# Asset hosts, read through raw GitHub links. Raw links send `access-control-allow-origin: *`, so the Spine loader's fetches need no setup.
VITE_ASSET_BASE_URL=https://raw.githubusercontent.com/steve1316/gfl-wiki-assets/main/
VITE_ART_BASE_URL=https://raw.githubusercontent.com/steve1316/gfl-wiki-assets-art/main/
