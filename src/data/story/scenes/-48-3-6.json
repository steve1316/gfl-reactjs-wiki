{"name":"-48-3-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Kitchen","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"As for that Umruss person... This is where he lives now. "}]},{"spans":[{"text":"I guess that counts as a result? That's all I can do for you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"—That's enough. It'll be very useful. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Please keep looking, if you don't mind. There might be other clues. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Okay, got it."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After hanging up, Nele takes out a collection of essays from her bookcase. "}]},{"spans":[{"text":"The inscription on it belongs to an outstanding woman—Gray."}]}]},{"sprites":[{"prefab":"APC556","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"Nele—"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I don't get it! Why was there such a huge change in her research direction all of a sudden?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She opens the book and starts ripping each page out, one after the other."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"There's no way she could be someone like that!"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I remembered every word she wrote! "}]},{"spans":[{"text":"\"Before studying medicine, one must first learn how to be a decent human being—wealth and poverty are not fair, but life is!\""}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"How could she possibly conduct experiments like this?! Do you know how many of our research trials were conducted in radiated zones, in secluded settlements below the poverty line?! "}]},{"spans":[{"text":"I thought we were saving them. I thought it was kindness."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"WHO IS THIS? HOW COULD THIS POSSIBLY BE MRS. GRAY?!","style":{"size":"55"}}]}]},{"sprites":[{"prefab":"APC556","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"Nele, calm down! "}]},{"spans":[{"text":"You're scaring me, and I'm worried about you... I'm worried that you'll end up doing something you shouldn't while you're in the grip of these emotions..."}]}]},{"sprites":[{"prefab":"APC556","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"You're just an ordinary human being. "}]},{"spans":[{"text":"You can't solve all this. All you can do is save the people within your reach."}]}]},{"sprites":[{"prefab":"APC556","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"And you're too tired! "}]},{"spans":[{"text":"Why don't you take advantage of the fact that you lost your job to go back to your hometown and clear your head, maybe start over again? How about that?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Don't treat me like a child!"}]}]},{"sprites":[{"prefab":"APC556","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"You're very confused right now, and that Agent J's mission is very dangerous—"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"My mind has never been clearer than it is right now, Mia."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Don't try to stop me. "}]},{"spans":[{"text":"I won't give up on anything, whether it's Mrs. Gray, Idunn, or that Agent J business. "}]},{"spans":[{"text":"This is what I believe in as a human being."}]}]},{"sprites":[{"prefab":"APC556","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021summer_SecurityBureau","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J squeezes the communicator he's holding. He's having a hard time hiding his excitement."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He jumps up from his chair, grabs the gun on his desk, and turns in preparation to leave."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Wait, Kevin."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I'm in a rush. Save it for when I get back."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I need to tell you now... Come with me."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG-Corridor","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K drags the restless J to a quiet corner of the office."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"What the hell are you up to? Don't forget that we pretty much have no permission to do anything now. "}]},{"spans":[{"text":"Romy is keeping a close eye on us and all our actions are under a magnifying glass. Don't get carried away and run off to do something stupid."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I've got news on the missing cargo."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"The Griffin Commander found the name of the person who placed the order—Umruss. "}]},{"spans":[{"text":"My informant checked the Galatea database and now we have his address! "}]},{"spans":[{"text":"Once we find him, we'll know who had their eye on that cargo."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Are you sure? "}]},{"spans":[{"text":"What if this is a trap? We can't do this, it's too risky."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Listen, Schwaben. "}]},{"spans":[{"text":"I am not acting on an impulse here. This is the closest we'll ever come to solving this missing cargo case. "}]},{"spans":[{"text":"What the hell have we found so far? Romy won't give us any information. At this rate we'll be letting the culprit go free."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"They're weapons! A big batch of weapons! "}]},{"spans":[{"text":"No matter where they end up, I'm certain it's not going to end in a peaceful settlement. "}]},{"spans":[{"text":"The thought of them circulating outside keeps me up at night, don't tell me it's not the same for you!"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Also... Why the hell did Light die in that mansion anyway? Why is Romy blocking the investigation? Have you never thought about that before?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"It's all related to Galatea! He must have found out about this... "}]},{"spans":[{"text":"I'm willing to bet they're all connected. We'll only get one shot at this. Do you really want to let it get away because of that woman's orders?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K takes a deep breath. He knows he can't stop J any longer."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I have a condition."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"We can't hide this from Mona."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Deal."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Cybercity","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a high-class residential district, Berlin."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...Target building identified."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As they look at the heavily-guarded building, the three Stasi agents set up a temporary command post on the roof of the building opposite it."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"That's a high-end personal condominium. "}]},{"spans":[{"text":"We'll put him on his guard if we try to force our way in without authorization."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I know that, but if we let him go, there's no telling when we'll be able to catch him again."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Are you sure he's in there?"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...The odds of that are very high. "}]},{"spans":[{"text":"I checked and one of the units is registered to an \"Umruss\". More importantly, he probably has not stepped outside today."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"So does it look like it's worth a try?"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"I think so. "}]},{"spans":[{"text":"If the missing cargo really are weapons, I can understand why Agent J is feeling so anxious about it. "}]},{"spans":[{"text":"We need to try all possible methods."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Turns out you're actually pretty reasonable."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"I'm very glad that you didn't keep me out of the loop this time, Agent J.."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...It was a request from K."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Agent K, I believe it would be more appropriate if we reported this to Frau Romy."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"NO!!! "}]},{"spans":[{"text":"That woman is clearly trying to play us for fools, given how she's hiding so much information from us. We mustn't tell her!"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"But...Frau Romy is our supervisor. "}]},{"spans":[{"text":"If we take unauthorized actions like this..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Argh, you're such a pain!"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"That's enough! J, mind your tone. "}]},{"spans":[{"text":"Mona is right. Frau Romy is in charge of us. You need to take her position into consideration when you do things."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Tsk."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"But this time... Mona, J isn't going off half-cocked here. The fact is that Frau Romy is not on the frontlines and she does not understand the situation. "}]},{"spans":[{"text":"If you report this to her now, she might tell us to call off the operation. And if we let Umruss go, there's no telling how long we'll have to wait again."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then do you intend to act now?"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"We can't delay any further. We need to do this now, while he still lives here."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"If we don't want to alert Frau Romy, then we won't be able to call for support."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Not necessarily."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"What do you have in mind?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I brought some plastic explosives along."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...What?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Oh, don't give me that look, I'm not planning to do anything dangerous with it."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"That isn't something you should be saying as you pull out a wad of plastic explosives!"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Ah... I get it."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"The guards there are bound to be incredibly high-strung. All we need to do is find a place, plant the charge, then set it off, and they'll panic. "}]},{"spans":[{"text":"When that happens, it'll be easy for us to sneak in. In fact, it's a tactic we couldn't use if we had too many people."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Th-that's too risky!"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"It won't cause any real casualties, it's just to lure them out of position. "}]},{"spans":[{"text":"If it makes you uneasy, then you can stay here and keep an eye on things."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...What do you think, Agent K?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I think it's doable."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...But if an accident happens..."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Then we'll have to trouble you to report to Frau Romy immediately. "}]},{"spans":[{"text":"Desperate times call for desperate measures, after all. "}]},{"spans":[{"text":"It's a sloppy plan, but it's got a solid chance of success."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing how in sync the two agents are, Mona lets out a heavy sigh."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
