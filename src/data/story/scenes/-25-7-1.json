{"name":"-25-7-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"159","raw":"BIN"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"spark","raw":"火花"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Strongpoint No.3. The Commander finally managed to create an opening in the enemy blockade."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Now, move! Watch out and dodge the artillery fire!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...BOOM!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...A shell exploded right next to 416."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"416!"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Don't mind me! Carry out my order! Quick! "}]},{"spans":[{"text":"74U, what are you doing?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...AK-74U grabs 416 and drags her behind cover."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"I decide how to execute your order. "}]},{"spans":[{"text":"Stay alive. Don't die."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...AK-74U catches up with Python and the others, and makes for the strongpoint."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...What a bunch of garbage. "}]},{"spans":[{"text":"No matter how I try to train them, I just can't turn them into 404..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sparkOff","raw":"关闭火花"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I suppose that's the difference in our levels of professionalism..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Or perhaps...I should change a little...?"}]}]},{"sprites":[{"prefab":"Mk12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"},{"type":"sfx","value":"Select","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Mk 12","narrator":false,"pages":[{"spans":[{"text":"Stop! Hold your fire! It's Griffin!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Ohhhh, it's you! I thought—"}]}]},{"sprites":[{"prefab":"A91","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"A-91","narrator":false,"pages":[{"spans":[{"text":"Don't you dare kick the bucket just like that, you still owe me a drink!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"I'm glad you remember!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep"