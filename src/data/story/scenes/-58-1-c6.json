se,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"They're both dead..."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-70"}}],"ops":[],"speaker":"Ganglati","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He interrupts Ange mercilessly. At the same moment, a grenade hurtles toward her..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange barely manages to dodge it in time. She dives sideways but is still caught in the shockwave of the blast."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-70"}}],"ops":[],"speaker":"Ganglati","narrator":false,"pages":[{"spans":[{"text":"Death is only the beginning..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":22,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Death is death!"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,-70"}}],"ops":[],"speaker":"Ganglati","narrator":false,"pages":[{"spans":[{"text":"Teacher will bring them back to my side..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Engrossed in his own melody, he launches a series of frenzied attacks."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! Boom! "}]},{"spans":[{"text":"Ange tightens her grip on her pistol and darts from cover to cover on the not-too-spacious rooftop."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":22,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Why... "}]},{"spans":[{"text":"Why give me a second chance..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With her back against the shaking obstacle that Ange is using as cover, the memory of Ramzan's death plays out once more in her mind."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":21,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"No matter how many times it takes, I will make sure you can rest in peace."}]}]}]}
