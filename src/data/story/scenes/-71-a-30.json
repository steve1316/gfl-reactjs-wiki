:"Commander","narrator":false,"pages":[{"spans":[{"text":"I understand what you're after, but—"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Miss Instructor tried to fob me off, but I won't hold it against her."}]},{"spans":[{"text":"I know you're going up against Galatea and the powerful entity behind them."}]},{"spans":[{"text":"My request is very simple—I want to restore Doctor Gray's reputation."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...That's very dangerous, you know."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Of course I do, but I've got to get to the bottom of it."}]},{"spans":[{"text":"I want to figure out what exactly was the thing that replaced the real Doctor Gray!"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Looks like nothing I say will dissuade you."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...You're right about that."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Even if it'll take you down a difficult path?"}]},{"spans":[{"text":"You do know that you're in the company of a group of wanted criminals, right?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"So what...? The pursuit of the truth is never easy."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright, I understand."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Looking at Nele's resolute eyes, the Commander knows that she is fully committed to her cause."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"276","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander, here's the Stasi agent that was found together with Miss Nele."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander directs their gaze at J, who is sitting in the corner. They're not quite sure how to feel."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Commander...?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sorry for getting you involved."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Did you receive my message?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I'd thought the next time we saw each other again, we'd be having a drink together in Frankfurt..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm sorry. That's really all I can say."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I know."}]},{"spans":[{"text":"We're never destined to walk the same path."}]}]},{"sprites":[{"prefab":"AR18","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Apologies, Agent J, but I'm afraid you're going to have to stay here for a short while."}]},{"spans":[{"text":"Someone will bring you some daily necessities in a bit."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"356","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"AR-18, tell all the Dolls to assemble at the meeting room in ten minutes."}]}]},{"sprites":[{"prefab":"AR18","expression":5,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR18","expression":5,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"I thought you would be depressed for a while..."}]}]},{"sprites":[{"prefab":"AR18","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"When Erma gave her life... you didn't slack off at all."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"...I am a soldier."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What a coincidence, so am I."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The road ahead will demand even more courage and determination from us."}]}]},{"sprites":[{"prefab":"AR18","expression":5,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR18","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"It is an honor to accompany you."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"98","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_ev2408_DanceWithDeath","raw":"BGM"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"We are now just outside an abandoned chemical plant in the Eschborn District of Frankfurt."}]},{"spans":[{"text":"Through our camera, you can see thick smoke and a large amount of powder billowing in the air."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"An explosion has just occurred here, but the exact cause and casualties remain unknown. Firefighters have already entered the scene to put out the fire."}]},{"spans":[{"text":"This is not an isolated incident. Two other factories in the Eschborn District also experienced explosions today."}]},{"spans":[{"text":"As those two factories are involved in the processing of hazardous chemicals, our team has not yet been granted access, and the situation remains unclear."}]},{"spans":[{"text":"We will continue to follow this story closely."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"760","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Ladies and gentlemen, we have just received an emergency report—an explosion has also occurred today in the Wiesbaden District."}]},{"spans":[{"text":"The blast site has been sealed off by police, and unauthorized personnel are not allowed to enter."}]},{"spans":[{"text":"From the perimeter, we can see police officers, firefighters, and medical personnel moving in and out, with multiple injured individuals being carried out for treatment."}]},{"spans":[{"text":"Hello, did you notice anything when the explosion happened?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Passer-By","narrator":false,"pages":[{"spans":[{"text":"I live nearby. I heard some rumbling and ran outside to see what was happening, then I saw the explosion in the district."}]},{"spans":[{"text":"There's a lot of yellow powder in the air, I sure hope it's not toxic."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Thank you for your response."}]},{"spans":[{"text":"We also observed a similar yellow powder earlier at the site of the factory explosion in the Eschborn District."}]},{"spans":[{"text":"To determine its origin and whether it poses any toxicity risks, we have reached out to an environmental expert on the scene."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Environmental Analyst","narrator":false,"pages":[{"spans":[{"text":"Um... We have conducted a series of tests on various environmental indicators within the affected neighborhood following the explosion. However, it will take some time to obtain the results."}]},{"spans":[{"text":"At present, we can confirm that the explosion has caused a sharp increase in ELID radiation particle concentration in this area. The levels are now approaching the threshold for a Yellow Zone classification."}]},{"spans":[{"text":"As a precautionary measure, we have issued a contamination alert to residents in the vicinity."}]},{"spans":[{"text":"But please stay calm and don't panic. We have already dispatched relevant personnel to contain the radiation contamination."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Yes, if any of our viewers live near the explosion site, please refrain from leaving your home until the contamination alert is lifted."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"776","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Following the major explosion in the Frankfurt District on November 1, multiple explosions have occurred today in Wiesbaden, Eschborn, and Raunheim, resulting in at least 50 casualties so far.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Police and emergency responders have arrived at the scenes to carry out rescue operations. We will continue to provide updates on the situation.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"It is worth noting that authorities have not yet classified these incidents as part of the same series as the explosion in the Frankfurt District. Instead, they have linked them to multiple explosions that took place in Berlin this past September.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Reports indicate that large amounts of yellow powder were also found at the Berlin explosion sites. Experts have now confirmed that this substance is identical to the yellow powder discovered at the new explosion sites in Frankfurt.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"While the exact origin of the substance remains unclear, it has been confirmed to cause elevated ELID radiation levels. Experts are actively studying its effects, and police are investigating its source.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"During this time, we urge Frankfurt residents to remain calm, limit outdoor activities, and avoid crowded areas.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"We will continue to follow the situation closely.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"[Angular Gyrus - END]"}]}]}]}
