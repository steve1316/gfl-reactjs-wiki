hot_h","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang. "}]},{"spans":[{"text":"ST AR-15 shot the mutated girl right in the center of her brow. "}]},{"spans":[{"text":"\"She\" slumped into the snow, no longer breathing."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"You made the right call."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't need you to tell me that."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_Memorial","raw":"BGM"}],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"Poor human."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Was she a civilian who had been hiding nearby? Maybe her parents were dead, or they wouldn't have left her here all alone."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 walked up and closed the girl's eyes gently."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"She died of mutation."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...It wasn't her fault."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"I know. "}]},{"spans":[{"text":"Come and give me a hand."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"6","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several minutes later. "}]},{"spans":[{"text":"M4A1 knelt on the ground next to a freshly filled grave. "}]},{"spans":[{"text":"ST AR-15 placed the dirty teddy bear and a bouquet of wild flowers onto the soil."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That should do it."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"A life was lost...just like that."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's the sort of world we live in. "}]},{"spans":[{"text":"No matter what it is that we want to protect, this will happen in the end."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"Is it always the same wherever we are? Will the strong always dominate the world while the weak are so casually slaughtered?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's why we must grow strong ourselves – so that we won't be the ones slaughtered."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I didn't know you were also capable of being so sentimental."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"I'm not so different than you."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"That may be true, but I still don't approve of you. "}]},{"spans":[{"text":"I'll cooperate with you for the time being, but only to ensure M4's safety. "}]},{"spans":[{"text":"I don't care what you're trying to do. If you don't return control over the body to M4 even after we're out of danger, I swear I'm going to kill you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"Sure, I get it."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"202","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A civilian... "}]},{"spans":[{"text":"I didn't expect there to be any civilians left on the scene under those circumstances..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The theater was right next to an abandoned town. A lot of refugees had been living alone in hiding within the Yellow Zone."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It was our purpose to protect civilian lives... I can't believe we ended up dragging so many innocent people into this."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"So long as there is strife, we will never truly know peace. "}]},{"spans":[{"text":"Living has always been hard. Only those who survive have the right to judge what is right and what is wrong."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shooting such a young ELID must've been devastating."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"If I hadn't, the infected would've suffered even more."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have experienced the sensation of being exposed to Collapse radiation. It was as if my bones were piercing through my skin. My entire body was in agony - like it was being torn apart. "}]},{"spans":[{"text":"It must be even worse for those who are even more acutely infected. The only release for them would be death."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I commend you for surviving that ordeal. "}]},{"spans":[{"text":"Surely you wouldn't want to experience that kind of pain again."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Not if I can help it."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Then let's keep going. We can only prevent the same tragedy from repeating itself if we complete the upload and find the information we need to repel the Military. "}]},{"spans":[{"text":"We don't have much time."}]}]}]}
