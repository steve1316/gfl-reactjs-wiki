{"name":"-54-T-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"529","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F02 (First-Class Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_2022_Summer_Battle_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Over 10 minutes have passed by the time Tareus regains consciousness."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I can't waste any more time on these insignificant insects."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila's location remains unknown."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Fire_Bonfire","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The burning sensation in her heart is harder and harder to endure. She opens the blank channel to issue orders to the troops outside the train."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Sweep and clear the entire train from head to tail. Leave no survivors. "}]},{"spans":[{"text":"I don't believe you'll elude me, Lyudmila.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus begins a second round of searching..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"523","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus stands by the side of the train car, watching Lyudmila from far away."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"For a moment, she has no idea what she should do, but she is still heading toward Lyudmila."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"524","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A loud whoosh of displaced air swoops through the sky overhead. Tareus can tell that it's \"Ruslan II\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bomber_Napalm","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It skims over Lyudmila's head, like a faithful knight protecting its princess, swinging its sword and dropping balls of fire on the enemy troops blocking her path..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"...Intercept the target."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"197","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Fire_Bonfire","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The blank channel is a write-off. "}]},{"spans":[{"text":"Her troops have been consumed by the bombardment, as if they had never existed. "}]},{"spans":[{"text":"Lyudmila's signal has also vanished in the sea of flames."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Verified—escort target has been neutralized."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus coldly announces the end of the mission."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Mission complete. Prepare to withdraw."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"531","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F03 (Second-Class Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus makes a detour and does not proceed immediately to the VIP-class carriage to meet up with the surviving passengers. Instead, she heads to the second-class carriage."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10258","raw":"BGM"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl called \"Eve\" is still lying there. Her wide-open eyes have started to cloud over."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus kneels beside her and takes the little teddy bear from her skinny hands."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"You won't need this anymore."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hugging the bear, she heads toward the VIP-class carriage. "}]},{"spans":[{"text":"That woman's cries echo in her ears again—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Eve... My Eve..."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Eve..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus mutters the simple word, which is the only one she remembers, even after countless virtual cognition image restorations. "}]},{"spans":[{"text":"Tareus has named her mech after it— "}]},{"spans":[{"text":"\"Miss Eve\"."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"529","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F02 (First-Class Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus has reached the first-class carriage. She is only ten or so steps from the VIP-class carriage."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She squeezes the soft teddy bear. Though its fur is a little scorched, it is still a cute little plush animal."}]}]},{"sprites":[],"ops":[],"speaker":"Woman","narrator":false,"pages":[{"spans":[{"text":"Eve! Let go of me... "}]},{"spans":[{"text":"Let me find my Eve..."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"My little girl... Eve..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The woman's cries grow louder and louder, as if the woman is right next to her. "}]},{"spans":[{"text":"As if she was the one hugging her body and calling out the name. "}]},{"spans":[{"text":"It's nothing more than a simple word, so why does it evoke such sadness in her? "}]},{"spans":[{"text":"Tareus does not understand."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She stops and records these doubts in her virtual cognition image."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
