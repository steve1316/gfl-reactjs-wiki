{"name":"-31-2B11-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two Dolls sprint through the tunnel."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What's your current status?"}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Some minor damage; won't be a problem for the moment. "}]},{"spans":[{"text":"Why did you come back?"}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Leaving on your own would've been the best solution. "}]},{"spans":[{"text":"Yet you doubled back, risking your own life and using up all our explosives - why?"}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't know why, I just thought that was the right thing to do."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"You should know that's not good enough of a reason, AR-15. "}]},{"spans":[{"text":"You are one-of-a-kind, while I can create backups of myself. Your survival takes priority."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Why ask me such questions? "}]},{"spans":[{"text":"You should know better than me."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I don't understand. "}]},{"spans":[{"text":"I just can't figure out your rationale, which is why I have to ask. "}]},{"spans":[{"text":"As a senior, you are more experienced than me..."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I told you to stop calling me that..."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 rubs her temples as if the word gives her a headache."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Something's value is determined by its demand. You and AK-12 have carried out more orders from Ange than me, so you meet her demand. "}]},{"spans":[{"text":"Therefore, from the perspective of meeting Ange's demand, you're more valuable than me. "}]},{"spans":[{"text":"Even you have to admit that, right? "}]},{"spans":[{"text":"No, you should admit it especially because you're so driven by logic."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Is that your reason...? "}]},{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"If you got destroyed back there, putting aside the question about whether Ange has a spare body of the same quality ready for you, it'd take a long time just to download your backup. "}]},{"spans":[{"text":"The situation is so urgent we simply don't have the luxury of waiting for you to reinstall yourself and get used to a new body."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"However, this mission can be accomplished even without me."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"There's a limit to how modest one can be, AN-94. "}]},{"spans":[{"text":"Don't deny your worth."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Sorry. But...AR-15, you and M4A1— no...the entire AR Team are the most tailored to Ange's use. "}]},{"spans":[{"text":"No matter how capable I look, I'm still just a supplementary tool. "}]},{"spans":[{"text":"All kinds of reasoning suggest that you should prioritize your own safety and I, too, will always choose to save you over myself."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...What do you mean?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Nothing. "}]},{"spans":[{"text":"The exit is just ahead, correct? "}]},{"spans":[{"text":"Then we had better leave this place quickly."}]}]}]}
