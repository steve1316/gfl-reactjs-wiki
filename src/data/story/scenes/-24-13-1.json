{"name":"-24-13-1","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I never thought that a day like this would come... "}]},{"spans":[{"text":"I never thought that someone like me would end up helping so many people... "}]},{"spans":[{"text":"I never thought that I would do something I'd never done before... "}]},{"spans":[{"text":"...But I have no way to tell anyone about it. "}]},{"spans":[{"text":"So please, RO, please wake up. "}]},{"spans":[{"text":"Listen to what I went through today, and share this joy with me. "}]},{"spans":[{"text":"Because right now... you're the only friend of mine who can hear my voice. "}]},{"spans":[{"text":"So please, hear me out..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Ow, ow, ow... not having tools really is a pain... so I should connect these wires, right? "}]},{"spans":[{"text":"I didn't think I'd have to go and tear my own body open, but there shouldn't be a problem if it's me!"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"72","raw":"BIN"}],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"【Neural cloud connection in progress. Access request has been accepted. Please stand by.】","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm in! I didn't think that messing around like that would actually work... Maybe I'm a genius, after all!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"【Neural cloud connection successful. Accessing connected target—】","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"This is great, looks like I wasn't blocked by the firewall... but where's RO's signal...?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"【Obtaining connected target's address - unable to obtain address. Please re-verify connection coordinates.】","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It's all dark... "}]},{"spans":[{"text":"Was the power supply unable to keep the neural cloud going? But I already hooked up the power... Don't tell me it was too late..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...Hm? "}]},{"spans":[{"text":"Stars? Why's there a starry sky in a neural cloud? "}]},{"spans":[{"text":"There's a bright light close by... Is that one of RO's neural fragments?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...RO's neural cloud hasn't completely stopped functioning yet! There's still a chance! "}]},{"spans":[{"text":"I'll go over and take a look where that bright light is..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II reaches the indicated position."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The light's circling around...? Do you understand what I'm saying?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The light flies in a circle."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"So it IS a fragment of RO's neural cloud! "}]},{"spans":[{"text":"RO! RO, can you hear me? "}]},{"spans":[{"text":"RO, I'm right here! I'm SOP-II! "}]},{"spans":[{"text":"Please! Please wake up! "}]},{"spans":[{"text":"RO—!!!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"7","raw":"BIN"},{"type":"openEyes","raw":"睁眼"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"},{"type":"flashback","raw":"回忆"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You finally showed up, ■■."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Should I apologize, 45?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Why should you? You were in command. "}]},{"spans":[{"text":"It's just that... "}]},{"spans":[{"text":"How is your choice any different from M4A1's?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"You mean contacting Helian?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I mean trying to save everyone. "}]},{"spans":[{"text":"If the Commander hadn't listened to you and rushed here at all costs... "}]},{"spans":[{"text":"All our deaths would have been on you."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I think I now know... "}]},{"spans":[{"text":"...Why you always do things your way."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then will you be content with losing your sense of self and becoming someone else's substitute?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"But... what even is my \"sense of self\"?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I was... created for this to begin with. "}]},{"spans":[{"text":"I will never abandon those who M4 wishes to protect. "}]},{"spans":[{"text":"And those who she believes in, I too, will."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In any case, you did the right thing in this operation."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Everything she does will be for M4A1's sake, including the things that the AR Team and M4A1 herself can't do. "}]},{"spans":[{"text":"I've readjusted the plan so she won't have so much of...\"that girl\" in her. "}]},{"spans":[{"text":"That way, she'll have more abilities and the room to make use of them, and become the most capable addition to the AR Team. "}]},{"spans":[{"text":"The development channels used in making the AR Team can't be mass-produced, and the number of times that the brain scan data can be used is far too limited... "}]},{"spans":[{"text":"But the simulated processing AI used as a substitute is quite stable. At this rate, the data specifications of this girl can probably be used as the template for the third generation of Dolls. "}]},{"spans":[{"text":"She will protect M4A1, not because she is ordered to, but because she admires and respects M4A1... "}]},{"spans":[{"text":"While this will all be the product of previous planning, aren't \"emotions\" basically playing things by ear anyway?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"75","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"What about M4? Did she do anything while she was crying?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"She didn't do anything at all! "}]},{"spans":[{"text":"She was the only one seriously crying, and the loudest one as well. She kept saying, \"It's my fault, it's my fault, I'm sorry!\" "}]},{"spans":[{"text":"She was just like a bullied kid I once saw in a movie. I have no idea how she managed to emulate the look so perfectly! "}]},{"spans":[{"text":"It was super embarrassing how our leader was so useless! And making fools out of the rest of us as well, hahaha! I would love to see it happen again! "}]},{"spans":[{"text":"Hahaha!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"76","raw":"BIN"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Ha... "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"Though...it's probably impossible at this point..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"SOP-II... "}]},{"spans":[{"text":"It's still possible. M16 must be waiting for us somewhere, and AR-15... Well, many things are still unconfirmed, right? "}]},{"spans":[{"text":"As long as we survive, there will surely be a way in the future."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yeah... ■■, why do you think we have emotion modules?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"About that..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I once posed this question to M16. She said perhaps it is to prove that we aren't simply killing machines. "}]},{"spans":[{"text":"We possess emotions, so we're different from those cold, emotionless Military Dolls... "}]},{"spans":[{"text":"But there are those who say that our emotions are what makes us defective and weak. "}]},{"spans":[{"text":"So what do you think? T-Dolls have emotions... Does that make us defective?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I don't know... "}]},{"spans":[{"text":"But emotion modules are something that humans gave to us. No one would intentionally make their own products defective, right? "}]},{"spans":[{"text":"So...there must be some meaning to all of this."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...... "}]},{"spans":[{"text":"...... "}]},{"spans":[{"text":"Beginning audio playback—"}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AR15","narrator":false,"pages":[{"spans":[{"text":"It's been a long time, ■■.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I don't know if this will be our last call, but due to my current situation, I'll have to cut a long story short.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I probably... can't ever return to the AR Team.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"You know, sometimes that's just the way things are. You work hard but you still end up with a mess.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Enemies, orders, or even just plain bad luck... So many things can ruin your plan...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"M16 once said, the difference lies in whether we give up just like that, or we prepare for the worst and keep going.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"If you don't see me the next time, it means the worst has happened...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"But I've already prepared for it. How about you, ■■?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Have you prepared... to return to the AR Team?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Of course, you have your own ideas and choices to make... So all I want to say is...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm sorry. Forgive me for what I said. You've always been exemplary. I know that.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Don't feel too down, ■■. "}]},{"spans":[{"text":"You're a high-performance Doll, better than most of the Dolls you haven't met yet."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I... don't understand... "}]},{"spans":[{"text":"But why... "}]},{"spans":[{"text":"Why did that Doll... AR-15... why did she say I was a failure? I clearly won in the simulated battle..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Because you sacrificed M4A1 without hesitation. It was a very bad choice."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I did it to win... "}]},{"spans":[{"text":"Aren't Dolls expendable?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Not all of them, ■■. That's not the answer I want."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"So I should prioritize protecting M4A1 from now on, right? Then give me a new order. I'll know what to do."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"No... that's not what I meant. "}]},{"spans":[{"text":"While the AR Team was made for that purpose, I won't give you an order like that."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I don't understand... "}]},{"spans":[{"text":"Why do you want me to do this... without ordering me to...?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You need to know WHY you have to do this. "}]},{"spans":[{"text":"You need to find the right answer on the battlefield, and not achieve victory based on your orders."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"Then why not directly program it that way? "}]},{"spans":[{"text":"Just tell me what to do, and I'll know how to do it."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You don't know where your true \"excellence\" lies, ■■... "}]},{"spans":[{"text":"But I'll give you a chance. I'll let you take part in live operations. You must accumulate experience, amass knowledge... "}]},{"spans":[{"text":"You must... add to your \"emotions\"."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"Emotions?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Yes. A Doll's emotions can be trained and changed. "}]},{"spans":[{"text":"This is... the fruit of Lyco's hard work... I hope I'm not abusing it now..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"Miss Persica?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I'll assign you to a new position, where you'll be doing real work. Mix well with your friends, and all kinds of human beings... "}]},{"spans":[{"text":"Even I don't dare to make contact with those humans... you'll have to be better than I am to succeed."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"A new position... I don't know if I'll be able to adapt. Will I not be able to return to the AR Team?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"The time is not yet right. I'll bring you back when you're ready."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"My... new job... "}]},{"spans":[{"text":"I'm not sure if I'll like it..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I'm honestly not sure either, and I won't compel you to do so with an order, but learning to like it will be your mission. "}]},{"spans":[{"text":"Learn to like M4A1, learn to like the world, and learn to like yourself. "}]},{"spans":[{"text":"Come, follow me, and we'll start right away."}]}]},{"sprites":[{"prefab":"92type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"41","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Yeah, the mission has also been accomplished... "}]},{"spans":[{"text":"Though... we'll have to part soon..."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"STEN MkII","narrator":false,"pages":[{"spans":[{"text":"Huh? Why is that?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"Don't you remember, Sten? "}]},{"spans":[{"text":"This team is assembled temporarily only for this operation."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"STEN MkII","narrator":false,"pages":[{"spans":[{"text":"Oh, right... And we already have Document 36... "}]},{"spans":[{"text":" Even though Sangvis Ferri completely destroyed the city..."}]}]},{"sprites":[{"prefab":"92type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"They won't be cocky for long. Makarov will bring word of this back to HQ.  "}]},{"spans":[{"text":"We will come up with something - against that large mortar, as well as the Sangvis ringleader hiding behind it."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"STEN MkII","narrator":false,"pages":[{"spans":[{"text":"Yeah. All of us have gone through so much and learned a lot from this operation. "}]},{"spans":[{"text":"Even if we go our separate ways, I will never forget..."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"