nce..."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"43","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I swear...  "}]},{"spans":[{"text":" I WILL make them pay! No matter what weapons they fire at us, what strategies they use, what conspiracy they have cooking on the stove... "}]},{"spans":[{"text":" So long as they cause destruction... So long as they wreak havoc... "}]},{"spans":[{"text":" I will definitely make them pay!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Have you finally...come to like this world? "}]},{"spans":[{"text":"Do you finally know why you act?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"I... "}]},{"spans":[{"text":"I don't know what it is that I like..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"It's you. You and this world are one."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"■■","narrator":false,"pages":[{"spans":[{"text":"Who... am I?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Your name... "}]},{"spans":[{"text":"Well of course, it's..."}]}]},{"sprites":[{"prefab":