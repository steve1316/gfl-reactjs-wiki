b":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It's a defense mechanism installed in my neural cloud. You were too rough and triggered it! "}]},{"spans":[{"text":"Also, those S.F. arms and legs of yours are a big problem too!"}]}]},{"sprites":[{"prefab":"RO635","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hey, I survived with the help of these things! "}]},{"spans":[{"text":"So what should we do now? How should I get you out of here?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Where's my body?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The head was smashed, so I left it back there. "}]},{"spans":[{"text":"Don't make me think about it; it makes me want to get my team to hunt down and kill Yegor."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Alright, alright, if you have teammates, then I'll need a body..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We don't have a