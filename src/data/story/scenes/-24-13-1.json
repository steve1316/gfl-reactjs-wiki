4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Well, it's not like I'll be eating cake or dancing any time soon. When I rebuilt my body, I dumped a lot of modules and parts. That freed up a lot of space. "}]},{"spans":[{"text":"But I don't know how to connect your core to my internal motherboard on the software level..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I have a way, but it'll put a huge strain on your neural cloud."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"\"If you don't use your head, you might as well not have one,\" M16A1 once said."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Alright, but first we need to get out of this place."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Can't you just tell them to stop?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The system thinks I'm dead, so it's stripped me of my neural cloud control privileges. I need to reauthenticate to get them back."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefa