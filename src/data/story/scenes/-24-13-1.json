gs":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO635 smiles."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Seeing you be this noisy, and knowing about all of the annoying work that's coming up for me... I really should have slept longer."}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hehe, but you're awake now, so let's go!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
