sion":6,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Careful, 45."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"45 follows the scratching sound to a tank in the corner. "}]},{"spans":[{"text":"The girl in there is a monster that's half-human, half-machine. "}]},{"spans":[{"text":"A massive mechanical limb extends from her deformed spine... The fragile human spinal column clearly cannot bear the weight of the heavy cybernetic appendage. "}]},{"spans":[{"text":"The girl's eyes are glazed and unfocused. Powered by leftover electricity and driven by her human instincts, she scratches robotically at the glass."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Is she still alive...?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"What difference does it make once you got turned into that?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 takes aim at the girl."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! "}]},{"spans":[{"text":"After the explosion of fluid and sharp fragments, the girl is finally silent."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"UMP45","narrator":false,"pages":[{"