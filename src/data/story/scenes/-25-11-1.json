{"name":"-25-11-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-RuinedCity","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Griffin's withdrawal is almost complete. "}]},{"spans":[{"text":"...The Griffin T-Dolls get in line to board the transports. They wave each other farewell, waiting to meet again at the new base."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Why are you still here, 416?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK74U","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The Commander just issued another rescue mission in the current theater. "}]},{"spans":[{"text":"Anyone that wants to take part are free to stay behind."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK74U","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"I heard. That mission is a real dangerous one. Why are you going?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK74U","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I didn't say I was. Some will go, some will stay. "}]},{"spans":[{"text":"I'm just taking in the view and...doing some thinking. "}]},{"spans":[{"text":"Are you going now?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"show