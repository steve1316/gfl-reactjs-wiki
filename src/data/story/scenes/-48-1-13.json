{"name":"-48-1-13","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"gunCGlake","raw":"BIN"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the outskirts of Berlin, Germany."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Huff... Huff..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Braced against the overturned vehicle, the Dolls finally manage to eliminate Paradeus' forces."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Good thing it was just a small unit... We probably won't be so lucky next time. "}]},{"spans":[{"text":"Is the vehicle still operational?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hah!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II tries to flip the vehicle back onto its wheels."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"There'll be hell to pay if you play this kind of trick again! "}]},{"spans":[{"text":"You think we really won't kill you?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In her wrath, ST AR-15 punches Morridow viciously."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow's only response to the Doll's violence is a low grunt."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Stop it, 15... Don't waste your strength on her. "}]},{"spans":[{"text":"Go and help the others."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Exhales) Sorry."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 shoots Morridow another dirty look, and while she still fights the urge to just blow her brains out, skelters off to join her comrades and checks on the unconscious Dandelion."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...Cool as a cucumber, aren't you, my Commander~?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shut up."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Oh~? I thought you captured me to get me to talk. "}]},{"spans":[{"text":"I thought you'd want me to do the opposite of shutting up~"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You can save me that load of crap."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"But from what I can see in our memory, you were very kind and gentle to my sister."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She was nothing like you... She would never take innocent lives for her own ends."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Oh? Is that what bothers you, Commander? You, whose hands are also soaked in blood? "}]},{"spans":[{"text":"Heh... I suppose a bud sprouting in the soil does still yearn for light. So that's the sort of thing you're into, I see. "}]},{"spans":[{"text":"Next time, I'll humor you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 comes over, interrupting the Commander and Morridow's conversation."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...A transmission from the base."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shoots Morridow another glance, then turns and follows RO635 to the other side."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's me."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"...I'm very glad to see that you're doing well, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Miss Helian? How's Kalina? Is she alright?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Relax, Kalina is perfectly fine.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We have already transferred her to a specialized hospital.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The juvenile Nyto known as Anna has also been sent to Havier for research.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right... Oh, sorry. "}]},{"spans":[{"text":"You must have called me for a particular reason. Is something the matter?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"You could say that.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Hello, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"Y-you are...?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"A Stasi agent and a colleague of K's. You may call me J.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"gunCGlake","raw":"BIN"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I see now... You're the one who's been helping Ange this whole time."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander murmurs with rueful understanding, then lapses into silence. "}]},{"spans":[{"text":"They didn't expect that to be the last time they would hear from Ange. "}]},{"spans":[{"text":"Now... there is even more work to do."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We are very grateful for your continued support. "}]},{"spans":[{"text":"We won't forget the favors that you and K have done us."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Wow, you're not like Ange at all. Anyway, let's not waste time on this kind of empty small talk.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...The fact that K has given me your contact information means he trusts you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I trust K, and I trust Ange, which is why I've decided to place my bet on you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Isn't it the same for you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...You're right. "}]},{"spans":[{"text":"But regardless, thank you very much for getting in touch with me."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...As you know, Paradeus' infiltration into our country is far more deep-seated and extensive than we expected.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"There's no telling whom we can really trust. Working together is our only hope of averting catastrophe.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander rubs their forehead and forces themselves to remain calm."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What do you need me to do?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...As I've said, I'm now under surveillance so I can't get around freely.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"There are many things that I can't really do at the moment, but you have no such limitations.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I will supply you with intelligence, and in return, I'd like you to share your findings with me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...My colleague was killed in that mansion.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But Ange could still be alive. We might still have a chance to rescue her.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...This is Ange we're talking about. "}]},{"spans":[{"text":"She couldn't have kicked the bucket just like that."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"You see? I knew we could come to an agreement.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right. Then let's keep in touch."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Alert me at once if you have any new discoveries. I'll do the same.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Call ended."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Can we really trust a guy who popped up completely out of the blue?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"He contacted me using K's cipher. "}]},{"spans":[{"text":"Considering our circumstances, having an extra lead is not a bad thing."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I see. Then right now..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...We have more questions to ask our prisoner."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Theatre","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Berlin State Opera, Berlin, Germany."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_21summer_avg_Demon","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The opera house is soon abuzz with activity and conversation. Then a female singer takes center stage and bursts into song."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Kein Traum ist dieses Glück!"}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Ich halte dich umfangen ♪"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her sweet and mellow voice has a certain mesmerizing quality that keeps the audience enthralled."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG-Theatre","raw":"BIN"}],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"She has a captivating voice."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"And your tastes are as refined as ever."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The legendary Minister Rudolf von Oberstein himself is sitting in a private box on the left alcove. "}]},{"spans":[{"text":"The center of power in the entire German Democratic Republic is currently gathered here in this very opera house."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The curtain falls. It is now the intermission."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Minister Oberstein, a gift from our friend brought to you all the way from the Soviet Union."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Ha, Moskovskaya vodka... "}]},{"spans":[{"text":"Looks like someone is reminding me not to step out of line. "}]},{"spans":[{"text":"Hm... It's been so long I've almost forgotten the taste."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"He really knows what you like..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein lifts his shot glass and peers at it with narrowed eyes."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Let's get down to business. Has he accepted our invitation?"}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Yes, he knew from the start that the invitation was from you."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Of course. He is no simple man."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"I'm beginning to understand why you have chosen to deal with him. However, isn't this too risky? "}]},{"spans":[{"text":"It's not a good idea to antagonize a member of the Council. Even the Swiss don't dare to get on the URNC's bad side. If they find out..."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I see that not only do you wish to befriend the Earl, you are also quite chummy with the Swiss. "}]},{"spans":[{"text":"Still, money doesn't necessarily buy one a friend. One could end up buying a dog."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Hahahahaha... "}]},{"spans":[{"text":"Don't worry, General. I promise there will not be another large-scale disarmament like the one in 51. However..."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"That's not my greatest concern. More importantly..."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Let's resume this discussion some other time. Our friend has arrived."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Right on cue, Oberstein's secretary speaks from outside the private box."}]}]},{"sprites":[],"ops":[],"speaker":"Secretary","narrator":false,"pages":[{"spans":[{"text":"Minister, Lord Griffin is here."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Please let him in."}]}]},{"sprites":[],"ops":[],"speaker":"Secretary","narrator":false,"pages":[{"spans":[{"text":"Yes, sir."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A moment later, the door is opened. The two men rise to receive their late guest."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Earl, you're late. You missed a spectacular soprano in the first half of the performance."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Apologies. I didn't expect the traffic to be so terrible in Berlin when it's rainy. "}]},{"spans":[{"text":"It's been a long time, Minister Oberstein. The last time we met was in '62, yet you still cut a striking figure."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Thank you. The last time I saw you was during that conference on European IT standards in London, wasn't it? Back then you were... still a \"secretary\" working at the Cabinet Office."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Do excuse my humble beginnings."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Well, thank you for your gift. It brings back memories of the reconstruction era."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"I thought you disliked vodka."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"And I thought Brits disliked leaving their quaint little island, yet here you are, making yourself at home in Berlin."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin returns Oberstein's gaze evenly. Then they both burst into laughter. Having watched the entire exchange on the edge of his seat, the general surreptitiously breathes a sigh of relief."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"My friends, let's all sit down comfortably before we continue."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Please."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"After you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three men slowly sit down. Oberstein is the first to speak."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Earl, we never had the chance to have a proper conversation even though you've been in Berlin for quite a while. I'll cut straight to the chase. "}]},{"spans":[{"text":"Why exactly is the Council so interested in Berlin?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"It's because of the smell, Minister. "}]},{"spans":[{"text":"The smell in the air on the eve of a storm. The smell of blood."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"You believe a storm is coming?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"I believe we are here to discuss how to stop it."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Oh? Then is there anything I can do to clear the air of the smell of blood?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Certainly. Where there is a will, there is a way. This bit of stench won't be much of a problem as long as it's dealt with in a timely fashion. "}]},{"spans":[{"text":"After all, I doubt anyone wants to plunge the world into chaos."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Earl, I hope you forgive the current state of disorder in Berlin. Germany is at a watershed moment."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"I am quite curious, esteemed Minister Oberstein, about how this state of disorder will be resolved and where Germany's future lies. More importantly, which future will you choose?"}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Do you believe we even have a future in this crumbling house?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Is it necessary to knock it down, then? So who is going to give it a good kick? You?"}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Earl, you..."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"It's quite alright, General Schweinsteiger. "}]},{"spans":[{"text":"We should be heartened that a guest from faraway shows such great concern for our country..."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"I thank you for your understanding. Please believe me when I say that I genuinely wish for a bright and prosperous future for Europe."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Do you know when was the first time I drank this vodka, Earl? "}]},{"spans":[{"text":"It was around ten years ago in an air-raid shelter. My lieutenant poured us both a shot to calm our nerves. I can still clearly recall his grin even after all this time. "}]},{"spans":[{"text":"So you don't have to ask me how to put an end to this state of disorder. Our Soviet friends are very experienced in this regard."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"True, but right now they're rather occupied by their own troubles, so unfortunately, they won't have time to share their valuable experience with you."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Then you must remind them to take care of themselves. Winter in Siberia can be brutally cold."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"You have a point. Let us drink to their long-lasting health."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Indeed. To their health."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein raises his glass and downs his vodka in a gulp."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Thank you for coming tonight, Earl. Germany has already wasted too much time in our past squabbles and turmoil. This time, we must not make the wrong choice. "}]},{"spans":[{"text":"And it goes without saying that I hope to see you in Germany's future."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein gets to his feet and pulls open the drapes behind the private box."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Thank you for inviting me, General Schweinsteiger. "}]},{"spans":[{"text":"But I must get back early tonight and continue serving my country tomorrow. Goodnight, gentlemen."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein turns and exits the box."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"He still hasn't left it behind."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Who can really say they have, Earl?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
