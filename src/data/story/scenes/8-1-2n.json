{"name":"8-1-2N","beats":[{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Combat concluded. Griffin forces storm the Sangvis outpost."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Clear. Squad Welrod, we'll hold our positions and cover you."}]}]},{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"Victory shall accompany those who trust in it. We'll leave it to you, then."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Phew... Hopefully everything will go well."}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"G17","narrator":false,"pages":[{"spans":[{"text":"You look relaxed for the first time tonight, Leader."}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Oh? How did I look like before?"}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Distaste had encompassed your entire face."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"I wasn't aware... "}]},{"spans":[{"text":"Hmm... I hope Fräulein Welrod and her team didn't notice that..."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Are you not satisfied with the Commander's arrangements to have us work with Squad Welrod?"}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"The only thing I'm dissatisfied with is... my own inexperience."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Your self-reflection lifts my spirits. "}]},{"spans":[{"text":"Seeing as how things turned out in our most recent mission, that is definitely a good takeaway from it."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"With Squad Welrod with us this time... perhaps I don't have to be too worried. "}]},{"spans":[{"text":"It just bothers me so much that we suffered a bitter defeat at the end of the line because of my foolish mistake."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Being bothered by that is fine. However, you're trying too hard to do everything perfectly. Your relentless pursuit for that ideal is only going to drown you."}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"G17","narrator":false,"pages":[{"spans":[{"text":"Everyone seemed pretty at ease on the helicopter. You were the only one on edge."}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"SSG 69","narrator":false,"pages":[{"spans":[{"text":"Heheh... We can totally steal the show if we just make an effort."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"That's not the point. We have absolutely no room for failure this time..."}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"G17","narrator":false,"pages":[{"spans":[{"text":"But isn't it odd for a PMC to be put in charge of