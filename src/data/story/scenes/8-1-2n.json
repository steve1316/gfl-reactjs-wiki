."}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"SSG 69","narrator":false,"pages":[{"spans":[{"text":"Hmph... Who cares. This is the perfect opportunity for us T-Dolls to shine! "}]},{"spans":[{"text":"Radiation, poison gas, Collapse Fluid - we can brave them all and remain steadfast. We were made for this, don't you think?"}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"G17","narrator":false,"pages":[{"spans":[{"text":"Just how much do you want to kill your audience...?"}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"May I have a word in private, SSG?"}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"SSG 69","narrator":false,"pages":[{"spans":[{"text":"Huh? Hold on. I was just kidding... As if I'd actually gas myself and walk on stage..."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Where are you going?"}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"I'll make good use of the additional authorization you've given me."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"SSG, this outpost isn't far from where you were destroyed last time."}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"SSG 69","narrator":false,"pages":[{"spans":[{"text":"Eh? So we chased after the convoy all the way here...? "}]},{"spans":[{"text":"No, wait... this hardly counts as \"not far\"!"}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"That doesn't matter. There's something I need you to do."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"blackscreenOff","value":"0.6","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click."}]}]},{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"Miss IWS... we're onto something. "}]},{"spans":[{"text":"We've detected faint traces of radiation residue. The convoy should be up ahead."}]}]}]}
