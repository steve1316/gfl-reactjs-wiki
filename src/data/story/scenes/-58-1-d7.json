{"name":"-58-1-D7","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"239","raw":"BIN"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outskirts of Neu-Tempelhof, Berlin."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q's seven-seater SUV is still parked in the same spot, but the agent herself is nowhere to be found. "}]},{"spans":[{"text":"AK-12 returns to the car looking very grim."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Sorry, Ange. She got away."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange scowls as she comes to a realization."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...She's been leading us in circles and wasting our time deliberately. "}]},{"spans":[{"text":"Forget about her. Since we can't get in touch with Q either, we're on our own."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I have good news and bad—"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Just spit it out!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The bad news is... the tracker I planted on Gray's tail was discovered. "}]},{"spans":[{"text":"Its last-known position before it got destroyed is somewhere in Berlin. "}]},{"spans":[{"text":"The good news is... Dandelion's latest location, which the Commander sent us... "}]},{"spans":[{"text":"...Happens to be in the same direction. Their destination is pretty obvious."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Where is it?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...The navigation system won't be of much help."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...The contamination zone?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...It's quite close to Berlin."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":21,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"This brings back some really bad memory. "}]},{"spans":[{"text":"Give me the car keys. I'll drive."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...But you could make your injuries worse."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 pats AN-94 on the back."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Sit in the back with 15. I'll ride shotgun and keep an eye on her."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange adjusts the driver's seat and rearview mirror, which reflects her tired face."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Are you sure about this? "}]},{"spans":[{"text":"Shouldn't we at least..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"At least what?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange looks at AK-12."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I know what you're thinking, but no support is coming. "}]},{"spans":[{"text":"If RPK-16 is so intent on stopping me from getting there, that's exactly what I'm gonna do."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 glances at AK-15 and AN-94."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Even if I say this is a bad idea, you're still going, aren't you?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Then I can't let you go on your own."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"318","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Outskirts of Berlin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"bgm","value":"BGM_23S_Crossroads_Warrior","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble... "}]},{"spans":[{"text":"Ange grips the steering wheel silently, her impatience apparent in the rearview mirror. "}]},{"spans":[{"text":"The scenery outside the car windows is dull and monotonous, while the atmosphere within the vehicle is somber. Everyone seems preoccupied with their own thoughts."}]}]},{"sprites":[{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Look at us, a proper suicide squad. "}]},{"spans":[{"text":"Our leader is covered in injuries and running head-first into a contamination zone to fight the Boss. "}]},{"spans":[{"text":"With no backup... and a stolen car."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I know what I'm doing."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Of course you do. "}]},{"spans":[{"text":"I'm sure you also know there is only so much we can do in this sorry state, yeah?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange sniffs. She is too busy fighting her exhaustion to respond to AK-12's quip."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Hold on. Stop the car."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...We're on the autobahn."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"There isn't a single car in sight. Not to mention, we've committed so many crimes, breaking one more traffic rule isn't going to kill us. "}]},{"spans":[{"text":"The same can't be said if you keep driving. Your eyelids are drooping."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_brake","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Screech... "}]},{"spans":[{"text":"Ange slams on the brakes wordlessly."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's better."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I'm just preserving my strength for what comes next."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange opens the door and gets out of the vehicle. She switches seats with AK-15 in the back."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I was offering to drive... but this works too."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Satisfied that the engine has started, Ange leans back and slowly closes her eyes."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Button_Click","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 looks into the rearview mirror and turns on the radio."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_ED_Phonograph_Disc","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Soothing music starts playing. "}]},{"spans":[{"text":"As night falls, the fog gradually rises outside the windows, creating a rare moment of tranquility."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...Strange."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I think I've heard this song somewhere before..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 concentrates and listens for a while."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's a common tune on the radio. Nothing special."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...Hm, that's weird."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What is it this time?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Don't you think we've been driving for too long? "}]},{"spans":[{"text":"This motorway seems endless. I don't remember it being so long on our way here. "}]},{"spans":[{"text":"We should've passed through the quarantine wall by now."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzt..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, the radio suddenly crackles ominously."}]}]},{"sprites":[],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...You're always so stubborn, Ange.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"}],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"The Commander was only dispatched to Berlin because of your rash decision.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So many have paid a heavy price for what you've done. Won't you at least reflect on your actions a little?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"RPK!"}]}]},{"sprites":[],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"You just never listen, Ange.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You knew this would be a path of no return, yet you carried on regardless.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You forced me to prove my allegiance to my true master.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Your true...?"}]}]},{"sprites":[{"prefab":"AK15","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...The vehicle is out of control!"}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"94, keep Ange safe!"}]}]},{"sprites":[{"prefab":"AK15","expression":4,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_brake","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The wheels pivot sharply, causing the vehicle to overturn without warning."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Its momentum propels it straight off the road. "}]},{"spans":[{"text":"Ange feels herself free-falling in an endless moment of weightlessness."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":22,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Ugh!"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1.5","raw":"CGDelay"},{"type":"effect","value":"%%code=AVG_zhayan%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The roof of the vehicle, the seats, as well as Task Force DEFY... Everything seems to have disappeared... or perhaps engulfed by darkness."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The state of weightlessness stretches on. To make matters worse, Ange's ears start ringing painfully."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":22,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Argh!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...There are better battlefields to give your life on, Ange. "}]},{"spans":[{"text":"You mustn't fall here."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"12...?!"}]}]},{"sprites":[{"prefab":"AK15","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Ange, wake up."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I'm awake. Where am I...?"}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, Ange... We failed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"If everything in life is futile, then what is the point in struggling?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_bigglassbreak","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk!"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"I can only show my loyalty through betrayal. "}]},{"spans":[{"text":"I am you, when I am I."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"183","raw":"BIN"},{"type":"sfx","value":"AVG_Rain_Heavy","raw":"SE1"},{"type":"effect","value":"%%code=NoiseVideo%%wait=1%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"641","raw":"BIN"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"No matter how many times you lose your memory, no matter how the people around you present themselves, you never change your mind. "}]},{"spans":[{"text":"I expected nothing less from my student."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You don't seem to know her well enough."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"It doesn't matter. Time is fair to each and every one of us—especially you. Now, I have the opportunity to understand it all."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"655","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Martha Meitner, I dare not believe any of this. "}]},{"spans":[{"text":"To think you actually went and sacrificed your own student... "}]},{"spans":[{"text":"Haven't we reached the conclusion long ago? This immortality... resurrection... whatever you'd like to call it... It's nothing but pointless fantasy! "}]},{"spans":[{"text":"This is murder—pure and simple. Butchery—an affront to human life in the name of your own ideals. "}]},{"spans":[{"text":"This is a betrayal of those very ideals. "}]},{"spans":[{"text":"If I had known from the start that this was what you're trying to achieve with the Evangel Axis... I would have never agreed to using this technology on Sana! "}]},{"spans":[{"text":"Martha, you deceived me... None of this was for Sana at all... "}]},{"spans":[{"text":"You! You servant of evil! "}]},{"spans":[{"text":"Blackwell, Berlin, 2051."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
