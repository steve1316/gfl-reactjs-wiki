ages":[{"spans":[{"text":"Inside the truck."}]}]},{"sprites":[{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"Hey, hey, hey! What's going on!? Are we just going to haul all these crates away?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M26 hurries inside the truck, but all she sees is SCR."}]}]},{"sprites":[{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"...Where's Leader?"}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"\"I'm leaving this place to you...\""}]}]},{"sprites":[{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"Say what?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she looks at SCR, who's still muttering to herself while spacing out, M26 can't help but freeze up."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Ah..."}]},{"spans":[{"text":"Leader went to chase someone."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"HAH!? Are you kidding me?! Does she even know who she is!?"}]},{"spans":[{"text":"What kind of commander abandons their post to go chase after people!?"}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Miss Aliana has a plan."}]},{"spans":[{"text":"In any case, let's move all of this back to Griffin."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"Fine... I'll contact the Commander."}]},{"spans":[{"text":"SCR, you keep trying to contact Aliana."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"...Okay."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SCR nods."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"542","raw":"BIN"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep, beep."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Scar_Battle","raw":"BGM"}],"speaker":"\"Daybreak\" System","narrator":false,"pages":[{"spans":[{"text":"\"Moon\" reaction detected.","style":{"color":"#99CC33"}}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...Hm?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The scan was never that clear to begin with, but now it's throwing up a fresh oddity."}]},{"spans":[{"text":"Aliana comes to a halt and rechecks it."}]},{"spans":[{"text":"...There's no malfunction. There are now two \"Moon\" reactions."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Is this a trick? Or...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...There's no time for delay."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana's furrowed brows loosen. After hesitating for just a moment, she heads straight for one of the positions she detected."}]},{"spans":[{"text":"Originally, she would never have needed to choose."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"471","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the plaza outside the Berlin Hauptbahnhof."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo gently strokes a puppy's head, and the puppy tenderly nuzzles up against her hand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Its master runs up, panting heavily as he grabs the dog's leash."}]}]},{"sprites":[],"ops":[],"speaker":"Dog Owner","narrator":false,"pages":[{"spans":[{"text":"Thanks for catching this dumb dog of mine."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"You're welcome."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Simo smiles and pats the puppy's collar for the last time before leaving."}]},{"spans":[{"text":"Yet another shell casing has disappeared from the ones she is holding in her palm."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"Now, the last one..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Drop","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo tosses the last of the shell casings fitted with jammers into a plant pot by the plaza."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"Now there should be four separate mes on her sensors. "}]},{"spans":[{"text":"That ought to delay her for about 15 minutes... No, it might only delay her for five."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"549","raw":"BIN"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo hurriedly walks through the bustling plaza, rubbing shoulders with all kinds of people."}]},{"spans":[{"text":"Despite the chaos and upheaval taking place not far away, it does not spark so much as a ripple in this stagnant world."}]},{"spans":[{"text":"The numbed people, the lively people, and the ones who are like walking corpses..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Scar_Morichongfeng","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Each and every one of them has their own destination. Whether the looks on their faces are ones of anticipation or indifference, they all head toward their endpoint, one step at a time."}]},{"spans":[{"text":"In this vast place. She is the one, sole and only person who does not fit in."}]},{"spans":[{"text":"She has no destination."}]},{"spans":[{"text":"Right now, the setting sun is slowly sinking into the end of day."}]},{"spans":[{"text":"Its faint light, that inch of golden radiance, shines equally on everyone's heads and shoulders without fear or favor, limning them with a gentle halo of light."}]},{"spans":[{"text":"Day and night, dawn and dusk, sun and moon."}]},{"spans":[{"text":"This is a liminal moment, and the most beautiful time of day."}]},{"spans":[{"text":"It is sunset."}]}]},{"sprites":[],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.2%%duration=2%%","raw":"bg_move"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"The contours of the milling crowd look like they have a veil on them as they fade into the embers of nightfall."}]},{"spans":[{"text":"They are indistinct as they file past each other, like birds winging across the sky."}]},{"spans":[{"text":"They are lonely souls constantly encountering each other on life's long journey. Perhaps they may have travelled together once."}]},{"spans":[{"text":"But in the end, they will return to being alone."}]},{"spans":[{"text":"Samo looks in the direction of the light."}]},{"spans":[{"text":"The brightest star in the sky is still dazzling, even right before the end."}]},{"spans":[{"text":"She can't help but narrow her eyes slightly—"}]},{"spans":[{"text":"It's neither too bright, nor too dark."}]},{"spans":[{"text":"It's like a tall, rainbow-colored goblet filled with champagne, swirling and sparkling with life."}]},{"spans":[{"text":"I've got you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She is in the shadows of dusk, just two or three steps away."}]},{"spans":[{"text":"As though destiny had played a trifling yet lethal joke on her."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...Got you."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"540","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The familiar voice suddenly speaks into her ear."}]},{"spans":[{"text":"The words don't sound like they're being said in the real world, but more like they're being spoken directly into Samo's neural cloud."}]},{"spans":[{"text":"That voice is so unreal that it feels like she's dreaming..."}]},{"spans":[{"text":"Samo looks up. Those eyes, which never opened all this time, now radiate a cold, keen glint for the first time."}]},{"spans":[{"text":"Bloodlust boils out from under the brim of her cap, and uncontrollable rage scatters the air between the two of them."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She's forgotten how long it's been since she last felt this way."}]}]},{"sprites":[],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"It feels just like yesterday to me."}]},{"spans":[{"text":"But to you, it's been a full 13 years."}]},{"spans":[{"text":"Your mangled body, your confused neural cloud, even your systems are still from ‘51."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Can you still hold a gun?"}]},{"spans":[{"text":"\"Daybreak\" Squad's—"}]},{"spans":[{"text":"Deserter."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo looks up again. The brim of her cap can no longer hide her rage."}]},{"spans":[{"text":"This is also the first time she's expressed such an emotion."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"You have NO right to say that to me."}]},{"spans":[{"text":"You..."}]},{"spans":[{"text":"You TRAITOR!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Remember what I said to you last time?"}]},{"spans":[{"text":"We are both just toys in the hands of an evershifting creator."}]},{"spans":[{"text":"The fate decreed for \"Daybreak\" was no accident, and Fate has declared that I will make \"Daybreak\" last forever."}]},{"spans":[{"text":"All you need to do is accept it, accept the fact that I will end your life."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"...I will kill you."}]}]},{"sprites":[],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"You can't do it."}]},{"spans":[{"text":"...Coward."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is a fire burning in her eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"Aliana, you'd better kill me now."}]},{"spans":[{"text":"Or else, you'll die by my hand."}]}]},{"sprites":[],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.5%%duration=2%%","raw":"bg_move"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana takes a few steps closer to her."}]}]},{"sprites":[],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"At last, we're going to put an end to that mission of ours that has remained incomplete for 13 years."}]},{"spans":[{"text":"Right now, killing you would be as easy as crushing an ant."}]},{"spans":[{"text":"But you may rejoice; I will not do anything to you in such a crowded place."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Yes, hate me. That will bring some amusement to our final showdown."}]},{"spans":[{"text":"I will personally finish you off, just not right now."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The setting sun finally descends, and the last rays of its light are replaced by those of the moon."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"You have five minutes to run. If I were you, I'd be turning tail already."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"541","raw":"BIN"},{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo's hands clench into fists."}]},{"spans":[{"text":"The hatred in her eyes looks like it could burn the entire world to ash."}]},{"spans":[{"text":"Under the setting sun's light, they look like twin moons suspended in the night sky."}]}]},{"sprites":[],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"...Just you wait, Aliana."}]},{"spans":[{"text":"You'll die someday, not in anyone else's hands, but mine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]}]}
