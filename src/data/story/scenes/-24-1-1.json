{"name":"-24-1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"161","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Alarm","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...An hour before the dirty bomb exploded, at the temporary Griffin Command Post."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Attention, all T-Dolls! "}]},{"spans":[{"text":"The Military has already breached the outer defensive perimeter of the Command Post! All combatants are to follow the briefed contingency plan and withdraw immediately! "}]},{"spans":[{"text":"9A-91, Thompson, both of your teams need to hold your defensive positions and secure the other Dolls' retreat!"}]}]},{"sprites":[{"prefab":"9A91","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"9A-91","narrator":false,"pages":[{"spans":[{"text":"Where's the Commander? We need orders, otherwise we can't mount an effective counterattack!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"9A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"The Commander is still coordinating the battle and cannot move from their current position!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"We're fighting the damn Military here. We won't last long without the Boss around!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Aaaaaahhhh, screw this! Let me give it a shot, then!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"9A91","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"9A-91","narrator":false,"pages":[{"spans":[{"text":"You...?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"9A91","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I've learned rudimentary tactics and commanding while serving with the Commander, y'know? I'm not that experienced, but I can at least serve to bolster your operational efficiency a little!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"9A91","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"9A-91","narrator":false,"pages":[{"spans":[{"text":"That'll do, Miss Kalina.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"We'll leave the rest to you then.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Let's move on forward, for Griffin, and for all of our friends!"}]}]}]}
