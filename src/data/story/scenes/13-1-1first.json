{"name":"13-1-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"m_avg_labyrinth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sensation of the electronic attack gradually subsides, and Anna can feel the consciousness of her peers stirring."}]}]},{"sprites":[{"prefab":"Nytochild01","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"The feels...just like...the day when the gates were sealed."}]}]},{"sprites":[],"ops":[{"type":"background","value":"244","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A blurry figure emerges in her mind. "}]},{"spans":[{"text":"That familiar person tilted Anna's chin up gently – there was no sign of any inhibitors on her glossy hair. "}]},{"spans":[{"text":"Anna tried to lean closer with all her might, but the person kept a firm distance away from her."}]}]},{"sprites":[{"prefab":"？？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"\"Stay here with our young ones. Remain with those who still have hope.\""}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I want to go with you. Can't I come? "}]},{"spans":[{"text":"I'm all grown up! I can fight, just like you!"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"\"You are a blessed and cherished child. You need to protect those who still have a chance of surviving.\""}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"If you leave this place, will everything still be the same?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"\"We will meet again – on the other side of Zion. When the moment comes, you will hear us calling out to you.\""}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They left. "}]},{"spans":[{"text":"They all headed out to fight for us."}]}]},{"sprites":[],"ops":[{"type":"background","value":"173","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Their connections disappeared in my mind."}]}]},{"sprites":[],"ops":[{"type":"background","value":"175","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Are they dead? But didn't Father say we would never die?!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"203","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"We have always believed in Father, but they told us we mustn't trust him just before they left. "}]},{"spans":[{"text":"I can't hear them anymore, but now I'm hearing voices that I've never heard before."}]}]},{"sprites":[],"ops":[{"type":"background","value":"178","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A consciousness from the outside? "}]},{"spans":[{"text":"There are others who can also hear the voices in Zion? "}]},{"spans":[{"text":"Will their arrival be our salvation or our demise?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"107","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But no one has any answers for me."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"If I could grow just a bit taller... If I could make myself more useful... Would I be able to fight by their side? "}]},{"spans":[{"text":"That way, would I be able to find out the truth?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is she still not awake? The attack should have been neutralized already."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Maybe you weren't thorough enough?"}]}]},{"sprites":[{"prefab":"Nytochild01","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"229","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"shake","raw":"震屏"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Ugh...!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Ah, looks like your relative is coming to."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You were breathing very rapidly. Bad dream?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange then notices the tears streaming down her cheeks."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Are you afraid?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I...I'm not!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna hurriedly wipes the tears off her face and looks at the people around her with forced composure."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"So...can you get us out of here, as we've agreed?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Right, it's time we kept our end of the bargain. "}]},{"spans":[{"text":"That scary lady over there will come up with something."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"This is hardly the time for jokes. "}]},{"spans":[{"text":"Being a nanny isn't part of my mission."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange strokes Anna's black hair gently to calm her down."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Like us, she has lost precious friends."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Could you lift the quarantine in this facility, Anna? Time is short."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Yeah... My sisters have all awakened. We will disable the locks within Zion."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Zion?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Like Dolls, these children can connect to a cyberspace in their minds – a place they refer to as \"Zion\". "}]},{"spans":[{"text":"According to Anna, there is only one way to access Zion, and it's where their consciousness intertwine."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Humans whose consciousness can be transferred like Dolls'? "}]},{"spans":[{"text":"That sounds like bad news... Jeez, how far has his experimentation gone...?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I'm guessing this is only part of the experiments that have been going on here. "}]},{"spans":[{"text":"That's all the information we have gathered for now; more details can only be gleaned after we return and conduct further analysis. "}]},{"spans":[{"text":"I'm sure you catch my drift."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"BGM_Victory","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna and the other juvenile Nytos hold hands and close their eyes in unison. "}]},{"spans":[{"text":"The Dolls can clearly perceive the communications interference clearing up. The signals of the sealed passage turn from red to green. The hum of machinery can be heard coming from all directions, and all the lights flicker back on."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Looks like the lockdown has been lifted. "}]},{"spans":[{"text":"Let's give the comms a try... Anyone copy?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9's Voice","narrator":false,"pages":[{"spans":[{"text":"Positive! Are you alright, 45?!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Can you hear me?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Comms have indeed been restored. "}]},{"spans":[{"text":"I'm fine, we have things under control here; Ange and DEFY are all okay. "}]},{"spans":[{"text":"Come join us in the foyer of the lab – sending you the route right now. I'll fill you in on the details when you get here."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9's Voice","narrator":false,"pages":[{"spans":[{"text":"Understood, we're on our way!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"45 turns back toward the group. Ange seems to have also got in touch with the Commander. "}]},{"spans":[{"text":"Task Force DEFY is in the process of replenishing their ammo."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I see you've caught on."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So we're completely destroying the lab... If I remember correctly, this course of action is reserved for the worst-case scenario."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's only true to the big wigs, but it will work out just fine for us."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"But if we do that, how are we going to trace the guy?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"All the info we can gather from this place is already in your storage drive; I also have another backup copy stored within 12's neural cloud. Let's try to get back alive before we worry about the rest. "}]},{"spans":[{"text":"The things in this lab are simply too dangerous. No one should ever get their hands on such dreadful technology."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"\"These children are all victims; they do not deserve to die here, but we must never breathe a word about what they are capable of,\" yeah? "}]},{"spans":[{"text":"What are your plans?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The Commander and I have brought each other up to speed. "}]},{"spans":[{"text":"Griffin's forces managed to cut off most of the Military troops. Meanwhile, the AR Team is venturing into the lower levels in pursuit of Yegor's mech unit. We are going to regroup with them and intercept him together. "}]},{"spans":[{"text":"I'll have the Commander blow up the seawater valves and completely flood the lower levels, including this place. "}]},{"spans":[{"text":"Your job is to get these kids out of here safely. Griffin could also use some reinforcements. "}]},{"spans":[{"text":"Rendezvous with them and secure a route for us to retreat."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Are you sure you can retreat at all?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"The Sangvis Mastermind is about to activate the Starfish. The best course of action would be to pull the AR Team out right now and just flood the entire base."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"What...?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"It was the Sangvis Mastermind who hacked me just now, telling me that she was going to begin her coalescence with the Starfish. "}]},{"spans":[{"text":"I'm not sure what exactly she's planning to do, but I have a really bad feeling about this. "}]},{"spans":[{"text":"If our previous intel is correct, then M4 also has an OGAS consciousness inside her neural cloud, right? If the AR Team enters the lower levels, even I can't tell how many variables that'll introduce to the equation."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Then we must act now. AK-12?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She's right. Collapse radiation levels are rising; the blue luminescence is growing in intensity."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Things are deviating from our original plan – or perhaps it has never been his plan to let the Military activate the Starfish...? "}]},{"spans":[{"text":"Whatever the case, we've got to get going this instant."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"AN-94 and I are ready whenever you are."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Then let's go. "}]},{"spans":[{"text":"45, take care of the children."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Turning a deaf ear to my suggestion, are we?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I heard you, which is all the more reason for me to get down there right now. "}]},{"spans":[{"text":"M4 is after her own objective; we can't stop her if her mind is set. "}]},{"spans":[{"text":"But we CAN stop Yegor and make sure he doesn't get what he wants."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Let me come with you."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We don't have the resources to fix you up again, 45."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"If I don't make it back, you'll find the password to my account hidden within the second shelf of the bookcase in the study in the Putryntsi safe house. The money in there should cover the sum that I owe you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange picks up her rifle and is about to leave when Anna tugs at the hem of her coat from behind."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Are you also leaving us?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"There is something that I have to do. "}]},{"spans":[{"text":"This Doll may look weird, but you can trust her. "}]},{"spans":[{"text":"She and her squad will fulfill my promise."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Nytochild01","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange slings the weapon onto her shoulder. The two DEFY members take their positions close behind."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I'm leaving them to you. I need to go."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"If you don't come back, I'll withdraw every single cent in your account and spend it all."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I know – think of it as compensation for all the outrageous and unreasonable missions I've given you in the past. "}]},{"spans":[{"text":"Now do your job. Griffin also needs you, got that?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"When have I ever disappointed you?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange nods; 12 and 94 also give 45 a wave. Then the trio exit the foyer without a backward glance and vanish into the dark expanse."}]}]}]}
