{"name":"-54-C-5","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"420","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Inside the restroom of Carriage F09 (Dining Carriage) of the Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Which of you is the agent on a secret mission?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Or are you both agents?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR18","expression":4,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila starts up the jammer without saying a word, and the restroom immediately becomes a no-service zone."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"An agent? I'm not an agent... "}]},{"spans":[{"text":"Are you?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila ignores Erma's question."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"If it's just a matter of memory loss, then it won't affect your survival. "}]},{"spans":[{"text":"Get off when you reach your stop and never get back on this train again. "}]},{"spans":[{"text":"The \"Colt Express\" especially. The black market is not simple as you might think. Given your background, she must be letting you board for some ulterior motive."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...My memory loss does affect my survival. "}]},{"spans":[{"text":"This isn't the first time I've lost memories. I keep losing them repeatedly. "}]},{"spans":[{"text":"No technician can fix my issues, and if I want to live on as my whole self, I need to solve my memory problems."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Your whole self? "}]},{"spans":[{"text":"Yeah, that definitely sounds like the kind of crap that Hume would have done."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You know \"Mama\"?!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila stops aiming her gun at Erma and reattaches her arm."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Don't mention anything about Doctor Hume to anyone. Not even a word. "}]},{"spans":[{"text":"The next person you face might not be as good-tempered as me."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"So you ARE a Soviet agent? "}]},{"spans":[{"text":"Then you believe what I'm saying?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...You might have misunderstood something. I have no need to believe you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila takes her pistol out from under her coat and loads a magazine."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"I'm on some very urgent business here. "}]},{"spans":[{"text":"You'd better find a place to hide."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma bites her lip and thinks for a bit."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"And what will you do if I listen to you and hide?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"I need to head back to my carriage."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You're going to go through those people outside?!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"No way, it's too risky!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...That isn't something you should be worried about."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Of COURSE I'm worried about you! "}]},{"spans":[{"text":"Who will I ask about Doctor Hume if you're gone?! "}]},{"spans":[{"text":"...And you forbade me from asking other people, so I can only turn to you. "}]},{"spans":[{"text":"Which carriage are you in? I'm coming with you!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Have you been fitted with a fire control core?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma goes silent for a few seconds."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I can't be sure."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila peels off her glove and takes Erma's hand."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"534","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"By the time Erma comes to her senses, she's returned to her own neural cloud."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"When did I..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Summer Garden has a door that wasn't there before."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma walks toward that unfamiliar door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"If she hadn't gone over deliberately, she might not have noticed that unassuming door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She places a hand on its cool metal handle, then works up her courage and presses down..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"168","raw":"BIN"},{"type":"bgm","value":"10254","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The door opens to reveal a filthy, messy street. "}]},{"spans":[{"text":"It looks a bit like the street that Erma had passed through while visiting the black market, but it isn't the same one. "}]},{"spans":[{"text":"The signs on the sides of the street are murky, and she can't make out the letters."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"What IS this place?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma is standing in the middle of a narrow road, holding something warm and soft in her right hand. "}]},{"spans":[{"text":"Someone's holding her hand, and she can feel the other person's racing heartbeat through her palm."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I'm just feeling a little weak..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They pant and wipe away the sweat beading on their forehead as though they had just finished some intense exercise."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud-thud-thud— "}]},{"spans":[{"text":"The sound of running footsteps—belonging to around seven or eight people—is heading their way."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Shh—"}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Why do we have to run?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The warm hand takes hers and they start running again."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They pass through the oppressively narrow alleys and avoid the angry shouts. Through it all, Erma maintains her grip on the other person's hand, and no matter what obstacles lie ahead... "}]},{"spans":[{"text":"For just a moment, she wishes they could keep running like this forever."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Erma, take this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_File_Put","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The other person shelters her around a corner. In place of that warm hand is a cold metal object."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"What is this?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It's an ability that you once had... "}]},{"spans":[{"text":"Load module— "}]},{"spans":[{"text":"Disable fire control core inhibitor."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
