alse,"pages":[{"spans":[{"text":"Then start hurling abuse, like you usually do.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"Ha, you can't do that because you need me to get you out of this mess.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Ёбаная ты сука."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"How very like you. Such a unique way of begging for a favor.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange rubs her throbbing temples. Holding back the urge to annihilate the world, she looks at the hateful face in the communicator."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":