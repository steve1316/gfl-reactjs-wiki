":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What's this..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She gets up from the floor irritably, steps over the stains left by her cold sweat, and looks for the source of the vibration. "}]},{"spans":[{"text":"Soon, the statue of wolves by the door catches her attention. The statue was a gift from Shaw. "}]},{"spans":[{"text":"She spots the strange glint in the eyes of one of the wolves, so she reaches out a hand—"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-shaw","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"bgm","value":"10051","raw":"BGM"}],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"Ange, we meet again.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"When did this..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"Actually, it's 12's idea.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"AK12","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Hi, Commander Angelia. Long time no see. Surprised?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"AK12","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"AK12","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Always keep an eye on even one's closest ally—you taught me that.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I didn't tell you to... Nevermind. Thanks to you, I can still communicate with the outside world."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":14,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"I hear you're in big trouble.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Not really, but the timing is truly terrible..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}},{"prefab":"NPC-shaw","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Shaw","narrator":false,"pages":[{"spans":[{"text":"By the by, my offer st