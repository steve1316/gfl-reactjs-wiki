{"name":"-5-1-3Round10","beats":[{"sprites":[],"ops":[{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, in the Factory at Griffin HQ."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, our freighters have completed the cannon extraction."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Fantastic. Serendipity never fails to cheer me up."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"(Chuckles) Perhaps this has something to do with your previous job?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"I don't deny that. "}]},{"spans":[{"text":"Besides, not many contractors can get their hands on the Military's technology."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"By the way, the Commander is still on the frontline. Should we give the order to withdraw?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Not yet. "}]},{"spans":[{"text":"If the Commander's team is still holding up, keep the operation going. "}]},{"spans":[{"text":"Reward them according to their performance in battle after the withdrawal."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Are you...testing the Commander's limit?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Not testing. Exploring. "}]},{"spans":[{"text":"We'll need that knowledge one day. "}]},{"spans":[{"text":"Regarding Squad 404, Have the neural clouds of all witnesses been wiped?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes. However, there is still some leftover memory in M16A1..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"I know. Things from before the creation of 404 don't matter. "}]},{"spans":[{"text":"Give them a holiday. They need it. "}]},{"spans":[{"text":"Perhaps we need one, too."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sunshine","raw":"BGM"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"When the Commander returns, perhaps we should organize a banquet... "}]},{"spans":[{"text":"Something...warm. "}]},{"spans":[{"text":"To celebrate spring, festivities, victory, and all things bright and beautiful... "}]},{"spans":[{"text":"To give thanks to the Commander as well as the T-Dolls. They have all worked hard."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"No problem. You're in charge."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Play your part too, Mr. Kryuger. Try to come up with a speech that isn't so rigid."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"That's gonna be tough. "}]},{"spans":[{"text":"I'm not sure if I can finish it before the Commander makes it back."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Don't worry. The Commander is going to last very long. "}]},{"spans":[{"text":"How about a bet? On who's the first to finish their job?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Well, let's wait and see..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"【HINT】Keep defending against Sangvis attacks to earn more rewards."}]}]}]}
