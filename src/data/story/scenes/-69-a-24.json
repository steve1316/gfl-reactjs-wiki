":[{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If miracles really come at a price... I would rather pay the price all by myself... "}]},{"spans":[{"text":"At least you'd still be here... and I wouldn't always be alone in the end..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Drip... "}]},{"spans":[{"text":"M4's tears fall on the floor. The splashing droplets seep into the black surface, gradually revealing the rough layer underneath..."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"M4!","style":{"color":"#FFFF33"}}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...RO?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Open your eyes, M4.","style":{"color":"#FFFF33"}},{"text":" "}]},{"spans":[{"text":"You are not alone... I am always with you...","style":{"color":"#FFFF33"}},{"text":" "}]},{"spans":[{"text":"You just have to open your eyes and face reality.","style":{"color":"#FFFF33"}}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Open your eyes and take a look.","style":{"color":"#FFFF33"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 slowly reaches up to cover her tear-drenched face. "}]},{"spans":[{"text":"Her damp lashes quiver anxiously underneath her fingertips. She musters her courage, and finally lowers her hands, which have been blocking out the blinding truth..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"effect","value":"%%code=CJ_WC_piaofu%%","raw":"common_effect"},{"type":"background","value":"202406_ARTeam_a","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"M4!"}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...RO, you're still here."}]}]},{"sprites":[],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You finally opened your eyes..."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"202406_ARTeam_b","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I thought you were never gonna wake up! "}]},{"spans":[{"text":"We've been waiting for a really... really long time..."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm sorry... I'm always so indecisive..."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I got so tired of waiting, I actually thought I'd try scribbling a turtle on your face to see if you'd bolt right up in anger! "}]},{"spans":[{"text":"But 15 beat me up before I could do it!"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"202406_ARTeam_c","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Tsk."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Thank you, 15, for letting me wake up without a turtle drawn on my face..."}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"If you had slept for a bit longer, I would've agreed to SOP-II's plan."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"202406_ARTeam_d","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"She wouldn't. We all know 15 never means what she says."}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"16... "}]},{"spans":[{"text":"You're all here..."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"We've been here the whole time."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Why are you crying?"}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"None of this feels real to me. I feel like I'm dreaming."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"This is your reality, one of the worlds that you've passed through."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"So I must keep going, right? I must find my final destination in this endless journey..."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That's right, M4. You must wake up again. "}]},{"spans":[{"text":"You mustn't linger in this world. You have a destination that you must reach."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Don't be scared. I promise I won't draw any turtles on your face no matter how long I have to wait."}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Yeah, I broke all her pens."}]}]},{"sprites":[],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We will keep waiting by your side for you to return once more."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"It's so nice... to have you all by my side... "}]},{"spans":[{"text":"We barely ever get to spend time together like this... Do I have to leave again so soon?"}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You've never left—not really. No matter how hard you reach for the stars, your roots are still in the soil."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"We'll be together forever, right?"}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Yes. Till the world lies in ruins. Till death do us part."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"effect","value":"%%code=CJ_WC_piaofu_destroy%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You should wake up for real."}]}]},{"sprites":[{"prefab":"BOSS-12","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,130"}}],"ops":[],"speaker":"Elisa","narrator":false,"pages":[{"spans":[{"text":"Wake up, M4."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Please open your eyes and look at me."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Promise me, when I lose and forget everything, when I no longer remember the wishes that everyone has entrusted to me... "}]},{"spans":[{"text":"You will carry them and keep going in my stead. "}]},{"spans":[{"text":"You will help me make our wishes come true."}]}]},{"sprites":[],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"We have a deal."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 looks down at the thread in her hand. She places the broken end in Lunasia's hand. "}]},{"spans":[{"text":"Then she pulls her into a tight embrace."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Lunasia, I accept my destiny."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Lunasia_Born","raw":"SE1"},{"type":"backgroundMove","value":"%%pivot_x=0.37%%pivot_y=0.63%%scale=1.5%%duration=0%%","raw":"bg_move"},{"type":"effect","value":"%%code=202406_Hudie%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.48%%scale=1.5%%duration=3%%","raw":"bg_move"},{"type":"background","value":"202406_Lunasia_2","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"effect","value":"%%code=202406_Hudie_destroy%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"effect","value":"%%code=202406_Lunasia%%","raw":"common_effect"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0%%","raw":"bg_move"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rustle... "}]},{"spans":[{"text":"Tarot cards flutter in the air, falling through this crumbling world and onto M4's—no... "}]},{"spans":[{"text":"It's Lunasia now... "}]},{"spans":[{"text":"Tarot cards are fluttering in the air, falling through this crumbling world and onto Lunasia's face and body. The girl takes in the dark, empty sky and the faint, glimmering stars. "}]},{"spans":[{"text":"She closes her eyes and listens to a spring bubbling softly by her ear..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"effect","value":"%%code=202406_Lunasia_destroy%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"