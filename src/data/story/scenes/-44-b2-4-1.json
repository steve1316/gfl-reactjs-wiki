{"name":"-44-B2-4-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"82","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...That night, in Machlian's room in the temporary command post. "}]},{"spans":[{"text":"ST AR-15 stands by Machlian's bed, looking down at her sleeping face with unbridled hostility."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Stop pretending."}]}]},{"sprites":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I know you're only faking it."}]}]},{"sprites":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Deep in the realm of sleep, Machlian does not respond to ST AR-15's accusation."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I never thought Dolls could go crazy...until tonight."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I knew you'd show up too."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speake