{"name":"-74-A-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202408_Room_c","raw":"BIN"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Office of the Minister of the Interior."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! "}]},{"spans":[{"text":"The heavy door is shoved open. "}]},{"spans":[{"text":"Inside, a man in a suit rises to his feet."}]}]},{"sprites":[],"ops":[],"speaker":"Chief Secretary","narrator":false,"pages":[{"spans":[{"text":"This is the Minister of the Interior's office, may I ask who—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before he can finish, a squad of armed soldiers stream in."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The secretary recognizes them immediately—the current Ministry for State Security, Romy Riefenstahl... and someone who should not be here at all—Commander Felix of the Hugo Eberlein Guard Regiment."}]}]},{"sprites":[],"ops":[],"speaker":"Chief Secretary","narrator":false,"pages":[{"spans":[{"text":"...The Minister is in a joint session with the Council of Ministers and the National Defense Council. "}]},{"spans":[{"text":"Even the Stasi—"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"},{"type":"sfx","value":"AVG_21Winter_FT_Heel","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":"Romy","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"The GDR is now in a state of war. For the moment, internal security falls under the Ministry for State Security. "}]},{"spans":[{"text":"As chief secretary, prepare a meeting room and summon all the ministers. "}]},{"spans":[{"text":"Commander Felix and I will assign the upcoming work together."}]}]},{"sprites":[],"ops":[],"speaker":"Chief Secretary","narrator":false,"pages":[{"spans":[{"text":"...Impossible... You... "}]},{"spans":[{"text":"Riefenstahl, this is treason! "}]},{"spans":[{"text":"You're a traitor to the German Democratic Republic!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"I'm afraid the traitor is your Minister. "}]},{"spans":[{"text":"Since you are unfit to carry out your duties..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy taps the shoulder of a stunned deputy secretary."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"From now on, you will take his place. "}]},{"spans":[{"text":"Now get all the ministers to gather."}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Secretary A","narrator":false,"pages":[{"spans":[{"text":"...Yes, ma'am."}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Secretary B","narrator":false,"pages":[{"spans":[{"text":"May I ask... what has happened to our Minister?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"He sold out the GDR by passing critical military intelligence to Carter. "}]},{"spans":[{"text":"He will be imprisoned on charges of treason, disclosure of state secrets, violation of official secrecy, and dereliction of duty."}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Secretary B","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The deputy secretaries quickly arrange for their assistants to start contacting all the ministries."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021summer_Office","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hoffmann's Office."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep-beep-beep. The communicator buzzes. "}]},{"spans":[{"text":"Hoffmann stirs his coffee and answers the call."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Agent K, turbulent times indeed. In just a few days, we've spoken more than in all of last year."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"\"But chaos is a ladder.\"","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"How well you know me, Agent K."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"If that's the only message you have, I'm hanging up.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Of course not. We've all been working around the clock; we could use a lighter topic to help ease our nerves, you know."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hoffmann sets down his cup, straightens his tie worn through an all-nighter, and sits upright."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"There's news from the Minister."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Good news?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Yes. We've secured command of the Spezialeinsatzkommando, the Civil Defense, and the Volkspolizei Alert Unit. "}]},{"spans":[{"text":"The commander of the Rapid Forces Division has also pledged cooperation for our next moves."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Things are going smoothly it almost feels unnatural.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"What about Chairwoman Ulrich's position?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"She has declared within the party that she stands firmly with Chairman Groß.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Excellent. How far are you from Frankfurt?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"The line may be tapped. I can't give coordinates, but we need more time.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"On the way to Frankfurt, multiple attempts on Chairwoman Ulrich's life have been made—we've dealt with six so far.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Did you interrogate the culprits?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I never got the chance. They all committed suicide when they failed.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"And Chairwoman Ulrich's condition?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"She's unharmed and calm enough—this is not her first assassination attempt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Regardless, you must reach Frankfurt before this war ends."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"We will do everything we can.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202404_BedRoom","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clatter."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"bgm","value":"BGM_ev2412_tranquility","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A secretary enters the meeting room. After putting down two cups of coffee and some pastries, he withdraws promptly. "}]},{"spans":[{"text":"The lavishly decorated room, currently occupied only by two men, feels eerily hollow. "}]},{"spans":[{"text":"One of them breaks the silence."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I didn't expect you to choose this room. "}]},{"spans":[{"text":"The last time we spoke here, it was to congratulate you for becoming General Secretary of the Socialist Unity Party."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"I chose it not for provocation. "}]},{"spans":[{"text":"But for reconciliation. "}]},{"spans":[{"text":"The party needs both of us. "}]},{"spans":[{"text":"The GDR needs both of us."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Enough with the false face, Groß. "}]},{"spans":[{"text":"Your ambition will destroy the GDR."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"And yours will destroy humanity itself."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"The Relics exist whether you use them or not. "}]},{"spans":[{"text":"Earth does not stop rotating just because man closes his eyes. "}]},{"spans":[{"text":"Technology... is the true lifeblood of the age."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"Herr Oberstein, you can't keep living in the past. "}]},{"spans":[{"text":"Look at the world today."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"The world today? It is nothing but the continuation of World War III. "}]},{"spans":[{"text":"I and my comrades defended Germany then."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"Yes. No one can deny history, Herr Oberstein."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"But now your eyes see only the past, not the future."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"You will never reach the future."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"I'll say that right back at you. "}]},{"spans":[{"text":"Relics are just tools—tools for obtaining power, not for causing humanity's annihilation."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I wholeheartedly agree. But who is our enemy? "}]},{"spans":[{"text":"They aren't in distant Antarctica. Our enemy is right here."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"No, our enemy lies within your heart—it is that withered ambition that will consume us all."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein's anger flares."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Groß! Have you forgotten who helped you rise to power?"}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"I am grateful. "}]},{"spans":[{"text":"Grateful that you chose me as your puppet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Groß looks at Oberstein coolly."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"But, you forget, Herr Oberstein—as a puppet, I have the right to enter the stage. "}]},{"spans":[{"text":"While you... have lost that right long ago."}]}]},{"sprites":[{"prefab":"NPC-Rudolf","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I don't need that. All I need is the power to replace the puppet at will."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam. The heavy alloy door slams shut as Oberstein storms out. "}]},{"spans":[{"text":"The talk ends not in peace. "}]},{"spans":[{"text":"But in open enmity."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202408_Room_b","raw":"BIN"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Back at his own office, Groß nods to his chief secretary."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"Contact Lord Griffin Lyons."}]}]},{"sprites":[],"ops":[],"speaker":"Chief Secretary","narrator":false,"pages":[{"spans":[{"text":"Yes, Herr."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The comms line connects. The chief secretary bows and leaves the office."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Your Excellency, I trust you have made your decision.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"We need a future. "}]},{"spans":[{"text":"Humanity needs a future."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Gross","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Only by passing on the flame will there be a future.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"There was a time when Oberstein was my most respected leader, my comrade."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"But he lives in the past.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Groß eases into his chair, his eyes falling on a photo on the desk of himself with Oberstein."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"As a brilliant technocrat, he rose above suffocating aristocratic politics through sheer ability. "}]},{"spans":[{"text":"In WWIII, he turned the tide—until tragedy bound him forever... "}]},{"spans":[{"text":"To this day, he is still consumed by the loss of his wife and daughter."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"He is only human. He has grown old.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"Because of that... he betrayed his family. "}]},{"spans":[{"text":"His own name. "}]},{"spans":[{"text":"He could neither stay in his position nor let go."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Beyond his past glories, all he has left is a broken body and a son that he clings to.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Gross","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"Fate repeats itself endlessly."}]}]},{"sp