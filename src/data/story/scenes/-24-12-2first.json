{"name":"-24-12-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The battle concludes."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"0,5","raw":"黑屏1"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"We've arrived, SOP-II! "}]},{"spans":[{"text":"I didn't think Scarecrow was actually telling the truth... "}]},{"spans":[{"text":"...SOP-II?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"AHHHHHHH—!","style":{"size":"55"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Cx4 Storm","narrator":false,"pages":[]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_NightOPS","raw":"BGM"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"SOP-II?!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"s