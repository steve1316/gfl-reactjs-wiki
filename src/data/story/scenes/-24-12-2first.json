}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"SOP-II..."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Heh, I'm probably not cut out to be a team leader. "}]},{"spans":[{"text":"Now, let's see what news our scouts bring us!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The recon T-Dolls return several minutes later and report their findings to Cx4. What they found is evident enough from the looks on their faces."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"...I'm sorry, SOP-II. There's nothing left here and we can't even establish comms. "}]},{"spans":[{"text":"We...we can't contact the Commander or find any clues..."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...So it was 