PIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Oh, this item is key. But don't tell anyone about it; they'll get the wrong idea. "}]},{"spans":[{"text":"In any case, I'm going to be sleeping for a long, long time, Cx4, so I'll need you to handle sentry duty with the others. "}]},{"spans":[{"text":"If anything happens, pat my body hard three times and cut the backup power, then I'll awake safely. Got that?"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"No problem! Still... will you be alright? "}]},{"spans":[{"text":"It feels like you're going to do something really dangerous..."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We've already done a lot of dangerous things today; all that matters is—"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"All that matters is the results, right? "}]},{"spans":[{"text":"I know, so relax and leave the outside to me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II nods, and Cx4 steps outside."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Now then..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II takes a deep breath."}]}]},{