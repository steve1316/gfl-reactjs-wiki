{"name":"-44-A0-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"5","raw":"BIN"},{"type":"sfx","value":"AVG_Helicopter","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bremen, Germany. Lower reaches of the Weser river."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This area is a considerable distance away from any human settlements. "}]},{"spans":[{"text":"The spaces within 50 meters on both sides of the river have been blocked off by black vans and cordoned with tape."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a helicopter rumbling overhead, a young man treks along the moss-covered path by the river with a briefcase in hand."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He can hear the conversation over the radio through the foliage."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Stasi Agent A","narrator":false,"pages":[{"spans":[{"text":"Zone D1 search complete. Nothing out of the ordinary.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Stasi Agent B","narrator":false,"pages":[{"spans":[{"text":"Zone A2 search complete. Nothing out of the ordinary.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Copy that. Keep searching and extend the perimeter by 1km. "}]},{"spans":[{"text":"Attention—\"Rabbit\" has escaped. Keep your eyes peeled and don't even miss a single tuft of her fur."}]}]},{"sprites":[],"ops":[],"speaker":"Stasi Agents A & B","narrator":false,"pages":[{"spans":[{"text":"Roger.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Stasi search agents have been working around the clock on the riverbanks for over 24 hours. "}]},{"spans":[{"text":"It has already been five days since Angelia crossed the German border."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is a faint rustle of a coat brushing over shrubbery. Detecting the approaching presence, K turns around. "}]},{"spans":[{"text":"As he makes out who it is, his rising unease disappears."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Sir."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Come."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Yes, sir."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The young man walks over to K. "}]},{"spans":[{"text":"His sharp gaze shifts to the river, where boats are still busy searching."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Time is short so I'll keep it brief. "}]},{"spans":[{"text":"Let's get straight to the point. You know why I've summoned you, Light?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Yes, I understand it is about Frau Angelia."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Have you read the report?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Yes, I am well aware of everything leading up to the confrontation between Frauen Angelia and Morridow. "}]},{"spans":[{"text":"It is J who has been following the case, isn't it?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"He's currently out of action, so you'll have to take over. "}]},{"spans":[{"text":"Now's your moment—have you chosen a letter for yourself?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Please stop making fun of me. "}]},{"spans":[{"text":"J is an exceptional agent—I still have much to learn from him."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Aw, where's your sense of humor?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I thought you said time was short."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You little... Nevermind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K turns and directs his attention back to the boats in the river."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Do you think Morridow died in there?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Difficult to say. None of the witnesses on the aircraft saw the moment of impact. "}]},{"spans":[{"text":"Even a well-trained agent could easily die when falling from that height. "}]},{"spans":[{"text":"Such a plunge could be fatal for ordinary civilians."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"But our little secretary is no ordinary civilian."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"That's true, and that's the problem. "}]},{"spans":[{"text":"According to Frau Angelia, Morridow is a new type of augmented human under the major criminal organization Paradeus. "}]},{"spans":[{"text":"Apparently, her strength is on par with AK-12 of the Wolf Pack."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"All information concerning Paradeus is still top secret. "}]},{"spans":[{"text":"We're making an exception here by filling you in, you understand?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"The aircraft bound for Chairwoman Ulrich's office building deviated from its original flight path yesterday. "}]},{"spans":[{"text":"The witnesses' accounts corroborate the fact that the confrontation took place as the aircraft was passing over the Wedersee."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Are the witnesses the pilot and Frau Angelia herself?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Indeed. "}]},{"spans":[{"text":"The scuffle lasted about six minutes, and when they reached the river, the suspect—Morridow—concluded that her plan had failed and decided to escape by jumping off the plane. "}]},{"spans":[{"text":"Once I caught word of the incident, I immediately sealed off the area within 5km of the scene. It was done in a rush, but I do not doubt the effectiveness of the blockade."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"But there is still no sign of her?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K shrugs."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"We can only assume that she has already left the scene before we got here. "}]},{"spans":[{"text":"Otherwise, I'll have to chalk it up to her being soluble in water."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"But it's not all doom and despair. "}]},{"spans":[{"text":"We have found some clues."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K taps his foot, indicating the stretch of the riverbank that they are standing on."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"An hour ago, we found the torn-off cabin door here. "}]},{"spans":[{"text":"There were bloodstains on it—this is still confidential information."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Bloodstains? ...Frau Angelia did mention that Morridow was injured."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I've had the surrounding area searched, but we haven't been able to locate her."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Can we extrapolate her path of escape?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"No, there is too little blood for that. "}]},{"spans":[{"text":"Besides, the river itself makes that impossible."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"What if we narrow it down based on the time she jumped? "}]},{"spans":[{"text":"If we calculate her trajectory and draw a radius..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I like your quick thinking."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"This is the first task I have for you. Here's the investigation report."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Right. "}]},{"spans":[{"text":"Forgive me for being blunt, but this is no different than looking for a needle in a haystack. "}]},{"spans":[{"text":"Also, if our manpower is stretched too thin, even if we locate the suspect, it will be difficult to capture her. "}]},{"spans":[{"text":"Isn't she some sort of monster that can fight toe-to-toe against an elite T-Doll?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"That's right, which is why no one will blame you if you conduct the search...in a leisurely manner."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...So the second task is what actually matters?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Yes...that is correct. "}]},{"spans":[{"text":"I just received new orders. "}]},{"spans":[{"text":"Once the investigation here is complete, you are to head straight to Berlin. "}]},{"spans":[{"text":"Isn't that exciting? You'll get to work with your dearest Frau Angelia."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"...No, please don't say that."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Oh, come off it. I'm not interested in the business of some teenage kid still wet behind his ears. "}]},{"spans":[{"text":"Now if you understand what you need to do, then scram. Can't you see I have guests?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Oh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light looks back and finds that Chairwoman Ulrich and her two bodyguards have been standing there silently for what appears to be a long time. "}]},{"spans":[{"text":"At the sight of the poised woman, he bows lightly in the way of acknowledgement. "}]},{"spans":[{"text":"Ulrich gives him a nod to indicate that she doesn't mind the wait."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"In that case, I'll take my leave."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light gives K a salute and takes off with the investigation report in hand. "}]},{"spans":[{"text":"He brushes past Ulrich but does not even bother to shoot her another glance."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"...So he is Uhrig's son?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"And a rising star. "}]},{"spans":[{"text":"This is probably hard to believe, but he is J's protégé."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ulrich waves her hand to send her bodyguards away. "}]},{"spans":[{"text":"The two security officers eye the rumpled-looking Stasi agent warily but still nod and back away."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"When they are a safe distance away, Ulrich strolls up to K and stares out at the boats still toiling away in the river."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You came straight from an interview?"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"A politician fights her own battles, Schwaben."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"The news from the last two days will keep the TV stations talking for the entire year. "}]},{"spans":[{"text":"Must've been tough cleaning up the whole mess."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Watch your tone, K. "}]},{"spans":[{"text":"We are still out in the open."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Apologies, I spoke out of turn."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"...But you're right, it hasn't been easy. "}]},{"spans":[{"text":"I had a lapse of judgment."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ulrich sighs heavily."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"It was obvious that Hopps was a member of the German Independence Party, but I didn't expect Morridow to have an even more complicated background... I thought they were sent by the same people. "}]},{"spans":[{"text":"It was largely my fault that the situation has taken a turn for the worse."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"There's a saying in our world of the secret service, Madam Chairwoman. "}]},{"spans":[{"text":"Never regret your decisions after you've made them. One doesn't even get the chance to regret a decision if it is truly regrettable."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Are you lecturing me, Schwaben?"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Sorry, I forgot my place. "}]},{"spans":[{"text":"What I mean to point out is that even though you never voiced your suspicions regarding those two beforehand, Angelia still figured it out."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I know."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ulrich unclasps her hands and rubs them gently against each other."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"When Angelia uprooted the Flora Institute, I could defend her. "}]},{"spans":[{"text":"It was Leone who forced her hand to begin with. "}]},{"spans":[{"text":"When she overstepped her authority at the orphanage, I could also quash the voices of objection. "}]},{"spans":[{"text":"Even the filthiest politicans I know understand that child-trafficking is a line that must not be crossed. "}]},{"spans":[{"text":"But what she did in the refugee settlement was completely out of line, K. "}]},{"spans":[{"text":"Those people in Berlin are like starving wolves eyeing a piece of juicy meat, and Angelia practically bared her own neck to their fangs."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"This isn't an issue of whether I warned her beforehand or not, K. "}]},{"spans":[{"text":"Ange's actions would inevitably have consequences. "}]},{"spans":[{"text":"That's just who she is."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"So...what are you worried about?"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"The people in Berlin have taken her, K. "}]},{"spans":[{"text":"And there's nothing I can do. I am out of my depth here."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You're right, they won't let go of Ange so easily. "}]},{"spans":[{"text":"I know their methods. They will shake her till she gives up the information they're after. "}]},{"spans":[{"text":"They won't stop until she succumbs."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"From now on, she is on her own."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You say that, but you've still transferred J and Light to Berlin. You're still doing whatever you can to help her."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...What?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ulrich looks up at K. Her face is largely unreadable, but the faint traces of apprehension does not escape K's experienced eyes. "}]},{"spans":[{"text":"Which is both surprising and puzzling to K—such a large reaction is a rather uncharacteristic display of weakness for someone like Ulrich."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"...K."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Yes?"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I did not arrange any transfers."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K is clearly not as good as masking his own emotions. His obvious shock has even drawn the attention of the two bodyguards, who have been watching them."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Then who was it? "}]},{"spans":[{"text":"They certainly aren't being dispatched on some ordinary mission... And the fact that they've chosen to send us means their aim is to help Ange."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"That's right, this could be a good thing for Ange...so don't worry, K."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I'm not worried. Ange and I aren't THAT close. "}]},{"spans":[{"text":"I'm just a bit shocked that someone could bypass your authority and issue commands to high-ranking Stasi agents operating in Bremen—who could it be?"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I have no idea."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ulrich gazes down towards the river, where the tireless searchers are still looking for signs of a young woman in the icy water."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"The stage has shifted, Schwaben. "}]},{"spans":[{"text":"...I just hope we haven't fallen too far behind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pungent metallic scent permeates the air in the confined space. Beads of sweat slide off a young woman's forehead and drip into the pool of blood on the floor, echoing briefly."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Are you alright?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I'm fine."}]}]},{"sprites":[{"prefab":"Narciss","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I have never seen you punished so harshly... Father is furious."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Failure deserves to be punished. This is our rule."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"If you count as a failure, what does that make us..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Only one person gets to decide who is a failure, Narciss. "}]},{"spans":[{"text":"Watch your tongue."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"I understand... "}]},{"spans":[{"text":"So who are we supposed to kill this time?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow gets to her feet laboriously."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"It won't be so simple, Narciss. "}]},{"spans":[{"text":"This time, we may have to make some sacrifices."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"...Really?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"If Father orders you to kill me, Narciss... "}]},{"spans":[{"text":"Will you hesitate?"}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"No, I will do it gladly."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Very good... I know I can count on you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow tucks a wet strand of hair behind her ear and gazes at the girl leaning in. She strokes her gently on the cheek."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Make it clean."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"...Okay."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
