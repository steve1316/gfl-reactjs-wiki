{"name":"-77-A-24","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Safehouse","raw":"BIN"},{"type":"bgm","value":"GF_21winter_battle_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shortly after the Commander escapes the hotel... "}]},{"spans":[{"text":"...The Commander is discussing the assault plan with the Griffin team at the secret rendezvous point."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is our best chance... and probably our only one."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As everyone commits to the mission and begins preparing for deployment... "}]},{"spans":[{"text":"AN-94 hesitates for a moment before stepping forward and voicing her concern."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Commander, M16's team attacked the production line not long ago. Even if William is still at the base, he must be aware of the attack. "}]},{"spans":[{"text":"Have you considered the possibility that he has already withdrawn from the base, having realized that it's no longer secure? "}]},{"spans":[{"text":"Or... that he might ask the Earl for support? He isn't limited to waiting there for us."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...That's exactly the point, 94. "}]},{"spans":[{"text":"He knows that I know he's there. That's why he'll stay and wait for me. "}]},{"spans":[{"text":"We have a score to settle with each other."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Why? That... doesn't sound very logical."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander falls silent. Their eyes flash with emotions too complex for others to understand."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Because I want him dead..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...And he wants the same for me. "}]},{"spans":[{"text":"Unless the situation becomes irreversible, the Earl still won't give up on either of us. "}]},{"spans":[{"text":"If he chooses to run... or to report this... then yes, I lose my chance to kill him, but he loses his chance to kill me as well."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"But at the very least, we should have a contingency plan..."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Don't worry... I'm confident."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 wants to say more, but AK-12 steps up beside her and gently shakes her head."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's no use, 94. "}]},{"spans":[{"text":"This is the last chance to catch William. The Commander won't let it go. "}]},{"spans":[{"text":"Neither will I."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...I understand, 12."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I'm just worried the plan is too aggressive..."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"This isn't like the Commander's usual style. "}]},{"spans":[{"text":"It feels... obsessive? Reckless, even?"}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"It reminds me of... when we went to that mansion."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 ultimately cannot bring herself to say the name. The scar in her heart still aches."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 shrugs and pats AN-94 on the shoulder."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Back then, I left you behind. That was my lapse of judgment as a leader. "}]},{"spans":[{"text":"If I'd been there, I wouldn't have let Ange do something so foolish. "}]},{"spans":[{"text":"I should've done better, but there are things that can't be undone. "}]},{"spans":[{"text":"However, I think it's different this time."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Different?"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The Commander looks more certain than ever to me, you see?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The operation plan is quickly finalized. "}]},{"spans":[{"text":"The Commander, together with Task Force DEFY, sets out on the road toward the endgame."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_M16c","raw":"BIN"},{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The covert vehicle carrying the Commander and Task Force DEFY moves like a shadow along the silent road."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AN94MOD","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"night","raw":"Night"},{"type":"background","value":"202407_Car_b","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"M16 reports that external comms jamming has been deployed. "}]},{"spans":[{"text":"From now on, the base is completely isolated."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Driving with practiced ease, AK-12 glances at the Commander through the rearview mirror."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I wonder how the host will feel about our visit."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Any response from internal security?"}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Everything seems to be normal."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 watches the monitors closely."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"No alerts at all."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Isn't that... a bit too quiet?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16","narrator":false,"pages":[{"spans":[{"text":"Just stay sharp."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander taps the armrest and thinks for a moment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's probably an ambush."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"An ambush? Then we—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The element of surprise is key to an ambush. Now that we expect it, the situation changes. "}]},{"spans":[{"text":"Once we arrive, prioritize locating enemy signal sources. Be ready to enter decisive combat immediately."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16","narrator":false,"pages":[{"spans":[{"text":"Dandelion, do we have terrain maps? I'll take a guess at their deployment."}]}]},{"sprites":[{"prefab":"NPC_Dandelion","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,300"}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"It's not complete, but this is what I've gathered so far."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Relax, 94. We're all here."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the vehicle moves forward, the unease in AN-94's chest grows heavier. This no longer feels like revenge; it feels more like... "}]},{"spans":[{"text":"A gamble."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And the Commander has already pushed all their chips forward, betting everything on the fact that William will remain at the table. "}]},{"spans":[{"text":"The road to the base stretches long and deathly silent."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202407_StasiBuilding","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Motorcycle","raw":"SE1"},{"type":"bgm","value":"BGM_stage11","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"When the squad reaches the abandoned base, everything is eerily quiet. "}]},{"spans":[{"text":"No alarms, no traps, not the slightest sign of Paradeus activity. It feels like nothing more than an empty shell left behind."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202407_ComputerLab","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They infiltrate the laboratory in the heart of the base without resistance."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Stay alert. Watch for traps..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_NightVision_Start","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A massive holographic screen suddenly lights up, its cold glow illuminating every face in the room. "}]},{"spans":[{"text":"William appears on the screen, seated, smiling with nauseating smugness like a cat that has caught a mouse."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 looks at the Commander's back. Their fists are clenched so tightly the knuckles have turned white. "}]},{"spans":[{"text":"The Commander has won the first bet—William did not run."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But the Commander has already played every card in their hand just to get the game started."}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Welcome, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I must admit, you're more efficient than I expected.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"William tries to applaud mockingly, but is forced to give up due to his condition. "}]},{"spans":[{"text":"A flash of vicious malice crosses his face before he regains his composure."}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"You know...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"I could have reported every detail of your plan to the Earl and turned your grand revenge into a farce crushed effortlessly by Rossartrist forces.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Then all your sacrifices, all your struggles, would be for naught.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But you didn't."}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Hahahahahaha! You're right, I didn't!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"I've been waiting for you to bring your amusing trash in here. I even played along.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Do you know why?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course."}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You stayed to make sure I would come. "}]},{"spans":[{"text":"Because we both want the other dead. "}]},{"spans":[{"text":"Because you hate me to the bone. "}]},{"spans":[{"text":"Because... you're Bill."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gazing at the seemingly unruffled William on the screen, the Commander can't resist making one last cutting remark."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Or maybe it's because you're just a crybaby who runs to his sister whenever things go wrong, begging her to wipe your tears again."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Too bad she'll never do that for you anymore."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Isn't that right, Ballard von Oberstein?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":14,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Heh...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":17,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Hehehe...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"HAHAHAHAHAHAHAHA!!!!","style":{"color":"#00CCFF","size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"William bursts into maniacal laughter. He lunges toward the camera, his twisted face filling the screen."}]}]},{"sprites":[{"prefab":"NPC-William","expression":16,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"I'm going to kill you! Commander, I will kill you with my own hands!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":17,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"You'll watch every one of your companions die before you! I'll turn them into experimental material, I'll—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"sfx","value":"AVG_bigglassbreak","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang. "}]},{"spans":[{"text":"The Commander's shot shatters the screen, cutting off the hysterical rant."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...So noisy."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10130","raw":"BGM"},{"type":"sfx","value":"Alarm","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The gunshot, like a trigger, instantly sends all the sirens blaring throughout the base."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Metal grinds. Heavy footsteps thunder from all directions."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Doors slam open across countless corridors, but it isn't just Nytos that come pouring out. Heavily armed private forces also charge from the darkness."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The door ahead begins to close. The lab is about to become a hell with no way out."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"There are this many Nytos... Just how many people has he killed?!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"C-Commander!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Stay close to me."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Tsk... This is more than I expected..."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"No! We're trapped if the door shuts! AK-15!!"}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0%%range=5","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 launches forward like a projectile, denting the heavy door with a mighty kick and halting its closure. AN-94 and AK-12 stay tight around the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Avoid being flanked! Push forward! William has to be somewhere inside!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_Gunfire","raw":"SE1"},{"type":"background","value":"202407_Passageway_b","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Tsk... Automated infrared turrets?! This place is a fortress!"}]}]},{"sprites":[{"prefab":"AN94MOD","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Watch out, Commander!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_Robots_Bomb","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An explosion erupts above the Commander."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...After an undetermined amount of time. "}]},{"spans":[{"text":"Gunfire, explosions, the scream of metal... all fade into silence."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202408_Room","raw":"BIN"},{"type":"bgm","value":"BGM_ev2412_tranquility","raw":"BGM"},{"type":"openEyes","raw":"睁眼"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander drags their broken body upright from a heap of corpses. The path deeper into the base has collapsed. "}]},{"spans":[{"text":"The last thing they remember is AN-94 throwing herself over them to shield them from the blast."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"William has gone completely mad. To ensure the Commander's death, he has used indiscriminate explosive weapons. The Nytos, heedless of their own destruction, hurl themselves at AK-15 in suicidal assaults."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Right. DEFY! What happened to them?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"AN-94! AK-12! AK-15!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander searches desperately, but the rubble leaves no place even to step."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They drag their nearly numb left leg and stagger out of the lab."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2022winter_Tunnel","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside, the devastation is even worse. Dismembered Nytos lie everywhere, some torn apart by brute force. "}]},{"spans":[{"text":"Did DEFY... break through?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No... that doesn't match the initial assault direction... Then the enemies on the outside..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"William..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The aftershock pounds in their skull. "}]},{"spans":[{"text":"A corpse lies nearby, barely recognizable, but the Commander pays it no mind."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion? ...Kalin?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_RedArea","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They walk through the silent base, searching for any sign of life, though they already know it's wishful thinking. "}]},{"spans":[{"text":"Amid the black-and-white wreckage, a familiar figure appears in their blood-blurred vision."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Tokarev?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They gently lift her motionless body. Her frame is severely damaged, and her neural core critically compromised. "}]},{"spans":[{"text":"The worst of the damage is a massive gash across her back—clearly from a white Nyto's scythe."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A wound on the back... Was she protecting someone...?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalina..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They don't dare pursue the thought. Laying Tokarev down, they stumble forward in a hurry, but every step is agony to their battered body."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"night","raw":"Night"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalin... Kalin!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That familiar orange mop of hair rests quietly against a console, as if she's merely asleep from a hard day of work."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalin...?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander walks up to her and lifts her gently. "}]},{"spans":[{"text":"Her body is cold."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalin..."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"fullwhite","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A light blooms deep within the base, staining the sky red. Magnificent—and utterly meaningless to the empty world before the Commander."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Robots_Bomb","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"[END]"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"If you choose to bleed yourself dry, perhaps you'll achieve a Pyrrhic victory. "}]},{"spans":[{"text":"But you would never accept such an ending, and neither would she."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"To her, making sure you live is far more important than putting him to death."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"As a side note, none of these possibilities truly happened. They leave no trace in your memory."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"But perhaps your subconscious picks up on one thing."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"That you always end up getting the one who stays by your side killed."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Perhaps that is why you start pushing her away without even realizing it."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"How tragic."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
