{"name":"10-3-2","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Good evening... "}]},{"spans":[{"text":"...Finally, we meet."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"eliza0","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You are...the Sangvis Mastermind, aren't you?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clap! (Applause)"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang!"}]}]},{"sprites":[{"prefab":"？？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...I have my own name."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Cough... "}]},{"spans":[{"text":"Cough... What a light tickle...from the leader of Sangvis Ferri... "}]},{"spans":[{"text":"Even M16's punch...hurt much more..."}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"You should not have deceived me. "}]},{"spans":[{"text":"You have an upright personality. That was why you have been chosen as the experimental subject of Parapluie. "}]},{"spans":[{"text":"I believed you would keep your word, that you would deliver M4A1 to me."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Your database could use some updating, young lady... "}]},{"spans":[{"text":"16LAB's technology is far beyond your imagination. Even Parapluie can't have me at its mercy. "}]},{"spans":[{"text":"Not to mention, personality is just a mask. We can turn into anyone...for the sake of revenge..."}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"\"Revenge\"? "}]},{"spans":[{"text":"A T-Doll giving up its life for something other than its given orders... "}]},{"spans":[{"text":"...How inexplicable."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Indeed... Of course you'd find it inexplicable... "}]},{"spans":[{"text":"Up until now... How much havoc have you wreaked?! How many of my companions have you hurt?!"}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I am merely doing what I believe is right."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"And so it's war, young lady from Sangvis Ferri... "}]},{"spans":[{"text":"This is not a game of toy bricks on the floor of your house. Everyone has to pay their price."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"If you still don't understand, let me teach you in a more straightforward way..."}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"A detonator... "}]},{"spans":[{"text":"So those explosives are prepared for me..."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Next time, please know the difference between a battlefield and a negotiation table. "}]},{"spans":[{"text":"But this time, please just die."}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"This...means nothing to me."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I know, of course... But I still want to get this off my chest... "}]},{"spans":[{"text":"Go to hell, Sangvis scum!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"主脑","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Mastermind","narrator":false,"pages":[{"spans":[{"text":"What you did was not worth it. "}]},{"spans":[{"text":"It wasn't a decision that a T-Doll should make. "}]},{"spans":[{"text":"That concludes our first meeting. "}]},{"spans":[{"text":"Until next time then."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"10","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"W...why... "}]},{"spans":[{"text":"...did you..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"background","value":"6CG-M4","raw":"BIN"},{"type":"shake","raw":"震屏"},{"type":"blackscreenOff","value":"20","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"6CG-M4","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the explosion goes off, M4A1 hears someone calling her from afar."}]}]},{"sprites":[{"prefab":"？？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...A1..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Ugh..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...M4A1! ...M4!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"background","value":"BG-BurnCity","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"Cough! "}]},{"spans":[{"text":"W...where am I...?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You've finally come to! "}]},{"spans":[{"text":"Don't you remember? We just had a victory with the Commander. We're now pushing forward... "}]},{"spans":[{"text":"Uh...what's the matter?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 glares viciously at RO."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then why did you wake me up?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Um... According to the newest update, the area just ahead is completely infected with Parapluie. "}]},{"spans":[{"text":"None of our forces can proceed any further and we can only wait for the Military to sort it out, but the Commander has a new mission for us..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'll talk to the Commander. Stand by for now."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 brushes past RO's shoulder and stalks off."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"M4... "}]},{"spans":[{"text":"Did I do something that pissed her off?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hmm... It always takes M4 a while to warm up to strangers."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Really...? But she looked like she wanted to eat me alive just now. "}]},{"spans":[{"text":"Could M4 be...a so-called...”angry riser” or something?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Not to my memory... "}]},{"spans":[{"text":"But maybe she hasn't had enough rest."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I hope that's all it really is... "}]},{"spans":[{"text":"Sigh...why is nothing working out...?"}]}]},{"sprites":[{"prefab":"RO635","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Enough with the chit-chat. "}]},{"spans":[{"text":"The Commander says our scouts just discovered some paralyzed military units. RO, you're equipped for electronic warfare, aren't you?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Uh, yes!"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then we're setting off right now. "}]},{"spans":[{"text":"If we can get them fixed, it could make the Commander's job easier."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, in the Military command center. "}]},{"spans":[{"text":"...Click."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"According to my subordinate's report, M4A1 has regrouped with Griffin. "}]},{"spans":[{"text":"And that thingy – the \"Key\" reacted instantly to Persica's little toy. "}]},{"spans":[{"text":"Looks like your intel is accurate."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"It will be the most foolish mistake you have made in your life if you doubt me, Mr. Carter."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"I've always had faith in your judgment, which is why I have made preparations to implement the Plan."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"Can you ensure it will proceed as we agreed?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"That's the whole purpose for this joint operation."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"I know you've pulled a lot of strings for this operation. You've even gone so far as to seek out small potatoes like Griffin. "}]},{"spans":[{"text":"But how are you going to deal with that Kryuger guy? Will he be a hindrance?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"They're just an excuse for us to enter the area. It doesn't matter at all what role Kryuger and that Commander of his are going to play. "}]},{"spans":[{"text":"Now that M4A1 has shown up, we can just leave the rest of them be."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"You're right. It doesn't hurt to let those irritating bugs crawl around for a bit. "}]},{"spans":[{"text":"It's all the same as long as the Central Committee doesn't get involved. "}]},{"spans":[{"text":"So, tell me how you're going to set this Plan in motion."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"With only their combat forces, Sangvis Ferri has no hope of defending against my troops. "}]},{"spans":[{"text":"At this rate, they'll have to resort to their killer move – we all know what that's gonna be. "}]},{"spans":[{"text":"And that is the moment when we implement the Plan."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"Humph... "}]},{"spans":[{"text":"The Military is every bit as unimaginative as I thought."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"It is the safest method."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"You're right, of course, but before that, I hope you could \"approach\" the Sangvis Mastermind."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"Is this also a part of the Plan? I never heard about it."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"No, it's not related at all. I merely have some personal interest in that fella."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"Is this compulsory?"}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"Don't make me put it so harshly, Mr. Carter. "}]},{"spans":[{"text":"Whenever I \"hope\" for something, it is pretty much implied that it's compulsory."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"(Sighs) Understood. I'll find a way."}]}]},{"sprites":[{"prefab":"经过电子处理的男声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Distorted male voice","narrator":false,"pages":[{"spans":[{"text":"Let me see...what's the deal of that man's final masterpiece."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-WarehouseOFF","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile. "}]},{"spans":[{"text":"In an obscure communication outpost on the battlefield."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Damn... "}]},{"spans":[{"text":"We overheard some incredible stuff here. It was worth all the legwork. "}]},{"spans":[{"text":"Hey, AK12, how long do we have left in the signal blockade?"}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"Not long. Less than 30 seconds."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Then why didn't you give me a heads-up earlier, freakin' Doll? "}]},{"spans":[{"text":"Cease monitoring and retreat from the signal blockade now."}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"My, aren't you being too careful? I'm dying to hear what else they're gonna say."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"It doesn't mean a damn thing to us no matter what they're planning to do. "}]},{"spans":[{"text":"The question is...what's their motive...? "}]},{"spans":[{"text":"From what I can gather...the \"Key\" that Carter mentioned is probably the Sangvis Mastermind? "}]},{"spans":[{"text":"But if they're after Mastermind, Operation Butterfly was their best shot. Why did they leave it till now...?"}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"So can we move yet? We're all set."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The info we've collected so far doesn't make for very conclusive evidence. Let's just send it to HQ for now. "}]},{"spans":[{"text":"Don't be so impatient all the time. Besides, you're gonna lose interest in this pretty soon."}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"Can't help it. I prefer making good use of time to wasting it on enjoying myself."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Then let's move it, Miss Doll. "}]},{"spans":[{"text":"Send word to your partner and the new recruit. We're going further in."}]}]}]}
