{"name":"-44-A2-5a","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"86","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"spark","raw":"火花"},{"type":"sfx","value":"Alarm","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside the apartment block. "}]},{"spans":[{"text":"The tardy fire brigade and police finally arrive. They seal off the building and start putting out the fire. "}]},{"spans":[{"text":"The Stasi has quietly slipped away from the scene and retreated into the shadows. "}]},{"spans":[{"text":"As actors in the previous act exits the stage, new ones enter."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd","raw":"SE1"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"}],"speaker":"Crowd Member A","narrator":false,"pages":[{"spans":[{"text":"Hey... Look! That woman!"}]}]},{"sprites":[],"ops":[],"speaker":"Crowd Member B","narrator":false,"pages":[{"spans":[{"text":"Huh... Shadow? That's Shadowless!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shadowless marches forcefully through the cordon, holding up her press card."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I am Shadowless from the DFF! "}]},{"spans":[{"text":"Who's in charge of the investigation here? I would like to cover this fire and report it on the news!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep. "}]},{"spans":[{"text":"Just then, her earpiece starts beeping."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Hello? Yes, speaking. Yeah, I'm already at the scene... Now? Everything is still in complete shambles. "}]},{"spans":[{"text":"I need backup. That's right, get me a cameraman. "}]},{"spans":[{"text":"15 minutes? Are you kidding me? "}]},{"spans":[{"text":"Make it five!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She turns off her earpiece and looks towards the chaos. "}]},{"spans":[{"text":"Interviewing the firefighters is out of the question. The fire is still raging on; she can't get in their way right now. "}]},{"spans":[{"text":"The police? That's certainly an option...but the police hasn't been playing nice with her lately. "}]},{"spans":[{"text":"That leaves..."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her acute sixth sense comes in useful once again at this crucial moment."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...Jesus Christ."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She rushes towards one of the police officers in the middle of the crowd."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Kevin!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"What are you doing here?! "}]},{"spans":[{"text":"No, how did you spot me?!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J, who is dressed in a police uniform, is dragged into an inconspicuous corner by Shadowless to talk out of the public eye."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sparkOff","raw":"关闭火花"},{"type":"fadePointOff","raw":"黑点2"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Shut up! Now tell me, why are you here?! "}]},{"spans":[{"text":"What has the Stasi got to do with this?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Give me a break, Missy. "}]},{"spans":[{"text":"Do you want me to lose my job?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":9,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Please, I won't take up too much of your time!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shadowless grabs J by his collar and turns off her pen recorder. "}]},{"spans":[{"text":"With the situation being so chaotic out there, hardly anyone would pay attention to the two people locked in a confrontation in this quiet corner."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I don't want to make things difficult for you... Just tell me—is Light okay? "}]},{"spans":[{"text":"He didn't come home last night. I could tell something's off about him."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J opens his mouth but doesn't know what to say."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...We had a fight."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Uh... Are you blaming that on me?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression"