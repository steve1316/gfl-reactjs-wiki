{"name":"6-3-1E","beats":[{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"机场","raw":"BIN"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"She..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"SOP-II, what's the matter? Where's AR-15?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"She said..."}]},{"spans":[{"text":"There's something she must do..."}]},{"spans":[{"text":"I don't know what she means... It...scares me..."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Understood, SOP-II."}]},{"spans":[{"text":"But right now, we have our own duty, too, so let's focus on that for now..."}]}]},{"sprites":[{"prefab":"M16","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yeah, we destroyed Alchemist..."}]},{"spans":[{"text":"Has the Sangvis attack...weakened?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Yes, their units are now scrambling around like bugs and no longer seem to be targeting us."}]},{"spans":[{"text":"Signal along the transport route has also returned to normal, and the remaining T-Dolls have started retreating."}]},{"spans":[{"text":"All that's left is M4. You know where she is?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yeah... AR-15 has given me M4's location. I'm on my way to look for her."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"All right. Cheer up and leave the rest to me."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Commander, we have a new mission."}]},{"spans":[{"text":"SOP-II is off to rescue M4A1. We need to give them cover."}]},{"spans":[{"text":"Sangvis forces are still strong as ever in that area, so we have to break through by force."}]},{"spans":[{"text":"Dispatch your forces, Commander."}]}]}]}
