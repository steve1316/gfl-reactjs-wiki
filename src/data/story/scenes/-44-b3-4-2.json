{"name":"-44-B3-4-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd","raw":"SE1"},{"type":"background","value":"328","raw":"BIN"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Criminal","narrator":false,"pages":[{"spans":[{"text":"Ahhhhhh!!!!"}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It's just like a zombie game!"}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"These people are definitely not normal. "}]},{"spans":[{"text":"They must've ingested or inhaled something, but it doesn't look like a stimulant."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Perosa! What about the explosives?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"They've all been disarmed!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But some of them still managed to go off.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"There's a breach in the prison wall, and all the convicts are heading for it!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Fedorov","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Fedorov","narrator":false,"pages":[{"spans":[{"text":"...It's no good, the prison guards' casualties are too heavy.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I can't manage!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Savage99","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Savage","narrator":false,"pages":[{"spans":[{"text":"I can't hold them!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"They're going to spill out onto the streets!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Let them go! We can't stop numbers like this! "}]},{"spans":[{"text":"Ensure the safety of the innocent first!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"327","raw":"BIN"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang bang bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"45 shoots the last Paradeus unit standing and changes her magazine with practiced ease."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"That's the last one."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"But I saw a few escape just now."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Hunting down stragglers wasn't part of our services. "}]},{"spans":[{"text":"I left a few alive as requested, so don't push it."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Of course, I'm very grateful for that. "}]},{"spans":[{"text":"Though they don't seem to be of much use..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion peers at the Paradeus units that members of 404 have subdued."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Their memories are even more of a mess than Machlian's. "}]},{"spans":[{"text":"There's no useful intel in there at all."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Speaking of which... "}]},{"spans":[{"text":"Is it really okay to leave her alone with the Commander?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Given the present circumstances, the control room is the safest place for them to be. "}]},{"spans":[{"text":"Also, if Machlian was putting on an act all this while, now would be the best time for her to strike."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...You're using the Commander as bait?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I simply have faith in the Commander's judgment. If the Commander trusts Machlian, then so do I."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"45!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I hear you. Sheesh, why the rush? "}]},{"spans":[{"text":"It's not like we're on a timer here."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"158","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the control room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and Machlian sit far apart in silence, both avoiding looking at each other. "}]},{"spans":[{"text":"This is the first time the two of them have been alone, but the timing is a little awkward. "}]},{"spans":[{"text":"Ever since leaving Bohnsdorf, and after the conversation in the truck, the Commander is suddenly at a loss for how to deal with Machlian."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...This is the last location, right?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the end, it is Machlian who breaks the awkward silence."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"When this is all over... "}]},{"spans":[{"text":"I'll take you to..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian shudders. A certain instinctive terror prevents her from speaking of \"the place\"."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I'll take you to...to..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You don't need to force it out."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I'll take you to where the medicine is made."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian calms her ragged breath. "}]},{"spans":[{"text":"She has not yet forgotten her promise—even if she made it in the middle of an emotional breakdown."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Thank you."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I'm your captive. You don't need to thank me."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander frowns, then turns to face her."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm making the request, but you're the one who ultimately decides whether or not to comply, Machlian. "}]},{"spans":[{"text":"Everything we've done is for our common goal. "}]},{"spans":[{"text":"We want to help more people with your medicine. You have endorsed this goal and aided us in our endeavors. "}]},{"spans":[{"text":"That is what you are doing now."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"But things almost never turn out well when I get involved."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nothing will ever take away from the good you've done. "}]},{"spans":[{"text":"You don't need to blame yourself for the suffering Paradeus has caused. "}]},{"spans":[{"text":"...The decision you make now could prevent countless tragedies like what happened to Elsa from playing out again."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The commotion outside has hasn't died down. Even from here, the Commander can tell that the situation is rather grim. "}]},{"spans":[{"text":"The chief warden is still lying unconscious on the floor. The Commander takes a deep breath, then smacks their knee as they come to a decision."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Machlian."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Hm?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Where to?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Things are starting to quiet down. They probably have the situation more or less under control now. "}]},{"spans":[{"text":"It would be safer for us to link up with the AR Team or Squad 404."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian nods and rises from her chair."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What is it?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After getting up, Machlian stands rooted to the spot, completely motionless."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Do you hear something, Robin?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander frowns as they strain their hearing."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_21Winter_FT_Heel","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tap. "}]},{"spans":[{"text":"Tap tap. "}]},{"spans":[{"text":"A series of crisp taps, like a woman's high heels striking the ground, come from the other side of the door."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Footsteps? "}]},{"spans":[{"text":"A woman?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"It doesn't sound like...the Dolls. "}]},{"spans":[{"text":"And...I..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian balls her hands up into fists so tight that her knuckles turn white. "}]},{"spans":[{"text":"She looks up and clings to the Commander's clothing with evident unease."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"In...In my memories, I've heard footsteps like this before."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...And then? What happened?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander understands instinctively that something's wrong. They chamber a round in their pistol as they ask Machlian to elaborate."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I knew it... I can't cheat fate. "}]},{"spans":[{"text":"There is nothing I can do, Robin. "}]},{"spans":[{"text":"...I will die here."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tap. "}]},{"spans":[{"text":"The steadily approaching footsteps suddenly come to a stop. The person seem to be standing right outside the door."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...You'll be fine."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shoots her a comforting smile before carefully pressing themselves to the wall with their pistol in hand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They move up to the door, double check that their pistol is loaded, then glance outside through the gap in the door."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":"ELID","narrator":false,"pages":[{"spans":[{"text":"(Howls)"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tsk..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"158","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It's one of the Infected. "}]},{"spans":[{"text":"One of the prisons staff, by the look of it. "}]},{"spans":[{"text":"It was her heels that produced the footsteps they just heard... At least the Commander can still make out that she's female."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Robin."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait... Be quiet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Commander shoots Machlian a glance to warn her not to speak, but seeing the despair on her face... "}]},{"spans":[{"text":"The Commander takes a deep breath and puts a hand on the door handle."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Not today, Machlian."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Not today... I was not present in all your visions of the future. "}]},{"spans":[{"text":"But here I am, so it doesn't match up."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"10118","raw":"BGM"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"background","value":"327","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam!"}]}]},{"sprites":[],"ops":[],"speaker":"ELID","narrator":false,"pages":[{"spans":[{"text":"(Snarls)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander savagely kicks the door open, and before the ELID can react, the Commander already has her head in their sights."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A spray of blood explodes from her head. The Commander can hear the crisp sound of a bullet striking bone."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just to be extra thorough, the Commander fires two more shots and drops the ELID's stinking body to the ground."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tango down!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This is immediately followed by more intense footsteps coming from the end of the corridor."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Robin!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait, don't panic!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 emerges from around the corner in a tactical roll, her muzzle pointed squarely at the Commander."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...What the heck, I thought you were dead."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that the person still standing is her employer, she quickly lowers her gun."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander. "}]},{"spans":[{"text":"Are you alright?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion strolls out casually from behind. As she greets the Commander, her gaze falls on Machlian."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I'm fine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander also breathes a sigh of relief at the arrival at Squad 404."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I almost forgot you had actually undergone training."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Want to go a round with me one of these days, if we have the chance? "}]},{"spans":[{"text":"I'm fairly confident in my skills."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"If you can pay, I don't mind having some fun with you. "}]},{"spans":[{"text":"You're footing your own medical bills, though."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Never mind, then."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian walks out from inside the room and peers down at the ELID on the ground."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...You did it, Robin. "}]},{"spans":[{"text":"We survived."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It's not as big a deal as you make it out to be, Machlian. "}]},{"spans":[{"text":"I told you already, these are small potatoes."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian seems a bit dazed. The Commander turns around and leaves her to her thoughts."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion, what's the status of the prison?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"We've purged the Paradeus infiltrators, but we couldn't fully suppress the rioting convicts. "}]},{"spans":[{"text":"The AR Team and Squad Griffin had their hands full just protecting the wardens. "}]},{"spans":[{"text":"Not to mention Paradeus released some kind of low-dosage radiation gas here... We had no choice but to let the convicts escape onto the streets. "}]},{"spans":[{"text":"The rest will be a problem for the local authorities."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Tsk."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander punches the wall in anger. "}]},{"spans":[{"text":"The mission can hardly be considered a success... And Collapse Particles again? Just how many does Paradeus have, anyway? "}]},{"spans":[{"text":"Machlian's medicine may be a lot more valuable and important than they originally thought."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, the Commander's communicator rings."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Hello? Commander? Are you there?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Our boss wants to talk to you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"RPK? Is Ange looking for me? "}]},{"spans":[{"text":"I'm currently..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ange?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Good afternoon, Commander... How are things on your end?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander eyes the corpse on the ground and snorts."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Going well, I guess. We just found a lead. "}]},{"spans":[{"text":"How about you?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Humph, I'm getting by.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Actually , I have a favor to ask of you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why so formal? Just ask."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Morridow—that Nyto. Is she still with you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Morridow... You mean Machlian?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander looks back at Machlian behind them."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, she is."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Have you got anything out of her?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm? Haven't I told you already?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...So did you not learn anything new after that?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nothing worth mentioning for the moment, or at least nothing worth bothering you over."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You need to pick up the pace. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I've told you before, Morridow is very crafty.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"She's stalling for time. You should be able to tell.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian looks like she's about to say something, but then she looks at the Commander and shakes her head. "}]},{"spans":[{"text":"The Commander pauses a little."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, I'm prepared 