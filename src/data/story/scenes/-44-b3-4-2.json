CFF"}},{"text":" "}]},{"spans":[{"text":"All I'm asking is if you can send her over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I can't do that right now."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ange..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What the FUCK is wrong with you?!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"How many times do I have to tell you?! Morridow excels in disguise and deception!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And now you believe everything she says?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Are you just going to ignore all my warnings?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She is not Morridow! "}]},{"spans":[{"text":"...Look, are you having some difficulties? "}]},{"spans":[{"text":"We can talk later. Once things are settled on my end, we can pick a place and meet. "}]},{"spans":[{"text":"I'll be able to explain everything then!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Ha! Oh yes, she's Machlian, yeah? You'd rather believe all that crap she's spewing.","style":{"color":"#00CCFF"}},