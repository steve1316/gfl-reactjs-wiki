{"name":"4-4-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"18","raw":"BIN"},{"type":"bgm","value":"BGM_Sad","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, at M16A1's hiding spot..."}]},{"spans":[{"text":"Combat over."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Why..."}]},{"spans":[{"text":"I am obviously the more outstanding T-Doll..."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Experience, reaction, training. You fall short in all of the above."}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"You never run out of excuses...M16A1."}]},{"spans":[{"text":"Tell me, what am I to you?!"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"(Forced laughter) Oh, please. You really wanna know?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Then I'll tell you, HK416."}]},{"spans":[{"text":"You mean absolutely nothing to me. Got it?"}]},{"spans":[{"text":"You're worthless. You're boring. You're nothing to me."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[