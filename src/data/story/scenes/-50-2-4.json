70"}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"No, she wouldn't. "}]},{"spans":[{"text":"So, which do you think is the prettiest?"}]}]},{"sprites":[{"prefab":"97type","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"-90,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Do I have to choose one?"}]}]},{"sprites":[{"prefab":"97type","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"-90,70"}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"Yep!"}]}]},{"sprites":[{"prefab":"97type","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"-90,70"}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Then... this one. "}]},{"spans":[{"text":"I'm not really an expert in the aesthetics of leaves. "}]},{"spans":[{"text":"But this one looks very nicely shaped."}]}]},{"sprites":[{"prefab":"97type","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"-90,70"}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"Hm..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Type 97 nods thoughtfully."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Say, have you been learning how to paint lately? "}]},{"spans":[{"text":"I'm seeing a lot of painting tools in your room."}]}]},{"sprites":[{"prefab":"97type","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"-90,70"}}],"ops":[],"speaker":"Type 97","narrator":false,"pages":[{"spans":[{"text":"Paint...? "}]},{"spans":[{"text":"Oh, yeah, I have actually been doing something like that. "}]},{"spans":[{"text":"My first piece of work will be ready soon. Wanna be the first to look at it when it's done, Commander?"}]}]},{"sprites":[{"prefab