{"name":"-12-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"17xh-Networld","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"How long have we been in here, 9?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Hmm..."}]},{"spans":[{"text":"Several hours?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"(Sighs)......"}]},{"spans":[{"text":"I think I'm almost at my limit."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Don't give me that. You went offline to rest just a while ago, didn't you?"}]},{"spans":[{"text":"Look at Gr G11, she's having a blast."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Don't compare me to that koala. She can last in there 'til World War IV as long as someone keeps her fed with rations."}]},{"spans":[{"text":"I want some real rest; even regular combat isn't this tiring..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Special circumstances, so hang in there."}]},{"spans":[{"text":"I'm uploading the fragments you found to Dier, but we're missing one last piece."}]},{"spans":[{"text":"After that, we'll be able to wake 45 up and get out of here together."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The only good news right now is that there's no bad news. I hope there won't be any other surprises in store for us..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"(Chuckles weakly) You do love raining on others' parade, don't you? Why not think a little more positive, 416?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Me? Forget it... Someone's got to play the bad guy."}]},{"spans":[{"text":"9...what'll you do if we can't save 45?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"...I don't know. It's too early to ask me that question."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I thought you would already have an answer prepared."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I'm not like 45. I don't have everything figured out."}]},{"spans":[{"text":"I only think about doing what's in front of me until 45 is satisfied."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What a heartwarming relationship you have."}]},{"spans":[{"text":"Now that we have the chance, can you tell me how you met 45?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Will you tell me what you saw of 45's neural cloud?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Can't you just read the report?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I don't want to..."}]},{"spans":[{"text":"Or rather, I don't dare..."}]},{"spans":[{"text":"Maybe I'm just waiting for her to tell me in person."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Humph, weirdo."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"...Beep."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Hey! 416, aren't you going to get a move on?"}]},{"spans":[{"text":"We're just one step away from fixing 45's neural cloud!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Got it, I'm going now."}]},{"spans":[{"text":"9, don't forget about the situation outside. S.F. is certainly searching for us."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Don't worry. The Tactical Fairies are keeping a constant lookout."}]},{"spans":[{"text":"If anything happens, I'll have the echelons fight them off!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"I'm not too reassured by 9's leadership..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Humph, is that so?"}]},{"spans":[{"text":"It just so happens that my leadership skills are limited, so guess I'll only save 416!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Hey! You got a network command module with a commander's data saved in it, right?"}]},{"spans":[{"text":"So you're an elite Griffin commander now! You can't just leave me for dead!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Be careful, 9."}]},{"spans":[{"text":"I'm not sure who the Ringleader is this time, but I am certain that they'll be very dangerous."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Mhmm, leave it to me!"}]},{"spans":[{"text":"(I have to keep everyone safe until 45 wakes up...)"}]},{"spans":[{"text":"(They're the last family I have, and...I MUST protect them!)"}]}]},{"sprites":[],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]}]}
