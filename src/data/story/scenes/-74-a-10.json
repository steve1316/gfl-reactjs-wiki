ion_Camera","raw":"SE1"},{"type":"cgDelay","value":"0.1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. Click. Officers are photographing the scene with great care."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Furniture torn apart like paper. Blood splattered on every surface, showing the victim's desperate struggle. Oberstein's eyes, still wide with the last trace of emotion. His motionless chest."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q slips under the cordon. Even she frowns at the sight of the corpse. "}]},{"spans":[{"text":"The younger officers have long since retched themselves empty when they first saw the gruesome body."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Any leads?"}]}]},{"sprites":[],"ops":[],"speaker":"Police Officer","narrator":false,"pages":[{"spans":[{"text":"Estimated time of death is three hours ago. "}]},{"spans":[{"text":"Weapon appears to be a sharp metal object. The fatal wound is the penetration wound through the head. Multiple other punctures and lacerations on the body. "}]},{"spans":[{"text":"Full assessment still pending."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Any ID on the killer?"}]}]},{"sprites":[],"ops":[],"speaker":"Police Officer","narrator":false,"pages":[{"spans":[{"text":"All internal cameras are destroyed. We're pulling street footage, but odds are slim. "}]},{"spans":[{"text":"The only witness is his chief secretary Fred, but he's hysterical—keeps repeating something about \"a woman turning into a spider\"..."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Right, I see."}]}]},{"sprites":[],"ops":[],"speaker":"Police Officer","narrator":false,"pages":[{"spans":[{"text":"There's no further useful intel at the moment."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Thank you, nonetheless."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The officers exit the room, leaving Q alone with Oberstein's body. She looms over him and gazes down into those clouded eyes."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Minister, Oberstein is dead. "}]},{"spans":[{"text":"Confirmed identity, confirmed deceased."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"...Dead?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Yes. Looks like Paradeus' handiwork."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Have his family been notified?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"His only direct relative can't be contacted."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Then arrange a simple funeral in the party's name.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q ends the call and leaves the office."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perhaps even Oberstein would never have imagined—the last time he was surrounded by a crowd, bombarded by flashing cameras, would be the moment of his own death."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"sfx","value":"AVG_The_Division_Camera","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Newstitle","raw":"BIN"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0%%","raw":"bg_move"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Tape_Start","raw":"SE1"},{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...An emergency broadcast runs across every channel. "}]},{"spans":[{"text":"Static interference occasionally breaks the feed."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":"沉痛的声音","narrator":false,"pages":[{"spans":[{"text":"This is a message from the National Defense Council, the Socialist Unity Party... and the Council of Ministers of the German Democratic Republic","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In deepest sorrow, we would like to inform all citizens of the GDR...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Herr Rudolf von Oberstein—Vice-President of the State Council, Vice-Chairman of the Council of Ministers, Minister of Science and Technology, member of the National Defense Council, and Deputy Secretary of the Socialist Unity Party—and General Heinrich Schweinsteiger—First Deputy Minister of Defense, Chief of Staff of the Nationale Volksarmee, and Secretary of the National Defense Council—have both been assassinated.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"As leaders of great achievement, they will live forever in the hearts of the German people.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"沉痛的声音","narrator":false,"pages":[{"spans":[{"text":"The orchestrator has been identified as Carter Petrovich Neustadt—former member of the Neo-Soviet Army General Staff, Army Group Chief of Staff, and the initiator of the ongoing Frankfurt air raid.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"He seeks to kill our people and tear apart our unity through violence, but we will never yield!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"At this critical hour, we have exchanged information with the Neo-Soviet leadership and received their affirmation—","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We will stand together as always, bound by the true will of the people.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0%%","raw":"bg_move"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep-beep. "}]},{"spans":[{"text":"The comms notification sound echoes forlornly in the dark."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-William","expression":6,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Lunasia","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Sister, do you like this gift I've given you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":6,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Lunasia","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...So this is the altar you chose?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":6,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Lunasia","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"This is the altar WE chose together. What we failed to complete back then can now begin anew.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-William","expression":6,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Lunasia","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...Will everyone die?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"William","narrator":false,"pages":[{"spans":[{"text":"Except for the lucky ones who board the Ark.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
