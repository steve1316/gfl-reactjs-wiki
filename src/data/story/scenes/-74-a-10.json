],"ops":[],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"Where are you? Why haven't you come to the parking lot yet?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"The newsroom is only waiting on you! Don't play the lone wolf now of all times!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I just received word the A5 was bombed. I'm going to cover it on site."}]}]},{"sprites":[],"ops":[],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"Are you insane?! The bombing is still happening!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I know."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"You're just a civil affairs reporter, not a war correspondent!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Stop this madness and get down here!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I'm still packing. By the way, I can't find my microphone. Ask Falk if I could borrow his."}]}]},{"sprites":[],"ops":[],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"You! You know our office isn't safe either! TV stations are always one of the top bombing targets!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Fine. I'll assume Falk agreed. Anything else?"}]}]},{"sprites":[],"ops":[],"speaker":"Ossietzky","narrator":false,"pages":[{"spans":[{"text":"Sheesh, you really...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I knew there's something wrong with you when you transferred here from Berlin! Turns out you actually got a few screws loose!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shadowless hangs up. She shoulders the camera and microphone and steps out of the office."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud. She collides with Falk, who is making his way back."}]}]},{"sprites":[],"ops":[],"speaker":"Falk","narrator":false,"pages":[{"spans":[{"text":"Shadowless?!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Perfect. Falk, I'm borrowing your microphone."}]}]},{"sprites":[],"ops":[],"speaker":"Falk","narrator":false,"pages":[{"spans":[{"text":"Where are you going?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"The A5. For an on-site report."}]}]},{"sprites":[],"ops":[],"speaker":"Falk","narrator":false,"pages":[{"spans":[{"text":"The bombing is still going on out there! It's too dangerous to go now!"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites