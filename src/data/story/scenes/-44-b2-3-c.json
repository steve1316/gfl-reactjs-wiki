{"name":"-44-B2-3-C","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"337","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Inkblots. "}]},{"spans":[{"text":"Inkblots of all shapes and sizes. "}]},{"spans":[{"text":"They're everywhere, bewildering the eyes."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"Tell me, what do you see?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"I advise you not to test my patience."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"This is the last time I'm asking you, what do you see in the inkblot?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"338","raw":"BIN"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The remains of corpses."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"You worthless piece of trash!!!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"339","raw":"BIN"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"Blood, it's blood..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"340","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A heavy slap across her face sends her reeling."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"Blood? Heh... Well, that IS one of your few uses. "}]},{"spans":[{"text":"Now that you mention it, is it time to draw blood today?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her arm is firmly secured, and a sharp razor blade cuts her skin. "}]},{"spans":[{"text":"Blood gushes out into the container."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Assistant","narrator":false,"pages":[{"spans":[{"text":"Professor, I think that's enough..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□","narrator":false,"pages":[{"spans":[{"text":"Relax, it's not like she'd die. "}]},{"spans":[{"text":"Good dogs fight back when they can't take any more abuse. A worthless mutt like her will live to the end, even if she has no pride to speak of."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"fadePoint","raw":"黑点1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"341","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The blood flows down the outside of the container, dripping onto the ground..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Ink_Drop","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"160","raw":"BIN"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Drip...drip... "}]},{"spans":[{"text":"The IV bottle connected to her wrist steadily drips its liquid. "}]},{"spans":[{"text":"The base is unusually noisy today."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Nyto's Voice","narrator":false,"pages":[{"spans":[{"text":"Faster, move it faster. Father said he wants everything transferred by today."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Fire_Alarm","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She carefully pulls out the IV catheter, and the alarm goes off, as expected."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Nyto's Voice","narrator":false,"pages":[{"spans":[{"text":"Don't look around! Our schedule is packed! Pick up the pace!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a while, nobody has come around to check on her, and the sound of the alarm has died down. "}]},{"spans":[{"text":"Her heartbeat suddenly speeds up in excitement."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"□□□","narrator":false,"pages":[{"spans":[{"text":"Is anyone...there...?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nobody answers. "}]},{"spans":[{"text":"She stands up and pushes open the door to the treatment room. "}]},{"spans":[{"text":"There are no obstacles in the empty corridor."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her footsteps slowly pick up speed, getting faster and faster, until she's in a flat-out sprint..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"167","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the truck dispatch point."}]}]},{"sprites":[{"prefab":"Nyto","expression":1,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"...This is the last batch of trash that needs disposing. We'll head out in five minutes. "}]},{"spans":[{"text":"Once we've taken care of it, we'll proceed directly to the new base."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"Good. Don't waste any time along the way. "}]},{"spans":[{"text":"If you're discovered or followed, take care of them by yourself. Remember to destroy all the evidence."}]}]},{"sprites":[{"prefab":"Nyto","expression":1,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She holds her breath, and climbs into the cabin filled with abandoned Isomers. "}]},{"spans":[{"text":"She pulls off a black cape and drapes it over herself, then she pulls apart the girls' cold corpses and squeezes among them. "}]},{"spans":[{"text":"She is nervous and afraid. All she can do is close her eyes and wait for the truck to start moving."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"It's time. "}]},{"spans":[{"text":"Go, hurry up and dispose of this trash."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The truck shudders, and finally, it begins to move. "}]},{"spans":[{"text":"In the distance, she hears a panicked alarm coming from the base..."}]}]}]}
