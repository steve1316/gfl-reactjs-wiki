{"name":"-18-1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Wake up, M4. We're about to begin the operation."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"How long was I asleep?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Two hours. Dawn just broke and the Military is about to fully mobilize."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What about Ange?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"AK-12 just finished creating a new signal blockade, and Ange's sending a transmission."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"She said she'd ask her superiors for support... "}]},{"spans":[{"text":"They're not likely to show up now that it's come to this, are they?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I've never held out hope for any support. "}]},{"spans":[{"text":"9, status report?"}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"The others and I have deployed Dummies to keep an eye on the key sectors. The Military's armored units are making their push."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Armored units, huh... "}]},{"spans":[{"text":"Let's see what Ange comes up with first."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I've already found several reports related to the OGAS support system in their servers, and I can provide basic speculation about their goals..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You know that speculation can't be used as evidence. "}]},{"spans":[{"text":"Without proof, we can't get approval to open an investigation."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"But you should have guessed their objective already, if we don't stop them now..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I understand. The Committee members are already displeased with their actions, but so far nobody is willing to come forward and handle the matter."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":" Are they still choosing to cover their asses at this juncture?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"After the war, everyone with high-level command authority was shunned. "}]},{"spans":[{"text":"There's a great deal of internal resistance to joining the Pan-European Alliance, and a whole new round of reshuffling might begin soon. "}]},{"spans":[{"text":"The Ministry of Internal Affairs can't just casually stick their nose into the matter."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"A new round of purges, you mean..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"In any case, without orders from the highest authority, a direct conflict with the Military is treasonous. "}]},{"spans":[{"text":"I've already asked the Minister to put pressure on the Prime Minister, but I haven't heard back from him yet."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"And so our units on the outside still have their hands tied."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I'm afraid so."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Chief...you don't understand how serious this is! "}]},{"spans":[{"text":"If they get their way, it won't be a simple matter of reshuffling!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I understand. That's why your mission is still underway."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I can't stop the regular army by myself. I can't create a miracle with just a few T-Dolls!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It's already made the papers. At the very least, they don't have the authority to transfer the four main divisions from the overseas cluster command yet...and the Air Force is still on our side. "}]},{"spans":[{"text":"According to the info I've received, the forces in the contested area are primarily the autonomous units which aren't bound by the regulatory treaty. "}]},{"spans":[{"text":"You still have a chance."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I ask again for permission to execute the final plan. We're running too great a risk here! "}]},{"spans":[{"text":"Even if we can't gather more evidence, this is the one time we can't let them have their way!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"No. If the fact that we bombed an operational area was exposed, the West will think that there's internal unrest in the country. "}]},{"spans":[{"text":"It is a very dangerous message to send."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Is this really the time to worry about how we're perceived?!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"This is a sensitive period for the talks. We can't give our opponents any excuses to use. "}]},{"spans":[{"text":"The recon squadron will assess the overall situation. We haven't reached that step yet. Do your best to wreck their scheme by normal means. Over."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Tsk...easier said than done."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"AK-12."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What's up?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Take stock of our usable resources. Track the Military's signals as best you can. We've got a hard fight ahead of us."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Understood. I'm on it."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"45."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Your orders?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"While I don't really want to do this, monitor all signals that M4A1 sends and receives. Pay particular attention to hidden transmissions on Level II."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So you've finally decided to use her as bait."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If we can't deal with the Military, we'll deal with Mastermind. "}]},{"spans":[{"text":"I don't know why, but Mastermind seems very interested in M4."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...While I don't usually question your orders... "}]},{"spans":[{"text":"If we destroy Mastermind, our only lead to finding the prime mover behind all this will vanish. "}]},{"spans":[{"text":"You know what that implies for us."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I understand. I will try my best to avoid that outcome."}]}]},{"sprites":[],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click—"}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"416 and the others have spotted a Sangvis unit near our position. Should we attack?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"How should we handle this, Ange?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Treat it as a warm-up, then. We'll need a clear field to work with."}]}]}]}
