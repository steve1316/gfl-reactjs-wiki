":false,"pages":[{"spans":[{"text":"Yeeeeeeeee-haw!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Huh...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a deafening vroom, a large motorbike comes skidding through the underground passage, followed by a truck."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4, look out!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 dives onto M4 and pushes her out of the way of the motorbike. "}]},{"spans":[{"text":"By the time they get back on their feet, the Sangvis convoy is already gone."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Are you okay, M4?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...We're going after them."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It's not over yet. I won't let it end just like that. Let's go!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":".