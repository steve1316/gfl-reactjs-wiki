{"name":"-51-2-7","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"17xh-Networld","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"10051","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Task Force Aeneas registration complete—Squad Nitrogen."}]}]},{"sprites":[{"prefab":"Rhino","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The heck is this? Why do we need a special network space just for a meeting? "}]},{"spans":[{"text":"Wouldn't it be more convenient to just use our comms directly?"}]}]},{"sprites":[{"prefab":"QBZ191","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Don't you get it? This is called being a pro."}]}]},{"sprites":[{"prefab":"Rhino","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Why do I get the feeling that you're talking out of your ass..."}]}]},{"sprites":[{"prefab":"SP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"1","raw":"GradientShow"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Greetings. Codename Nitrogen is in position. I'm the squad leader, Mona."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"1","raw":"GradientShow"}],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"I'm the freshly-appointed Stasi agent Doll, Rhino."}]}]},{"sprites":[{"prefab":"QBZ191","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"1","raw":"GradientShow"}],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"I'm a mercenary Doll, codename No. 9. I have been hired by Statesec to work with you on this mission."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I've already shared the briefing files with everyone here. You can read them after the meeting is over. "}]},{"spans":[{"text":"Now, allow me to explain the details of Operation Aeneas."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"But we're still missing quite a few people. Aren't we going to wait for them?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It's alright, they'll show up when the time comes."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"In that case, I'll begin."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"bgm","value":"10118","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"This operation is codenamed \"Aeneas\". Our objective is to rescue Ange, and to investigate the Paradeus hideout in the \"Dead Sea\"."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Currently, the information that we have verified... Mona, if you'd please."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Yes. The following is all information provided by the Stasi."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_Fire","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"One—Paradeus has lost their Berlin base after the battle against your Commander and the Stasi."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"2022winter_Town","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"After comparing many days' worth of surveillance imagery, movement into the Black Zone has risen at an abnormal rate. While we have not yet found any clear links between Paradeus and Galatea, given the recent increase in the radiation index, we have reason to believe their HQ is located within the \"Dead Sea\". "}]},{"spans":[{"text":"In fact, we suspect that their HQ is located in that region."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_elevator_red","raw":"BIN"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Two—during the previous fighting, I engaged in direct combat with the high-ranking Nyto Bramedb. "}]},{"spans":[{"text":"Records of that encounter have been preserved and I will upload them to the conference room afterwards, for everyone's reference."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_NitrogenTeam2","raw":"BIN"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Three—the two Tactical Dolls working for the Stasi in Squad Nitrogen—namely myself and Rhino—are the highest-spec units that the Stasi can field at the moment. "}]},{"spans":[{"text":"No. 9 is also a renowned elite among mercenary Dolls. We will provide our full support for the duration the upcoming operation."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"17xh-Networld","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That's awesome... Huh? We're going into a Black Zone? "}]},{"spans":[{"text":"Doesn't that mean we won't be able to communicate with each other?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's why we've established this conference room. As long as 45 is around, we can communicate through her neural cloud layer."}]}]},{"sprites":[{"prefab":"SP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"I see... It seems you've also made extensive preparations."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"As you may have surmised, the situation inside the Black Zone will be very complex. Even Dolls will have to be cautious. "}]},{"spans":[{"text":"We must complete the appropriate preparations and be ready to enter the Black Zone at any time."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"night","raw":"Night"},{"type":"background","value":"2020summerOffice","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside a certain safe house at the Soviet-German border."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10082","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cold wind beats against the windows of the wooden cabin, emitting non-stop howls that chill the soul."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"(Pants heavily)"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seated in front of the stove, Dupieux ends up breaking multiple matchsticks with his trembling hands."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"God... dammit..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He needs heat to stay warm..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_Fire_Bonfire","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh... "}]},{"spans":[{"text":"Firelight fills the stove, and the bone-dry kindling ignites. Warm air wafts out of the stove immediately."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"Whew..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as Dupieux is about to relax, an unnatural noise comes from inside the cabin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_3h","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Almost instantly, he pivots and fires several shots at the door out of reflex."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The swinging wooden door immediately sports three conspicuous holes, and the light that streams inside illuminates the motes of dust dancing in the air."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"(Pants heavily)"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10065","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He can almost feel his heart in his throat. "}]},{"spans":[{"text":"Are they Statesec pursuers? How did they follow him so quickly? "}]},{"spans":[{"text":"Is... is this place no longer safe? He needs... he needs to go now."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"\"Polar Bear\"?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The communicator has been switched on at some point and a crisp woman's voice speaks through it. Startled, Dupieux throws it away from him. The communicator spins on the ground and comes to a halt in the center of the room."}]}]},{"sprites":[{"prefab":"NPC-Dupieux","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"...Evangelist? Is that you? "}]},{"spans":[{"text":"No... Who are you?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_Q","raw":"BIN"}],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Nice to meet you, \"Polar Bear\". "}]},{"spans":[{"text":"I am Q of the Stasi."}]}]},{"sprites":[],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"Stasi? ...What do you want?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Did the Evangelist send you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Hm... Sorry, but I'll have to ask you to tell me about this \"Evangelist\" in detail afterwards. "}]},{"spans":[{"text":"I'm sure the Soviets are also very curious about him."}]}]},{"sprites":[],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dupieux looks incredulously at the communicator."}]}]},{"sprites":[],"ops":[],"speaker":"Dupieux","narrator":false,"pages":[{"spans":[{"text":"You, you—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Believe me, this isn't personal."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Rifle","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot echoes through an echoing canyon as a bullet flies through the woods, the wind and the snow, piercing the rotted wooden door and striking Dupieux in his center mass just as he's about to flee."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzt... Pzzzt... "}]},{"spans":[{"text":"A paralyzing electrical current immediately pours into his body, his muscles, his joints and his nerves... "}]},{"spans":[{"text":"In an instant, his consciousness is taken by the bullet, sinking into a silent darkness."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_Q","raw":"BIN"},{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"},{"type":"sfx","value":"AVG_Bullet_Drop","raw":"SE1"}],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Whew... Thanks for fleeing with all your might. "}]},{"spans":[{"text":"If the Soviets had found you first, it would have all been for nothing."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Through the scope of her rifle, Q sees the incredulous look on Dupieux's face. Yet, he keels over without so much as a sound."}]}]},{"sprites":[],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Hm, looks like I caught a big fish~ "}]},{"spans":[{"text":"Now let's see, who's this Evangelist that's going to show up?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
