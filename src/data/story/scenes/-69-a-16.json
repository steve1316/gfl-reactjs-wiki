{"name":"-69-A-16","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"bgm","value":"BGM_AuguriesofInnocence","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"M4! Come out!"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}},{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"There's only Lunasia here. This M4 that you're looking for isn't here."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}},{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Why are you doing this?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}},{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"To reforge the world into a place with no sin, no darkness, and no violence. "}]},{"spans":[{"text":"Just like my garden, everyone will be plants thriving in sunlight, each vibrant and beautiful in their own way..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What you're doing won't make your dream come true. You are simply doing somebody a favor. "}]},{"spans":[{"text":"I don't know who fed you all these lies, but they are certainly manipulating and using you!"}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Think about why you're here. Think about what you came here for in the first place."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"463","raw":"BIN"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"BOSS-10","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"If it's you... If you can merge with me..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Are you sure you can do it?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"As long as we live, the future will have endless possibilities. "}]},{"spans":[{"text":"Even if our physical forms are lost, we will still meet again some day."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The hidden past obscured by the darkness makes her wince in pain."}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"What did YOU come here for? Why won't you leave me alone?!"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}},{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You are the whole reason why I'm here."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}},{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Do you still remember the first time you opened your eyes?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"},{"type":"background","value":"463","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"So you're M4A1? M16A1, a T-Doll like you. "}]},{"spans":[{"text":"Pleasure. Guess I'll be taking orders from you."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"And the AR Team? RO has taken over as leader since you left. "}]},{"spans":[{"text":"But you know, we're all waiting for you to return."}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"463","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR15","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Sadly, the time has come for us to part, M4A1. There's no time to keep such petty scores. "}]},{"spans":[{"text":"You may feel sad; you may feel angry... You may remember me; or you may forget me... "}]},{"spans":[{"text":"Whatever the case, just let this memory give your strength and make you even stronger..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD II","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I've already lost AR-15 and M16! "}]},{"spans":[{"text":"If I have to lose you too, then I'll die with you! "}]},{"spans":[{"text":"This is the order we all received the moment we left the factory, and I intend to obey it to my very last breath!"}]}]},{"sprites":[{"prefab":"RO635","expression":12,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"AR-15 wanted me to save you. M16 wants me to save you. So does SOP-II as well as the Commander! "}]},{"spans":[{"text":"M4A1... "}]},{"spans":[{"text":"I might not be acting out of my own free will, but I'm doing this because everyone is counting on me. "}]},{"spans":[{"text":"Even if you don't believe me, at least believe those who have always supported you. "}]},{"spans":[{"text":"C'mon, take my hand. Let's go back together..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_Power_Down","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The darkness seems to have taken physical shape as a heavy and viscous vortex with her in the center. She feels slowly, viciously crushed from all directions."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pair of hands cup her face. They are so gentle they feel surreal."}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Lady Lunasia, you look troubled. Are the voices bothering you?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Who's talking?"}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"I'm alright... "}]},{"spans":[{"text":"I can handle it."}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Of course. I just want to let you know that you don't have to be afraid, because I'll always be here. "}]},{"spans":[{"text":"You just have to give the word, and I will remove all obstacles for you."}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Martini-Henry leans in and whispers into her ear."}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Lady Hanna and the young master are still waiting for you to come home."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"M4, don't trust her!"}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Lady Hanna has especially prepared your favorite dishes and snacks, and the young master is waiting for you to watch television together."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Focus on my voice, M4!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Lady Lunasia, please stop hurting yourself. What's the point of dwelling on someone else's painful memories? "}]},{"spans":[{"text":"How is that more productive than saving the real world?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Martini-Henry covers M4's ears, blocking out M16's calls."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"10","raw":"duration"},{"type":"rate","value":"20","raw":"rate"},{"type":"delay","value":"30","raw":"delay"},{"type":"cg","value":"37,52,105,116,149","raw":"CG"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"S-stop!"}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Leave those memories of others' suffering behind. Their stories are written in stone. "}]},{"spans":[{"text":"But our story is just about to begin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Martini-Henry takes M4's hand."}]}]},{"sprites":[{"prefab":"NPC-MartiniHenry","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"200,150"}}],"ops":[],"speaker":"Martini-Henry","narrator":false,"pages":[{"spans":[{"text":"Let's go, Lady Lunasia."}]}]},{"sprites":[{"prefab":"NPC-lnxy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"...Okay."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,80"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"M4!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 turns away, and M16's calls are cut off in the endless darkness."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"background","value":"699","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A dull ache in the back jolts ST AR-15 awake."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She jumps to her feet and scans her surroundings. "}]},{"spans":[{"text":"Winding vines, strange flower and plants, clocks and geometric planes suspended in mid-air... "}]},{"spans":[{"text":"Shapes are twisting and contorting in a macabre manner. The garden barely looks like a garden."}]}]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...RO! ...SOP-II!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She calls out softly, but there is no response."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_TurnOverCard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fighting to suppress the pain, ST AR-15 rummages through her pockets and pulls out a card— "}]},{"spans":[{"text":"Or rather, a fragment that's only a third of a tarot card's size. "}]},{"spans":[{"text":"Depicted in the center of the fragment is a tall wine glass; the liquor contained within is a clear and sunny yellow."}]}]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You'd better be useful."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She presses her palms together over the card fragment. "}]},{"spans":[{"text":"It feels cool in her hands, almost as if she is holding an actual glass. She lets the sensation draw her neural cloud to a special comms channel..."}]}]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...RO? ...SOP-II?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"What's your status? Please respond...!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_21summer_avg_Demon","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Again and again, she calls out via the comms channel. "}]},{"spans":[{"text":"But the channel remains silent."}]}]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,250"}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Can you hear me?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She keeps waiting... "}]},{"spans":[{"text":"Her heavy breathing marks the passing seconds... "}]},{"spans":[{"text":"The branches in the woods continue to spin and distort before her eyes, interweaving into a void of chaos. "}]},{"spans":[{"text":"She watches it all happen but can do nothing about it. The feeling of helplessness threatens to overcome her..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"85","raw":"BIN"},{"type":"flashback","raw":"回忆"},{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0.1%%range=3","raw":"controll_shake"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The impact of the explosion throws SOP-II and ST AR-15 heavily against the door, and they crash right into the temporary command room. "}]},{"spans":[{"text":"Sunlight shines in through the gap, illuminating the countless dust motes quivering in the air."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It's not gonna hold out there! RO, we need to withdraw!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"How's the Commander doing? Throw them on my shoulder and let's get outta here!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO doesn't even look up. She stares dazedly at the Commander, whose head is lying on her lap. "}]},{"spans":[{"text":"The Commander has stopped gritting their teeth in pain. Instead, they seem to be slumbering peacefully. Their dark red uniform is patchy with blood that has dried and turned black."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...The Commander is gone."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What are you on about?! The Commander wouldn't just go! "}]},{"spans":[{"text":"They promised they'd never abandon us!!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II throws herself onto the Commander and shakes them roughly."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Commander! Commander! "}]},{"spans":[{"text":"Wake up! We need to withdraw!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"SOP-II, let the Commander be..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that the Commander is unresponsive, SOP-II simply hoists them on her back."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Let's go! You two clear the way while I carry the Commander! "}]},{"spans":[{"text":"They must be asleep! They haven't slept a wink in days, so they must've fallen asleep! "}]},{"spans":[{"text":"Once we get to safety, the Commander will wake up!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP-II... put them down..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"No! The Commander promised they'd be with us till the very end!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...This is as far as they could go. They tried their best."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's arm flops limply off SOP-II's shoulders. The unmistakable truth pushes SOP-II to the brink of breaking down."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{