d","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's this...?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Encrypted with G&K's internal encryption code, Category III—the highest category."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"The Commander left this to us?!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No... I don't know who the sender was... "}]},{"spans":[{"text":"It just appeared on the Commander's... body..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The Commander lost so much blood we used up all the bandages, so I tore up some of my clothes to make more. I went to disinfect the fabric strips before I dressed the Commander's wounds. "}]},{"spans":[{"text":"I turned away for only a few seconds, and by the time I turned back, I found this letter in the Commander's hand..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left",