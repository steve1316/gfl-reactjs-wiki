{"name":"-75-A-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Darkness. Stillness. Absolute silence."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzzt... "}]},{"spans":[{"text":"A sharp crack of circuitry connecting cuts through the void."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev's consciousness snaps violently back into reality. The familiar warmth of a system reboot trickles through every circuit in her body. "}]},{"spans":[{"text":"What's the last thing she remembered?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gunfire. Explosions. The Commander's voice and her teammates shouting—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Tokarev! Hang in there! We're almost through!\""}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...How did she fall behind?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A sudden EMP—the Nidhogg Protocol formally engaged and forced her into a total shutdown. In an instant, everything collapsed into black."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her visual module gradually recovers from chaos. At first, there are only scattered points of light, then blurry outlines, then shapes slowly sharpening into something she can scarcely believe—"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022saros_DataBase","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's haggard face."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dressed in a formal professional outfit that she normally hates, Kalina is pale, with heavy dark circles hanging under her eyes. "}]},{"spans":[{"text":"Her blonde hair, usually perfectly kept, is a disheveled mess, as if she hasn't properly rested in a long time."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Miss Kalina?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2412_tranquility","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's tense expression loosens a little. A breath of relief passes through her."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Thank goodness... thank goodness. You're awake..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Only now does Tokarev have the capacity to take in her surroundings."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She has been packed like cargo inside a crate. Next to Kalina lies a discarded crowbar, and Tokarev notices the blood-red scrapes on Kalina's slender hands."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The crate's lid—previously nailed shut—lies pried open in the middle of the corridor."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rows upon rows of identical crates line both sides of the passageway."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Miss Kalina..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev lifts her arm with great difficulty. Her joints feel stiff, as if they were rusted, but she forces it to move and wraps it around Kalina's trembling body."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Please don't worry. You don't have to shoulder everything on your own. I'm fully awake now."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina takes a long breath, wipes at the tears welling up in her eyes, and sombers up."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...I'm fine, Tokarev. Can you move?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev tests the other parts of her body, trying to ease the side effects of the forced shutdown and improper handling."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Everything seems to be in order. I'm ready for combat anytime."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Good... Hm, I wish I could wake a few more helpers. "}]},{"spans":[{"text":"But... well, you've probably guessed it. I snuck in here illegally. Just to be safe, we should... get out of here first."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her voice holds none of her usual vivacity, only exhaustion and a kind of bottomless despair. "}]},{"spans":[{"text":"Tokarev has many questions. She knows this isn't the time, but she needs at least a basic understanding of the situation."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Where are we?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"An IOP warehouse in Frankfurt... a temporary one."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"And the Commander? How... did the fight end? "}]},{"spans":[{"text":"Shouldn't you be in hospital? Why are you in Frankfurt? "}]},{"spans":[{"text":"How long... has it even been?"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina bites her lip. The fatigue on her face deepens."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...It's a long story. Let's... get out of here first. "}]},{"spans":[{"text":"After that... I'll fill you in on everything."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"delay","value":"0.7","raw":"Delay"}],"speaker":"Tokarev","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Then please stand behind me."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
