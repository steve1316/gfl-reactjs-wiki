{"name":"2-5-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Combat over."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Finally. That's the last time, right? That's what you said, Miss Persica."}]},{"spans":[{"text":"But we didn't find much, just this tape..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Ah! The tape! Show...Show it to me!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Huh? Well... Could you play it, Commander?"}]}]},{"sprites":[{"prefab":"Kalina","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"All right, here it goes..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"机场","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Day 70 on the run. No progress at all... Or rather, the operation is in jeopardy..."}]},{"spans":[{"text":"...A