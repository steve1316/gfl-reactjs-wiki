":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Hmm... Commander... Thanks for this time..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Next time I'll treat you to coffee...in my lab..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica terminated the call."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"(Sighs) Unless you fancy drinking dirty water used for doing the dishes while sitting in a freezer, I'd suggest you forget it."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Let's get back on track, Commander."}]},{"spans":[{"text":"Griffin is now assigning an important mission to you. I'll give you a detailed explanation..."}]}]}]}
