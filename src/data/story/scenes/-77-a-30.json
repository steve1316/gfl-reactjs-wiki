{"name":"-77-A-30","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"10213","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"background","value":"742","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Catch you later, Commander. "}]},{"spans":[{"text":"I'll let you do the honor of killing William."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Got it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander parts with M16 and moves deeper into the base."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"900","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AN94MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"This looks like a storage area for experimental equipment."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After fending off several Nyto ambushes, the group enters a zone packed with various devices and instruments."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Commander, look over there."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Following AK-12's prompt, they notice a row of glass cultivation tanks filled with faint blue liquid. It is not an unfamiliar sight to them."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's gaze locks onto the fluid as clear as lake water."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.6","raw":"CGDelay"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"321","raw":"BIN"},{"type":"sfx","value":"AVG_fall_into_water","raw":"SE1"},{"type":"sfx","value":"AVG_Pause","raw":"SE1"},{"type":"bgm","value":"GF_22W_SFX_chant","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"For a fleeting instant, a vision flashes before their eyes—countless pale arms bursting from beneath the surface, pounding violently against the glass walls."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It is the image of the Paradeus facility within the \"Dead Sea\", something they have only ever seen through recordings—bones piled endlessly at the bottom of the tanks, feeding William's ambitions. "}]},{"spans":[{"text":"Even though they have never witnessed the victims' final moments firsthand, scenes like this have replayed in their mind again and again."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_Bubble","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hundreds, thousands of Isomers struggle within the massive vats, each one ultimately dissolving into a single drop."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"569","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bubble","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The drops gather, eventually merging to form the bottomless Lake of Cognition."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"900","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AN94MOD","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Commander? You don't look well."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine... These devices... resemble those from Avernus."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"No life signs in the containers. The experiments haven't begun. These... are just empty vessels."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fortunately, nothing else is inside aside from the liquid. The Commander lets out a quiet sigh of relief—the nightmarish sight in their memory has not yet become reality. "}]},{"spans":[{"text":"But presence of this lab setup proves similar experiments are being prepared."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yet their very presence proves that such experiments are already being prepared. "}]},{"spans":[{"text":" The evil once eradicated in Operation Muromets is now gathering strength to return."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"There's too much clutter here. Stay alert for ambushes—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the group's attention is drawn to the equipment, an unnatural gust of wind sweeps through the sealed room."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Watch out!"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"sfx","value":"AVG_Sword_Scope","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A streak of white flashes across the Commander's vision."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before they can figure out what it is, the familiar high-pitched vibration tears through the air—"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"fadePoint","raw":"黑点2"},{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At some point, Grig has already appeared behind the Commander. "}]},{"spans":[{"text":"But thanks to Dandelion's interference, her strike is delayed by a fraction of a second."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":6,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the next instant, AK-15 slams into her like a cannon shell, forcibly knocking her away. "}]},{"spans":[{"text":"The collision erupts with a heavy, thunderous impact."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":4,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Protect the Commander!"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...Where did this one come from?"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Her name is Grig. She's a Nyto... Extremely fast. "}]},{"spans":[{"text":"Even faster than before. Really saved my ass there, Dandelion."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"You're welcome. She really is faster now, so I didn't catch her in time."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...? "}]},{"spans":[{"text":"You did though, didn't you?"}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"That's not important. What matters is... "}]},{"spans":[{"text":"...AK-15 might need help."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15's movements are swift and ferocious, her explosive strength among the very best."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She is already fast, but she still falls short compared to that white blur."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Sword_Scope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum—"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The only consolation is that Grig's attacks fail to inflict any real damage on AK-15."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Each time that blade—sharp enough to cut steel—comes close to slicing through her body, AK-15's counterattack forces Grig to disengage at the last moment."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...Faster even than my new frame. Impressive."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Stay away. She's still targeting the Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 cannot defeat Grig alone, but with the other two DEFY members guarding the Commander, Grig has also lost her chance to assassinate the Commander. "}]},{"spans":[{"text":"Eventually, she stops pressing the attack and pulls back. The assault ceases, resulting in a tense standoff."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Looks like this is William's last card. He should be just ahead."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Dandelion, take the Commander and go. "}]},{"spans":[{"text":"Her attack has stopped. Now's your chance."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander steps forward instead. Grig shows no reaction. She doesn't seem interested in the fight anymore."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Do you see these devices? "}]},{"spans":[{"text":"William intends to rebuild something like the Lake of Cognition."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You understand what that means. "}]},{"spans":[{"text":"If it is rebuilt, what happened to you, to Gray, and to all the other Nytos... will happen again."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig's gaze shifts ever so slightly."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Is there any point saying that to a Nyto, Commander?"}]}]},{"sprites":[{"prefab":"AN94MOD","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Commander, please go. Leave this to us."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I promise... "}]},{"spans":[{"text":"I will destroy William's ambitions."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"