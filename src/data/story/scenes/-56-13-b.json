":[],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#A9A9A9"}}]},{"spans":[{"text":"Ah...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris is still thinking."}]},{"spans":[{"text":"This is what being reborn must feel like."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"70","raw":"BIN"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":"Worker","narrator":false,"pages":[{"spans":[{"text":"...It's over."}]},{"spans":[{"text":"You can move now."}]}]},{"sprites":[],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris sits up inside the metal vat and flexes an arm experimentally."}]},{"spans":[{"text":"She looks back at her other body, or rather, a dismembered wreck that can only be called \"a jumble of parts\"."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Scar_Battle","raw":"BGM"}],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...Did you extract all of the core components?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Worker","narrator":false,"pages":[{"spans":[{"text":"They're all in your new body. No functions have been left out."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris climbs out of the metal vat."}]},{"spans":[{"text":"A flash of green light passes through the eyes of her brand new body, and she calls that long-abandoned number."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#99CC33"}}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...This is between you and me."}]},{"spans":[{"text":"You shouldn't have involved others."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"What a coincidence, I was thinking the same thing.","style":{"color":"#99CC33"}}]},{"spans":[{"text":"Amaris.","style":{"color":"#99CC33"}}]},{"spans":[{"text":"I thought you'd have run off by now.","style":{"color":"#99CC33"}}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...You think too much..."}]},{"spans":[{"text":"Pick a place. We'll settle everything there."}]},{"spans":[{"text":"...I'll take revenge on you for everyone's sake—Samantha, Morea, Olivia, Eula, Nicole, Callisto, Laura, and myself, Amaris."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Very well... I've sent you the location.","style":{"color":"#99CC33"}}]},{"spans":[{"text":"See you there tomorrow, Amaris.","style":{"color":"#99CC33"}}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"See you tomorrow, Aliana."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
