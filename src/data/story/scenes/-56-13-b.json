{"name":"-56-13-B","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"563","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Scar_Shenzhizi","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the mysterious room."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"I remember my name now..."}]},{"spans":[{"text":"And I remember yours too... All of you..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Although the faces in the seven chairs in front of her are shrouded in shadows, their excitement fills the entire room."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Congratulations..."}]}]},{"sprites":[],"ops":[],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"You've always done very well."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"My name is Amaris."}]},{"spans":[{"text":"Big Sis Eula..."}]}]},{"sprites":[],"ops":[],"speaker":"Eula","narrator":false,"pages":[{"spans":[{"text":"...You've found yourself."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A figure steps out of the darkness."}]},{"spans":[{"text":"A teardrop spills from her eye."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"I remember now..."}]},{"spans":[{"text":"Back then, I lost contact with A Team that was following Aliana. After that, she came over to us..."}]},{"spans":[{"text":"The order she gave was to snipe the person in that room."}]},{"spans":[{"text":"And then... I saw her..."}]},{"spans":[{"text":"She executed Samantha... with her own hands."}]},{"spans":[{"text":"She executed everyone else..."}]},{"spans":[{"text":"And then... I saw you."}]},{"spans":[{"text":"I'm sorry... it turns out I was running away from all this for so many years."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Eula","narrator":false,"pages":[{"spans":[{"text":"No, you were very brave."}]},{"spans":[{"text":"You're the bravest of us all, our most caring sister."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Eula reaches out to pat Amaris' shoulder lightly, and after her, more figures emerge from the darkness."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"But... All your memories were jumbled up because I was afraid... "}]},{"spans":[{"text":"It's all because I didn't dare face Aliana."}]},{"spans":[{"text":"It's because the first thing I wanted to do when I saw her was run away."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Samantha","narrator":false,"pages":[{"spans":[{"text":"There is nothing wrong with that, Amaris. "}]},{"spans":[{"text":"You've been strong enough."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Laura","narrator":false,"pages":[{"spans":[{"text":"No matter what you do, we will always be by your side. We will always support you."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"page