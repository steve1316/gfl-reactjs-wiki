,{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris crosses a stream of dirty water flowing over the road and ducks into the shadows of a building."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Good evening, Miss Amaris."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Got time to talk?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"I already know who you are. I can go with you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Well, that's a WW3 legend for you, straight to the point."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"However. I have a condition."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Hah?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"I intend to deal with Daybreak Squad's traitor. Relax, she's also a Doll."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I can't answer you right away. Give me some time to confirm."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Don't forget to tell your boss to order a SST-762 body, the kind with the biggest battery capacity."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"70","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the outskirts of Berlin, in Basement 4 of the M07 heavy mechanical factory."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Shield_Startup","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...This is one of the secret production lines Statesec built in Berlin."}]},{"spans":[{"text":"The machines that were once sealed away now roar with activity tonight."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris' body is secured to a workbench."}]},{"spans":[{"text":"She sees her body reflected in her eyes. After her synthetic skin has been stripped away, all that remains is a metallic shell beneath, as pure and bright as the moon."}]}]},{"sprites":[],"ops":[],"speaker":"Worker","narrator":false,"pages":[{"spans":[{"text":"...Do you really not need to shut all these off?"}]},{"spans":[{"text":"Keeping them