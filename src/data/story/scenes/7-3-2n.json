{"name":"7-3-2N","beats":[{"sprites":[],"ops":[{"type":"background","value":"Metro","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Combat over. Right outside the factory."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"We got here sooner than expected. That's some great improvement you've shown, Commander. "}]},{"spans":[{"text":"I knew I was right to choose you after the last operation with M4A1. "}]},{"spans":[{"text":"Now let's finish the last step."}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAR-21","narrator":false,"pages":[{"spans":[{"text":"Negev, the Sangvis patrols will reach my position in 15 minutes. Can you draw them away?"}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"I don't have any hands to spare here."}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAR-21","narrator":false,"pages":[{"spans":[{"text":"If something happens to me, you're dead meat. You know that, right?"}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Sure I do, so just sit tight. "}]},{"spans":[{"text":"\"They\" should be back any minute now."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Hey, Negev!"}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"What the hell, so you did survive."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Ha, thanks to you. "}]},{"spans":[{"text":"But can't you send someone more reliable to my rescue next time?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"Hey, why are you being so picky about your savior? I didn't even get a proper \"thank you\"!"}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Huh? If I hadn't helped you get rid of the pursuing Sangvis units, you would've been in pretty deep crap yourself."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"I only had them on my tail because I had to come save your butt! Why did I have to take on such a thankless task the moment I reported back for duty?!"}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Haha, well sorry, I'm not the kinda girl who grovels at somebody's feet in gratitude just because they did me a favor."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"I know that. That's why I hate coming back! The whole squad is made up of unreasonable nutcases!"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"But you did come back. "}]},{"spans":[{"text":"Humph, guess you can't find anywhere more suitable for you."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"Tsk, that's entirely your fault. "}]},{"spans":[{"text":"Especially you, Negev! You're the craziest bastard of them all!"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Doing everything perfectly isn't my strong suit. I can live with just winning."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"Seriously... Where the hell did you pick up this \"get the job done no matter the cost\" attitude?! "}]},{"spans":[{"text":"Aren't we all selfish cheapskates here?!"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"That's enough. Since you've passed the test, get started on the next task already."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"Hey, I didn't say-"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Tavor has run into some trouble. Galil and Uzi, go make some noise and draw away the nearby patrols. "}]},{"spans":[{"text":"Get it done in ten minutes. Chop chop."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Ha, that's more than enough. Let me fix my hair first. The sandstorm..."}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"MicroUZI","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Micro Uzi","narrator":false,"pages":[{"spans":[{"text":"Cut that crap! We've only got ten minutes! Get up!"}]}]},{"sprites":[{"prefab":"AR","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Hey! You-! "}]},{"spans":[{"text":"Wait, there's no rush-"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Transmission ends."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Now that's settled. "}]},{"spans":[{"text":"All that's left is the Sangvis Ringleader... "}]},{"spans":[{"text":"The Dummy that haunts the factory like a ghost..."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Oh my... Whose Dummy are you talking about, young lady?"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"Dreamer... "}]},{"spans":[{"text":"According to my intel, you should be-"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Where should I be? I can be anywhere. "}]},{"spans":[{"text":"Especially when you need me to."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"So you...are the formidable enemy that no one dares touch. "}]},{"spans":[{"text":"Have you been watching us the whole time? With your remote control Dummy?"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Well, this is my backyard. I can't let any outsiders sully it. "}]},{"spans":[{"text":"I could be wrong, but maybe you just happen to have stumbled in here by accident and now plan to run away with your tail between your legs?"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Don't go causing new trouble on the battlefield. That's what my senior has taught me."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"But somehow I get the idea that like me, you're not a very good girl."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Indeed. I've always let her down and been a burden to her... "}]},{"spans":[{"text":"That's why she'll never forget me, the bad student who's always full of surprises."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"So am I also a surprise to you?"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"...No. "}]},{"spans":[{"text":"A part of you will be. I'll take my pick after the fight."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Negev. That's your name, isn't it? "}]},{"spans":[{"text":"This is the first time we talked, but...I've already grown quite fond of you..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"So...can I eat you?"}]}]}]}
