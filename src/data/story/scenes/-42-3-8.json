eft","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"...AH400?!"}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AH400","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"TAC-50 tries to take off her mask, but the Doll struggles violently."}]}]},{"sprites":[{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"AH400","narrator":false,"pages":[{"spans":[{"text":"No! Don't take off my mask!"}]}]},{"sprites":[{"prefab":"TAC50","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"Why? What on earth is going on? "}]},{"spans":[{"text":"What happened to your face? And why do you sound all weird?"}]}]},{"sprites":[{"prefab":"TAC50","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AH400","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I lost my original face and voice... "}]},{"spans":[{"text":"I do not want you to see me like this. Just remember me the way I was..."}]}]},{"sprites":[{"prefab":"TAC50","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"Is this your mistress' doing? Why? "}]},{"spans":[{"text":"Isn't it illegal to construct a Doll's face in a human's likeness?"}]}]},{"sprites":[{"prefab":"TAC50","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AH400","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AH400","narrato