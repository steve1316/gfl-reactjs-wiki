wn":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"Of course. We'll be friends forever."}]}]},{"sprites":[{"prefab":"NPC-Fuduto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"82","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Passadou","narrator":false,"pages":[{"spans":[{"text":"...She had a Doll sing in her place? "}]},{"spans":[{"text":"That's inconceivable. How preposterous."}]}]},{"sprites":[{"prefab":"TAC50","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"You're right. Miss Passadou really is quite baffling, isn't she?"}]}]},{"sprites":[{"prefab":"NPC-Fuduto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Passadou","narrator":false,"pages":[{"spans":[{"text":"So what has this got to do with me? "}]},{"spans":[{"text":"I just want you to finish your tale and make yourself scarce."}]}]},{"sprites":[{"prefab":"TAC50","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAC-50","narrator":false,"pages":[{"spans":[{"text":"Alright, I'll pick up the pace then. "}]},{"spans":[{"text":"Some time had passed, then one day, AH400 told me cheerfully... "}]},{"spans":[{"text":"That her mistress had decided to leave this perverse life behind and go live out the rest of her life quietly. "}]},{"spans":[{"text":"AH400 just had to perform one last time and she could regain her own identity. "}]},{"spans":[{"text":"I knew I would miss her dearly, but this was certainly for the best, so I was happy for her. "}]},{"spans":[{"text":"Her final performance just so happened to be on Halloween last year. "}]},{"spans":[{"text":"The very same day the theater burned down."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Passadou's icy fingertips dig painfully into her palms."}]}]}]}
