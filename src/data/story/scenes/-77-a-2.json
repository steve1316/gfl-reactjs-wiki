ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nothing but an ordinary human."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Where are we? How did we get here?"}]},{"spans":[{"text":"I remember we were in the interrogation room on board the Elmo... Was it William's doing?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Like you, I know nothing about our current situation."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I help this person sit up. In the darkness, that familiar yet unfamiliar face rises and falls within my memory."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ordinary. "}]},{"spans":[{"text":"Ordinary."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"What an... utterly ordinary person."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...How long have we been here?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Maybe a week, maybe a decade."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is this really the time for stupid jokes?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ordinary looks. "}]},{"spans":[{"text":"Ordinary physique."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even their personality is so plain and unremarkable."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is nothing about them that stirs even the slightest interest."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You woke up before me?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Did you see our abductors?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I don't know who abducted us. All I know is that the last time this door opened, it was a handful of scientists working under William."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"William... What did they do?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"They took me to the lab. After that, I don't know."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Only one thing."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...This one thing alone sets them apart from everyone else."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The wound is here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even in the darkness, that burning gaze still pierces forth from those eyes."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Wanna see?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This person's eyes shine as brightly as stars."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I cannot understand how such a pair of eyes could come into being in a world filled with lies, betrayal, and decay."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...No. "}]},{"spans":[{"text":"We need to get you out of here and give you a check-up."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as I expected, they don't show the slightest reaction to my teasing. "}]},{"spans":[{"text":"Even though they seem like such a warm and humorous person in my \"memory\"."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Can you contact the Dolls?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"No, the signal is completely jammed here."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gets off the bed, walks over to the door, and gives it a few light taps to get a feel of its thickness. "}]},{"spans":[{"text":"For some reason, this behavior makes them seem endearingly child-like."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I can see outside through this crack!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Why is that?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"You're right. Can we use it to escape?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Why is it that someone so ordinary can obstruct little Bill again and again?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let me try."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Why is it that someone so ordinary can stand at the center of so many whirlpools, yet remain staunch and unwavering?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":5,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Oh..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Are you okay?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Why..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander... just run..."}]},{"spans":[{"text":"Leave me..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Why is it that someone so ordinary can influence my memories, my actions, even my thoughts and emotions?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Get on!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"I want to know... the answer."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"██/██/████. ███, ████."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"So, have you found your answer?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"The Commander... is a brave soul. "}]},{"spans":[{"text":"That's all they are. "}]},{"spans":[{"text":"In different worlds, there are different endings. Like everyone else, they cannot escape death most of the time. "}]},{"spans":[{"text":"Perhaps they were meant to become a hero, but this world has no need for heroes, and this era has no place for heroes."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"I have a simpler word."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expressio