pression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jenny Dixon (?)","narrator":false,"pages":[{"spans":[{"text":"I'm giving this to you. It can ward off any calamity for you."}]}]},{"sprites":[{"prefab":"K5","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is this what you're giving me in return for the White Day chocolate? "}]},{"spans":[{"text":"Thank you, K5. I'll cherish it."}]}]},{"sprites":[{"prefab":"K5","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Jenny Dixon (?)","narrator":false,"pages":[{"spans":[{"text":"I don't know what you're talking about. "}]},{"spans":[{"text":"My name is Jenny Dixon... But I'm sure Miss K5 will be glad to hear that."}]}]},{"sprites":[{"prefab":"K5","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course. Don't worry, I'll keep it safe."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander smiles as they put away the crystal ball carefully."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Should I help you pack up, Miss Dixon?"}]}]},{"sprites":[{"prefab":"K5","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"No, I'll move before Miss Kalina gets here. "}]},{"spans":[{"text":"...I wish you a pleasant weekend, Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Thank you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
