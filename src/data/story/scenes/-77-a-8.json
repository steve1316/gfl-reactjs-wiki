{"name":"-77-A-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-RuinedCity","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_ev2412_tranquility","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"██/██/2064. White Zone, Frankfurt. "}]},{"spans":[{"text":"Several weeks after the Battle of Frankfurt, the buildings damaged in the war still linger across the city like scabbed-over wounds."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Construction Worker","narrator":false,"pages":[{"spans":[{"text":"Careful! The base of that crane isn't stable! Don't try to lift that much at once!"}]}]},{"sprites":[],"ops":[],"speaker":"Crane Operator","narrator":false,"pages":[{"spans":[{"text":"Got it. You stay back. No telling what's buried under the rubble. "}]},{"spans":[{"text":"They dug up an unexploded bomb while clearing the streets in Mainz the other day—lucky it didn't go off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Construction workers move through the streets and alleys, preparing for the city's reconstruction. "}]},{"spans":[{"text":"They are tasked with clearing every scar—and scars, by nature, can always split open again without warning."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"}],"speaker":"Construction Worker","narrator":false,"pages":[{"spans":[{"text":"Lift! Lift!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the crane carefully hoists the heaviest steel beam from the collapsed structure... two gray bodies beneath it send a chill down the workers' spines."}]}]},{"sprites":[],"ops":[],"speaker":"Construction Worker","narrator":false,"pages":[{"spans":[{"text":"Mein Gott, how did these get missed?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They are children judging by their size. They cling to each other, their lives taken by the flames of the explosion. "}]},{"spans":[{"text":"The older one holds the smaller tightly—an act of kindness and courage preserved in their final moment."}]}]},{"sprites":[],"ops":[],"speaker":"Crane Operator","narrator":false,"pages":[{"spans":[{"text":"...Sigh. Call the police. I can't handle this..."}]}]},{"sprites":[],"ops":[],"speaker":"Construction Worker","narrator":false,"pages":[{"spans":[{"text":"The police? I thought I saw them nearby just now."}]}]},{"sprites":[],"ops":[],"speaker":"Crane Operator","narrator":false,"pages":[{"spans":[{"text":"Those guys? They're no police—that's the army! Tsk... these Soviets, how long are they planning to stay on our turf?"}]}]},{"sprites":[],"ops":[],"speaker":"Construction Worker","narrator":false,"pages":[{"spans":[{"text":"Aren't they all under that... URNC now? "}]},{"spans":[{"text":"Who knows what they're up to. Hope this doesn't mean more trouble."}]}]},{"sprites":[],"ops":[],"speaker":"Crane Operator","narrator":false,"pages":[{"spans":[{"text":"No idea... but I've got a bad feeling... "}]},{"spans":[{"text":"The war's over, but... life hasn't gone back to the way it was."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They glance again at the bodies hanging beneath the crane. The victims resemble a charcoal sketch brought into three dimensions, frozen amid the ruins of the aftermath."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"},{"type":"background","value":"BG_City","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a narrow alley beside the ruins, armed URNC soldiers have already arrived at the entrance. "}]},{"spans":[{"text":"With practiced efficiency, they split into squads under their leader's signals and surround the building."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG_City","raw":"BIN"},{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On a rooftop not far away, two figures observe the scene. "}]},{"spans":[{"text":"Hidden perfectly in the shadow beneath a water tank, they appear like discarded fragments of the structure itself."}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"They're concentrating their forces here. Looks like they're preparing for a full-scale sweep. "}]},{"spans":[{"text":"No heavy weapons spotted yet. 404 should be able to break out even if surrounded."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That would've been true before. Don't forget, they've lost their most important asset now."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...?"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It might not matter to you, but 416 is their indispensable blade."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Let's rendezvous ahead of time. We have to make sure the item gets delivered to them safely."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202408_Warehouse","raw":"BIN"},{"type":"bgm","value":"10213","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, in the basement of a building, Kalina and the others remain unaware of the situation outside."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Long time no see, Kalin. "}]},{"spans":[{"text":"Kept you waiting, huh?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"M... M16?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing the figure emerge from the hidden door, Kalina finds herself at a loss for words, despite all the questions tumbling in her head."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Don't just stand there. Come in and have a seat. Make yourself at home. "}]},{"spans":[{"text":"How about a drink?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Stop joking! "}]},{"spans":[{"text":"Where the hell have you been?! "}]},{"spans":[{"text":"Do you have any idea everyone out there is—"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"—Looking for me? Yeah, I know. "}]},{"spans":[{"text":"They're trying a lot harder to catch me than they are you."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"You..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina bites her lip."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...I'm glad you're okay."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Alright, since everyone's here, I'll explain. "}]},{"spans":[{"text":"Kalin, you've already heard about the Commander defying the protocol and launching the final assault, right?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Yes. Tokarev told me. "}]},{"spans":[{"text":"Speaking of which, Tokarev and the others—"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"It's okay, Kalina. Someone will recover their neural clouds. "}]},{"spans":[{"text":"I don't know who exactly, but the Commander would never abandon a single Griffin Doll!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We're short on manpower, and they're valuable assets. "}]},{"spans":[{"text":"Cold as it sounds, I'd really like to have them repaired and back in action soon."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"...If only we could fix 416 too. "}]},{"spans":[{"text":"My workload's gotten so much worse without her."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"416's been working hard enough already. Let her rest for once."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Anyway, since you know about the Nidhogg Protocol and the Commander's final decision, I'll continue."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, in that operation... we failed to kill William. "}]},{"spans":[{"text":"The reason's unclear. But one thing is certain—the Commander has no intention of giving up. "}]},{"spans":[{"text":"And after the operation, they realized that the elite Nytos we destroyed weren't all of William's remaining forces. "}]},{"spans":[{"text":"William—or rather, Paradeus—still has numerous hidden labs and factories in Frankfurt. "}]},{"spans":[{"text":"Based on our intel, they all belong to Oberstein, and they're gradually coming back online."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We were shocked too—mostly that the Commander found out before we did. But it's true. "}]},{"spans":[{"text":"Looks like someone important is backing William."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"In other words, the problem isn't that brat anymore."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Paradeus' secret supporter—that's our real enemy."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Exactly. He's the one helping William reactivate those facilities."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"You mean..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Griffin Lyons."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"The Earl... "}]},{"spans":[{"text":"W-why would he side with Paradeus?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Because he's a filthy liar, a madman, and a politician. "}]},{"spans":[{"text":"He wants all of Paradeus' technology and research. "}]},{"spans":[{"text":"And what the Commander—and we—need to do now is make sure he never gets it."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...I feel like I've missed too much. "}]},{"spans":[{"text":"But if the Commander has chosen to fight, then I'll help them. "}]},{"spans":[{"text":"I finally found them again. I'm not letting them go off alone again without knowing anything."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I'll stay by their side. I'll fight with them!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Heh, what a touching confession. If I were the Commander, I'd have fallen for you already."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"F-fall for...? No, that's not—"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Relax, I'm just joking. "}]},{"spans":[{"text":"Surely you don't think anyone hasn't noticed, do you?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"That's not it! I was just... startled."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Anyway, where is the Commander now? Are they safe?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"As the hero of Frankfurt, they're under heavy protection. "}]},{"spans":[{"text":"We're actually the ones in danger here, not them."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Yeah, URNC forces have been chasing us nonstop."}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"We've been on the run every day. I can't even remember the last time I slept properly."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.9","raw":"CGDelay"},{"type":"sfx","value":"AVG_Knock","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, a rhythmic knock sounds at the door. "}]},{"spans":[{"text":"Kalina tenses immediately."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"W-who is it?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Relax. That rhythm—it's one of ours."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Good evening, everyone. "}]},{"spans":[{"text":"Unfortunately, you'll need to move again soon."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"You're... Miss AK-12? But weren't you—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Long time no see, Kalina. "}]},{"spans":[{"text":"I'd love to catch up, but there's no time."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"shown":true,"side":"left","tags":{}},{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"URNC forces are moving in."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"That soon? We just shook them off, didn't we?"}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"I can't walk anymore. Someone carry me, please and thank you."}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"They're the URNC's regular army units. It won't be easy to evade their search. "}]},{"spans":[{"text":"We'll have to keep relocating."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Understood. Get ready, 9, Gr G11."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Also, take this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 hands Kalina a communicator."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"What's this?"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's what I came to deliver. "}]},{"spans":[{"text":"A certain \"mysterious figure\" relaying the Commander's orders will use it to contact you with further instructions. "}]},{"spans":[{"text":"He seems like a nice guy, but... best not make him angry."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
