{"name":"-54-O-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"530","raw":"BIN"},{"type":"bgm","value":"10247","raw":"BGM"},{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"},{"type":"night","raw":"Night"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The rain keeps pouring down. Gunshots and firelight fill the night, turning the dark, ruined carriage into an endless corridor of nightmares."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie clings tightly to Erma's hand and runs through door after door."}]}]},{"sprites":[{"prefab":"Erma","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Are we really not going to take her? "}]},{"spans":[{"text":"At the very least, we ought to get her neural cloud core..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma looks back, but Maggie doesn't give her a chance to hesitate."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In fact, she's going so fast that she almost pulls Erma off her feet. "}]},{"spans":[{"text":"Maggie coldly interrupts Erma."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"If you waste a single moment, I'm going to leave you behind."}]}]},{"sprites":[{"prefab":"Erma","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click— "}]},{"spans":[{"text":"A message comes in through the comms channel."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"How long until you reach Carriage F02?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"40 seconds! "}]},{"spans":[{"text":"No, half a minute tops!"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Then, do you have any questions?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"We just need to wait, yeah?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"That's right. Help is on the way.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","na