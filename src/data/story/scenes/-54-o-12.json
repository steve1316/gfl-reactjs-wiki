":" "}]},{"spans":[{"text":"I work for the Military.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The transmission seems exceptionally quiet for a moment."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"10 seconds.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Is your real name Lyudmila?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...It's a name I have given myself.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"With that, Lyudmila terminates the transmission. "}]},{"spans":[{"text":"She listens to the pattering of rain outside the door, then she lowers her head and sighs."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Instructor Я","narrator":false,"pages":[{"spans":[{"text":"...Do you regret this?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"You suck at telling jokes.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Instructor Я","narrator":false,"pages":[{"spans":[{"text":"You're the field commander now, so this is your choice, whether you lose or win."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"It's OUR choice, Instructor Я. ","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"...Because we are one.","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"},{"type":"background","value":"533","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F01, Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After taking in the fleeing passengers, the already cramped space becomes even more packed. "}]},{"spans":[{"text":"That unpleasant exchange at the door, in particular, has clearly divided the carriage into two camps. Dr. Rugosa is caught in between the original occupants and the later arrivals as they stare daggers at each other."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Despite being sandwiched between the two parties, Rugosa seems almost oblivious to the tension."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"Clean her wounds."}]}]},{"sprites":[{"prefab":"NPC-TD_Boy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucas","narrator":false,"pages":[{"spans":[{"text":"Yes, doctor."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He is entirely focused on the girl lying on the table. Much of her exposed skin shows small-scale silicification... "}]},{"spans":[{"text":"Fortunately, it's not very deep. Unfortunately, the harsh environment and her already frail constitution have caused complications that might kill her before ELID does."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lucas wipes the sweat from Dr. Rugosa's forehead."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom—! "}]},{"spans":[{"text":"The firelight outside the window suddenly flickers, and a massive explosion comes from the other side of the door, which makes all the passengers shudder. "}]},{"spans":[{"text":"...Those ruthless killers are still sweeping the train."}]}]},{"sprites":[],"ops":[],"speaker":"Well-Dressed Woman","narrator":false,"pages":[{"spans":[{"text":"...What's in it for you to work so hard on saving her?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A woman from among the crowd watches Rugosa work and ventures a nervous question."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, Dr. Rugosa's hands do not falter in the least because of the approaching shadow."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"This girl's only family is a droid that none of you would even bother to look in the eye. "}]},{"spans":[{"text":"Right now, he is doing his best to fix the train's emergency systems."}]}]},{"sprites":[],"ops":[],"speaker":"Rosita","narrator":false,"pages":[{"spans":[{"text":"Ugh..."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"If HE hasn't given up yet, then how could I?"}]}]},{"sprites":[],"ops":[],"speaker":"Well-Dressed Woman","narrator":false,"pages":[{"spans":[{"text":"...He's a droid. Protecting us is his job."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"And I'm a doctor. Saving people is MY job."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After muttering deliriously for some time, Rosita's labored breathing gradually eases up."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rugosa checks her temperature with the back of his hand, and he, too, sighs in relief."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, the darkened carriage is suddenly bathed in the light again. "}]},{"spans":[{"text":"This sudden surprise banishes the dark clouds hanging over everyone's head. The passengers, who were all so glum just a second ago, all look up and around in a daze."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"It's not yet time to give up."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dr. Rugosa's deep and sonorous voice fills the room."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"...The dawn will come soon."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Muttering to himself, the doctor pulls a blanket over Rosita. He looks up at the tightly-shut carriage door."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The rest is up to you, Madam Instructor."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"1","raw":"BIN"},{"type":"effect","value":"%%code=CJ_rain%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Captain Ivan raises an eyebrow as he looks down at the corpse before him. "}]},{"spans":[{"text":"Danil's eyes are wide, like his death had completely taken him by surprise."}]}]},{"sprites":[],"ops":[],"speaker":"Captain Ivan","narrator":false,"pages":[{"spans":[{"text":"Dump the corpses here. "}]},{"spans":[{"text":"We just witnessed an in-fighting among the Sakharovs, tut-tut."}]}]},{"sprites":[{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Soldier A","narrator":false,"pages":[{"spans":[{"text":"Yes, sir."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As he looks at the relit train in the distance, Captain Ivan picks up his communicator and makes a call."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click— "}]},{"spans":[{"text":"The call connects."}]}]},{"sprites":[],"ops":[],"speaker":"Captain Ivan","narrator":false,"pages":[{"spans":[{"text":"We have swept through 21 carriages so far. "}]},{"spans":[{"text":"Should we continue?"}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Proceed.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You are too inefficient.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Captain Ivan","narrator":false,"pages":[{"spans":[{"text":"Then grant us permission to use heavy weapons."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Permission granted, but wait until I eliminate this target.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker"