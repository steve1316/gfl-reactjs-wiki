ab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Not like I remember; it's a brand new experience each time.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"You sound pretty upset alright.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Who are you, and what have you done with Maggie? Why are you talking about all this crap?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Just making idle conversation since we've got nothing to do anyway.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Quit pretending! We're Dolls, not humans.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If something feels bad, all we have to do is get rid of the memories. It's tiring enough just to survive. Who's got the energy to overthink such things, anyway?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"I'm not pretending, I'm just...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Who's that?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Halfway through the conversation, Maggie senses something, and the gentle tone she's using with Catherine instantly changes."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Ahem... Uh... I didn't mean to eavesdrop on you guys...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"But you already did, didn't you?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Well, I picked up some signal fluctuations and thought it was something extraordinary.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Sorry to bother you, please continue.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"What, you think you can just walk in and out as you like?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Quite the hacker, aren't you?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Catherine, good job on picking this body for me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Oi.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"You do know, right? Your train ride isn't free.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I do now.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"No wonder you didn't want money but rather wanted me to put my body up as collateral.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So, am I getting back the 2 ounces I earned on the Colt Express?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine hangs up without any hesitation."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"530","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"At the gangway connection between Carriages F01 and F02 of the Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The faint scent of blood hangs in the air, and the mood is heavy and stagnant."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"That is, until a crisp sound rings out, and everyone turns to the Doll fiddling with the door."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...♪"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie turns around, bathing in the audience's attention before executing a stylish bow."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Greetings, dear passengers. "}]},{"spans":[{"text":"The carriage F01 that you've booked is now ready. "}]},{"spans":[{"text":"Enjoy your trip~"}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Stewardess Maggie, I'd like a seasonal set meal."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"I'll have to charge an extra fee for that."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ignoring the two of them, Lyudmila enters the carriage and gives the interior a quick once-over."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"For some reason, this place is empty. "}]},{"spans":[{"text":"However, given how dangerous the current situation is, Lyudmila leaves that question aside for now. "}]},{"spans":[{"text":"She comes back out and nods to everyone."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Considering the level of the defenses here, we should be able to make it to Poznań if they don't hit us with heavy firepower."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"I'll be going in first, then... The rest of the \"show\" is up to you."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Right."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The passengers hurriedly squeeze into the first-class carriage, leaving Rugosa at the doorway to exchange some final words with the Dolls. "}]},{"spans":[{"text":"Rugosa looks at Lyudmila and bows solemnly to her."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"We're counting on you."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Close","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila silently closes the door to the first-class carriage. "}]},{"spans":[{"text":"In an instant, there are only three Dolls left at the gangway connection."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_3","raw":"BGM"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...It's kind of late to say this now, but... "}]},{"spans":[{"text":"Can we really do this with just the three of us?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Well, if you want to back out now... "}]},{"spans":[{"text":"I can do this myself."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Really? Your words, not mine."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma looks up at Maggie."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I took a look around your neural cloud while I was reconstructing the comms signal."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"That's very rude, Miss Erma."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma doesn't seem embarrassed at all. Instead, she seems even more righteous than before."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"If you don't work with Lyudmila... "}]},{"spans":[{"text":"I'll scrap your precious Colt Express."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie's mouth twitches."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...You REALLY know how to pick people, Catherine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The three of them are briefly silent."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, an encrypted transmission suddenly enters Lyudmila's private channel."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Madam Instructor.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I hope you haven't forgotten your role and mission?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Getting rid of you on the spot isn't all that difficult, you know.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR18","express