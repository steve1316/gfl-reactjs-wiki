{"name":"-1-4-1","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Some time later, near the Sangvis Ferri jammer in Area S06."}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Found you, 404."}]}]},{"sprites":[{"prefab":"UMP9","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"街道","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Uwaa!"}]}]},{"sprites":[{"prefab":"Weaver","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Stop hiding. Your legs...have already given up on you, haven't they?"}]}]},{"sprites":[{"prefab":"UMP9","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Y-y-y-you're Ouroboros?!"}]},{"spans":[{"text":"H-h-h-h-h-how did you find me?!"}]}]},{"sprites":[{"prefab":"Weaver","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Your ability to hide is no longer effective. Griffin's identification signals are all over the map now."}]}]},{"sprites":[{"prefab":"UMP9","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"How could this be...? It was hard enough for us to escape back there, and now..."}]}]},{"sprites":[{"prefab":"Weaver","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text"