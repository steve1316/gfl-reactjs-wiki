{"name":"-31-3B1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"168","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An hour after the destruction of the quarantine wall. In the city of Belgrade."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The gunshots and screams have been replaced by the howling gusts crashing through the streets. "}]},{"spans":[{"text":"No sign of activity can be seen among the buildings."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...With a small exception."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"All clear. Let's move."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two Dolls run through the alleyways one after the other."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"One advances in the front while the other walks backward to keep an eye on the rear. They guard each other's backs vigilantly."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Stop. The drone detects ELIDs up ahead."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Should we go around?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"There aren't too many of them. We're in a rush so let's plough through them. "}]},{"spans":[{"text":"Just giving you a heads-up so you can prepare for combat. You take the left, I'll focus on the right."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Understood. Thanks for the concern."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Their gunshots are muffled by suppressors and the storm. All that can be heard is the Dolls' footsteps and the clangs produced by empty shell casings falling on stone bricks. "}]},{"spans":[{"text":"After a while, the duo cross the main street, which is littered with human and ELID corpses, and enter another alley."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"If we're only talking about combat, you might actually make a decent partner."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Your friend told me a few things about you so I didn't expect much from you in battle."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...That only serves to illustrate that a deserter who didn't even bother to say goodbye is not a reliable source. "}]},{"spans":[{"text":"People who believe in gossip and pry into others' affairs are even more unreliable."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Don't misunderstand, I'm genuinely curious, and I intend to keep observing you like a hawk. "}]},{"spans":[{"text":"But right now we have more important things... Ange? What's the matter?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Are you reading AN-94's and AR-15's signals?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...Nyet, we haven't received any signals or picked up any transmissions so far. "}]},{"spans":[{"text":"You haven't been able to contact them?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's why I'm asking you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It's been almost half an hour since they last got in touch. I just have a bad feeling about this.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"How far are you from the opera house?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Judging by the direct distance... Another ten minutes on foot, I'd say."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Assuming nothing unexpected happens on the way."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Have you found the new safe house, Ange?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't worry about me. It's pretty safe where I am. Just focus on re-establishing communication with AN-94 and AR-15.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I hope you're right. If you've got ELIDs where you are, we're too far away to run to your rescue, you know."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Anyway, just get there ASAP. If there's any new information or development, give me a report immediately.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I can fend for myself. Ange out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Is she going to be alright?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Why wouldn't she be? "}]},{"spans":[{"text":"She said she's okay on her own, so she's going to be alright."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What a clear and simple answer."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It'd be too much to have two Dolls muttering to themselves in Task Force DEFY, don't you think?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"159","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 and AK-12 resume their course toward their destination. After passing through who knows how many streets and alleyways, they finally arrive at a square."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Is this the opera house...?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Da, this is it. The building facing the square with the bronze statue of a rider. "}]},{"spans":[{"text":"But this terrain... I'm afraid we can't just barge in through the front doors."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Didn't Ange tell us to find them ASAP?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Better late than never. There's a difference between giving prompt support and waltzing right into a trap. "}]},{"spans":[{"text":"Contrary to the narrow streets with plenty of cover, the square is exposed and can be easily monitored from a high vantage point. "}]},{"spans":[{"text":"Whoever won the fight is most probably ready to take us on."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then what do we do? We're this close already. We can't just stand here and stare at the opera house."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Let's take a few minutes to scout around the building first and try to see if anything seems wrong in there. "}]},{"spans":[{"text":"We'll have to enter eventually, but I don't want to be blown into smithereens before we even get inside."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 may be smug and brash, but her strategies are always extremely cautious."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 follows her closely through side streets and alleys as they take a slow and convoluted route toward the opera house. "}]},{"spans":[{"text":"After a while, M4A1 can no longer resist the urge to ask AK-12 this question."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Aren't you at all worried about AR-1...AN-94?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"A little, but not as worried as you are about AR-15."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Hmm..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Unlike suicidal maniacs like you and AR-15, AN-94 has a very clear idea of who she is and what role she plays. "}]},{"spans":[{"text":"Even if AR-15 wants to do something stupid, I'm sure AN-94 will try to stop her."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That's why you seem so carefree... "}]},{"spans":[{"text":"...Now that I think about it, even though AR-15 and I have always been on the same team, I can't say I know her very well. "}]},{"spans":[{"text":"I haven't been able to have a proper talk with her either ever since we were reunited."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Wanna join my Human and Doll Observation Club? If you pay your member's fee now, you can be our second member."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Is that a joke?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Everything you do gives me great insight, even your highly defensive reactions."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I can never tell...if you're being serious or not."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I am always dead serious."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Also, I need to concentrate on searching the area. Please keep an eye on the comms channel and see if you can pick up on anything nearby."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Nothing. "}]},{"spans":[{"text":"We're already so close but we still haven't heard anything from AR-15 and AN-94."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Don't just search for friendly signals. Turn off your IFF for the time being. It'd be great if we can pick up anything even from S.F. or the white things."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The only thing I'm receiving is the emergency broadcast channel... "}]},{"spans":[{"text":"They seem to be urging citizens who couldn't make it to bunkers in time to find shelter in the cathedral."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Oh? Are they actually being so ostentatious? I'll bet you anything this isn't part of K's plan. "}]},{"spans":[{"text":"It would seem that the Griffin Commander isn't really the type to do things by the book."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yeah... The Commander has helped us out a lot even though we never expected any help."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Well, thanks to your Commander's broadcast, I now have a pretty good idea on the situation here. "}]},{"spans":[{"text":"I'm absolutely certain that we'll be walking into an ambush in the opera house."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"How can you be so sure?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The fact that the radio broadcast is still transmitting shows that the interference caused by the storm isn't strong enough to shut down communications in the whole area. "}]},{"spans":[{"text":"However, the opera house is as quiet as a black hole. That's totally unnatural."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I see... That means there must be jammers in there."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm glad to see you're keeping up. "}]},{"spans":[{"text":"We have a tough fight ahead. Are you ready?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You bet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two Dolls exchange a smile."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Their footsteps soon disappear behind the front doors of the opera house."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
