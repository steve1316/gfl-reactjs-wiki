":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"(Whispers) I-I know. You don't have to remind me..."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Um... So you're the commander in Area S09?"}]},{"spans":[{"text":"Uh... Thanks for your help, and..."}]},{"spans":[{"text":"...That's all. I salute you. Over."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"树林","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"}],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Huh? Is that all?"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"We're T-Dolls. We just have to carry out our missions."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"But...you seem to be blushing? Are you embarrassed?"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"W-Why would I be?! Besides, I was born to fight. It's only natural that I'm not good with words!"}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"So are you admitting or denying your embarrassment..."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Shut up. Aren't you here for the recon report? You got it, so get lost already."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Thank you, Miss WA. Here are some supplies that Miss G36 prepared especially for you."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"Oh... Chocolate ice cream? As expected of G36. She knows me."}]},{"spans":[{"text":"But don't you dare tell a soul... WA2000 loves ice cream? What a joke."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Um... I am very sorry..."}]},{"spans":[{"text":"But actually... The commander is still on the line..."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"}],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"...Why didn't you say so earlier?!"}]}]}]}
