{"name":"-75-A-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0%%range=3","raw":"controll_shake"},{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"480","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev watches the streets of Frankfurt blur past the car window. This city, once something she longed to see, feels utterly foreign now. "}]},{"spans":[{"text":"The traces of war are everywhere. The roads are scarred; the walls of many buildings are pockmarked with bullet holes, some have even collapsed entirely."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"What used to be a bustling commercial district is now empty, with only a few pedestrians hurrying through."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's car passes a hastily constructed military checkpoint. A few soldiers lazily wave them through. Judging from their gear and posture, they're clearly a militia unit pressed into service at short notice."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"730","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...The Neo-Soviet garrison is still here?"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kalina","narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina doesn't answer. Her hands are locked tightly on the wheel, knuckles pale."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"159","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Motorcycle","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After driving a while longer, she pulls into a quiet corner, letting the car blend into Frankfurt's nightscape."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"background","value":"730","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...They say the Commander is dead."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev, who has been silent ever since they left the warehouse, can no longer hold herself back."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Impossible! ...They're lying! This has to be a lie!","style":{"size":"50"}},{"text":" "}]},{"spans":[{"text":"The Commander... How could the Commander possibly...?!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Calm down, Tokarev!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina grips the steering wheel even harder."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"…I don't believe it either."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"But the news reported it last night. "}]},{"spans":[{"text":"They said the Commander was taken hostage by the rogue Doll Dandelion and forced to drive a military tank into the White Zone to carry out a terror attack. "}]},{"spans":[{"text":"The vehicle exploded upon entering the zone. Dandelion was destroyed, and the Commander... is missing."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Missing? How...? And who even is Dandelion?!"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"M4's OGAS. I'm sorry, we kept her identity hidden from you for various reasons. "}]},{"spans":[{"text":"But... she would never betray the Commander. She would never betray us."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...So the news is fabricated?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...I don't know yet, but something is definitely off. For example, they claimed the tank was full of Doll fragments belonging to Dandelion. "}]},{"spans":[{"text":"But Miss Dandelion's body is... special. If she left behind \"fragments\", they wouldn't be mistaken for standard Doll parts. "}]},{"spans":[{"text":"The moment I learned about this early this morning, I rushed here non-stop from the Neo-Soviet Union... "}]},{"spans":[{"text":"I was in such a hurry Helian even had to handle my discharge papers for me."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"When I arrived, I was confronted with this unfathomable situation... "}]},{"spans":[{"text":"The Commander vanished without a trace, all of you got put into a forced shutdown by some absurd protocol and even had your Griffin authorizations revoked..."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"The government has no corpse, no evidence, nothing... yet they announced the Commander's death and terminated the investigation. "}]},{"spans":[{"text":"Even Mr. Kryuger refuses to tell me anything. He won't even meet with me!"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Something is being hidden from me. I'm sure of it..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's voice breaks into a desperate, trembling sob. "}]},{"spans":[{"text":"Only now does Tokarev fully realize how cornered and helpless Kalina must have been, to resort to illegally reactivating her."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...So I came to you, Tokarev. "}]},{"spans":[{"text":"You're the only one who can tell me... what on earth really happened yesterday. "}]},{"spans":[{"text":"And what happened to the Commander... these past days."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Tokarev","narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Tokarev closes her eyes."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Let me start from the beginning."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"730","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Horn_Car","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina slams her fist against the steering wheel. "}]},{"spans":[{"text":"The horn blares sharply, startling a flock of crows drawn by the scent of decay."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"How could they do this?!"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Miss Kalina... please calm down!"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"How am I supposed to calm down?! They... they actually...!"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kalina","narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina forces a deep breath to steady her heaving chest."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...If I had known... even if I could barely stand, I would've gone with the Commander."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Your absence was not to blame for this outcome. "}]},{"spans":[{"text":"Even if you were here, I doubt it would have changed anything."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina bites her lip."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...The Commander must have needed someone at their side..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She slumps back into the seat, covering her face with both hands, feeling utterly defeated."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"So much happened while I was in the hospital... Miss Ange... even she... That can't be true either, right?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...I don't know the details, but I'm afraid that part about Miss Ange is very much true..."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina turns her face away, maybe to hide her expression, but Tokarev still hears the quiet sobs."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I know... this is probably all you know about what happened earlier. But I need to figure out—what about yesterday? "}]},{"spans":[{"text":"What happened yesterday?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"I don't know all the details as I wasn't allowed to take part in the Commander's strategic meeting. "}]},{"spans":[{"text":"But before the protocol activated—meaning the day before yesterday—the Commander received a call from some important figure. After that, they summoned us and informed us about the protocol. "}]},{"spans":[{"text":"To prevent the Commander from carrying out their next operation, IOP would gradually revoke their command authority over all IOP Dolls within the following twelve hours."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Operation...?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"To eliminate Paradeus and William."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...And then?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"The Commander let us decide whether to stay or leave."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"None of us backed down."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"After that, we followed the Commander and fought our way from the Elmo into the White Zone... or at least, we should have."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...\"Should have\"?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"In one final \"charitable gesture\", Mr. Havier staggered the activation of the protocol across 12 hours, with its effect spreading from the weakest Dolls to the strongest, giving the Commander strength for one final battle. "}]},{"spans":[{"text":"...I'm sorry, but I'm not one of Griffin's stronger Dolls. Before we even entered the White Zone, I lost consciousness. "}]},{"spans":[{"text":"And when I opened my eyes again... it was your face I saw."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kalina","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"In other words, you also don't know what happened inside the White Zone, or what happened when the Commander \"disappeared\"?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...I'm very sorry."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina falls silent, as if the last glimmer of hope has been snuffed out."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"I'm so sorry, Miss Kalina."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina's voice sounds bitter and hollow."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"No... it's not your fault. "}]},{"spans":[{"text":"I just... Thought... I'd at least find someone who knew something. "}]},{"spans":[{"text":"But in the end... I can't even confirm whether the Commander is alive or dead."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I was gone for only a few days... and everything's changed. "}]},{"spans":[{"text":"I should've been there. I should've faced it all with the Commander. "}]},{"spans":[{"text":"Even... even if it meant dying, I should've been with them..."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Miss Kalina, please don't say that. "}]},{"spans":[{"text":"If you had been there, the Military likely would have restricted your movement—or detained you entirely."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Right now, you're the only one still free to seek the truth."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Besides, even if I don't know what happened in the White Zone, we do have a lead— "}]},{"spans":[{"text":"If there really was an explosion, there would have been records of a formal investigation and body recovery."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Even the fiercest blasts leave DNA traces or identifiable remains. "}]},{"spans":[{"text":"But the authorities have no body and refuse to provide evidence."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"You... you're right."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"We need to find proof, Tokarev. "}]},{"spans":[{"text":"Whether it proves the Commander is dead, or that they're alive—I need to see the truth for myself."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"We should inspect the site. "}]},{"spans":[{"text":"The authorities must have already investigated and cleaned up, but there will always be traces left behind."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Not to mention..."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],