..I disagree. "}]},{"spans":[{"text":"We can't reveal DEFY's existence so easily."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"But if the situation remains as it is, our mission will incur additional risk."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Let me think, there must be some other way..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Some other way? Now I'm kind of looking forward to it. "}]},{"spans":[{"text":"Still, you'd better come up with it quickly... Time is running out for us."}]}]}]}
