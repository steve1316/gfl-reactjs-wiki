":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Of course I know what the consequences are, AK-12.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So we'll be pointing our guns at humans then, is that it?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"According to the information you sent, there aren't many humans among the rebels. The bulk of their fighting strength is made up of automaton units and mechs.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Destroy their automatons, wreck their mechs, ease the pressure on the defenders... That's all you need to do. It'll be enough.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Of course, if you have no choice, then you need to be prepared to open fire on human beings.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Ange, while I don't mean to second-guess your orders, is it really wise to intervene in a firefight that's unrelated to the mission? "}]},{"spans":[{"text":"Isn't our aim to find and destroy the Pike Node?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Thi