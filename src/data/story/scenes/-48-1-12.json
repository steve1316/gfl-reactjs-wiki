{"name":"-48-1-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin Base, Area S09, Neo-Soviet Union."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Has Kalin been transferred to a specialized hospital?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the command room, Persica suddenly inquires with a steaming cup of coffee in her hand."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"She does the most in-depth data compilation I have ever seen... "}]},{"spans":[{"text":"I hope her condition won't deteriorate any further."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Miss Persica. "}]},{"spans":[{"text":"While there might still be a shortage of medicine... "}]},{"spans":[{"text":"With enough care and the right treatment, she will definitely get better."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I hope so. "}]},{"spans":[{"text":"...What about the juvenile Nytos?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"They're now under Mr. Havier's temporary custody."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"What a shame... That old geezer."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"While Kalina is absent, if there is anything you need, just let me know."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica's face is lined with exhaustion."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"The mood here is slightly better than at IOP. "}]},{"spans":[{"text":"But I didn't expect I'd still have to work overtime here..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Thanks to you, the recovery of our Dolls has been progressing very smoothly."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"That goes without saying. "}]},{"spans":[{"text":"I didn't come here to ride the gravy train."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"When the Commander returns, I'm sure they will also be glad to learn—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Just then, the communicator lets out a chirp."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"... Caller unknown?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief moment of hesitation, Helian decides to take the call."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"This is Griffin Base S09. "}]},{"spans":[{"text":"State your business."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-DinnerNoMan","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Berlin, Germany."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Cheers","raw":"SE1"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clink. "}]},{"spans":[{"text":"After the waiter puts down the beverages, the two men sitting on the sofa clink glasses lightly."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The situation in Berlin has been rather tumultuous lately, I hope you didn't mind the abrupt invitation to this meeting, Earl."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"With the help of the Nationale Volksarmee, I'm sure this so-called \"turmoil\" is no more than insignificant ripples on the surface of a lake, General Schweinsteiger."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"How many regimes' collapse started with such \"insignificant ripples\"? As the Minister of Defense, I am not so confident."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Heinrich Schweinsteiger, Minister of Defense of the German Democratic Republic and Vice-President of the National Defense Council. "}]},{"spans":[{"text":"A man holding such important positions can only have the most extraordinary amount of experience."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Well, it's your job to worry about such things, though I believe you didn't invite me here just for this glass of German brandy?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"You haven't changed at all, Earl. We haven't seen each other for more than a decade, have we?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"14 years."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Can't believe it's been that long already. We were still relatively young then. What was your job again? You were a journalist?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Just the chief editor of a small news agency. What, reminiscing about wartime?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Why would anyone reminisce about that, Earl? "}]},{"spans":[{"text":"There's nothing nostalgic about sending young people into trenches. However, in order to prevent that from happening again, we must never forget. Isn't that right, Mr. Journalist?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Forgive me for being blunt, but what are you doing in Berlin these days?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Enjoying a hard-earned vacation, nothing more."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"It may be a vacation to you, but your presence is giving a lot of people in the government a massive headache."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"The conference that will decide the future is about to begin. Consider my visit necessary for some preparatory work."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Earl, we both know full well what you're doing here and on whose behalf. "}]},{"spans":[{"text":"It's no secret where the Council stands on this matter and what the party thinks of this. "}]},{"spans":[{"text":"I've got to remind you—the Nationale Volksarmee has its own standpoint and considerations, and the German people know how to tell friends and foes apart. "}]},{"spans":[{"text":"Please respect our decision."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"It would be a shame if it really had to come to that."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"I agree, which is why you must exercise restraint to prevent it from coming to that."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Can I take this as a warning from our \"friend\"?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin lifts his glass again."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Hahahaha, nobody is warning you, Earl. "}]},{"spans":[{"text":"It's just a piece of friendly advice to save us all from an awkward situation. "}]},{"spans":[{"text":"After all, the founding of the Union of Rossartrism is just around the corner, and every single one of us has a duty to defend the Union's interests."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"But of course. The future of Europe hinges on Germany's decision, and Germany's future hinges on your decision. "}]},{"spans":[{"text":"So may I construe this as your official reply to the Council?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Good God, not at all. I'm just an old man who wants to spend some time catching up with you."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Alright, then I'll look forward to \"Faust\" tonight."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"But speaking of which, tension has been on the rise again, especially once the conference was scheduled. "}]},{"spans":[{"text":"Oberstein has been very troubled ever since he returned from London. Please tell me the truth, Earl. "}]},{"spans":[{"text":"What really happened in London?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"The future."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"The future?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"That's right, General. It has always been the future that the Council sets its eyes on."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"The \"future\" is such a vague term. At this point, Germany can only afford to focus on the present."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Have you ever considered the fact that it is precisely because the future is obscured that we find every single passing day so riddled with hardship? "}]},{"spans":[{"text":"There will always be some people who can't see the situation for what it is, but time will always be on our side."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"That's true, time is on our side... Until this run-down building gets knocked down."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger takes out an exquisite-looking invitation card and places it on the table."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"We are now at the crossroads of fate. One wrong choice and we will go down in history as villains. "}]},{"spans":[{"text":"We must do our duty to our countries. Is a stable Europe part of the future you mentioned?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Of course."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Then have a chat with my friend here. Maybe we can turn a new page together."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin looks down at the address written on the invitation. He knows exactly who will be waiting for him there. "}]},{"spans":[{"text":"This must be Faust's deal."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Please inform Mr. Oberstein that I most graciously accept his invitation."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin rises to his full height and is just about to stow the invitation in his pocket. "}]},{"spans":[{"text":"But Schweinsteiger keeps his fingers pressed on the invitation, with seemingly no intention of handing it over just yet."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"What is the meaning of this?"}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"There's another personal matter."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"...Please go ahead."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Oberstein... is plagued by the past because of something. "}]},{"spans":[{"text":"At this point, I believe I have the right to know what it is."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"I'm sure you know me much better than I do."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Lunasia."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Oberstein's daughter. "}]},{"spans":[{"text":"What exactly happened back then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin eyes the general before him and suddenly realizes... he has not taken a single sip out of his wine glass. "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"gunCGlake","raw":"BIN"},{"type":"bgm","value":"GF_21winter_avg_mahaline","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the outskirts of Berlin, Germany."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Moist soil slips through the Commander's fingers as they stare at the freshly relaid earth in a daze."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Sorry, Commander... "}]},{"spans":[{"text":"This is all we could find."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes the long piece of metal sheet from RO635 and sticks it in the ground in front of them."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Here lies two pure souls... "}]},{"spans":[{"text":"\"who gave their lives to light a candle of hope for the world.\""}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"It's probably for the best that we leave out their names."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Someone will remember them. We will, at the very least."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander clasps their hands together and closes their eyes in silent prayer. "}]},{"spans":[{"text":"After a short while, they stand up and dust themselves off."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"A-Are we really not taking them back with us?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"We don't have time for this... We're in enough danger as it is. "}]},{"spans":[{"text":"We'll only regret it if any harm comes to their bodies. "}]},{"spans":[{"text":"This is a good spot... It's remote and quiet, and the view is nice."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You do have a point, and I must applaud your excellent choice. "}]},{"spans":[{"text":"If I ever need to be laid to rest, could you take care of my funeral?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ignoring UMP45's quip, ST AR-15 silently follows the Commander's gaze and contemplates the crude and simple gravestone."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 watches on. Then with a shrug, she turns around and heads back toward their vehicle."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45, this is bad!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What's wrong?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While everyone else is in solemn mourning, UMP9 suddenly calls out urgently from inside the vehicle."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Get in!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What happened?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"416 turns her head angrily and glares at the restrained Morridow."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What we were dreading came true after all. "}]},{"spans":[{"text":"This bitch somehow opened a crack during our interrogation and broke through the electronic seal for a short period of time. "}]},{"spans":[{"text":"Though we pulled out just in time and closed down the signal flow... "}]},{"spans":[{"text":"She still managed to get a message out."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What? What did she send?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I don't know, but if it were me, I would definitely go with—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10230","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"—Our location. "}]},{"spans":[{"text":"SOP-II, AR-15! "}]},{"spans":[{"text":"Get—"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM!!!!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Aiiieee?!"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Commander, watch out!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The loud explosion is followed by chaos. "}]},{"spans":[{"text":"At that moment, the Commander feels the world spinning upside down all around. "}]},{"spans":[{"text":"The blast has sent their vehicle rolling."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ugh...!"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Not good, 45! "}]},{"spans":[{"text":"A large Paradeus force is closing in!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander, are you alright?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 rushes over to drag the Commander out of the overturned vehicle. "}]},{"spans":[{"text":"In their state of confusion, the Commander can just make out the fast approaching white battalion."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...RO, 45, prepare to sortie!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Roger!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Like we ever had a choice... Let's move it!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
