pression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig grips her blade. Even though she is quite badly injured, she shows no intention of giving up."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Save your breath, Commander. Just tie her up and I will extract what you want to know from her."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I agree."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The T-Dolls form a second ring outside the Sangvis encirclement, closing in on the injured Grig."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Be careful, she's still got some fight in her."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That can easily be remedied. "}]},{"spans":[{"text":"Hey, you from S.F.! Give her another round."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"...I find you rather lacking in manners. "}]},{"spans":[{"text":"But I shall grant your request."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"typ