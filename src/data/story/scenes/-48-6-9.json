{"name":"-48-6-9","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10118","raw":"BGM"},{"type":"background","value":"229","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum... "}]},{"spans":[{"text":"In the enclosed space, Grig deflects gunshots with her blade and darts around from obstacle to obstacle."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":1,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Take this!"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...Tsk."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The advantage in her ghostly speed is largely mitigated in these battle conditions."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"BOSS-5","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Alchemist","narrator":false,"pages":[{"spans":[{"text":"Where are you going, my lovely?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...These Dolls are consciously restricting her movements by forming an encirclement around her."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"(Exhales)"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her slash sends Executioner stumbling back several steps. "}]},{"spans":[{"text":"Her disadvantage will only get worse if this goes on..."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"You're not getting away!"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig is just about to break through the encirclement using the opening she just created, but is intercepted by Gager, who has stepped up to take Alchemist's place. "}]},{"spans":[{"text":"Grig has been caught in their formation."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"In that case..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig backs off quickly and leaps towards the corner. She runs up the wall with light steps that defy gravity. "}]},{"spans":[{"text":"To the Commander's human eyes, she looks exactly like a specter climbing up to the ceiling."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Good job. She fell for it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The drone sticking to the ceiling suddenly lights up. Grig immediately changes direction—"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,