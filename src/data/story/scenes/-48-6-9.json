:"effect","value":"%%code=CJX_xm_yan%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, a shot is fired, and a grenade lands near the group. When it blows up, it generates a thick cloud of smoke."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"(Coughs) Crap, someone's here! Executioner, behind you!"}]}]},{"sprites":[{"prefab":"BOSS-2","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Huh?! Ugh!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A powerful mechanical tail suddenly pierces through the smoke and sends the already exhausted Executioner flying with a mighty swing."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Gray?!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"... Come with me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The gray figure reveals herself amid the smoke. "}]},{"spans":[{"text":"The tail that has struck Executioner suddenly stretches out and wraps around the injured Grig, then Gray takes off with no hesitation."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"222","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Gr G11, seven o'clock! Open fire to intercept!"}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Leave it to me!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bangbangbang!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Tsk."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Gray, you—!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Keeping her coiled tail behind herself, Gray shields her face with her claw-blades as she is assaulted by a torrent of bullets."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":5,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Ugh...!"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"This isn't part of the plan... You shouldn't have come!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"...The plan makes no mention of your defeat either."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The hail of bullets is taking its toll on Gray. As her movements grow more sluggish, the Commander seizes the opportunity right away."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"She won't be able to fight back!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion! Work together with the Dolls and prepare to surround them!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"No problem... I've been looking forward to this bit."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":5,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Despite her terrible condition, Gray suddenly holds up her hands and flashes the Commander her usual, charming smile."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"... Commander, don't you want to know what happened to Ange?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Oh boy... Even Paradeus isn't above such tricks either."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You have something to tell me?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Why don't we make a deal?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let you and Grig go, and you'll give me Ange?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Quite a good deal, isn't it?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander, this is definitely a trap."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Do you think I will fall for it again?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander signals behind their back. The AR Team completes the formation with great coordination."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You want a deal? Alright, but leave that Nyto behind. "}]},{"spans":[{"text":"You can take her with you when you bring Ange here in one piece."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray takes two steps back with an odd look on her face. Her movements are putting everyone on edge again. "}]},{"spans":[{"text":"Behind her is the door that Grig was guarding."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"...No problem. We can make this exchange right now. "}]},{"spans":[{"text":"You want Miss Ange? Then I'll give you Miss Ange."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Gray_Hand_Mech","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray retracts her claws and swishes her tail to one side before reaching out to pull the lever next to the door."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Here, come say hello to Angelia."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Prison_Door","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray pulls the lever down and opens the door with a dazzling smile."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"effect","value":"%%code=CJX_xm_yan%%","raw":"common_effect"},{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The heavy door grunts when the mechanism kicks into action. Thick, white smoke pours through the widening gap. "}]},{"spans":[{"text":"Through the smoke, the Commander can clearly make out the profile of the woman hanging mid-air."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ange!!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, watch out!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Goodbye, Commander~!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While the Commander is distracted, Gray leaps straight into the smoke."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bangbangbang!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait, don't shoot! We don't want to hit Ange by mistake!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The signals are gone—they have escaped."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Rescuing Ange is more important. Let them be."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Wait a minute... Commander. "}]},{"spans":[{"text":"The drone isn't reading any heat source. "}]},{"spans":[{"text":"It's a puppet."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Hahahahahaha! This is absolutely hilarious! "}]},{"spans":[{"text":"You're so easy to bamboozle! Oh my, this has put me in such a good mood!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That sounds like—!!"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"side":"left","tags":{}}],"ops":[{"type":"background","value":"229","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"10144","raw":"BGM"}],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Hi, Commander. We meet again. ♪"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb saunters into the warehouse with a squad of Paradeus troopers from the passage behind them."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"The last time we met, it was under similar circumstances, wasn't it? "}]},{"spans":[{"text":"But this time, the tables have turned, Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Bramedb."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"It's my turn, dearie. "}]},{"spans":[{"text":"You're not leaving just like that. "}]},{"spans":[{"text":"I will not allow that to happen."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her eyes glow red, and the Paradeus troopers behind her all raise their weapons."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Let's have some fun together, Commander."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
