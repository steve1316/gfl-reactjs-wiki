ages":[{"spans":[{"text":"...Someone's cut the power supply."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Still looks normal from here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":5,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Wait a minute, the camera timestamp's been changed. Commander...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"!!!"}]},{"spans":[{"text":"Is it Paradeus? The rebels? Or—","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_SCARL2","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"10254","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot ricochets off the ground beside the Commander's feet."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander rolls aside and crouches low, staying silent. Their nerves are wound tightly and they have their gun in a death grip."}]},{"spans":[{"text":"The only thing here is darkness and endless silence."}]},{"spans":[{"text":"There is only the sound of their breathing."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The elevator power supply is back under control. ST AR-15 is leading a team to lock down the secure passage.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Commander, please verify your safety.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about Persica? Is she safe?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"WHERE IS PERSICA!?","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I don't see her on the cameras.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_Gunpast","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang—"}]},{"spans":[{"text":"Another bullet hits the ground by the Commander's feet."}]},{"spans":[{"text":"Did the opposition mess up?"}]},{"spans":[{"text":"No, it was a carefully calculated shot."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=5","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander follows their memories as they run toward the lab, their gun at the ready."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"night","raw":"Night"},{"type":"background","value":"2022saros_Workshop","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the lab."}]},{"spans":[{"text":"It is lit only by the touchscreen on the electronic door."}]},{"spans":[{"text":"The faint light reveals that the glass panel of the door is covered in cracks and the metal frame has been badly deformed."}]},{"spans":[{"text":"Behind it lies Contender, a piece of twisted metal stuck in her neck."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander places their hand to the touch panel."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"Verifying identity...","style":{"color":"#FFFF00"}}]},{"spans":[{"text":"Identity confirmed.","style":{"color":"#FFFF00"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The door slides open..."}]},{"spans":[{"text":"The Commander holds their breath—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_ElecSpace","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep—!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Right after that, as though in response to the Commander's hunch, a shrill alarm immediately begins making a racket while flashing red lights fill the lab."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The \"repair tank\" before them is wide open, revealing that it is empty."}]},{"spans":[{"text":"...\"It\" is missing."}]},{"spans":[{"text":"The Commander's face is grave."}]},{"spans":[{"text":"Has the base been infiltrated by intruders? Did someone sneak in without a trace? No, how did they know that \"it\" had been moved here by Statesec? And where's Persica?"}]},{"spans":[{"text":"No, those shots were meant to lure them to the lab!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=6","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Wham!"}]},{"spans":[{"text":"Upon sensing the breeze on their skin, the Commander reacts with lightning speed."}]},{"spans":[{"text":"—However, they are still too slow."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Urgh—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Something hits their hand hard as they're raising their pistol, and the gun goes flying away."}]}]},{"sprites":[],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.2%%duration=10%%","raw":"bg_move"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=10","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the next moment, a massive impact knocks them to the ground."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_SCARL1","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"...Stay still."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is a weight on their back, followed by the feeling of cold metal pressed against the back of their head. The Commander presses themselves to the ground and raises their arms without a word."}]},{"spans":[{"text":"...Who is it? "}]},{"spans":[{"text":"An answer slowly reveals itself within the Commander's heart."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...SCAR-L?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"}],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The other person doesn't say anything. "}]},{"spans":[{"text":"However, not answering is an answer of its own."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Looks like you're awake. "}]},{"spans":[{"text":"Statesec sent quite an interesting \"gift\"."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"So you are the commander here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The somewhat cold voice says this in a tone that does not permit any room for doubt."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...So nobody infiltrated us, and you caused all this by yourself?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"},{"type":"background","value":"2022saros_Workshop","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap—"}]},{"spans":[{"text":"The lights in the lab come back on."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Visibility restored. "}]},{"spans":[{"text":"Dandelion, our target is one Doll."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80","commsBox":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Her systems are different. I can't take care of it from here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"She's just an old model from nearly two decades ago! Disarm her already!"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"...I advise you not to act rashly."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander can't see the face of the Doll behind them, but the pressure on the back of their head intensifies."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We... are not the enemy. "}]},{"spans":[{"text":"World War Three is—"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Is already over."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That part was unexpected. If \"she\" knew that, then why did she attack them?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"You should not have tried to capture a Ranger."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...The subject of your loyalty no longer exists. All the governments were reshuffled during World War III."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"So?"}]},{"spans":[{"text":" Are you saying I should be loyal to you, then?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Your only way to survive lies in putting down your gun."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"OPS was a failure. Mission cancel code: CA0311."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The air seems to freeze over. Every second that passes is unbearable for everyone."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Upon seeing that the other person isn't moving, ST AR-15 slowly raises her gun."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Lower your gun, 15. "}]},{"spans":[{"text":"SCAR-L, we can talk."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If your aim is to anger me so I will write you off or scrap you by force, or to return you to Statesec..."}]},{"spans":[{"text":" Then I'm afraid you've got the wrong idea."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Even after being sealed away for over 10 years, you've maintained your clarity of mind, your intellect, and your ability to act swiftly."}]},{"spans":[{"text":"You've certainly proven that you're an elite Doll from WW3."}]},{"spans":[{"text":"In turn, I will prove that I am a commander who is worthy of your trust."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"I cannot pledge my loyalty to you."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And why is that?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"It is a base layer setting of mine. I only have one set of \"dog tags\"."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...If you're not willing, we won't force you to undergo any sort of modifications either."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"That is not a quality a commander ought to possess."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...But that's simply how I live in this world. "}]},{"spans":[{"text":"Every person and every Doll ought to have \"freedom\" of their own."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Freedom, you say?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander feels the pressure on their back ease off, enough for them to turn around and stand up."}]},{"spans":[{"text":"Now, they can get a good look at this \"legendary\" figure."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"I am Aliana, of Daybreak Squad."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Doll standing behind the Commander is tall, and she puts her gun away with fluid motions."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Though she radiates an oppressive aura like a blade, she extends a hand to the Commander with a warm smile on her face."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Timesync, Commander."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It is now 04:56PM, Berlin time."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Did you not see Persica when you woke up?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"If you're talking about that female researcher, she's in Warehouse B6 on the level below. She's unconscious for the moment."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_GriffinSPAWAR","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the Ops Room."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander picks up the mountain of paperwork on their desk and begins reading through it."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-80"}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"She's no ordinary Doll. She has many secrets around her."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've got no room to be picky."}]},{"spans":[{"text":"In order to fight this battle, I'll take every chance I can to increase our strength."}]},{"spans":[{"text":"I don't care about what she's holding back or what she chooses to declare as long as I can use her."}]},{"spans":[{"text":"They do say geniuses often act arrogant, Dandelion."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-80"}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Are you praising me, Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a temporary meeting room."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several Dolls are scattered around the otherwise-empty meeting room. Each of them has a different expression on their face."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"...Tsk!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And among them, the first to snort in disgust is Contender, who's seated in the middle."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"So nobody knows why the Commander called us here?"}]}]},{"sprites":[{"prefab":"M60","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"M60","narrator":false,"pages":[{"spans":[{"text":"...Are we going to be punished? "}]},{"spans":[{"text":"I mean, we DID mess up our job to protect Miss Persica..."}]}]},{"sprites":[{"prefab":"M26MASS","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,80"}}],"ops":[],"speaker":"M26-MASS","narrator":false,"pages":[{"spans":[{"text":"Maybe it's for an after-action report."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Contender thinks back to that encounter which lasted less than a second, and clenches her fists."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"...I was attacked from behind. It was my fault for not being alert enough."}]},{"spans":[{"text":"SCR!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Y-yes?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SCR is seated in the corner of the room and her body trembles as she is suddenly called out."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"Back then, you were the only one in the lab helping Miss Persica."}]},{"spans":[{"text":"Did you see what the intruder looked like?"}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SCR swallows, and she opens her mouth as though she is about to speak, but the words stick in her throat and won't come out."}]}]},{"sprites":[{"prefab":"M60","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"M60","narrator":false,"pages":[{"spans":[{"text":"Forget it, Contender. "}]},{"spans":[{"text":"SCR has practically zero combat experience, and she wouldn't have been chosen for guard duty if we weren't low on people."}]},{"spans":[{"text":"Don't expect too much from her."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Don't expect too much from her.\""}]},{"spans":[{"text":"SCR lowers her head in silence—the fact that she cannot refute that statement is the most frustrating thing for her at this moment."}]}]},{"sprites":[{"prefab":"M249SAW","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FF M249SAW","narrator":false,"pages":[{"spans":[{"text":"Save it, you two."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thump—"}]},{"spans":[{"text":"Con