."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click—"}]}]},{"sprites":[{"prefab":"M60","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"M60","narrator":false,"pages":[{"spans":[{"text":"Miss Helian!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone immediately stands at attention."}]},{"spans":[{"text":"Helian enters the room and claps her hands together."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Quiet."}]},{"spans":[{"text":"Considering the reconstruction progress of the base, the Commander believes that we can take on more missions now."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Miss Helian... Is Miss Persica alright? "}]},{"spans":[{"text":"I'm sorry, it's all because I messed up."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Don't worry, SCR. "}]},{"spans":[{"text":"The Commander won't be punishing anyone because of that."}]}]},{"sprites":[{"prefab":"Contender","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Contender","narrator":false,"pages":[{"spans":[{"text":"Say what?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Right now, we have a new operational team. "}]},{"spans":[{"text":"You are its members."}]}]},{"sprites":[{"