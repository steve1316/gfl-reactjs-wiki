[{"type":"bgm","value":"10213","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ashley has always prided herself on being perceptive, but she did not notice anyone approach."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You've actually kept the same assistant around for so long."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A slender arm wraps around her shoulders. From the corner of her eye, Ashley sees a beautiful face with exquisite features leaning in."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"She seems to be just an ordinary Nyto, so how did she manage to survive for so long by your side?"}]},{"spans":[{"text":"How curious. I would love to take her apart and have a look..."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Sister Hebe... If I have done anything to offend you by mistake, please forgive me..."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"Haha, I was just joking."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hebe lets go of her. Ashley feels weak in her legs."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"I have your report. You're excused for now."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Yes, Sister Nemhran."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ashley leaves the cultivation chamber, her heart still pounding in apprehension."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"It shouldn't have been time to check in yet. Why have you summoned me?"}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Read the report."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hebe flips through the report that Ashley has left behind and raises an eyebrow derisively."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"I see that the operation in Berlin went splendidly."}]},{"spans":[{"text":"Morridow was so efficient. Ruining plans, exposing her downlines, squandering our supplies—she did it all."}]},{"spans":[{"text":"She's even better at spending money than me."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"I'll deal with her later. We have a much more pressing matter."}]}]},{"sprite