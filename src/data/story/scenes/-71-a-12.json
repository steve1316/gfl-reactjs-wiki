}]},{"sprites":[{"prefab":"NPC-Hebe","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"Turn it down."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Assistant","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[],"ops":[],"speaker":"Assistant","narrator":false,"pages":[{"spans":[{"text":"Oh, while you were at St. Mary's Sanatorium earlier, a woman named \"Lady Whyte\" left you a message."}]},{"spans":[{"text":"You have not assigned her a tier, so I wasn't sure how to..."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"What's the message?"}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hebe, who has been resting with her eyes closed in the back seat, opens her eyes."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"No need, she's already got me one."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"