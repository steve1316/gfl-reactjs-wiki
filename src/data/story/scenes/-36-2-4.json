ion":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"99","raw":"BIN"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Tsk...play your petty tricks while you can."}]},{"spans":[{"text":"Main force, fall back to the flanks. That train has not been resupplied and it'll run out of ammo soon."}]},{"spans":[{"text":"Also, don't forget our objective... That base is the most important thing here."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Military Officer","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalina, can we reload for another round?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander, we've expended all our ammo."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Looks like it's time to squeeze the last bit of value out of this train..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander...?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion, order all Dolls to load all the ammunition they can carry into their personal gear, dump all the ammo they can't outside the train, then have them brace for impact."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Commander, there may be no going back if you do this."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well, there's a 100% chance we won't be going back if we DON'T do it. Hurry and give the order."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Commander, don't tell me you're going to...?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's right... Sorry, Kalina. I'm going to be selfish once again."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina gazes at the Commander and sighs. She buckles up her safety belt, then gives a determined nod."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"All Dolls are braced for impact."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion, you know what I have in mind."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"For a long time, I couldn't fathom why people had so much faith in you... Now, I think I understand."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You flatter me."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Held in place by its brakes, the train shudders from the vibration of its engine. Under Dandelion's control, the train's engine begins to overheat — steam spews from its head, and the entire carriage starts shaking violently."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then, with the sound of tearing metal as the brakes give out, sparks spray from the wheels, and the train roars as it lunges forward at the base. "}]},{"spans":[{"text":"The train, which should have been decelerating, picks up speed as it nears the quarantine wall. At this rate, it's going to derail at the mouth of the barrier gate, but..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"224","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amidst the vigorous shaking, the Commander barely manages to hang on to the railings, muttering as the train rocks harder and harder."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_brake","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Come, I'll show you just how hard crushing an insect can be. "}]},{"spans":[{"text":"As Sun Tzu once said, \"On desperate ground, fight!\""}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"225","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_stage7","raw":"BGM"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The speeding train jumps its tracks, skidding across the frozen soil before it hits the barrier gate."}]},{"spans":[{"text":"The train is well and truly stuck in the gate now..."}]},{"spans":[{"text":"It is a wordless display of the Commander's will and determination."}]}]}]}
