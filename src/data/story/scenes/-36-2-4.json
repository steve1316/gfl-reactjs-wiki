{"name":"-36-2-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"10051","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the Military staging area."}]}]},{"sprites":[{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Mobile Team Leader","narrator":false,"pages":[{"spans":[{"text":"Quartz to Terra, we've succeeded in breaching the quarantine wall. Proceeding with the mission. Over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Terra copies. Don't be careless. Over."}]}]},{"sprites":[{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Mobile Team Leader","narrator":false,"pages":[{"spans":[{"text":"Copy that. Quartz out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yegor ends the transmission."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"How goes the extermination of Griffin?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Officer","narrator":false,