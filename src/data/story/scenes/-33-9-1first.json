n":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crack. "}]},{"spans":[{"text":"What sounds like a branch being snapped breaks the silence and registers through Kord's auditory module."}]}]},{"sprites":[{"prefab":"Kord","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kord","narrator":false,"pages":[{"spans":[{"text":"Is this Sangvis Ferri or Paradeus?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The fog grows heavier. A blurry figure is coming towards her from within the haze."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Who...are you? "}]},{"spans":[{"text":"You are not my kind... Are you a foe?"}]}]},{"sprites":[{"prefab":"Kord","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kord","narrator":false,"pages":[{"spans":[{"text":"(That sounds like a girl. How odd, I can't see anything at all... Nor can I detect her signal.) "}]},{"spans":[{"text":"Please don't come any closer. Whoever you are, if you don't stop right there, I'm going to open fire."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"So you are...a foe? "}]},{"spans":[{"text":"Can you kill me? "}]},{"spans":[{"text":"Or would you rather I kill you?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The blurry figure is getting closer and closer. Kord aims at her legs and is about to squeeze the trigger, only to discover that her finger refuses to move."}]}]},{"sprites":[{"prefab":"Kord","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kord","narrator":false,"pages":[{"spans":[{"text":"...What is going on? "}]},{"spans":[{"text":"That voice..