ans":[{"text":"I know... I think I sensed some unknown signals just now."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Unknown signals? Like Paradeus?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I don't know, but now I can definitely feel them, and their numbers are increasing. "}]},{"spans":[{"text":"...They seem to be heading this way."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What?! Are the real enemies finally showing themselves?!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm not sure. RO, have you detected any life signs or mechanical signals in the vicinity?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...I'm only reading Griffin signals.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"However, it's become a bit foggy since a while ago, and the signal is pretty weak so I can't be absolutely sure. Do you want me to go and scout around?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That won't be necessary, just stick to the original plan for now. "}]},{"spans":[{"text":"... "}]},{