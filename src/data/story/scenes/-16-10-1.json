{"name":"-16-10-1","beats":[{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The breakthrough is in progress."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Are you really okay with letting her handle these enemies by herself?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Since Ange thinks it's fine, I have no problem with it. "}]},{"spans":[{"text":"Didn't you use to be on the same team? Shouldn't you know her better?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's why I'm worried about her... "}]},{"spans":[{"text":"You, on the other hand...are way too blasé about this."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"A T-Doll ought to act like a T-Doll. If I had to worry about everything, then why would we need humans? "}]},{"spans":[{"text":"Ah, she's back."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M4A1 walks over."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"All enemies exterminated. We can move on to the next objective."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Your performance after the repairs is pretty good. "}]},{"spans":[{"text":"But don't push yourself too hard. It would be a shame if you were to break again just after you got fixed."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"My body feels very light now...Both my aiming speed and mobility have improved tremendously...Your skills are amazing, AK-12."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm not one to get happy from praises. "}]},{"spans":[{"text":"I'm worried that your neural cloud hasn't fully adapted to the newly-installed components. "}]},{"spans":[{"text":"What are we going to do if overusing them leads to incompatibility issues, and your neural cloud breaks down? Not to mention, I heard you..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It only needs to last until I can personally destroy my target. That won't take long."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4A1, do you know the difference between riding a horse and a camel through the desert?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What is this, Chicken Soup for the Soul time?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Horses show signs of exhaustion as they move on, whereas camels will just keel over and strand people in the desert. "}]},{"spans":[{"text":"Whether or not this story is true, you know what I'm getting at, right?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'll inform you of any abnormalities in my neural cloud. "}]},{"spans":[{"text":"My turn, AR-15. Aren't you...going to tell me about it?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tell you about what?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"About how you're still alive, of course."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Now's not the time to reminisce about the past."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"M4, if you're concerned about the Parapluie virus in AR-15, that's not necessary for the time being."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"10","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Shut up, AK-12. If you say any more, I'll—"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"shake","raw":"震屏"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","value":"10","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...BOOM!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"spark","raw":"火花"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Nobody can hear each other speak for a few seconds after that."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Boom! Boom! "}]},{"spans":[{"text":"Dirt, trees and wreckage are all swept into the sky."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Coughs) "}]},{"spans":[{"text":"M4, are you alright?!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm fine, the cover's still intact!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"AR-15, do your surroundings explode when you get mad?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Stop pulling my leg! That was artillery fire from S.F.'s main forces! We've been spotted!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Judging from the signals, there's a super dangerous S.F. unit approaching. "}]},{"spans":[{"text":"We might not be able to handle her with our present numbers."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The enemy's vanguard is coming! Prepare to fight them off!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"AK-12, contact Ange immediately!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Eh? Shouldn't you try throwing yourself at the enemy first or whatever?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"They've got heavy weapons. How are we supposed to defeat them?!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Fine, fine. I've got to broadcast in clear. There's no alternative. "}]},{"spans":[{"text":"Ange, are you listening?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I'm here. You should have received your mission. Gather at point β."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"While this really isn't the best timing, uh... "}]},{"spans":[{"text":"Well...we kinda ran into some trouble."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Just get to the point! "}]},{"spans":[{"text":"Ange, we're pinned down by Sangvis' main forces and we need support!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Stop shouting into my ear! Don't you have a radio of your own?!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Pssst...pssst..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't expose yourselves for too long! Hang on until we can get there!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange, another thing—"}]}]},{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Psst...pssst..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ah, the transmission cut out. "}]},{"spans":[{"text":"I guess handling ECM is hard for AN94 after all... "}]},{"spans":[{"text":"Still, she and Ange should have our coordinates now. We just need to hunker down here and wait for them to rescue us!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sparkOff","raw":"关闭火花"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Roger! "}]},{"spans":[{"text":"M4, come with me to fight off the enemy! "}]},{"spans":[{"text":"Hold out until Ange gets here!"}]}]}]}
