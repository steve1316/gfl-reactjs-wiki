?"}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"Since we'll be meeting a creature that fell 400 feet from the sky and came away unscathed, I believe we should show her some basic courtesy."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I've never seen such an ostentatious secret agent."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"Like I said, this is considered basic."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"When will you move?"}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"An hour from now."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...You mean I only have an hour to search the mansion?"}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spa