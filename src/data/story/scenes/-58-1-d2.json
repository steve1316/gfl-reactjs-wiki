:"SE1"},{"type":"background","value":"240","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 gives a powerful shove, and the doors of the mansion swing open. "}]},{"spans":[{"text":"The double doors shudder and creak, shaking loose a thick layer of dust. They are so out of use that the hinges look as if they might fall right off the wall. "}]},{"spans":[{"text":"Ange holsters her pistol and slowly enters. "}]},{"spans":[{"text":"In the gloomy foyer, there is no sound other than the trio's echoing footsteps."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...12?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She's on."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Patch her through."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Channel established."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"When it comes to fishing, the most important thing to have is patience.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I hope your fish is worth it."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Agent Q","narrat