ny virus comes after you."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Leave it to me, 45!"}]}]}]}
