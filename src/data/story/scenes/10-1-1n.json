aker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"...Gager is a high-ranking command-type Sangvis Doll. Your observation skills aren't too bad. "}]},{"spans":[{"text":"But it'll take more than that to stand a chance against a Sangvis ringleader. "}]},{"spans":[{"text":"Time's up, I'll see you around."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Huh? What's the rush? "}]},{"spans":[{"text":"Hey... What about my plan...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"MP41 watches 98k's receding figure."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"...Hold on, she just said that the Commander had ordered all Dolls to withdraw, yet she's moving in S.F.'s direction. "}]},{"spans":[{"text":"Maybe...she's actually on the mission to destroy the ringleader...!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"MP41, I'm back. "}]},{"spans":[{"text":"Hmm? Isn't that Fräulein Kar?"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"As if I'd let you take all the credit!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"What are you talking about?"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"...There you are, G43. "}]},{"spans":[{"text":"That elite is trying to steal all our credit! "}]},{"spans":[{"text":"We've got to catch up right away!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"Huh? In that direction? "}]},{"spans":[{"text":"Aren't there Sangvis scouts nearby?"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"MP41 shakes her head."}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"How are we supposed to make a name for ourselves if this is enough to scare us?! If we run into any S.F., we'll just have to wipe them out!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"MP41, heading out!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"Huh?...W-wait for me!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
