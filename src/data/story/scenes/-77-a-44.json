ages":[{"spans":[{"text":"Is that so."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns to look at \"Dandelion\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Moments ago, she stood as the final obstacle between them and William. "}]},{"spans":[{"text":"Now, without any need for confirmation, they just know—she is an ally."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And more than that..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"25","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Is it you... Commander?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"898","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perhaps it's the sense of relief they feel now that the dust has settled. For a fleeting moment, the past and present seem to overlap on that familiar face."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's free hand brushes the corner of their grinning lips out of reflex."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.4","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This brings me back."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"},{"type":"sfx","value":"AVG_Lunasia_Born","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"902","raw":"BIN"},{"type":"whitescreen","raw":"白屏2"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And in that instant, the \"shadow of the past\" before them shifts."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her gear, her coat, and even her appearance flow like sand, changing dramatically in the blink of an eye into a form far more familiar—Dandelion."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Stunned, Commander? "}]},{"spans":[{"text":"Unfortunately, this form suits me better."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How... how did you..."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Her gear is made of nanomachines. Otherwise, what did you think those blue butterflies were? Lunasia's ghost?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The illusion of the overlapping figures shatters with her flippant tone. The Commander rubs their eyes as they're dragged back to reality."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How... "}]},{"spans":[{"text":"How did you... how did you do this? "}]},{"spans":[{"text":"Everything... everything that happened... it all unfolded exactly as M4 said. "}]},{"spans":[{"text":"Is this the power of Nirvana? ...And what exactly is the price she mentioned?"}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion inclines her head slightly but does not answer immediately. "}]},{"spans":[{"text":"The lightness fades from her expression, replaced by solemn gravity."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What?"}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Before I answer you... "}]},{"spans":[{"text":"I have three questions. If you can answer them... "}]},{"spans":[{"text":"I will tell you everything, as well as explain the price you'll have to pay."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Go ahead."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"First... "}]},{"spans":[{"text":"Is there only one \"goddess\"?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Second, is the \"goddess\" omniscient and omnipotent?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Third..."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"If a world was altered by the \"goddess\", did it ever truly exist?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander cannot answer a single one of the questions."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I see you now understand. "}]},{"spans":[{"text":"Then promise me one thing, Commander. "}]},{"spans":[{"text":"Never seek any knowledge regarding Nirvana. "}]},{"spans":[{"text":"Do not touch it. Do not ponder it. Do not attempt it."}]}]},{"sprites":[],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I promise."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Good. "}]},{"spans":[{"text":"Then..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion performs a perfect curtsy, then gestures toward the silent main control terminal."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Please embark on your next journey."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"890","raw":"BIN"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep! Beep! Beep!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A harsh incoming signal suddenly echoes through the lab, coming from the bloodstained terminal."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Keyboard_Correct","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pauses briefly, then steps forward and answers the call."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It's me."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"...Congratulations, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...I have fulfilled my promise, Mr. Mikhail. "}]},{"spans":[{"text":"Thank you for your assistance and support... From now on, Paradeus is no more."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"I know. In fact, I may have known even earlier than you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"That is why I decided to thank you personally, Commander. The Prometheans will not forget your contribution.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I don't need a reward."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I have already received one."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"Do not be so quick to dismiss it, Commander. Some among us may have disappointed you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But everyone makes mistakes. What matters is the future.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"We have discussed the matter. You need rest. Time to cool down.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We have prepared a vehicle with sufficient supplies. You may take it and leave this place.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Do not ever return.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If you have any other requests, we will do our best to accommodate them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...I do have one request. "}]},{"spans":[{"text":"Regarding my... subordinates."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The old man falls silent for a moment."}]}]},{"sprites":[],"ops":[],"speaker":"Elderly Voice","narrator":false,"pages":[{"spans":[{"text":"...There is no precedent for such a request.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But very well. I'll allow it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Thank you."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes a deep breath."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Goodbye."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
