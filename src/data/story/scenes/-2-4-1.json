{"name":"-2-4-1","beats":[{"sprites":[],"ops":[{"type":"sfx","value":"Alarm","raw":"SE2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Five minutes later, a Sangvis alarm starts blaring."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The alarm is sounding! She's upping her game!"}]}]},{"sprites":[{"prefab":"M16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Keep calm. It's gonna take a while for them to get here. "}]},{"spans":[{"text":"RO, can you give us an estimate on their numbers?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"It's gonna be more than just a handful...I reckon. "}]},{"spans":[{"text":"But judging by Gager's command efficiency, I doubt she'd be able to mobilize that many teams at once."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What do you mean? As in they're not gonna swarm us?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But there's another possibility..."}]}]},{"sprites":[{"prefab":"RO635","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"There may be more than one Ringleader in the area."}]}]},{"sprites":[{"prefab":"M16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"C'mon, two Ringleaders? "}]},{"spans":[{"text":"Please tell me it's just a random guess."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It IS just a guess, but we must not panic and start scrambling around. "}]},{"spans":[{"text":"Let's find a spot for a breakthrough before the S.F. forces have us surrounded."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What about M1887? We still haven't found her..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We haven't run into her yet, so she must be somewhere farther in. "}]},{"spans":[{"text":"All we can do is forge ahead and count on sheer dumb luck. "}]},{"spans":[{"text":"After all...our own safety comes first."}]}]},{"sprites":[{"prefab":"M16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I understand. Then lead us on, RO."}]}]}]}
