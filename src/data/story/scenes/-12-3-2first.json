ad 404."}]},{"spans":[{"text":"Did you like that appetizer? I'm sure it wasn't enough to show our sincerity as that was merely some nibbles."}]},{"spans":[{"text":"So why don't I personally offer you some hospitality with this brand new form of mine!"}]}]},{"sprites":[{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Although I'm guessing you can't recognize me, can you?"}]}]},{"sprites":[{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"You're...Destroyer, right?"}]}]},{"sprites":[{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What?! How did you figure that out?!"}]}]},{"sprites":[{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Destroyer? Hang on, wasn't Destroyer a midget?"}]}]},{"sprites":[{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Hey! How did you figure me out!? And who the hell's a midget!?"}]},{"spans":[{"text":"I was a big doggy earlier!"}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BossDestroyerPlus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Sho