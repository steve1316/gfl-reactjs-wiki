!!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, much to everyone's surprise, she tightens her grip on her sword, leaps over the Commander, and rushes straight toward the truck in the back."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"sfx","value":"AVG_lifttable","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shingggg! With another flash of the blade, the entire truck is sliced cleanly into two!"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"(Coughs) ...Grig?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thrown out by the massive impact, Morridow rolls a few times after hitting the ground. Then she can finally make out the approaching Nyto."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...Sister."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The blade hovers above Morridow's head. The white Nyto gazes coldly down at Morridow, ignoring the T-Dolls catching up from behind."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Those who fail have outlived their purpose. "}]},{"spans":[{"text":"You taught me that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dirt and smoke are still billowing in the air after the explosion..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...You're going to kill me?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,