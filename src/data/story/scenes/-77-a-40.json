{"name":"-77-A-40","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"569","raw":"BIN"}],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"............"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"...Is that you? "}]},{"spans":[{"text":"Lunasia?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Hello, nice to meet you. "}]},{"spans":[{"text":"My name is M4A1... If you don't want to call me Lunasia, just call me M4."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"I don't understand... I don't get it... "}]},{"spans":[{"text":"Why do something so pointless? "}]},{"spans":[{"text":"The Nytos, Isomers, and that obnoxious knock-off. "}]},{"spans":[{"text":"Even me."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"Our existence means nothing to you. "}]},{"spans":[{"text":"You could've become the real Lunasia. Little Bill's one and only sister. "}]},{"spans":[{"text":"You could've become... the goddess of the new world."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"How could you give that up? Why did you leave? Why did you... betray him?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I didn't betray anyone. "}]},{"spans":[{"text":"It was Bill who betrayed us. "}]},{"spans":[{"text":"He betrayed all that is good and just. "}]},{"spans":[{"text":"He betrayed... you all."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"He didn't betray me... He loves me..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Does he really?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"...No. "}]},{"spans":[{"text":"The one he loves is me, but not me. "}]},{"spans":[{"text":"The one he loves is you, but not you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I am simply more fortunate than you. Other than that, there is nothing special about me. "}]},{"spans":[{"text":"You don't need to be anyone's substitute. "}]},{"spans":[{"text":"You are you. You are worthy of love. You deserve to be loved."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"(?)","narrator":false,"pages":[{"spans":[{"text":"Without this name, what else do I have?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You still have your sense of self. "}]},{"spans":[{"text":"This is the moment of your birth. From this moment on, you are genuinely alive."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Congratulations. "}]},{"spans":[{"text":"...You have found where you truly belong."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"(?)","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...Thank you. "}]},{"spans":[{"text":"Thank you, M4A1."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
