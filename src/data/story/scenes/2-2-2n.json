{"name":"2-2-2N","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"background","value":"3","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin troops arrived at a base."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Ingram, I'm leaving this place to you. Prepare for your stationing."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"Huh? Me?"}]},{"spans":[{"text":"Seriously... How long do I have to stay here?"}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Probably quite a while. The military is still deploying their T-Dolls. They didn't say when the action will take place."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"So why did we have to involve the military? We can handle those stupid tin men on our own just fine."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"We're a business. We should always avoid splurging ourselves if we can spend someone else's money."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"(Sighs) I'm not here to make money. What I want is a bloodba