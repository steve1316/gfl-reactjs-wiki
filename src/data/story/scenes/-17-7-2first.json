ight"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Everyone, prepare to disengage. We've got no time to waste on her. "}]},{"spans":[{"text":"Everyone's top priority is to escort AK-12 to the repeater station. Anyone who can't make it, look for cover!"}]}]},{"sprites":[{"prefab":"AK12","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...You gave that order yourself."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"This is for everyone's sake. "}]},{"spans":[{"text":"Only you and AN-94 can hack the repeater station. We need to ensure your safety."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What an honor. Let's go."}]}]},{"sprites":[{"prefab":"BOSS-4","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE1"},{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Intruder","narrator":false,"pages":[{"spans":[{"text":"Leaving in the middle of the performance? I won't allow that. "}]},{"spans":[{"text":"Do you know what sort of script awaits you up ahead?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator"