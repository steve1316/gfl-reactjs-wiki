es":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Heart_Monitor1","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"background","value":"639","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The surgical procedure is over. Morridow's body feels light and hollow. She feels like a butterfly flapping its wings as it flutters towards the flowers, finally free from its cage."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow is practically dragged out of the operating room."}]},{"spans":[{"text":"Her head hangs feebly. Her face is obscured by her hair."}]},{"spans":[{"text":"Nobody sees her smile."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NytoIsomer","expression":12,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...If that is indeed what you want, I can give you what you desire."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow closes her eyes. M4, who is standing in the darkness, smiles compassionately at her."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A single butterfly flies out of three conjoined cocoons."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw"