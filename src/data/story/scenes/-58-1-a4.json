{"name":"-58-1-A4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=AVG_xiaxue%%","raw":"common_effect"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"11335","raw":"BGM"},{"type":"background","value":"161","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the schoolyard of Beslan High School No. 1."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sky is dark and oppressive. The snow on the ground mixes with dirt and gunpowder, casting everything in a gray and gloomy haze."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone is breathing heavily, demonstrating their allegiance through the direction in which they aim their weapons. "}]},{"spans":[{"text":"Eight members of the Guard Regiment have their guns of various models trained on Armin. Standing right next to him is Anna, and further away behind him is Martha and a little girl who looks no older than seven."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a heavy scowl, Armin glances at Anna and pushes her behind him. "}]},{"spans":[{"text":"The silence is soon broken."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Asshole, why are you pointing your guns at one of our own?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan, who has followed Anna and come around the corner, is dumbfounded by the scene that greets him."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He storms over to one of the Guard Regiment members and shoves the muzzle of his gun downward."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"What the hell is happening here?"}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"Ask him. "}]},{"spans":[{"text":"If he weren't your brother, we would've opened fire already. "}]},{"spans":[{"text":"Dunno if he's lost his mind or what."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan turns to look at his elder brother with a frown."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Bro?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin glares at Ramzan."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"They started it by pointing their guns at women and children."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan shifts his gaze to those standing behind Armin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fat drops of tears are falling from the little girl's face. She recoils further into Martha's arms as she meets Ramzan's eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"They're all f*cking pindosi! "}]},{"spans":[{"text":"Do the pindosi care to spare our women and children when they're slaughtering our compatriots on the frontlines?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin's eyes are filled with disdain."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"Then how are you any different from them?"}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"You fuc—","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Guard Regiment member swears and makes to charge forward."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan spreads his arms and plants himself firmly in the way."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Bro. "}]},{"spans":[{"text":"American bitches spawn American brats who will then grow into American soldiers. "}]},{"spans":[{"text":"Our asses are planted on different chairs. "}]},{"spans":[{"text":"It's called having different positions."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin chuckles."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"...Remind me, which country is Boris' mother from? And is Maria not a brilliant commander on the frontlines?"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"That's different... They're on our side..."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"Is that so? "}]},{"spans":[{"text":"Is that really your reason?"}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"Enough with this crap! Brothers, attack! For the Motherland!"}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"For the Motherland... "}]},{"spans":[{"text":"This shouldn't be an excuse to justify losing our reason and our ability to make moral decisions!"}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"...Weapons are meant to be pointed at enemies, not women and children. "}]},{"spans":[{"text":"There's nothing brave about what you're doing right now... "}]},{"spans":[{"text":"It's nothing more than criminal behavior."}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member B","narrator":false,"pages":[{"spans":[{"text":"Ramzan, there's no talking any sense into him! "}]},{"spans":[{"text":"Just drag him away! We'll let this slide!"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan looks at the Guard Regiment members, then at Armin. "}]},{"spans":[{"text":"Uncertainty fills his eyes."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"They're just a bunch of bullies terrorizing the weak! \"Protect the Motherland\" my ass! "}]},{"spans":[{"text":"Our old man thought you joined the Guard Regiment to keep our city safe. Who would've thought you'd also be pointing a gun at defenseless kids?!"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin drags Anna forward from behind him and gives her a rough shove. She stumbles into Ramzan's arms."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"Take Anna and haul your ass back home!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":33,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan catches Anna and grabs her firmly by the shoulders. He gazes at Armin with a conflicted look on his face."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"What about you?"}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"...The old man taught me to be a proper man."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There comes a click. The sound of a round being chambered."}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"Armin, I am willing to give everything for our Motherland."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! "}]},{"spans":[{"text":"A shot lands right by Armin's foot."}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"Think about your position very carefully. This is your final warning."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_2022Saros_Gunpast","raw":"SE1"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! Just as the Guard Regiment member finishes his sentence, a bloody cut appears on his cheek. "}]},{"spans":[{"text":"A bullet has grazed him. "}]},{"spans":[{"text":"He looks toward the source of the bullet."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10345","raw":"BGM"}],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"Ramzan?! Have you also lost your marbles?!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Screw your position. That's my brother. "}]},{"spans":[{"text":"My position is to never raise a hand against family!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan walks away from the Guard Regiment members and stops right in front of his brother. Then he turns around and points his own gun at his former comrades. "}]},{"spans":[{"text":"Armin looks at Ramzan with mixed feelings."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"...Ramzan, you..."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"That whole spiel you just gave makes zero sense. "}]},{"spans":[{"text":"Why would you take the old man's drunken rants so seriously? Nothing should matter more than staying alive. "}]},{"spans":[{"text":"But... "}]},{"spans":[{"text":"Sheesh, can't be helped. You're my big brother, after all!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin sighs, but the corner of his mouth tilts upward."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"Fine. Although you always drive me up the wall... "}]},{"spans":[{"text":"It can't be helped. You're my little brother, after all."}]}]},{"sprites":[],"ops":[],"speaker":"Guard Regiment Member","narrator":false,"pages":[{"spans":[{"text":"You leave me with no..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before he can finish, an unknown object is lobbed at the Guard Regiment member from behind Armin."}]}]},{"sprites":[],"ops":[{"type":"background","value":"183","raw":"BIN"},{"type":"sfx","value":"AVG_The_Division_Flash_Bomb_Explosion","raw":"SE1"},{"type":"sfx","value":"AVG_Rifle","raw":"SE1"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! "}]},{"spans":[{"text":"The MP-443 fires a shot, and the scene is instantly engulfed in smoke."}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"(Coughs)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dazzled by the powerful flash, everyone present is forced to close their eyes."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"161","raw":"BIN"},{"type":"effect","value":"%%code=AVG_xiaxue%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan's arm shoots out and grabs Anna by the collar."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"(Wheezes) "}]},{"spans":[{"text":"Don't go running off. Follow me and Armin..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":37,"side":"left","tags":{"Position":"0,-50"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"It's that woman... "}]},{"spans":[{"text":"She played the same trick again!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Armin is just about to say something when a wriggling child is suddenly thrust into his arms."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":4,"side":"left","tags":{"Position":"0,210"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Frightened Child","narrator":false,"pages":[{"spans":[{"text":"(Coughs) Ma... Mama..."}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Martha","narrator":false,"pages":[{"spans":[{"text":"Your heart is in the right place, but you're really thick in the head. "}]},{"spans":[{"text":"There's no point wasting your breath on them! "}]},{"spans":[{"text":"Now run! We're splitting up!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_flag","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna keeps struggling with her eyes still squeezed shut, unable to free herself from Ramzan."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":34,"side":"left","tags":{"Position":"0,-50"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"(Wheezes) M-my gun... "}]},{"spans":[{"text":"Give it back!"}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Martha","narrator":false,"pages":[{"spans":[{"text":"Tsk."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pistol is shoved into Anna's hand."}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Martha","narrator":false,"pages":[{"spans":[{"text":"Now go. Head left. That's the quickest way to the school entrance."}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"What about you?"}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Martha","narrator":false,"pages":[{"spans":[{"text":"Pfft, they're just a bunch of brats still wet behind their ears. "}]},{"spans":[{"text":"I can deal with them perfectly fine."}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Pamzan","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"...Who exactly are you?"}]}]},{"sprites":[{"prefab":"NPC-Laplace","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Martha","narrator":false,"pages":[{"spans":[{"text":"...A very unfortunate physics teacher."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=AVG_xiaxue%%","raw":"common_effect"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"650","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_brake","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna and the others flee the school in a flustered state. When they reach the street outside the school gates, the tardy police finally arrives at the school entrance in their yellow police vehicle."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10056","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":"Beslan Police","narrator":false,"pages":[{"spans":[{"text":"You lot!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The heavily-armed police officers scramble out of the vehicle and promptly have the group surrounded. "}]},{"spans":[{"text":"One of them straightens his hat. Then he summons a teammate, makes a few gestures, and the bulk of the force storms through the school gates."}]}]},{"sprites":[{"prefab":"NPC-Ahmin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Armin","narrator":false,"pages":[{"spans":[{"text":"...This will take a lot of explaining."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The little girl in his arms suddenly burst into tears."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":4,"side":"left","tags":{"Position":"0,210"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Little Girl","narrator":false,"pages":[{"spans":[{"text":"My mama... They're gonna kill my mama..."}]}]},{"sprites":[],"ops":[],"speaker":"Beslan Police","narrator":false,"pages":[{"spans":[{"text":"We received a call about an alleged terrorist attack? "}]},{"spans":[{"text":"And a mutiny within the Guard Regiment? "}]},{"spans":[{"text":"What is going on here...? How many people are involved?"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"...It's Operation \"Eternal Flame\". "}]},{"spans":[{"text":"It involves some members of the Guard Regiment, a few students, and the police."}]}]},{"sprites":[],"ops":[],"speaker":"Beslan Police","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"You'll have to do the counting yourselves. "}]},{"spans":[{"text":"Bro, let's go."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":1,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_stage10","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan looks to his side and finds only Anna holding the child."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Where's Armin?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":37,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=5","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna pushes the little girl onto Ramzan and runs back towards the schoolyard without a word."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"...блядь!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He lets out a sigh of resignation."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After some thought, he puts down the little girl."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"You stay right here and wait, you hear me? Don't wander off!!"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":1,"side":"left","tags":{"Position":"0,210"}}],"ops":[],"speaker":"Little Girl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I'll be watching you, okay? Don't move a muscle!"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":4,"side":"left","tags":{"Position":"0,210"}}],"ops":[],"speaker":"Little Girl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan warns the girl as he backtracks quickly."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I'm still watching! Stay where you are!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl watches as Ramzan slowly recedes into the distance. Tears well up in her eyes, but she does as she is told and remains utterly still."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reassured by her obedience, Ramzan turns around and sprints after Anna. "}]},{"spans":[{"text":"Sometimes he can't help but wonder why two brothers born from the same parents can be so drastically different."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
