"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Dye...? (Turns around) Humans, is there any dye around here?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"人类女性","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"There...there's some camouflage face paint..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"You heard that, Commander. But what good is it going to do?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The commander proposes a plan."}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-Sanatorium","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"416, any ideas yet? The military is going to catch up soon! What do we do?! We can't just conjure an Ange out of thin air!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"RO... "}]},{"spans":[{"text":"Why can't we?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"416? What did the commander tell you? What should we do?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"One thing I learned from 404 - no risk, no reward. I'll do anything to complete a mission. "}]},{"spans":[{"text":"Now, let's play a game."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Meanwhile, Ange contacts the commander."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Commander, I... "}]},{"spans":[{"text":"I'm sorry. I can't think of anything... "}]},{"spans":[{"text":"Yegor is only after me. If I walk outside, it'll definitely get their attention, especially when they already know something's off."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Don't give up just yet, Ange. Their scouts are not making a move yet."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"But this time I'm really out of ideas... This is all because of me. I honestly don't know how to keep everyone alive... "}]},{"spans":[{"text":"Commander, you've done your best, and I have nothing else to say. I think it's time..."}]}]},{"sprites":[{"prefab":"指挥官","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ange... "}],"choices":["I'm here to save you. Are you trying to sabotage my mission?","Think about Task Force DEFY. Are you giving up on them?","Waving your white flag already? There's still time to think!"]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We've all experienced failure. Most of the time, it's not due to our own fault that we fail. You've done very well. It's me..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"They can make it out. Yegor won't treat T-Dolls as prey. I..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You can't grapple with the military indefinitely. I think it's time to put an end to this. Let me..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What the hell are you saying, Ange? "}]},{"spans":[{"text":"If you give up, what are we going to do?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The commander will take care of you. You will have better opportunities to put your skills to good use."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"But you are our charge. If we fail to protect you, then we..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I know you'll be devastated, but you can just have your neural clouds wiped—"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Like what you did to the AR Team? You want to delete SOP-II's memories again? "}]},{"spans":[{"text":"How many more times do you want to die just to make us all forget you?!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We're out of time. Get out of here. "}]},{"spans":[{"text":"Take all the combat records and the HOCs back with you... Avenge me..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...What? Commander? What...did you say...? "}]},{"spans":[{"text":"...There is a way?"}]}]}]}
