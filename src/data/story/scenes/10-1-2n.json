ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Enough of that. "}]},{"spans":[{"text":"...Think of something else to call me first."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"You don't like it? Fine... Let me think..."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Just call me Kar."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Just Kar? That doesn't sound very polite... "}]},{"spans":[{"text":"I'll call you Fräulein Kar!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"...Alright. "}]},{"spans":[{"text":"Why have you followed me here?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Because you're obviously after the Sangvis ringleader? "}]},{"spans":[{"text":"Bring me along, Fräulein Kar! I'll definitely make myself useful!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"...B-besides, if you're trying to fish for credit just because you took a stroll out here... "}]},{"spans":[{"text":"I'll have to expose you for the future of Griffin. "}]},{"spans":[{"text":"However...if you're really as capable as you claim to be, then I'd very much like to witness it with my own eyes! "}]},{"spans":[{"text":"I'll even vouch for you later on so no one would ever doubt you!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"In a certain sense, you've made quite an interesting point. "}]},{"spans":[{"text":"I am, in fact, on a mission and this is one of my hideouts for monitoring Sangvis movements."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"It does make for a fantastic surveillance spot... "}]},{"spans":[{"text":"B-but I haven't seen any Sangvis activity nearby at all?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"As you said yourself, S.F. only deployed a single ringleader, who's most certainly doing everything she can to remain undetected. "}]},{"spans":[{"text":"Stay here and be my spotter while I head to my sniping position and bide my time. "}]},{"spans":[{"text":"Don't worry, it isn't very far from here."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Huh? No way, I want to go with you."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"An extra pair of eyes means a better chance of spotting the enemy. You can take a lot of credit if you discover Gager. "}]},{"spans":[{"text":"But if you miss her...there will nothing in it for either of us. "}]},{"spans":[{"text":"I take it that you're the kind of Doll who seizes every victory?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"You strike me as someone who never lets a single chance of victory slip by and will do anything to succeed."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Oh, of course! I'm exactly that kind of Doll! "}]},{"spans":[{"text":"Trust me, Fräulein Kar, I'll certainly help you destroy that Sangvis ringleader, and you'd better remember that!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Sure, I will. "}]},{"spans":[{"text":"Now listen carefully. If the Sangvis ringleader doesn't show herself by dawn, then we're out of luck. "}]},{"spans":[{"text":"In that case, you must go back to the base and withdraw like a good girl."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"What about you, Fräulein Kar?"}]}]},{"sprites":[{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"I'll withdraw on my own. "}]},{"spans":[{"text":"Surely you can find your way back without me, right?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Of...of course! I'll be fine even on my own!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"But you'd better not tweak the combat report while I'm not with you! "}]},{"spans":[{"text":"Huh? Where did she go?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"By the time MP41 realizes she's alone, Kar98k had already disappeared into the darkness..."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"}],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"...Fine. Just you wait, Fräulein Kar. "}]},{"spans":[{"text":"I will definitely find that Gager. "}]},{"spans":[{"text":"Then all the Dolls at the base and even the Commander will shower me with praise! "}]},{"spans":[{"text":"But before that, I'd better clean up this surveillance hideout a bit. "}]},{"spans":[{"text":"I think I'm gonna move this shrub out of my face... Whoa!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment MP41 pushes the shrub away, she finds G43's face looming right over her."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"Oh, MP41! So you're alive."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"What are you talking about?!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"I thought you got captured by Sangvis Ferri. I was just thinking... "}]},{"spans":[{"text":"That if I still couldn't find you after making another round, I'd return to the base on my own."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Sigh, low-spec Dolls really can't be trusted... "}]},{"spans":[{"text":"I found Fräulein Kar just now and she asked me to stay here as her spotter!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"I see... Well, I apologize as a low-spec Doll. "}]},{"spans":[{"text":"In that case, I'm heading back and leaving you with your \"Fräulein Kar\"."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"True... With Fräulein Kar..."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"(Thank goodness!) "}]},{"spans":[{"text":"Alright then, off I go. Good luck with your mission. Have fun. Tschüss—"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Wait! "}]},{"spans":[{"text":"Actually, a spotter could also use some protection! "}]},{"spans":[{"text":"We've still got a deal!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"No way... "}]},{"spans":[{"text":"(Sobs) I'm sorry, Commander. "}]},{"spans":[{"text":"I'll never touch things just because they look interesting again..."}]}]}]}
