{"name":"10-1-2N","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"1","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...End of operation."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"I knew it. Of course we'd run right into S.F. since we charged in so carelessly..."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"We killed them all so no big deal!"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"I killed 90% of them, okay..."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Shush... Keep quiet and stay here."}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"Hmm? What is it?"}]}]},{"sprites":[{"prefab":"g43","expression":0,"side":"left","tags":{}},{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"MP41 creeps toward a bush."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Found you! "}]},{"s