{"name":"-18-2-4-Point6188","beats":[{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Even with that stirring pep talk, we alone won't be able to stop the Military's main forces."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's true... We don't stand a chance until we get the airdropped package."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So by sending out M4, you're hoping the Sangvis Mastermind will take the bait?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Something like that. After all, we need to prepare a backup plan, but I'm personally more for settling things myself."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So what should we do next? We don't have any weapons on hand that can counter armored units."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Now that things have gotten this far, it looks like we'll have to owe the Griffin Commander a favor."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Ah, Griffin Commander? Do you copy?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Ah! It's that whatsherface who saved you from before!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I have nothing but the utmost respect for your courage in staying behind, Commander, and I believe you understand the situation that Griffin is in. "}]},{"spans":[{"text":"The AR Team and I are doing everything we can to prevent the worst from coming to pass, but the Military's armored units are already headed towards them."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Eh?! Not Sangvis Ferri, but the Military?!"}]}]},{"sprites":[{"prefab":