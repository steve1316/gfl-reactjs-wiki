eone who needs it more. Let me think...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Keyboard_Input","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J takes a photo and sends it to Nele."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Just use disposable gloves! You're used to wearing them anyway!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"See? Perfectly clean.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The photo shows J's hand wearing a medical latex glove."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"You're a doctor. Bloody hands are normal.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If you don't like the mess, just wear gloves.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Hello? Nele?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Good. I'll contact you later.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J hangs up."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Will gloves... really solve the issue?","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC-People_Female","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"E-excuse me..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A timid voice interrupts Nele's musings again. "}]},{"spans":[{"text":"It is a dusty-faced woman, clutching a sleeping child."}]}]},{"sprites":[{"prefab":"NPC-People_Female","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I see you're wearing a white coat... Are you a doctor?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"NPC-People_Female","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"My child's had a fever for days. I meant to take her to the hospital today, but then this happened... "}]},{"spans":[{"text":"Now she's burning up and won't wake up. I'm worried sick... Please, could you please look at her...?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele's eyes fall on the little one's flushed round face. The child's breathing is erratic, and her limbs are spasming slightly. She is clearly in critical condition."}]}]},{"sprites":[{"prefab":"NPC-People_Female","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Hello?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele's hands feel like they'd been branded with a hot iron. The crimson stain is searing hot. Painful. Impossible to ignore. "}]},{"spans":[{"text":"She can clearly hear all the voices screaming from the depths of her memories. "}]},{"spans":[{"text":"The struggle. The hesitation. The pain. The rage..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But she lifts her head and gives her answer—"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Yes. My hands are a bit dirty. Could you take a pair of medical gloves from my pocket for me?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
