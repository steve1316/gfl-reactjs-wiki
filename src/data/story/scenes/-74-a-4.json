{"name":"-74-A-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_stage13","raw":"BGM"},{"type":"sfx","value":"AVG_Strike_Loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Rumble! "}]},{"spans":[{"text":"A sound utterly foreign to everyday life shatters the air—endless crashing, and it's impossible to tell if it's near or far. "}]},{"spans":[{"text":"On both sides of the street, faces twisted in terror let out shrill, inhuman screams, like rats trapped in a cage, scattering in panic. "}]},{"spans":[{"text":"Nele feels as if the world itself is rapidly falling apart."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_People_Panic","raw":"SE1"}],"speaker":"Pedestrian","narrator":false,"pages":[{"spans":[{"text":"AAAAAAAAHHHH!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Pedestrian","narrator":false,"pages":[{"spans":[{"text":"Help! We're getting bombed!!!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A haze of unreality clouds her mind as she stands dazed at the curb, jostled again and again by the stampeding crowd. "}]},{"spans":[{"text":"She had stepped out of that desolate, abandoned castle only hours ago."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beside her, Amaris clutches her arm so tightly it almost hurts."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"There's no time to make it to the underground shelters! We have to hide somewhere! Being out in the open is too dangerous!"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Right!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Strike_Single","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! Boom! "}]},{"spans":[{"text":"The explosions show no sign of stopping. Amaris shoves through the panicked masses, heading straight for a shop by the roadside—"}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Get inside! Now!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The world sways violently. If not for Amaris' grip, Nele would have been knocked off her feet by the soundwave rushing in from every direction. "}]},{"spans":[{"text":"They stumble through a doorway, while flashes of terrified, contorted faces sweep past her vision."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris shoves Nele under a heavy, solid wooden table."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Stay in here! Protect your head!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Following her orders, Nele curls up under the table, hands shielding the part of her that holds her soul and memories."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She breathes deeply and shuts her eyes..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Distance","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It feels like a century has passed before the crashing dies down, and Nele's heartbeat begins to steady."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2024AB_Ware","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She crawls out from under the table and sees Amaris standing guard close by."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"The bombing... stopped?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"For now."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Why was there suddenly a bombing...?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"According to the latest intel from the Commander, Frankfurt and Moscow were both hit by surprise attacks from the Neo-Soviet rebels. "}]},{"spans":[{"text":"Nele... war has come."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"War—a word that feels distant. "}]},{"spans":[{"text":"But now that she thinks about it, she realizes it has never truly been far away."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Glancing around, Nele notices they've entered a bakery. It's small, and it's now packed with people crowding around the bread display to take shelter. "}]},{"spans":[{"text":"The shop is in ruins. Soft, clean loaves lie crushed across the floor, and the front window facing the street is filled with unsettling cracks. "}]},{"spans":[{"text":"Low sobs drift through the air; some people are trying to establish contact with the outside, while others converse with each other in hushed tones."}]}]},{"sprites":[],"ops":[],"speaker":"Passer-By A","narrator":false,"pages":[{"spans":[{"text":"...What's going on? Who's behind this?"}]}]},{"sprites":[],"ops":[],"speaker":"Passer-By B","narrator":false,"pages":[{"spans":[{"text":"No idea. Signal reception is terrible. I can't even get online."}]}]},{"sprites":[],"ops":[],"speaker":"Passer-By C","narrator":false,"pages":[{"spans":[{"text":"(Sobs) I want to go home..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fenced in by the crush of people, Nele is pressed right up against Amaris."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She glances at the almost non-existent signal bar on her communicator and sighs. There's no hope of getting a connection."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,