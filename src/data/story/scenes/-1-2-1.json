 off the ride now?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"We're still working on the location of the jammer. Do you plan to standby?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well..."}]},{"spans":[{"text":"We are currently near the back of the Area S06 outpost. If we land now, we'll be in a good position for a sneak attack."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"You plan on capturing the Ringleader in the outpost to directly get the location of the jammer?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Yes. We don't have a lot of time, so it's better for us to take the initiative."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Very well. According to our report, the Ringleader stationed at the outpost is Hunter."}]},{"spans":[{"text":"She has gone through an \"Elite\" modification. Be careful."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Understood. Are we clear on the objective, everyone?"}]}]},{"s