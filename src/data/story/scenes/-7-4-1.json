{"name":"-7-4-1","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"},{"type":"background","value":"CG4N","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"?? minutes later. "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Ouroboros..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Ah...that's the face... "}]},{"spans":[{"text":"You do know you won't be the next to die, right...? "}]},{"spans":[{"text":"You're gonna be the last."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You mean... "}]},{"spans":[{"text":"You know where I am?"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Oh... "}]},{"spans":[{"text":"Now I remember. That's something even you yourself don't know."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Are you the ones...who are holding me captive here?"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Holding you captive? "}]},{"spans":[{"text":"Hahahahahaha! "}]},{"spans":[{"text":"Poor dear, looks like you're completely clueless!"}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"You have no idea what kind of sacrifices your friends have made for you..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"What...what do you mean?!"}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"They put all their hopes of survival on an unconscious M4A1 at the very last moment..."}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"They shoved you into a control room with a camouflaged signal then faced me valiantly... "}]},{"spans":[{"text":"And you know how that ended for them, of course..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"(No...that can't be true...)"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Do you miss them? M16A1 and M4 SOPMODII? "}]},{"spans":[{"text":"I can recover the video recording of their final moments for you... "}]},{"spans":[{"text":"The moment they charged to their deaths...and the dismal state they were in afterward... "}]},{"spans":[{"text":"HAHAHAHAHAHAHAHAHA!"}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4! Are you okay?! "}]},{"spans":[{"text":"Your functional parameters..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I...I'm fine... "}]},{"spans":[{"text":"Just a little...disturbed... "}]},{"spans":[{"text":"Don't worry. Until I help you escape, I won't..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Hahahahaha! Why must you help them escape, M4A1? "}]},{"spans":[{"text":"They're the ones keeping you there!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, M4A1. We do know... "}]},{"spans":[{"text":"The passcode to the door of your control room... "}]},{"spans":[{"text":"And we're the only ones who know..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"(Sighs) You really picked a splendid time to tell me..."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4A1, that's because..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Alright, ladies, that's enough revelations for the plot. "}]},{"spans":[{"text":"Now...it's time to decide which ending we're heading towards."}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"M4A1, you initially had the chance to escape the battlefield on your own. "}]},{"spans":[{"text":"Unfortunately, you wasted your precious time on these scraps of junk, so you've already lost your opportunity. "}]},{"spans":[{"text":"Tell me, do you hate them? Do you regret helping them?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Why would I hate them? "}]},{"spans":[{"text":"Isn't it a commander's duty to fight till their last breath for victory? "}]},{"spans":[{"text":"I can finally serve with pride and honor...just like the Commander..."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4A1..."}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Humph...a slightly unexpected answer, but still a reasonable one. "}]},{"spans":[{"text":"You're much more spineless than I thought. Then are you prepared to be yanked out along with your useless friends? "}]},{"spans":[{"text":"After all, your numbers are pretty much depleted. Killing the rest is just a matter of time..."}]}]},{"sprites":[{"prefab":"？？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Which means we can do it as long as we have time, right? "}]},{"spans":[{"text":"Guys, attack!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"街道","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_War","raw":"BGM"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"An ambush! How is this possible?! "}]},{"spans":[{"text":"You! How..."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"Vikhr!"}]}]},{"sprites":[{"prefab":"SR3MP","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"SR-3MP","narrator":false,"pages":[{"spans":[{"text":"Heheh, don't underestimate the resilience of an elite T-Doll. "}]},{"spans":[{"text":"It took quite some time to get out of that pinch, but I did find a lot of friends who survived as well! "}]},{"spans":[{"text":"M4A1, didn't think you'd last this long. Did we make it?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You're right on time. Welcome back. "}]},{"spans":[{"text":"Now the tables can be turned!"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Impossible! Don't forget your objective! "}]},{"spans":[{"text":"I'll destroy you all right here! Not a single one of you will make it out!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Right... Of course you'd do that. "}]},{"spans":[{"text":"But...only if you can find us."}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"M99, Vikhr, this is our last chance. "}]},{"spans":[{"text":"We must...get out of here!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Here's a reminder: all the Sangvis Dolls you have encountered so far...were dummies that I set up. "}]},{"spans":[{"text":"They have neither sentience nor consciousness, and naturally...require no complex reconstruction. "}]},{"spans":[{"text":"So come, be my guest...and torment these pitiful creatures to your heart's content!"}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4A1, Ouroboros has reanimated the dummies of Hunter, Executioner and Architect. "}]},{"spans":[{"text":"Their stats may not be higher than their previous versions, but that doesn't make them any less dangerous. Please take care."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Understood. I have started formulating an infiltration plan."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"By the way, M4A1, this is the passcode to the door of the control room. "}]},{"spans":[{"text":"Actually...we didn't tell you before because M16A1 asked us not to... "}]},{"spans":[{"text":"She thought this control room was your only protection. "}]},{"spans":[{"text":"She was afraid that you'd be in danger if you left."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yeah...that's just like her... "}]},{"spans":[{"text":"That's what she's always been doing... "}]},{"spans":[{"text":"She was trying to substitute herself with the control room...to protect me..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But she forgot...that no one could ever replace her... "}]},{"spans":[{"text":"And some day, I'll have to survive on my own..."}]}]}]}
