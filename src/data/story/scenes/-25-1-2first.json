{"name":"-25-1-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"159","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...End of operation. The fireteam eliminated the unknown enemies that invaded the base. "}]},{"spans":[{"text":"...While the Fairies are patching up the opening, 416 studies the remains on the floor with a deep frown."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...White enemies. Certainly never seen them before."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"See? Who knows where they're from."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...But this is beyond strange. Even I have no clue."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Ha, how arrogant. "}]},{"spans":[{"text":"But I've got to admit you did pretty well just now."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"So do you trust me now?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Sorry about that. You really are an elite T-Doll. "}]},{"spans":[{"text":"Looking at your baby face, I honestly thought you were just a random decorative Doll cleaned out from some warehouse to bolster our numbers."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I wish I were just some decoration. Wouldn't have to do everything myself. "}]},{"spans":[{"text":"Still, those enemies were much weaker than I expected. Were they the main force?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Don't be ridiculous, these are just a nuisance, the ones that attacked us before were on a completely different level. "}]},{"spans":[{"text":"The real ones...are unkillable."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Unkillable?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Literally, you are not gonna like facing them, enough about that, we've got to move."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Wait, so why did they send these low-level units here?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Does that matter? So they sent some cannon fodder this way. That's no big deal, right?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"We're facing enemies even more unfathomable than the Military. With this level of technology, they won't make reckless moves. "}]},{"spans":[{"text":"I don't recommend setting off right away. We should wait till the base is completely restored—"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Huh? Are you joking? "}]},{"spans":[{"text":"That'd be too late! 9A-91 is still waiting for us!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Even so, we can't risk it. The enemy was only testing the water, the real attack will follow!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Every step we take now is a risk! "}]},{"spans":[{"text":"Listen, 416, time is our most limited resource. My friends are still taking bullets for us on the frontline out there, I can't just leave them for dead!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Don't let your feelings get the better of you! You're a Tactical Doll, so obey your orders!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Oh, sure! I'll listen to orders, let the Commander give the order! Order me to stay here!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"74U, you...go ballistic at the mention of your friends. Are all T-Dolls at Griffin as undisciplined as you?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"I'm not you. I wouldn't leave behind my friends and go on a suicide mission alone."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...Do you have any idea what you're talking about?"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"You don't even have friends, do you? "}]},{"spans":[{"text":"I know who you are, Squad 404."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"So what? "}]},{"spans":[{"text":"You don't actually know me, Griffin trash."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"sfx","value":"Rope","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"...74U grabs 416 by the collar."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"I'm not trash! Do you know wh—"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Watch out!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...416 pushes AK-74U away. "}]},{"spans":[{"text":"...Bang bang! The spot where they used to be is showered by bullets."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"...! 416!"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I'm fine! Just a scrape! "}]},{"spans":[{"text":"Protect the Fairies! We're falling back to the construction site!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...New enemy troops come pouring in from the opening, 416 struggles to hold them back."}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"It-it's them! The main force! "}]},{"spans":[{"text":"Just like last time, our bullets have no effect!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"At least slow them down! "}]},{"spans":[{"text":"Where's the rest of our group?! Bring up anyone that can still move!"}]}]},{"sprites":[{"prefab":"AK74U","expression":0,"side":"left","tags":{}},{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"AK-74U","narrator":false,"pages":[{"spans":[{"text":"Got it! "}]},{"spans":[{"text":"And 416, about what happened just now—"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"This isn't the time! Do your job! Move it already!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Sheesh. Griffin is always...full of idiots dragging me down."}]}]}]}
