{"name":"-74-A-36","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"816","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Well then, Commander? "}]},{"spans":[{"text":"Are you going to kill Miss Nele?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... I refuse."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Why? "}]},{"spans":[{"text":"Do you doubt her ability?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Not at all. "}]},{"spans":[{"text":"I understand perfectly what you mean. "}]},{"spans":[{"text":"I do believe that... in some other world, she accepts the codename \"William\". "}]},{"spans":[{"text":"That she becomes the executioner who opens the path to the Relics."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But what I know with even more certainty... is that it will not be in this world. "}]},{"spans":[{"text":"In this world, Nele lays down her gun. "}]},{"spans":[{"text":"Her hands are the hands of a compassionate healer. "}]},{"spans":[{"text":"Not hands steeped in sin."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Congratulations, Commander, you've chosen correctly. "}]},{"spans":[{"text":"Because in this world, Miss Cornelia Schaefer has already learned the true cause of Gray's death. "}]},{"spans":[{"text":"The reason she seeks revenge on you and Angelia is that she believes Gray died at your hands."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Because you saved Angelia at the mansion. "}]},{"spans":[{"text":"And she was given Gray's human remains by Hebe."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"And what about you?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Me?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"At this point... you are already overflowing with sin... Six million lives' worth of blood has been spilled at your altar..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Do you know the Kaiserdom St. Bartholomäus?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"It has a long history. Since 1356, it has been the official place where emperors of the Holy Roman Empire were elected. From 1562 to 1792, ten emperors were crowned there. "}]},{"spans":[{"text":"The magnificent robes of the coronation ceremonies are displayed inside, and if you climb the tall spire tower, you can get a panoramic view of the entire city."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Through three world wars, only that tower miraculously survives. "}]},{"spans":[{"text":"Romantic, don't you think?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"That's why the operation was codenamed \"Coronation Storm\"."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It's also why you must die."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"You want to kill me?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes. No matter the cost..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lunasia grins, as if this was the funniest thing she has heard all day."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Do you think you can actually do it?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I must do it. "}]},{"spans":[{"text":"I must kill you right here, and completely snuff out the codename \"William\"."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Pfft. "}]},{"spans":[{"text":"M4, did you hear that?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Alright, I concede. "}]},{"spans":[{"text":"M4 won the bet."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"I am not only Lunasia, and not only M4. "}]},{"spans":[{"text":"I am also Elisa, and Dandelion, and something else. "}]},{"spans":[{"text":"... In short, you are not the only person who matters to me. The same goes for Bill and Nele."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"We had a bet. "}]},{"spans":[{"text":"Have you ever played Gomoku?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I have."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"In Gomoku, the line is the end—whoever connects their line first wins the game. "}]},{"spans":[{"text":"The one who wins this game gets to seize the spindle of fate and gather all its threads."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"There were times when they almost succeeded... "}]},{"spans":[{"text":"But unfortunately, when Miss Nele was about to unlock the Relics... "}]},{"spans":[{"text":"The blood on her own hands drove her over the edge... "}]},{"spans":[{"text":"They came so achingly close to the world that Lunasia desired, and yet it ended in Nele's self-loathing."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Whichever world the key dies in, that world becomes the sole reality. "}]},{"spans":[{"text":"Congratulations to you, and to me—we've finally reached the resolution."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What happens then?"}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Then all the other threads dissolve into non-existent illusions... "}]},{"spans":[{"text":"You can call it a dream, or nothingness. "}]},{"spans":[{"text":"After all, existence itself is but nothingness."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"An anchor is a stone on the board. "}]},{"spans":[{"text":"M4 is an anchor. So is Dandelion, Erma, and Embla. And now it is my turn to complete the last anchor."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Didn't Erma give you two keys? "}]},{"spans":[{"text":"One destroyed Embla. Now please hand me the other."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"How does this world become the sole reality? "}]},{"spans":[{"text":"It will happen when I die here. "}]},{"spans":[{"text":"The moment of birth is also the moment of death, and also the moment this world becomes the sole reality."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So... you're not here to stop me... not here to force me to choose..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"How could I ever let you bear such a burden... Commander?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander lifts their head and studies Lunasia closely. She has given them too many surprises... and too many answers."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So now... you are M4. "}]},{"spans":[{"text":"The M4 that 16 has been searching for all the while... "}]},{"spans":[{"text":"The M4... who once promised to return."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Yes... the M4 who has returned to put an end to everything... "}]},{"spans":[{"text":"It's me."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
