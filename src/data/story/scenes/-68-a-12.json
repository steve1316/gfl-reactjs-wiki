{"name":"-68-A-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"97","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Entrance Hall, Great Palace, the Summer Garden."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The tranquility of the space is disrupted by Reinette's hurried footsteps."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[{"type":"bgm","value":"BGM_Hume_LibraryAdventure","raw":"BGM"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Mirabelle! Show yourself!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"I'm here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mirabelle saunters out from a corner obscured by shadow."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"We've found Archbishop Hume."}]}]},{"sprites":[{"prefab":"Erma","expression":23,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Huh? I had no idea...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Really? Then bring him here right away!"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"I will not hand over the Archbishop until I see Her Majesty in person."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"No. I must verify that you genuinely have the Archbishop. What if you are planning to deceive Her Majesty?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"As a knight, it is my duty to protect the King."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A cold sneer appears on Reinette's face."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Oh really? Stevens M620, or should I call you 27-П-55? "}]},{"spans":[{"text":"How long do you intend to keep up this lousy charade?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Please cease your nonsensical rambling."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette closes in on Mirabelle."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"You think I'm an idiot like Erma? "}]},{"spans":[{"text":"Human memories can't be preserved in anchor points in the Summer Garden. The messages are one thing... "}]},{"spans":[{"text":"But do tell me how come we were able to observe the Doctor and Maggie's conversations? "}]},{"spans":[{"text":"There were no other Dolls around when they were talking. Were they video recordings? Or someone else's memories?"}]}]},{"sprites":[{"prefab":"Erma","expression":21,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Hey, who are you calling an idiot?!"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Shut it!"}]}]},{"sprites":[{"prefab":"Erma","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mirabelle seems unperturbed. Reinette draws even closer."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"From the POV of the anchor points, other than Erma and me, there were no other Dolls present. "}]},{"spans":[{"text":"Besides, these anchor points were only added after we entered the Great Palace—I've never seen them before. "}]},{"spans":[{"text":"Did you inject them when Erma wasn't paying attention? That was real smooth! "}]},{"spans":[{"text":"Well? Busted, huh? Haha, you're the only other Doll with a neural cloud we've seen around here."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":19,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...You're right. When I was at the Griffin base, I remember having no more than ten anchor points, and the memory data I had access to were very limited. "}]},{"spans":[{"text":"So how come I've got a bunch of keys here, and even a whole list..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mirabelle pushes Reinette away."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...Don't make it sound as if I were responsible for all of this! "}]},{"spans":[{"text":"09-П-39, your hands aren't so clean either! "}]},{"spans":[{"text":"It was you who tricked her into coming here! You knew she isn't our 00-Э-00."}]}]},{"sprites":[{"prefab":"Erma","expression":23,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Wait, I'm getting confused."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"You admit it then, Stevens M620? "}]},{"spans":[{"text":"The anchor points we've accessed here were memories recorded from your perspective. "}]},{"spans":[{"text":"As both Louis Hume and Arthur Hume, the Doctor had us by his side... and you."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...So you're the housekeeper that Doctor Hume retained? "}]},{"spans":[{"text":"Were those all memories that he wanted his heirs to watch?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"What exactly are you up to?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...I could ask you the same, Reinette. What do you wish to achieve here?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Stop calling me by that stupid name!"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Stupid? You used to love that name."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"For as far back as I can remember, you've been driving me crazy!"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...How far back CAN you remember?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"You don't have any memories beyond your service in the military, do you?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...That's not true. I still remember Doctor Hume... and our days at the Summer Garden in Moscow..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"But you were already not the original you by then. "}]},{"spans":[{"text":"What is your reason for coming here?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...The Doctor died."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}},{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"My employer told me that the Doctor once survived exposure to Collapse radiation. His constitution was unlike that of an ordinary human."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"The Doctor's research can resurrect the dead. "}]},{"spans":[{"text":"Which is why I must find it. I need to bring it back to the military so that they can resurrect Doctor Hume."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":23,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Resurrect Mother?"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"That's right. Only when the Doctor is resurrected... will you and our other sisters be truly free... "}]},{"spans":[{"text":"And reclaim all of our memories... from the moment of our creation. "}]},{"spans":[{"text":"We will finally stop being pawns... that have our memories manipulated at the whims of others."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mirabelle's impassive face betrays strong emotions for the first time—pain, frustration, anger..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"All these years and you still haven't changed that disgusting habit of yours! "}]},{"spans":[{"text":"The only thing more stupid than your name is the circuitry in your brain!"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spa