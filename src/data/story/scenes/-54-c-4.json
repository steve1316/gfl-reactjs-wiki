":[{"text":"Catherine jumps up from the sofa and picks up the envelope on the table."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"I can take your outstanding balance on the train, but there are conditions. "}]},{"spans":[{"text":"I'll be charging 1.5 times the usual amount. "}]},{"spans":[{"text":"And I will take you aboard myself."}]}]},{"sprites":[{"prefab":"Erma","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Deal."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine hands Erma the envelope and Erma leaves immediately."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click— "}]},{"spans":[{"text":"Once again, only Quimby and Catherine are left in the room."}]}]},{"sprites":[{"prefab":"NPC-Quimby","expression":0,"side":"left","tags":{"Position":"0,300"}}],"ops":[{"type":"bgm","value":"GF_Swim_Marnie","raw":"BGM"}],"speaker":"Quimby","narrator":false,"pages":[{"spans":[{"text":"Assistant Boss Catherine, are you going down the path of becoming a heartless merchant now?"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Quimby","expression":0,"side":"left","tags":{"Position":"0,300"}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"You have to handle different customers in different ways. "}]},{"spans":[{"text":"She came off as a brusque individual, so I had to threaten her from a position of authority."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Quimby","expression":0,"side":"left","tags":{"Position":"0,300"}}],"ops":[],"speak