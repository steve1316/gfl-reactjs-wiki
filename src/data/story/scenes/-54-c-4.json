ial website just how hard it is to get tickets for the Future. That is, if you have any common sense."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Finally, we don't extend credit."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":6,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After that series of explanations, Catherine returns to her comfy sofa."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I have a few questions..."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Shoot."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Why do I need two tickets to board the Colt Express?"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"What an elementary question... Quimby."}]}]},{"sprites":[{"prefab":"NPC-Quimby","expression":0,"side":"left","tags":{"Position":"0,300"}}],"ops":[],"speaker":"Quimby","narrator":false,"p