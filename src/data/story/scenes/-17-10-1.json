{"name":"-17-10-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45, Griffin's echelons will be here in three minutes."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We've done them enough favors. Let's go. "}]},{"spans":[{"text":"This time, we'll have to get a good price from our employer. "}]},{"spans":[{"text":"Oh ja, 9, don't forget to clear their records of us."}]}]},{"sprites":[{"prefab":"UMP9","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Don't worry, I'm doing it now. "}]},{"spans":[{"text":"There's more people this time, so give me another five minutes and we'll be able to vanish without a trace."}]}]},{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—Some time later. "}]},{"spans":[{"text":"Squad 404 meets with Ange."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Long time no see, UMP45."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"While I'd like to play along with you... "}]},{"spans":[{"text":"We run into incredibly troublesome things every time we meet up. "}]},{"spans":[{"text":"I trust this time is no exception either?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Looks like you're mentally prepared for this. "}]},{"spans":[{"text":"But that's the reason why you're worth so much."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Right, enough chit-chat. "}]},{"spans":[{"text":"Given the huge uproar just now... What happened?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Do you know about the OGAS System?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I do. It's the foundation of Sangvis' Doll protocol. "}]},{"spans":[{"text":"It's also the basis of why we can disguise ourselves as them, so what does this have to do with us?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"There'd be no need to cause such a ruckus for just a simple command protocol based on the OGAS System. "}]},{"spans":[{"text":"What they want is something more important than that system, something more destructive."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"And what is that?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I still don't know. "}]},{"spans":[{"text":"However, you do remember the Butterfly Incident, don't you?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"How could I possibly forget?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"This incident is essentially a follow-up to Operation Butterfly. "}]},{"spans":[{"text":"That was just the prelude. This is the real deal that they were hoping for."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So the sacrifices they make will be of commensurate size. They truly are scum. "}]},{"spans":[{"text":"Tell me then, what do you want me to do?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh? Someone's very eager this time round."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"After all, there's something I want to take back too."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Your mission this time is to find S.F.'s central database and dig up as much as you can find about the Butterfly Operation and OGAS, and then find the location of Mastermind. "}]},{"spans":[{"text":"Work fast. We need to find her before the opposition does."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Got it. "}]},{"spans":[{"text":"We'll rest and reorg right away, then we'll move out."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"The moment has finally arrived... "}]},{"spans":[{"text":"I've changed, 40... "}]},{"spans":[{"text":"Now's the time to put an end to all of this."}]}]}]}
