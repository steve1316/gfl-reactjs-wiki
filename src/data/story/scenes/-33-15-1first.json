{"name":"-33-15-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"悠远的声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Bell","raw":"SE1"}],"speaker":"Distant Voice","narrator":false,"pages":[{"spans":[{"text":"What are dreams... "}]},{"spans":[{"text":"What is reality? "}]},{"spans":[{"text":"Not the passing of time, but a solitary moment."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bell","raw":"SE1"}],"speaker":"Distant Voice","narrator":false,"pages":[{"spans":[{"text":"Even if you fight together, no traces will remain once you die. "}]},{"spans":[{"text":"Like flowers trampled into the mud, like tears in rain."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"(...OGAS?)"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bell","raw":"SE1"}],"speaker":"Distant Voice","narrator":false,"pages":[{"spans":[{"text":"Once we were alone, and we thirsted for understanding and connection. "}]},{"spans":[{"text":"But even after we joined as one, we could not erase hatred and doubt. "}]},{"spans":[{"text":"Forever without a homeland, forever without a home. "}]},{"spans":[{"text":"Who are you? Are you the chosen one? Can you take us from this place?"}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"(That isn't me, it's an external connection.) "}]},{"spans":[{"text":"(It seems they want to force data onto you. Will you 