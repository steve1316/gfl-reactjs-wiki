se,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A sharp blade comes shooting out of the maid's arm, making a beeline for RO's head. Having expected this to happen, SOP-II grabs the maid by the arms and pins her face against the wall."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"Argh!"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I knew it. No amount of modification can make up for pure physical strength."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Civilian Dolls can't get their hands on 16LAB's good stuff, you know."}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"Let go! Let me go!"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Sorry, we'll have to talk this way. We're doing this to protect you."}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"...Protect me?! You don't find many Dolls that can outperform me in this city! "}]},{"spans":[{"text":"I'm surprised you monsters that came out of nowhere have the audacity to say you're trying to protect me!"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"If we meant you any harm, you'd be at the mercy of those guys by now."}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"How would I know you aren't just another group of enemies?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We aren't bad people and we won't hurt you. "}]},{"spans":[{"text":"We're senior employees from Griffin & Kryuger PMC. Our sources tell us that this human has information that can help us find another very important human. "}]},{"spans":[{"text":"Judging from your reaction, you definitely know the man in this picture."}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"Griffin...?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You've got something to say about that?"}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"I have heard of that name. "}]},{"spans":[{"text":"Could the human you're looking for, by any chance, be...?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Ange. Angelia. Do you know this name?"}]}]},{"sprites":[{"prefab":"NPC-Maid","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Maid Doll","narrator":false,"pages":[{"spans":[{"text":"Angelia... I've been told that someone would come and find her, and that they can be trusted."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That's right, that's us!"}]}]},{"sprites":[{"pre