":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM!!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-WildBattle","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev's voice echoes across the expansive battlefield."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"MP-443! C14! Where are you?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Through the comms, Lee Enfield's voice is shredded by artillery fire and the shriek of the wind."}]}]},{"sprites":[{"prefab":"MLEMK1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Lee Enfield","narrator":false,"pages":[{"spans":[{"text":"It's too late! Tokarev, fall back immediately to the 17th defensive line! They're already here!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"No! I still... I still have teammates—"}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0%%range=3","raw":"controll_shake"},{"type":"cgDelay","value":"0.4","raw":"CGDelay"},{"type":"sfx","value":"AVG_Explosion","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh—BOOM!!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"typ