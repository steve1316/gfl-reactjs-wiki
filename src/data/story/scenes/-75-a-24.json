{"name":"-75-A-24","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_HeavyVehicle_Stop","raw":"SE1"},{"type":"background","value":"BG_Base","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the assembly point, more and more artillery and armored vehicles roll onto the training ground. "}]},{"spans":[{"text":"Passing this close to them, the vibrations coming up through the ground are enough to set anyone on edge. "}]},{"spans":[{"text":"Yet the petite Doll's mind is nowhere near the field."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Gr MG23, you're drifting out of formation!"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"Campaion-34","raw":"BGM"}],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"Huh?! S-sorry!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gr MG23 jumps at her name and immediately hides her hands behind her back."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"What's that? What are you hiding?"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"Shhhh!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gr MG23 glances left and right, then pulls out a small object from behind her."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"A straw-woven little bunny? That's adorable~ I didn't know you could make things like this."}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"It-it's nothing fancy... "}]},{"spans":[{"text":"But after this operation is over and we wipe out Sangvis Ferri, I want to give it to the Commander at the celebration banquet. "}]},{"spans":[{"text":"Y-you mustn't tell the Commander directly, okay?"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"So that's what it is. Don't worry~!"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"Heheheh... but still, will the Commander like it? What if it's... too childish...?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"I can't say for other humans, but our Commander will definitely like it, so—"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What are you two talking about?"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_TT33","expression":2,"sho