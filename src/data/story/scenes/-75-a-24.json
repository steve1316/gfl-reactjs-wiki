ession":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev's thoughts drift back and forth between illusion and memory."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She sees medical Dolls running past her, stretchers carrying shattered comrades, long trails of repair fluid smeared across the ground."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She hears again the thunder of the submarine base explosion, Dolls hurled into pitch-black water by the shockwave, their bodies twisting and breaking under pressure."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She can almost smell the acrid stench of burning at the Griffin base, see her comrades calling out names of the missing amid the ruins, again and again."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev looks ahead. As far as her vision reaches, everything is scorched earth. "}]},{"spans":[{"text":"Across the blackened ground lie ruined Doll frames impossible to identify, along with countless severed limbs still sparking with electricity."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"So this... is the might of the Military?"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"...How... how could they?! "}]},{"spans":[{"text":"It was supposed to be a drill... but they did this to us...! "}]},{"spans":[{"text":"It's impossible to tell... if the Commander is 