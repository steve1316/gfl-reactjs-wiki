e":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev and Gr MG23 snap to attention and salute."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Once the Commander nods and leaves, the two exchange a look and burst out laughing."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"We've got to do well this time and live up to the Commander's expectations. "}]},{"spans":[{"text":"As for the gift, we'll talk about it after the operation. Come on, let's go~!"}]}]},{"sprites":[{"prefab":"hk23","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MG23","narrator":false,"pages":[{"spans":[{"text":"Right!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_Gunfire","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"T-Doll","narrator":false,"pages":[{"spans":[{"text":"Aaaaah!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"T-Doll","narrator":false,"pages":[{"spans":[{"text":"Quick! Get to cover! Move!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"T-Doll","narrator":false,"pages":[{"spans":[{"text":"Command center! Command center! We're under S.F. fire! Command center, do you copy?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Comms","narrator":false,"pages":[{"spans":[{"text":"N-no...! It's not Sangvis Ferri!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"It's friendly forces! We're under friendly—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"t