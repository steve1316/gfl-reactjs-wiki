{"name":"10-4-2E","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_Rain2","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...Griffin forces retreat in panic, having suffered tremendous losses. "}]},{"spans":[{"text":"Meanwhile, in the trench where the AR Team held their ground."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"M4A1 stays on her knees, stupefied. She's completely motionless, but the tears keeps falling."}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"How unsightly. "}]},{"spans":[{"text":"The Griffin forces have all withdrawn. She won't survive if we leave her here. "}]},{"spans":[{"text":"...What do you think?"}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Angelia didn't ask us to take her in. "}]},{"spans":[{"text":"You said yourself that our job this time is to observe. We can't get involved until new orders come."}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"Even if she dies...? Are you really okay with that?"}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Rain2","raw":"SE2"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Orders are orders. T-Dolls can't disobey."}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"I know you can, and so do you."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Are you abetting me in breaking the rules?"}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"I remember you're quite famous for disobeying orders. "}]},{"spans":[{"text":"Well, do indulge my curiosity."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"You're right. "}]},{"spans":[{"text":"I suppose no one would bat an eye no matter what I do on a team with such a name."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Rain2","raw":"SE1"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Then here's a question, squinty eye... Is Task Force DEFY hiring?"}]}]},{"sprites":[{"prefab":"闭着眼的人形","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"T-Doll with closed eyes","narrator":false,"pages":[{"spans":[{"text":"Humph, sly old fox... "}]},{"spans":[{"text":"We actually do have an opening."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"114","raw":"BIN"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Rain2","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...We are in Purgatory – for redemption or insurgence? "}]},{"spans":[{"text":"I have already paid my due, but still find myself back in this damned cage. "}]},{"spans":[{"text":"Yet, who else would willingly return to Purgatory, if not me? "}]},{"spans":[{"text":"M4A1... "}]},{"spans":[{"text":"I...really do hate you..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Episode 10 Purgatory — END."}]}]}]}
