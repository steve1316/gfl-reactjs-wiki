{"name":"-31-1B1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Slum","raw":"BIN"},{"type":"bgm","value":"BGM_Moon","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"After nightfall in the city, in a certain darkened alleyway "}]},{"spans":[{"text":"AR-15 sits quietly in a blind spot of the surveillance cameras. The light from the city outside filters into the alley and reaches her eyes. "}]},{"spans":[{"text":"Even when she hears footsteps, she does not look back. Instead—"}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"If you point your gun at me, I might return fire by reflex."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"In that case, don't just pop up from behind me."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 puts her gun away, but just as she is about to stand up, AN-94 falls to one knee before her. "}]},{"spans":[{"text":"This is not a gesture of loyalty, simply a way of facilitating what will happen next. AR-15 knows that very well, so she directs her eyes to the heavy backpack she has just taken off."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I've brought your gear and batteries. There may be a very long fight ahead of us and Ange doesn't want us to waste precious time on running back and forth to resupply."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"How did you get here?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Through the sewers. AK-12 found a map of the city's sewers during the last operation, so she handed it to me. There are some places that are quite handy to set up camp in secret. "}]},{"spans":[{"text":"However, the map's not too complete, and there are some suspicious sources of jamming which you should avoid. After filtering them out, we only have a couple of routes that we can take."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It'd be weird if there weren't any sources of jamming with that white bunch around. "}]},{"spans":[{"text":"Let's see what you brought... "}]},{"spans":[{"text":"Ammo...and lots of it, enough for two people. A signal filtering kit, a biothermal analyzer...and what's this crowbar doing here?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"AK-12 told me to bring it, she said it might come in useful. Also, this is your radio, it's been encrypted."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Thank you...and what is this?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 holds up a book that was lying at the bottom of the tactical bag."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"It's the Holy Bible."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"And did AK-12 ask you to bring that as well?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Da. She said it could be useful before your operation."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"As if that could be... "}]},{"spans":[{"text":"...I see, there was a slottable chip with preloaded apps on it."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Since you're unable to connect to the Zener Network, the chip should be able to help you update your essential functions."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Thank you for your thoughtfulness."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"AK-12 prepared it. If you want to thank anyone, then thank her."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You keep going on about AK-12, how deeply in love with her are you anyway?"}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"It's not love... "}]},{"spans":[{"text":"Ever since I was rolled out, I was designed to accompany and protect her. It is my purpose in life, the guidepost for the actions I take, my fate and my destiny. I believe that should be an accurate description."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You're almost making me sick."}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"From your combat records, you weren't much different from me in terms of what you did for M4."}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That was because of that damn core order... "}]},{"spans":[{"text":"But M4 means nothing to me now. "}]},{"spans":[{"text":"You, on the other hand, sound like how the believers describe their God in that Bible. "}]},{"spans":[{"text":"It's pathological."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Have you read the Bible before?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"My database contains some elementary knowledge on it, along with information about human religions and lifestyle. "}]},{"spans":[{"text":"...Humans worship their God, and in return they hope God will save them."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Then...do you believe in God?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Why would a Doll need to believe in God? Don't tell me your neural cloud's so fragile that you need God to comfort you and fill the hole in your life?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I was simply mentioning a possibility, but each and every time you refuse to give me a proper answer."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Humph... "}]},{"spans":[{"text":"If I really believed in a god, then my god would be Persica. "}]},{"spans":[{"text":"Do you honestly think I would feel anything like reverence for a \"god\" who gave me such a miserable fate?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"To Dolls, everything has already been planned out. Our gods are our creators and our creators' orders are absolute, just like how humans can't question their gods."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What a boring answer."}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"However, unlike how humans are shackled by destiny, we are unbound, except by the orders of our gods. "}]},{"spans":[{"text":"That is why we are called \"DEFY\". "}]},{"spans":[{"text":"We cannot escape the choices of our gods, but I can make choices of my own outside that. "}]},{"spans":[{"text":"And my choice is that no matter what AK-12 expects of me, I will do as she wishes."}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Even if it means you will struggle without hope for the sweet release of death?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Unlike you, we don't have the concept of death. "}]},{"spans":[{"text":"The purpose for our existence is to complete our tasks and support a certain someone."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...I've had it. "}]},{"spans":[{"text":"Pretend I never brought this up."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Have I upset you?"}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"It seems I've upset you."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I don't really understand why Ange arranged for us to be in the same team. "}]},{"spans":[{"text":"Looks like we won't be great conversational partners. In that case, let's focus our attention on how to carry out our upcoming mission."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Victory","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Yes, the mission is the highest priority. "}]},{"spans":[{"text":"Your energy accumulators should be fully charged now, so we can begin the operation after your body calibrator gives you the green light."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Roger. "}]},{"spans":[{"text":"I'll handle the outskirts, you take care of the city districts. We'll split up and move separately. "}]},{"spans":[{"text":"\"If you spot those white bastards, don't carelessly exchange fire.\""}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"\"Verify their location; the top priority is to see if they're linked to the 'Node'.\""}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Orders verified. 5 seconds remaining. 3, 2, 1, — move out!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG_City","raw":"BIN"},{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 slowly forges ahead through the city streets, in the bustling heart of the commercial district."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hailing AR-15, please respond.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Received. I'm entering a region with high signal density as planned. How are things on your end?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Carrying out passive scanning as planned.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Other than your region, there are 43 new locations with suspicious signals, and 18 of them are confirmed to be using White Faction wavelengths. I can't accurately pinpoint the others. Do I need to increase scanner power?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"No need. Ange said that someone else will handle the small fries. We mustn't run the risk of exposure.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Focus on finding the clues to the \"Node\". We need to filter through to the high-value targets ASAP.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Understood. I'm currently eavesdropping on all the verified units. No extra news for the time being.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Although...the strange thing is that I've discovered signal wavelengths similar to S.F.'s.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"shake","raw":"震屏"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"S.F.?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"What's S.F. doing here?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Similar to S.F. It only appeared for a moment and I thought I had been mistaken...but they were very similar, to the point where one could conclude that there were S.F. Dolls in the city.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Why would S.F. come to Belgrade...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"In that case, will she come here too...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"AR-15...our main objective is not those S.F. Dolls.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"We should make completing our mission our top priority.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"But...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...You're right, we don't have much time.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Make a note of the signal source, we can talk about the rest after the mission is complete.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Alright, I've marked the location.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Let's not worry about that for now.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Now then...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"...I've reached the target sector.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"This is...a military camp?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-TemporaryBase","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The soldier on sentry duty looks around, and just as he turns back, a shadow silently leaps over the wall surrounding the camp."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"AN-94, can you hear me?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Received. How are things?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I'm already inside the military base. As I expected, the signal markers here are very obvious... A very amateurish way of hiding a signal. I was even a little worried that this was a trap.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"So are you going to leave?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It's not the first time I've known it was a trap and walked into it anyway. More importantly, I can't just come away from this empty-handed.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Help me set up a secure channel, I need to contact Ange.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Must you use the radio? No matter how much you encrypt them, old signal patterns like that are easily intercepted. It's not like we can't unlock your Zener Protocol...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't want to hear that voice again. Could you cut the chit-chat?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"As you wish.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Secure channel established. I'll maintain it for 60 seconds.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Hailing Ange, please come in.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Received. How's progress?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"This is AR-15.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'm investigating the first cluster of white signals. This is a garrison camp, but not a large one. ","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"It's very likely that the military district is linked to the \"Node\", so I'll be sneaking in to scout the place.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I can verify the position of the signal here for the most part. Will any demolition be required?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Don't be hasty.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Others will handle the task of eliminating the infiltrators. All you need to do is send all the positional data you've collected to me.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Conduct a full reconnaissance on the entire camp. My instincts tell me there's a big fish there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't get it.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"How important is the \"Node\"?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Is it really alright to leave the enemies hiding here alone, even if they might end up hurting or killing the humans in this city?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The mission I gave you was to find clues related to the \"Node\", not protect civilians.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"You're not a PMC employee anymore, AR-15.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Understood.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"AN-94's also found some white signal clusters apart from this camp. There are even S.F. signals in the city.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Is that so...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"94, what's the exact number of signals you've screened?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"52, and nine more signal sources appeared in the past 30 minutes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"It makes no sense that so much trash could burrow in here and not be detected.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Even if their \"Baptized\" are here, hiding so many entities at once is very difficult.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"According to my investigations, they're not bothering to hide themselves at all.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That would mean...there's a problem with the immune system.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"So having white signals in a garrison is a perfectly reasonable answer.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"However powerful the White Faction might be, I doubt it extends to making the local army do their bidding...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"From what I know, this country has maintained absolute neutrality.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I don't think it's possible that the army would obey the White Faction's commands either.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Maintaining one's neutrality in a dangerous situation requires stringently-selected troops and great political skill.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"But leaves only fall after the roots have rotted.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"So they've been compromised from the inside, then...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I understand.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The secure channel is going to expire soon.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Continue monitoring the situation until new information comes up. I look forward to hearing good news from you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"25","raw":"duration"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange cut off the transmission."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Sighs) What a troublesome mission. AN-94, I'll remain hidden in this camp to observe the situation. I need you to keep an eye on the camp's other exit.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Meow...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Meow?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Oh, it's nothing. I see the coordinates you sent. I'll be there in half an hour. AN-94 out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG-Cybercity","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 shuts off her comms. "}]},{"spans":[{"text":"A soft sensation rises up from her leg and one of the stray cats wandering through the park attempts to jump onto AN-94's thigh. "}]},{"spans":[{"text":"AN-94 bends down to lift the cat up onto her lap and gently caresses its soft fur."}]}]},{"sprites":[{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"An adorable creature, is it not?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"??"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Who would realize that cats are actually terrifying predators when they're being all cute and cuddly?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"You are?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Sorry, my apologies. I'm a local resident and I often come by to feed the cats, so please don't mind me."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl scatters some cat food on the ground, and the cat that was seated on AN-94's lap immediately jumps down."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Then, it's about time to take my leave as well."}]}]},{"sprites":[{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 stands and prepares to leave. "}]},{"spans":[{"text":"As she passes the girl, the girl muses aloud..."}]}]},{"sprites":[{"prefab":"NPC-Mercurows","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Are you also like that? A cute and cuddly predator?"}]}]},{"sprites":[{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"!!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 looks back in shock, but the girl is already gone. "}]},{"spans":[{"text":"And there is no trace of the cat food or the kitty on the ground."}]}]}]}
