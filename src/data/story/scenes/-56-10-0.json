 they do."}]},{"spans":[{"text":"Do you understand now, Cheryl?"}]}]},{"sprites":[{"prefab":"NPC-Cheryl","expression":5,"side":"left","tags":{"Position":"0,-100"}}],"ops":[],"speaker":"Cheryl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"Eula isn't coming back. You should forget about her."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Cheryl's trembling lips open and close, but she does not say anything."}]},{"spans":[{"text":"Samo rises from the couch and checks her power levels."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"I should go."}]},{"spans":[{"text":"Thank you for taking care of me all this while."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo tucks away her power cables, puts her hat back on, and heads outside."}]},{"spans":[{"text":"Cheryl watches her dumbly from where she's standing."}]}]},{"sprites":[{"prefab":"NPC-Cheryl","expression":5,"side":"left","tags":{"Position":"0,-100"}}],"ops":[],"speaker":"Cheryl","narrator":false,"pages":[{"spans":[{"text":"Samo..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Samo","narrator":false,"pages":[{"spans":[{"text":"I'm going now. Take care of yourself."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samo slowly closes the door—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam—Cheryl rushes out the door and into Samo's back."}]}]},{"sprites":[{"prefab":"NPC-Cheryl","expression":5,"side":"left","tags":{"Position":"0,-100"}}],"ops":[],"speaker":"Cheryl","narrator":false,"pages":[