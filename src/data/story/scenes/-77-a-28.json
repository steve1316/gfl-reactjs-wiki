gs":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"This is Team Palette. We've entered the target base through Entrance B.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"VHS","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"VHS","narrator":false,"pages":[{"spans":[{"text":"...Squad Puzzle has reached the designated position. Awaiting orders, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"GeneralLiu","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"General Liu","narrator":false,"pages":[{"spans":[{"text":"(Sob) It's really good to see you again, Commander!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SL8","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr SL8","narrator":false,"pages":[{"spans":[{"text":"Huh? We can talk to the Commander? I wanna do it, too! Commander, is it fun over there?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Ah, these Dolls... "}]},{"spans":[{"text":"Even without knowing the full situation after waking up, they all rushed in without hesitation the moment they heard they were coming to rescue you. "}]},{"spans":[{"text":"You sure are popular, Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing those familiar faces on the comms, countless memories flash through the Commander's mind."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Hmph, the other squads are all chatting casually with the Commander. You're the only one being so serious, Makarov.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"I have nothing to say...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Commander, I just want to keep fighting by your side forever.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I'm glad to see you all again. "}]},{"spans":[{"text":"But now isn't the time to chat."}]}]},{"sprites":[{"prefab":"VHS","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"VHS","narrator":false,"pages":[{"spans":[{"text":"I've shut those idiots up. Give the order, Commander. We'll cover your advance.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"These figures have accompanied the Commander across countless battlefields. Now, once again, they become the force that drives them forward."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm counting on you. All frontline squads, continue the feint. "}]},{"spans":[{"text":"Palette, Puzzle, and others squads, advance from alternate entrances and destroy base facilities. "}]},{"spans":[{"text":"M16, DEFY, you're with me. We find William."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Dolls","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"10213","raw":"BGM"},{"type":"background","value":"742","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With gunfire echoing behind them, the Commander's group pushes deeper into the base."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is this room?"}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Looks like a central control room, but at this scale... it might not just control this base."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Let me check. Hmm... It seems to be connected to the production systems in other factories. "}]},{"spans":[{"text":"We might be able to support Kalin if we can take control."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...No time. Raiding the IOP storage won't go unnoticed. "}]},{"spans":[{"text":"We need to find William before URNC reinforcements arrive."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Then we split up. "}]},{"spans":[{"text":"I'll stay here and hack the system—help Kalin while ensuring all data and factories are destroyed. "}]},{"spans":[{"text":"As for killing William... I've already failed twice, so..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"This time, I'll let you do the honors, Commander."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 raises her hand in a playful finger-gun gesture toward her head."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Make sure you deliver the bullet for me."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The forced casual gesture carries the weight of parting."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Go. Didn't you say time is short?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...We'll meet again. If not after this battle, then someday. "}]},{"spans":[{"text":"See you around. And the rest of AR Team."}]}]},{"sprites":[{"prefab":"NPC_TT33Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Too bad Persica has them all placed under \"protection\". "}]},{"spans":[{"text":"I don't even want to imagine what 15 will do when she finds out we fought the final battle without her. She might go Goliath... again."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"s