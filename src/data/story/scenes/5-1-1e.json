{"name":"5-1-1E","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Video file."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"26 minutes after the AR Team commenced pursuit on Destroyer..."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"There's too much firepower ahead! Dammit, we can't make it through!"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Don't rush it! Wait for the reloading gap before we charge!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Wait. Listen to that..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Now! Run for it!"}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"M16, watch out!!"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...BOOM!!"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","