ression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"It'd have been more believable if you'd said the Sangvis ringleader did us a large favor and self-destructed.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"That hideout is relatively safe. As long as they stay put, S.F. won't find them. "}]},{"spans":[{"text":"And they'll head back at dawn. "}]},{"spans":[{"text":"Though I suppose MP41 will be rather disappointed."}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"There's no point in being so kind...Kar.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"That kid isn't gonna appreciate what you've done for her.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"I know, but I didn't do that for anyone's appreciation. "}]},{"spans":[{"text":"It's time. What's the current situation?"}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"I have a rough idea of Gager's position, but she's constantly on the move.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"She...seems to be searching for something.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Find a way to draw her into my optimal range. If I don't kill this Sangvis elite with a single shot... "}]},{"spans":[{"text":"We most probably won't be going back alive."}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"According to S.F.'s search pattern, they'll approach this area in two hours.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Then as always, I'm going to feint an attack to draw Gager right into your line of sight.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":" "},{"text":"I really hate getting used to a new body after having my neural cloud re-installed...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So could you please make your shot count?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"98k smiles faintly."}]}]},{"sprites":[{"prefab":"98k","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Don't worry. "}]},{"spans":[{"text":"Have I ever failed you?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Meanwhile."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty",