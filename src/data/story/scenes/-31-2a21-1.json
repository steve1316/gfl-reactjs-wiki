{"name":"-31-2A21-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-Wall","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Behind the quarantine wall."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange activates her comms."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I remember telling you not to say anything unnecessary again.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"There's been another breach on the quarantine wall. We're currently trying to keep things under control."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Your mission is to gather intelligence on the Pike Node, not damage control.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If the situation gets any worse, we won't be able to do any recon work. "}]},{"spans":[{"text":"Even if we aren't getting any support, at least