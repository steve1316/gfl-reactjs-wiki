{"name":"-2-2-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"7","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Haha! Look, another communication outpost!"}]}]},{"sprites":[{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Fantastic. The door isn't locked either. "}]},{"spans":[{"text":"M16, could you please check the comms system inside?"}]}]},{"sprites":[{"prefab":"M16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Fully functional and shows no sign of having been hacked. We're really in luck."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Woohoo! Then let's go in! "}]},{"spans":[{"text":"We have to set up a new communication network and warm ourselves up while we're at it. I'm literally turning into a popsicle!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"8","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Three minutes later."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"M4... "}]},{"spans":[{"text":"Wait, no. M16, is that you?"}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Yes, Miss Helian. We are all okay. "}]},{"spans":[{"text":"We found several survivors and are now contacting you at a communication outpost to the west of where we crashed."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"That's good news... "}]},{"spans":[{"text":"HQ has been doing everything they can to mount a rescue mission once they learned of your survival. "}]},{"spans":[{"text":"However, this is going to take some time due to the distance and poor weather conditions."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"We are relatively safe for now, but S.F. has probably already detected our presence. "}]},{"spans":[{"text":"We've been gathering our forces by searching for other survivors, but the weather is simply too terrible. "}]},{"spans":[{"text":"Low temperatures and strong winds are severely impeding our movements and replenishments."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I'm dispatching... "}]},{"spans":[{"text":"...aircraft to the heli...in the southeast..."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Pardon? Miss Helian?"}]}]},{"sprites":[{"prefab":"赫丽安","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"...to provide supplies... "}]},{"spans":[{"text":"But...careful..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Connection broken."}]}]},{"sprites":[{"prefab":"M16","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"(Slams the table) Dammit!"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The blizzard must be interfering with the signal... "}]},{"spans":[{"text":"If there's a heliport in the southeast, then they must be able to keep sending in supplies. "}]},{"spans":[{"text":"In any case, let's move out."}]}]}]}
