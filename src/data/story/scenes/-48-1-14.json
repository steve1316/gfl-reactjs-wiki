{"name":"-48-1-14","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"冰湖","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"effect","value":"%%code=CJ_snow%%","raw":"common_effect"},{"type":"sfx","value":"GF_Halloween_Wind_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the Neo-Soviet Union..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"(Rustling) "}]},{"spans":[{"text":"The drifting snowflakes fall to the ground, crackling delicately as they disappear under a leather boot. "}]},{"spans":[{"text":"Winter is coming earlier and earlier in the Neo-Soviet Union."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man in plain clothes walks in slowly from the entrance of the cemetery, leaving a long trail of footprints behind him. "}]},{"spans":[{"text":"He stands before the cenotaph and raises his head. "}]},{"spans":[{"text":"He has engraved every name on it in his heart."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"Phew..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As he exhales a cloud of white mist, Carter can keenly feel the coldness of early winter. "}]},{"spans":[{"text":"Behind him, a uniformed soldier approaches slowly, an umbrella in hand."}]}]},{"sprites":[],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"...Sir, the report has been accepted by the Secretary. "}]},{"spans":[{"text":"You are currently relieved of all duties and are to remain in your current position to await further instructions."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"Relieved of all duties... "}]},{"spans":[{"text":"...Is that all?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"...Yes, sir."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"I hold no delusions that Zelinsky is that kind. "}]},{"spans":[{"text":"Perhaps the people on top are still thinking of the sacrifices I've made for the Motherland."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"Sir..."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"What about Captain Yegor's family?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"...Captain Yegor was branded as a traitor. "}]},{"spans":[{"text":"We could not treat him as a martyr, so... all we could do was arrange for his family to move elsewhere."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"It's a shame."}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"Sir?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"It's a shame that a hero who fought for his nation does not even have the right to be buried in the land he was born in. "}]},{"spans":[{"text":"Such a country is no longer the motherland that we've sacrificed everything for."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Carter looks up at the cenotaph, which is covered in countless names. He takes out a document with an opened seal."}]}]},{"sprites":[],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"Sir... What is that?"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"...Just a contract."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After taking another long, hard look at the document in his hands, Carter turns and slowly walks toward the cemetery's exit."}]}]},{"sprites":[],"ops":[],"speaker":"Soldier","narrator":false,"pages":[{"spans":[{"text":"Sir! Where are you going?!"}]}]},{"sprites":[{"prefab":"NPC-Carter","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Carter","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...To the border."}]}]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=DoomsdayClock03%%wait=1%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
