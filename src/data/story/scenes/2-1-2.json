{"name":"2-1-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Combat over. Report submitted to Helian."}]},{"spans":[{"text":"Helian returned to HQ."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Things look more serious than we imagined, Mr. Kryuger."}]},{"spans":[{"text":"According to that commander's investigation, Sangvis Ferri was again one step ahead of us."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"In other words, they've been beating us to intelligence regarding M4A1."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes. My guess is that they have a T-Doll skilled at breaking codes."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Or...they've been acquiring intelligence from one of our own."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"That's..."}]},{"spans":[{"text":"I believe...everyone at Griffin to be trustworthy, and the T-Doll safety system impeccable."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Safety and trustworthiness are relative."}]},{"spans":[{"text":"We can't begin to guess what cards our enemies have up their sleeve."}]},{"spans":[{"text":"Halt your operations for now, Helian, just to be safe."}]},{"spans":[{"text":"There's no need to follow up on that commander's mission either."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Then...should we continue the operation to rescue the AR Team?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Certainly, but we're changing our strategies. I'll find someone more suitable for the task."}]},{"spans":[{"text":"Speaking of which, Helian, does the commander working for you...like cats?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]},{"spans":[{"text":"Well... I never asked, but...I hope so."}]},{"spans":[{"text":"Don't tell me, Mr. Kryuger, you intend to..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Yes. Since we can't solve the current problem, let's start from the roots."}]}]}]}
