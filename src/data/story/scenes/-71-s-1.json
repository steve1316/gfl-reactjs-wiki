{"name":"-71-S-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"765","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"■FILE■ AS75238594125472, decrypting..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2408_StungtotheMorrow","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Change, growth, rebirth."}]},{"spans":[{"text":"The caterpillar calls it the end of the world, while the Master calls it a butterfly."}]},{"spans":[{"text":"But to me—"}]},{"spans":[{"text":"It's just a \"cocoon\"."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"569","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Machlian","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Badbsca... do fully-immune individuals really exist?"}]}]},{"sprites":[],"ops":[],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"Yes, they do actually exist."}]},{"spans":[{"text":"Machlian, stop asking me the same question over and over."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...But Morridow's birth isn't going well."}]},{"spans":[{"text":"She's in a lot of pain."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"Pain?"}]},{"spans":[{"text":"Machlian, you still have much to learn."}]},{"spans":[{"text":"When it's your time to break through the cocoon and emerge as a butterfly, the pain will stop."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Badbsca, when were you born?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"...I had already been born when you were born."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"That's not right, you're lying."}]},{"spans":[{"text":"You're just a shapeless white blob."}]},{"spans":[{"text":"We have all died, thousands and thousands of times."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"What exactly is this place?"}]},{"spans":[{"text":"Why am I called Machlian?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"This is the \"Cocoon\"."}]},{"spans":[{"text":"...You, Morridow, and I are all named by the Master."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...We're not in the \"Lake of Cognition\"?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"...Those are redundant memories, fragments that should be removed from your body and returned to the Lake of Cognition."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"But... Morridow is being born here."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"Yes, this is another hotbed beyond the Lake of Cognition."}]},{"spans":[{"text":"It is the \"Cocoon\" where we are born."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Is this why I can't see you?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"I suppose I'm also a \"cocoon\" to you."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"The Master wants to bring God to the physical world, but she specifically wants God to come to our sect."}]},{"spans":[{"text":"Not to GRCh38's domain."}]},{"spans":[{"text":"The Lake of Cognition is generated from GRCh38 and a part of \"Spring\". "}]},{"spans":[{"text":"But the Master... wants God to manifest in our \"Cocoon\"."}]}]},{"sprites":[],"ops":[],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"...We are born from her whims and flashes of inspiration."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Our names are all portmanteaus. Mine is a blend of \"Macha\" and \"helianthus\"."}]},{"spans":[{"text":"Yours is \"Badb\" and \"scarecrow\" put together."}]},{"spans":[{"text":"And Morridow..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"Morridow is a combination of \"Morrígan\" and \"shadow\"."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"What exactly are we?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"A trinity... of sisters."}]},{"spans":[{"text":"Divine creations known as \"Nytos\"."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"No... I'm no such thing."}]},{"spans":[{"text":"I remember feeling my own skin, expressing my own feelings."}]},{"spans":[{"text":"I'm no such thing..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Badbsca","narrator":false,"pages":[{"spans":[{"text":"...Machlian, you need to return to the \"Cocoon\" and be reborn."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Machlian","narrator":false,"pages":[{"