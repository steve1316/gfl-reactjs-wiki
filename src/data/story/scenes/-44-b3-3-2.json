{"name":"-44-B3-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=changjing_huafen%%","raw":"common_effect"},{"type":"background","value":"gunCGlake","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! "}]},{"spans":[{"text":"A series of explosions goes off throughout the village. In just ten-odd minutes, what had once been a quiet settlement has been transformed into a hellscape."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dammit! (Coughs)"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander! You need to get out of here right now! The Collapse Particles are still spreading!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine! How about Machlian, how is she?!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I'm watching her!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian is standing in the middle of the road, her lips trembling as her eyes reflect burst after burst of firelight."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO, didn't you say there wouldn't be explosives here?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I said that it would be very hard to cause meaningful damage to a wide-open space with explosives. "}]},{"spans":[{"text":"But... These villagers used them on themselves!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"They're all insane!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Commander! We disarmed another one! But..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Squad Griffin drags the struggling villagers out of their home. But even though they've survived the fate of being blown up, their exposed skin is starting to show signs of ulceration where it made contact with the air."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"<Size=55>BOOM!!</Size>"}]}]},{"sprites":[{"prefab":"Kolibri","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"Ahhhhh, there's too much to do! "}]},{"spans":[{"text":"And they're even putting up a fight! What's wrong with these people?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"<Size=60>BOOM!!!</Size>"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,