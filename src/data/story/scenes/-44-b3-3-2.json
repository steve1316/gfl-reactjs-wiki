[{"text":"The rapidly-spreading ELID is tearing through her body, and her immune system is steadily transformed her tissues into rotten pus."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian does not cower or back away from her. Instead, she scoops Elsa up into her arms."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"You'll be fine... You'll be fine... I'm here, I'm right here. "}]},{"spans":[{"text":"You'll be fine... Elsa!"}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Elsa","narrator":false,"pages":[{"spans":[{"text":"...Are you crying, My Lady? "}]},{"spans":[{"text":"Are you hurt too?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I'm not... I'm not..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian's face is a mess of tears. She pulls up her sleeve and bites down on her hand. "}]},{"spans":[{"text":"Drip. "}]},{"spans":[{"text":"She doesn't feel the pain at all. "}]},{"spans":[{"text":"The blood oozing out is still warm, and Machlian smiles even as she weeps, as though she's grasped a lifeline in a storm. She brings her wound to Elsa's lips."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Elsa, open your mouth... Open your mouth. "}]},{"spans":[{"text":"You'll be alright... You'll be alright..."}]}]},{"sprites":[{"prefab":"NPC-Lilyan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Elsa","narrator":false,"pages":[{"spans":[{"text":"My Lady..."}]}]},{"sprites"