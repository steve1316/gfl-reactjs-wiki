:[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Machlian?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21winter_avg_mahaline","raw":"BGM"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I'll tell you... I'll tell you everything! "}]},{"spans":[{"text":"I'll tell you everything you want to know!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her voice suddenly turns hysterical. Her hoarse throat cannot take all the sudden shouting, and she lapses into a fit of violent coughs."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I'll take you, I'll take you there! "}]},{"spans":[{"text":"Use my blood! We can make an antidote! We'll go now!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She rises from the ground, still carrying Elsa's body."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Over here... This way..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Don't try and stop me!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[