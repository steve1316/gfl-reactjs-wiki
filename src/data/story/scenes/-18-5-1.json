{"name":"-18-5-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"98","raw":"BIN"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"spark","raw":"火花"},{"type":"sfx","value":"Gunfight","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Squad 404! How are you holding up?!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Ange seems to have forgotten that 404 was never meant to fight pitched battles like this... (Coughs) Things aren't looking too good..."}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Hurry up and think of a solution with that devious neural cloud of yours, UMP45!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Even the most devious neural cloud can't shoot through 150mm of armor plating."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What about Ange's last resort?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"It's not time yet... Ange hasn't given the order...!"}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Griffin signals, 750m on the right flank!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Is it the Commander?!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"M4! 45! Do you copy?! The Commander and I are exchanging fire with the Military! "}]},{"spans":[{"text":"We'll delay them, so use this opportunity to pick your way through their scattered units! You MUST find Mastermind! Do you hear me?!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"416 and Gr G11, get on that tower up there and provide fire support! "}]},{"spans":[{"text":"M4! Come with me and 9! We're taking the shortest route!"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What do you mean shortest route, are you trying to commit suicide?!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"From what I can see, their tanks can't shoot at low angles! "}]},{"spans":[{"text":"Draw their fire away from us! If we move fast enough, we might have the ghost of a chance to do this!"}]}]},{"sprites":[{"prefab":"HK416","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Tsk! You're all insane! Gr G11, get up, we're moving!"}]}]},{"sprites":[{"prefab":"G11","expression":2,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sparkOff","raw":"关闭火花"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"R...right away!"}]}]}]}
