"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Then what do we do? Should we just watch?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I'll get in touch with the Commander... Before that, let's run a few scenario simulations.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Scenario simulations?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We should predict all the possible conflicts and outcomes that could happen. That'll give the Commander more information to work with when making judgment calls.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Wow, you've really thought of everything, haven't you..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Eh, it's no