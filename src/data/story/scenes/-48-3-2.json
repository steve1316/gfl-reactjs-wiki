{"name":"-48-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"356","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In the Berlin safe house."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Ugh... Hm?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow wakes up from her delirium, only to find the Commander sitting there with a stony expression."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...What is it? You all look positively murderous."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's something I need to ask you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow looks at the Commander with narrowed eyes. Her gaze drifts from captor to captor and finally rests on M4."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Of course. No problem at all. Let me guess... "}]},{"spans":[{"text":"You want to know the cargo's whereabouts, am I right?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow beats the Commander to voicing their question."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You read my mind."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"It's practically a fait accompli. "}]},{"spans":[{"text":"Robin, I can sense your restlessness."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I am indeed very restless... "}]},{"spans":[{"text":"So this is not the best time to try my patience."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You'd better cooperate, or else—"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Sure."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I said I'd cooperate."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow is amused by everyone's surprise. Even the Commander did not expect her to be so compliant."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Nimogen saved my life, so I'll return the favor once. "}]},{"spans":[{"text":"Then we'll be even, alright?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 remains silent and makes no response."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I refuse to believe you have the decency to do that."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Hey, if I don't say anything, you guys beat the living crap out of me. Now that I'm actually spilling, you doubt me. "}]},{"spans":[{"text":"So should I tell you or not?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Don't get cheeky."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gazes at Morridow in silent deliberation."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No strings attached?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"None whatsoever. I told you, I'm returning a favor. "}]},{"spans":[{"text":"If you really want to know, I'm actually hoping you'd teach that Nyto who tried to kill me a good lesson."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"That would be my pleasure."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I've decided to trust you. "}]},{"spans":[{"text":"Just as you can decide to trust me."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"So what will it be, Robin?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander stares at Morridow's face unblinkingly. "}]},{"spans":[{"text":"Morridow studies their expression and slowly breaks into a smile."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I know you're a clever one."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
