{"name":"-74-A-14","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"41","raw":"BIN"},{"type":"bgm","value":"BGM_ev2412_2064","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Mainz Power Station."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0%%range=4","raw":"controll_shake"},{"type":"sfx","value":"AVG_Bomber_Napalm","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! "}]},{"spans":[{"text":"Raging flames consume the station, scattering sparks through the air. "}]},{"spans":[{"text":"Once Falk finishes adjusting the equipment, Shadowless strides forward to begin her report."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=202412_LIVE%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"41","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{"Position":"0,-350","Scale":"1.4"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"This is Shadowless from DDR2. I am standing in front of the Mainz District Power Station.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"About an hour ago, a sudden explosion erupted here. The entire Mainz District is now without power.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"According to staff on site, they were working overtime inside due to energy shortages wen the accident occurred. This has led to devastating casualties...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Preliminary figures show 78 dead, 237 injured, with many still missing.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Nearby residents report that because communications are down, despite immediately sending representatives to the police and fire departments to request aid, no response has come. All staff seem to be already dispatched.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"As of this broadcast, not a single police officer, firefighter, or medic has arrived at the scene.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Help is needed here!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"},{"type":"backgroundMove","value":"%%pivot_x=0.47%%pivot_y=0.55%%scale=2%%duration=0.7%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The camera pushes in, zooming in on the burning structure behind Shadowless."}]}]},{"sprites":[],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.6%%pivot_y=0.55%%scale=2%%duration=2%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_lifttable","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A window frame, warped and twisted by the heat, breaks loose and falls from the upper floors..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0.7%%","raw":"bg_move"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{"Position":"0,-350","Scale":"1.4"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Additionally, surviving station workers confirm that the explosion was not caused by an air raid, but originated from the underground pipelines.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The cause remains unclear. We will continue to follow this story.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Falk nods and shuts off the camera."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"41","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shadowless exhales in relief. Just as she is about to walk back toward Falk, her eyes catch a man standing not far away. "}]},{"spans":[{"text":"A face both familiar and estranged."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{"Scale":"0.9"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Shadowless","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Falk, can you please give me a minute?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Falk gives her a glance. He asks no questions and quietly steps aside with the camera. "}]},{"spans":[{"text":"He stops at a spot that's close enough to keep an eye on her, but out of earshot. "}]},{"spans":[{"text":"The man nearby slowly approaches."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...It's been a long time, Shadow."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...Why are you here?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I was passing by... and just so happened to see you. "}]},{"spans":[{"text":"I really didn't expect to see you here."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...I'm surprised too, Kevin. "}]},{"spans":[{"text":"Say, do you think Frankfurt, having been razed to the ground, can ever be rebuilt?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"It's got to be rebuilt. There will always be someone to rebuild."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...Kevin, you're really not suited to be a special agent."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Why not?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Because you're lying. "}]},{"spans":[{"text":"You didn't just \"happen to see me\". You came looking for me."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Maybe you just know me too well."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Or maybe it's because our family has produced two Stasi agents."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"About Light... I still owe you an apology."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He looks away, his face laden with guilt."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...It was his choice. "}]},{"spans":[{"text":"From the moment our mother died, I knew he would take that path. "}]},{"spans":[{"text":"Just like you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"If you came only to say this, then forget it."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I asked around DDR2. They said you're working... as a war reporter now. "}]},{"spans":[{"text":"I thought, given the situation, I might find you here."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Because a power station is an obvious target."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"True, everyone knows that. "}]},{"spans":[{"text":"Yet so many still chose to stay and work here. "}]},{"spans":[{"text":"Already 78 dead, 237 wounded... "}]},{"spans":[{"text":"Most of them will die from the lack of rescue. "}]},{"spans":[{"text":"They'll die at their posts."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Is this what the big shots... the ones in power... want? "}]},{"spans":[{"text":"Countless civilians giving their lives for the whims of a few."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...To them, these are just numbers. Necessary sacrifices. "}]},{"spans":[{"text":"Right now, they're more concerned about... winning the power struggle and purging their enemies..."}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{"Scale":"0.9"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"While the people truly in danger—their so-called voters... "}]},{"spans":[{"text":"...Get absolutely nothing."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I'm sorry."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I'm not blaming you. "}]},{"spans":[{"text":"The ones I'd blame wouldn't care about my words anyway."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I know. But all I can say is sorry. "}]},{"spans":[{"text":"Shadow, it feels like I've only ever said sorry to you. And still, I have nothing else to give other than my apologies."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"When we were kids, Light and I dreamed of being legends like your father Ulrig—agents who died for their ideals. "}]},{"spans":[{"text":"But this era... this era has no place for idealists anymore..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"I know... I know that better than anyone. "}]},{"spans":[{"text":"This is the twilight age. People mouth empty words that even they themselves no longer believe."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"J","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Do you think I've chosen the wrong path?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Kevin... What's the point in asking me that now?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"What about you? Are you walking a path that you chose yourself?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"As a child born of a Stasi agent, I was watched from birth. "}]},{"spans":[{"text":"When I was young, I swore that one day I'd break free, that I would be the one watching others instead."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Later, I realized how ridiculous that was. "}]},{"spans":[{"text":"Media is just a job. "}]},{"spans":[{"text":"Most jobs in this world are just jobs. "}]},{"spans":[{"text":"Only as children did we have the delusion that some jobs could change the world."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Maybe from the moment we were born, we were destined never to be heroes who reshape the world."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"But since we live, we've got to do something. "}]},{"spans":[{"text":"Something that we feel compelled to do. Something that has to be done."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Something that has to be done... "}]},{"spans":[{"text":"What is that for you?"}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":8,"side":"left","tags":{"Scale":"0.9"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...What I'm doing now."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Command room. "}]},{"spans":[{"text":"A call comes through an encrypted comms channel."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"It's me, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I received the possible locations of the Iaso's Boxes. Thank you. "}]},{"spans":[{"text":"I'll dispatch a team."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I only passed you the information. You're the one who's doing the real work.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What matters is you thought to pass it to me. "}]},{"spans":[{"text":"I'm sure the Stasi has its own missions."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I just thought... there are some things that only you would be willing to do.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Thank you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"No, thank YOU. After all, this is my country. My people.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...No, Agent J. "}]},{"spans":[{"text":"When they're in my sight, they're my people too."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Why?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Because this is something... that I absolutely have to do."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"It's something that has to be done?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, absolutely. "}]},{"spans":[{"text":"For a long time after I left the service, I'd forgotten why I first picked up a gun all those years ago. "}]},{"spans":[{"text":"I forgot the distant promise... that my past self had made. "}]},{"spans":[{"text":"But I once promised someone... "}]},{"spans":[{"text":"...To become a hero, to win the medals and the glory."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Who hasn't said silly things as a child? I once said I'd grow up to punish evil and defend the weak.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't think children's words are silly. "}]},{"spans":[{"text":"It's just that we still had ideals back then. "}]},{"spans":[{"text":"But now... everyone has forgotten their ideals. In the world of grown-ups, there is only interest."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So tell me—what else can I do? "}]},{"spans":[{"text":"If I can, I want to do more."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"You've changed, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You're not as cynical as you were in Berlin.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Why?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Because now I know what I truly want."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Is that so? I see.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If you still have the capacity, consider repairing roads or power stations.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The air raids and the Iaso's Boxes are both targeting such infrastructure.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I understand. Has the government deployed repair teams? How long will the repairs take?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"They've sent all available crews, but as you know, progress is poor.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"The bombing has crippled all transport in the city... Crews can only reach sites on foot.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And because of the \"Interim Regulations for Doll Security\", Frankfurt has very few Dolls available—most of them are probably on board the Elmo with you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":6,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I see."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Keyboard_Correct","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns on their tablet and looks through the teams currently on standby."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Have 404 locate the repair crews and dispatch nearby squads to assist."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the silent winter night, the frigid wind howls through the smoke of war."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"779","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Johannes Gutenberg University metro station, Frankfurt. "}]},{"spans":[{"text":"After a day of chaos, the people slumber deeply. "}]},{"spans":[{"text":"They lie huddled on makeshift bedding, their snores and muffled sobs rising and falling."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Nele, you should get some rest too."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Mm. I'll just check on the critical patients once more, then I'll rest."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing Nele's exhausted face, now lit with unwavering determination, Amaris recalls their first meeting. "}]},{"spans":[{"text":"It was just days ago."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Why, Nele?"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"813","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele does not answer. Instead, she holds out her hands. "}]},{"spans":[{"text":"After days of toil, they look dry and frail. Even after careful washing, stains linger in the lines of her palms and fingers."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"779","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"What's wrong with your hands?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Martha's last words scared me deeply."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"She was a witch who spewed all kinds of poison."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"But I'm not scared anymore. "}]},{"spans":[{"text":"I can now hear my own voice. I want to save lives, to help more people. "}]},{"spans":[{"text":"I know that walking this path, my hands will be stained with blood again and again."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris looks at Nele. In her eyes, there is only peace and joy."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"This is why I do it, Amaris. "}]},{"spans":[{"text":"Because I want to."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
