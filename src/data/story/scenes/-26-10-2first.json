{"name":"-26-10-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The final decision is to have everyone enter the building and set up defenses."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I do not think...this is safe."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The military will find us, but we'll be prepared."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"AK-12, we're all ready."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"AK-12! The military is coming towards the building. They must've discovered us!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's to be expected, but we don't have a choice. "}]},{"spans":[{"text":"At least, we fight together."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...Yeah!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"This is the first time we take the military's main force head-on..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"For Ange..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"And for ourselves. "}]},{"spans":[{"text":"AN-94, do you resent the choice I made?"}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I trust you, AK-12. "}]},{"spans":[{"text":"No matter what choices we make, in the end, it always comes down to luck. That is what you said."}]}]},{"sprites":[{"prefab":"AN94","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...That's true. "}]},{"spans":[{"text":"All we need...is a stroke of luck."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"安洁莉娅","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I had a dream. "}]},{"spans":[{"text":"A dream...where others died for me. "}]},{"spans":[{"text":"I know when I wake up, everything in my dream will come true. "}]},{"spans":[{"text":"But I must wake up. "}]},{"spans":[{"text":"This is something I...must face."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"openEyes","raw":"睁眼"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Yegor..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"You had very loyal subordinates. They fought to the bitter end, as all Tactical Dolls are expected to. "}]},{"spans":[{"text":"Naturally, their effort was futile against us."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"They... are they..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"I left some of them alive. My men are taking them apart downstairs. Some of the stuff in their neural clouds might be worth something. "}]},{"spans":[{"text":"As for you, I've just been waiting for you to wake up. That's all."}]}]},{"sprites":[{"prefab":"叶戈尔","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Got anything else to say? "}]},{"spans":[{"text":"Or are you waiting for more new toys to come to your rescue? Or have you rigged this building with explosives? "}]},{"spans":[{"text":"Sadly, I've searched it thoroughly beforehand. There's nothing here. "}]},{"spans":[{"text":"No reinforcements, no explosives, no Griffin-or-whatever T-Dolls."}]}]},{"sprites":[{"prefab":"叶戈尔","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Yes, that's the face. This is the moment I've been waiting for. "}]},{"spans":[{"text":"...Now, good night."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Reload","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunkill","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-InterrogationRoom","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"We are surprised you are still capable of such deception under these circumstances. "}]},{"spans":[{"text":"We have truly underestimated you, Griffin Commander. "}]},{"spans":[{"text":"We must administer a larger, but not fatal, dosage."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A Nyto takes out another syringe and injects the truth serum into my veins."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The effect starts kicking in quickly, but I can still resist it. I still have a bit of willpower...though I don't know if I'm already running on fumes..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Ange did not die, at least not in this battle. We saw her kill one of us with our very own eyes. "}]},{"spans":[{"text":"So tell us how she survived and with whom she has had dealings."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I will tell them everything that comes to mind. "}]},{"spans":[{"text":"The lies, the truth. Let them guess. "}]},{"spans":[{"text":"I know what they're really after. I also know the consequences of giving them what they want."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Humans are fragile contraptions that break down easily. "}]},{"spans":[{"text":"If you wish to leave this facility with your mind and body intact, value the chance you have been given and tell the truth."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That's why I need time...as well as all sorts of fantasies to counter the truth serum. "}]},{"spans":[{"text":"How many more times will Miss Ange die in my story? "}]},{"spans":[{"text":"At the very least, she has to keep dying till I can live... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
