{"name":"-31-2C1-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"169","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"sfx","value":"Alarm","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The streets in the immediate vicinity of the quarantine wall have become hell on earth."}]}]},{"sprites":[{"prefab":"NPC-PasserbyM","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Civilian","narrator":false,"pages":[{"spans":[{"text":"Ahhhhhhhh!"}]}]},{"sprites":[{"prefab":"NPC-PasserbyF","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Civilian","narrator":false,"pages":[{"spans":[{"text":"S-stay away from me! Help!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Garrison Soldier","narrator":false,"pages":[{"spans":[{"text":"Residents, evacuate to the nearest shelter immediately! Don't open the door until they stand down the alert! "}]},{"spans":[{"text":"Garrison of Gate E4 hailing Garrison HQ! ELIDs have invaded the city! We have entered combat! Requesting reinforcements!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"fadePoint","raw":"黑点1"}],"speaker":"Garrison Soldier","narrator":false,"pages":[{"spans":[{"text":"Please... E-even here?! Ahhhhh!!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"M4, AK-12, report! Answer me!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Well..."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange, we couldn't stop the rebels. They detonated the explosives. "}]},{"spans":[{"text":"The explosion wasn't particularly big, it just blew a hole in the quarantine wall, but even so, it's large enough that plugging the breach is not going to be easy."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Copy that. I understand.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What are you planning to do, Ange?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"They punched a hole through the wall...and at the worst possible time...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"With just half of Task Force DEFY, we're pretty much helpless under the circumstances. At a time like this...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"commsBox","raw":"通讯框"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"This is Lieutenant Dragović, Acting Commander of the Eastern Garrison.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"commsBox","raw":"通讯框"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Attention all garrison units - we have received reports that the quarantine wall has been destroyed by rebel forces not long ago.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"commsBox","raw":"通讯框"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Do not panic. Everyone heed my command and hold your ground!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That sounds like...the wounded officer we came across.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Ange, I have an idea."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Being a busybody again?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let her finish. What are you trying to say, M4?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"We coordinated with the officer of the local garrison while clearing the rebel forces. That's how we acquired our military IFF signals and comms frequency. "}]},{"spans":[{"text":"We alone can't stop the ELIDs, but if we work with the garrison troops..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I see, borrowing the strength of the local garrison is indeed a valid solution. "}]},{"spans":[{"text":"Patch me through. I'm gonna have a proper chat with that guy."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After making some small adjustments to the comms settings, Ange's digitally-distorted voice is transmitted through the channel."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You seem to be having some trouble, Lieutenant Dragović.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Who are you? Which unit are you from? Why do you have access to this channel?"}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You've met my subordinates before. You probably remember them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"...I see. "}]},{"spans":[{"text":"If it hadn't been for you, we'd have been completely crushed by the bastards. "}]},{"spans":[{"text":"No matter who you're with, I owe you one."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let's leave that for later. We're both short on time.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What's your current situation? How long can you last? When will your reinforcements arrive?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"It's chaos. My forces are putting their lives on the line to hold the upper wall, but the bottom has already been breached by the ELIDs..."}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Most of the troops on the wall, including me, don't actually have much combat experience. Our tactical teams have also been separated so it's difficult for us to mount an organized defense."}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Also, we haven't been able to contact HQ. There's been no response to our communications. I doubt we'll be getting any reinforcements at all."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Tsk... The worst possible scenario, huh...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Tell your subordinates to save their ammo and try their best to retreat into narrow passages or corridors.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Concentrate your fire and rebuild your defense line. Do that first to make sure you don't get overrun.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Understood... But if we draw back to within the wall, more ELIDs will force their way into the city..."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If you die here, no one will be left to stop the ELIDs.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"...Right, I'll have my forces fire at the infected creatures to give us cover while we safeguard our defense line."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Each minute you fight, you'll kill more ELIDs and give the citizens of Belgrade a better chance to survive.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Hold the wall and stay in touch. We'll find a way to give you support. Over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"AK-12, M4, you heard that?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"From now on, support the garrison troops in defending the wall and focus on helping isolated forces return to their garrison.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Our priority is to minimize their casualities and stop the ELIDs from entering the city. Hold out until reinforcements get here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"As always, you're the kind of person who enjoys surfing in a thunderstorm."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I'm not that stupid. Besides, we're doing ourselves a favor by helping these garrison troops.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"We'll find a way to withdraw to the safe zone once this is over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"But some ELIDs have already broken through the wall and into the city, and the Collapse contamination has also started seeping in thanks to the destruction of the purification tower and the storm. "}]},{"spans":[{"text":"If you don't want to take another radiation bath, I suggest you stay indoors. Just leave everything on the frontlines to M4 and me."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I know. With ELIDs crawling all over the place, running around like a headless chicken is suicide.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If there's only a single breach, it should be pretty easy to tell where the ELIDs are coming from...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...If everything goes well, we should be able to keep the damage to a minimum with the help of the garrison troops.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Question is, will everything actually go that well?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"To stir up waves in still waters... To turn bad things to our advantage... That's Task Force DEFY's mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Alright, focus on fighting. I have other things to sort out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...K, do you read me?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Why have you broken radio silence?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"The purification tower is screwed. "}]},{"spans":[{"text":"...Not that you'd care about that, I suppose."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Just get to the point.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"There are too many ELIDs and I don't have enough people, not to mention the oncoming storm. Time is short. I need you to send in more troops to lend me support near the wall."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I can't.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Why?!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Ahem...I just need them to round off the ELIDs; that's hardly an unreasonable request!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Perhaps I should seriously consider just how much you care about this mission."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Don't think too much. Just carry out your orders.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Care to listen to my suspicions about you?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Did these suspicions form over the last few seconds?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I believe I'm not obliged to listen, nor am I obliged to offer you any explanation—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"For example, maybe there's actually a secret agenda to this mission?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You're overthinking it, woman. That's not good for your health, mental or physical.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"As a Statesec agent, you simply have to do your job. That's the only thing you're good for.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh? And here I thought I was a renegade."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"All the more reason why you need me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...What do you—"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I have no wish to concern myself with what you have done or who you used to be. Those things mean nothing to me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You're nothing more than a tool, and right now I'm the only one who can tell where your loyalties lie.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I hope you can remember that. Now shut up.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Dammit, it's always like this. "}]},{"spans":[{"text":"He always says that everything is under his control, that he can provide all the support at his disposal, but when shit goes down, we're always on our own."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Disappointed?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I never had any hopes for reinforcements. There's nothing to be disappointed about."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Still, I must say...K actually has a point. Stopping the ELIDs has never been our job to begin with. We can still leave this mess if we want to.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Judging by the speed at which these ELIDs are swarming in, I'm afraid I can't say the same in another ten minutes. Your location won't be safe for long.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...It isn't time yet."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Abandoning the wall will make the rest of our operation even more difficult. At least hold out till AR-15 and AN-94 complete their objective."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So we're buying them time...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What's the situation?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1Mod","narrator":false,"pages":[{"spans":[{"text":"Order is gradually being restored, but things still aren't looking good.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1Mod","narrator":false,"pages":[{"spans":[{"text":"Almost all garrison outposts are in a state of emergency...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1Mod","narrator":false,"pages":[{"spans":[{"text":"From what I saw, these soldiers are practically panic-shooting, and their accuracy is...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"With this level of training, I'm afraid they won't last very long.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Also, I just eavesdropped on the comms of the local garrison.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It appears that neither the mobilization of backup forces nor the evacuation of civilians are going too well.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"The majority of them are youngsters who have never seen real combat. You can't expect them to be too capable. On top of that, the garrisons have been infiltrated. This must also be part of their plan."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Actually, the main reason why things have gone down so badly is because the rebels seized control of all automated heavy weapons beforehand.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1Mod","narrator":false,"pages":[{"spans":[{"text":"But they have all pretty much been destroyed in the previous battle...by us.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What else could we have done? We didn't have the luxury to spare the armored units and the tanks."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Besides, as long as we still have ammo and we make sure the ELIDs are only coming from one direction, then the situation isn't exactly beyond..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"169","raw":"BIN"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Despair often comes hand-in-hand with hope that is almost within reach."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"A second explosion on the quarantine wall thoroughly destroys the opportunity that I thought I had within my grasp."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Another explosion?! And the scale...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm investigating, but..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Too many people are trying to communicate simultaneously; coupled with the EM storm, the signals are getting all scrambled!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"M4, can you see the location of the explosion? Do you have visuals?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"There...there's a second opening on the wall! "}]},{"spans":[{"text":"I...I'm sending you the location!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"No way...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It could be a time-delayed bomb. That would explain why the first explosion was a lot smaller than expected. "}]},{"spans":[{"text":"The rebels probably planned to trigger the second explosion as the rescue teams and engineer corps rushed in to plug the first opening."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That hardly matters anymore. More importantly, if they're caught in between, then the garrison troops...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Holding our position here no longer serves any purpose. We must leave this place before we're attacked from both sides."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the quarantine wall."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Lieutenant Dragović, do you copy?! There's been another explosion!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"I know... ELIDs have already started appearing from behind! We're only holding a small section at the top of the wall..."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"As you can see, the situation has become even more precarious. There's no point in defending the wall at this point.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"For the sake of preserving your strength, I suggest you withdraw immediately.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"My subordinates will cover your evacuation. Please move in an organized manner and follow my plan...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"...We're not leaving."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"There's no time for you to hesitate. This is your only chance of escape. If you drag this on...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sad","raw":"BGM"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"I can see that the other teams are still doing everything they can to destroy the ELIDs. If we leave, they'll lose fire support and take the brunt of the attack. I can't just abandon them."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You want to drag your subordinates with you to hell?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"...You were right. Every ELID we kill will buy more time for the citizens of Belgrade."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Given that you survive!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Our orders are to defend this wall. This is our post. "}]},{"spans":[{"text":"Behind the wall is my hometown; behind the wall is my country and my people. I have to protect it. "}]},{"spans":[{"text":"The same...goes for my subordinates. We've all got family here."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Garrison Officer","narrator":false,"pages":[{"spans":[{"text":"Thank you very much for all the help you've given us. If it hadn't been for you, we wouldn't have made it this far. "}]},{"spans":[{"text":"We will stay behind to slow them down. Please withdraw as fast as you can."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Received.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Attention Task Force DEFY, we're withdrawing.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But those people...!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}},{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"No buts, M4. We're in combat. Our orders are absolute."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Rendezvous with me at the Belgrade safe house. We'll plan for our next step when we're there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't think. Just focus on executing my order.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"181","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Soldiers are all the same...be it Yegor or Dragović. "}]},{"spans":[{"text":"I wonder if it's a good thing or a bad thing to train people into such soldiers."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
