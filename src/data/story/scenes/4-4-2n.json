ans":[{"text":"No matter what weapons they fire at us, what strategies they use, what conspiracy they have cooking on the stove..."}]},{"spans":[{"text":"So long as they cause destruction... So long as they wreak havoc..."}]},{"spans":[{"text":"I will definitely make them pay!"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Please watch me, AR-15..."}]},{"spans":[{"text":"Our new play is about to begin."}]}]}]}
