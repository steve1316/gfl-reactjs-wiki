xpression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"RO..."}]},{"spans":[{"text":"What if...we ARE the targets?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"What are you talking about? If that were the case, we'd have been dead long ago."}]},{"spans":[{"text":"And as you see, their aim is completely random. Only one shell hit 92..."}]},{"spans":[{"text":"..."}]},{"spans":[{"text":"Or can it be..."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"RO, we're also targets being used to test their artillery."}]},{"spans":[{"text":"The enemy ringleader has probably discovered us right from the start, and is only toying with us...or messing with us..."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"You...You've got to be joking..."}]},{"spans":[{"text":"Then the next shell will be aimed at..."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"...!"}]},{"spans":[{"text":"RO, find cover!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"bac