":[{"text":"Besides, I HAVE considered my way of escape..."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Hey, RO! You still kicking?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Yeah... Everyone is fine, too. We're all safe."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Haha, it's Makarov! You're finally here!"}]},{"spans":[{"text":"Oh... Have you been crying? Your eyes are all red..."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"...I rushed here from HQ during the night. I'm just sleep-deprived."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"If you keep asking stupid questions, I'm gonna plant all your dummies in the ground."}]},{"spans":[{"text":"Anyway, I've called in troops to give you support. You'll make it out before they fire the next round."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Umm... Well... Haha..."}]},{"spans":[{"text":"In any case, we're finally back together tonight!"}]}]},{"sprites":[{"prefab":"92type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type92","narrator":false,"pages":[{"spans":[{"text":"Indeed. The mission is accomplished, too."}]},{"spans":[{"text":"Though...we'll have to part again soon..."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"Huh? Why is that?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Don't you remember, Sten?"}]},{"spans":[{"text":"This team is assembled temporarily only for this operation."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"Oh, right... And we already have Document 36..."}]},{"spans":[{"text":"Even though Sangvis Ferri has completely destroyed the city..."}]}]},{"sprites":[{"prefab":"92type","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type92","narrator":false,"pages":[{"spans":[{"text":"They won't be cocky for long. Makarov will bring word of this back to HQ."}]},{"spans":[{"text":"We will come up with something - against that large mortar, as well as the Sangvis ringleader hiding behind it."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"Yeah. All of us have gone through so much and learned a lot from this operation."}]},{"spans":[{"text":"Even if we go our separate ways, I will never forget..."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Don't be so melodramatic, Sten. It's not like we'll never see each other 