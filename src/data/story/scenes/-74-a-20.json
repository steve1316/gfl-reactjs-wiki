{"name":"-74-A-20","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"819","raw":"BIN"},{"type":"bgm","value":"BGM_ev2412_PrinceIgor","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Autobahn 661. "}]},{"spans":[{"text":"After the Dolls' hard work, the road is now mostly open, with wrecked cars pushed to the roadside. "}]},{"spans":[{"text":"On the withered grassland to the west, human corpses killed by the bombing are carried out by the Dolls and laid neatly in two rows, awaiting later collection."}]}]},{"sprites":[{"prefab":"G41","expression":0,"side":"left","tags":{"Position":"-180,200"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Gr G41","narrator":false,"pages":[{"spans":[{"text":"One, two, three—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls push together, straining against a twisted SUV."}]}]},{"sprites":[{"prefab":"G41","expression":0,"side":"left","tags":{"Position":"-180,200"}}],"ops":[],"speaker":"Gr G41","narrator":false,"pages":[{"spans":[{"text":"One more time! One, two, three—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0%%range=2","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Scrrrk— The vehicle scrapes along the surface of the road and finally shifts aside. At this point, the major obstacles are gone, but the road is still littered with sharp debris, not yet fit for passage."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Road maintenance vehicles arriving in one minute; on-site squads prepare to clear the way.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"G41","expression":0,"side":"left","tags":{"Position":"-180,200"}}],"ops":[],"speaker":"Gr G41","narrator":false,"pages":[{"spans":[{"text":"Roger!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls form a line and move toward the Elmo."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"sfx","value":"AVG_21Winter_Water_Tap","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pshhh— Soon, a high-pressure cleaning truck arrives, spraying torrents that blast the remaining rubble off to the sides of the road."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander observes from the roadside, then suddenly presses the comms button."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hold the waterworks. Have four Dolls bring a waterproof sheeting."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II quickly arrives with three others, carrying a huge roll of tarp."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Cover them."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The four Dolls pull it open, spreading it wide like a vast banner, and carefully lay it over the bodies at the roadside."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Water_Tap","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The water truck resumes, its spray splattering mud onto the tarp with sharp patters."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_ship_horn","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Honk— The driver sounds the horn, like a farewell salute to the fallen."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, drones report the road ahead is clear and passable.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Good. Let's move out."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AirRaidWarning","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Woo— The city alarm starts blaring all of a sudden. The Commander's face darkens."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"RO635, shut down the Elmo's radar and deploy the stealth canopy! "}]},{"spans":[{"text":"AR-15, keep a close eye on all the patients in the hall, make sure no one moves!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Understood, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Roger! Shutting down radar, activating EM shielding, activating IR masking.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But the canopy... Commander, we should evacuate, staying here is riskier.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who said we're staying put? "}]},{"spans":[{"text":"Bring out the auxiliary vehicles."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You mean, stretch the canopy between the front and rear vehicles?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Yes... we can sync the auxiliary vehicles to the Elmo's system, move as one, and use drones to extend visibility.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Understood, I'll assign crews right away.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll take point. I'll lead the Elmo through."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's too dangerous, Commander! You must remain on board the Elmo.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...And if EM jamming cripples your systems? The lead vehicle is the Elmo's eyes and compass—it cannot fail."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But your safety is the highest priority!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No time. Execute the order."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"background","value":"846","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whooshhh— A bluish-grey canopy of radar-absorbent fabric unfurls, draping over the Elmo, pulled taut at both ends by two vehicles. "}]},{"spans":[{"text":"Palm-sized drones buzz alongside, feeding RO635 a full perimeter view."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The air-raid sirens cut off, plunging the city into a suffocating silence. The Commander grips the wheel, cruising down the empty highway. RO635 has remote control, but the Commander is ready to act. "}]},{"spans":[{"text":"The wind rustles the canopy, outlining the Elmo beneath the fabric."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still no fighter engines in the sky. The Commander's unease only deepens as they glance constantly in the mirror at the sky above Frankfurt."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, white streaks cross the skyline."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Missiles?! "}]},{"spans":[{"text":"Good, at least it's not bombers..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander breathes a sigh of relief. The chance of the Elmo being struck seems far lower now."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, not good. Better if nothing came at all."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But speculation creeps in—what are the targets? How many casualties? "}]},{"spans":[{"text":"Memories of the rescue scenes during the last few days, of tears and blood, weigh heavily in the Commander's chest."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The world blurs. The sounds around the Commander grow increasingly muffled..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The world tilts, fades, and is plunged in endless black..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"background","value":"4","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Outside the barracks, the Commander pretends to stroll by idly, eyes searching for a familiar figure."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Winter_Night","raw":"BGM"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She appears at last, her stride brisk, her smile radiant."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Kid, what brings you here out of the blue?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Oh, nothing big. I was on leave and remembered it'd be your birthday soon, so I bought you something."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"You thought of that while you were on leave two months ago?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Don't make a fuss. Just take it."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Haha, let me guess. "}]},{"spans":[{"text":"Canned beef?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You think I'm you? I don't give tin cans as gifts."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Then..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Oh, forget it. You'll never guess!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shoves a small box into Marina's hands. "}]},{"spans":[{"text":"She gently unties the ribbon and opens the lid—"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"A lily necklace!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the box lay a silver pendant, carved in the shape of a lily. She lifts it out and studies it closely."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"You remembered..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've got a good memory. Besides, you've said it more than once. "}]},{"spans":[{"text":"How lilies are your favorite, how they fill you with peace and hope."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"...Thank you, kid."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's nothing. If conditions were better, I'd even get you a real specimen! "}]},{"spans":[{"text":"Or an artificial replica that's almost like the real deal."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Normally, Marina would've flicked their forehead with a laugh. "}]},{"spans":[{"text":"But she only stroked the necklace silently, her eyes glistening faintly."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Seriously? A necklace makes you cry? Is it really such a big deal?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Lily... It's been so long... "}]},{"spans":[{"text":"Kid, this wasn't cheap, was it? You blew your wages just like that?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I've got no family to spend it on anyway."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Back when my mother was still alive, she'd place lilies on the dining table. "}]},{"spans":[{"text":"Only once a month—on payday. "}]},{"spans":[{"text":"When war broke out, the factory where she worked went under, and she never bought them again."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"By the time I started making a living, lilies had pretty much vanished from the world."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"They're just flowers. If you like them so much, I'll get you some next time I go on leave. "}]},{"spans":[{"text":"If you can't keep them at the barracks, put them in your home, they'll be the first thing you smell when you walk through the door!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Marina hands the necklace back to the Commander."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Help me put it on, Kid."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She turns around. The Commander carefully brushes her hair aside and drapes the necklace around her neck."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"...Go home, kid."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Home? I've got no family. What home?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"No family? Then become someone's family. "}]},{"spans":[{"text":"That's why I enlisted—so that kids like you... can live your life in peace."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Stop treating me like a kid!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Then call me sister. "}]},{"spans":[{"text":"You've got no family, and neither do I. "}]},{"spans":[{"text":"But here, we're family."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Like hell I'd call you sister!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The young Commander awkwardly fastens the clasp, but she catches their hand."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"...I hate war. "}]},{"spans":[{"text":"More than anyone. "}]},{"spans":[{"text":"It took my family, my friends, my mentors. "}]},{"spans":[{"text":"It will take more still. "}]},{"spans":[{"text":"But I must fight."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"For the Gold Star medal?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"...Maybe. "}]},{"spans":[{"text":"The requirements are harsh. I may never earn it... "}]},{"spans":[{"text":"But if I can keep more kids like you alive, that's enough."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How harsh? If you can't get it, just go home. "}]},{"spans":[{"text":"I'll get it myself."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Marina laughs aloud as she turns back around."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Hahahahaha, that's the kid I know. The bravest Soviet. "}]},{"spans":[{"text":"Forever my hero!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Don't get sappy."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"If I can't win that medal, I'm sure you'll win it for me... "}]},{"spans":[{"text":"In my heart... "}]},{"spans":[{"text":"You will become..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Heart_Monitor1","raw":"SE1"},{"type":"background","value":"160","raw":"BIN"},{"type":"openEyes","raw":"睁眼"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep... Beep... The monitor hums in a steady rhythm. "}]},{"spans":[{"text":"The warmth of sunlight still seems to linger on their fingers and cheeks. The Commander's eyes open, but the unexpected brush of golden sunset leaves them momentarily dazed."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Oh, Commander! You're awake!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The doctor says it's just exhaustion, nothing else serious. Do you feel any other discomfort?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hang on... How long have I slept?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"About an hour. "}]},{"spans":[{"text":"Don't worry, the supplies aren't fully loaded yet, and it's going to take a while to refuel the Elmo. "}]},{"spans":[{"text":"But..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 bows her head and is just about to speak, when a doctor in a white coat sweeps in like a gust of wind, followed by a crowd."}]}]},{"sprites":[],"ops":[],"speaker":"Director Brücher","narrator":false,"pages":[{"spans":[{"text":"I'm Brücher, Director of Mannheim People's Hospital. Commander, thank you for setting up the temporary medical communication platform; it has helped us tremendously!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Director Brücher shakes the Commander's hand firmly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Uh, thank you... "}]},{"spans":[{"text":"But I need to go. I'm needed in Frankfurt for a lot of things."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander starts pulling at the IV line."}]}]},{"sprites":[],"ops":[],"speaker":"Director Brücher","narrator":false,"pages":[{"spans":[{"text":"Don't rush. The medical supplies you require are being prepared; they'll be delivered soon. I promise we won't cause you any delay."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander glances at RO635, who nods, confirming Director Brücher's words."}]}]},{"sprites":[],"ops":[],"speaker":"Director Brücher","narrator":false,"pages":[{"spans":[{"text":"As for St. Vincent's... I'm very sorry. Losing Fred is a loss to us all..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander cannot believe their ears."}]}]},{"sprites":[],"ops":[],"speaker":"Director Brücher","narrator":false,"pages":[{"spans":[{"text":"An hour ago, enemy missiles struck the Children's Hospital of Mainz and St. Vinzenz Hospital..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A crushing sense of absurdity hits the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Impossible! I haven't transferred the second group of patients yet! He's still waiting for our aid!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Px4 Storm is offline... "}]},{"spans":[{"text":"The Dolls stationed at other hospitals also confirmed it—St. Vinzenz Hospital was hit and reduced to rubble. "}]},{"spans":[{"text":"The enemy has launched multiple missile strikes today; casualties in Frankfurt may exceed 2,000..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander tears out the IV line and springs to their feet—only to stagger from dizziness. SOP-II and RO635 rush forward to steady them."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Commander! You haven't fully recovered yet!"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We return to Frankfurt. Now!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"RO!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I'll make the preparations. SOP-II, keep the Commander safe."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But... Alright..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"},{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 leaves. SOP-II props the Commander up as they slowly head outside."}]}]},{"sprites":[],"ops":[],"speaker":"Director Brücher","narrator":false,"pages":[{"spans":[{"text":"Commander, you're not German. You don't serve in any government office. Why are you doing all this?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander freezes in place."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"4","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"},{"type":"flashback","raw":"回忆"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're just an ordinary soldier. Why are you doing this?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Does it matter why?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It matters. I want to know."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"What's wrong with wanting more medals on my chest?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're lying."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Since those lofty people don't care about civilian lives, then I will care. "}]},{"spans":[{"text":"That is why a soldier picks up a gun."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"160","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If no one cares for the civilians, someone has to stand up and do something. "}]},{"spans":[{"text":"That is the reason I pick up a gun."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Alarm_Distance","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"764","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside the ruins of St. Vinzenz Hospital, fire trucks extinguish the flames and raise the floodlights. "}]},{"spans":[{"text":"Civilians form long lines, clearing the rubble by hand. Each time a body is found, someone steps forward to carry it away."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander... "}]},{"spans":[{"text":"This is Px4 Storm's neural core. "}]},{"spans":[{"text":"And this is the old director's work badge."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the harsh white light, the Commander peers at the badge, bloodstained and thick with dust."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Also, the 15 patients we sent to the quarantine ward... they... all..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's legs feel soft as dough; they sink slowly onto the rubble."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The farewell from this morning still echoes in their ears, but now there is only rubble, hundreds of corpses... "}]},{"spans":[{"text":"In the space between one sunrise and sunset, everything has changed."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm fine, RO. "}]},{"spans":[{"text":"In a moment, we'll bring supplies to the other hospitals... "}]},{"spans":[{"text":"Just give me a minute..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"276","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Fred Erdrich","narrator":false,"pages":[{"spans":[{"text":"Fred Erdrich, former army medic of the 1st Armored Division, Nationale Volksarmee of the German Democratic Republic, at your service. Thank you for your aid!"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The badge and the neural core. The Commander cradles them both in their palms. Tears quietly blur their vision."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
