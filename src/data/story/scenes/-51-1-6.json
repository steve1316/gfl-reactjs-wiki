{"name":"-51-1-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"gunCGlake","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Outside Paradeus' underground base on the outskirts of Berlin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16A1 leans down to inspect the Nyto's corpse lying on the ground. She raises an eyebrow at what she sees."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Jet_Passby","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vrooooom... "}]},{"spans":[{"text":"The familiar rumble announces her partner's timely return. Beak swings herself off her bike briskly."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"She got away."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Doesn't matter."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 shakes her head and gets to her feet."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Her attacks were very peculiar. Havier's intel failed to mention that."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"I never expected decent intel from people whose intel system is about as secure as a sieve. "}]},{"spans":[{"text":"I stayed on the chase for quite a while and only lost her when she started messing around with my navigation system."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...They have even more tricks up their sleeve than we imagined."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"So have you figured out what they're here for?"}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I took a look around inside and found a lot more corpses than stated in the report. "}]},{"spans":[{"text":"If I'm not mistaken, this place might have been used as some sort of \"petri dish\"."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"So I'm actually stepping on countless dead specimens?! Eeeep!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Notify the Western Group of Forces and ask for reinforcements. She couldn't have gone far. "}