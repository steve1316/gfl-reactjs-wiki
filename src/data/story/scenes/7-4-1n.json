{"name":"7-4-1N","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"I've never heard of her before, Negev. "}]},{"spans":[{"text":"Is there really such a Ringleader at Sangvis Ferri? You sure you're not just making this up?"}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"You've been in rehab for too long, Jericho. S.F. never stopped developing new Ringleaders. "}]},{"spans":[{"text":"And this one... "}]},{"spans":[{"text":"This particular one...is the most powerful we've seen so far..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"55","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Well? Hiding from me? "}]},{"spans":[{"text":"Do you dread seeing me so badly? "}]},{"spans":[{"text":"Am I...really that scary?"}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Commander, direct confrontation is imminent. I suggest engaging her and wearing her down. "}]},{"spans":[{"text":"Then I'll lead my squad around to the back and retrieve our target. Be ready to..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Are you ready?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","value":"4","raw":"黑屏1"},{"type":"background","value":"9","raw":"BIN"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","value":"4","raw":"黑屏2"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"This is your first mission as a team leader, right? Do you really have to do this?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Yes. "}]},{"spans":[{"text":"One day..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"10","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Watch me, Jericho. "}]},{"spans":[{"text":"I will definitely survive this and tell you all about this victory... "}]},{"spans":[{"text":"Our bloodline will remember this night with pride. Give me your blessing."}]}]}]}
