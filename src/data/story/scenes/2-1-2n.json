{"name":"2-1-2N","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"background","value":"3","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin troops arrived at a base."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Beautifully done, Boss. Now let me discuss our next step with the PIC of this mission."}]},{"spans":[{"text":"1911, do you copy?"}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"You've come way ahead of time. Looks like the commander can't wait to see me."}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Oh, please. I need to put someone here. Any suggestions?"}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"This base is used mainly for recon work. Best leave it to a handgun T-Doll."}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"A handgun, huh. Other than you, who else is up to the job..."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"Let me do it, Miss Thompson! I'll do even better than 1911!"}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"That's some nice verve you've got there. Griffin needs enthusiastic T-Dolls like you."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"Humph. I'll take every chance to prove that I'm better than a certain old hag!"}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"I heard that, M9..."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Anyway, I'm leaving scouting duties to you, M9. Now, a T-Doll to guard you..."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"That won't be necessary. We're understaffed enough as it is, right?"}]},{"spans":[{"text":"I'll be fine on my own if it's just scouting. Don't underestimate my skill in making great escapes."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Don't try too hard to be brave, M9. The battlefield is unpredictable."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"I've fought a bunch of Sangvis with the commander. Don't worry about me."}]}]},{"sprites":[{"prefab":"M9","expression":0,"side":"left","tags":{}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"All right. Be careful then. Let's keep going."}]}]}]}
