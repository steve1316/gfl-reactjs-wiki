"spritePosition":"0,25"}},{"prefab":"LAMG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"LAMG","narrator":false,"pages":[{"spans":[{"text":"The truth?"}]}]},{"sprites":[{"prefab":"LAMG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"LAMG","narrator":false,"pages":[{"spans":[{"text":"What kind of—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"LAMG is keenly aware that this is a subject that Ange has never taken the initiative to bring up, and this may be an important opportunity to understand her better. "}]},{"spans":[{"text":"She wants to ask more questions, but Ange interrupts her by raising a hand. "}]},{"spans":[{"text":"She looks into the distance at the slowly rising smoke and finally gives the order to attack."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":10,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Send them out. Coordinate with the teams fighting on the flanks and attack the target from behind."}]}]},{"sprites":[{"prefab":"LAMG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"LAMG","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"LAMG jumps out of the bush with excitement, and then she stops abruptly."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,25"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What's the problem?"}]}]},{"sprites":[{"prefab":"LAMG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"LAMG","narrator":false,"pages":[{"spans":[{"text":"Commander, can we continue the conversation when I come back?"}]}]},{"sprites":[{"pref