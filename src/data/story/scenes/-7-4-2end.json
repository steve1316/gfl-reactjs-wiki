lian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I'm not entirely sure, but she...does seem to have an unusual interest in M4A1."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...Lyco."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Hmm?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"The girl...is doing this because of Lycoris."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"...Lycoris?"}]}]},{"sprites":[{"prefab":"帕斯卡","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"She...wants to find answers... "}]},{"spans":[{"text":"For her father."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":