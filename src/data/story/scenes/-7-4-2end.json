{"name":"-7-4-2End","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"CG4N","raw":"BIN"},{"type":"spark","raw":"火花"},{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Entering the final stage of the battle against Ouroboros."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"I don't dislike people who struggle to their dying breath. After all, your futile resistance is my source of happiness. "}]},{"spans":[{"text":"Sadly...it looks like you've reached your limit, SR-3MP."}]}]},{"sprites":[{"prefab":"SR3MP","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"SR-3MP","narrator":false,"pages":[{"spans":[{"text":"Oh dear...it does seem so... "}]},{"spans":[{"text":"After all, we don't really...have many T-Dolls left..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"Still fishing for compliments before you die?"}]}]},{"sprites":[{"prefab":"WeaverElite","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"But really sorry to tell you that everything you do is for naught. "}]},{"spans":[{"text":"No matter how many units you destroy, it won't affect the overall outcome."}]}]},{"sprites":[{"prefab":"SR3MP","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"SR-3MP","narrator":false,"pages":[{"spans":[{"text":"That doesn't matter... After all, my objective isn't to defeat you... "}]},{"spans":[{"text":"I only have to hang on...until she makes it here..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 appears with the sound of footsteps."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Vikhr... "}]},{"spans":[{"text":"As the commander, I will lower the curtains for the battle tonight in person."}]}]},{"sprites":[{"prefab":"SR3MP","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"SR-3MP","narrator":false,"pages":[{"spans":[{"text":"Such an eyesore you are, M4A1... "}]},{"spans":[{"text":"It's precisely because you're always stealing the show that I don't like you... "}]},{"spans":[{"text":"But...seeing that M99 got out safely..."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"(Smiles) ...I apologize. "}]},{"spans":[{"text":"This will be the last time...I interrupt..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"M4A1, you actually..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Do you have to be so surprised, Ouroboros? "}]},{"spans":[{"text":"I thought you've been dying to see me? I just saved you the steps in between."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"What a party pooper. "}]},{"spans":[{"text":"I thought you could've come up with some more interesting tricks. Turns out it's just gonna be a gladiators' fight..."}]}]},{"sprites":[{"prefab":"WeaverElite","expression":