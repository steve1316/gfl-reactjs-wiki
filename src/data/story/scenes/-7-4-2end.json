":[{"text":"Objectively speaking, even though my location and condition make me the easier rescue target... "}]},{"spans":[{"text":"I still think... "}]},{"spans":[{"text":"Your life is worth more than ours..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"M4A1 tries her best to muster a smile."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That's exactly why...I must die with dignity..."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4A1... But you'll really be gone..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"As long as someone remembers us, we won't truly die... "}]},{"spans":[{"text":"So...please return...with your neural cloud... "}]},{"spans":[{"text":"And tell everyone of what happened tonight... "}]},{"spans":[{"text":"Tell them... "}]},{"spans":[{"text":"We...won..."}]}]},{"sprites":[{"prefab":"M99","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M99","narrator":false,"pages":[{"spans":[{"text":"M4A1... "}]},{"spans":[{"text":"I will bring it back... "}]},{"spans":[{"text":"I will tell everyone...everything that's happened here... "}]},{"spans":[{"text":"So... "}]},{"spans":[{"text":"So...please..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click."}]}]},{"sprites":[],"ops":[],"speaker":n