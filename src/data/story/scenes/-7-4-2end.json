xt":"Why does that...matter?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"You just asked me what's wrong with my neural cloud. "}]},{"spans":[{"text":"Well, here's the problem. I only want to do what I want. "}]},{"spans":[{"text":"So strictly speaking, I...am more like a Sangvis Doll than any of you."}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"And what do YOU know...about Sangvis Ferri...?"}]}]},{"sprites":[{"prefab":"建筑师","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"More than you do, Ouroboros. "}]},{"spans":[{"text":"Have you heard of... "}]},{"spans":[{"text":"The name...Lycoris?"}]}]},{"sprites":[{"prefab":"衔尾蛇","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Ouroboros","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"What's so important...about this name?"}]}]},{"sprites":[{"prefab":"建筑师","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Let me tell you, Ouroboros... "}]},{"spans":[{"text":"So long as this name still exists... "}]},{"spans":[{"text":"We...won't achieve true freedom..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Operation Cube"}]},{"spans":[{"text":": Blindfold Theorem - END"}]}]}]}
