{"name":"-51-2-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_Jet_Passby","raw":"SE1"},{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On board Schweinsteiger's private jet, Berlin airspace."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"273","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Stasi Liaison","narrator":false,"pages":[{"spans":[{"text":"...Emergency report. There are major outbreaks of violence on Preußische Straße and the locality of Wedding.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So far, the number of injured is confirmed to be at around 20.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"He turns off the transmission, and there is an imperceptible shift in his expression."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"General, we will arrive at the capital within an hour."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"General?"}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"I heard you. Leave me, I need some personal space."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Bodyguard","narrator":false,"pages":[{"spans":[{"text":"Yes, sir."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bodyguard respectfully closes the cabin door, leaving Schweinsteiger alone inside his luxurious cabin."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"To think you'd be so impulsive... "}]},{"spans":[{"text":"You've gotten old, Oberstein."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger shakes his head and chuckles sardonically before calling up Romy."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Has it been taken care of?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Everything is going according to plan.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We are steadily erasing the traces in Berlin.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"I'm not just talking about internal business. "}]},{"spans":[{"text":"You know what I mean."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Yes. We're also trimming back the tentacles from the outside.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Well done... However, I sometimes wonder, were we too radical before? "}]},{"spans":[{"text":"After the \"Fireworks\" blossomed, the tension in Moscow seems to have spread to Frankfurt."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Rest assured, no matter what decision you make, we will always have the advantage.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In a war like this, information is power.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"And now, all this information is at your disposal.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"You should head back to the capital once you've dealt with Berlin."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Yes, sir.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"No matter how brightly the flames of anger burn, they will cool one day... "}]},{"spans":[{"text":"If he is unwilling to make a dignified exit, then we shall spare his dignity for him."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger adjusts his hat, coughs twice, then slowly walks up to his sofa and reaches out to pick up several roses from the coffee table."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They are all of different colors—black, red and yellow, all stuck into a vase, their petals still coated with drops of water. "}]},{"spans":[{"text":"Their vibrant colors are like a flag fluttering high in the air."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger pauses briefly as he notices an exquisite recording pen in front of his champagne flute."}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Button_Click","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He picks up the pen and presses the play button."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_21winter_avg_pathfinder","raw":"BGM"}],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Good morning, General Schweinsteiger.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I hope I have not interrupted your breakfast.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger shrugs, then puts the pen down before sitting back on the sofa. "}]},{"spans":[{"text":"He does not seem the least bit surprised by the voice coming from the pen."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I regret I could not speak to you in person.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But this will not affect our friendship.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I believe you will like the present I have given you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I am certain that I cannot go wrong using it as an opportunity for us to make up with each other.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"At times, but only at times, it is natural for friends to have conflicting opinions, and arguments, while rare, are still normal.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But that does not mean they cannot make peace after the argument... ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Maintaining our friendship will do us both good.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Compared to those outsiders, we are friends who can truly trust each other.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Arla","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"What exactly do you want... Minister Oberstein?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger mutters to himself as he stares at the recording pen."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I do not want to see invasive species in our garden.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Everything I have done has been dedicated to this end.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As though he was anticipating Schweinsteiger's question, Oberstein supplies his answer."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"Trust me, General.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In the end, only we can help ourselves.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Oberstein's voice pauses before continuing warmly."}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"I guarantee that when everything is over, I will kindle our friendship brighter than it's ever become.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Perhaps it is time to restore the Stasi to its full glory, last seen a century ago. I trust that you will prove to be an indispensable gardener within our garden.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Oberstein","narrator":false,"pages":[{"spans":[{"text":"As you always have.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"The recording comes to an end."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Schweinsteiger removes his hat and sighs heavily."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Knock","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, there is a knock on the door."}]}]},{"sprites":[{"prefab":"NPC-Schweinsteiger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"I said, I wanted to be alone."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, the person outside doesn't seem to have heard and opens the door."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A waiter dressed in white enters. His face is blank as he presents a bottle of champagne. "}]},{"spans":[{"text":"Schweinsteiger is certain that he's never seen this man before."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Waiter","narrator":false,"pages":[{"spans":[{"text":"Please enjoy."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The champagne bottle has \"To friendship\" written on it in bright red letters. "}]},{"spans":[{"text":"As Schweinsteiger sits on the sofa, his eyes unconsciously drift to the hidden doorway—his bodyguards are still on duty, yet they are paying no attention to what is happening in here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Drink_Tea","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, the waiter before him doesn't seem to have noticed Schweinsteiger's glance. He simply opens the bottle and politely fills his glass. "}]},{"spans":[{"text":"The fizzing bubbles from the champagne make a pleasant sound in the glass."}]}]},{"sprites":[{"prefab":"NPC-Schweinsteiger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Schweinsteiger","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Waiter","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Schweinsteiger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Schweinsteiger","narrator":false,"pages":[{"spans":[{"text":"...To friendship."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With that, Schweinsteiger picks up the champagne, clinks it against an empty glass, and downs it in one gulp."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
