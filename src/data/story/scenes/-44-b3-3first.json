{"name":"-44-B3-3First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"318","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under the Dolls' protection, the Commander steps into Bohnsdorf for the second time. "}]},{"spans":[{"text":"It is much, much quieter than their previous visit. "}]},{"spans":[{"text":"The streets are empty and there is nobody in sight. The Commander and company already stood out to begin with, but now it's as though someone is shining a spotlight on them."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"262","raw":"BIN"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...We're here."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After reaching the gate of Elia's manor, the Commander can't help but look back at the places they've passed along the way."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...What happened to the village?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian has never seen anything like this before either. She looks around in concern."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I don't know, but it feels kind of spooky around here."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I've got a bad feeling about this..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Tsk."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 raises her gun and points it at the manor entrance."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It's not often that we all agree on something, can we hurry up and finish this ASAP so we can get out of here?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Could...Could you not carry your guns openly?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You can close your eyes if you want."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We've come this far. I'd like to avoid causing a commotion if we can avoid a conflict. "}]},{"spans":[{"text":"Dandelion, can you open the door?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Easily."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The main door opens in response."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Whew..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander recalls the unsettling woman who runs the village and gathers their resolve."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...If you see Elia, deal with her before she can start a disturbance."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Deal with her?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't mean killing her⁠—just knocking her out."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Something's not quite right here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO peers through the open door. From the steps, the inside is no different from the outside, as lifeless as ever. "}]},{"spans":[{"text":"At this point, one might wonder if this place is already a dead village."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Is that hag really in there?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Are you picking up any explosives?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"A moment please..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion lightly ascends the steps and pauses amidst the silence."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The surrounding Dolls remain vigilant, waiting for Dandelion's response."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, Dandelion's body quivers. Her expression changes dramatically and she runs up the rest of the steps and rushes into the house."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Stop!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"?! "}]},{"spans":[{"text":"After her!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion's sudden movement takes everyone by surprise, leaving them in a daze. "}]},{"spans":[{"text":"That is, everyone except ST AR-15 and Machlian. "}]},{"spans":[{"text":"The two of them bolt almost right after Dandelion, before the Commander even gives the order."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"background","value":"270","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander runs down a long corridor in pursuit of the three of them. Finally, they find Dandelion and the others in one of the guest rooms."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"D-Dandelion, what's going on?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Are you insane?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still ignoring the Commander, Dandelion stares dubiously at what lies before her."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"My Lady... Oh, My Lady! "}]},{"spans":[{"text":"I knew you wouldn't forsake us..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian's face is filled with shock."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Elia, what are you doing?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The table in front of Elia seems to be some sort of altar, and it is neatly stacked with what can only be explosives. "}]},{"spans":[{"text":"But what really frightens the Commander is the familiar shade of dark green right in the center of the explosives. "}]},{"spans":[{"text":"Those are Collapse Particles. "}]},{"spans":[{"text":"Elia withdraws her hand. She seems to have punched in a string of numbers on a control pad."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"640921...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Miss Elia."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and the Dolls step up behind Machlian. "}]},{"spans":[{"text":"At the sight of the Commander, Elia's smile freezes on her face."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"You... It's you! You kidnapped our Saint! "}]},{"spans":[{"text":"It's you! You lied to us!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her veiled face contorts in fury, and she looks ready to lunge at the Commander at any moment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Miss Elia!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Elia!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Only after Machlian calls out to her does Elia finally calm down."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"Oh... My Lady... Your Holiness..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two streams of tears flow beneath her veil."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"We can't lose the Saint... "}]},{"spans":[{"text":"Without you... We..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Elia... Listen to me. "}]},{"spans":[{"text":"You need help now. "}]},{"spans":[{"text":"Don't be rash, I beg you... Don't be rash..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is that...? "}]},{"spans":[{"text":"Who gave it to you? What do you plan to do with that?"}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"...No! We don't need help!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Elia looks at the Commander, her cloudy eyes suddenly flashing sharply again."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She puts her hand on the detonator. The motion makes all the Dolls raise their guns."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander, we should kill her!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"No! You can't!"}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"We don't trust these filthy heretics! "}]},{"spans":[{"text":"Nor do we need your help! "}]},{"spans":[{"text":"Paradeus will show us the way! We know where the future lies!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a maniacal shriek, she puts her finger on the detonate button."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"You betrayed us! You betrayed Paradeus, Machlian! "}]},{"spans":[{"text":"We don't need you anymore! We...We can make a new Saint!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Elia...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian's eyes widen in horror."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_21Winter_Ink_Drop_Single","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Poot. "}]},{"spans":[{"text":"After Elia presses the button, the explosives only produce a comical sound. "}]},{"spans":[{"text":"For a moment, the Commander wonders if the detonator suffered a malfunction of some sort. "}]},{"spans":[{"text":"However, Dandelion's expression dispels this last, vain hope."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander, we need to get out of here right now! "}]},{"spans":[{"text":"I'm picking up a spread of Collapse Particles—those aren't explosives! "}]},{"spans":[{"text":"It's a radiation bomb! They're infecting themselves!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tsk!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, Squad Griffin is reporting explosions in the village! "}]},{"spans":[{"text":"All the villagers are carrying miniature bombs! They're killing themselves! "}]},{"spans":[{"text":"Squad Griffin couldn't disarm all the devices in time!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"God dammit!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"effect","value":"%%code=changjing_huafen%%","raw":"common_effect"}],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"Ahahaha...Hahaha!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she soaks in the spreading cloud of pale yellow mist, Elia spreads her arms wide and laughs maniacally while looking to the heavens."}]}]},{"sprites":[{"prefab":"NPC-Elijah","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Elia","narrator":false,"pages":[{"spans":[{"text":"A miracle... This is a miracle!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Elia! No!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Elia's skin begin to visibly ulcerate and fester before her eyes, Machlian falls helplessly to her knees and bursts into tears."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We don't have time! Machlian!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander pulls Machlian up."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We can still save the others!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Shut up and RUN!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
