,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let's flip the script and think about it... "}]},{"spans":[{"text":"Interesting, I'll give it a go! "}]},{"spans":[{"text":"If it was the Military that opened the firewall themselves, and all this was part of their plan...does that make sense?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Remember what they did during the joint operation? "}]},{"spans":[{"text":"The Military charged all the way in, and then Sangvis Ferri was forced to fully activate Parapluie."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You mean...they deliberately let Parapluie spread? What good would it do for them?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Mastermind can see and control anything infected by Parapluie, be it a Doll or a server. "}]},{"spans":[{"text":"And then, the Military deliberately exposed their theater server to Parapluie, so Mastermind could see its contents... "}]},{"spans":[{"text":"But what would the Military want to show her...? "}]},{"spans":[{"text":"No...I can't think of anything. I don't have enough leads..."}]}]},{"sprites":[{"pre