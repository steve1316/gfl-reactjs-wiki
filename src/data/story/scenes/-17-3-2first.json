ion":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Perhaps...perhaps because OGAS was too dangerous. "}]},{"spans":[{"text":"The file you found in the theater server mentioned it, right? It's connected to the Relics..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"So...why now?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Lyco's AI had extremely powerful self-learning abilities... It was his masterpiece, though I didn't know what it has to do with OGAS. "}]},{"spans":[{"text":"But perhaps it has fully matured now, and someone in the Military knows that \"she\" is mature..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Oh!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You've got a lead?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"