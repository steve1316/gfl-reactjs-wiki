ckground","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Ange... "}]},{"spans":[{"text":"What if...what if the Military also had Parapluie, or a more powerful electronic control method than the Parapluie virus?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"A more powerful method...?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"It's hardly impossible. "}]},{"spans":[{"text":"They're seasoned veterans when it comes to electronic warfare. Let's call the version they have Super Parapluie."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let me think... "}]},{"spans":[{"text":"The military forces Mastermind to deploy Parapluie, which causes Mastermind to find the central server which the Military has deliberately exposed to her... "}]},{"spans":[{"text":"After that, Mastermind thinks she has successfully infected the server, and goes one step further to hack into the theatre server to control the military units. "}]},{"spans":[{"text":"The Military then uses its own Super Parapluie to flood Mastermind's infected sectors, which means they could..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Reverse the connection..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"},{"type":"shake","raw":"震屏"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Exactly! They use the connection to reverse-hack Mastermind with their Super Parapluie!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Reverse-hacking?! "}]},{"spans":[{"text":"You mean the Military wants to...directly control Mastermind?! "}]},{"spans":[{"text":"Is that the Military's plan? Just to control S.F.'s Mastermind?!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"That was why they left M4A1 in place, in order to lure Mastermind onto the frontlines. It would improve their chances of reverse-controlling Mastermind several-fold. "}]},{"spans":[{"text":"But then why did they go out of their way to attack the AR Team when they left her alone on the spot?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It's definitely weird. Maybe they felt that there was some advantage to be gained by letting M4 and M