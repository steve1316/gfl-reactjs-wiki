":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But when I think about meeting all of you in the future, I suddenly realize that maybe the future isn't so bad after all...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl's eyes flicker with some kind of emotion."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"It might be hard for you to understand this feeling, but it really means a lot to me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Thank you, all of you, for giving me a reason to look forward to the future.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I hope we'll get to meet each other soon.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girl smiles and waves."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The video ends."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"GeneralLiu","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"17xh-ShootingRange","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"General Liu","narrator":false,"pages":[{"spans":[{"text":"Who is she? She's super cute!"}]}]},{"sprites":[{"prefab":"AUGPARA","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AUG Para","narrator":false,"pages":[{"spans":[{"text":"I don't know, never seen her before. I think she called herself Machlian or something?"}]}]},{"sprites":[{"pref