rator":false,"pages":[{"spans":[{"text":"\"Dandelion\" raises her head. The light in her eyes has returned, but there is a different color to them."}]}]},{"sprites":[],"ops":[],"speaker":"\"Dandelion\"","narrator":false,"pages":[{"spans":[{"text":"Nobody's sacrifice is without value. "}]},{"spans":[{"text":"Because by relinquishing their lives, they will be giving the living something even more precious."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dande...lion?"}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Oh come on, are you still pulling that crap at a time like this? "}]},{"spans":[{"text":"I don't care how many immunity—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Furious, ST AR-15 whirls around to glare at Dandelion, but the moment their eyes meet, all her angry words die in her throat. "}]},{"spans":[{"text":"She looks into those familiar eyes and whispers in a quivering voice."}]}]},{"sprites":[],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M...M4."}]}]},{"sprites":[],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Dandelion... M4?"}]}]},{"sprites":[],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"Enough with the charade!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Exasperated by \"Dandelion's\" interruption, Narciss commands all her floating blades to pivot and take aim at the Commander."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","val