{"name":"-59-c-3-end","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Lewis","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"73","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"m_avg_hope","raw":"BGM"}],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"It's over?"}]}]},{"sprites":[{"prefab":"m500","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M500","narrator":false,"pages":[{"spans":[{"text":"It is."}]}]},{"sprites":[{"prefab":"Lewis","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"Did it turn out good or bad?"}]}]},{"sprites":[{"prefab":"m500","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M500","narrator":false,"pages":[{"spans":[{"text":"Based on the training results alone, I'd say the latter."}]},{"spans":[{"text":"Neither were our stats pretty, nor have we demonstrated adequate tactics."}]}]},{"sprites":[{"prefab":"Lewis","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"Ah... wouldn't that mean we made an embarrassment of ourselves?"}]}]},{"sprites":[{"prefab":"M1897","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1897","narrator":false,"pages":[{"spans":[{"text":"I don't think so."}]},{"spans":[{"text":"Floors you can't mop clean right now will eventually get cleaned one day."}]},{"spans":[{"text":"Today, we've merely climbed up a brand new flight of stairs. "}]},{"spans":[{"text":"By the next time we come around, we might just finish cleaning it together."}]}]},{"sprites":[{"prefab":"LWMMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"LWMMG","narrator":false,"pages":[{"spans":[{"text":"Not maybe. Definitely."}]}]},{"spr