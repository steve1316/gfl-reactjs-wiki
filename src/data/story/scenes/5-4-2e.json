{"name":"5-4-2E","beats":[{"sprites":[],"ops":[{"type":"background","value":"22","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Factory, Griffin HQ..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, the analysis is out."}]},{"spans":[{"text":"The information left behind by AR-15 matches with Squad 404's previous discovery."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Looks like Sangvis Ferri intends to wipe out Griffin once and for all with their next plan."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"So soon? I find it hard to believe they have that many T-Dolls in reserve."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"They don't need T-Dolls, Helian. She has something way more dangerous up her sleeve."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger... You've already found out so much."}]},{"spans":[{"text":"Did you really come across her in that building?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"It's raining on the plain, and parapluie...or umbrella...is the key."}]},{"spans":[{"text":"No matter. With AR-15's information, we can now find the exact location of this Plan Parapluie."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"AR-15..."}]},{"spans":[{"text":"She's still doing her best to help us even now..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"She is merely fulfilling her purpose, Helian."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I understand, but right now I'm just a little..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"I have no prejudice against T-Dolls, and I am very grateful for the duty they shoulder for mankind's sake."}]},{"spans":[{"text":"I can also understand why some field commanders treat them as equals."}]},{"spans":[{"text":"But whether you view them as tools or friends or whatever..."}]},{"spans":[{"text":"The moment they fall under outside control, you have to make a choice."}]},{"spans":[{"text":"Bid them farewell in person, or stand by and watch as they drag everyone along into the abyss."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Then...our choice is..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Give it a bit more time, Helian. The choice is not ours to make."}]},{"spans":[{"text":"That commander stills needs some time."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Is this another...grooming session?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"No..."}]}]},{"sprites":[{"prefab":"Kyruger","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Kyruger","narrator":false,"pages":[{"spans":[{"text":"This time, it's a test."}]},{"spans":[{"text":"Helian, take stock of our T-Doll roster. Report all the ones fit for battle."}]},{"spans":[{"text":"We must be prepared. It's our turn to make a move now."}]}]}]}
