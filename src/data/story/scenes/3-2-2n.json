{"name":"3-2-2N","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outpost secured."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Outpost secured. Flawlessly done, Commander."}]},{"spans":[{"text":"I shall start decoding the data. Get me a chair, SKS."}]}]},{"sprites":[{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Ha, and where do you suggest I get a chair? We couldn't even find the door knob when we came in."}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Hmm... How can Sangvis units bear rotting in this dumpster?"}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"This place is only for those in the lower ranks. You should be glad there's a charging port."}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Ha, I pity those pugs and angelfish."}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"You aren't a fish. How do you even know they're pitiful?"}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Just look at this place. Not a single drop of vodka. I can't stand being in here for even half an hour."}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"See, AK47, that's your problem. You mustn't indulge in such worldly material gratification."}]},{"spans":[{"text":"You should always be contemplating the purpose of our existence as T-Dolls."}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"Tch. So you're saying, those Sangvis trash have a higher form of existence than me?"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"What kind of nonsense are you two prattling about?"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Aren't you the least bit intrigued, Makarov? About the origin and objective of Sangvis T-Dolls?"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"They are enemies who threaten Griffin's interests. We just have to destroy them."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Humph. Surely you know quite a lot, Makarov, since you're such good buddies with OTs-14."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"That's right. C'mon, give us some insider story!"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"There, target location acquired. Break time's over."}]}]},{"sprites":[{"prefab":"SKS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SKS","narrator":false,"pages":[{"spans":[{"text":"Hey! You know something, don't you?! You must know quite a lot, Makarov!"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"...What difference does knowing make?"}]},{"spans":[{"text":"AK47, SKS, no matter what we know, our order as T-Dolls will never change."}]},{"spans":[{"text":"Destroying Sangvis Ferri is all we have to do. So let's continue our mission."}]}]}]}
