{"name":"-70-S-5","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"},{"type":"background","value":"202407_Shaw","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"■FILE■ PACC74839827146238—Decrypting..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Samantha Shaw (2009-2062), "}]},{"spans":[{"text":"Formerly known as Yekaterina Vasilievna Petrovskaya."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In 2054, StateSec kickstarted Project \"Wolf Pack\", with Samantha Shaw spearheading the project. "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"In 2062, StateSec shelved Project \"Wolf Pack\", and Samantha Shaw went missing [Attachment 556] [Attachment 557]."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Decrypting Attachment 556..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samantha Shaw's voice starts speaking..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Winter_Night_Bayan_Version","raw":"BGM"}],"speaker":"Samantha Shaw","narrator":false,"pages":[{"spans":[{"text":"I'm Samantha Shaw. They seized my research materials and took away all my research data.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But I'm glad they didn't get to the Wolf Pack, the only Dolls in existence that aren't tainted by Relic technology. Everyone else's work... was poisoned by Hume, that son of a bitch...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This audio recording may well be the last thing I leave behind.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Listen, you bastards—I know you've been listening in the whole time, but listen all the same...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":"Samantha Shaw","narrator":false,"pages":[{"spans":[{"text":"Putting a human mind inside the head of a Doll doesn't make it a fucking human!","style":{"color":"#00CCFF","size":"50"}},{"text":" "}]},{"spans":[{"text":"Weapons are weapons, and humans should be 100% human.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Frankenstein's monster should've stayed in Mary Shelley's novel, why bring it into the real world?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'm against using Relic technology of any sort. It will inevitably become the weapon that humanity uses to bring about its own demise.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The sad thing is... I'm a human myself.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202407_Shaw","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Decrypting Attachment 557..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_button","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022saros_DarkRedMask","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Samantha Shaw speaks again. At this point, she no longer has the strength to rage, and her voice is little more than a feeble rasp."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Winter_Night","raw":"BGM"}],"speaker":"Samantha Shaw","narrator":false,"pages":[{"spans":[{"text":"...What a shame... Why did they have to come before I could finish RPK-16...? I was so close... SO close...! "}]},{"spans":[{"text":"RPK-16 is the last hope... in my strife against the Relics... Why can't I finish her...? "}]},{"spans":[{"text":"Why...?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"\"Nadia\"","narrator":false,"pages":[{"spans":[{"text":"Is there anything I can do for you at all, my lady?"}]}]},{"sprites":[],"ops":[],"speaker":"Samantha Shaw","narrator":false,"pages":[{"spans":[{"text":"Send a message to Persica... Ask her to complete RPK-16 for me..."}]}]},{"sprites":[],"ops":[],"speaker":"\"Nadia\"","narrator":false,"pages":[{"spans":[{"text":"Yes, my lady."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang-bang... "}]},{"spans":[{"text":"A series of gunshots ring out."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"\"Nadia\"","narrator":false,"pages":[{"spans":[{"text":"My lady, you still haven't input the final command."}]}]},{"sprites":[],"ops":[],"speaker":"Samantha Shaw","narrator":false,"pages":[{"spans":[{"text":"...RPK... 16..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Unfamiliar Voice","narrator":false,"pages":[{"spans":[{"text":"Take her away, and get rid of all the equipment here."}]}]},{"sprites":[],"ops":[],"speaker":"Male Voice","narrator":false,"pages":[{"spans":[{"text":"What about that Doll? Do we destroy it?"}]}]},{"sprites":[],"ops":[],"speaker":"Unfamiliar Voice","narrator":false,"pages":[{"spans":[{"text":"There's no time, someone's coming. We have to go..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"\"Nadia\"","narrator":false,"pages":[{"spans":[{"text":"My lady..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
