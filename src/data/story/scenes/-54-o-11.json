{"name":"-54-O-11","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"528","raw":"BIN"},{"type":"bgm","value":"GF_2022_Summer_Battle_1","raw":"BGM"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F09, Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There's a rustling amidst the rubble, as though someone is moving swiftly through it. "}]},{"spans":[{"text":"After ensuring that nobody's paying attention, Maggie pushes an intact snack cart out from the corner of the carriage."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Jerky or chocolate?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine, who has emerged from hiding as well, glares at Maggie. Her face twitches in annoyance."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Are you actually in the mood to be eating at a time like this?!"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Well, what would you do?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie sits down on a ragged sofa and opens a packet of cookies, then lies down like she's in heaven... "}]},{"spans":[{"text":"It would have be heaven... if she were not surrounded by the ruins of the dining carriage. "}]},{"spans":[{"text":"Erma peeps out from behind Maggie, a suspicious look in her eyes. "}]},{"spans":[{"text":"Catherine glances at Erma, and then filches a pack of olives from Maggie's little push cart."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Why don't we just hand her over?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"And then what, get shot full of holes by the soldiers outside?"}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Do you HAVE to discuss this in front of me?"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"But even if we don't do that, those soldiers will destroy the train carriage by carriage! "}]},{"spans":[{"text":"How much longer can we hold out? Why didn't we run to Carriage 1 with the others?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"You know what they say about putting all your eggs in one basket. "}]},{"spans":[{"text":"And besides, I've only heard of people hunting elephants, not ants."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"But that's because elephants are worth more than ants!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie rolls her eyes at her."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"All we can do now is keep our strength and stamina up, put our hands together..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"And pray that Madam Instructor pulls off a complete victory."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"If we're counting on her... "}]},{"spans":[{"text":"Then isn't this plank we're clinging to a little too small? "}]},{"spans":[{"text":"I feel like we've already been carried away by the flood..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Isn't this common occurrence for us? "}]},{"spans":[{"text":"Or did you think our planks from before were very big?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Well, it's true, we're either having adventures or on the way to an adventure."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Change is the only constant, as they say."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"And the only safety is the pursuit of safety itself."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine sighs heavily."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"My life sucks."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Just our luck to get stuck with an owner like that. "}]},{"spans":[{"text":"We couldn't catch a break at the beginning and it's just been endless suffering throughout our lives."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...What was your owner like?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"brighten","raw":"同时点亮"}],"speaker":"Maggie & Catherine","narrator":false,"pages":[{"spans":[{"text":"No comment."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then tell me everything you know about Doctor Hume."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...So you can afford to pay for the information now?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Put it on Lyudmila's tab."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Eh? You're not mad at her anymore?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"That's between her and me. I'll ask her to explain everything when she shows up."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You tell me what you know first."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Eh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie sighs."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_2","raw":"BGM"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Actually, I don't really know that much. I mean, he wasn't a regular customer or anything. "}]},{"spans":[{"text":"He DID do business with me, but as a seller, not a buyer. "}]},{"spans":[{"text":"Back then, he was selling some kind of self-developed Doll technology. "}]},{"spans":[{"text":"The product description for it was really weird, which actually left an impression on me... "}]},{"spans":[{"text":"...\"Doll-related technology, using Dolls as research subjects.\" "}]},{"spans":[{"text":"It seemed interesting to me, so I flipped through it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She thinks for a bit."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Let me think... I think part of it went... "}]},{"spans":[{"text":"\"If the point was to make a better killing machine, it wouldn't have to look like a human...\""}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"\"...Physical performance isn't everything. More importantly, Dolls are supposed to be an improvement on humanity.\""}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Yeah, that's the one."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"What does it mean?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"How should I know? I'm a social engineer, not an actual engineer. "}]},{"spans":[{"text":"But to my knowledge... All the Dolls that took part in the experiment.... "}]},{"spans":[{"text":"They all went mad in the end, until their neural clouds melted down."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You make him sound like some kind of mad scientist."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"You mean he wasn't?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I thought he was my \"Mother\"."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Humans all love playing pretend. "}]},{"spans":[{"text":"One of our mistresses always had us call her \"Milady\"."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Even though she wasn't a lady, or rich."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"I'd secretly roll my eyes every time I had to call her that."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"That's just how humans are. They seek things that they lack. "}]},{"spans":[{"text":"Same goes for us."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrat