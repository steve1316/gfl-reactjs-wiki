expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"If Miss M16 could survive her previous ordeal, she'll be fine this time as well. "}]},{"spans":[{"text":"Let's go. Miss T91 is still waiting for your good news."}]}]},{"sprites":[{"prefab":"T65","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"T65","narrator":false,"pages":[{"spans":[{"text":"She's been waiting for so long... "}]},{"spans":[{"text":"If we go back just like that...we'll give her nothing but more hope... "}]},{"spans":[{"text":"And I can do nothing...but wait with her."}]}]},{"sprites":[{"prefab":"T65","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"But this is a hard-earned chance for us to make a safe retreat... If you go back for Miss M16, you'll only end up putting yourself in unnecessary danger. "}]},{"spans":[{"text":"If you get destroyed...you won't even remember you've seen Miss M16."}]}]},{"sprites":[{"prefab":"T65","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"T65","narrator":false,"pages":[{"spans":[{"text":"I... "}]},{"spans":[{"text":"I've had enough with sitting at the base waiting for so-called good news. "}]},{"spans":[{"text":"If I had to lose her again, then I'd rather not have reunited with her to begin with! "}]},{"spans":[{"text":"Either we go home with Miss M16, or we forget everything that happened here!"}]}]},{"sprites":[{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1 Garand","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"m1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speake