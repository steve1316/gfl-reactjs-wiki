":false,"pages":[{"spans":[{"text":"Precisely. Ever since then, the Stasi's reputation and status have gone down the gutter.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"My boss in Germany is... how do I put it... an overachieving perfectionist workaholic.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"To give you a rough idea, if there were a pasta-making competition, she would end up making pasta so long it could go round the planet three times.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Yeah... that's the kind of freak she is.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"She aspires to restore the Stasi to its former glory.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":21,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"An ambitious aspiration.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":21,"side":"left","tags":{}}],"ops":[],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"But...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"She actually did it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":19,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"Agent Q","narrator":false,"pages":[{"spans":[{"text":"I'll let you take a peek.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"493","raw":"BI