 time to move, backup team."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M9","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"Huh? All the Sangvis...are destroyed?"}]},{"spans":[{"text":"A-Are you one of us?"}]}]},{"sprites":[{"prefab":"SuperSASS","expression":0,"side":"left","tags":{}},{"prefab":"M9","expression":1,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Frontline","raw":"BGM"}],"speaker":"Super SASS","narrator":false,"pages":[{"spans":[{"text":"SuperSASS, new recruit at Griffin. Glad to be of help, Miss M9."}]}]},{"sprites":[{"prefab":"SuperSASS","expression":0,"side":"left","tags":{}},{"prefab":"M9","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"M9","narrator":false,"pages":[{"spans":[{"text":"Th...Thank goodness..."}]},{"spans":[{"text":"You're my hero, Super...whatever!"}]}]},{"sprites":[{"prefab":"SuperSASS","expression":0,"side":"left","tags":{}},{"prefab":"M9","expression":1,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Super SASS","narrator":false,"pages":[{"spans":[{"text":"It's SuperSASS, Miss M9."}]},{"spans":[{"text":"And you're squishing the breath out of me..."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"3","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Phew, thank goodness you'd prepared for backup beforehand. Otherwise things wouldn't have ended pretty for M9."}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false