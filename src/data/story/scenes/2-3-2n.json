{"name":"2-3-2N","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Battle","raw":"BGM"},{"type":"background","value":"3","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin troops arrived at a base."}]}]},{"sprites":[{"prefab":"M1911","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"Thompson, you've got a good field of vision over there. Have you picked your sniper?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"M21, you're up. Give me some bullseyes."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"M21","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M21","narrator":false,"pages":[{"spans":[{"text":"Sure. But who should I aim for, the military or Sangvis Ferri?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"M21","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Now is not the time for jokes..."}]},{"spans":[{"text":"Still, seeing that you're a civilian T-Doll, occasional mistakes are unavoidable, aren't they?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"M21","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M21","narrator":false,"pages":[{"spans":[{"text":"Heheh. How about...raising the barrel by 1cm on the premise of not endangering the operation?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"M21","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"As long as it's within permissible range of the contract, you can have all the fun you want."}]}]},{"