rator":false,"pages":[{"spans":[{"text":"A floor plan?"}]}]},{"sprites":[{"prefab":"Lewis","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"It's a floor plan of the Aegean's internal structure... It shows all the safety passages on the ship, including every single room in the VIP area."}]}]},{"sprites":[{"prefab":"MDR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MDR","narrator":false,"pages":[{"spans":[{"text":"Miss Superstar must've left this for us."}]}]},{"sprites":[{"prefab":"Welrod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Welrod MkII","narrator":false,"pages":[{"spans":[{"text":"If she's capable of taking out the security droids, does that mean she can get off the ship anytime?"}]}]},{"sprites":[{"prefab":"Lewis","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"Not necessarily... The cargo bay has been marked with an asterisk. The label reads... "}]},{"spans":[{"text":"Thunder."}]}]},{"sprites":[{"prefab":"MDR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MDR","narrator":false,"pages":[{"spans":[{"text":"What does that mean? Is Thunder in the cargo bay? "}]},{"spans":[{"text":"Why would she know that?"}]}]},{"sprites":[{"prefab":"Welrod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Welrod MkII","narrator":false,"pages":[{"spans":[{"text":"Your guess is as good as mine. In any case, this is the only lead we've got."}]}]},{"sprites":[{"prefab":"Lewis","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"Even if it's a trap, we have no choice but to go. "}]},{"spans":[{"text":"We can't abandon our friend."}]}]},{"sprites":[{"prefab":"MDR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MDR","narrator":false,"pages":[{"spans":[{"text":"But what about your precious idol?"}]}]},{"sprites":[{"prefab":"Lewis","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lewis","narrator":false,"pages":[{"spans":[{"text":"Hey, one is an out-of-reach idol and the other is a friend who's been through thick and thin with me!"}]}]},{"sprites":[{"prefab":"Welrod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Welrod MkII","narrator":false,"pages":[{"spans":[{"text":"You've got to say that to Thunder in person..."}]}]},{"sprites":[{"prefab":"M200","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M200","narrator":false,"pages":[{"spans":[{"text":"She'll be so touched!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"19winter_inbg_2","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Somewhere on the cruise."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the dimly-lit space, a security droid lands a heavy punch on Thunder's face."}]}]},{"sprites":[{"prefab":"NPC_girill","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Valentin","narrator":false,"pages":[{"spans":[{"text":"...Tsk! "}]},{"spans":[{"text":"I should've prepared some electronic tools. Regular weapons can't get a T-Doll to talk."}]}]},{"sprites":[{"prefab":"Thunder50","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thunder","narrator":false,"pages":[{"spans":[{"text":"...Paula Snow..."}]}]},{"sprites":[{"prefab":"NPC_girill","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Valentin","narrat