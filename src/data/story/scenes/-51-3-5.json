{"name":"-51-3-5","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"480","raw":"BIN"},{"type":"bgm","value":"GF_21summer_avg_Crisis","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...On the outskirts of Berlin, at the edge of the Red Zone. "}]},{"spans":[{"text":"Even when capitalizing on their superior numbers and formation, Squad Nitrogen only barely manages to maintain a slight suppression advantage."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"She's slowing down, No. 9!"}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"I see it!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Sword_Scope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as Grig pauses mid-stride, No. 9 raises her gun and pulls the trigger without hesitation."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bangbangbang—!!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullte_Ricochet","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A series of bullets strikes Grig dead on, and some of them hit her legs."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"}],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a subdued grunt, Grig brings her sabre up in a flourish and takes a defensive stance. "}]},{"spans":[{"text":"The gleaming blade and the inky-black muzzles of the guns are locked in a silent confrontation. "}]},{"spans":[{"text":"Both sides are unable to act, and the stalemate continues."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"W-Why is nobody moving?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"We can't be sure that we can overcome her with a pre-emptive strike.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"But we can't just let ourselves get passively beaten up!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"No, the enemy isn't fully confident either, which is why she's ceased her attack.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"In that case...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"At times like this, you mustn't panic. Hold your breath and focus yourself.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Look in the direction of your prey. Don't lose yourself in her eyes, but trace every frame of every movement she makes in your mind. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"I'll try.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a smirk, Grig suddenly shifts from a defensive stance and suddenly thrusts her sabre forward for the kill."}]}]},{"sprites":[{"prefab":"SP9","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Scatter!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"This is—"}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"Uwah—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Though they're all well-trained Dolls, they're having difficulty dealing with this sudden onslaught."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bangbangbang—"}]},{"spans":[{"text":"Covered by gunfire, the three of them manage to avoid the ferocious thrust and roll to the side. "}]},{"spa