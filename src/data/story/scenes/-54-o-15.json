{"name":"-54-O-15","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_N-0-1","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Moskva 24","narrator":false,"pages":[{"spans":[{"text":"...Breaking news.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The EN440-13M train that went missing in the Red Zone earlier has been confirmed to have crashed on German territory near the Soviet-German border. The authorities have immediately dispatched a rescue party to the scene to provide disaster relief.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Sources say that a gangland firefight which broke out in the second-class carriages of the train while it was in transit could be the cause of the derailment. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Traffic restrictions will be lifted in two hours' time. Please stay apprised of the latest updates.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Moskva 24","narrator":false,"pages":[{"spans":[{"text":"According to analysis of the site footage, this is the most serious accident in the 20 years that the Siberian Lifeline has been operating, involving over 300 people.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Our reporters will provide coverage live from the scene shortly afterwards.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2021white_Newstitle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"...Welcome to the Voice of Berlin.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'm your host Shadowless, bringing you urgent news.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Shadowless","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"The EN440-13M intercontinental train \"Future\" that met with an accident last night is now out of danger thanks to help from the local police.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Rescuers state that a large quantity of Soviet military equipment was left behind at the scene, which has fueled suspicion for the Soviets' involvement in the incident.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Additionally, according to the Railway Authority, the damage to the rails is severe, and it is unclear as to when the Moscow-Paris line will be restored.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_N-1-3","raw":"BIN"}],"speaker":"BBC","narrator":false,"pages":[{"spans":[{"text":"This just in—the explosion on the Warsaw-Poznań stretch of the Siberian Lifeline has been verified by local police as a terrorist attack. Severe damage has been done to the section of railway in question and no organizations have stepped forward to claim responsibility for this event.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The rescue teams dispatched by the Germans and the Soviets have yet to return with any survivors. We will continue to monitor the situation and provide updates.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2019summer_3","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"m_avg_hope","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Outside the ruined carriages of the intercontinental train \"Future\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With light borrowed from Lady Luck, Prometheus ushers in the dawn and finally dispels the long night. "}]},{"spans":[{"text":"As the sun's red rays fill the sky, the muddy ground slowly dries. "}]},{"spans":[{"text":"All traces of the chilly autumn rain from the night are nowhere to be found. "}]},{"spans":[{"text":"All that is left is the lingering warmth where that torch has burned out. "}]},{"spans":[{"text":"It is faint, but full of hope."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"We've cleaned up the battlefield."}]}]},{"sprites":[{"prefab":"MLEMK1Mod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lee Enfield","narrator":false,"pages":[{"spans":[{"text":"I'll go confirm the time with Kar. "}]},{"spans":[{"text":"You arrange for everyone to board."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"Right, one blanket, one bottle of water, two pieces of milk chocolate, and half a pound of bread for everyone. "}]},{"spans":[{"text":"Please collect your supplies before boarding."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel helps Rosita up and gives her his two pieces of chocolate."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Rosita","narrator":false,"pages":[{"spans":[{"text":"...I'm fine. "}]},{"spans":[{"text":"Lucas spent all night taking care of me... "}]},{"spans":[{"text":"You can give the extra to people who need it more."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel nods and turns to see if anyone else might need it. "}]},{"spans":[{"text":"However, nobody but the Griffin Dolls would come within a meter of them."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel quietly brings the food that he and Rosita can't finish back to the supply crate where Type 56-1 is handing out supplies."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Type 56-1 sighs and pats Pavel on the shoulder."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"The long night is over. Everything will be okay once you get to Berlin."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...Thank you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After that, he helps Rosita onto the Elmo. "}]},{"spans":[{"text":"On the other side, Kar98k leads her team over, followed by Stewardess Susanna."}]}]},{"sprites":[{"prefab":"98KMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"We've completed the recovery mission. "}]},{"spans":[{"text":"I've also checked the list of belongings with Susanna, the passengers can collect them at their own pace. "}]},{"spans":[{"text":"If there are any items whose owners cannot be identified, you can go check with Susanna."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"Got it!"}]}]},{"sprites":[{"prefab":"98KMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Do a final headcount and an inventory of our remaining supplies. "}]},{"spans":[{"text":"We leave in five minutes."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"Will do."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Type 56-1 signals for Desert Eagle to come over."}]}]},{"sprites":[{"prefab":"56-1typeMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,150"}}],"ops":[],"speaker":"Type 56-1","narrator":false,"pages":[{"spans":[{"text":"Go search the carriage one last time. "}]},{"spans":[{"text":"Then prepare to head back."}]}]},{"sprites":[{"prefab":"DesertEagle","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Desert Eagle","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lucas has been watching from a distance. He tugs on Dr. Rugosa, who's bent over looking for something."}]}]},{"sprites":[{"prefab":"NPC-TD_Boy","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucas","narrator":false,"pages":[{"spans":[{"text":"Doctor... It's time to go."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dr. Rugosa adjusts his glasses."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Nevermind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dr. Rugosa and Lucas walk hand-in-hand toward the Elmo."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Inside the \"Elmo\"."}]}]},{"sprites":[{"prefab":"MLEMK1Mod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":"Lee Enfield","narrator":false,"pages":[{"spans":[{"text":"Doctor, this is the message log."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"Thank you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After writing his name on the book, Dr. Rugosa's keen eyes quickly sweep over the open crates nearby."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A smudged wristwatch is buried amidst the pile of guns, tank wreckage, and dented suitcases. "}]},{"spans":[{"text":"It's like a chunk of gold hidden in sand."}]}]},{"sprites":[{"prefab":"MLEMK1Mod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lee Enfield","narrator":false,"pages":[{"spans":[{"text":"Doctor?"}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"...That belonged to a former friend of mine. Could I see it?"}]}]},{"sprites":[{"prefab":"MLEMK1Mod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lee Enfield","narrator":false,"pages":[{"spans":[{"text":"Of course. If you're certain that it belonged to the deceased, then you can write down how you'd like to dispose of it."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"...Thank you all."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After thanking them again, Dr. Rugosa slowly picks up the wristwatch. "}]},{"spans":[{"text":"He can't bear to see it so dirty and wipes it carefully with the cloth he uses for his glasses."}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_ED","raw":"BGM"}],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"Pain always lasts so long, like a snail diligently crawling forward. "}]},{"spans":[{"text":"Yet joy is so fleeting, like a rabbit's tail bounding across the autumn plains."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"[Longitudinal Strain - END]"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"credits","value":"2022Summer_Credit","raw":"名单2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_21Winter_Subway","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Sewer","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the small hours. Berlin Central Train Station, Germany."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_Street","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Doorbell","raw":"SE1"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A train has just pulled into the station. As the train doors open, the busy passengers boil out in a clamorous tide that gushes out of the station like a flood. "}]},{"spans":[{"text":"Another Tareus walks among the crowd, gently touching her earlobe."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Mission complete. "}]},{"spans":[{"text":"The objective \"Grand Duke\" has been intercepted."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Very good. You may return.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tareus","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"The transmission ends."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tareus looks up at the starry sky. A shooting star is streaking across the heavens. "}]},{"spans":[{"text":"She looks away and follows the crowd out of the station."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"END"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
