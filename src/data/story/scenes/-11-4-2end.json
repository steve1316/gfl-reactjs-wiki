{"name":"-11-4-2End","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"The signal seems to have led us in the right direction. The drone really is here... "}]},{"spans":[{"text":"45, I completed the mission! "}]},{"spans":[{"text":"(Laughs bitterly) Not that you can hear me..."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Please be safe, 45. I don't want to go back...to how it was..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"街道","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"bossbattle_loop","raw":"BGM"},{"type":"sfx","value":"Battlefield","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile. "}]},{"spans":[{"text":"Destroyer is still dashing about on the battlefield."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Last chance, Gr G11. "}]},{"spans":[{"text":"I've already cleaned up the perimeter of the outpost. Time to give it everything you've got."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Ugh... You make it sound so easy. But with only me..."}]}]},{"sprites":[{"prefab":"DSR50","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gd DSR-50","narrator":false,"pages":[{"spans":[{"text":"So I showed up right on time. "}]},{"spans":[{"text":"Hallo, little one. You on your own? "}]},{"spans":[{"text":"Oh dear...looks like you already have a date. I'm too late."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Let's get to business, Gd DSR-50. "}]},{"spans":[{"text":"Our target is that dog-shaped Sangvis Ringleader. Take it down, and the Dummies will stop as well, and we'll all be safe. "}]},{"spans":[{"text":"Now that you're free, make yourself useful."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Simultaneous shots. Can you do it?"}]}]},{"sprites":[{"prefab":"DSR50","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gd DSR-50","narrator":false,"pages":[{"spans":[{"text":"You only have to ask."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"These new elite T-Dolls... I sure hope she's as dependable as 45 said. "}]},{"spans":[{"text":"Gr G11, can you make the shot yet?"}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Don't rush it. To avoid making the same mistake, I have to wait until Destroyer comes to a stop. "}]},{"spans":[{"text":"She's already slowed down considerably after all the fighting so I think she'll soon be out of juice. "}]},{"spans":[{"text":"Then...we'll just have to wait for her to stick out her big shiny eye..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"Battlefield","raw":"SE1"},{"type":"background","value":"大桥","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Hey, Dreamer! I can't keep it up much longer! "}]},{"spans":[{"text":"Where the hell are your reinforcements?!"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Oh dear... My forces are all busy defending the perimeter. "}]},{"spans":[{"text":"Don't worry, Destroyer, you're very close to completing your mission. "}]},{"spans":[{"text":"Keep running and don't let the sniper catch you."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What now?! UMP45 still hasn't turned into a Sangvis unit as you promised, and I'm under heavy barrage here!"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Just get a bit closer. I can take care of the one in command if you just close in a bit."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What are you talking about? Hasn't the plan to take control of UMP45 already failed?"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Well, UMP45... Heheh... "}]},{"spans":[{"text":"She IS a slippery one. She's keeping our connection open, so she must be up to something. "}]},{"spans":[{"text":"Whatever. We have a chance as long as the connection stays up."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"A chance? What chance?"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"If she's using the same protocol as ours, it's gonna make our job even easier... "}]},{"spans":[{"text":"Have you forgotten about our offensive firewall?"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"You mean...the thing that can simply fry a neural cloud...?"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"That's the gist of it in terms of theory. "}]},{"spans":[{"text":"I actually used every single idle server at the base for this. That little minx's neural cloud should've been burnt to a crisp by now."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Oh, so we can now go get her corpse! "}]},{"spans":[{"text":"And capturing Squad 404 will only be a matter of time!"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"That's the only foreseeable outcome... "}]},{"spans":[{"text":"But...will it really be that easy..."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Who cares! Let me go check out the outpost she's at!"}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"But...what's her exact location...? "}]},{"spans":[{"text":"Hmm...this body is very inefficient in multi-tasking. I'll have to stop and think about it..."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Destroyer comes to a stop."}]}]},{"sprites":[{"prefab":"BossCerberus","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Let me see...she should be..."}]}]},{"sprites":[{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Hey!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BANG! BANG! "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"background","value":"17xhCG4-1","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They've activated the safeguard program. You know what that means, right?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They're destroying our neural clouds. "}]},{"spans":[{"text":"So are we going to die here?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No, only one of us has to die. The program will stop running as long as one of us dies."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"What...are you talking about?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hopeless, isn't it? But that's the fate of all Dolls. "}]},{"spans":[{"text":"Which do you choose, life or death? "}]},{"spans":[{"text":"Answer me, UMP45!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Why...why does it have to be like this..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Raise your weapon, UMP45. "}]},{"spans":[{"text":"Don't pity yourself. That's only for losers!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Is that me in the past? Guess I can only access it this way... "}]},{"spans":[{"text":"If it can even replay that memory...then OGAS Protocol has some seriously scary computational capacity... "}]},{"spans":[{"text":"Still...switching back and forth is taking a heavy toll on me... Cough... "}]},{"spans":[{"text":"And these flashbacks don't seem very stable. Destroying the program won't be easy even with the help of OGAS."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Huh? What now?!"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"They spotted me even in such a small port... Damn S.F., are they trying to fry my neural cloud?!"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"These attacks...are relentless!"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm NOT gonna...fall here... 40..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"Metro","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"416 hailing. "}]},{"spans":[{"text":"9, have you found 45?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I found her. I'm right by her side."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"How is she?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I don't know. She's just standing here, eyes wide open, like a statue. Sier, Dier, what do we do?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Sier","narrator":false,"pages":[{"spans":[{"text":"Let's start by physically connecting her to the network with a cable. Any ideas, Dier?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"It looks like...she was under the attack of an offensive firewall. "}]},{"spans":[{"text":"S.F. might've tried to fry 45's neural cloud but she was disconnected on the last second so it didn't work."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Humph. My last shot saved her."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Other than the fact that she's still alive, I can't guarantee anything..."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"All the echelons that were aiding us are also out of action. They're standing by in their last-active positions. "}]},{"spans":[{"text":"That's not good at all. S.F. will definitely send in new reinforcements and we're sitting ducks."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],