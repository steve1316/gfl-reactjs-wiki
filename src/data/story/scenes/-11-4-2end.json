xt":"But we need your help. It's all on you, Squad 404!"}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"We practiced this before we set off... "}]},{"spans":[{"text":"I hope you still remember how it's done."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Tsk... To be honest, I don't like that place."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Since when do you grumble so much? "}]},{"spans":[{"text":"You're becoming more and more like me."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Shut up!"}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Alright, alright, get off each other's throat! "}]},{"spans":[{"text":"Let's bring 45 back and make it home together!"}]}]}]}
