:[{"text":"With just a bit more careful cultivation, I'm sure she will greatly boost our figures!"}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"The one-eyed girl? Very well. Watch her closely."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Garren","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Pentacles","narrator":false,"pages":[{"spans":[{"text":"Things have also been going smoothly on my end. The key target is very compliant. We will most certainly be able to meet the projected figures."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"delay","raw":"Delay"}],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"Next."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Cups","narrator":false,"pages":[{"spans":[{"text":"O Your Handsome, Dapper, Snazzy, Demonic Highness..."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"I get it. Your results are dangerously underwhelming."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Cups","narrator":false,"pages":[{"spans":[{"text":"I have yet to find a suitable target, but I have a feeling—"}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"Haha, toss her into the shredder."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"sfx","value":"AVG_Thunder_Dry","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Fae of Cups","narrator":false,"pages":[{"spans":[{"text":"No! My Lord! Your Highness, please give me another—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Krrrrrrrrk... "}]},{"spans":[{"text":"The torn-up pieces of the Fae of Cups flutter in the air."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"Next."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Blade","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Fae of Swords","narrator":false,"pages":[{"spans":[{"text":"M-My Lord, I am working to further the plan according to your instructions. Everything is going well at the moment. "}]},{"spans":[{"text":"My progress may not be comparable to some of the others, but I am certainly not the bottom of the pile!"}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"Humph."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Laplace's Demon lets out a cold snort. All the faes present, as well as the fragments of the Fae of Cups, fall silent."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"If we succeed in our task, Lady Lunasia will be reborn... "}]},{"spans":[{"text":"And our work will be completed for good..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A happy but fickle smile spreads across Laplace's Demon's face. She waves her sword, and the fragments of the Fae of Cups scattered on the floor come together again."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Cups","narrator":false,"pages":[{"spans":[{"text":"(Sobs) Thank you, My Lord. I will never forget your grace and generosity..."}]}]},{"sprites":[{"prefab":"NPC-DemonLaplace","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Laplace's Demon","narrator":false,"pages":[{"spans":[{"text":"Do your job properly. "}]},{"spans":[{"text":"Don't forget—this is all for the sake of Lady Lunasia."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Chalice","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Cups","narrator":false,"pages":[{"spans":[{"text":"Yes, for Lady Lunasia."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"bgm","value":"BGM_AuguriesofInnocence","raw":"BGM"}],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"The game is about to begin. "}]},{"spans":[{"text":"Where are you, my sweet target?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"235","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Oh! The memory remains frozen here. Got you..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seawater has filled all the space beyond the orb of light. It almost feels like being in an underwater palace. "}]},{"spans":[{"text":"M4 nods toward M16, who has dragged all the unconscious Sangvis units closer to M4. As the Starfish System begins to dim, the blue sphere also shrinks gradually."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Are you sure you can do it?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"As long as we live, the future will have endless possibilities."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Even if our physical forms are lost, we will still meet again some day."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Will we, really?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Certainly. Promises transcend time and space. Whichever dimension I end up in, I will be waiting for you on the other side."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Starfish has reached criticality and eventually explodes. "}]},{"spans":[{"text":"In that instant, the orb of light shrinks rapidly, and the blue radiance becomes blindingly bright. The seawater outside starts riling and boiling. "}]},{"spans":[{"text":"The Dolls are also set ablaze and eventually disappear altogether along with the light..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"M4... "}]},{"spans":[{"text":"Do you still remember the beautiful dream that you were pursuing? "}]},{"spans":[{"text":"I don't think I ever believed in \"miracles\". Back then, I simply couldn't bear to let you down..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"If I had known the cruelty that \"hope\" would bring upon us... "}]},{"spans":[{"text":"I would have definitely stopped you. "}]},{"spans":[{"text":"No matter the cost."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"1","raw":"CGDelay"},{"type":"background","value":"462","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"At last... I found you at long last..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...M4?"}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Hello, Miss M16A1. The Fae of Wands, at your service."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A card hovering in mid-air bends humbly, as if performing a bow."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Fae of Wands? Where am I?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"This is a world filled with beauty and hope, where the power of love will make all dreams come true for the pious!"}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"sfx","value":"AVG_Cheerful","raw":"SE1"}],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"TAROT PARADISE!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"No darkness, no injustice. As long as you work hard enough, you will fulfill your wish. "}]},{"spans":[{"text":"You will get to meet this Miss M4A1 that you just mentioned."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...M4 is here as well?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"...Perhaps. "}]},{"spans":[{"text":"That depends mainly on how much work you're willing to put in."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I just stepped through the Starfish... How did I end up here?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"I suppose it must the work be fate."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"It's alright. I know you still have a lot of questions, but feel free to explore this place and take a look around yourself."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Okay."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Before you embark on this wondrous journey, please accept a blessing from me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A black hole starts swirling like a maelstrom around the Fae of Wands..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Tinnitus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"All of a sudden, a beam of dazzling starlight spills out from the center of the black hole, like an opening that has ripped through the void. The black hole stretches on and on in a bizarre fashion... "}]},{"spans":[{"text":"Until it turns into a thin card and flies toward M16's forehead."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":1,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Wha—?!"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_magic_circle_start","raw":"SE1"},{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"183","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The starlight suddenly flashes so intensely M16 cannot keep her eyes open. "}]},{"spans":[{"text":"She feels a pinprick sensation on her forehead. The starlight instantly vanishes, and a colorful card drifts lightly into her head through the center of her brow."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the strange sensation spreads all over her body, the world before her eyes also starts distorting... transforming..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"703","raw":"BIN"},{"type":"backgroundMove","value":"%%pivot_x=0.64%%pivot_y=0.42%%scale=1.4%%duration=0%%","raw":"bg_move"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Until it freezes at a curious state that looks almost like a freshly drawn oil painting."}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"You are very fortunate to receive the Blessing of the Major Arcana. You have been given a new power."}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What's it for?"}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Everyone who enters this place is given a unique blessing. "}]},{"spans":[{"text":"Those who receive the Blessing of the Major Arcana are assigned their own authority and corresponding image. "}]},{"spans":[{"text":"Those who receive the Blessing of the Minor Arcana are not so lucky. "}]},{"spans":[{"text":"All they have is a dull number or symbol. They look very similar to me, so it's quite easy to mix us up."}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"You will understand when you see them. Please make sure you recognize me. I have no numbers, after all~"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 gives a non-committal nod."}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"So how exactly should I \"work hard\" to make my wish come true?"}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Very simple~ "}]},{"spans":[{"text":"You just have to \"collect\" different cards, the way heroes collect treasures in the legends. "}]},{"spans":[{"text":"Once your collection is complete, you will obtain the Lord's favor! "}]},{"spans":[{"text":"Then the Lord will grant your wish, no matter what it is!"}]}]},{"sprites":[{"prefab":"M16A1Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}},{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Are you done with the info dump?"}]}]},{"sprites":[{"prefab":"NPC-Tarot_Leangle","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[],"speaker":"Fae of Wands","narrator":false,"pages":[{"spans":[{"text":"Yes. As I said, this is a simple world where all is bright and beau—"}]}]},{"sprites":[],"ops":[{"type":"sfx","val