sly."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":12,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...You should know the truth."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow shrinks back fearfully in M4's increasingly intimidating presence, but she stumbles into something."}]},{"spans":[{"text":"She whirls around without thinking and finds herself looking at a mirror."}]},{"spans":[{"text":"In the mirror is the reflection of an unsightly corpse thrashing in sludge."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"No... no... NO!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow starts screaming hysterically, and the corpse mirrors her movement."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I am not a failure... I'm not! I'm not!"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Impossible! It can't be! If I'm a failure, what are you?!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 watches Morridow's panic with indifference."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":12,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Does it matter?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"shown":true,"side":"left",