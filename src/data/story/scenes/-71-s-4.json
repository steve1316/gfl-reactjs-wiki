o one."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Each of the Nytos born from the \"Cocoon\" has her own desire."}]},{"spans":[{"text":"Machlian wishes to return to the human world."}]},{"spans":[{"text":"Morridow yearns for absolute freedom."}]},{"spans":[{"text":"What about Badbsca?"}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Badbsca thinks to herself..."}]},{"spans":[{"text":"What could my desire be?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
