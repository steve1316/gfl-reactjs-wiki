{"name":"-75-A-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_stage11","raw":"BGM"},{"type":"background","value":"725","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The entrance to the White Zone in Frankfurt is under heavy guard."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several security checkpoints line up in a row, with fully armed soldiers and autonomous security droids patrolling each channel."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ever since the Commander forced their way through, the security level has clearly been raised."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev and Kalina stand at the edge of the square beyond the checkpoint, quietly observing the fortified defenses. "}]},{"spans":[{"text":"Tokarev wears a long coat that conceals most of her Doll features, but hiding her identity completely is impossible. "}]},{"spans":[{"text":"Kalina bites her lip and frowns deeply."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"This is worse than I expected... "}]},{"spans":[{"text":"Those scanners are the newest Doll-identification models. "}]},{"spans":[{"text":"The moment you get close, they'll flag you."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Technically speaking, I currently qualify as an \"unauthorized Doll\". If I'm detected... "}]},{"spans":[{"text":"Miss Kalina, I can hide somewhere nearby. You can enter alone—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina shakes her head firmly."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"No, I need you. "}]},{"spans":[{"text":"And splitting up is too dangerous."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She rummages in her pocket, but finds nothing useful. "}]},{"spans":[{"text":"In the end, she pulls out a green card. She gives a weak, bitter laugh."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"This is...?"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...A gift from the boss—permanent residency for the Green Zone. "}]},{"spans":[{"text":"It guarantees me a comfortable life there, but right now it's useless for getting into the White Zone. "}]},{"spans":[{"text":"How did you get in two days ago?"}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Two days ago... when the Commander led us into the White Zone, there were several... Dolls whom I didn't know personally, but they didn't seem to be strangers. "}]},{"spans":[{"text":"They disrupted the security system using some kind of electronic warfare."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A spark of understanding flashes through Kalina's eyes."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"404... Of course. They would definitely assist the Commander."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"You know them?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina nods, then sighs in frustration."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...I haven't seen any of them since I got here. "}]},{"spans":[{"text":"Not just them—the AR Team, Task Force DEFY, and other Dolls who technically aren't under IOP jurisdiction... I can't find any of them. "}]},{"spans":[{"text":"It's like they all just... disappeared."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Maybe they're also searching for the Commander. "}]},{"spans":[{"text":"Or maybe..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She trails off, but Kalina understands the implication instantly—they might already be under government control. "}]},{"spans":[{"text":"The thought drains even more color from her face."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Either way, right now we're on our own. "}]},{"spans":[{"text":"...I may have to contact Mr. Kryuger again."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"...Are you certain? "}]},{"spans":[{"text":"Mr. Kryuger has already made it clear that he doesn't want you involved."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"He talks tough, but he's never refused one of my requests. "}]},{"spans":[{"text":"Not to mention... he cares about the Commander too."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina steps aside and activates her communicator."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev stays alert nearby, but she remains within earshot."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Connection established."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.4","raw":"CGDelay"}],"speaker":"Kryuger","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Kalin?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I told you to rest, didn't I?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, I need your help."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"If this is about the Commander, I thought I'd made myself clear yesterday—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"All I need is a temporary White Zone pass. Just this once."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"White Zone? Where are you right now?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I—"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"You should be on a plane back to the Neo-Soviet Union, Kalin, not making trouble in Frankfurt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I'm not quitting the investigation, Mr. Kryuger. The Commander isn't just my superior, they're my—"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"The Commander is dead, Kalin.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Go home before you get yourself in trouble.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"The Commander is not dead!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"bgm","value":"BGM_23S_War_Sacrifice","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...If you won't help me, I'll find another way."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Kalin... the Commander wouldn't want you putting yourself at risk.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Listen to me, just this once. Let it go. Go home.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":"Kalina","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Thank you for taking care of me all these years. "}]},{"spans":[{"text":"But this time, I must stand by my own decision."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"If you insist... I'll revoke your access permits.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Not as a threat, just to keep you from walking into danger.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I understand."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Goodbye, Mr. Kryuger."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina ends the call, takes a long breath to steady herself, and returns to Tokarev."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...He won't help us."}]}]},{"sprites":[{"prefab":"NPC_TT33","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger might be right. "}]},{"spans":[{"text":"The Commander... cared deeply about your safety."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina gives a strained, bittersweet smile."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"But I don't need protecting, Tokarev. "}]},{"spans":[{"text":"What I need is the truth. I need to know what really happened to the Commander. "}]},{"spans":[{"text":"If the Commander truly fell, I need to confirm it with my own eyes. And if the Commander is alive, then I can't stop searching. I'll stand by their side. "}]},{"spans":[{"text":"This isn't an impulsive decision. I've thought this through—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Motorcycle","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hummm... "}]},{"spans":[{"text":"A black sedan glides toward them, interrupting her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It stops directly in front of them. The window rolls down, revealing a familiar face."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21summer_avg_Demon","raw":"BGM"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Miss Kalina. What a coincidence meeting you here. "}]},{"spans":[{"text":"It seems you're having trouble entering the White Zone?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Havier's polite smile doesn't reach his deep, unfathomable eyes."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina freezes for a moment, then instinctively steps forward to shield Tokarev behind her. "}]},{"spans":[{"text":"But Havier's gaze has already slipped past her, settling on Tokarev."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"And... an IOP T-Doll who's supposed to be deactivated. "}]},{"spans":[{"text":"Now that's... an interesting combination."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev tenses, ready for any sudden threat. "}]},{"spans":[{"text":"Kalina swallows hard but keeps her back ramrod straight."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Mr. Havier, I can explain—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He raises a hand, cutting her off with a half-smile."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"No need, Miss Kalina. "}]},{"spans":[{"text":"I happen to be heading to the White Zone for some official business. "}]},{"spans":[{"text":"If you don't mind, perhaps I can offer you a ride?"}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina and Tokarev exchange a long look. "}]},{"spans":[{"text":"Neither expected Havier to overlook Tokarev's presence so casually, let alone offer help. His intentions are unreadable. "}]},{"spans":[{"text":"...But this may be their only chance to enter the White Zone."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Don't worry. I won't hand you over to anyone. "}]},{"spans":[{"text":"I'm merely offering assistance. "}]},{"spans":[{"text":"But you don't have much time—security will notice this little scene soon."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina takes a deep breath and comes to a decision."}]}]},{"sprites":[{"prefab":"NPC_Kalina_OL","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,-90"}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Thank you for your generosity, Mr. Havier. "}]},{"spans":[{"text":"We'll accept your help."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Havier nods as the car door unlocks."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Then get in. "}]},{"spans":[{"text":"Time is short, isn't it?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina and Tokarev approach the vehicle. Tokarev scans the interior for potential threats. "}]},{"spans":[{"text":"Despite their unease, they have no choice but to board this car—toward the White Zone, toward the place that might hold the truth."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Close","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The door closes, and the black sedan drives smoothly toward the White Zone checkpoint."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
