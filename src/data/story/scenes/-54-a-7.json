G_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then she walks up to the cubicle door and opens it with great determination."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022summer_DiningCar","raw":"BIN"},{"type":"bgm","value":"10254","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She runs straight into a burly man the moment she is out."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He is aiming an M500 right at Lyudmila's face. "}]},{"spans":[{"text":"Lyudmila recognizes this man. He was in the first-class carriage. "}]},{"spans":[{"text":"The man gazes at her with narrowed eyes."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"...T-Doll? "}]},{"spans":[{"text":"You're the retired military instructor in the first-class carriage."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Danil watches Lyudmila with distrust, his grip tightening on his gun."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"...You're alone? There's no one else with you?"}]}]},{"sprites":[{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...It would seem so."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man has been checking their surroundings even as he questions her. "}]},{"spans":[{"text":"Throughout the conversation, he has been keeping a safe distance away from Lyudmila, and his gun has never once wavered."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"You must be armed, aren't you? Hand over your weapon. Don't play any tricks."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Keeping her hands completely visible, Lyudmila removes her pistol from its holster and hands it over to Danil with the muzzle pointed at herself."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"Put it on the floor and kick it over to me."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clack."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Danil promptly picks up the pistol and rises back to his full height in the same second, his gun still trained on Lyudmila."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"His stows the confiscated pistol away, then tells Lyudmila to put her arms in the air and searches her. "}]},{"spans":[{"text":"After a very thorough pat-down, he is finally satisfied."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"Move. We're leaving the restroom. You go first."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila walks out of the restroom. "}]},{"spans":[{"text":"These people have seized complete control over the dining carriage. "}]},{"spans":[{"text":"Several humans held at gunpoint are kneeling on the floor to one side with their hands in the air."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The hostages... seem to be safe for the moment. Everyone is accounted for. A total of six vory are guarding them, two of which are armed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the other side... "}]},{"spans":[{"text":"...are the Dolls with their comms and movement modules removed. They are also being held hostage by a few retired Military droids. "}]},{"spans":[{"text":"Four of them, all obsolete and decommissioned. Looks like they got sold on the black market... In principle, their fire control core should have been removed, and yet they are all armed, so better not count on that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila's gaze falls on an old woman. "}]},{"spans":[{"text":"She has seen her in the first-class carriage earlier. Right now, she is sitting in the most prominent seat, surrounded by the other gangsters. "}]},{"spans":[{"text":"Lyudmila's eyes narrow. "}]},{"spans":[{"text":"...This is Baba Lyuba."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"Don't get any silly ideas, Madam Instructor. "}]},{"spans":[{"text":"It's best to be cooperative. We're just here to procure some goods. Surely you won't do anything stupid."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Danil pushes Lyudmila over to the tied up Dolls by the window and forces her to sit down."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She turns her head to look at a young man standing on the other side. Unlike his gleeful companions, he has a rather dour look on his face."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nikolai scoffs at Danil's cautious movements."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"Do you have to be so careful handling a woman? "}]},{"spans":[{"text":"You make a show of every little thing you do, don't you?"}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"A gentle reminder that this is a T-Doll."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Chains_Break","raw":"SE1"}],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"...Cuff her. I'm reporting this to Baba."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"...You giving me orders now?"}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"...Could you please help me cuff her, Mr. Nikolai?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nikolai takes the handcuffs reluctantly. "}]},{"spans":[{"text":"He glowers bitterly at Danil's back as he walks towards Baba Lyuba."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"...How dare he talk to me like that. "}]},{"spans":[{"text":"He's treating me as if I were a Doll..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nikolai now redirects his anger at Lyudmila."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"T-Doll... What's the big deal? "}]},{"spans":[{"text":"You don't even have fully bionic skin."}]}]},{"sprites":[{"prefab":"AR18","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila's intense gaze only further fuels Nikolai's irrational rage."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"—Stay still!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a flick of his wrist, Nikolai slaps the metal cuffs around Lyudmila's wrists roughly and is just about to engage the locking mechanism..."}]}]},{"sprites":[{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"—You know, you should really listen to him."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10256","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"THUNK!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"Wha—Huh?!"}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It all happens in the blink of an eye."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a thrust of her arms, Lyudmila draws blood by bashing her metal cuffs into the back of Nikolai's head."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Nikolai cries out in pain, she wraps the chain tightly around his neck and starts strangling him."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"Guh... argh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"His bulging veins form a web on his neck. "}]},{"spans":[{"text":"His face turns an angry red; even his eyes become bloodshot."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The vory have all raised their weapons, but no one dares pull the trigger—because Lyudmila is completely obscured behind Nikolai. "}]},{"spans":[{"text":"Baba Lyuba's features darken as she takes in the scene. "}]},{"spans":[{"text":"Gazing at Lyudmila, she speaks in a sinister whisper."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"...Let him go."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"D... don't shoot..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nikolai squeezes out these words with great difficulty as he looks fearfully at his companions."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Baba Lyuba watches as Lyudmila slowly backs away using Nikolai as a shield. Her eyes gleam ruthlessly."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She wipes away an non-existent tear from her right eye with a finger."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"—Fire."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The old woman's soft command is completely drowned out by Nikolai's pitiful howls. "}]},{"spans":[{"text":"However..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang, bang, bang!!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rat-tat-tat!!! "}]},{"spans":[{"text":"All the vory pull their triggers on Baba Lyuba's command."}]}]},{"sprites":[{"prefab":"NPC-NervousMan","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"Argh!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Metal_Break","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, Lyudmila takes off her handcuffs and shoves Nikolai away."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"sfx","value":"AVG_Gatling_gun","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang, bang, bang! "}]},{"spans":[{"text":"The hail of bullets hit the liquor cabinet, the walls, and the ceiling. Nikolai rolls quickly across the floor and somehow remains completely unscathed."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Without making any superfluous movements, Lyudmila dashes towards the carriage past the bar counter."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"After her!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Baba Lyuba gives the order through gritted teeth as she glares at Lyudmila's receding figure."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
