{"name":"-50-2-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Theatre","raw":"BIN"},{"type":"bgm","value":"2022_white_valentine_BGM2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Great Hall, Griffin Base."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After the final chord is struck, Falcon sits silently, soaking in its echo, and only opens her eyes when the Commander applauds."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"I knew I shouldn't have expected anything less from my Little Lamb... "}]},{"spans":[{"text":"But I never thought you'd hire the entire hall just to listen to my recital."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I didn't exactly hire the place. You give me too much credit. "}]},{"spans":[{"text":"It just wasn't booked to begin with."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"Not much of a charmer, are you, Little Lamb? "}]},{"spans":[{"text":"But that's alright, this has already made me very happy. And with the chocolate you gave me, I must do something to return the favor."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I didn't do this expecting a gift in return."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"And I'm not giving you a gift just to even the score, Little Lamb."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Falcon smiles as she walks down the stage."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"What do you want, Little Lamb? "}]},{"spans":[{"text":"I might just give you something with quite a lot of sentimental value."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Huh...?"}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"Haha."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Falcon takes great delight at the Commander's discomfort and happily hangs her guitar over the Commander's neck."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"This is my very first guitar, Little Lamb. "}]},{"spans":[{"text":"She is slowly losing her sweet timbre and can no longer play beautiful music with me. "}]},{"spans":[{"text":"Cherish her. She has been through a lot with me... Treat her the way you treat me."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Thank you for your trust. "}]},{"spans":[{"text":"I will keep her safe."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"Of course you will, Little Lamb."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Falcon retrieves the pick from her guitar and waggles it in front of the Commander's face. Then she turns around and starts heading for the door."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"If you want to hear me play again, remember to make a booking."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If the great hall is available, I definitely will."}]}]},{"sprites":[{"prefab":"Falcon","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Falcon","narrator":false,"pages":[{"spans":[{"text":"Happy White Day."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
