{"name":"-62-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"8","raw":"BIN"},{"type":"bgm","value":"BGM_22Swim_langrensha","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin ops room, late at night."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The black coffee on the table has cooled long ago. "}]},{"spans":[{"text":"The Commander anxiously contemplates the issue, tapping the table occasionally, creating ripple after ripple in the mug."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"No good, still no answer..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina looks at the notification on the big screen, worry written all over her face."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Could they have clocked off by this time? "}]},{"spans":[{"text":"Maybe we should ask Miss Persica—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"She's occupied with a project of hers. If you were willing to make her coffee for a lifetime..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Perhaps the issue isn't so pressing after all."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep. "}]},{"spans":[{"text":"Call answered!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander suddenly leaps up with excitement."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Thank goodness! "}]},{"spans":[{"text":"Dier, we've got trouble!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dier turns on the light, still drowsy. The image feed of a young face with scruffy hair comes through."}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"(Yawn) Oh, it's the Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Is it another night where you wanted to play video games when it's time to sleep? Tonight's no good...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No! The supplementary exam program we asked you to make before has an error..."}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Huh?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dier frowns, no longer lethargic."}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"An error in a program I made myself?!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Absolutely impossible!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Did one of you people at Griffin touch something you weren't supposed to? Did you follow the instructions?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalin, send him the recordings."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina immediately sends through the recording files from the program."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"563","raw":"BIN"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"UMP45Mod","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45?","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Can you really call yourself an elite Doll with performance like that??"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"8","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Eh? T-this...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Give me a moment!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dier frantically dons his equipment."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The pitter-patter of keyboards and humming of machines comes through the other end of the call."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After waiting for what feels like a century, Dier finally returned to the camera."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How is it?"}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Tsk... How to explain this...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Looks like I embedded the code for 404's demon-training program into it...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Demon-training program?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dier scratches his head."}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"So, basically...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In order to improve 404's combat capabilities, 45 asked me to create a simulated combat program.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The core of the program consists of repeatedly cycling combat scenarios to really bring out a Doll's maximum potential.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Every three combat scenarios is a cycle. Every cycle, the combat scenario's difficulty doubles.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Even worse, no matter how well a Doll performs in any given cycle, 45's AI will pop out, saying \"No, that's not perfect enough,\" and on the cycles go...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So how can the cycle be ended?"}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"That.. the system will automatically exit when all Dolls become incapacitated.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What the hell?!"}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Don't jump to any conclusions, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"That's how it's supposed to work, but I can create a workaround.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Like maybe... a patch for the system that will stop the cycle after the current one ends. That should...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well get on with it!"}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Okay, okay! Give me 5 minutes!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dier departs from the camera's field of vision again. "}]},{"spans":[{"text":"The Commander sighs."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalin, you go first and wait at the exam room, I'll send the patch over the moment I get it. Install it as soon as you can! "}]},{"spans":[{"text":"A second later and they might enter another cycle, with everything that it comes with..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Got it! "}]},{"spans":[{"text":"But I have one little question. How are we supposed to explain all this when they're out?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thinking back to the combat footage and the surely furious expressions of the Supplementary Exam Squad... The Commander feels a creeping chill up their spine. They swallow with some difficulty, taking a breath and steadying their nerves."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Don't worry, Kalin. "}]},{"spans":[{"text":"Leave it to me, I'll explain it to them myself! "}]},{"spans":[{"text":"For my sake, if I apologize earnestly, perhaps they will put it behind— "}]},{"spans":[{"text":"No, I'm sure they will!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Mm... looks like that's all we can do. "}]},{"spans":[{"text":"I'll head over, then! Be strong, Commander!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander nods, watching as Kalina's silhouette disappears out the door..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
