{"name":"-44-A2-5-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"46","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At Ange's accommodation in Berlin. "}]},{"spans":[{"text":"It's deep into the night, still two or three hours away from daybreak. "}]},{"spans":[{"text":"Ange and her subordinates are in varying states of disheveledness, but they have finally made it back. "}]},{"spans":[{"text":"From the moment they left the storage facility, Light has been following Ange without a word. "}]},{"spans":[{"text":"He silently escorts Ange, who is just as silent, all the way to the safe house."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He shadows Ange's footsteps until they reach Ange's door. The other Stasi members have returned to their original posts, but Light seems intent on staying. "}]},{"spans":[{"text":"Ange comes to a halt in front of her door."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"This will do."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I will be staying here tonight—in the room next door."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light sidesteps Ange's pointed remark expressionlessly."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What, worried that I'll go blow up another warehouse?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Not at all. "}]},{"spans":[{"text":"It's just that my elder sister has already gone to bed and I do not wish to disturb her."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh? You have a sister? Is she also in the Stasi?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"...No, she's a reporter."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"A reporter?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Indeed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange gazes at Light, her hand still resting on the door handle. "}]},{"spans":[{"text":"Light returns her gaze evenly. He doesn't plan on letting Ange out of his sight until she has entered through the door. "}]},{"spans":[{"text":"Considering what just happened...Ange has nothing to say about that. "}]},{"spans":[{"text":"She pauses for a long while before finally letting go of the door handle. She leans on her elbow against the door and decides to clear the air."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Look, I'm really sorry about tonight. "}]},{"spans":[{"text":"I acted without permission and caused you trouble."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light blinks—he is not expecting this at all. "}]},{"spans":[{"text":"Angelia doesn't strike him...as someone who would ever apologize."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"No...it's alright. "}]},{"spans":[{"text":"I know you don't trust me. That's completely understandable. "}]},{"spans":[{"text":"I know what you've been through in Bremen. "}]},{"spans":[{"text":"Paradeus has already infiltrated the top strata of German politics, now even Gray has proved to be unscrupulous. "}]},{"spans":[{"text":"I cannot fault you for being cautious under such circumstances."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange raps her knuckles against the door while pondering what to say in response. Honestly, Light is not wrong about her—she isn't one to apologize. "}]},{"spans":[{"text":"She is not particularly good at it, but looking at this young man, she believes she owes him this much."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"When that young woman first joined me, she was just like you. "}]},{"spans":[{"text":"Young, eager, ambitious. You remind too much of her."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"...But I will never go against you or try to take your life on a plane."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Haha. "}]},{"spans":[{"text":"What, so you're a good boy?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I don't think I'm particularly good. "}]},{"spans":[{"text":"I often make my sister angry. To her, I'm a rebellious baby brother."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It's not always a bad thing to be a rebel. However, you shouldn't rebel just for the sake of it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange grabs hold of the door handle again."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You saved us today. Thank you. "}]},{"spans":[{"text":"However, I will not stop relying on my judgment."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I do have faith in your judgment. "}]},{"spans":[{"text":"If you require my services, please just ask."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Now go get some rest. We have much to do tomorrow."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange enters her room."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Goodnight, Miss Ange."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing that Ange is safely inside her room, Light turns around and is ready to retire himself. "}]},{"spans":[{"text":"In the silent corridor, the overhead lamp seems dimmer than usual."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"His Stasi colleagues are standing guard on the first and second floors. "}]},{"spans":[{"text":"This building has always been the accommodation of important foreign dignitaries, so the higher floors are almost never staffed. "}]},{"spans":[{"text":"Right now, apart from Ange and her Dolls, it's completely empty. "}]},{"spans":[{"text":"It's only normal that it's quiet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light grasps the handle on his own door and gently turns the lock. "}]},{"spans":[{"text":"...However, he can't shake off this odd feeling. "}]},{"spans":[{"text":"There is something unusual...about this silence today."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss An—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light turns around in alarm and finds a figure towering over him."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"Paradeus Soldier","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"276","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_20Winter_Door_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Once inside her room, Ange isn't at all surprised to find AK-12 sitting next to the window."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"How unlike you to have a heart-to-heart with the young man. "}]},{"spans":[{"text":"I'm almost touched."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Shouldn't you be standing guard outside with the others?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm wounded and deserve some rest. "}]},{"spans":[{"text":"Besides, I have a feeling you'd want to talk."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange walks around AK-12 and draws the curtains before sitting down on the chair next to the bed."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You're too tense."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Are you my psychotherapist now? I thought only RPK was into this sort of thing."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I've studied up on analyzing human body language. "}]},{"spans":[{"text":"You've always avoided windows, but you didn't tend to deliberately sit facing the door when we're around."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I can't tell if I'm in Berlin or Paradeus' den anymore. "}]},{"spans":[{"text":"Perhaps there's no distinction between the two."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You need help, Ange. "}]},{"spans":[{"text":"You can't topple Paradeus single-handedly. "}]},{"spans":[{"text":"I'm not trying to put in a good word for the whelp, but he was referred to us by J and K. "}]},{"spans":[{"text":"And if it hadn't been for him today, we would've met our end then and there."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I know... Light can be trusted, that much I can tell. "}]},{"spans":[{"text":"But as I've said before, his trustworthiness is moot because as long as there's a single spy working under him, I can't possibly let him in on our entire plan. "}]},{"spans":[{"text":"Unless he ditches everyone else."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Worst case, you still have us. We may be called \"DEFY\", but we will never betray you. "}]},{"spans":[{"text":"Oh, there's the Griffin Commander as well."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I'll give the matter of Light some more thought."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":16,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's more like it. That's the Ange I know."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":16,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Compared to Bremen, we have a much clearer objective this time. "}]},{"spans":[{"text":"I'm confident that we'll be able to find out William's plan by going after Gray. "}]},{"spans":[{"text":"This woman is the key."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"We mustn't let her succeed, no matter what she's after."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Indeed, we mustn't. "}]},{"spans":[{"text":"We cannot let him put his terrorist attack into action."}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Speaking of which, I was just going to ask if you..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"AK-12 stops abruptly mid-sentence."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...12?"}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Enemy attack."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Broken_Glass","raw":"SE1"},{"type":"bgm","value":"10230","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crack!"}]}]},{"sprites":[{"prefab":"AK12","expression":17,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange, get down!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang bang bang!! "}]},{"spans":[{"text":"The window covered by the curtains is suddenly smashed by the massive intruder. Ange reflexively rolls across the bed to the other side and draws her pistol behind cover."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But AK-12 has already swiftly slit the throat of the intruder."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Flash_Bomb","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clang..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"A projectile!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_The_Division_Flash_Bomb_Explosion","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"(Wheezes) "}]},{"spans":[{"text":"Goddammit... Tear gas..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While Ange is scrambling to find a towel, her door is kicked open. "}]},{"spans":[{"text":"AK-12 trains her rifle on the door and is just about to pull the trigger..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss Ange! "}]},{"spans":[{"text":"(Coughs)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But it turns out to be Light, who is also on high alert. "}]},{"spans":[{"text":"His face splattered with blood, he is holding a small knife in one hand and a pistol in the other."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss Ange, we have to move! "}]},{"spans":[{"text":"We're under attack!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh, I'm not blind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange spots the corpse of a Paradeus soldier lying just outside her door. "}]},{"spans":[{"text":"And the one that AK-12 has just disposed of... She's seen these units before. "}]},{"spans":[{"text":"Paradeus Strelets. "}]},{"spans":[{"text":"Dammit... She should've seen this coming. "}]},{"spans":[{"text":"That woman won't let her off the hook just like that."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, gunshots ring out around the corner down the corridor. Light retreats into Ange's room."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Where's RPK and the others?!"}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm trying to reach them..."}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"delay","value":"1","raw":"Delay"},{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Damn! Signal is being jammed!"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Same here. I can't call for support at all, and the alarm has been disabled."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Looks like I pissed her off big time."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange tuts and reloads her pistol."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"They aren't exactly being subtle about it, so even if comms are down, people will soon notice the commotion. "}]},{"spans":[{"text":"We'll just have to hold out until reinforcements arrive!"}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...I'm afraid that's not true."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"sfx","value":"AVG_20Winter_Burnfire_Loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crackle..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[{"type":"spark","raw":"火花"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Incendiary bombs. "}]},{"spans":[{"text":"They're planning to burn me to death."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Heat comes crashing in from down the corridor. AK-12 tears off the curtains and watches out for possible attacks from outside the window."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She also hears the sound of crossfires coming from the lower floors."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Crap... The other agents are pinned down too..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"This bit of heat is nothing to me. "}]},{"spans":[{"text":"But if you're dead, there's no point for me to live, is there?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"At this rate... "}]},{"spans":[{"text":"In a matter of minutes, I'll either die of severe burns or hypoxia."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I don't think you'll run out of oxygen, the window is open, after all... Hold on. "}]},{"spans":[{"text":"Can't you escape through the window?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Just in case your brain got smoked, might I remind you that we're on the eighth floor?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"But if Miss AK-12 carries you, she can make it down a floor or two with the help of some tools, right?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What about you?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"They're here for you. If you get out, they'll go after you. "}]},{"spans":[{"text":"I can make my own way out."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Good idea. Unfortunately, I'm currently in no shape to execute such acrobatics. "}]},{"spans":[{"text":"I think our enemies know that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 grabs a glass off the table and tosses it out through the window."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Broken_Glass","raw":"SE1"},{"type":"sfx","value":"AVG_rifle_finalshot_h","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! "}]},{"spans":[{"text":"In the darkness of the night sky, the delicate glass explodes into smithereens."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange will be dead the moment she pokes her head out."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Then we'll have to run the gauntlet down the corridor. "}]},{"spans":[{"text":"We must try to break through their blockade before the fire spreads up here."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Understood. Miss AK-12 and I will spearhead our escape!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Are you mad? It'll take them less than two seconds to vaporize you!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Which means I'll have a second! "}]},{"spans":[{"text":"Your safety is our priority here, Miss Ange!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't be ridiculous!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Wait, stop bickering! "}]},{"spans":[{"text":"Something's down there!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What—?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_lifttable","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While Ange and Light are still arguing, they sense a massive impact underneath their feet. "}]},{"spans":[{"text":"The cracking concrete starts falling under gravity's pull, then the two humans follow suit before they can react."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"(Coughs)"}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What the hell?! Couldn't you think of a better idea?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the split second before landing, AK-12 grabs Ange and cushions her fall with her own body. "}]},{"spans":[{"text":"Her already damaged body produces an ominous crack. "}]},{"spans":[{"text":"Still in a daze, Ange hears AK-12's exasperated gripe, followed by another familiar voice."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"To tell the truth, dear 12, no, I honestly couldn't. "}]},{"spans":[{"text":"They've cut off all access to the eighth floor. Besides, the fire is spreading quickly and I can't risk having Ange use the fire escape."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"RPK16","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...RPK? Where are 15 and 94?"}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"There are Nytos and Paradeus death squads in the lower levels as well. "}]},{"spans":[{"text":"They're good at sneak attacks, which makes them rather tricky even for 15 and 94 together. "}]},{"spans":[{"text":"I reckoned those could be a diversion so I came up on my own, and sure enough."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Ugh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light grips his foot and lets out a groan."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Light?! Are you alright?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Uh... I'm not sure."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rat-tat-tat..."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I'd love to apologize, but this isn't really the time. "}]},{"spans":[{"text":"It's the quickest way I can think of to get you out. "}]},{"spans":[{"text":"The only drawback is how much attention it draws."}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The ONLY drawback? You're too lenient about your own tactic."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Ugh...!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light bites back the pain and gets to his feet. He stumbles immediately and collapses on the rubble again."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You don't look okay at all."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I'm fi... No, you're right. I'm not fine. "}]},{"spans":[{"text":"I must've twisted my ankle."}]}]},{"sprites":[{"prefab":"RPK16","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Uh-oh."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Can you walk?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I can, but...I can't go with you. "}]},{"spans":[{"text":"I'll just slow you down. "}]},{"spans":[{"text":"Let's split up."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What are you talking about? I might as well be sending you to your death!"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Don't worry, it'll take more than that to kill me. After all, I'm the Stasi's \"rising star\". "}]},{"spans":[{"text":"Besides, their target is you, so they'll most likely just ignore me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light flashes Ange a dazzling grin, though Ange has little patience for his charm under these circumstances."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You can dream of being a hero when you're actually asleep. "}]},{"spans":[{"text":"I'm not leaving you behind."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I'd like to say the same to you, Miss Ange. This isn't the time for nonsensical sleep-talking. "}]},{"spans":[{"text":"We don't have much time."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As if to lend weight to Light's statement, Paradeus fires more shots."}]}]},{"sprites":[{"prefab":"Nyto","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"Target located. Execute extermination."}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Here they come."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Dammit... Not giving us even a breather. "}]},{"spans":[{"text":"They're hell-bent on killing me."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"They have squads guarding the other end of the passage. They'll just pin us down if we force our way through."}]}]},{"sprites":[{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...If we're to get Ange out of here... "}]},{"spans":[{"text":"Someone will have to draw their fire."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}},{"prefab":"AK12","expression":18,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Oh my, then I suppose it's time for our great squad leader to shine."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's right."}]}]},{"sprites":[{"prefab":"RPK16","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...Wait, you're being serious?"}]}]},{"sprites":[{"prefab":"RPK16","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It is the only way."}]}]},{"sprites":[{"prefab":"RPK16","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"In your current state? "}]},{"spans":[{"text":"You do know how that'll end for you, right?"}]}]},{"sprites":[{"prefab":"RPK16","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm not an idiot like you. "}]},{"spans":[{"text":"Of course I know."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"It isn't a bad idea, at least you won't be here to boss me around while we're in Berlin. "}]},{"spans":[{"text":"Though Ange will probably get lonely, don't you think?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You want to cover our retreat? "}]},{"spans":[{"text":"No way. I have no spare bodies for you right now!"}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm smarter than the two of you combined. "}]},{"spans":[{"text":"If I say there's no other way, there is no other way. "}]},{"spans":[{"text":"Ange, I've told you many times—you must prioritize your own life. "}]},{"spans":[{"text":"Don't get yourself killed because of a Doll."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"There are battlefields more worthy of your sacrifice."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"RPK."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Hm? ...What are you sending me? Command authorizations? "}]},{"spans":[{"text":"I'm the new squad leader?"}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"For now. "}]},{"spans":[{"text":"If anything happens to Ange, I don't give a damn about what Shaw has got to say. "}]},{"spans":[{"text":"I will make you wish you could access your own base code."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...I am terribly flattered."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss AK-12 and I will draw the enemies in different directions. "}]},{"spans":[{"text":"Once you make it out, the pressure on us will lessen immediately. "}]},{"spans":[{"text":"If you want us to survive, flee as fast as you can."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Don't worry, I'll be fine. "}]},{"spans":[{"text":"With Miss AK-12 drawing most of their fire, I'll do my best to stay alive."}]}]},{"sprites":[{"prefab":"RPK16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Save your breath, Ange. "}]},{"spans":[{"text":"Look, they're volunteering as tributes. "}]},{"spans":[{"text":"Besides, even I can't think of a better way."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"side":"left","tags":{}},{"prefab":"RPK16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"side":"left","tags":{}},{"prefab":"RPK16","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...I will get you safely to 15 and 94."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Fine. Let's go."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange sets her jaw and takes one last look at AK-12, who's bracing herself against the corner, and Light, who's sitting on a pile of rubble covered in dust but still smiling at her, before finally turning away and taking off with RPK-16."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss AK-12, take my ammo."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Light tosses all his remaining magazines and micro-explosives to AK-12."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What about you? "}]},{"spans":[{"text":"They say people speak kindly as their death draws near. You're not planning to die here with me, are you?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Of course not. I've simply come to the conclusion that I have a better chance of survival if you have these. "}]},{"spans":[{"text":"I'm just going to sit right here. As long as Frau Ange makes it out or reinforcements arrive, they won't waste any effort on me."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":16,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I see. You've got a decent head on your shoulders. "}]},{"spans":[{"text":"Still, I might just sign off for a while."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"side":"left","tags":{}},{"prefab":"AK12","expression":16,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"...May we meet again in a brave new world, Miss AK-12."}]}]},{"sprites":[{"prefab":"AK12","expression":15,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Cut the crap."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 jams a fully-loaded magazine into the mag well of her rifle and racks the action deftly."}]}]},{"sprites":[{"prefab":"AK12","expression":17,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Time to show those Paradeus brats... "}]},{"spans":[{"text":"What a true Tactical Doll is made of."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
