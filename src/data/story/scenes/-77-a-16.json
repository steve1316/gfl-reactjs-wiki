{"name":"-77-A-16","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_stage11","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"207","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"██/██/2064. At an abandoned factory in Frankfurt. "}]},{"spans":[{"text":"While the interview is taking place at the DDR2 studio, in an industrial district somewhere in Frankfurt."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside a factory that has been abandoned for many years, the sound of dry branches snapping underfoot echoes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the stillness—thick with rust and decay—is disturbed by unwelcome visitors, dust rises like startled ghosts, swirling wildly in the shafts of light slanting in through the broken windows."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Ack! I've got cobwebs stuck to my face!"}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"We're basically like rats, rummaging through garbage in the ruins of the city. "}]},{"spans":[{"text":"Ugh... I don't mind being a rat, but I'd at least like a cleaner place to sleep..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Since we're rats, we'd better dig out all the dirty little secrets that the Earl has hidden in the sewers. "}]},{"spans":[{"text":"Dandelion, are you sure this is the right place?"}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Affirmative. There should be an electronic security door nearby that's still operational.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Ah, I think I found it, but it needs authentication to open."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina is the first to notice the alloy electronic door hidden among the debris."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A low hum can be heard as the indicator light on the control panel blinks faintly."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"With Dandelion around, I guess I don't need to step in, right?"}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Hold on, I'm working on it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion's voice comes through the communicator in Kalina's hand. "}]},{"spans":[{"text":"Kalina had no idea that she is the \"mysterious figure\" AK-12 mentioned—the one relaying messages on the Commander's behalf."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina looks at Dandelion's virtual avatar on the screen, recalling her conversation with Tokarev a few days ago. "}]},{"spans":[{"text":"What Tokarev doesn't know is the Commander's final \"ending\"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Only the Commander and she know... "}]},{"spans":[{"text":"The reason Dandelion lost her body, and why that tank drove down that road."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Um, Miss Dandelion..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_2023Slow_Keyboard_Correct","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"It's done.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The door's unlocked.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"That... that was fast..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Kalina can figure out how to broach the subject, Dandelion has already finished cracking the lock."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The indicator light on the door turns green."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"You looked like you wanted to talk to me in private?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I can pretend that the hack is still underway and keep 45 and the others waiting a bit longer if you want?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"It's not anything important..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Kalina takes a deep breath."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Sorry... It is actually important. "}]},{"spans":[{"text":"Miss Dandelion... is the Commander okay?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The Commander is fine. At this very moment, they're delivering an inspiring speech to all of Frankfurt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, we can't watch the broadcast.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"A speech? What's going on?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"It's complicated, but don't worry. I'm monitoring their situation constantly. I won't let anything happen to them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...So you really have been staying by their side all along, Dandelion."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I have some more good news for you. The neural clouds of Tokarev's squad have been successfully recovered.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Task Force DEFY is securing new frames for them, and they should be rebooted soon.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"R-really? Thank you!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"No need to thank me. It's the Commander's order.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Once they set their mind on doing something, they don't give up until it's done.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I've been so busy doing their bidding, I haven't had any rest in quite a while.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Th-that's right! Once the Commander gets to work, they drag everyone else into overtime—and doesn't even realize it themself!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Which is why, when things finally fall apart, they're usually the first to go down.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Exactly! That's why I'm always so worried about them! "}]},{"spans":[{"text":"Honestly, even when I'm not around, they haven't changed at all."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Are you two done talking? We need to move on."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The door's open. I've also scanned the layout ahead.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The Commander's orders are to infiltrate this facility. I expect guards inside.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Guards? In an abandoned factory like this?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"We won't know if it's truly abandoned or not without further investigation."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Indeed. Stay ready for combat. "}]},{"spans":[{"text":"Gr G11 and M16 will take point. 9 and I will cover the rear. Make sure we keep Kalina safe."}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"If possible, I'd prefer rear guard duty too. It sounds easier than being the vanguard. "}]},{"spans":[{"text":"I'm definitely requesting a transfer once 416 gets back—and taking back all the rest I'm owed."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"794","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"GF_21winter_battle_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"██/██/2064. Underground factory, Frankfurt."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The group takes a narrow freight elevator and soon reaches a warehouse filled with raw materials."}]}]},{"sprites":[],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Careful.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Those are... URNC soldiers? "}]},{"spans":[{"text":"Wait, what's in these crates?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Dandelion?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Without a doubt, these goods belong to Paradeus.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"They thought I wouldn't notice just because there are no markings. How naïve.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"So the URNC is still colluding with Paradeus..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"And this is just one production line. "}]},{"spans":[{"text":"Based on our intel, there are many more facilities like this throughout Frankfurt. "}]},{"