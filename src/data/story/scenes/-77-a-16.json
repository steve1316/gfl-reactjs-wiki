":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"cgDelay","value":"0.6","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang-bang!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"794","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That should be enough of a diversion, right?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"This is more than a diversion—it's a full-on assault.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Did you find what we're looking for?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I've hacked into the factory's main system and found some interesting records.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This production line was active for a short while a few days ago. The goods were shipped to a single location...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This should be the place the Commander has been searching for.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Jackpot. Looks 