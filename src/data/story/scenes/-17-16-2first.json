{"name":"-17-16-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The battle continues, and most of the Griffin T-Dolls manage to successfully escape."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG-BurnCity","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Unforgivable... "}]},{"spans":[{"text":"So close, I was so close..."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"If you had taken care of them from the beginning, you would not be having this trouble now."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":" Agent..."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"At first, you said you would share the mission here with Intruder, but in the end you pushed all the work to Intruder and deserted your post. Now the central database has been breached and several rats are busy reading the data within."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Their aim should be obvious enough. "}]},{"spans":[{"text":"If you had still been watching that location, Lady Elisa would have been much safer."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"Architect, is it? "}]},{"spans":[{"text":"Why are you thinking of that traitor when Sangvis Ferri is facing a crisis?"}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"I simply...wanted to eliminate her with my own hands."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"It was my fault for allowing you to act independently. "}]},{"spans":[{"text":"Intruder has already begun her pursuit. Go help her."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Understood. I'll set out right away. "}]},{"spans":[{"text":"How about you, Agent?"}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"I will help you clear up the mess you've made. "}]},{"spans":[{"text":"While I'm at it, I will also personally bury the foe who has been making trouble for us this whole time... "}]},{"spans":[{"text":"...The Griffin Commander."}]}]}]}
