peaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So the interference was really caused by Sangvis Ferri, but it's so...amateurish. Hard to imagine how S.F. is now in such a sorry state."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Didn't Dandelion mention that S.F. was involved in this mission?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"And you believe her?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The other Dolls don't seem particularly hostile to her."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"First she's related to OGAS, then she's related to the Pike Node. Now this Pike Node is somehow connected to the Butterfly Incident. "}]},{"spans":[{"text":"This thing that's neither human nor machine is the most suspicious subject on the entire train."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"If you're so concerned, why don't you just ask her?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Humph... This Dandelion has already noticed that I've been monitoring M4's neural cloud the whole time."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I know. I could tell many of the things she said weren't directed at the Dolls she was talking to. "}]},{"spans":[{"text":"Just leave it be. You and I both know that you aren't keeping tabs on M4 just to complete Persica's mission."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"What are you getting at?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I'm not sure what you're trying to achieve here, but it's obvious that you have common interests with those Dolls, so why don't you just let those special Dolls handle it? "}]},{"spans":[{"text":"After all, we aren't like them."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You always pride yourself on being an elite, yet you're admitting your inferiority at a time like this?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Change is only natural after going through so much. "}]},{"spans":[{"text":"The AR Team aren't the only ones who have changed. I realized when I came back that even we're not the same. "}]},{"spans":[{"text":"One could easily drown in the past if they refuse to let go. "}]},{"spans":[{"text":"The UMP45 I know would never be stupid enough to make such a mistake."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You're quite chatty today."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"You don't have to listen if you don't want to. I'm just giving you some friendly advice. "}]},{"spans":[{"text":"We'll be entering that submarine base soon. I don't want to drag your tattered body out of there like what happened last time."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I appreciate your concern, now focus on cleaning up the Sangvis corruption in the file."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
