{"name":"-48-1-0","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"10106","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"The mysterious Earl \"Griffin\" has issued the Commander a new mission."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"We all call him the \"Earl\". ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So should you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"You will live until the end. I can sense it. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But I must give you a word of advice. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...Trust no one. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Does that include... yourself and \"the Earl\"?"}]}]},{"sprites":[],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Oh yes. ESPECIALLY him. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"A Nyto named \"Morridow\" is currently plotting a terrorist attack of unprecedented scale in Berlin."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Morridow","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's this mission about?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Find our target and bring her to a designated location."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Bar_Griffin","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"To launch a terrorist attack in Berlin, explosives won't work. "}]},{"spans":[{"text":"It has to be with some kind of new weapon that cannot be detected. "}]},{"spans":[{"text":"A weapon...That we are both familiar with."}]}]},{"sprites":[],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You want me to look into this?"}]}]},{"sprites":[],"ops":[],"speaker":"Griffin","narrator":false,"pages":[{"spans":[{"text":"Once you have settled this business in Berlin, I will give you the location of the mansion."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"New characters have made their entrances in turn. Some are friends, while others are adversaries."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Virgin","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Machlian... or Morridow?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Machlian, for the time being."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Institute_G&A","raw":"BIN"},{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"My nurses don't tend to enter the operating room."}]}]},{"sprites":[],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Let me guess—they're busy committing murder and arson at your bidding at night?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"The scarred and battered city becomes mired in trouble amidst gunsmoke."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Jail_People","raw":"BIN"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"First we'll go to the prison... Then we'll make the medicine. "}]},{"spans":[{"text":"I can give you all the medicine, even my life. "}]},{"spans":[{"text":"Robin... We can save a lot of people..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Fire_Alarm","raw":"SE1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"These people are definitely not normal. "}]},{"spans":[{"text":"They must've ingested or inhaled something, but it doesn't look like a stimulant."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_slum","raw":"BIN"},{"type":"spark","raw":"火花"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What the hell?! Couldn't you think of a better idea?!"}]}]},{"sprites":[],"ops":[{"type":"sparkOff","raw":"关闭火花"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"There are no bio signs in the building. "}]},{"spans":[{"text":"I'm not detecting AK-12's signal either."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Unavoidable traps. Unexpected trust and betrayal."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020white-2","raw":"BIN"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The mansion. "}]},{"spans":[{"text":"The mansion is here."}]}]},{"sprites":[],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Really? Alright then. "}]},{"spans":[{"text":"...I suppose there's no stopping you."}]}]},{"sprites":[],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"I hope I can be someone like you one day."}]}]},{"sprites":[],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"What do you mean, someone like me?"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"A hero."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"19winter_lab","raw":"BIN"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I am human. "}]},{"spans":[{"text":"I do have a heartbeat, so I am not a monster. "}]},{"spans":[{"text":"I am human."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Where is the Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Haven't I told you already? "}]},{"spans":[{"text":"...The Commander is in Hell."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"19winter_lab","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Factory","raw":"BIN"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"The AR Team, bereft of ammunition and supplies, fighting against Narciss and me. "}]},{"spans":[{"text":"Do you think you can protect Nimogen?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Don't worry, Commander. "}]},{"spans":[{"text":"I'm back."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"War is always accompanied by blood and tears."}]}]},{"sprites":[],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"They are people who know why they fight. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Their convictions make them keener, braver, fiercer, and more eager for battle. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"What you seek is peace, while you fight for a greater peace. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Newstitle","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That concludes today's news, brought to you by the DFF."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"},{"type":"effect","value":"%%code=NPC_TV_5%%","raw":"common_effect"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"This is Shadowless. I will now be providing an overview on the most notable news from last week."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_N-1-2","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Due to the closure of a number of Galatea's laboratories, Idunn's release has once again been delayed. "}]},{"spans":[{"text":"Large-scale demonstrations break out in Berlin as the people urge the government to hasten the vetting process of the serum, so that suffering patients can have a chance of recovery."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_N-1-1","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"Incidents involving serious violence have occurred in multiple civilian residences. Crimes including shootings and arson have claimed eight lives and injured 20 people. The suspects are still at large, while over a thousand people are protesting at the municipal general office, demanding better protection for civilians by the government."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_N-1-4","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"The recent influx of refugees in Berlin have caused severe conflicts with the auxiliary police over issues such as living arrangements and rations and medical supplies. The Bürgermeister of Berlin has pledged to resolve these issues, but little to no progress has been made thus far."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_N-0-2","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"There has also been continuous unrest along the borders. The Neo-Soviet Union Ministry of Defense claims to have uncovered a major arms smuggling case and urges Germany to launch a joint-operation."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_N-1-3","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"A leak occurred at a chemical factory in Berlin; the specific cause is still currently under investigation. The same factory was also involved in a traffic accident earlier where a transport vehicle was overturned. The chief operator of the factory was found to have committed suicide at his residence two days ago."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Newstitle","raw":"BIN"}],"speaker":"Shadowless","narrator":false,"pages":[{"spans":[{"text":"That's all for last week's news round-up. Now we'll catch up with the latest news. "}]},{"spans":[{"text":"Celebrations are underway for the annual Unity Day. As host cities, Bremen and Berlin will organize grand musical and fireworks spectacles at the same time. "}]},{"spans":[{"text":"The Minister of Construction Oberstein proclaims in a public speech, "}]},{"spans":[{"text":"\"Germany has made very significant achievements since Unification.\" "}]},{"spans":[{"text":"\"According to a survey, as of yesterday, 76% of the German population believes that Unification was the right choice for our nation.\" "}]},{"spans":[{"text":"\"The people have put great faith in us, and we shall never let them down.\""}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","value":"%%","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021summer_MRL1","raw":"BIN"},{"type":"sfx","value":"AVG_Rocket_Gun_Truck_Turn","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=DoomsdayClock01%%wait=1%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
