{"name":"-36-5-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several minutes ago."}]}]},{"sprites":[],"ops":[{"type":"background","value":"19winter_inbg_2","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the ground floor of the base, not far from the seawater valves."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"This is UMP45. AR Team, where are you? "}]},{"spans":[{"text":"We're almost out of ammo."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I'm out of handgun rounds too! "}]},{"spans":[{"text":"Commander, lend me your gun!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"There's two minutes until detonation. You should get out of here."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Who'd pay us if we left? I don't make bad deals. "}]},{"spans":[{"text":"Last mag!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression"