{"name":"-61-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"73","raw":"BIN"},{"type":"sfx","value":"AVG_Rifle","raw":"SE1"},{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bullet wheezes past the empty space, a hit on the target follows. Immediately afterward, a notification reports on the result."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"“Miss.”"}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Eh?! How?! I clearly hit the target!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Rifle","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Card_Reader","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"“Inner Ten.”"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lowering her muzzle, M4 cautiously glances at SOP to her side and the spare M4A1 assault rifle she's wielding."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Only the bullseye counts, the rest are considered off-target even if you hit it."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Damn it!"