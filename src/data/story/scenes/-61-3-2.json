ges":[{"spans":[{"text":"...Indeed, Miss Persica told us to think outside the box and find our own ways of solving problems."}]},{"spans":[{"text":"We were lucky enough to make it through this time, but come the next round, we'll run into a very different challenge."}]},{"spans":[{"text":"Instead of dwelling on a momentary victory, we must learn to think critically."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP blinks."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M4..."}]},{"spans":[{"text":"...You're such a big philosopher!"}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Eh?! Isn't that what you meant?!"}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I just want to try out new weapons! "}]},{"spans":[{"text":"Though... after playing with all of them, mine still suits me the best! And my secondary weapon is... myself! Gaow! "}]},{"spans":[{"text":"If my rifle jams, I'll use my claws, my teeth! I'll get them all!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Pfft."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 can't help but chuckle."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Never change, SOP."}]},{"spans":[{"text":"Leave the more complicated matters to me... as well as 15 and big sis 16. They'll help me, too."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Don't you worry!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"However, there's no room for slacking off on the basics. Come on, pick up your rifle. Time to get serious."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yeah—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Rifle","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sound of gunfire continues to echo through the training ground in the dead of night."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
