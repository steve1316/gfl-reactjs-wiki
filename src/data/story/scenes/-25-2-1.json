{"name":"-25-2-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"17xh-404Room","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In the Griffin repair room."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Sier! Answer me, Sier! "}]},{"spans":[{"text":"Have you guys figured anything out yet? Why can't 45... "}]},{"spans":[{"text":"...be rebooted at all?!"}]}]},{"sprites":[{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Sier","narrator":false,"pages":[{"spans":[{"text":"Uh, um... Please don't panic...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"It's just that...well...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"Argh, shut up! I shut down her Level II consciousness to save power!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Stop bothering me; I'm remotely giving her emergency maintenance right now!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Will 45 live?"}]}]},{"sprites":[{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"The Griffin logistics officer did a good job.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"However, even with the minimal power supply secured, we can only save a few core modules and buy her some time.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You'll need to move her to a more advanced repair facility for me to sort this out completely!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"There's no such facility here. We'll need transport to move 45. Could you arrange for that, Sier?"}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Sier","narrator":false,"pages":[{"spans":[{"text":"I'm sorry...but your coordinates are way too dangerous at the moment.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"According to intel, the area is embroiled in conflict among different forces and heavily contaminated by Collapse Fluid. Your temporary base is also under attack...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"It can't be done?"}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Sier","narrator":false,"pages":[{"spans":[{"text":"Well, it can, anyone willing to take such risks is bound to be pretty expensive...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"As you know, our capital reserve...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"si