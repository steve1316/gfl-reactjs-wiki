ntOn","raw":"黑点1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Unlikely, but it's still possible. Look into it. Move closer to the building and observe carefully. "}]},{"spans":[{"text":"Once the pursuit unit has secured the perimeters, or if anything moves inside, enter the building! "}]},{"spans":[{"text":"We can't ignore any possibility, and we mustn't let Ange escape!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"10","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I just talked to the commander. We must secure our evacuation route. "}]},{"spans":[{"text":"I've marked it out on the map, but there are some military facilities along the way. 416 and the others will have to follow the commander's instructions and destroy them for us to evacuate safely."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"But just having a route isn't enough."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The military scouts are still nearby. The moment we leave, we will be spotted. We must find a way to exit safely..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I know that, don't rush me! "}]},{"spans":[{"text":"Let me think... "}]},{"spans":[{"text":"Is there a way to leave the building without alerting the military...?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Commander, we're leaving the situation out there to you. "}]},{"spans":[{"text":"We'll protect Ange, so don't worry."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"But...is there really a way...?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","value":"0,3","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...AN-94 stares at the signal scanner, then suddenly—"}]}]},{"sprites":[{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ange! New movements from the surrounding enemies!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's their scouts! They seem to be moving towards us!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Why...? Have they seen through the ploy?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expre