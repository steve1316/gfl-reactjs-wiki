{"name":"-26-11-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Where did Ange run off to?"}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Corporal","narrator":false,"pages":[{"spans":[{"text":"According to our scan, Ange and her subordinates are holed up in a complex in the Yellow Zone. Our mechanical units have already locked onto their coordinates. "}]},{"spans":[{"text":"It will still take a while for the tanks to arrive at the site, but we have a surveillance outpost right in front of the complex. However, we cannot determine the situation in the outpost remotely."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Don't be distracted by unimportant matters. Our soldiers will do their duty...as long as they're alive... "}]},{"spans":[{"text":"Have the unit in pursuit confirm their location and numbers visually. Make sure Ange herself is actually in the building."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Corporal","narrator":false,"pages":[{"spans":[{"text":"We already scanned their signals ten minutes ago."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Signals can be faked. This battle has shown me what 16LAB is capable of and I haven't seen Ange on visuals for quite a while."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Corporal","narrator":false,"pages":[{"spans":[{"text":"You suspect they've split up?"}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"As I said, it's quite possible. Sacrificing several Dolls to save your own life - any human would think it's a decent bargain."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Corporal","narrator":false,"pages":[{"spans":[{"text":"Our analysis shows that the best time for them to split up would've been when they reached the abandoned structure, but the scan we ran on the area detected no human life signs in the building. There are also no signs indicating that any individuals have entered the building."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"...Are you certain?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Meanwhile."}]}]},{"sprites":[{"prefab":"安洁","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"46","raw":"BIN"},{"type":"openEyes","raw":"睁眼"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"AK-12..."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange... Finally..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I don't see you like this very often... Did I...die?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"More than once. And you didn't just die. During resuscitation, you went back and forth between being a corpse and a zombie."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That pretty much sums up how I'm feeling... "}]},{"spans":[{"text":"It may just be one last burst of strength, but I feel like I can hold out for a while longer."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I don't know when you passed out, but the others have already set off half an hour ago."}]}]