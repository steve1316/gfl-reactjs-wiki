{"name":"2-3-1N","beats":[{"sprites":[{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"10","raw":"BIN"}],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"Thompson, did you hear the barrage from this side?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Humph. The military seems to have opened fire ahead of schedule."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"(Sighs) They had never trusted us."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"We stick to our plan. The frontline isn't here. It'll be fine as long as we don't get caught up in the fight."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"Well... Here's a tiny problem."}]},{"spans":[{"text":"The frontline happens to be where M9 is. And military T-Dolls can be very... you know, destructive..."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"I have no time to babysit her. Surely you've made your own preparations?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M1911","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M1911","narrator":false,"pages":[{"spans":[{"text":"Boss, continue the operation and lead us to the next base."}]}]}]}
