{"name":"-58-2-R1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"446","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"In the Eastern Tower, Avernus. "}]},{"spans":[{"text":"Operation Aeneas - \"Phase 0\". "}]},{"spans":[{"text":"Target—Anna Viktorovna Tsoi. "}]},{"spans":[{"text":"Aeneas Conference Room current progress saved. "}]},{"spans":[{"text":"Phase 0... 99% completed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The nauseating stench that permeates Avernus threatens to overwhelm RO635's neural cloud. "}]},{"spans":[{"text":"The only thing that is keeping her sane is the fact that she still hasn't reached her objective— Angelia. "}]},{"spans":[{"text":"At this very moment, she is threatening a Nyto in black named Koleda into taking her to the laboratory where Ange is being incarcerated."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Koleda... Who exactly are you?"}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"...As you can see, I am Koleda, the Nyto who is currently standing right in front of you."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"If you wish to see her, I will bring you to her. "}]},{"spans":[{"text":"But once you do, you will understand. "}]},{"spans":[{"text":"She cannot leave this place with you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half of Task Force Aeneas are lost... RO635 is their last hope. "}]},{"spans":[{"text":"How could she give up now that she's here?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I will take her with me no matter what."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"657","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Koleda walks ahead in silence, her slender, metallic legs tapping brightly on the floorboards."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They are going down a hidden path. Not a single Paradeus member is in sight along the way."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"510","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Koleda operates the access control. The electronic door opens, revealing a pure white glass room deep inside the laboratory."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Ange is inside."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 looks in the direction indicated by Koleda and sees a woman lying in the center of the white room. Her chest rises and falls almost imperceptibly—her breathing is incredibly faint. "}]},{"spans":[{"text":"A myriad of wires and tubes are connected to her body, pumping all kinds of unknown fluids into her bloodstream and maintaining her weak vital signs. "}]},{"spans":[{"text":"The passcode lock at the door of the room flashes red. The display screen on it reads, \"Subject: Angelia\"."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Ange—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 rushes up to the door and tries to open it. She attempts to crack the electronic lock, but the mechanism is utterly unresponsive."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She bangs forcefully on the glass, shouting Ange's name loudly. "}]},{"spans":[{"text":"Naturally, her efforts are all futile."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"As I said, you cannot take her away."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What has Paradeus done to her?!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Punch","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"How do I open... this goddamn door?!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"It's no use. "}]},{"spans":[{"text":"This room is specially prepared for white torture. The pure white interior deprives the victim of any sensory input and destroys their spirit. "}]},{"spans":[{"text":"The inner wall is impenetrable. Even if you somehow managed to break in using violence, you still wouldn't be able to save Ange."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"The passcode cannot be cracked. Brute forcing it will trigger a deadlock seal."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"The ventilation duct in this room is less than five centimeters wide and connects directly to the filter system in the Eastern Tower."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Everything you can think of, I've tried."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Then what are you still waiting for?!"}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"I don't know. "}]},{"spans":[{"text":"Maybe for the moment when her heart flatlines."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What then?"}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Then I can begin my quest for vengeance. "}]},{"spans":[{"text":"I will make them pay."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...I'm against it. I'm sure the Commander won't approve either!"}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"The Commander didn't send you here alone. "}]},{"spans":[{"text":"Yet you're the only one who managed to get this far. As a fellow team leader, I know what that means for the others. "}]},{"spans":[{"text":"Turn back; maybe you can still save one or two."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...Don't let us down."}]}]},{"sprites":[],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"We... have a deal then! We must fight to our last breath!"}]}]},{"sprites":[],"ops":[],"speaker":"SOP-II","narrator":false,"pages":[{"spans":[{"text":"I believe you! I'll be waiting!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"510","raw":"BIN"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I reached this point with everyone's will upon my shoulders. I will not give up just like that. "}]},{"spans":[{"text":"Here is the \"Strongarm\" that Miss Persica has tasked me with delivering to Ange. With it, we can lock on to her position. "}]},{"spans":[{"text":"If Ange regains consciousness, we may still have a chance of leaving this place."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Such stubbornness. Such naïveté."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...I will not give up until the very end."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"I once pondered over a question."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What question?"}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Back in '61, why did Ange choose us over you?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"