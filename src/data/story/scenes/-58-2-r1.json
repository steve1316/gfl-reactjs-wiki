the \"Holy Grail\" surgery can reach the Lake of Cognition."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Generally speaking? Are you not dead?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I am... the one who devised this surgery."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"So it's you... You're the one to blame for it all..."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...Perhaps."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You're not even denying it!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Sertürner isolated morphine to create an analgesic, but inadvertently opened Pandora's box."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"That's often the case with technology. Its applications can be entirely different from the intended use."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Then why did you devise this surgery in the first place?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...To save a little girl's life."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What was her name?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Sana."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0.1%%range=3","raw":"controll_shake"},{"type":"sfx","value":"AVG_splash_water","raw":"SE1"},{"type":"effect","value":"%%code=AVG_qipao%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Splash... Splosh... "}]},{"spans":[{"text":"The water churns... A mighty force—almost like a hurricane—seems to be pounding the bottom of the lake."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Come to me."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I think... something is calling to me..."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Perhaps your consciousness hasn't been severed entirely. You're not dead yet in the biological sense."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Then... can I go back? "}]},{"spans":[{"text":"I need to go back."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...You see that?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange turns around. All she sees is the same boundless lake."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Up there."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's..."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"462","raw":"BIN"},{"type":"effect","value":"%%code=CJ_WC_piaofu%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A rainbow that stretches on to infinity. "}]},{"spans":[{"text":"A diamond bridge that seems to be flowing. "}]},{"spans":[{"text":"A gigantic and dazzlingly beautiful rainbow refracted by the sunlight."}]}]},{"sprites":[],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Beautiful, isn't it? "}]},{"spans":[{"text":"This is a phenomenon of optical interference. "}]},{"spans":[{"text":"A huge iceberg hangs over our heads."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"If you want to go back, you must get through that."}]}]},{"sprites":[],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"510","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Monitoring Room, Eastern Tower Operating Level, Avernus."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"If you want to get Ange out of here, you must do exactly as I say."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"More than half a day ago, Ange underwent surgery. "}]},{"spans":[{"text":"She has been unconscious since she got moved here. She was in critical condition and had to be resuscitated a few times, and those were the only times when staff were summoned to this room. "}]},{"spans":[{"text":"They are probably monitoring her through all this equipment. If we take Ange away, the machines will sound the alarm and tip them off. That's just asking for trouble."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"If we just pull all the wires and tubes out, we could cut off her blood and oxygen supply and endanger her life."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So we need to get around these machines."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"That's right. I'm sending you the floor plan of the building. "}]},{"spans":[{"text":"We are currently on the Operating Level in Avernus, not far from the central surveillance room. "}]},{"spans":[{"text":"According to my observation, this place is rather understaffed and not very well defended. Most of the people coming and going are medics and scientific researchers."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No wonder we haven't run into any obstacles along the way."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"But even so, I suggest you stay low and avoid making a commotion. If they move Ange somewhere else, all our previous efforts will have been for nothing."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I'll be sure to stay hidden."}]}]},{"sprites":[{"prefab":"NPC-Koleda","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Koleda","narrator":false,"pages":[{"spans":[{"text":"Go. I'll wait for you here."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
