{"name":"-51-3-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10227","raw":"BGM"},{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"AVG_Explosion","raw":"SE1"},{"type":"background","value":"485","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kaboom—"}]},{"spans":[{"text":"The dust thrown up by the cannonfire blends with the fog floating through the Black Zone, obscuring the Dolls from view."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"Son of a bitch! No! No, no, no, no, no!","style":{"size":"50"}},{"text":" "}]},{"spans":[{"text":"Stop running around!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Using the black dust clouds that fill the air for cover, Mona and the others steadily pull away from Narciss. "}]},{"spans":[{"text":"As she watches her enemy flee, Narciss relentlessly deploys the floating blades around her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh, whoosh—! "}]},{"spans":[{"text":"However... with no way to pinpoint the targets, the floating blades can do nothing but return empty-handed, despite their power."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"GODDAMMIT!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Narciss explodes in anger and is just about to give chase when a hoarse voice calls out from behind her."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...Don't chase them, Narciss."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"...Who gave you permission to speak to me, trash? "}]},{"spans":[{"text":"You have some nerve daring to speak after getting beaten up like that. Can you even call yourself a combat-type? "}]},{"spans":[{"text":"And you're trying to give me orders too? What gives you the right?"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...That's not what I meant. "}]},{"spans":[{"text":"It will take some time for them to recover from the damage they've sustained. Rather than hunting them down, we still have other things we need to do. "}]},{"spans":[{"text":"Morridow... Big Sister Morridow needs you. She's been hurt very badly. Don't you want to see her soon?"}]}]},{"sprites":[{"prefab":"Narciss","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Narciss","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Narciss tilts her head in contemplation. Perhaps Grig's words have swayed her, but she stops trying to set out after them."}