aw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"485","raw":"BIN"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Elsewhere, after verifying that the enemy isn't pursuing them, Nitrogen and Ferrum finally stop their mad dash."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10254","raw":"BGM"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gager immediately starts repairing herself."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{"Position":"0,120"}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"That firepower was hard to handle."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"...What kind of scary combat capability was that!"}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{"Position":"0,120"}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"She's also another one of those no-brain-all-brawn fighters, so how come she's so much stronger?"}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Yeah... "},{"text":"HEY, I UNDERSTOOD THAT ONE! YOU'RE TAKING A SHOT AT ME, AREN'T YOU?!","style":{"size":"55"}},{"text":" "}]},{"spans":[{"text":"Wait a minute, I'm not a fighter!"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Is everyone alright?"}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"I'm okay, just a little hurt."}]}]},{"sprites":[{"prefab":"QBZ191","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"No big deal. It won't affect the mission."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"Hey! You lost the bunny ears on your head!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"Those are my signal tracers... They can disguise my signal when needed. "}]},{"spans":[{"text":"When we passed that aircraft just now, I figured they'd use it to return to their hideout, so I put one inside."}]}]},{"sprites":[{"prefab":"BOSS-9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Then what about the other one?"}]}]},{"sprites":[{"prefab":"QBZ191","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"The other one... Well, I had to take it off because of fashion reasons."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"Fashion reasons?"}]}]},{"sprites":[{"prefab":"QBZ191","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"Stop asking so many questions!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep! The conference room channel broadcasts a hail tone again."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"This is... an emergency contact signal?"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"486","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"},{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...After quietly capturing the outpost. "}]},{"spans":[{"text":"RO635 and UMP45 connect to the outpost's database and search it for info."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Their security system went down in one hit. They might as well be handing the info to us on a silver platter."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I found the outpost layout map."}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Hang on."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"XM8 and RO635 begin connecting lines on the map. "}]},{"spans":[{"text":"Many lines originate from all the outposts, extending into the blank expanse. "}]},{"spans":[{"text":"Eventually, the lines intersect. "}]},{"spans":[{"text":"And the place with the most intersections is—"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We're close now... We're very close to this point..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635's finger lands on that inky black point. "}]},{"spans":[{"text":"Her voice trembles, but there's no way to tell if it's from excitement or nervousness."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We'll go here."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"485","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...RO635 and company follow the map to the intersection in that blank expanse. "}]},{"spans":[{"text":"However, there is nothing there. "}]},{"spans":[{"text":"No outpost, no other structures, and no Paradeus."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"How come there's nothing here?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"XM8, did you make a mistake somewhere?"}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"That's impossible! I couldn't have made a mistake in my calculations!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The group's anxious voices echo across the open plain."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Could it be an underground base? Like that Paldiski Sub Base..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I doubt it. It's very difficult to perform deep excavation in terrain like this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO stomps the ground. The surface here is pretty much covered in hard bedrock."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Should we search the surroundings?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It's too open here. If the enemy passes by, we'll be forced into a disadvantageous battle."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Let me contact Mona—"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What's up, SOP-II?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as RO635 is about to make a call, she finds SOP-II squatting beside a green puddle."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The water here is darker than usual."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Could it be a difference in pollution levels?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But when you look at it from a different angle, the black stuff in the water moves too."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Let me see."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as SOP-II said, the color of the water in this area is definitely darker. "}]},{"spans":[{"text":"But that's not because the water itself has changed, but because—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Because of what is reflected in it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 looks up."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seeing RO's dramatic expression of utter shock, SOP-II looks up as well in confusion. "}]},{"spans":[{"text":"And then—"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Whoa... WHOAAAAA!!!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What...IS that?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Is it a myth? Or an urban legend, maybe?"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"456","raw":"BIN"},{"type":"whitescreen","raw":"白屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the Dolls all direct their attention to the sky, they can see part of a massive object that seems to be floating in the sky. "}]},{"spans":[{"text":"It is a tower. "}]},{"spans":[{"text":"To be precise, it is a pair of black towers, joined at the base. "}]},{"spans":[{"text":"They are floating high in the sky, in flagrant disregard of gravity, and their metallic-looking surfaces radiate an oppressive air even from this distance. "}]},{"spans":[{"text":"The faint moonlight leaks out from between the two towers. Not even birds flying in the air would be visible against this light."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It's so pretty..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II mutters her awe as she gazes at this sight, which cannot be adequately described by the word \"miracle\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then, as though waking from a dream, RO635 immediately sends out the emergency contact signal."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep... "}]},{"spans":[{"text":"Squad Nitrogen has connected..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Unable to contact the Commander."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Oh no."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I can't contact the Commander..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Is Dandelion causing trouble again?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...Hang on, let me check."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 verifies the network status and the comms system."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Our connection to the outside world has been cut off, but the Aeneas conference room's signal is currently stable."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Mona, can you guys hear me?"}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"We've been here all this while, but what's the deal with losing contact with the Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"...That sounds bad. Were we exposed?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"If we were exposed, I believe we'd have hundreds of Paradeus units after us by now."}]}]},{"sprites":[],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Are we changing our plan? It would not be wise to go any further without leadership.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":2,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Wait, don't panic!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 falls silent for a while, then she turns to address the group and shakes her head. "}]},{"spans":[{"text":"She meets Mona's gaze resolutely."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We're continuing the op."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yup, that's right!"}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"I'm not afraid or anything, but are you sure this is wise?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If the Commander doesn't know about our situation, then there won't be any rescue for us if something goes wrong.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Paradeus has chosen to activate their signal jamming now, which means we're very close to our destination, and that our presence is a threat to them. "}]},{"spans":[{"text":"If we withdraw now, it's likely that we'll be intercepted by Paradeus forces. "}]},{"spans":[{"text":"Also, if we want to enter this place again, we'll only end up having to pay a higher price for it."}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Besides, we were never going to get any support or rescue in this place anyway."}]}]},{"sprites":[],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Looks like we're destined to wake up in a repair tank after all.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It might sound cruel, but we should all have expected this before we set out..."}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"I can feel your determination. We need to continue the mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's right. We don't have the luxury of multiple tries. Everything is riding on one big bet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Aeneas conference room channel falls silent as everyone ponders the implication of RO's decision."}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Well, let's leave all this talk of death and rescue aside for now. What bothers me is—"}]},{"spans":[{"text":"How are we going to get up there?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"If we