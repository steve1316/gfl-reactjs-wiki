{"name":"-48-2-11","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"276","raw":"BIN"},{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The tiny safe house is packed full of people. Mia uses the crude facilities to make coffee for everyone. "}]},{"spans":[{"text":"The windows are latched and Mona is squeezed in between Nele and Leni on the two-seater bench. J, on the other hand, leans on the table like he owns the place."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"They've got the apartment block sealed off tight. You can spend the next couple of days here."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...I didn't think you'd be so considerate."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"This is a Stasi safe house, it's not like I'm paying the rent for this place. "}]},{"spans":[{"text":"Oh yeah, don't stay here for more than two days, I haven't applied for permission to use this place yet."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I take back what I just said."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Alright, so what do you have?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Agent J, I've thought things through. "}]},{"spans":[{"text":"It isn't about what I have, but what you want me to do. "}]},{"spans":[{"text":"I'm sure a high-ranking Stasi agent wouldn't have the time to escort me home and take statements. "}]},{"spans":[{"text":"So what do you want to know about Galatea?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Huh~ Looks like I've underestimated you, Frau Nele."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I can help you find the information you want."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Pfft... You know, you're being so cooperative all of a sudden, I'm starting to feel suspicious."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"You can trust me, because there's something I want to find out too."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},