t","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J turns to Nele and taps the picture with his fingertip."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Go to the Galatea database and get me the transport details on this truck. That shouldn't be a problem for you, right?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Not at all."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Start with that, then. My colleague here is getting very impatient."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...I'm not."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"If there's nothing else, we'll keep in touch. Right now, time is of the essence"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Goodbye, then."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J and Mona take their leave, and the room finally falls silent. Nele stares intently at the closed door, feeling very tired."}]}]},{"sprites":[{"prefab":"APC556","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"That isn't the only task the agent has given us."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mia turns the picture over and find several words hastily scrawled on the back— "}]},{"spans":[{"text":"Deal Two - 920, Neu-Tempelhof, mansion, who?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"168","raw":"BIN"},{"type":"bgm","value":"GF_21winter_avg_nightbar","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The pub street is usually bustling with activity at night, but right now it seems particularly deserted. "}]},{"spans":[{"text":"A woman is holding a cigarette between her fingers, her eyes filled with impatience."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beepbeepbeep—the 109th attempt to make contact has failed as well."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Is she dead? (Sighs) Would it kill her to make it more obvious if she is? It's really hard for an underling to come back halfway and take a job over. "}]},{"spans":[{"text":"Subordinates like me who are this concerned about their bosses aren't exactly common, you know."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Sometimes I wonder if anyone's actually working in HQ, the way all these problems spring up whenever they do anything."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While the woman is griping beneath her breath, a suspicious-looking man approaches her from behind."}]}]},{"sprites":[{"prefab":"NPC-handyman","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Furtive Man","narrator":false,"pages":[{"spans":[{"text":"Yo~ Are you waiting for someone, darling? "}]},{"spans":[{"text":"Need a light?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The woman smiles and shuts off her communicator. She extends the unlit cigarette she is holding to the man who's chatting her up. "}]},{"spans":[{"text":"The man lights her cigarette for her obligingly."}]}]},{"sprites":[{"prefab":"NPC-handyman","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Furtive Man","narrator":false,"pages":[{"spans":[{"text":"And here I thought the beautiful ladies in these parts all came out at night— "}]},{"spans":[{"text":"I knew you were different from the rest the moment I laid eyes on you, my dear."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Pfft... You've got a good eye, then~"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The elegant lady purses her lips and exhales a mouthful of blinding smoke into the man's face."}]}]},{"sprites":[{"prefab":"NPC-handyman","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Furtive Man","narrator":false,"pages":[{"spans":[{"text":"The bars aren't open in the day, want to head over to my place? I've got a lot of good drinks—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A male voice suddenly cuts in."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"No need for that. She's with me."}]}]},{"sprites":[{"prefab":"NPC-handyman","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Furtive Man","narrator":false,"pages":[{"spans":[{"text":"And who the hell do you think you... "}]},{"spans":[{"text":"Aaaahhhhh—!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The furtive man is shoved against the nearby wall with his arm twisted against his back."}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Get lost."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The furtive man is so frightened that he immediately flees the area. The woman throws the cigarette to the ground and stomps on it a few times."}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Sorry to keep you waiting. I've arranged the route."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Aren't you going to do something to make up for keeping a lovely lady waiting?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Did you bring your things?"}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Of course!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She gestures to the suitcase by her feet."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I'm sure you'll want this information. "}]},{"spans":[{"text":"(Sighs) Are all German men as obsessed with politics as you are?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I thought we were going to discuss our upcoming deal."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The way you go by the book for everything makes it really fun to play with you."}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Don't mess around."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The woman puts her arm on the man's shoulder. They look just like a pair of passionate lovers."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It seems I'm homeless now, whatever shall I do?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You can stay at my place if you don't mind."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"And if I do mind?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man says no more. Instead, he takes the suitcase from the woman's hands."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"417","raw":"BIN"},{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Drink_Tea","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The coffee machine comes to life after the button is pressed, dispensing a black double espresso into a white porcelain cup. Hardly anyone is left in the Stasi agent offices. After all, the people here spend more of their time on field work than hunched over a desk writing reports."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I caught a big one! Remind me not to mess with those guys in Traffic~"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Well done! The old Kevin I knew is back."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Rather than fish for tadpoles in the sea, we've got information on several transport routes now."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Good, drinks are on me tonight! "}]},{"spans":[{"text":"We'll go check the terrain near those routes later. There's no way things can just disappear into thin air."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Oh yeah, have I sent you this license plate number yet?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Nope, let's turn on the PC and sort it out."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Right."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The power switch is on, the power button on the CPU chassis is pressed, and within 10 seconds the computer has finished booting up and is now displaying the desktop—a sign that the computer is in very good condition. "}]},{"spans":[{"text":"Just then, J's facial expression undergoes a dramatic shift—"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Schwaben! Who messed with my PC?!"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Relax, all these computers have restricted access. "}]},{"spans":[{"text":"What about the physical evidence?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief but intense search..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...It's all gone. Even that picture!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A door opens with a \"bang\", followed by the crisp sound of footsteps. Someone has entered the office."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The first to enter is Romy, who has a thick stack of data in her hand. Mona follows closely behind her. Both of them have grave looks on their faces."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Did you look into the Galatea logistics data?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Yes. There was a connection to the case, so—"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"That was not the direction you should have taken."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...It is very difficult for us to perform follow-up investigations when the clues are not sufficiently clear."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"It's a matter of standards."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...I apologize."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"If this was a simple job, I wouldn't need to hand it to you. "}]},{"spans":[{"text":"What you need to do is finding out where that shipment went."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy slams the data she's holding onto the table."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"How many times do I have to tell you?! "}]},{"spans":[{"text":"The truck, the truck! I want the truck and what's in it!"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Yes."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"And you can't even maintain basic opsec. Looks like it's time for the Stasi to start hiring again."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"You—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy shoots him a glance, then hands down her orders."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Your mission is over. "}]},{"spans":[{"text":"The follow-up work will be suspended for now!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"356","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone is resting peacefully when the phone suddenly rings. The call goes straight to voicemail without waiting for anyone to pick up."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Ahem... Hello? Is this recording?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Sorry, Commander, but I need to bother you about something again. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"So our vase of a boss gave us a mission recently. The details are confidential, but it's essentially looking for a missing cargo truck. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Guess what? That truck belonged to Galatea. Just as things were getting a little interesting, Frau Vase snapped at us for literally no reason and terminated the mission. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Weird, right? I thought it was weird too... It's just like when Light died. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The supervisor back then didn't know anything either—this was confidential, that was confidential... I'm starting to wonder if I'm an agent or a janitor. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I digress again... In any case, I'm sure you get the idea—this job is a fishy one. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'm starting to have my suspicions about the \"cargo\" in the truck. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"For all I know, this might end up being linked to my colleague and Ange. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You're the only one I can count on, Commander. I'll be waiting to hear from you— J. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
