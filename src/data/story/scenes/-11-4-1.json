ther difficult... "}]},{"spans":[{"text":"There's more than one big dog!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Four have appeared on the map at the same time! "}]},{"spans":[{"text":" I'm afraid they're coming for all of us!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"But their primary target is me... "}]},{"spans":[{"text":"(Mutters) If I can somehow cut myself off from everyone..."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Come again, 45?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"One sec! 9, new incoming transmission! "}]},{"spans":[{"text":"Take it. Gr G11 and I will figure out a way to move. Take care of 45!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"DSR50","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"Gd DSR-50","narrator