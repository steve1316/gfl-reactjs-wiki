 herself and playing the bait??"}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"She might also have run into some problem so this is the only solution for now... "}]},{"spans":[{"text":"But she's gonna be fine. We must hurry and get the drone, then we're going back for her!"}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"How unlike her... "}]},{"spans":[{"text":"Got it. Gr G11, we're meeting up with 9. Then we're moving towards the drone signal."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"街道","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Is 45...in trouble?"}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Kinda, so we have to be quick. "}]},{"spans":[{"text":"What, you worried about her?"}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Of course? "}]},{"spans":[{"text":"If she dies, I'll have nowhere to go."}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"spea