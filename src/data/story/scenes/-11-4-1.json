{"spans":[{"text":"Meet up with the others, rescue Gd DSR-50, and take the drone. That's an order. Do it at once."}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Understood... I trust your judgment. But I'm coming back for you after we have the drone!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP9 takes her leave."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm counting you, 9... "}]},{"spans":[{"text":"Now then, time to get busy..."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"大桥","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Sier! Sier!"}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Sier","narrator":false,"pages":[{"spans":[{"text":"Miss UMP9, I am aware of the situation. I have already started tracing the Sangvis signal."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Seele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"And?!"}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Deele","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dier","narrator":false,"pages":[{"spans":[{"text":"UMP45's neural cloud is experiencing