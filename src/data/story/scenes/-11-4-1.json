,"narrator":false,"pages":[{"spans":[{"text":"Transmission terminated."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Are you sure it's a good idea to help her, 45? "}]},{"spans":[{"text":"Is it worth the risk to rescue hostages while being chased by big dogs?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I know her - this Gd DSR-50. "}]},{"spans":[{"text":"Get her out and killing Destroyer won't be a problem."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Understood. More good news, the T-Dolls we rescued before have agreed to help us as well! "}]},{"spans":[{"text":"But they'll need an operation objective, or they're completely unorganized."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Their objective is simple, protect you three at all costs."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Huh? But what about you? "}]},{"spans":[{"text":"You're the primary target here!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9","expression":2,"shown