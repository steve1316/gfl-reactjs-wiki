ator":false,"pages":[{"spans":[{"text":"...I don't know."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":33,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"And you still took part in it? "}]},{"spans":[{"text":"You really are a bear of very little brain."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan, rather uncharacteristically, makes no rebuke. "}]},{"spans":[{"text":"He just sighs and looks away."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Ever heard of the saying? There are two sides to every coin, but only one to a person. "}]},{"spans":[{"text":"Compared to people's messy and confusing reasonings, I'd much rather believe my brother."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":33,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"...I thought those guys in the Guard Regiment were your brothers too?"}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I could only choose one, so I made the choice I did. "}]},{"spans":[{"text":"Because only Armin and I are brothers by blood."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan says no more to Anna and walks away towards the staircase. "}]},{"spans":[{"text":"Anna enters the classroom with a little sneer."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"654","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"T