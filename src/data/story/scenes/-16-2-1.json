{"name":"-16-2-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"},{"type":"sfx","value":"AVG_Rain2","raw":"SE2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"How unsightly. "}]},{"spans":[{"text":"The Griffin forces have all withdrawn. She won't survive if we leave her here. "}]},{"spans":[{"text":"...What do you think?"}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"},{"type":"blackscreen","value":"0.6","raw":"黑屏2"},{"type":"sfx","value":"AVG_Rain2","raw":"SE1"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Angelia didn't ask us to take her in. "}]},{"spans":[{"text":"You said yourself that our job this time is to observe. We can't get involved until new orders come."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Even if she dies...? Are you really okay with that?"}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Orders are orders. T-Dolls can't disobey."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"},{"type":"sfx","value":"AVG_Rain2","raw":"SE2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I know you can, and so do you."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Are you abetting me in breaking the rules?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I remember you're quite famous for disobeying orders. "}]},{"spans":[{"text":"Well, do indulge my curiosity."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"},{"type":"sfx","value":"AVG_Rain2","raw":"SE1"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"You're right. "}]},{"spans":[{"text":"I suppose no one would bat an eye no matter what I do on a team with such a name."}]}]},{"sprites":[{"prefab":"熟悉的人形声音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"Familiar voice of a T-Doll","narrator":false,"pages":[{"spans":[{"text":"Then here's a question, AK-12... Is Task Force DEFY hiring?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"113","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Humph, sly old fox... "}]},{"spans":[{"text":"We actually do have an opening."}]}]},{"sprites":[],"ops":[{"type":"background","value":"113","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"114","raw":"BIN"},{"type":"blackscreen","value":"0.5","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"In that case, DEFY will welcome its second temporary member. "}]},{"spans":[{"text":"Don't let her drag us down, because this team... "}]},{"spans":[{"text":"Well, it's made up of brand new, elite Doll models."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...35 minutes ago. "}]},{"spans":[{"text":"Current time is 1600 hours."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"130","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's no different from an actual battlefield at this point... "}]},{"spans":[{"text":"I honestly couldn't imagine that a PMC could cause such a huge disturbance, just going by the data we received."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"130","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"But this ought to be a good thing, right? At the very least, it'll be easier for us to take action."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"131","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ah, it's time. "}]},{"spans":[{"text":"Now then... "}]},{"spans":[{"text":"Guess it's time for us to make our entrance."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange, this is about the situation just now. "}]},{"spans":[{"text":"We've confirmed that a team of human soldiers attacked the safe house where our target M4A1 was located. "}]},{"spans":[{"text":"The exact casualty status of Griffin is unknown, but we can be sure that M4A1 herself was left in place. "}]},{"spans":[{"text":"This is very strange, do you know why they would do that?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"There's nothing strange about that. They must have their own agenda. "}]},{"spans":[{"text":"What about the disconnection procedure I had you execute?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I've verified its completion, though it's a bit...flawed. "}]},{"spans":[{"text":"The Doll M4A1 seems to be the center of attention for both sides. Is it alright to not recover her?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let AR-15 decide. She knows what to do."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You do know your old subordinates well."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You sound jealous."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Don't say I didn't warn you. Excessive self-confidence is an undesirable trait in commanders."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh, I know that better than anyone else."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The transmission ends."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Yet another troublesome day, and I can't help but worry... "}]},{"spans":[{"text":"Laws, systems, orders...why do humans have to live like Dolls?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Have you thought about that question before... "}]},{"spans":[{"text":" ...AR-15?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...I'm prepping my gear. Leave me alone."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Oh? And where are you going all by yourself?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Do you have to ask about everything I do? Ange authorized me to act independently, didn't she?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Are you sure you want to go at it alone? You've still got Parapluie in you now, right? "}]},{"spans":[{"text":"While it hasn't completely spread throughout your neural cloud, all your external connection functions have been locked down to avoid further contagion."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"So?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Which means, you can't control dummies and you can't sync information on battlefield conditions with us. I trust I don't need to explain the implications of that."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Indeed, I can't access the Zener Network, but I can still use the radio to establish basic comms. "}]},{"spans":[{"text":"That's good enough for me. I'm best suited to working alone."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm simply worried that you'll regret working alone afterwards."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...I never regret anything."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"There's often a price to be paid for speaking in absolutes. Don't you want to hear about the new mission that Ange handed down?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'll hear you out for now."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange wants us to rescue M4A1."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Are...are you doing this on purpose?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"