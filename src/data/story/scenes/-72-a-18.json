refab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...Did I?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"If your memory's incomplete, go recover it yourself. Don't come to me with this nonsense."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tableware","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Having gathered all the fragments into the tray, the white Nyto stands silently behind Bill."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...I've lost all my memories of Mother. All I have left is vague feelings."}]},{"spans":[{"text":"But I don't sense a single trace of Mother's memories on Nemhran."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"She's the kind of mother the children want now."}]},{"spans":[{"text":"Let her stay by this so-called \"Father's\" side, working dutifully until the day she dies."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Did I... hate her?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man looks at Lunasia with surprise."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...In my dreams, Mother always stands among the zealots. Her face is hidden by a cloak, so I can't see it clearly."}]},{"spans":[{"text":"I'm always far away, seated in a chair, unable to move—only able to watch as they draw daggers from their white sleeves..."}]},{"spans":[{"text":"And then, blood... rushing at me like a flood..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The white Nyto trembles slightly, as if still trapped in that nightmare."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"When I look at that version of Mother... I don't feel hatred..."}]},{"spans":[{"text":"Only fear..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man's patience finally reaches its limit."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"If you've got nothing else to say, shut up. I still have plenty to do."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...Bill, my head is full of noise—thoughts and emotions that don't belong to me..."}]},{"spans":[{"text":"When will I be able to fully reclaim myself?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...This problem will be resolved after the final operation is complete."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...When?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Just wait a little longer... For your sake, I'll personally perform the surgery."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Is that something I had asked of you too?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"???","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"That's right."}]},{"spans":[{"text":"...Luci, I made a promise to you in the past."}]},{"spans":[{"text":"Whoever you want to kill, whatever wish you want to fulfill, I'll make it happenf for you."}]},{"spans":[{"text":"Even if you've lost all your memories now. Even if you're no longer the person who made that promise."}]},{"spans":[{"text":"So don't question me. Don't test me."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Otherwise... I'll replace the vessel."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...Bill, you didn't used to be like this..."}]},{"spans":[{"text":"You're always... so impatient with me now..."}]},{"spans":[{"text":"I'm not used to you acting this way..."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...I'm not used to you acting this way either, Luci."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man says nothing more and walks into another room."}]},{"spans":[{"text":"Lunasia knows the conversation is over."}]},{"spans":[{"text":"Every time she says she's not used to him like this, he becomes cold and distant."}]},{"spans":[{"text":"In that moment, she feels like just another experiment—no different from any randomly selected Nyto in a test chamber."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bill has become... just like that woman."}]},{"spans":[{"text":"Even though that woman never wears such a cruel expression, her heart is far colder and more ruthless..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"639","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Laplace' eyes snap open. She is momentarily dazed by the dazzling light."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Ope