ator":false,"pages":[{"spans":[{"text":"Following countless tangled pathways, Lunasia finally locates a suitable exit."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"Father, this is what you asked for—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"whitescreen","raw":"白屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Lunasia's consciousness captures her, the white Nyto's pupils dilate sharply. The tray in her hands falls to the ground with a crash..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_21Winter_OperatingDisc_Drop","raw":"SE1"},{"type":"background","value":"566","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Lunasia","narrator":false,"pages":[]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...Bill."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{}},{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Took you long enough to show up. Have you made up your mind?"}]}]},{"sprites":[{"prefab":"NPC-Willia