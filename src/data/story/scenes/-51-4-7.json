":[{"text":"She approaches the spiral staircase that clings to the inner walls of the tower and ascends."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She arrives at the heavy door and pushes it open wordlessly."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Creak..."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, her constrained field of vision opens up again. "}]},{"spans":[{"text":"She strides into the new chamber before her, advancing in silence."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her footsteps echo endlessly within the dark and empty tower."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hum... "}]},{"spans":[{"text":"The door behind her closes slowly with a mechanical noise. Deadbolts emit a mocking click as they engage."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She comes to a halt. Her piercing gaze focuses on the person before her eyes."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...So it WAS you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This vast platform is like a Roman arena, where gray and white are pitted against each other. "}]},{"spans":[{"text":"Gray's lips curl into a grotesque smile as she peers at this poor unfortunate soul who has just entered the fighting pit."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"How sad... Are you fighting all by yourself again, AK-15?"}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 watches Gray without saying a word. Her electronic eye starts scanning the surroundings for danger from under her bangs."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Don't worry... Bramedb has gone to take care of your remaining friends. "}]},{"spans":[{"text":"Right now, it's just you and me."}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...Whew."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 exhales heavily, as if in relief... Or rather, in regret. "}]},{"spans":[{"text":"Right now, it feels as if she'd returned to that old mansion, but this time, both her arms are intact, and her primary weapon is fully loaded. "}]},{"spans":[{"text":"Her bloodthirst is palpable."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...Do you want a rematch, then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She does not respond to Gray's smile and question."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"shown":