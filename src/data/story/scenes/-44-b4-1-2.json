","expression":0,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"What's that all about?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"Don't play dumb, I saw it all. "}]},{"spans":[{"text":"You exchanged looks with that pink-haired girl who loves blowing up. "}]},{"spans":[{"text":"When did the two of you hook up?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Enough with the nonsense. "}]},{"spans":[{"text":"Deploy your drone and keep your eyes open."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"Tsk."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kolibri stalks off sullenly."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perosa remains where she is, her eyes scanning the floor on which the AR Team walked over."}]}]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"flashback","raw":"回忆"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Back at the temporary command post."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Perosa."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...ST AR-15? "}]},{"spans":[{"text":"Is something the matter?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"How much do you believe of what Machlian just said?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"You mean... What she said about the interior of the plant? "}]},{"spans":[{"text":"Or how she escaped it?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Dandelion will stay on top of things inside the plant, so I have no objections there. "}]},{"spans":[{"text":"But her story about escaping sounds off to me."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Indeed, it was too easy."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's not all. "}]},{"spans":[{"text":"Let's give her the benefit of the doubt and say she really is innocent. "}]},{"spans":[{"text":"But where did she end up fleeing to? Bohnsdorf. "}]},{"spans":[{"text":"Which we know is pretty much a Paradeus indoctrination center. "}]},{"spans":[{"text":"So in the end, she never really escaped from them."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Also, when you were in Bohnsdorf, Paradeus responded extremely quickly, so I suspect they're aware of Machlian's location."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Very suspicious indeed, don't you think?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"So why don't you go to the Commander with this?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"The medicine is very important to the Commander, so nothing I say now will make the Commander call the operation off. "}]},{"spans":[{"text":"Also, we don't exactly agree on how to handle Machlian. "}]},{"spans":[{"text":"I'll admit that she puts on a very convincing show, but that doesn't mean I can overlook all the suspicious things about her."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"So, you've come to me instead? "}]},{"spans":[{"text":"What do you have in mind?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I checked Dandelion's scans, and they're fine. "}]},{"spans":[{"text":"However, the interior layout is extremely complex, so in case something happens... "}]},{"spans":[{"text":"I need you and your squad in there with us ASAP."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"I see... I get it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perosa nods and produces a small vial from her tactical bag."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What's this?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"A primitive tactical item. Basically, it's a very special powder that can only be seen under UV light. "}]},{"spans":[{"text":"When you go in, scatter this along the way, and we'll know which route you took. "}]},{"spans":[{"text":"If anything happens, I'll follow your trail and get to you as quickly as possible."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...It really is primitive."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"But effective nonetheless. "}]},{"spans":[{"text":"I also have plenty of UV flashlights, so you should take one too."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"322","raw":"BIN"}],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Perhaps ST AR-15 is just being paranoid. "}]},{"spans":[{"text":"They're moving very quickly, and the Commander may very well be back in less than 10 minutes. "}]},{"spans":[{"text":"Still..."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...I just can't shake off this bad feeling."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"324","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With the help of Dandelion's map, the Commander and company do not need to take too many detours. "}]},{"spans":[{"text":"A few minutes after entering the base, the group reaches their destination. "}]},{"spans":[{"text":"Torn cables, the thick coating of dust on the tables, broken pieces of unknown equipment... They all clearly indicate the fact that this place has been abandoned."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[