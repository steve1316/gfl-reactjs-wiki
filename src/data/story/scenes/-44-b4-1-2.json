{"name":"-44-B4-1-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"322","raw":"BIN"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside the abandoned underground plant on the outskirts of Berlin."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the familiar main gate looms before her once again, Machlian's face goes even paler than when she was in the truck. "}]},{"spans":[{"text":"Her heart pounds against her chest with every beat. Just standing here makes her feel like she's going to suffocate."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander wordlessly puts a hand on her back."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Robin."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It is a small gesture, but it greatly relieves Machlian's uneasiness. "}]},{"spans":[{"text":"Even her breathing has slowed down."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Your heart is beating very fast, Machlian. "}]},{"spans":[{"text":"...Are you alright?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"My heart...beats?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian puts a hand on chest dubiously."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Robin, does a corpse have a heartbeat?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Have you finally gone mad?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I am human. "}]},{"spans":[{"text":"I do have a heartbeat, so I am not a monster. "}]},{"spans":[{"text":"I am human."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Machlian","expression":5,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprite