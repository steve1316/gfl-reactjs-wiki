om."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Machlian!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Commander! Commander! This is bad, Commander!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, SOP-II runs in, followed by ST AR-15 and RO, who both look very alarmed."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Those little things outside... "}]},{"spans":[{"text":"Those pillars... They...They started glowing all of a sudden!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, our connection with the outside world has been cut off! "}]},{"spans":[{"text":"We can't pick up any signals and we can't communicate with the people on top!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It's a trap. "}]},{"spans":[{"text":"I TOLD you it was a trap!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Perosa? 45?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"(Static hissing)"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What should we do, Commander?"}]}]},{"spri