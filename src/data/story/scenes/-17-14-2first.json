n","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Gager, Architect is currently imprisoned in a secret detention facility at HQ. "}]},{"spans":[{"text":"It's a Griffin internal secret, and we frontline personnel have nothing to do with it. "}]},{"spans":[{"text":"Of course, we can guarantee that she's still alive—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"I told you already, give me Architect's location. That's the condition for freeing the hostages. "}]},{"spans":[{"text":"I don't care how you do it, find out right now!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"But...we can't even contact our own superiors, to say nothing of a prisoner, so—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Well then, you'll be losing contact with the first batch of hostages right now."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Please...please wait, let us try—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-7","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speak