s":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Lyudmila... She'll be fine, right?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Don't worry, if she can't handle them, you and I don't stand a chance either."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang-bang!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The gunshots draw ever closer, followed by chaotic footsteps. "}]},{"spans":[{"text":"The two Dolls can almost feel their hearts lurch—"}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Lyu—"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70","commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Weigh anchor.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh— "}]},{"spans":[{"text":"Maggie and Erma shoot each other a quick glance."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Without any hesitation, Maggie opens the door with her key. "}]},{"spans":[{"text":"Lyudmila rolls into the dining carriage in the same second."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clang. "}]},{"spans":[{"text":"Wasting no time, Maggie locks the door again right away. She executes the whole sequence of maneuvers so smoothly, none of the gunshots have made it through the door."}]}]},{"sp