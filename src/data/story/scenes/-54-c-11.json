eaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Phew..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma, still buzzing with excitement, remains rooted to the spot."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Lyudmila!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila turns to give Erma a quizzical look."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"When you achieve victory in these kinds of operations... "}]},{"spans":[{"text":"Don't you do anything to celebrate?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...It's not written in the rules, but sometimes we hug each other."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Then..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma opens her arms. "}]},{"spans":[{"text":"Lyudmila freezes in shock. She doesn't quite know how to react. "}]},{"spans":[{"text":"Amused, Erma grins and starts striding towards her."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Congratulations on the great success of Operation Anchor!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Train_Bombings","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"background","value":"183","raw":"BIN"},{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM!"}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"whitescreenOff","raw":"白屏2"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"},{"type":"bgm","value":"10227","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma's exhilarated grin suddenly freezes. "}]},{"spans":[{"text":"She isn't walking on stairs, but her foot is suspended in mid-air, unable to find the ground. "}]},{"spans":[{"text":"She looks down at her suspended leg in surprise. In her befuddlement, she watches as an alarmed Lyudmila reaches out to her."}]}]},{"sprites":[{"prefab":"AR18","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila seems to be shouting something, but her voice is drowned out by a deafening noise, and Erma cannot hear a single word."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Wha...?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"By the time Erma registers the sensation of being in zero-g, her body has already been flung across the carriage."}]}]},{"sprites":[{"prefab":"AR18","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"—WATCH OUT!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BAM! "}]},{"spans":[{"text":"A powerful strength grabs hold of Erma. "}]},{"spans":[{"text":"With one hand clutching the handle of the bar door, Lyudmila catches Erma with her other arm and holds onto her for dear life."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh!!"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Whoaaaa!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_Train_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No one can tell which came first—the loud noise or the spinning. "}]},{"spans":[{"text":"As the train tears off the metal tracks, Lyudmila's vision spins and swirls into a blurry, incoherent jumble. "}]},{"spans":[{"text":"Having lost all sense of balance and control over her body, she tumbles around in the cramped space, colliding with other objects..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She has no strength to spare on anything else other than holding onto Erma with a vice-like grip."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thump— "}]},{"spans":[{"text":"While everything is in motion, a sharp metal stake pierces through her right arm. "}]},{"spans":[{"text":"The centrifugal force finally subsides. Her body grows heavy and she struggles to move."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She stares at her right wrist in a daze as a message keeps flashing on her watch—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Unknown Signal","narrator":false,"pages":[{"spans":[{"text":"...Evening Star has fallen.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
