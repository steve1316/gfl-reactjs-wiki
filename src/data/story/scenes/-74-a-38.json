{"name":"-74-A-38","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Winter_Night_Bayan_Version","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202412_Lunasia_a","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Day breaks. "}]},{"spans":[{"text":"\"You\" follow \"Lunasia\" back to the devastated surface of Frankfurt."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...How come... "}]},{"spans":[{"text":"How come it's you now... M4?"}]}]},{"sprites":[],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"...I've faced such moments many times... "}]},{"spans":[{"text":"But none has ever brought me as much relief, happiness, or satisfaction as this one."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Because I finally have everything I ever wanted. "}]},{"spans":[{"text":"Commander, you should be bathed in sunlight, and return to Moscow one beautiful spring. "}]},{"spans":[{"text":"There you will find boys and girls as radiant as lilies. "}]},{"spans":[{"text":"And you yourself will be like a lily."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"The time for farewell has come..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202412_Lunasia_b","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Commander... will you walk with me one last time?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Sure."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"Commander, please allow me this one selfish act... This is my only choice..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't think of this as farewell. "}]},{"spans":[{"text":"M4, this is us... running together toward our own choices."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"That's all we have to tell you about our friend the Commander. "}]},{"spans":[{"text":"At countless crossroads of fate, they could have become... "}]},{"spans":[{"text":"A remarkable warrior. "}]},{"spans":[{"text":"A gentle senior. "}]},{"spans":[{"text":"A hot-tempered instructor. "}]},{"spans":[{"text":"A carefree child."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"But the Commander never keeps time for themself—they always give it to others."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Life is so long, and yet so short. They only have enough time to become a brave soul."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"[Convolutional Kernel - END]"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"credits","value":"202412Activity_ED","raw":"名单2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202410_News","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Now we bring you the latest news.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In a statement issued by the Ministry of Defense spokesperson, earlier today, an unregistered illegal Doll named \"Dandelion\" abducted a Commander who had made outstanding contributions in the Battle of Frankfurt. With the Commander as hostage, the Doll seized a military tank and attempted to storm the White Zone in a terrorist attack.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Traffic surveillance shows that chaos broke out when the vehicle entered the White Zone. It is presumed that the Commander engaged the Doll in a physical altercation, causing the tank to lose control, crash into the quarantine wall, and explode violently.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Inside the vehicle, investigators found numerous Doll fragments, confirmed to belong to Dandelion. The Commander's whereabouts remain unknown.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Authorities immediately secured the site, ruling out any risk of secondary explosions.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"To honor the Commander's courage, fearlessness, and self-sacrifice in fighting illegal Dolls and defending Frankfurt, the Gold Star medal is awarded posthumously.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The Ministry spokesperson declared, \"It is with deep sorrow that we announce this news. Frankfurt will never forget the Commander's heroic deeds. We will forever remember this comrade.\"","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.8","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Additionally, during today's medal ceremony, another unregistered illegal Doll wearing a black eyepatch over the right eye attacked Iron Cross recipient Ballard von Oberstein barehanded, severing his left arm. The injured has been rushed to hospital.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The issue of Doll security is urgent. After the establishment of the URNC, all Dolls must be brought under supervision.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"17xh-Networld","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Stasi special communications channel."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"That concludes the investigation report of this server incident.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"You've done well.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The migration of servers and the reorganization of the underground sectors will be handled by Hoffmann.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Understood, Director.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"No... Now I should call you General Riefenstahl.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"I fulfilled my promise. The Stasi has regained its former glory.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"...Looks like I can finally rest for a while.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2412_Yaroslavna","raw":"BGM"},{"type":"sfx","value":"AVG_Moto_Run","raw":"SE1"},{"type":"background","value":"202407_Car_b","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, thank you for posting my bail. "}]},{"spans":[{"text":"But where are we going now? To see the Commander?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"I'm taking you to start a new life."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"But... I wrote a letter to the Commander just a few days ago... I don't know if they ever received it..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Don't worry, I'll deliver it for you. "}]},{"spans":[{"text":"This is for your safety—and also the Commander's wish."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Thank you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kryuger says no more. "}]},{"spans":[{"text":"Nele can only watch the cityscape blur past the car window, wondering where they are headed."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_HeavyVehicle_Stop","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202412_Outskirts","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After some time, Kryuger pulls the car to the side of a deserted street."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before the vehicle has fully stopped, J has already rushed over with Mia and Amaris in tow."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Nele!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"J..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Don't call me J anymore. "}]},{"spans":[{"text":"My real name is Kevin Hartmann."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Just stay in the car, Nele."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kryuger unbuckles his seat belt, steps out of the car, and opens the storage compartment. Inside, Nele sees a green pass to the White Zone, a Gold Star medal, and two sets of documents."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kryuger hands the files to Kevin Hartmann while keeping the medal and green pass in his hands."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"These are your new identities. All the identifications you'll need are inside."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kevin Hartmann","narrator":false,"pages":[{"spans":[{"text":"...Got it."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Nele, Kevin. You must forget your old selves. Forget everything you've lived through. "}]},{"spans":[{"text":"From now on, stay far away from conflicts, away from trouble, and live under new names in a new city."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kevin Hartmann","narrator":false,"pages":[{"spans":[{"text":"Yes, I understand. I'll help Nele adapt to her new life."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Live well. Enjoy an ordinary life in the Commander's place. "}]},{"spans":[{"text":"That is what we ask of you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kevin Hartmann","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kevin solemnly accepts the car keys. Nele has a feeling that something is being left unsaid. "}]},{"spans":[{"text":"She fixes her eyes on Kryuger in silence."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"The green pass is for Kalina. That too was the Commander's wish."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"And the medal? Where has its owner gone?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"0.95"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"This Gold Star medal will wait for its owner forever. "}]},{"spans":[{"text":"And I will wait for the owner of this medal to return to Griffin."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"The Savior's crown a thousand grains of grief."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Here all my tears reach out to you in vain."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"One proud mute glance is all of my relief..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"[Girls' Frontline - END]"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
