{"name":"11-2-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"166","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO! RO, do you copy?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What is it? I'm a little busy here!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"A human is walking this way. I don't know what she wants, but she's definitely coming straight for me!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Might just be some pamphlet distributor! I'll be done soon. Buy me some time!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hurry! She's almost right before me—"}]}]},{"sprites":[],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"You can't sit here, young lady!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Huh? Uh...why?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"Because a very important demonstration is about to take place here!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Huh? Demonstration? About what?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"A demonstration against the government for reducing our sugar and tobacco rations for three months straight! "}]},{"spans":[{"text":"Also, the officials claimed that they'd be raising the immigration quota this year, but they still haven't delivered on their promise!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Uh...so...I have to move?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"That's right. Actually, you should just join us!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...I don't really want to take part in any demonstration. I simply want to sit here and watch these electronic cats fighting with the Shiba Inu."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"You should do more for the sake of freedo... Hold on, you...you're not human...!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I...uh... I-I'm a Tact— Uh, no, a civilian Doll?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"A Doll? A freaking Doll has the nerve to take up human space?! Scram already!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sorry, can't this wait just a bit? My friend is asleep."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"How dare you talk back at me, you freaking piece of scrap metal! Is something wrong with your toaster of a brain?!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the woman raises her hand to slap SOP-II, the latter smacks her arm away out of reflex."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"AHHHH! MY ARM!!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Oops... It got bent. I didn't adjust my strength properly..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Human female","narrator":false,"pages":[{"spans":[{"text":"There's a killer robot!! Arghhh, my arm!! Call the ambulance!!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Uh...I..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What the hell have you done?!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO, you're awake?!"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Let's go, the cops will be here soon! Run!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But that human..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We're done for if we get caught! Go, go, go!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Right...okay!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Two minutes later, in a corner of the square."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I was gone for just barely a few minutes and look at what you've done... "}]},{"spans":[{"text":"Didn't I tell you to stay out of trouble?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm sorry... But that woman...these people seem to be very hostile towards Dolls..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Be thankful that we're working for a nice company. "}]},{"spans":[{"text":"I've taken several cases in the past – all kinds of abuse and violence against Dolls, sometimes even worse. You wanna know how those cases were resolved?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I want to. I'd love to resolve them myself..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You're not cut out for that line of work. What would you do, point your gun at the culprit's head? Most of those cases don't end like that. "}]},{"spans":[{"text":"Just do your current job properly. That's the least we could do to show the Commander and Kalina our gratitude."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I understand... So have you found the informant?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"No, I haven't... "}]},{"spans":[{"text":"I've made a copy of all the footages taken by the cameras in this area, but I couldn't find the person in the photo."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"H-How is that even possible? Maybe you missed something?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I've checked three times. "}]},{"spans":[{"text":"But think about it – there aren't that many cameras around here, nor are they completely watertight... If the informant has undergone anti-surveillance training, avoiding these cameras wouldn't be that difficult. "}]},{"spans":[{"text":"He isn't the kind to expose himself too much to begin with. If he had planned his route beforehand, it would be hard to track him down... In the end, we have to go back to gathering optic records from Dolls..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hmm... But there's got to be some clues... He must've left behind something. "}]},{"spans":[{"text":"RO, can you send me the footages? I want to take a look myself."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Sure."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO draws out a transfer cable and plugs it into SOP-II."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Still, I'm fairly confident you won't find any..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO, look at this part! There's a brawl!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"A brawl? There are at least 30 brawls captured in these footages."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But this one was a bit peculiar. Look, several burly guys surrounding a maid with knives in their hands."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Mugging? That's pretty common in slums. "}]},{"spans":[{"text":"There were five cases of mugging and twelve cases of theft documented in..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That's not the point. Check out the footage from the two other cameras overlooking this street."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hmm...I think I see what you mean..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Right?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"There's no sign of the maid in them..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I've looked at all the footages from other cameras in the vicinity – the maid wasn't in them either, which means she was deliberately avoiding the cameras."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But the mugging derailed her plan... The route she had planned wasn't safe."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Now watch this."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The men who had the maid surrounded reveal that they were armed with knives."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Smack! "}]},{"spans":[{"text":"All of a sudden, the maid crossed her arms and grabbed hold of a man's knife-wielding hand. "}]},{"spans":[{"text":"Meanwhile, she kicked another man in the lower jaw, then swung back around and jabbed the third man on the neck with her elbow. Finally, she pinned the first man onto the ground and punched him right in the face."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a matter of seconds, the unarmed maid has thwarted her human assailants."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You see?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Her strength and movements... This is definitely an illegally modded Doll... "}]},{"spans":[{"text":"What she did is impossible without advanced software and a high-spec body... "}]},{"spans":[{"text":"Even in Griffin, only a small number of T-Dolls have that kind of performance due to our limited budget."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Her movements, speed, and force applied when she beat those muggers were all carefully calculated... Even I couldn't have done it."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Huh? I thought you're an expert in close-quarters combat?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm an expert in tearing enemies apart, but I'm not capable of the intricate moves required to react that quickly while applying just the right amount of force to knock them out without killing them..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"In any case, there's our clue!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Humph. If we end up getting fired from Griffin, let's set up a detective agency together!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Huh... Can Dolls be detectives?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Who knows, maybe the Commander could secretly help us get our licenses?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Why are you assuming we'd get fired? Besides, our mission is far from over!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Okay, okay. Then what are you planning to do?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"It'll be much simpler now that we know what to look for. The maid may be able to avoid cameras, but she certainly can't avoid being seen by all the Dolls out there. "}]},{"spans":[{"text":"We can extrapolate her course and even determine her destination with just a single optic record. "}]},{"spans":[{"text":"Now we just have to look into what the Dolls around these cameras have seen!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sigh, we'll have to do it again and again and again..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So let's get to work, SOP-II!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod-Noarmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Argh... In the end, we're stuck doing this bother of a chore..."}]}]}]}
