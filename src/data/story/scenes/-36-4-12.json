{"name":"-36-4-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"85","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"Alarm","raw":"SE2"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the Griffin temporary command post. "}]},{"spans":[{"text":"The bombing sounds like it will never end. "}]},{"spans":[{"text":"Their bunker stands in silence, trembling along with the rest of the world."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How many Dolls made it back?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Only half of them. They're pinned down by enemy pursuers and can't shake them off!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What a bunch of clingy bastards..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Our forces are scattered and the base is in chaos..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Intercept them from our bunker! We mustn't let them link up with Yegor!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"What happened? I heard the explosions from over here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We had the air force conduct a bombing run. The Military's surface forces should be finished, but some of them managed to flee into the base."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Tsk... Yegor's mechs are a pain in the ass. Fortunately they're busy fighting S.F. right now.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I have a plan to wipe them all out in one fell swoop, but I'll need your help.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Go ahead."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I infiltrated this sub base by sea. There are four valves which lead to the ocean. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If we can pin down their mechs on the first floor and blow all four valves at the same time, we can drown them in seawater and Yegor will be fish food.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I'll send you the location of the seawater valves. They're all located on the surface level of the base. If we're defeated here, then please blow the valves. 404 is heading towards you right now; they should be able to give you some assistance.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about you?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We can't let the enemy have their way, no matter who they are.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I understand."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The transmission ends."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander, what are you doing? "}]},{"spans":[{"text":"Why are you putting on your bulletproof vest...? "}]},{"spans":[{"text":"Wait, you're taking your backpack and pistol too? Hang on, isn't that..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"As you can see, it's the one Kryuger gave me."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I'm not talking about the gun. Where are you going?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You heard Angelia."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"But the Dolls haven't returned yet! You can't go in on your own! It's too dangerous!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I know. That's why I'm not going alone. "}]},{"spans":[{"text":"K, take this."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Remote-detonated explosives?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It shouldn't be a problem, right, Major Schwaben? I trust this mission should be a piece of cake for you."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Please, I've had more training than you've had meals."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K sneers as he loads the explosives into his backpack. Then he picks up his weapon and gives it a quick check."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm not the one who got KO-ed before the fighting even started."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I don't cower behind Dolls all the time, unlike you."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Wait... Don't tell me you're going to..."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yup, that's exactly what we're going to do. Good thing I didn't skip a single tactical training lesson."}]},{"spans":[{"text":"These are the coordinates we received from Ange. We'll take two each. You can handle it, right?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Wait a minute... Wait a minute, both of you! "}]},{"spans":[{"text":"Commander, I'll...!"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You'll what?"}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Give me one too."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What are you talking about?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She holds out her hand and repeats what she interrupted me to say."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Give me one too! I'll deal with one site for you!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No. You stay here."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This logistics officer who always has a brilliant smile does not belong on such a dangerous battlefield. Yet she has gone through hell and high water by my side more times than I could count. "}]},{"spans":[{"text":"I cannot and WILL NOT ask her to endanger herself for me again."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If any Dolls come back, someone will need to give them orders and resupply them. "}]},{"spans":[{"text":"Someone has to man the command post. This is a very important duty. "}]},{"spans":[{"text":"Do you understand, Kalin?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is an order. I need someone to help me gather up the surviving Dolls."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She holds my gaze in silence. Then she nods solemnly. "}]},{"spans":[{"text":"I can see the tears welling up in her eyes, but all I can do is turn away and feign nonchalance."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright, let's head out. But make sure we all come back alive!"}]}]}]}
