}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Sadly... you've just lost your only chance to capture me."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_3h","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"All of a sudden, a burst of gunfire comes from behind Gager."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gager evades out of reflex, but the next bullet is fired accurately at her new location."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She is forced to block the shot with her weapon and dive behind the nearest piece of cover."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, more bullets rain down squarely on where she's trying to take cover, so she has no choice but to turn her body to make herself a smaller target... "}]},{"spans":[{"text":"Yet even then the bullets find their mark."}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Tsk... "}]},{"spans":[{"text":"How did I not sense that?! "}]},{"spans":[{"text":"Long-range shooting? Is there another elite Doll?!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The second before Gager lands on the ground, she sees..."}]}]},{"sprites":[{"prefab":"98k","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_weapon_reload","r