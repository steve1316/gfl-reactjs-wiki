[{"text":"Let me ask you – what's the key to a successful sniper kill?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"Uh...is it the distance or windage?"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Dummkopf, it's the terrain! "}]},{"spans":[{"text":"Fräulein Kar drew Gager there for a reason – that area is an open space with a clear view and almost no obstacles."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"She found the perfect spot that I've deduced from months of recon in just an instant..."}]}]},{"sprites":[{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"You're right, I did lure her here to facilitate the attempt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Ja, then you've already given us a great head start!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"That's why! "}]},{"spans":[{"text":"When Gager hears the gunshots, she has very limited options when it comes to finding cover – no more than a few dozen!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"That's still too many. G43 plus all her Dummies only give us five 