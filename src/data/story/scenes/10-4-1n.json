ator":false,"pages":[{"spans":[{"text":"I see now.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'll try my best to buy you time.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"StG44, while Fräulein Kar is playing for time, you'll also have to shoot with G43."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"But my weapon can't fire from such a long range."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"That's fine, I'll guide you! "}]},{"spans":[{"text":"Judging from the way Gager destroyed Fräulein Kar's Dummies, she must've located them and anticipated their shots by tracing the trajectory of their bullets. "}]},{"spans":[{"text":"However, yours will be completely off kilter due to the lack of momentum, while Gager has the habit of dodging shots while locating her enemies... "}]},{"spans":[{"text":"This will confuse the heck out of her!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"That makes sense..."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"After she dodges the first shot, her options become even more limited."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"G43, you and your Dummies get into the positions that I've marked out and take aim... "}]},{"spans":[{"text":"Then the moment Gager moves, we adjust our aim and fire three successive shots."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"I see! "}]},{"spans":[{"text":"This will really give us a much better chance! At least one of these shots will hit her!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"That's right, then Fräulein Kar will fire the fatal shot while she's busy dancing around! "}]},{"spans":[{"text":"Perfect! Well done me!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"It does sound like a solid plan.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But there's still a good chance that the final shot will miss.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"Don't worry... I'll execute the ultimate backup plan if that happens."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"The ultimate backup plan...?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"I-I can't tell you too much at this point... "}]},{"spans":[{"text":"In any case, both Fräulein Kar and I are counting on you, G43!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"G43","narrator":false,"pages":[{"spans":[{"text":"That's...a lot of pressure..."}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"g43","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MP41","narrator":false,"pages":[{"spans":[{"text":"It's okay, you'll just have to fire at my instruction. Everything will be fine!"}]}]},{"sprites":[{"prefab":"MP41","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"I agree. StG44, make sure you keep her off me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"StG44","narrator":false,"pages":[{"spans":[{"text":"That goes without saying."}]}]},{"sprites":[{"prefab":"STG44Mod","expression":0,"side":"left","tags":{}},{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Right, I trust you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"98k","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Kar98k","narrator":false,"pages":[{"spans":[{"text":"Then I'm breaking cover now. Good luck to us all.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Back to the present..."}]}]},{"sprites":[],"ops":[{