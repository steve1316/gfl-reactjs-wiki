{"name":"-36-4-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"99","raw":"BIN"},{"type":"bgm","value":"BGM_War","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"20 minutes ago, at the military staging area."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Terra to Hematite. Sitrep. Over."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Military Officer","narrator":false,"pages":[{"spans":[{"text":"This is Hematite. We've linked up with the remnants of Quartz's troops. We're currently exchanging fire with Sangvis Ferri and Paradeus forces.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Unable to break through swiftly, I repeat, unable to break through swiftly. Over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Terra copies. Report losses. Over."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Soldier","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military Officer","narrator":false,"pages":[{"spans":[{"text":"Hematite copies. We are still able to carry out the mission. No need to worry, Terra. Over.","style":{"color":"#00CCFF"}}]