side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"How are things in the lab?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We've collected all the things you wanted. There are also living specimens present. I promised them that I'd get them out of here alive.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Humph. I'll think of something."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Commander, please let me command the AR Team. I'll make sure I finish off that bastard Yegor once and for all.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Understood. Come back alive."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I'll try. Ange out.","style":{"color":"#00CCFF"}}]}]}]}
