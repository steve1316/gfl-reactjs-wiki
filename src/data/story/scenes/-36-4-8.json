te. AR Team, take the DEFY members and one HOC to pursue the mechs that entered the base. And bring Dandelion with you!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But the defenses of the main gate...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let me worry about that. Make sure you stop those mechs!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Roger, we'll head out right away.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment the transmission ends, another one comes through instantaneously."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Still alive, Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Miss...Miss Ange?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Thank goodness, so Griffin hasn't been completely wiped out yet.","style":{"color":