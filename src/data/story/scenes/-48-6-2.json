r":false,"pages":[{"spans":[{"text":"Welrod gave her life to save me, so I want to do whatever I can...To help the others... ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Very well. Tokarev, you're now the leader of the blocking squad. Put a team together and get the others out of danger."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Roger!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After hanging up, Helian leans against a wall and slumps to the ground. A chill runs down her spine. "}]},{"spans":[{"text":"Once again, she can feel the terror of being trapped in the darkness."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"393","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The blocking squad starts building a defense line while the others retreat one after the other. "}]},{"spans":[{"text":"Tokarev puts her back to a piece of cover and carefully listens for the enemy's movements."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Those cunning bastards. With the power out, there's no way Miss Helian can transport the neural cloud servers either."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21winter_battle_1","raw":"BGM"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"We'll think of a way to fix it."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"I'm staying here with you."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"All we can do is buy time. Eventually, the enemy will overwhelm us. "}]},{"spans":[{"text":"When that happens, you need to take the remaining Dolls to protect Mr. Kryuger and Miss Helian, as well as the neural cloud servers. "}]},{"spans":[{"text":"Let us handle this mission. It's easy enough—all we have to do is die. Your mission is a lot harder."}]}]},{"sprites":[{"prefab":"Ribeyrolles","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ribeyrolles","narrator":false,"pages":[{"spans":[{"text":"Yeah..."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Don't worry. We'll fight until the end."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'll leave a squad behind as a second defense line. If you can't take it anymore, fall back to them."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thompson pats Tokarev on the shoulder, then slings the unconscious Kryuger on her back and leaves."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"I didn't expect I'd end up with you guys again."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"It feels like Welrod has brought us together..."}]}]},{"sprites":[{"prefab":"Ribeyrolles","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ribeyrolles","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"So, Miss Taking-Over-For-Welrod. What should we do now?"}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Delay the enemy and restore power."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"With just the few of us?"}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Yup, just the few of us."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the darkness, Tokarev's eyes gleam with determination."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"That's a bold plan. I like it."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"There's no way we can do it... Not with our current firepower..."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"We're going to avoid all stand-up fights. "}]},{"spans":[{"text":"Ever since the enemy entered the base, their tactic has been a concentrated bombardment, followed by sending in a squad to assault. "}]},{"spans":[{"text":"There's no way we can handle an attack like that in our present condition."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"We'd be gone in less than a second. Wouldn't even leave a stain behind."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"Also, I've noticed most of the enemies are using submachine guns and grenades. No pistols or melee weapons."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"Isn't that a standard loadout?"}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"That means they aren't prepared to fight at anything closer than submachine gun range."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"I think I get it now..."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"What do you get?"}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"We can use narrow passages to crush them in close combat."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tokarev loads her pistol, and the shovel behind her back seems to emit an eerie glow in the darkness."}]}]},{"sprites":[{"prefab":"mp443","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MP-443","narrator":false,"pages":[{"spans":[{"text":"This is starting to sound pretty exciting!"}]}]},{"sprites":[{"prefab":"Ribeyrolles","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ribeyrolles","narrator":false,"pages":[{"spans":[{"text":"Close combat... I can do that..."}]}]},{"sprites":[{"prefab":"PPK","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PPK","narrator":false,"pages":[{"spans":[{"text":"Looks like we've got a plan. Now then, that only leaves one question— "}]},{"spans":[{"text":"Who's going to be our lone wolf who fixes the power?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The excitement behind the cover suddenly cools off into silence."}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"W-why are you all looking at me...?"}]}]}]}
