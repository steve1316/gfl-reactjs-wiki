refab":"AN94","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I won't be taking part in any direct combat on my end, so don't worry."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Miss Ange... "}]},{"spans":[{"text":"While completing the mission is a given... "}]},{"spans":[{"text":"May I have your permission to look for a missing T-Doll?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"SOP-II, huh... "}]},{"spans":[{"text":"Sorry, but completing this mission is your top priority. "}]},{"spans":[{"text":"I'll authorize you to take independent action depending on the situation after that."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":2,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Understood... I will carry out my orders. "}]},{"spans":[{"text":"Give us a while to sort out our gear."}]}]},{"sprites":[],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M4A1 leads everyone away."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"AK-12. "}]},{"spans":[{"text":"What do you think of M4A1's performance so far?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She strikes me as being... a lot more proactive than her data indicates. "}]},{"spans":[{"text":"However, I feel that this is due to the influence of her neural cloud. Her thought processes tend towards risk-taking and she lacks a clear sense of purpose. "}]},{"spans":[{"text":" It's as though... she was controlled by something other than her orders."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I understand. "}]},{"spans":[{"text":"As a new model of elite T-Doll, it must grate on you to have to take orders from other Dolls, huh."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Personally, it's not so bad if those orders are interesting enough. Also... "}]},{"spans":[{"text":"Observing the interesting things they do is  a hobby of mine."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"85","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's just like you. Go, and take care of AN-94."}]}]}]}
