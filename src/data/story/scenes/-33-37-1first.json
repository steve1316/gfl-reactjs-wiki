:[{"spans":[{"text":"Concentrate fire on breaking through the defenses of the armored train. "}]},{"spans":[{"text":"We launch a blitz from the other side and take them by surprise. "}]},{"spans":[{"text":"That should also take some pressure off Squad 404."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"A decision that's very much your style, Commander."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood. Then I'll issue the order right away. "}]},{"spans":[{"text":"Operation Golden Fleece is go. "}]},{"spans":[{"text":"Charge!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...BOOM!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Reverse","raw":"BGM"},{"type":"background","value":"2019summer_13","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"(Coughs) This thing...is even spicier than Sangvis Ferri's cannons..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Watch your step. With that kind of firepower... If we take a direct hit, not even a crumb of our core will 