{"name":"-33-37-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"Metro","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the outskirts of Tallinn. "}]},{"spans":[{"text":"The AR Team arrives at the location where defenses are to be deployed and awaits their sortie."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood, Commander. We will coordinate with the other echelons. Leave the assault to us. "}]},{"spans":[{"text":"Roger that. We await your orders."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Have you issued our objectives?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, we're all sorted here. "}]},{"spans":[{"text":"AR-15, is it really a good idea to let M4 go solo?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's her decision, and we should trust our leader. "}]},{"spans":[{"text":"Besides, judging by the current situation, that is the best course of action."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm also a bit worried... "}]},{"spans":[{"text":"If what M4 told us really happens...won't she be in grave danger?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Lighten up. Her resolve is a lot stronger than it was."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Speaking of which, what happened after you connected with M4?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You really want to know?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yeah. You two felt...different after you came out."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It was nothing special, really. "}]},{"spans":[{"text":"We simply turned down some lousy invitations and witnessed a few distasteful moments."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"AR-15... "}]},{"spans":[{"text":"I don't think I get it..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...That's probably for the best. "}]},{"spans":[{"text":"Ignorance is bliss."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Fine... I never really care about such things anyway. "}]},{"spans":[{"text":"All I want is for all of us to stay together!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","