{"text":"Was it William? "}]},{"spans":[{"text":"No... It's probably... her..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_2023Slow_Fall_into_water_v2","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"569","raw":"BIN"},{"type":"bgm","value":"GF_22W_SFX_chant","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Is this the secret of Avernus, then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The lake water slowly washes over her nose, making her suffocate. "}]},{"spans":[{"text":"She doesn't actually feel it, but the despair is all too real."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is it about to begin? "}]},{"spans":[{"text":"I'm actually kind of curious about what she was like in the past."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Those were nostalgic times."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I thought... someone like you would be stern, cold, or... how shall I put this, deranged? "}]},{"spans":[{"text":"I didn't expect you to be so..."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"So what?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"So normal... Like a normal human being. "}]},{"spans":[{"text":"Kind, patient, caring, and determined. "}]},{"spans":[{"text":"You seem more like a normal human being than anyone else in a world like this. "}]},{"spans":[{"text":"Pardon me, I misspoke. "}]},{"spans":[{"text":"You are human to begin with."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Perhaps you meant \"ordinary\". "}]},{"spans":[{"text":"Now, don't think about anything. Just wait patiently."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I have to say... I'm a little nervous..."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Shhh..."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"This concept of yours... is practically a miracle."}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Science has always been the pursuit of miracles."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Like our very existence?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Indeed. "}]},{"spans":[{"text":"...You just gave me the impression that I was talking to someone else."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"And who might that be?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"I once had a student who was as curious as you. "}]},{"spans":[{"text":"We made each other a promise."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"A promise?"}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Yes, a promise. "}]},{"spans":[{"text":"And now, I'm starting to feel something I haven't felt in a very long time... excitement. "}]},{"spans":[{"text":"That's because I'm looking forward... to the return of my student."}]}]},{"sprites":[],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Rain_Heavy","raw":"SE1"},{"type":"effect","value":"%%code=NoiseVideo%%wait=1%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"655","raw":"BIN"},{"type":"whitescreenOff","raw":"白屏2"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Welcome... "}]},{"spans":[{"text":"Anna Viktorovna Tsoi. "}]},{"spans":[{"text":"Your life has only just begun..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
