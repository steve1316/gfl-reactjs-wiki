{"name":"-51-1-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"356","raw":"BIN"},{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Neo-Soviet Military Safe House, Berlin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click... "}]},{"spans":[{"text":"Incoming transmission."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I hope you have good news.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Then sorry to disappoint—we lost her in the end. "}]},{"spans":[{"text":"She's more slippery than any of the targets we've tracked before."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Hm... I've read your report.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Is this the area where you lost track of her?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I'll wait for your follow-up report.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ha. "}]},{"spans":[{"text":"There is a region known as the \"Dead Sea\" nearby. "}]},{"spans":[{"text":"During WWIII, it was a dumping ground for wartime waste. It is now a land of death and decay that even birds cannot fly across."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"A Black Zone?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Without a doubt. "}]},{"spans":[{"text":"It goes without saying that the region is deadly to humans, but even Dolls and mechs cannot stay in there for long."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"That checks out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"We got a name from the internal purge that just happened—\"Avernus\".","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Very apt, don't you think? The entrance to the underworld. A perfect name for this \"Dead Sea\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...I see. "}]},{"spans":[{"text":"Then one must wonder why she'd vanish here."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I await your good news.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Transmission disconnected."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange scowls. Having one's hands and feet bound is especially uncomfortable for someone who has the habit of chewing their nails."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bright lights suddenly start going out one after the other in the distance. "}]},{"spans":[{"text":"The ominous snaps seem to be heralding the approach of some unknown being. They echo incessantly around the spacious room, drumming against her heart."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...Pointless theatrics."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Once Ange gets over the initial shock, she is completely unfazed. "}]},{"spans":[{"text":"To be fair, even if she were fazed, there's nothing she could do about it."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"(Exhales)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everything falls silent around her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"},{"type":"background","value":"510","raw":"BIN"},{"type":"whitescreen","raw":"白屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap. "}]},{"spans":[{"text":"A beam of dazzling light shines upon Ange, illuminating the inside of her eyelids to a soft pink even through her blindfold. "}]},{"spans":[{"text":"She senses an unfamiliar presence not too far away, but she is completely immobilized. Other than her mouth, she can't move a single muscle."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Who's there?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange asks tentatively but receives no answer—which only cements her speculation. "}]},{"spans":[{"text":"Still... even though she expected the meeting to take place, she did not anticipate the fact that he would appear before her in the flesh."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Nice to meet you, Angelia."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[{"type":"bgm","value":"GF_22W_BGM_1","raw":"BGM"}],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"I am the one you've been searching for. You may call me William."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...It is the voice of an adolescent with telltale signs of breaking. "}]},{"spans":[{"text":"Ange can't help but furrow her brow. "}]},{"spans":[{"text":"He didn't even bother to distort his own voice—is he too self-confident... or does he have no intention of letting her go? "}]},{"spans":[{"text":"Or perhaps... "}]},{"spans":[{"text":"No, the most astonishing thing is his youth. He is so young—he's practically a child."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's not your real name."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Why does it matter? "}]},{"spans":[{"text":"It's just a form of address, a pseudonym. You can call me by something else if you like, I don't mind. "}]},{"spans":[{"text":"After all, that's not the point... The point is the reason why I've invited you here, Angelia. "}]},{"spans":[{"text":"I wish to have a simple conversation with you."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...Is this your so-called \"simple conversation\"?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange strains against her binds forcefully but cannot achieve so much as a twitch."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Indeed. I'm afraid this is a necessary precaution to ensure that we can converse in a fair manner."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Fair my fucking ass... Are you that afraid I'll bash your skull in?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"You're mistaken, Angelia... I'm not doing this to protect myself, but to protect you. "}]},{"spans":[{"text":"You want to kill me, and that's no secret. "}]},{"spans":[{"text":"But I must ask you—what exactly is your motive? Are you doing this for vengeance? Or for your meager sense of justice?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You think I'm after you for some petty revenge? "}]},{"spans":[{"text":"How many people have died because of you? If my sense of justice is meager, then nothing in the world is substantial."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Alright, alright, Champion of Justice. "}]},{"spans":[{"text":"But has it ever occurred to you that I'm simply an arms dealer? "}]},{"spans":[{"text":"Even if I hadn't created these weapons, people would still slaughter each other—even with stones and clubs."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You sure make it sound as if you're not to blame. "}]},{"spans":[{"text":"But the fact remains—so long as you're alive, the world will take a turn for the worse."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"No, the fact is even if you succeed—even if William is dead and Paradeus disbands... how will that change anything? "}]},{"spans":[{"text":"Am I really the culprit who plunged the world into misery in the first place?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"So this is what you \"invited\" me for? To listen to your pathetic justification?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Wonderful... You're hurling insults now, which means we can begin our discussion in earnest. "}]},{"spans":[{"text":"Because you have run out of arguments to make, isn't that right?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"You know full well, don't you, Angelia? "}]},{"spans":[{"text":"You know that I am not the cause of the sickness that plagues the world. "}]},{"spans":[{"text":"It is the power structure of the world... those who are at the steering wheel right now. "}]},{"spans":[{"text":"They are the true source of the poison."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Someone comes to mind, right? "}]},{"spans":[{"text":"Those people, those politicians, they have the world in the palm of their hand, but all they care about is their self-interests. "}]},{"spans":[{"text":"If you are so righteous, why do you cry foul at a scientist like me, yet choose to overlook those people? "}]},{"spans":[{"text":"Is that what you call \"justice\"?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I don't see you filled with such righteous indignation as you flirt with those politicians and hand them the butcher's knife."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Now that's how we are different from each other, Angelia. "}]},{"spans":[{"text":"Our aim is actually one and the same. We're just using different methods—you resort to guns, while I go with research. "}]},{"spans":[{"text":"We have both taken many lives along the way... Yes, I do admit that was wrong. "}]},{"spans":[{"text":"But this wrongness is the very proof that this world requires change."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"I am a creator. I am creating a power that is capable of changing the status quo. "}]},{"spans":[{"text":"That's on a whole different level from putting bullets in the heads of a few inconsequential goons. "}]},{"spans":[{"text":"Only when we possess this power will we have what it takes to do what is right. "}]},{"spans":[{"text":"When that time comes, Angelia, think about it... "}]},{"spans":[{"text":"Who has the right to wield such power?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Not you for sure."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"But who else can create this power? "}]},{"spans":[{"text":"...I can bring this power into existence, then bestow it upon someone who deserves it. "}]},{"spans":[{"text":"What do you think, Ange? "}]},{"spans":[{"text":"Do you wish to possess this power?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"This isn't an invitation, but a screening. A test to find those with enough greed and ambition to make a worthy candidate."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Ha, absolute power, eh?"}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"William?","narrator":false,"pages":[{"spans":[{"text":"Absolute power, indeed..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"bgm","value":"GF_22W_SFX_chant","raw":"BGM"},{"type":"background","value":"460","raw":"BIN"},{"type":"effect","value":"%%code=CJ_WC_piaofu%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Avernus."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The ritual begins as the first ray of sunlight shines upon Avernus."}]}]},{"sprites":[{"prefab":"Nyto","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"Two suns, each illuminating a path."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":1,"side":"left","tags":{"Position":"0,50"}},{"prefab":"Nyto","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"The path of the mundane world, and the path of the merciful Father."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":1,"side":"left","tags":{"Position":"0,50"}},{"prefab":"Nyto","expression":2,"side":"left","tags":{"Position":"0,50"}}],"ops":[{"type":"brighten","raw":"同时点亮"}],"speaker":"Black/White Nyto","narrator":false,"pages":[{"spans":[{"text":"Sanctum turned into the Devil's pit, the scales into an alter, drenched in sinners' blood. "}]},{"spans":[{"text":"Each Fury with her nails was tearing at her breast; they smote them with their hands, and cried so loud."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"When half way through the journey of our life, "}]},{"spans":[{"text":"Through this Heaven and Hell art we led, "}]},{"spans":[{"text":"Thou wast made before I unmade. "}]},{"spans":[{"text":"The anguish thou art in perchance withdraws thee from my memory. "}]},{"spans":[{"text":"We shall be together, in neither Heaven nor Hell, neither cursed nor redeemed. I did not die, nor yet remained alive."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Nyto","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"Big Sister Nemhran, Father is looking for you."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Alright. "}]},{"spans":[{"text":"Olga..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Give me this file when I'm back."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"side":"left","tags":{"Position":"0,50"}}],"ops":[],"speaker":"Olga","narrator":false,"pages":[{"spans":[{"text":"Yes, Sister."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"447","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a soft \"ding\", Nemhran strolls out of the elevator."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She walks up to the room ahead with her head lowered, then pushes open the door reverently as she utters a cheerful greeting."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"507","raw":"BIN"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"...Felicitations, Father."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Everything is according to plan. "}]},{"spans":[{"text":"Now the whole world shall hear your voice."}]}]},{"sprites":[{"prefab":"NPC-William","expression":0,"side":"left","tag