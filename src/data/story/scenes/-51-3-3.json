[{"spans":[{"text":"Hailing Umbrella, this is Nitrogen. We've encountered the target, Morridow. "}]},{"spans":[{"text":"However, it looks like she's boarded a Paradeus truck and left. We cannot pursue further."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Umbrella copies. Don't push yourself. You just need to lock onto the tracking device.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Roger."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Squad Ferrum is heading over to back you up.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Roger, with heavy firepower we'll be able to—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mona suddenly stops speaking. Though she was only distracted for a moment by her conversation, she comes to an abrupt realization... The Nyto in white who was standing not too far ahead has just vanished in the blink of an eye."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...Where's Grig?"}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"Huh? I-I don't know... "}]},{"spans":[{"text":"Did she just vanish into thin—?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Sword_Scope","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","r