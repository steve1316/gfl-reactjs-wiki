es behind her—"}]},{"spans":[{"text":"\"Move in.\""}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Upon receiving the signal, the two Dolls stick to cover and proceed toward the target in an orderly fashion. "}]},{"spans":[{"text":"Mona opens a short-range intra-squad comms channel."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Remember to conceal your signals.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"Got it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"The enemy is inside this building.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Correct. I just scanned around us. Even if they're all mobs, we can't take on their numbers.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Also, we're supposed to be following the target, so we need to avoid spooking her.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Concealed in the shadows of the ruined masonry, the three girls remain motionless, like stone statues blending in with the environment."}]}]},{"sprites":[{"prefab":"SP9","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Take note. The target has appeared.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"Target Morridow locked. Signal from the tracking device matches our information.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"QBZ191","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"No. 9","narrator":false,"pages":[{"spans":[{"text":"The person next to her looks pretty impressive...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"That's Grig. Her swordsmanship is incredible, so make sure you don't let her get close—that's what the AR Team reported.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Rhino","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Rhino","narrator":false,"pages":[{"spans":[{"text":"She looks like the agile type. Those are hard to handle.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under the trio's watchful gaze, the white-clad Grig helps support Morridow to a ruined building ahead of them, with several Paradeu