."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RPK-16 smiles and follows the Nyto out of the hall. Soon, the two of them are alone."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Has Angelia been settled in?"}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}},{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}},{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Big Sister Nemhran thinks very highly of you. "}]},{"spans":[{"text":"She says you're more efficient than Big Sister Gray."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}},{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"That would be going too far. I'm just doing my duty."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}},{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"We reward capable individuals appropriately... "}]},{"spans":[{"text":"Paradeus will make your dream come true."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"sprit