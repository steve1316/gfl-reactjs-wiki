[{"text":"I told him to keep it a secret. "}]},{"spans":[{"text":"...Worked pretty well, didn't it?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"You'd better explain yourself."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"As you can see, Paradeus is getting desperate. "}]},{"spans":[{"text":"When they tried to assassinate me, they knew they had to avoid being discovered. "}]},{"spans":[{"text":"But this time, because we already knew their target and were well-prepared, assassination wasn't going to work. "}]},{"spans":[{"text":"So they had to risk it and take a more direct approach. "}]},{"spans":[{"text":"They sent a force just large enough to overpower you—no more, no less."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"And when I ambushed them out of the blue, things got completely out of hand for them."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Wait, so when did you escape from the fire?"}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"...Once Miss Ange had fled, the assassins retreated. "}]},{"spans":[{"text":"But I couldn't get out with my twisted ankle."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"It was Miss AK-12..."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I see, so it's all thanks to Miss Snow Wolf. "}]},{"spans":[{"text":"When she gets downloaded into a new body, remind me to buy her a drink."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Enough chit-chat. We're on a tight schedule here. "}]},{"spans":[{"text":"Take the Nyto's corpse away. It's importance evidence. "}]},{"spans":[{"text":"...Where's Leone?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Your Silver Fox is watching her."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"So where are they?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J turns around and scans the surroundings."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":2,"shown":true,"side":"l