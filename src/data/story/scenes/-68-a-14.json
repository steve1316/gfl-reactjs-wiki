e,"pages":[{"spans":[{"text":"Who are you?"}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I am your past."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Don't you hate the feeling of not remembering anything? "}]},{"spans":[{"text":"Come to me, and I can release you from your suffering."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Hold on, what's all this about?"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...This is Erma's mission in life—to become the true mistress of the Summer Garden. "}]},{"spans":[{"text":"Because she is Doctor Hume's only daughter."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Only daughter? What does that make us then?"}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"We are knights, princesses, maidservants, and soldiers. "}]},{"spans":[{"text":"We are all Dolls that the Doctor created from commissioned blueprints. "}]},{"spans":[{"text":"Only Erma was given the Doctor's highest authorizations. "}]},{"spans":[{"text":"In his own words, only Erma is a work of art, while the rest of us are just ordinary merchandise."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Highest authorizations... of what?"}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Come. Become one with me and you will find out."}]}]},{"sprites":[{"prefab":"Erma","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma hesitates uneasily."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Mirabelle, what is the meaning of this?","style":{"size":"25"}},{"text":" "}]},{"spans":[{"text":"The three of us have been through so much together...","style":{"size":"25"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"There's no point in having secret conversations in Her Majesty's presence. "}]},{"spans":[{"text":"Reinette, what I've shown you is only a very small part of it. "}]},{"spans":[{"text":"Consider our serial numbers and it should be obvious how many others like us have lived in the Summer Garden. "}]},{"spans":[{"text":"But there has only ever been one King, and there has only ever been one Erma."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...I don't understand. "}]},{"spans":[{"text":"So we're all just part of some... grand design?! "}]},{"spans":[{"text":"So you and I were both tasked with bringing Erma here in the event of the Doctor's death?"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Yes. So long as we are still connected by our special comms channel... So long as this verdant path still exists... So long as the spring water keeps flowing... "}]},{"spans":[{"text":"We will certainly be reunited here and deliver Erma to Her Majesty."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"This feels off... "}]},{"spans":[{"text":"Erma, don't get any closer."}]}]},{"sprites":[{"prefab":"Erma","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Right."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...I need to see what exactly this King is.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Utilizing the lighting control authorization that Erma has granted her earlier, Reinette turns up the light around the King. "}]},{"spans":[{"text":"But nothing happens. "}]},{"spans":[{"text":"The candlelight flickering in the soft breeze is still too dim to illuminate the figure."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Why is this not working?","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Oh, you must have all forgotten my face. "}]},{"spans":[{"text":"In that case, let me show you again."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The King raises a hand, holding a lantern that has suddenly materialized. Light spills across her face."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"}],"speaker":"Her Majesty the King (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You are Erma."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_2","raw":"BGM"}],"speaker":"Her Majesty the King (?)","narrator":false,"pages":[{"spans":[{"text":"Yes, I am Erma of the past and future."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"If you're both the past and future, why do you have to merge with her?"}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King (?)","narrator":false,"pages":[{"spans":[{"text":"Because she is the present. "}]},{"spans":[{"text":"She carries the only blessing that Archbishop Hume had given her—the ability to forget. "}]},{"spans":[{"text":"As soon as I break the spell, she will join with me, and we will become the true mistress of the Summer Garden. "}]},{"spans":[{"text":"I am the true form of your base layer."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...Doctor Hume planned all this..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma rummages through the pockets of her coat and produces an object, which she shows the others— "}]},{"spans":[{"text":"It is a paper note."}]}]},{"sprites":[{"prefab":"Erma","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"This was Mother's coat. I've been keeping it on me since he died."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"When people are parted, they tend to recall only the happy memories and gradually forget the moments of pain and sorrow. "}]},{"spans":[{"text":"This is a kind of defense mechanism for humans, and also a reflection of what they yearn for— "}]},{"spans":[{"text":"Love and happiness. Things that are hard to come by. "}]},{"spans":[{"text":"We desperately cling to them because we need them to sustain our lives."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I never understood why Mother kept making me forget, but I've always believed that he did this for my benefit."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...All this time, I've been living in fear and terror. "}]},{"spans":[{"text":"My unreliable memory is almost sinful. "}]},{"spans":[{"text":"I feel like I've wronged everyone. "}]},{"spans":[{"text":"I don't remember the life we shared together, nor do I remember that 620 has been waiting for me in the Summer Garden this whole time."}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-200,0"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"It's not your fault."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"In my memory, Mother always shot me before my memory was reset."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Did I do something wrong? "}]},{"spans":[{"text":"Why did he do that to me?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The coat slides out of Erma's arms and falls to the floor in a crumpled heap, like a deflated balloon."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I want a family. I want sisters. I want Mother. I want to have company. "}]},{"spans":[{"text":"Because... I'm scared of being alone."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Now I have Mother and sisters. "}]},{"spans":[{"text":"Yet you all tell me you hate me and you don't need me like this. "}]},{"spans":[{"text":"The one you love and want isn't me, who is an utterly useless amnesiac... "}]},{"spans":[{"text":"Rather, the \"Erma\" who possesses all her memories and the ability to change everything. "}]},{"spans":[{"text":"The perfect \"work of art\"."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...What are you talking about? We never said any of that."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I tried to pretend it didn't bother me. I tried so hard to retrieve my memories of the past."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"0,0"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"But I'm sorry... "}]},{"spans":[{"text":"I just find those memories exasperating... and sickening. "}]},{"spans":[{"text":"I even deluded myself into thinking they were the last gift that Arthur Hume had left me..."}]}]},{"sprites":[{"prefab":"Erma","expression":16,"shown":true,"side":"left","tags":{"spritePosition":"70,-140","spriteScale":"1.08"}}],"ops":[{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.6%%duration=0%%","raw":"bg_move"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"This coat... I don't want it anymore."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma's tears stream down her face and land on the coat lying on the ground."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Erma","expression":28,"shown":true,"side":"left","tags":{"spritePosition":"0,100","spriteScale":"1.55"}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.6%%duration=0%%","raw":"bg_move"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...What I've been searching for this whole time turned out to be a shadow of the past. "}]},{"spans":[{"text":"A past that doesn't belong to me; a future that doesn't belong to me. "}]},{"spans":[{"text":"I don't know what's the point anymore."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1.2%%duration=0%%","raw":"bg_move"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Erma, calm down!"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"shown":true,"side":"left","tags":{"spritePosition":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I will not calm down. I will not obey. I am rebelling. "}]},{"spans":[{"text":"Hate me all you want, because I hate you too."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma storms out of the garden."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King (?)","narrator":false,"pages":[{"spans":[{"text":"She'll come back."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Erma!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette gives chase immediately."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
