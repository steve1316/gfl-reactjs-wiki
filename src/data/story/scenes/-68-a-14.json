."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Do you really think he can be resurrected?"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...I don't know."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"Erma","expression":20,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...You've been working so hard for something you don't actually understand? You're not very smart either."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"You think I'm not gonna beat you up just because we're in the Summer Garden?"}]}]},{"sprites":[{"prefab":"Erma","expression":13,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Right."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"According to the intel I received... someone has been successfully resurrected. "}]},{"spans":[{"text":"And your Commander met this person."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60"}},{"prefab":"Erma","expression":17,"shown":true,"side":"left","tags":{}}],"ops":[],"spea