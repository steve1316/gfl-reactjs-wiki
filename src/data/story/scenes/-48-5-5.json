t in here?"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, just having some usual bickering."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Is this what life is usually like at the Griffin base...?"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Uh, not exactly..."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Oh right, the Earl just left a message in response to your inquiry regarding the exchange of hostages proposed by Paradeus that I passed on to him earlier."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What did he say?"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"He said, \"You may do what you will with Morridow.\""}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please convey my gratitude to the Earl for his continued support."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Will do."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Khaybar skirts around the various obstacles lying on the floor and vanishes from sight."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Are we really handing Morridow over? "}]},{"spans":[{"text":"M4 did say she was going to handle it, but what happened at the airport was way too sudden."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"She mentioned a timing. This happens to be a good one. "}]},{"spans":[{"text":"We can go along with her plan and even get Ange back."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"But she never explained her plan in detail before she was gone."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"She didn't leave any concrete instructions, but her intention is clear."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I also want to get Ange back, but if we botch this, Morridow might return to William with an abundance of information about us."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We'll be playing right into Paradeus' hands. Our losses will be devastating."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The stakes are very high, 45, but this is also a rare opportunity for us to get o