nder","narrator":false,"pages":[{"spans":[{"text":"Indeed. At this rate, we'll be able to complete the mission in just half an hour. "}]},{"spans":[{"text":"I'm glad we can make it in time."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"Hm... But I'm getting some complications from my reading."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Huh? What does that mean?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander stares dubiously at K5, who's stacking up her tarot deck."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"It means..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"It means—there's no way you can get away with this, Commander!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Kalina?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While the machine is in order and everything is going according to plan... they are interrupted by a familiar voice, and Kalina comes storming into the room."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"I've heard all about what happened, Commander! "}]},{"spans":[{"text":"How can you do this?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Who told you? No, wait, what did I do wrong?!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"2022_white_valentine_BGM2","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gazes uncomprehendingly at Kalina for the unexpected dressing down."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"It was Agent who told me. I ran into her when I got out of bed and was just about to set off for work. She was just done punishing Destroyer and reported the situation to me."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You got out of bed... at this hour? Is this usually when you start working?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Of course, but that's not the point. "}]},{"spans":[{"text":"Commander, look at the chocolate in your hand. "}]},{"spans":[{"text":"Surely you're not planning to give that to the Dolls?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's wrong... with it?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander studies the remaining chunk of the prototype chocolate in their hand. It seems perfectly fine."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Oh boy..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina lets out a heavy sigh."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander, how many chocolates did you receive on Valentine's Day?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"About... 300?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Did any of those look the same?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No... they were pretty much all handmade. "}]},{"spans":[{"text":"The few commercial ones were also quite fancy."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"That's exactly it! All the Dolls put a lot of thought into preparing their gifts for you because they're truly grateful to you. "}]},{"spans":[{"text":"Only for you to give them mass-manufactured chocolate in return?! "}]},{"spans":[{"text":"How disappointed do you think they'd be?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Crap. "}]},{"spans":[{"text":"Now that you point it out... these chocolates... are all completely identical!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander finally understands Kalina's point."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How did I not think of that...? This is no different than just buying 300 pre-packed chocolates from the grocery store!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"You see?!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But we only have six more hours. "}]},{"spans":[{"text":"I really don't have enough time to customize each chocolate. "}]},{"spans":[{"text":"What should I do?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Where did you get this machine?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I asked Miss Persica to build it for me."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"In that case..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina looks at the Commander with great determination."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"There's only one thing to do."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica's room, Griffin Base."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is this really a good idea...? Waking her up twice in a day?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"There's no other way. "}]},{"spans":[{"text":"As long as we apologize properly, I'm sure Miss Persica will forgive us."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"...I'll have to disagree."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hunter gazes at the bundle of blanket curled up next to the bed."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"Even if we take the risk and wake her up, I don't think she'll be inclined to help us."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"It can't be that bad. Miss Persica will surely understand."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Miss Persica—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Completely oblivious to the severity of the situation, Kalina walks up to the bundle and grabs a corner of the blanket..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hold on, Kalin—"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"—?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as Kalina is about to rouse Persica, Persica suddenly bolts up!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A cold wind whizzes past Kalina's cheek, ruffling her hair."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The next moment, the coffee mug that Persica just hurled hits Commander right in the forehead."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"OOOF?!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Will you stop badgering me?! I was just starting to doze off!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"M-Miss Persica?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An irate Persica leaps to her feet, the corner of her mouth still stained with coffee."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"There's no end to this nuisance! What is it you want this time?!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Kalina swallows everything she was going to say as she gapes at the utterly demented Persica."}]}]},{"