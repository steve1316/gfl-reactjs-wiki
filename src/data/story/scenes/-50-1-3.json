{"name":"-50-1-3","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"March 14, 4am."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"工厂背景avg","raw":"BIN"},{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica's lab, Griffin Base."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Standing in front of the massive machine, the Commander and the four Dolls nervously extract the freshly produced chocolate from the conveyor belt and start tasting it. "}]},{"spans":[{"text":"In addition to Hunter and LWMMG, the company now consists also of K5 and M1 Garand, whom LWMMG has woken up for some extra pairs of hands."}]}]},{"sprites":[{"prefab":"K5","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"K5","narrator":false,"pages":[{"spans":[{"text":"How does it taste, Commander? "}]},{"spans":[{"text":"According to my divination, it should be pretty good."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah... It IS very good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander snaps the prototype chocolate into two chunks and pops one into their mouth. The velvety sweetness melts on their tongue."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"