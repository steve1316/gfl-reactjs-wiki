FF"}},{"text":" "}]},{"spans":[{"text":"Anyway, let's work together and bring about victory for FN squad!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"FAL","expression":8,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"FAL?","narrator":false,"pages":[{"spans":[{"text":"Okay.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Then I'm counting on you, Miss Gr G36.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep. "}]},{"spans":[{"text":"Without hesitation, the user called FAL leaves the chatroom."}]}]},{"sprites":[{"prefab":"G36","expression":17,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Gr G36","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And she's gone.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Was that... really FAL?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"FN49","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}},{"prefab":"G36","expression":17,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Why would you say that, Miss Gr G36?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"FN49","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}},{"prefab":"G36","expression":17,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Gr G36","narrator":false,"pages":[{"spans":[{"text":"How could a Werewolf just expose herself like that in an open chatroom...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Shouldn't she be hiding and trying not to be noticed?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And her way of speech... seems a bit odd to me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"FN49","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}},{"prefab":"G36","expression":17,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Don't worry! Leader only came in because she saw me! That means she trusts me!!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Well then, I'm counting on you, Miss Gr G36!!!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Thank you very much!!!","style":{"color":"#00CCFF","size":"50"}}]}]},{"sprites":[{"prefab":"G36","expression":17,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Gr G36","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Very well then.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"frame","value":"2","raw":"边框"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"FAL","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"background","value":"2022_Stall","raw":"BIN"}],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"I've never connected to any chatroom, nor was I a Werewolf! "}]},{"spans":[{"text":"Who impersonated me?!"}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"I-I don't know... "}]},{"spans":[{"text":"I didn't suspect a thing until after Miss Gr G36 linked us up and we exchanged our details... "}]},{"spans":[{"text":"It was only then I realized I'd been tricked... Sniff..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"FAL lets out an exasperated sigh."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Private chats outside the game... It's a violation of the rules. "}]},{"spans":[{"text":"This time, it is indeed the fault of your own carelessness, FF FN49."}]}]},{"sprites":[{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Did you not consider your curse when you linked yourself to FAL? "}]},{"spans":[{"text":"While the both of you would've been in a third faction, you would've still been on the same side! That's a guaranteed loss no matter how you slice it!"}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}},{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"I... I didn't consider much other than the fact that Leader said she wasn't very good at playing as a Werewolf... "}]},{"spans":[{"text":"B-besides, maybe the curse only targets the Villagers, and a third faction could bring about a good ending... "}]},{"spans":[{"text":"A-anyway, that's what I thought... "}]},{"spans":[{"text":"However..."}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}},{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"You ended up suffering the consequences of your own actions, didn't you?"}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"I-I'm sorry... "}]},{"spans":[{"text":"I'm the one who ruined the game for the Villagers, the one who screwed over Leader, and FN squad as well..."}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"FF FN49 lowers her head in anticipation of harsh criticism, as she does every time after a failure. "}]},{"spans":[{"text":"Until—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pair of hands gently holds her tight. "}]},{"spans":[{"text":"The comfort of FAL's palm slowly warms her body. "}]},{"spans":[{"text":"She stares into FAL's eyes, and her body slowly stops trembling in fear."}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Le... Leader?"}]}]},{"sprites":[{"prefab":"FAL","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_Memorial","raw":"BGM"}],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"This is not your fault. "}]},{"spans":[{"text":"Be it the curse, or that Cupid link... they aren't your fault. "}]},{"spans":[{"text":"Thank you for everything you've done for me, FF FN49... "}]},{"spans":[{"text":"Thank you for trying to protect me and the whole FN squad..."}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Leader..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"FAL sighs, and with FF FN49's hand in her palm, they slowly walk up to the Commander."}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"Commander, maybe FF FN49's rule-breaking move can't be forgiven, but... she only did it because she was way too afraid of the \"curse\", and cared way too deeply for FN squad. "}]},{"spans":[{"text":"That reason motivated her into that chatroom, and made her believe the lies of that imposter. "}]},{"spans":[{"text":"This is all because I failed as a leader, not FF FN49 as a subordinate. "}]},{"spans":[{"text":"She's a loyal squadmate—not only as a member of FN squad, but also as the Knight of the Villagers. "}]},{"spans":[{"text":"It is my honor to have such a partner."}]}]},{"sprites":[{"prefab":"FN49","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Sob... "}]},{"spans":[{"text":"Thank you, Leader... I'm sorry..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"FF FN49 starts crying again. FAL, with a rare affectionate look in her eyes, pats her on the shoulder."}]}]},{"sprites":[{"prefab":"CBJMS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Alright, stop crying! We haven't lost yet! What are you crying about?!"}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"That's rich coming from you, C-MS."}]}]},{"sprites":[{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Hmph."}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"Commander, I have an ungrateful request to make. "}]},{"spans":[{"text":"Please help us achieve victory... I would like to give it to FF FN49 as a gift."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"A gift?"}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"That \"curse\" of yours—remember that? "}]},{"spans":[{"text":"FF FN49, if we win, then it shall be no more!"}]}]},{"sprites":[{"prefab":"FN49","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Yeah!"}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"However, FF FN49, you need to understand this: "}]},{"spans":[{"text":"The reason why you made these mistakes is your overwhelming fear of the \"curse\", and as such, you've lost your confidence. "}]},{"spans":[{"text":"There is no such witchery in this world, and failures aren't that scary. "}]},{"spans":[{"text":"What's truly scary is losing yourself, and turning to deceitful tricks only to lose yourself even further. "}]},{"spans":[{"text":"You cannot do that in the future, understand?"}]}]},{"sprites":[{"prefab":"FN49","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"Y-yes... Leader!"}]}]},{"sprites":[{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Humph, what you two discussed sounds great indeed! But what if the Commander doesn't agree?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The group looks back at the Commander in unison."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well... I am willing to help..."}]}]},{"sprites":[{"prefab":"FN49","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[],"speaker":"FF FN49","narrator":false,"pages":[{"spans":[{"text":"C-Commander... Thank you!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"FF FN49 shakes the Commander's hand in excitement, her tearful eyes full of joy."}]}]},{"sprites":[{"prefab":"FAL","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"Thank you, Commander... The Villagers' victory now lies within your hand. "}]},{"spans":[{"text":"I trust your judgement."}]}]},{"sprites":[{"prefab":"CBJMS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Hey, hey, hey! Stop wasting time! "}]},{"spans":[{"text":"Come finish the game and then go vote, Commander!"}]}]},{"sprites":[{"prefab":"FAL","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"It's rare for our goals to align, C-MS."}]}]},{"sprites":[{"prefab":"CBJMS","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"You should be glad we're on the same side, otherwise I would have never bothered with these rookie squadmates of yours. "}]},{"spans":[{"text":"Commander, since you're voting for the Villagers, how about you just vote for me? Forget about those two! "}]},{"spans":[{"text":"I'm getting pissed just thinking about them."}]}]},{"sprites":[{"prefab":"FAL","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"FAL","narrator":false,"pages":[{"spans":[{"text":"...Are you looking for a fight?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright, alright. Since we share the same goal, let's not argue with each other unnecessarily. "}]},{"spans":[{"text":"We should just get back to the game!"}]}]},{"sprites":[{"prefab":"CBJMS","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"C-MS","narrator":false,"pages":[{"spans":[{"text":"Hmph! As a courtesy to the Commander, C-MS's stall, Fiery Beacons, is now open to you!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
