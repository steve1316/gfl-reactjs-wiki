{"name":"1-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"8","raw":"BIN"},{"type":"bgm","value":"BGM_Sunshine","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sangvis outpost successfully shut down. Transport route safety confirmed."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Well done, Commander. The injured T-Dolls should arrive any minute."}]},{"spans":[{"text":"These T-Dolls are especially valued because they are possible witnesses to some intel."}]},{"spans":[{"text":"If the intel proves to be true, it might mean open war between us and Sangvis Ferri."}]},{"spans":[{"text":"...Yes, 'us', and that includes your troops, Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click."}]},{"spans":[{"text":"A ping comes from behind Helian."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Oh? Looks like the T-Dolls are back."}]},{"spans":[{"text":"Please excuse me."}]}]},{"sprites":[],"ops":[{"type":"background","value":"22","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Griffin Headquarters. The damaged T-Dolls have arrived at the Factory."}]}]},{"sprites":[{"prefab":"MAC10","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"Humph, so we're back already..."}]},{"spans":[{"text":"Not the slightest bit of fun during the whole thing. I was bored to tears."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"MAC10","expression":1,"shown":true,"side":"left","ta