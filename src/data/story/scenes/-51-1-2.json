{"name":"-51-1-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Jet_Passby","raw":"SE1"},{"type":"background","value":"Desert","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Unity Day, on the Soviet-German border."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_ElecSpace","raw":"SE1"},{"type":"bgm","value":"10065","raw":"BGM"}],"speaker":"WGF Air Traffic Control","narrator":false,"pages":[{"spans":[{"text":"Beep, beep, beep, beep! Warning! Warning! Warning!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":"WGF Air Traffic Control","narrator":false,"pages":[{"spans":[{"text":"This is Air Traffic Control of the Western Group of Forces. You are about to enter a military no-fly zone. Please alter your course immediately and identity yourself, or the Soviet Air Forces will be authorized to shoot down your aircraft.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Beak."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"WGF Air Traffic Control, please open encrypted channel number 13."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Air Traffic Control","narrator":false,"pages":[{"spans":[{"text":"The radio operator has been notified. Connecting through encrypted channel.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":"Radio Operator","narrator":false,"pages":[{"spans":[{"text":"Security message received... Identity verified—Black Box.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"There are currently dozens of aircrafts awaiting directions.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We are unable to give you permission to land. Please increase your altitude.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"I freaking hate this codename..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Apologies, but we need to land right now. "}]},{"spans":[{"text":"This very instant."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Radio Operator","narrator":false,"pages":[{"spans":[{"text":"But...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"This is a Statesec A-tier command code. "}]},{"spans":[{"text":"We have to land immediately."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Radio Operator","narrator":false,"pages":[{"spans":[{"text":"This is...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...Alright, we will allocate a flight line for you right away.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...No need for that. Just give us permission to land. "}]},{"spans":[{"text":"We have a more direct way of coming down."}]}]},{"sprites":[],"ops":[],"speaker":"Radio Operator","narrator":false,"pages":[{"spans":[{"text":"A more direct way?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"Hahaha, we can just jump off once we've reached a certain altitude!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Jet_Passby","raw":"SE1"}],"speaker":"WGF Air Traffic Control","narrator":false,"pages":[{"spans":[{"text":"...Hold on, that's the command cen—"}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"I know, that's exactly why I'm—"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her voice is soon garbled and drowned out by the howling wind."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An intense argument is currently taking place in the command center, which is still oblivious to what has just transpired."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"10247","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It can be heard even through the thick and heavy door."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2022winter_Office","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"You must depart immediately for Moscow!","style":{"size":"50"}},{"text":" "}]},{"spans":[{"text":"This is an order from our superior! You're defying a direct order without a valid reason! Do you want to be dragged in front of a military tribunal?!"}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer B","narrator":false,"pages":[{"spans":[{"text":"Dozens of take-off requests just came in simultaneously for unstated mission objectives! This deviates from the central authority's customary guideline! I demand that we put in an inquiry to Moscow!"}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"You're going over the head of your direct superior to make a report?! "}]},{"spans":[{"text":"This is treason! "}]},{"spans":[{"text":"The Military adheres to a strict chain of command! There is only one thing to do when our superior issues an order, and that is to obey."}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer B","narrator":false,"pages":[{"spans":[{"text":"It isn't just a simple border that we are guarding—we are the first line of defense against Europe! "}]},{"spans":[{"text":"I must report this to Moscow even at the risk of a dishonorable discharge! "}]},{"spans":[{"text":"Two MiGs are already on the way. We must hurry!"}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"But what about the border?! Are you planning to ignore their request for support?! "}]},{"spans":[{"text":"Lieutenant Colonel, we must execute our order immediately!"}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer B","narrator":false,"pages":[{"spans":[{"text":"If we execute the wrong order, an air force won't be the only thing we lose! "}]},{"spans":[{"text":"Instead of arguing ceaselessly here, we should report this as soon as possible."}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"We are part of our country's regular army! "}]},{"spans":[{"text":"If we have to question our superior over any order that we find dubious, we'll end up calling Moscow about everything! "}]},{"spans":[{"text":"Going over our superior's head is also making trouble for the central authority!"}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...That's enough!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"THUNK!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sound of a large impact comes from above the command center, and all the military officers immediately draw their sidearms."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The next instant, the door to the command center is opened by a security guard. "}]},{"spans":[{"text":"This makes no sense, but it does show that whoever is here possesses adequate clearance."}]}]},{"sprites":[{"prefab":"Beak","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Beak","narrator":false,"pages":[{"spans":[{"text":"...What an intense argument."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two Dolls walk in through the door. "}]},{"spans":[{"text":"Guests that are utterly unexpected."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We are the \"Black Boxes\" sent here by Statesec. Who's in charge here?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A man steps forward."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...Statesec? You're Chief Zelinsky's associates?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Beak."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beak rolls her eyes and flashes her ID to the man."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...Apologies. Please state the purpose of your visit."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The officers exchange looks of confusion. They grudgingly stow away the weapons that they've drawn by reflex and return to their own seats."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That was quite the... warm welcome we received, but I hope everyone here has calmed down?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"Chief Zelinsky isn't one to make unnecessary moves."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That's precisely why I'm here. "}]},{"spans":[{"text":"A Doll can convey a superior's command accurately."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...Does the central authority not trust us anymore?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"They've sent me here to ensure your loyalty—or should I say, to instill some loyalty in you."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"Statesec reports directly to the central authority. Your loyalty is obviously unimpeachable."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"But the same cannot be said about this base."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...We are loyal to the country."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Should I reiterate the mandate of the Military? "}]},{"spans":[{"text":"Your loyalties can only lie with the central government."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"Lieutenant Colonel! We should not have to declare our loyalty to a mere Doll!"}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer B","narrator":false,"pages":[{"spans":[{"text":"She has Statesec papers on her! "}]},{"spans":[{"text":"Right now she speaks with Statesec's authority, Lieutenant Colonel."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"How are you planning to instill loyalty in us?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The corner of M16's lips curl up faintly."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I am going to set up a special hotline."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...Won't that be bypassing the military district's jurisdiction? "}]},{"spans":[{"text":"Statesec may be under the central authority, but we do not answer to Statesec."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You asked how I would instill loyalty in you, and I gave you the answer. "}]},{"spans":[{"text":"But at the end of the day, it is on you to prove your loyalty."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Unlike you humans, a Doll like me has no such qualms. "}]},{"spans":[{"text":"This is why Statesec has sent me."}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer A","narrator":false,"pages":[{"spans":[{"text":"...We have received over 20 operation directives at the same time; there's no way for us to tell which are genuine."}]}]},{"sprites":[],"ops":[],"speaker":"Military Officer B","narrator":false,"pages":[{"spans":[{"text":"Then the special hotline is the only genuine thing we can trust."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 holds the silent Lieutenant Colonel's gaze."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"This base is hardly the only one that's been thrown into utter disarray, I'm sure. "}]},{"spans":[{"text":"However, Statesec only sent me to this particular one."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...I understand. We will call the special hotline... "}]},{"spans":[{"text":"And obey all commands from the central authority."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Then that concludes the first task on my agenda."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Now for my second task, which marks the true beginning of my actual operation... "}]},{"spans":[{"text":"I need to carry out a secret mission on behalf of Statesec, and I require some support."}]}]},{"sprites":[],"ops":[],"speaker":"WGF Lieutenant Colonel","narrator":false,"pages":[{"spans":[{"text":"...Understood. "}]},{"spans":[{"text":"I will make the arrangements immediately."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 nods at the Lieutenant Colonel and turns to leave the command center."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"BG_Inner","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Operation Aeneas Conference Room."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_stage11","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Identity verified, please input your login password. "}]},{"spans":[{"text":"Password accepted. Connecting... "}]},{"spans":[{"text":"You have successfully logged in to the Operation Aeneas Conference Room."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Wow, this meeting venue is super fancy!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Well of course! The Commander had this built just for us!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I funded half of it. "}]},{"spans":[{"text":"This server is no simple thing. Its security and stability are both guaranteed. "}]},{"spans":[{"text":"You can connect to this conference room even from places with strong signal interference. "}]},{"spans":[{"text":"Most importantly, logged-in Dolls will be able to maintain clear communication. "}]},{"spans":[{"text":"...The drawback is that it runs on my cache, so if I go down, it'll go down with me. Is anyone gonna reimburse me for all this effort?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The Commander will make sure you're paid accordingly. "}]},{"spans":[{"text":"N