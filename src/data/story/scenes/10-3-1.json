{"name":"10-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Five minutes later, on board the vehicle en route to the outpost where the Commander is stationed. "}]},{"spans":[{"text":"SOP-II is corresponding with the Commander."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"(So this is...M4A1...) "}]},{"spans":[{"text":"(I gotta say something...) "}]},{"spans":[{"text":"Um..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 looks up and gazes at RO."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I just want to say... "}]},{"spans":[{"text":"(C'mon, RO! Say something!) "}]},{"spans":[{"text":"You're the leader of the AR Team now, aren't you...?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"That is correct. "}]},{"spans":[{"text":"You just transferred your command authorizations to me, didn't you?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Err...you're right... "}]},{"spans":[{"text":"Oh, and...regarding the search for M16A1..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You didn't find her, did you?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"That's true, but there's still a possibility that she survived, so please—"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Our current mission takes higher priority. No further attempts to find M16A1 are to be made for now."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hmm..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Thank you for your concern, but I'm fine."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 touches M16A1's equipment case gently."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"We'll talk after this operation is over. "}]},{"spans":[{"text":"(This isn't the time to be dejected...) "}]},{"spans":[{"text":"(It's because of my indecisiveness that the AR Team is in this sorry state...) "}]},{"spans":[{"text":"(AR-15...) "}]},{"spans":[{"text":"(And M16...) "}]},{"spans":[{"text":"(I must pull myself together. I can't afford to be the weakling that I've always been...) "}]},{"spans":[{"text":"(Which is why...I must focus on leading everyone in accomplishing our mission...like a proper commander!)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II turns around."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M4...are you okay?"}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm fine. Don't worry about me."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"How can I not worry? You've been away for so long..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"As you can see, I'm perfectly alright. "}]},{"spans":[{"text":"You should be happy about that. "}]},{"spans":[{"text":"More importantly, what did the Commander tell you?"}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The Commander said the Military just gave the order to deploy our forces..."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Right now? What's the hurry?"}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We won't have time to catch a break at the base. We must head toward the S.F. stronghold and regroup with the Commander right away. "}]},{"spans":[{"text":"The Commander should've set off by now."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Good. Looks like we haven't missed the first kill."}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Are you sure you're okay, M4?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I told you, I'm fine. We're gonna cause a bloodbath on the field soon. Isn't that what you want?"}]}]},{"sprites":[{"prefab":"SOPII","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Of course I can't wait to tear apart some Sangvis junk, but I'm more worried about you. You've barely recovered..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It's taken me way too long to recover. It's time I stretched myself a bit. "}]},{"spans":[{"text":"Everyone, check your gear. We're heading out!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
