{"name":"-77-A-38","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"569","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Failed Isomer (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"You... you're..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"I am the collective of failed Isomers. Of what you call \"noise\" and \"failed rejects\". "}]},{"spans":[{"text":"As a representative, you may call me \"Nimogen\"."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"Nimogen... You're the... from the array... "}]},{"spans":[{"text":"...What are you doing here?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"You have never seen the bottom of the Lake, because even butterflies cannot traverse the Dead Sea. "}]},{"spans":[{"text":"I am here because this is where I belong. I was not born here, but this is my final resting place."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"...It's her. "}]},{"spans":[{"text":"She's just ahead, right?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"You are afraid. You are hesitant. You have questions. You have concerns. "}]},{"spans":[{"text":"Do not fear. "}]},{"spans":[{"text":"Do not hesitate. "}]},{"spans":[{"text":"Do not question. "}]},{"spans":[{"text":"Do not fret."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"She is not angry with you for stealing her appearance and her name. "}]},{"spans":[{"text":"Nor is she sad or disappointed in you for all that you have done."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"She is us, and we are her."}]}]},{"sprites":[{"prefab":"NPC-Lunasia","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Lunasia (?)","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"Now go. Go meet her. Meet \"us\". "}]},{"spans":[{"text":"Then... get to know us. Get to know yourself. "}]},{"spans":[{"text":"Then you will finally see where you truly belong."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
