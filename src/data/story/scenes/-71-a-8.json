{"prefab":"APC556","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"If it's at all possible, could you ask Miss Nele to take note of the terrain and geography within the White Zone for us?"}]},{"spans":[{"text":"To be honest, this is what the Commander has been trying to achieve clandestinely."}]}]},{"sprites":[{"prefab":"APC556","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"...That's state secret."}]},{"spans":[{"text":"Are you asking Nele to commit treason?"}]}]},{"sprites":[{"prefab":"APC556","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"...We will never put Miss Nele in that kind of position."}]},{"spans":[{"text":"I swear to you on the Commander's honor."}]}]},{"sprites":[{"prefab":"APC556","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Mia","narrator":false,"pages":[{"spans":[{"text":"Nele will be meeting Herr Vogt in the White Zone tomorrow afternoon."}]},{"spans":[{"text":"I hope you'll hold up your end of the bargain."}]}]},{"sprites":[{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"When this matter is over, I will make sure Miss Nele gets an appointment with the Commander."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Safehouse","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"10230","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-18 convenes an emergency operation meeting."}]},{"spans":[{"text":"The assembled Dolls line up neatly and gather in the cramped interior of the safe house."}]},{"spans":[{"text":"AR-18 stands across from them behind a simple desk and scans everyone's faces."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"We are all set to enter Frankfurt."}]},{"spans":[{"text":"I will now give instructions on how we are going to proceed. Would all team leaders present promptly relay the information to their teams."}]}]},{"sprites":[],"ops":[],"speaker":"All","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"First of all, we will be entering Frankfurt with Miss Nele's help."}]},{"spans":[{"text":"Her bodyguard, Miss Mia, will be driving us into the city, and we will be declared as \"Miss Nele's newly hired bodyguard Dolls\"."}]},{"spans":[{"text":"Considering the latest intel we have on the traffic restrictions in Frankfurt, I believe those who come along this time must meet at least the following criteria—"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":