de":"left","tags":{}}],"ops":[],"speaker":"Hertha","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"This is MG338, I have a report for AR-18."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hertha routinely sweeps the visitor from head to toe with as quickly as she can."}]}]},{"sprites":[{"prefab":"NPC-M400","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hertha","narrator":false,"pages":[{"spans":[{"text":"...You're good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The petite figure gives Hertha a silent nod before disappearing through the door into the safe house."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2021white_Safehouse","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the evening, inside the temporary safe house."}]},{"spans":[{"text":"The stuffy air hangs heavy in the room. It is obvious that the windows haven't been open for several days."}]},{"spans":[{"text":"Lenny walks up to AR-18, who is hard at work."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"While going through the work that the Commander has left behind, I came across several messages in their personal mailbox."}]},{"spans":[{"text":"The sender's name is Cornelia Schaefer."}]},{"spans":[{"text":"She wrote to request the Commander's assistance in investigating Professor Gray, who was affiliated with the Galatea Corporation before her death. She seems to have knowledge of certain matters concerning Paradeus."}]},{"spans":[{"text":"What do you think?"}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"She is the employer of Mia, a former colleague of mine."}]},{"spans":[{"text":"If you are concerned about whose side she is on, I once helped her evade Paradeus' pursuit while in Berlin."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"So you think she can be trusted?"}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"In my opinion, even though she hails from a wealthy and prominent family, she can be depended upon."}]},{"spans":[{"text":"In fact, I would go so far as to say she is on the same path as the Commander."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"...Hails from a wealthy and prominent family?"}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"Yes, she is the granddaughter of the former Ministry of Health."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"We need an influential human to help us get into Frankfurt."}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"...Are you implying we should ask a favor of Miss Schaefer?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"If there's any possibility that it may work, I'll give it a try."}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"I understand. I will contact Mia immediately."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Also, keep the Commander's disappearance a secret from her for now."}]}]},{"sprites":[{"prefab":"MG338","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lenny","narrator":false,"pages":[{"spans":[{"text":"...Yes, ma'am."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":