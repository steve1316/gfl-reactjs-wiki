{"name":"-17-2-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange, are you making progress?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Is this your way of making small talk?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I heard that Domestic Dolls were originally designed to relieve human boredom."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"(Chuckles) Then you've done a good job, because I feel so much better now. "}]},{"spans":[{"text":"Back to the subject. I've managed to work my way past the Military's defensive perimeter..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ah... that's just like you, looking to throw your life away as always."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Oh yes, unfortunately I just can't quite seem to die. "}]},{"spans":[{"text":"Some bad news - the Military is starting to station tanks here. "}]},{"spans":[{"text":"An intercontinental train's been pre-deployed to this sector, also sent over by the Military. It's clear that they've been preparing these reinforcements for a long time."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So they're even deploying their armored units? "}]},{"spans":[{"text":"Is there a need to go to such lengths for a base of rebellious robots?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That just means that Sangvis Ferri has something that the Military wants at all costs. "}]},{"spans":[{"text":"In any case, there'll be no stopping the Military once those tanks start their push."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"But it'll be a while before that, right? It'll take at least three hours before the armored units arrive."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's why I've marked a transmissions repeater station. Take it and look for a way to log in to ensure I can keep a closer eye on their movements."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"We'll need some time to improve the disguise of our ID signals. "}]},{"spans":[{"text":"Still, do you know what you'll be able to do after this?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't worry, someone will be telling me what to do next. "}]},{"spans":[{"text":"Only thing is, she'll need some time as well."}]}]}]}
