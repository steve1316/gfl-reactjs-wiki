[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan straightens up and honors Alexander with a salute."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The dust created by the explosion is still drifting in the air like gray snow."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"480","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside the abandoned plant."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna looks back at the ruins, then at the hazy horizon."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":32,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"We've got no transport."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":32,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"You still have your legs."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":32,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"My communicator is broken.