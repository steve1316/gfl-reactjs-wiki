{"name":"-54-B-9","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022summer_ColtTrain","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Inside the Colt Express, aboard the Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_4","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie sits on one side of the table, smiling to the black figure opposite her. "}]},{"spans":[{"text":"A king of spades lies in front of the figure, weighed down by a wine glass."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"This is \"her\" role."}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"King of Spades","narrator":false,"pages":[{"spans":[{"text":"...Understood."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"So, what will \"Casino Royale\" do about the remainder of the payment for this job? When can I expect it?"}]}]},{"sprites":[{"prefab":"NPC-Tareus","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"King of Spades","narrator":false,"pages":[{"spans":[{"text":"...Someone will take care of it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"King of Spades gives Maggie a glib reply before vanishing before her eyes, just as silently as when she had arrived."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022winter_WolvesTeam","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"In the rear carriage of the Colt Express, aboard the Intercontinental Railway train \"Future\"."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"She's back at last..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine sighs in relief upon seeing Maggie show up in the carriage."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"We have unidentified armed forces outside the train and Vory inside it. "}]},{"spans":[{"text":"The cabin is also leaking... "}]},{"spans":[{"text":"I hope we won't have to take super hard jobs like this again! "}]},{"spans":[{"text":"If I'd known, I wouldn't have gone after Nikolai's money."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Quit complaining about stuff you can't do anything about."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Then why don't you say something useful?! "}]},{"spans":[{"text":"This is no longer our business now, right...?"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Says who... "}]},{"spans":[{"text":"We've got a lot to do after this."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Hold on, hold on... Let's not talk about this, it's giving me a headache. "}]},{"spans":[{"text":"Don't you think the stakes are a bit too high this time? "}]},{"spans":[{"text":"I thought you'd be playing your usual trick of betting on both sides while they fight each other."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...There are times in life when you can only get on one boat, after all."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Then what about those armored vehicles outside? "}]},{"spans":[{"text":"I've never seen a battle formation like that before..."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Well, now you know why you shouldn't accept black market jobs offering huge payments other than ones you've personally vetted... "}]},{"spans":[{"text":"I just wanted to make some money to upgrade my body and enjoy my retirement, not mess around with this gang of people who are clearly tired of living."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"But the world is getting crazier and crazier. "}]},{"spans":[{"text":"Sometimes, we don't get to choose."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Humans never learn their lesson. "}]},{"spans":[{"text":"They fought WWI with basic weapons, WWII with advanced weapons, and WWIII with fully automated ones. "}]},{"spans":[{"text":"...Who knows how far off we are from WWIV."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Forget it, I don't want to think so far ahead."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh. "}]},{"spans":[{"text":"Catherine then disappears from inside the carriage."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Is it really so far ahead? "}]},{"spans":[{"text":"Even if the sky falls, the tall people will hold it up for us. What's the point in me worrying?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh. "}]},{"spans":[{"text":"Maggie also disappears. "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022summer_DiningCar","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F09 (Dining Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_2","raw":"BGM"},{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rustle... "}]},{"spans":[{"text":"Rain pounds against the glass of the windows, beating against silent hearts. "}]},{"spans":[{"text":"Nobody is making a fuss about getting off the train anymore. "}]},{"spans":[{"text":"Despair starts to spread through the cramped carriage."}]}]},{"sprites":[{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susanna stands by the door. As the door closes, she can almost see that corpse in the rain, its eyes open and uncomprehending. "}]},{"spans":[{"text":"The passengers within the carriage check their injuries and silently wait for the dawn that may or may not ever come."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...You'll feel better if you lie down."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma gently nurses Lyudmila's right arm. "}]},{"spans":[{"text":"The latter doesn't seem aware of her own injury as she studies the distant firelight with a cold and silent gaze."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Are you really not going to lie down and rest?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila finally turns to give her a look."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"It's my arm that's injured, not my legs. "}]},{"spans":[{"text":"Besides, a minor wound like this is nothing."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...But I was supposed to protect you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila seems a little taken aback."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm the big sister. "}]},{"spans":[{"text":"I should protect you, just like \"Mother\" protected me."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...You're overthinking this. "}]},{"spans":[{"text":"He's not your \"mother\", and he won't protect you."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I don't believe you. "}]},{"spans":[{"text":"You're too dishonest."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"If you don't consider yourself my little sister, then why did you protect me? "}]},{"spans":[{"text":"Don't worry, I won't tell anyone about your identity as a Soviet secret agent.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila wants to say that anyone would have offered a helping hand under those circumstances. "}]},{"spans":[{"text":"Even as an instructor, she has done so countless times before. "}]},{"spans":[{"text":"But is she really the work of Professor Hume? "}]},{"spans":[{"text":"...What would happen if she ended up going crazy like before?"}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I made a key just for you in the Summer Garden.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"If I should forget you, then as long as someone mentions the name Lyudmila in front of me, I'll remember.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...A memory anchor, you mean?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Yes. They take the form of keys in my neural cloud.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Although I might forget you after a while, it's okay, because I'll eventually remember you someday.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Please stop looking for Professor Hume. "}]},{"spans":[{"text":"Forget him, find a job, and live as a free Doll."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I can't.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Why are you so persistent?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I told you, I want to be a complete \"self\".","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Each of my memories is precious to me. They shape me, they accompany me, and they comfort me.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"If I forget those people and things by accident...","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Then it would be very unfair to them!","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"...And it wouldn't be fair on my part...","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Memories aren't all good, you know."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"So what?","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"The good memories are mine, and the painful memories are also mine. ","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Together, they make up all of me.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Then go."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Hm?","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Are you going to tell me about \"Professor Hume\" now?","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"You don't hate talking about him anymore?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...No."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Fine, let's talk about something else.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"...How did you know that they weren't a rescue party?","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Didn't they respond to Miss Susanna's signal?","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila sighs."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"They came too quickly."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"But we only just left Warsaw, and with such a big ruckus, surely the outside should have gotten word, right...?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Even if there just so happened to be reinforcements nearby that responded immediately, they wouldn't have taken on that formation. "}]},{"spans":[{"text":"...Because that's an armored assault formation."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Armored... assault formation?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"No country would deploy rescue forces in attack formation. "}]},{"spans":[{"text":"Doctors should be carrying blood bags, not bayonets."}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I see.","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just then, a voice suddenly calls out to her."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...What are you talking to yourself about, Instructor Lyudmila?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Ack, I forgot I was having a direct conversation with you.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_AVG_3","raw":"BGM"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"A Doll called Pavel wants to see you. "}]},{"spans":[{"text":"But he's got an ELID patient with him and the humans inside the carriage refuse to open the door."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022summer_Joint","raw":"BIN"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"At the gangway connection between Carriages F09 and F10 of the Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila brings Erma and Maggie with her to the gangway connection. "}]},{"spans":[{"text":"The Dolls there have cleared out some space, in which Pavel the Doll is standing. "}]},{"spans":[{"text":"He has a girl behind him who is showing obvious signs of infection. Her eyes are tightly shut and it's plain to see that she's blind."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Mr. Pavel... What happened?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel nods to Erma in acknowledgment."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Erma. "}]},{"spans":[{"text":"It's a long story..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He then turns to Lyudmila."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Instructor Lyudmila. We have only spoken over the comms, but I remember that you're in command here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila quietly studies him. "}]},{"spans":[{"text":"A girl and a railway Doll; a pairing that's unlikely and practically unheard of."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...Rosita can still be saved. "}]},{"spans":[{"text":"We're bringing her to Berlin for treatment. "}]},{"spans":[{"text":"Please help us, Instructor."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seemingly disturbed by the mood in the room, the girl that Pavel is shielding behind him suddenly speaks up."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Rosita","narrator":false,"pages":[{"spans":[{"text":"Pavel... S-stop begging people for my sake."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rosita sounds very weak."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"It'll be fine, Rosita... The train just broke down for a bit. "}]},{"spans":[{"text":"They'll fix it soon."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Rosita","narrator":false,"pages":[{"spans":[{"text":"No... stop fighting..."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Um... Rosita?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rosita's voice grows weaker and weaker. Realizing that something isn't right, Pavel immediately bends down and feels her forehead."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...She's feverish... "}]},{"spans":[{"text":"Instructor!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel turns around. There's no expression in his large eyes, but strangely enough, she can see the burning anxiety in them."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...I once served in the Siberian Lifeline Project, Instructor. Perhaps I can be of use to the people here..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"The doctor in Carriage 1 might be able to help."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie has been standing quietly behind Lyudmila all this time, but she can't help but speak. There's even a hint of sympathy in her expression. "}]},{"spans":[{"text":"This is the first time Erma has seen any other expression on the face of the scammer with a permanent smirk."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Thing is, I don't know if he's still alive."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The first-class carriage has exceptional protection. He should be fine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila looks thoughtfully at her communicator."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma gives Pavel a reassuring pat."}]}]},{"sprites":[{"prefab":"Erma","expression":9,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Lyudmila will think of a way to help."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie goes \"pfft\" with laughter, and her faint smile returns."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"I wonder how you perceive the instructor. "}]},{"spans":[{"text":"Do you think of her as a superhero?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk! "}]},{"spans":[{"text":"A loud noise interrupts their idle chatter."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21summer_intro_DemonVariation","raw":"BGM"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Instructor, there's no need to throw such a big temper tantrum."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ignoring Maggie's mockery, Lyudmila immediately draws her handgun and heads back into Carriage F09."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"The enemy is here! "}]},{"spans":[{"text":"Everyone, on your guard!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Scene_Transfer","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh— "}]},{"spans":[{"text":"All the Dolls in the carriage instantly go on alert. "}]},{"spans":[{"text":"Just then, a figure she hasn't seen in a while shows up near the ruined bar counter."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"Scrap all of these Dolls! "}]},{"spans":[{"text":"Cygnus specifically wants these pieces of trash."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
