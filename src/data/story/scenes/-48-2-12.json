 cocky for long. "}]},{"spans":[{"text":"I'll have to trouble you with sorting out the route."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Don't worry and leave it to me."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"树林","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A bionic robot dog comes to halt in front of a small house and refuses to move any further."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Looks like this is the place. They're pretty cautious."}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Hm... But nobody's home... "}]},{"spans":[{"text":"Bailey, let's get to work!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Bailey","narrator":false,"pages":[{"spans":[{"text":"Woof!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"机场","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"By an Autobahn in Berlin, Germany."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An Autobahn snakes around a mountain like a scarf, with vehicles whizzing by every so often. "}]},{"spans":[{"text