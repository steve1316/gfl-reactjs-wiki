{"name":"-48-2-12","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Dorm","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The night view outside the French windows is dazzling. The glow of a cigarette lighting up twinkled like a beautiful firefly blinking in and out of sight."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"(Exhales)"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The woman's eyes fall on a large poster advertising the Galatea Corporation. "}]},{"spans":[{"text":"She takes out her communicator..."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"(Exhales) Esteemed tsundere of Galatea—Mrs. Gray, how have you been?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"You actually got in touch with me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"How very unusual, Bramedb.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"The route is compromised."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"...I see.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Aren't you taking a bit too long?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"(Exhales) Am I? "}]},{"spans":[{"text":"We're working non-stop 24/7 over here. Unlike you, we don't have the luxury of enjoying the AC in an office."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"If I'm not mistaken, you're the one who's asking for help here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Bramedb","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Should I put your portrait on a shrine and pray to it before every meal then? "}]},{"spans":[{"text":"Humph, I'd never stoop to calling you if I could reach the boss."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"We should be the only ones with access to this route, so who on earth—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Th