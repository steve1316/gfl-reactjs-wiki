{"name":"-24-3-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Shut up! You traitor! "}]},{"spans":[{"text":"You... "}]},{"spans":[{"text":"I won't... "}]},{"spans":[{"text":"I'll never..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II grits her teeth and cuts the transmission."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Kill you... "}]},{"spans":[{"text":"Kill... all S.F... "}]},{"spans":[{"text":"No... "}]},{"spans":[{"text":"M4A1... "}]},{"spans":[{"text":"M4A1...where are you..."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What should I do...? "}]},{"spans":[{"text":"I can't...I can't believe M16 anymore... "}]},{"spans":[{"text":"I'm alone... "}]},{"spans":[{"text":"I have to...decide by myself..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...An hour later."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang! Bang, bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II takes the S.F. command post and goes into a rampage, wrecking everything."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Not enough... "}]},{"spans":[{"text":"Not enough...blood... "}]},{"spans":[{"text":"I haven't...found her yet...M4A1...isn't here... "}]},{"spans":[{"text":"I need to...carry on..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunkill","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II is shot in the back."}]}]},{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The alerted S.F. remnants gather around her, and in her impaired state SOP-II cannot respond in time. "}]},{"spans":[{"text":"She hears M16A1 say something over the comms channel, but none of that matters anymore."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II, ragged and all alone...can no longer move. "}]},{"spans":[{"text":"Night falls on her and this unfeeling world. She does not stand up again. She does not feel anything again. She no longer knows what is happening in the world. "}]},{"spans":[{"text":"Is this death? Is this the ending...and the answer that she sought? "}]},{"spans":[{"text":"SOP-II's neural cloud slowly sinks into endless confusion, until it is utterly devoured by the night."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"158","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Stop. "}]},{"spans":[{"text":"Commander, SOP-II did not die. She is still alive. You are lying to us. "}]},{"spans":[{"text":"There is no point in doing so."}]}]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Smack!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"My eyes can't catch what she did, but my body knows."}]}]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Smack! Smack!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Those aren't hands, but a pair of torture implements."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is no expression on the puppet's face after the punishment ends, neither enjoyment nor pity. "}]},{"spans":[{"text":"I grit my teeth. My entire body hurts, and I'm bleeding. "}]},{"spans":[{"text":"My face must look even uglier now, worse than after being caught in the blast of that dirty bomb..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"The interrogation continues. "}]},{"spans":[{"text":"Whenever you diverge from our information, we will consider more rigorous methods of interrogation in the future. "}]},{"spans":[{"text":"Commander, amend your story."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I know, I know. "}]},{"spans":[{"text":"I cough up a wad of blood, which probably has a tooth in there as well. I pant heavily, and then I try to think through the pain... "}]},{"spans":[{"text":"It is time for another story, and I have to reconsider its...ending."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
