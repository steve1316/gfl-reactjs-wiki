{"name":"-51-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=AllSeeingEye03%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Inside the abandoned Paradeus base."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"background","value":"229","raw":"BIN"},{"type":"bgm","value":"10082","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After the brief conversation, Gray puts down the communicator with a grave look on her face."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...Gray."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After confirming that Gray's transmission is over. Grig carefully steps up to her side. "}]},{"spans":[{"text":"Morridow lies curled up in the corner. Her body is covered in wounds, but her eyes are filled with light and life."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I'm fine. "}]},{"spans":[{"text":"Teacher, how are you now?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I'm largely alright after the emergency repairs."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I didn't think they'd do this to you when I took you to the base inside the city..."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"A failure has no right to make demands, Gray."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...You're right. Father has already had Bramedb clear that place out. "}]},{"spans":[{"text":"Nemhran ordered her to bring RPK-16 to Avernus while keeping an eye on her. "}]},{"spans":[{"text":"However... she made no mention of either you or us, Teacher."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Doesn't that mean we should return to Avernus too?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray frowns as she hesitates."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...If we go back now... There will be no turning back. "}]},{"spans":[{"text":"And we've already received news that \"that person\" is headed for Frankfurt."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Ange is still with us. Do you think \"that person\" will really give up?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Nobody can gainsay Father when he says he wants someone."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"We must go back immediately."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow, who has been silent all this time, suddenly raises her head."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Teacher?"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"We have made too many mistakes, and Father does not like mistakes. "}]},{"spans":[{"text":"Our current situation has made many things clear. If we do not do something, we will all be discarded."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow says so in a casual tone."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...I need an opportunity to meet with Father in person. That's the only way we can turn things around. "}]},{"spans":[{"text":"Otherwise, we will all die here."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I understand."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Help me up, Grig."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow gets to her feet. Still leaning on Grig, she makes her way forward with determination in her eyes."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I don't understand."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Gray, if we stay here, we will be discarded. "}]},{"spans":[{"text":"Nemhran has already gone back."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"But her task has ended now that the \"Fireworks\" have blossomed. "}]},{"spans":[{"text":"Isn't it normal for her to go back?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"No, it means Avernus needs her to work on something new. "}]},{"spans":[{"text":"Failure isn't the worst thing, but by not taking part in the core project, we will have lost all value."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...I see."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"spritePosition","value":"0,140","raw":"Position"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"As long as I can return to Avernus, we will regain Father's trust. "}]},{"spans":[{"text":"I can assure you of that."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"357","raw":"BIN"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At a temporary safe house near Berlin Airport. "}]},{"spans":[{"text":"The Commander connects to the Aeneas conference room. "}]},{"spans":[{"text":"...Identity verified, please input your login password."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Baggage_bomb_Activation","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Password accepted. Connecting... "}]},{"spans":[{"text":"You have successfully logged on to the Operation Aeneas Conference Room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Are there any new developments concerning our target?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, Morridow's signal is on the move.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Excellent. Let's sync up our information."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Roger.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Both members of Squad Umbrella are present. We're watching the target.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Both members of Squad Unicorn are in position, ready to assist Squad Umbrella during ops.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"All three members of Squad Nitrogen are in position. En route to the objective.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-7","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Both members of Squad Ferrum are in position. Standing by for further instructions.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I've already shared the regional offline map, Paradeus-related information and security contact frequencies with everyone.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Everyone should have topped up their ammo and tactical supplies before setting out.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Total number of Operation Aeneas personnel that have been gathered is 9/12.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We can't wait for the rest of the team to assemble since the target has already started moving. I'll inform RO about how to incorporate the forthcoming team members. "}]},{"spans":[{"text":"Please remember the mission requirements—speed and stealth."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right now, we are an unexpected dagger to the enemy's heart."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll confirm the mission status with everyone again. "}]},{"spans":[{"text":"Operation Aeneas is a raid with two objectives—"}]},{"spans":[{"text":"1. To rescue Angelia. Contact me immediately if anything goes wrong. "}]},{"spans":[{"text":"2. To get a grasp of enemy structures and units within the \"Dead Sea\"."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion will ensure this conference room remains accessible. "}]},{"spans":[{"text":"I'll provide assistance if you need anything."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But I won't be on the frontlines, RO."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Roger. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're the leader of this operation, so you have the responsibility of making decisions."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...I won't let you down.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Is there anything else you'd like to remind us about, Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Also, I mentioned something about support earlier—Persica has sent \"Chessmaster\" over. "}]},{"spans":[{"text":"Upload every location you find here immediately. That way, Chessmaster can extrapolate the objective's location through already-known coordinates."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood. We'll link up with her ASAP.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right. Any other questions?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief silence, the Commander speaks again."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Alright. We will now officially commence Operation Aeneas."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls fall silent."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as UMP45 ends the comm, she hears another soft ringtone. It's the Commander's personal encrypted channel."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Commander, you have extra tasks for me? "}]},{"spans":[{"text":"Let me make this clear, you'll be billed extra for it."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course. This operation is going to be carried out by Dolls from multiple different squads. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"While I have complete faith in RO's abilities, she's going to need help.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Of course, I'll be on her side— "}]},{"spans":[{"text":"So long as 9 and I are safe."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"45, I need you to support RO—whatever the cost.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This mission's difficulty is on an unprecedented level. Even all of your individual strengths will not be enough to accomplish it. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Only if the entire team is united as one do you have a chance of completing the mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You always did love ordering services that weren't on the menu, Commander."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This isn't an order. I'm asking a favor of you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And you don't need to spare my dignity here. I know I'm being extremely unreasonable—","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I am asking you to put your life on the line to support RO.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So it's a request from you, Commander..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"45 lowers her head. There's no telling what is going through her mind. "}]},{"spans":[{"text":"A moment later, she looks up again."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Understood. "}]},{"spans":[{"text":"Still, you'd better not welch on the bill no matter how many zeroes there are on it. ♪"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Of course. I'll pay up no matter how big it is.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With her usual enigmatic smile, UMP45 leaves the meeting room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Please come back alive to stick me with the bill, 45.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"468","raw":"BIN"},{"type":"bgm","value":"10213","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the outskirts of Berlin, at the border of the Red Zone, where there are few traces of people."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"From under a building which looks like it's about to collapse at any time, RO635 carefully studies the movements of the blip on her scanner."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO... I'm so booooored! Can't we move out yet?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hang in there a little longer, SOP-II."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45, who is also monitoring the scans, leans over."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"The target has been turning in place for the past 10 minutes. "}]},{"spans":[{"text":"Should we investigate the possibility that the tracking device might have been removed?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"side":"left","tags":{"Position":"0,-50"}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Yeah, they might have stuck it on a robot dog or something..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"There isn't much chance of that. The tracker was planted inside the target's body while the target was unconscious. "}]},{"spans":[{"text":"It won't be easily spotted without a full-body inspection. "}]},{"spans":[{"text":"Given their current situation, they wouldn't have had the chance to perform such a detailed examination."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yup, I hid it myself!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The four pairs of eyes turn to the scanner screen once again, but the blip representing their target still has not left its original position."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"How about closing the distance to the target?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Let me think about it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After studying the target's path and the nearby terrain, RO635 ponders her options..."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO! The target has suddenly started moving at high speed!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_ElecSpace","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the four of them watch, the target blip suddenly rockets into the Red Zone."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We need to catch up!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Roger."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The four Dolls' clothes rustle quietly as they vanish into the ruins."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"469","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In the Red Zone on the outskirts of Berlin. "}]},{"spans":[{"text":"After ensuring that they haven't been followed, three ghostly figures emerge from a long-abandoned ruin."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[{"type":"bgm","value":"10106","raw":"BGM"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...Have we lost our tails? "}]},{"spans":[{"text":"Extra complications will do us no good at a time like this."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Don't worry... I'm sure of it."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Do you want to rest here for a bit, Teacher? Your condition..."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig watches in silence as Gray speaks softly to Morridow while helping her sit down for a short rest before turning away."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"I'll go watch the perimeter."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":fa