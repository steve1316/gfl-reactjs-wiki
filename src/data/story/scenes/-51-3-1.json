":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow licks her lips, and her anxiety drives her to stand again."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,140"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Let's go. We'd better not delay."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...Yes, Teacher."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Noticing their movements, Grig silently returns to Gray's side and looks at the pair."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Is it still our priority to shake off our pursuers?"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Hm. While I don't think it's likely that they managed to follow us here, we should detour a little more for safety's sake. "}]},{"spans":[{"text":"I'll leave some Nytos behind along the way to delay any pursuers. That ought to be enough for us to make it into Avernus."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"I'll lead the way. You watch Teacher."}]}]},{"sprites":[],"ops":[],"speaker":null,"na