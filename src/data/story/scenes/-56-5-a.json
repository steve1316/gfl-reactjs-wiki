{"name":"-56-5-A","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-Corridor","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Berlin, in the temporary Griffin base."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"},{"type":"bgm","value":"GF_21winter_avg_pathfinder","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana returns, wreathed in a cold aura amidst the gloom of night."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"You're back..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Aliana returns, SCR gets up from where she was waiting by the doorway, but Aliana ignores her and walks straight in."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She seems completely oblivious to the hostility emanating from Aliana as she anxiously scampers after her."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Wait, Aliana."}]},{"spans":[{"text":"The Commander wants you to..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pomf—"}]},{"spans":[{"text":"Aliana suddenly stops. SCR is completely unprepared for this and bumps into her shoulder."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Are you going to criticize me too?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana's tone is icy, and when she turns around, SCR sees her face."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"...No, I, I didn't mean to do that."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...Pick up your gun."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Hah?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2022Saros_SCARL1","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana flicks off the safety on her weapon and presses its barrel against SCR's forehead."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"I'm pointing a gun at you right now, so take up your weapon!"}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"...Aliana, I won't point my gun at you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana is stunned."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Because... you're my team leader."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"Also, the Commander never said they were unhappy with the outcome of the mission."}]},{"spans":[{"text":"However, they were a little worried about your departure, so they asked me to wait here and tell you to report to Miss Persica's lab once you returned."}]},{"spans":[{"text":"I... I didn't mean anything else by it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana slowly lowers her weapon."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"If I point a gun at you, then you'd better do the same too. Otherwise, people will look down on you."}]}]},{"sprites":[{"prefab":"NPC-SCR","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"SCR","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana heads for Persica's lab, still in a foul mood."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SCR stands dumbly where Aliana left her."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2022saros_Workshop","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In Persica's lab."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana silently enters the lab with a scowl on her face."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as she's about to enter the examination pod, Persica stops her."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Hold it, don't interrupt my experiment."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...You asked me to come here."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Oh yeah, do you know you've got some undeletable base layer code in your neural cloud core?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Of course, she knows. She knows it better than anyone."}]},{"spans":[{"text":"Persica's words quench the wrath of unknown origin boiling within her."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Instantly, her overheated head cools down."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"I know. I was rolled out that way."}]},{"spans":[{"text":"You don't have to worry about it if you think it's a problem."}]},{"spans":[{"text":"I'll explain to the Commander if need be."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Oh no, that's not what I meant. Or rather, good for you; it's not like I care anyway."}]},{"spans":[{"text":"What I meant is that when I was giving you a new body, I discovered that it might end up affecting your neural cloud."}]},{"spans":[{"text":"It was just a reminder; no need to thank me."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Scar_Shenzhizi","raw":"BGM"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Yeah, I know."}]},{"spans":[{"text":"It already had an effect."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Did it? What exactly did it do?"}]}]},{"sprites":[],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In contrast to her words, Persica goes from uninterested to concerned in an instant."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Changing to a new body did manage to suppress it, but only for about half an hour..."}]},{"spans":[{"text":"Once that time elapses, I'll automatically carry out that mission."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Automatic execution? ...Your mission was left over from over a decade ago. Surely carrying it out now would be fruitless."}]},{"spans":[{"text":"I have to say, people who hard-code stuff like that without comments are a huge pain in the ass."}]},{"spans":[{"text":"Fortunately, I ran a full diagnostic on you beforehand, so it shouldn't affect your bodily performance."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...Indeed, it doesn't affect them, so long as it doesn't infringe on related people and matters."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Ugh... Fine, as long as you know."}]},{"spans":[{"text":"I can't delete it right now, so if you know too, then just report anything strange that comes up."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Anyway, that's all I wanted to say."}]},{"spans":[{"text":"Leave quickly if there's nothing else. Don't interfere with my work."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Oh yeah, I think the Commander was looking for you."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"...Understood."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2021white_GriffinSPAWAR","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the Griffin Base's Ops Room."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana enters the Ops Room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're back."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes a seat."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Miss Zoya is under Griffin's protection."}]},{"spans":[{"text":"Your mission is over."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana waits for a while, but the Commander does not say anything."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Is there anything else you want to ask?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At great length, the Commander speaks."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The mission is complete."}]},{"spans":[{"text":"As for any other things, whether or not you want to tell me about them is up to you."}]},{"spans":[{"text":"If you don't want to talk about them, then you have countless ways to deceive me, and if you want to share them, then it'll naturally come up."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana remains silent for a while before finally sighing. "}]},{"spans":[{"text":"She closes her eyes as though she's gathering up her determination, and when she opens them again, she no longer avoids the Commander's gaze."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Commander, have you heard of \"Operation Couatl\"?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hm..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"The first time we met, you used an OPS order to disarm me."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"However, it was limited to some paperwork, so it should be considered a failure of WW3."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Aliana continues explaining herself."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Indeed, that failure was why I was mothballed."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"As I recall, the exact reason was that backup didn't arrive in time as well as the transport helicopter being shot down by a missile. It does seem a little ridiculous when you look at it now."}]},{"spans":[{"text":"However... World War III was a chaotic time."}]},{"spans":[{"text":"There are many lost records that have not been found again, even now."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"}],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Allow me to re-introduce myself."}]},{"spans":[{"text":"I belong to the \"Daybreak\" Squad, an all-Doll infantry platoon under the Rangers."}]},{"spans":[{"text":"Nothing about Daybreak Squad should be on public record."}]},{"spans":[{"text":"Also, there should be nothing left over from Daybreak Squad in current Doll development."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander frowns."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Actually, I'm quite interested in what you said."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Current Doll technology has gone in a completely different direction from how it started out."}]},{"spans":[{"text":"In the era when I was produced, conflicts and battles escalated rapidly, and Dolls sent to the battlefield soon ended up being bottlenecked in terms of performance."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"But the circumstances could not possibly wait for technology to catch up..."}]},{"spans":[{"text":"After the military forcibly intervened in the matter, we in \"Daybreak\" underwent a top secret experiment in order to discover the limits of Doll performance. The core product of that experiment still remains."}]},{"spans":[{"text":"That would be the \"dog tags\" locked in my base layer."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What are they?"}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Originally, dog tags were metal plates used by human soldiers to identify each other's corpses."}]},{"spans":[{"text":"But for Dolls, they have another use."}]},{"spans":[{"text":"On one hand, they prevent their neural cloud data from being taken by the enemy. On the other hand, they are carriers that were jury-rigged with neural cloud technology."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That sounds like quite a logical design."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, its practical usage did not turn out to be as successful as expected. The researchers back then did not take the individual elements of Dolls into consideration..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-L","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Aliana","narrator":false,"pages":[{"spans":[{"text":"In any case, this system was developed to secure absolute success in \"Operation Couatl\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Scene_Transfer","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she says these words, a chill air radiates from Aliana's body."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
