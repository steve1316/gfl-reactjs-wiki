{"name":"-17-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"22","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Persica, you must stop what you're doing right now. "}]},{"spans":[{"text":"What you know is already too dangerous for you, and there is no need for you to know either."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"No need?! Do you have any idea how the past few years have been for me?! "}]},{"spans":[{"text":"Havier, I don't mind if you don't want to help me, but don't get in my way!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I'm doing this to PROTECT you, Persica. "}]},{"spans":[{"text":"Did you know? Kryuger was arrested three hours ago."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Do you think I ENJOY leaving my seaside resort and my automatic race cars to get involved in these trivial matters of yours? "}]},{"spans":[{"text":"I don't care about whatever science freak you and Lyco birthed before this! His death even brought me an abundance of business opportunities! "}]},{"spans":[{"text":"But the balance has been broken now, Persica."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"The balance... What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Everything started with the two of you, you and Lyco. Two members of 90WISH who defected but still refused to abandon their stupid research... "}]},{"spans":[{"text":"This was how Lyco brought disaster upon himself, but what about you, Persica? "}]},{"spans":[{"text":"Don't say you want to keep playing with fire! I put so much money into 16LAB. You have to take some responsibility for your work, don't you?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"...Mr. Havier. "}]},{"spans":[{"text":"What was the objective of reactivating the OGAS System?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"22","raw":"BIN"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Why the hell are you asking me? Do I look like some old man who takes part in evil plots and schemes?"}]}]},