{"name":"-51-1-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"187","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"GF_21summer_avg_Demon","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"...On the German border. "}]},{"spans":[{"text":"The MCV loaded full of Griffin Dolls drives slowly toward the sunset that is about to melt into the horizon."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"202","raw":"BIN"},{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger, we're about to cross the German border."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"How are the Dolls?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Repair work is progressing steadily, but we'll have to wait for the IOP supplies to arrive before we can replace their bodies. "}]},{"spans":[{"text":"The Dolls' morale is stabilized, more or less..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I'm really not suited to this sort of thing, compared to Kalina."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"You've done your best. Have things on Kalina's end been taken care of?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes, she's been successfully transferred and her vital signs are stable."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Good. Now all we have to do is wait."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I wonder if things are going well on the Commander's side..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_HeavyVehicle_Stop","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=7","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble—"}]},{"spans":[{"text":"The MCV awkwardly brakes in its forward motion."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"I'll go check. Ingram, come with me."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"187","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"},{"type":"bgm","value":"GF_21winter_battle_1","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With Ingram escorting her, Helian exits the MCV. "}]},{"spans":[{"text":"Several men in Border Guard uniforms are blocking their path."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Border Guard","narrator":false,"pages":[{"spans":[{"text":"We are inspectors from the German Bundesgrenzschutz, please show your identification."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Hello. These are our entry documents."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Helian hands the permits that Zelinsky prepared for them to the inspectors. "}]},{"spans":[{"text":"The inspectors take turns reading them. Every now and then, one of them steps aside to speak into his communicator for confirmation. "}]},{"spans":[{"text":"Helian can tell from the change in their facial expressions that something unusual is happening, but she doesn't dare to act rashly."}]}]},{"sprites":[],"ops":[],"speaker":"Border Guard","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, but your entry permits are invalid."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[],"ops":[],"speaker":"Border Guard","narrator":false,"pages":[{"spans":[{"text":"Miss Helian, Mr. Kryuger, we have just been informed that you are wanted for endangering national security. "}]},{"spans":[{"text":"You are under arrest. Please refrain from pointless resistance."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"MAC10","narrator":false,"pages":[{"spans":[{"text":"Get your hands off her!"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Wait!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"More Border Guards stream out of the checkpoint. They raise their guns and point them at Helian. "}]},{"spans":[{"text":"Helian restrains Ingram beside her."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"You have my cooperation, but Mr. Kryuger is injured, and he needs immediate medical attention."}]}]},{"sprites":[],"ops":[],"speaker":"Border Guard","narrator":false,"pages":[{"spans":[{"text":"We will arrange for it, naturally."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Ingram, inform everyone that the repair schedule will proceed as planned. Don't panic and wait for us to return."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"MAC10","narrator":false,"pages":[{"spans":[{"text":"Miss Helian, they look crooked to me. Are you really going to leave with them?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"We have no choice."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a sigh, Helian stares down the countless empty black gun muzzles pointed at her and raises her arms."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"357","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the safe house in Berlin."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...This isn't what was planned."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":" You sound like a kid who received a workbook for Christmas.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shakes their head and sighs into the communicator... After all that's happened, even something like this isn't enough to alarm the Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll think of a way to deal with this... The Earl should have a solution."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Probably for the best. I don't want to have to manage an MCV full of Dolls for you...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How's the progress on the Doll repairs?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Huuuhhh?! Are you rushing me?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I came to your base for a vacation... I mean, to be protected!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Now I'm stuck wandering around with you and you have the gall to rush me?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Er... That's not what I meant. "}]},{"spans":[{"text":"But I really need backup right now..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander falls silent."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I need to be able to dispatch a forward expeditionary team. "}]},{"spans":[{"text":"But this will be a private operation undertaken without the Earl's permission."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"That's strange.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So you won't go rescue Ange if you don't get support, money or manpower?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...No, I will."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Then isn't it settled?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Just do what you want. Why are you putting so much thought into it?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I drink a cup of coffee when I wake up every morning, but that doesn't mean I need to spend the day working.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You need to go with your gut and your instincts, whether you're a soldier or a scientist.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...It feels kind of weird to hear you lecturing me about this."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You're just overthinking things.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I haven't seen Ange keep a cat yet, so letting her die just like that would be a bit of a shame.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"How about this, I'll send an intellectually-inclined Doll with my new invention to help you out. Don't expect anything else, though, since I've used all the combat-grade parts on them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"...Honestly, she's been gone for so long but she's still finding ways to cause me problems.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Um, thanks."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Right, is that conference room any good? I didn't have the chance to test it out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Uh... hang on, I'll send you the feedback data..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9",