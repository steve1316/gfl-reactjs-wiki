{"name":"-26-13-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-ContaminatedZone","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Shrieks and clamor come through Yegor's communicator."}]}]},{"sprites":[{"prefab":"人类女性的声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Human female voice","narrator":false,"pages":[{"spans":[{"text":"I'm one of your own! Don't kill me!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Cough...please! I was forced into this! I didn't do anything! Oh god!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Military soldier","narrator":false,"pages":[{"spans":[{"text":"Sir, we've captured the target that appeared to be Ange. We've confirmed that she is one of our medical personnel, given a simple makeover to resemble Ange.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"人类女性的声音","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Human female voice","narrator":false,"pages":[{"spans":[{"text":"That T-Doll knocked me out and left me here...cough... I need...cough, cough! I beg you...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Military soldier","narrator":false,"pages":[{"spans":[{"text":"She is infected and in need of treatment... Sir?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Bring her back and treat her on the way."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Yegor leans against one of the tanks and massages his brows with his fingers."}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Ange is in the building... "}]},{"spans":[{"text":"She was just buying time to treat herself! FUCK!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Yegor punches the tank in fury, then gets up and walks toward the command room."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Military soldier","narrator":false,"pages":[{"spans":[{"text":"Sir! The Griffin party is making a run for the building!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"They're going back to defend it! This is their last attempt to protect Ange! "}]},{"spans":[{"text":"Where are the scouts? Can they enter the building before Griffin gets there?"}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Military soldier","narrator":false,"pages":[{"spans":[{"text":"They can, but the building is within the range of Griffin's HOCs. They may come under attack if they get too close!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Then have them stand by on the spot. All combat personnel, head toward the target building and surround it!"}]}]},{"sprites":[{"prefab":"NPC-YegorDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"0,0.7","raw":"黑屏1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Ange! All those tricks are for nothing! Even if your Dolls make it back to the building, they'll just be heading to their deaths! "}]},{"spans":[{"text":"This time, there'll be no escape for you!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG7-3","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Ten minutes later, the rescue party returns to the building. 416 gives Ange a dose of adrenaline."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Phew... Thanks. I'm feeling a lot better."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I should've recorded your scream when I stabbed you with the needle."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Don't play it at my funeral, thanks. "}]},{"spans":[{"text":"Now I can finally do some simple thinking."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Commander, Griffin's party has returned to the building. We'll start mounting our final defenses. "}]},{"spans":[{"text":"The artillery shells have been modified into IEDs. AN-94 and I are installing them as fast as we can. We'll also sort out the detonator!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Are we really doing this? I'm seriously not sure if..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Worst case, we all die here, but we are all prepared for that."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"SOP-II and 416 aren't... "}]},{"spans":[{"text":"They have another mission - the commander... The commander is still in danger. You can't die here."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sorry, Commander's orders. I can't very well disobey them, can I?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Commander, I don't understand. Why are you so hellbent on saving me?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}],"choices":["I'm used to being in danger. This is just another mission.","Finish the job right before us first. Then we can think about what comes next.","You've given me so much help. It's time I did something for you."]}]},{"sprites":[{"prefab":"指挥官","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm used to being in danger. This is just another mission."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"In other words, you haven't realized just how important you are, have you?"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's exactly why the Commander is so important, don't you think? We can't win if we never take any risks."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Griffin needs commanders with an eye for tactics, not an idiot like me."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Sorry, I don't think any of us qualifies. I guess that's why we're all on the same boat?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"This is the battlefield! It's no place to talk about personal debts! Commander, we don't owe each other anything!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Now you owe the commander one, Ange. Better start drafting your thank-you letter."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Since it is all decided, Ange, start thinking about what we are going to do."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...Alright. "}]},{"spans":[{"text":"Our priority is to slow the enemies down until the IEDs are all in place. "}]},{"spans":[{"text":"The Military will storm the building at all costs. We must buy ourselves more time!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP-II, 416, the military is surrounding us in four directions!"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Reverse","raw":"BGM"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Jeez...they're calling in their entire main force."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"They've already caught on. They know Ange is in the building!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Now that I think about it, this is the first time...we're engaging the military's main force directly. "}]},{"spans":[{"text":"I wish...I could fight in my T-Doll body."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Just take a good nap, RO. "}]},{"spans":[{"text":"When you wake up, we'll be leaving this place with Ange!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Well, there's nothing much for me to do. I'll leave it to you then."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Actually...will you stay awake, RO?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Huh? Why?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It's only the AR Team when the two of us are together."}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Suit yourself. "}]},{"spans":[{"text":"I'll record everything for you - the glorious battle in which the AR Team takes on the military's main force."}]}]},{"sprites":[{"prefab":"HK416","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"They're coming! HOCs, prepare for battle! "}]},{"spans":[{"text":"Commander, this is our last stand. We must fend off their attack and buy time for Task Force DEFY!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]}]}
