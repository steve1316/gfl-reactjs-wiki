{"name":"-44-A2-3-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"276","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Back in the apartment. "}]},{"spans":[{"text":"Ange places the vial on the table and studies it intently."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I could tell from your face that you haven't returned empty-handed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-12 has snuck up quietly behind her."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Where are the others?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I have 94 watching the whelp. 15 and 16 are on the lookout. "}]},{"spans":[{"text":"You don't want him to take part in what's coming up?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"That's because I'm about to cross the line. "}]},{"spans":[{"text":"If he finds out, things will get messy."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What's the plan?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"First of all, I must track down whoever's slinging this. "}]},{"spans":[{"text":"According to Powell, this thing is in ample supply, so there must be more. "}]},{"spans":[{"text":"Whoever the supplier is, they must've left traces."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What's this?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"The same stuff we encountered in Bremen, remember? Hallucinogen à la Leone. "}]},{"spans":[{"text":"But all of Leone's and Powell's stocks should've been seized by the Stasi when they were arrested."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"So either there is another source... "}]},{"spans":[{"text":"Or they still have spies in the Stasi. "}]},{"spans":[{"text":"Which do you think is more probable?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I know for a fact that Leone and Powell didn't hold all the stock. "}]},{"spans":[{"text":"But do you see the implication of such flagrant circulation of this illicit substance within Berlin Prison? "}]},{"spans":[{"text":"Who do you think I can trust, 12?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange taps the armrest on her chair, her voice wavering sightly."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Me, 94, 15, 16, and the Griffin Commander."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You're not alone in this fight, Ange. "}]},{"spans":[{"text":"Relax. You're being too hard on yourself."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I know..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Call connected."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Ange?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Good afternoon, Commander. "}]},{"spans":[{"text":"I hope you have good news for me?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Well...I don't know if this counts as good news.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I do have a new lead, but it points toward a tragedy that's poised to happen.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Just \"poised to happen\"; not \"already happened\"—I'll take that as good news. "}]},{"spans":[{"text":"Go ahead, what's this about?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Remember the Earl said William is planning something big in Berlin? I have an inkling of what that may be.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"An inkling?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"William is possibly planning to detonate a dirty bomb in Berlin.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I saw an image of the aftermath - the entire city covered in Epiphylla.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Dandelion also believes that this is the desired effect of a certain \"plan\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...A dirty bomb? "}]},{"spans":[{"text":"Are you certain? It's impossible even for William to get something like that into Berlin."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'm not sure, but there is evidence to support this conjecture.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The specific implementation and timeframe are still unclear and under investigation.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I just think you should know about this.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Right, got it... You're starting to sound like that old geezer. "}]},{"spans":[{"text":"And how are things going with Morridow? Have you obtained any new information from her?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Mo...you mean Machlian?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...Nothing so far.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'm working on it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If it's not working out, just send her over to me before it's too late. "}]},{"spans":[{"text":"I have more ways than one to make her talk."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, it's okay, I can handle it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Fine. "}]},{"spans":[{"text":"...Say, did something happen? "}]},{"spans":[{"text":"You seem kinda out of it."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Me? No...I'm perfectly fine.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't try to fool me, you should know better. "}]},{"spans":[{"text":"Or do you not trust me?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's not it!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"(Sighs) ...It's just...um...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Kalina, my adjutant, spent too long in the Red Zone...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"ELID?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I'm sorry. "}]},{"spans":[{"text":"Is it serious?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's not too bad at the moment; still only in the early stages. I'm just worried about the allocation of medical... No, forget it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Don't worry, that young lady is a strong one. If she had enlisted, she would have done at least as well as me. "}]},{"spans":[{"text":"She'll pull through."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, thanks.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Right, I've got stuff to do. "}]},{"spans":[{"text":"Till next time."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Okay, bye.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"Call ended."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"What a nightmare. "}]},{"spans":[{"text":"The competent Miss Kalina succumbed at a time like this? "}]},{"spans":[{"text":"No wonder she wasn't there at the pub."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange closes her eyes. She suddenly clutches at her chest and bends down."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange...?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...12?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...I'm fine."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange clenches her fist. Her hand is clammy with sweat."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If what the Commander says is true, then everything unusual that's happening could be a prelude to the oncoming attack. "}]},{"spans":[{"text":"The Earl...wasn't lying."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You think the attack is going to happen?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Why not? This also corresponds to the leads we currently have. "}]},{"spans":[{"text":"You heard the Commander. The image is the aftermath of a dirty bomb explosion, with Epiphylla blooming. "}]},{"spans":[{"text":"Who has the means to transport a dirty bomb into the heart of Berlin? "}]},{"spans":[{"text":"It can only be Leone's new technology... I don't know what exactly it is yet, but it must have something to do with Epiphylla. "}]},{"spans":[{"text":"This must be what Gray is planning."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That does make sense. Then the woman is the key to the whole conspiracy?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Has Leone given her the tech yet? "}]},{"spans":[{"text":"...We have to let the Earl get rid of her before she starts putting the plan into motion. "}]},{"spans":[{"text":"The Earl wants evidence, so we'll give him evidence."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange inhales deeply to ease the tightness in her chest."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"We must track down the supplier of this hallucinogen. You and 94... No, have 94 watch that kid. Get 15 and 16 to help you look into who's smuggling the drug into the prison."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":6,"side":"left","tags":{}},{"prefab":"AK12","expression":13,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...William wants to play an epic game of chess. "}]},{"spans":[{"text":"So, I'm overturning his chessboard."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I will never let him get what he wants."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
