{"name":"7-2-1N","beats":[{"sprites":[],"ops":[{"type":"background","value":"2","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"night","raw":"Night"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half an hour later."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Galil hailing Negev. Do you copy?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Get on with it."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Target location is confirmed. It's inside that abandoned car factory, just as our intel says."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Humph. Of course. It's my intel."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Fine, fine. Everything is yours. We're all yours. "}]},{"spans":[{"text":"But you know how to read a map, right? You see how far we are from the car factory?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Is it that far? It's only a three-hour walk, right?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"We could get there in three hours IF this was a smooth marathon route with no enemies or obstacles. "}]},{"spans":[{"text":"Guess where we are, my lady?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"We're in bloody Sangvis territory!"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"That's why I sent you to scout ahead."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Ha, ha, ha. How \"cautious\" of you. "}]},{"spans":[{"text":"Now what? I did my job. What about you?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"You stay here and keep gathering intel. The Commander is about to lead our echelons forward. "}]},{"spans":[{"text":"I'll get in touch with Tavor and find out her infiltration progress."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Hmm, Negev?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"Be careful."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"It's just a night op. Nothing I can't handle."}]}]},{"sprites":[{"prefab":"AR","expression":0,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Galil","narrator":false,"pages":[{"spans":[{"text":"I keep saying... "}]},{"spans":[{"text":"Whatever. Do your best. Keep everyone safe."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Negev."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Hmm?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"You're too reckless."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"I know."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"You didn't learn anything I taught you."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"I wouldn't call that teaching, Jericho. You sent me to die. "}]},{"spans":[{"text":"Even if I had learned anything, I forgot all about it after dying."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"I told you I'll help you remember."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"But then...we'll forget about you."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"I don't care. We are soldiers."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Humans don't leave their own safety in the hands of cold, rigid robots. That's why they chose us. "}]},{"spans":[{"text":"My neural cloud tells me that I don't want to forget you. If I can have my way, no one will ever forget you."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Who taught you...to have such...\"thoughts\"?"}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"What on earth are you afraid of, Jericho?"}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You really have grown a little when I wasn't looking... At least in terms of rhetoric. "}]},{"spans":[{"text":"But what exactly was your target of retrieval in your operation?"}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Well...wait for it... "}]},{"spans":[{"text":"Let me organize my thoughts. I'll reveal it in good time."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"I was right. When you retire, you'll make a great talk show host."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Anyway, so I directed the Commander to advance towards the car factory. "}]},{"spans":[{"text":"After a skirmish, we took the outpost and got in touch with Tavor..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"10","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]}]}
