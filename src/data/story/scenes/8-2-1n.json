{"name":"8-2-1N","beats":[{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"A cruel joke wrought upon us by fate... I see the lorries. "}]},{"spans":[{"text":"These guys have stopped right here. Isn't this a perfect opportunity?"}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}},{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Are you certain that's our convoy? "}]},{"spans":[{"text":"Couldn't they just be some random lorries...?"}]}]},{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"The detector is getting stronger readings. It has to be them."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Looks like the Commander was right... "}]},{"spans":[{"text":"Thank goodness we found the cargo here."}]}]},{"sprites":[{"prefab":"SSG69","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"SSG 69","narrator":false,"pages":[{"spans":[{"text":"But don't you think... that it was just a tad bit too easy? "}]},{"spans":[{"text":"Wouldn't S.F. want to guard something like this much more heavily?"}]}]},{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"How, pray tell? Wrap it up with a beautiful ribbon and then send a greeting card to Griffin? "}]},{"spans":[{"text":"It's nigh impossible to hide something this large. Any attempt to camouflage it is a fool's errand."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Couldn't we just destroy the cargo on the spot?"}]}]},{"sprites":[{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"Have your rationale capacitors been fried? It's radioactive."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"So our only hope in neutralising this risk... is taking it with us."}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Doesn't this place remind you of our dorms at Griffin?"}]}]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Glock17","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AUG","expression":0,"shown":true