rod","narrator":false,"pages":[{"spans":[{"text":"They're getting serious."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"We're this close to accomplishing our mission... Feels like déjà vu."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}},{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"...Could you NOT bring that up right now?"}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Well, it's not exactly the same as the last time where you only managed to open the vehicle door. Sending a call for our ride back wasn't even part of the equation."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Welrod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"Welrod","narrator":false,"pages":[{"spans":[{"text":"So you have met your end once before under such circumstances. Thus, we shan't fall to the same mistake."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"background","value":"BG7-4","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Seriously, whose side are you on, AUG...?"}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"shown":true,"side":"left","tags":{"spritePosition":