{"name":"-51-3-7","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"506","raw":"BIN"},{"type":"fadePoint","raw":"黑点2"},{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In an abandoned outpost on the edge of the Red Zone. "}]},{"spans":[{"text":"XM8 is sitting on a table, idly kicking her legs."}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Yo, you're here at last."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Thank you, XM8. You helped us discover an important clue."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Thanks to you, we've finally got a safe place to rest up!"}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Hehe, easy peasy. "}]},{"spans":[{"text":"Oh yeah, Leader, Miss Persica asked me to bring this along."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"XM8 hands the strange device named \"Strongarm\" to RO635, and at the same time she shares the offline map with everyone."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Strongarm? What's this for?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Lemme see!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Upon seeing a device she's never encountered before, SOP-II eagerly grabs it and fiddles with it, looking for a slot on her body where it'll go."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hm? Why can't I plug it in?!"}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Maybe Miss Persica didn't prepare it for you."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Humph! Then who's it meant for?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 takes the strange little device from SOP-II, but she can't fathom its uses either."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"XM8, did Miss Persica say anything else about this \"Strongarm\"?"}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"Nope. She said you'd understand once you got it."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Alright then, I'll hold on to it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 seems to have an inkling, but right now she doesn't have the time to think about it. Instead, she picks up her communicator."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"This is Umbrella, hailing all squads on Task Force Aeneas."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Nitrogen here. Are there any new mission developments?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yeah, let's wait till everyone's gathered first."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Squad Ferrum joins the channel."}]}]},{"sprites":[],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"What is it now?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Squad Ferrum is here. ","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Good, we're all here. I'll contact the Commander now."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Roger.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"RO, any news?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A familiar voice speaks through the comms."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We've approached the vicinity of the Black Zone. The radiation level there is abnormally high. "}]},{"spans":[{"text":"That's why I was hoping we could conduct a strategic meeting first."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Please outline the current situation.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We've verified Morridow's trail. She was originally accompanied by Gray and Grig on her way toward the Black Zone. "}]},{"spans":[{"text":"However, because our shadowing was spotted, Gray and Grig stayed behind to buy time for Morridow to flee. "}]},{"spans":[{"text":"According to Squad Nitrogen's most recent report, Morridow has boarded a truck and entered the \"Dead Sea\"."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"In other words, we are also about to enter the \"Dead Sea\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the shared tactical sand table, RO635 plants a flag in the middle of the patch of blackness that represents the Dead Sea. "}]},{"spans":[{"text":"The mood in the air instantly turns somber."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Once we proceed, our comms will be severely impeded. This will be a great trial of our coordination..."}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"But we haven't even played chess together. How are we going to coordinate with each other?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Architect","narrator":false,"pages":[{"spans":[{"text":"Hahahaha! You took the words right out of my mouth!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"You can shut up now.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hey! Pipe down, you two! The Commander and RO are giving a briefing!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Chessmaster has brought up a problem that we'll have to tackle. We're all from different squads and were put together at short notice. "}]},{"spans":[{"text":"We haven't had any practice working together, so it's hard to tell if we can even coordinate well."}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...That's true.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"However, we have no time left to build teamwork."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Yup. If we miss this opportunity, there's no telling when we'll get another one."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"At this stage, our respective objectives remain the same. "}]},{"spans":[{"text":"However, conditions in the \"Dead Sea\" are complex, so every squad's mission parameters may change. "}]},{"spans":[{"text":"No matter what happens, we need to maintain contact and make timely adjustments for such changes."}]}]},{"sprites":[],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Nitrogen copies.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Unicorn copies."}]}]},{"sprites":[],"ops":[],"speaker":"Gager","narrator":false,"pages":[{"spans":[{"text":"Okay.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"XM8MOD","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"XM8","narrator":false,"pages":[{"spans":[{"text":"No problem!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, that's it for us here."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Good. That'll do.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_HeavyVehicle_Stop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Meanwhile, on the side of a road in the \"Dead Sea\"."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"485","raw":"BIN"},{"type":"bgm","value":"BGM_stage11","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray and Grig have rushed here to meet up with Morridow, whom they help in dismounting the vehicle."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"...This is as far as this vehicle goes. Did you lose them?"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Yes, they're a long way off."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Same here."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Whew..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow takes a deep breath."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Now I'm sure they did something to my body. "}]},{"spans":[{"text":"We could stand to learn some technical lessons from these Soviets... Just to be safe, prepare a unit to cover us."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Activating an aircraft now might expose our position again."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"We can't delay any longer, and we need to return to the tower immediately. "}]},{"spans":[{"text":"Also, I'm already thoroughly exposed... We basically have to assume that they'll catch up with us at this point. "}]},{"spans":[{"text":"Still, no need to worry. A few measly Dolls won't pose a threat to us."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Besides, they can't catch up with us without aircrafts of their own."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"Just in case... "}]},{"spans":[{"text":"And I'm saying just in case, what will Father do if we end up giving away Avernus' location to the enemy?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In a rare turn of events, even Gray is questioning Morridow's orders."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow raises her head. She was badly injured to begin with, and the previous battle has further exacerbated her condition."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"That's not a big deal. As long as what happens in Avernus stays in Avernus, then no one will be any the wiser! "}]},{"spans":[{"text":"As for Father... I'm sure he won't blame us, because the news I will bring him is far more valuable than this base."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":11,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Trust me, Gray. "}]},{"spans":[{"text":"I need to get back..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":10,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Let's go! Now!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Gray..."}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Gray","narrator":false,"pages":[{"spans":[{"text":"...Let's head to the outpost. They're changing shifts today, so there ought to be backup aircrafts there."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Grig notes the multiple expressions that have crossed Gray's face. After a very long silence, she finally answers."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Grig","narrator":false,"pages":[{"spans":[{"text":"Yes, I understand."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
