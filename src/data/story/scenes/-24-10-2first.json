ory.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"SOP-II, you need to find a safe route that avoids Sangvis defense strongholds!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Got it! "}]},{"spans":[{"text":"I'll think of a plan along the way!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Hurry... please hurry, SOP-II!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We've come so far, we mustn't let everyone die here! "}]},{"spans":[{"text":"Check your map and consult the plans M4A1 and the Commander left behind to see which one is applicable to a situation like this!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hang on... wouldn't Sangvis-controlled territory make things more interesting?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"M16... I think I understand what you were talking about..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]}]}
