ges":[{"spans":[{"text":"...Scarecrow doesn't answer. She simply signals behind herself."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"...?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...A Sangvis Dinergate drags a box up to SOP-II."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"This is the backup power supply you wanted."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You're not asking me why I want it?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Scarecrow turns and leaves."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"I don't care. I don't need it now."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"So, that's it?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"We're already withdrawing. Hurry up and get out of here."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...SOP-II opens the box. It is indeed a Sangvis backup power supply."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"(Shouts) You know I wasn't willing to do this, right? I'd rather talk to your severed head than you!"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"I only agreed to this negotiation purely out of practical considerations. There won't be a next time."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Then can you run, Scarecrow? You do know the Military is going to prioritize pursuing you, right?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Why do you care?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You're excellent bait for us! We'll be sad if you die."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"I'll run as far as I can so that you won't have to shed tears on my behalf."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I know you're planning to escape from the Helipad with your tails between your legs, but the Military won't let you