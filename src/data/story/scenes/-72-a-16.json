pression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-50"}}],"ops":[],"speaker":"Styx","narrator":false,"pages":[{"spans":[{"text":"In fact, I hope things don't move too fast—I'd hate for it all to be over before we even get to show up in our finest."}]}]},{"sprites":[{"prefab":"NPC-Hebe","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hebe","narrator":false,"pages":[{"spans":[{"text":"...Honestly, I'm getting tired of this body. I just want it all to be over. Preferably without me having to lift a finger."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"17xh-Networld","raw":"BIN"},{"type":"sfx","value":"AVG_Shield_Startup","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Aeneas Conference Room—activated."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander delegates access permissions to all Dolls participating in the operation."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Welcome to the Aeneas Conference Room, everyone. From this point forward, all mission orders and intelligence updates will be issued here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gestures for AR-18 to project a map of Frankfurt into the room."}]},{"spans":[{"text":"Several flashing red dots mark the locations of Doll teams still operating within the city."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Currently, Squad 404 and Task Force DEFY are still in the urban area of Frankfurt. The AR Team will head over to assist you shortly.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"To counter sweeps and attacks from the Nytos, all teams remaining in the city must change safe houses every 24 hours.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Don't worry—this is 404's specialty.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"We've also prepared backup locations for the other teams!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Great work. Please stay safe out there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"...Commander.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"How's 416 doing?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"416 has been placed in a repair tank. Her situation is complicated, and repairs can't be completed onboard the Elmo.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"But don't worry—her damaged data have already been sent to Persica and Dier. Their initial assessment is cautiously optimistic.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Gr G11","narrator":false,"pages":[]},{"sprites":[{"prefab":"G11Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"...Okay!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We reviewed the electronic warfare attack that took down 416. The enemy was clearly prepared—the amount of redundant data was overwhelming. I tried every decryption tool available... Honestly, the workload alone could get me archived in a Doll Antique Museum.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The opponent appears to have used a data compilation structure I've never seen before. We still can't determine her basic profile or combat style.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The fact that she was able to take out 416 without alerting us makes her extremely dangerous.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"We know far too little about her right now. Don't act rashly.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Understood.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I'll also try to dig up intel on this new Nyto from other sources.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Commander, both DEFY and 404 are continuing real-time monitoring of the Bee Sting System.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Paradeus has significantly increased the frequency of dynamic key changes, and the security level of those keys has also gone up.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Any new discoveries concerning Project Cocoon?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"On that subject, all Paradeus factories in Frankfurt have ramped up to full production capacity.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"This is unprecedented—it's like they no longer care about staying hidden, discarding all attempts at concealment just to manufacture Iaso's Boxes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...They're accelerating Project Cocoon's timeline.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We can't let them complete the shipment...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right. Locate their production lines and find a way to destroy them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab"