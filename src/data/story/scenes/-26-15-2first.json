{"name":"-26-15-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"157","raw":"BIN"},{"type":"bgm","value":"BGM_Sad","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The operation has dragged on for too long and the infection has spread all over Ange's body. Task Force DEFY is forced to abort the mission and make a swift escape."}]}]},{"sprites":[{"prefab":"AN94","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The contamination index in this area is falling! There must be a safe spot ahead!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Hurry, Ange! Keep running! We're almost there!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Heading towards something. That's what Ange has been doing all along."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange?"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...But she has never felt so lost before."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ange..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Confusion, terror, hate. At the last moment... "}]},{"spans":[{"text":"...She lets go of all these things that she's been holding onto, so that she can get the one thing she wants right now."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange..."}]}]},{"sprites":[{"prefab":"安洁莉娅","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"GUARGHHHHHHH!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Death."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Ange... "}]},{"spans":[{"text":"I can't do this..."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Didn't you hear her, AK-12? "}]},{"spans":[{"text":"She wants us...to kill her."}]}]},{"sprites":[{"prefab":"AK12","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"安洁莉娅","expression":0,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Ugh...argh... "}]},{"spans":[{"text":"GUARGHHHHH!!"}]}]},{"sprites":[{"prefab":"AN94","expression":4,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"This is our final order. Come on."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Gunkill","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang, bang!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"157","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Half an hour later, at a certain communications outpost."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Commander, Ange's radiation sickness escalated and became rampant. We obeyed her dying wish and put her down.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"The rescue mission has ended in failure. AN-94 and I will bury Ange's body and self-destruct in 15 minutes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Please...withdraw the rescue party and leave the battlefield as soon as you can.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...End of transmission. "}]},{"spans":[{"text":"...Not another sound comes through the communicator..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"158","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"We are surprised you are still capable of such deception under these circumstances. "}]},{"spans":[{"text":"We have truly underestimated you, Griffin Commander. "}]},{"spans":[{"text":"We must administer a larger, but not fatal, dosage."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A Nyto takes out another syringe and injects the truth serum into my veins."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The effect starts kicking in quickly, but I can still resist it. I still have a bit of willpower...though I don't know if I'm already running on fumes..."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Ange did not die, at least not in this battle. We saw her kill one of us with our very own eyes. "}]},{"spans":[{"text":"So tell us how she survived and with whom she has had dealings."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I will tell them everything that comes to mind. "}]},{"spans":[{"text":"The lies, the truth. Let them guess. "}]},{"spans":[{"text":"I know what they're really after. I also know the consequences of giving them what they want."}]}]},{"sprites":[{"prefab":"Nyto","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Humans are fragile contraptions that break down easily. "}]},{"spans":[{"text":"If you wish to leave this facility with your mind and body intact, value the chance you have been given and tell the truth."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That's why I need time...as well as all sorts of fantasies to counter the truth serum. "}]},{"spans":[{"text":"How many more times will Miss Ange die in my story? "}]},{"spans":[{"text":"At the very least, she has to keep dying till I can live... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
