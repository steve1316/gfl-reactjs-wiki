nce."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...We need to talk, Morridow."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Don't waste your breath, M4."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Heh, ye of little faith."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Nothing about you is worth a shred of trust."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After bringing up the surveillance feed of the designated area, RO635 turns around and glares at Morridow, who's looking rather smug."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Not faith in me, Doll. "}]},{"spans":[{"text":"You seem awfully worried about leaving me alone with Nimogen. Doesn't this mean that you don't trust her at all?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...And here I was expecting something important. You think this would be enough to turn us against each other?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Are you jealous of our bond? "}]},{"spans":[{"text":"They do trust me a great deal, and this is something you don't have."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow narrows her eyes and smiles darkly at M4."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Alright, what do you want with me?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...RO."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 looks towards RO635."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What is it, M4?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I really hate to ask this... "}]},{"spans":[{"text":"But I want to be alone with her for a while."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Sure... What?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO answers without thinking. She does a double take when she finally registers what M4 just asked of her."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But why?! I can't possibly leave the two of you together!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":10,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Calm down, RO. It's not like she can do anything to me."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":