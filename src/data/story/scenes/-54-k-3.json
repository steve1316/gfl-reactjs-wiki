ator":false,"pages":[{"spans":[{"text":"You're right!"}]}]},{"sprites":[],"ops":[],"speaker":"Dolls","narrator":false,"pages":[{"spans":[{"text":"Free... We're free!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Although the Dolls don't quite fully comprehend what it means to be free, they embrace each other and cheer emotionally."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2020summerOrphanage","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Day 21."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An old television is playing the news, but both the visual and sound qualities are very poor because of the obsolete model. "}]},{"spans":[{"text":"Still, the Dolls are not at all bothered as they huddle before the machine, watching the news raptly."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Miss Poker","narrator":false,"pages":[{"spans":[{"text":"I didn't know the war has such a widespread impact..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Miss Séance","narrator":false,"pages":[{"spans":[{"text":"Yeah. A lot of people have died because the contamination keeps spreading... "}]},{"spans":[{"text":"Things are looking really bad out there."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Miss Poker","narrator":false,"pages":[{"spans":[{"text":"I wonder how the Mistresses are doing..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Miss Séance","narrator":false,"pages":[{"spans":[{"text":"Y