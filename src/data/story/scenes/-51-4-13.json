f","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Analyzing format... "}]},{"spans":[{"text":"Playing."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a flicker, the screen reveals a familiar figure. "}]},{"spans":[{"text":"The Commander stops breathing for a second."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"2021white_GriffinSPAWAR","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...Long time no see, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange looks very battered and bruised in the clip, but her firm and resolute gaze shows that her spirit remains unbroken. "}]},{"spans":[{"text":"For some reason, just the sight of her face puts the Commander at ease."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Time is short so I'll get to the point.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'm really sorry, but I can't leave this place just yet.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before the Commander can react, ST AR-15 exclaims with wide eyes. RO635 and SOP-II's fate is still unknown—she has never been more high-strung."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But the Commander simply waits quietly for Ange to continue."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...This may be hard for you to swallow.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You went to such great lengths and arranged for a task force to rescue me... yet this is the answer you get.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"However, I have a very compelling reason for my decision.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I will tell you the reason—you deserve that much.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But before that, you must answer a question.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Question?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Commander, what should we look to in order to save the world?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Go on, give me your answer.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"This will tell me... whether we are really on the same side.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What the hell...? Why has it stopped?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Dandelion?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The second half of the video is encrypted. "}]},{"spans":[{"text":"It will only resume with a password... I'm guessing that's the \"answer\". "}]},{"spans":[{"text":"I can also try to break the code by force... if you don't know the correct answer?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What a strange question... Who knows what it is that she wants to hear."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange... I believe the answer you're looking for is... "}],"choices":["The past...","The present...","The future..."]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...To uphold the past and carve up the world the old way—like the Earl, like Oberstein, like those bureaucrats. "}]},{"spans":[{"text":"To restore their idea of \"order\" to the world, where their rules are followed, their authority is obeyed, and their interests are protected. "}]},{"spans":[{"text":"As the Earl puts it, the minority decides the rules, and the majority has to follow the \"right path\". "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"But are they really right? "}]},{"spans":[{"text":"If they were... the world wouldn't be in this sorry state. "}]},{"spans":[{"text":"The past is a mistake. Their immutability will only lead to repeated tragedies. "}]},{"spans":[{"text":"No, this isn't it."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It's the present."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...To blaze a trail to the future—that does sound very appealing. "}]},{"spans":[{"text":"The Commander mulls over these words and imagines the possibilities that the future holds. "}]},{"spans":[{"text":"However... in order to realize such a world, what would be the cost, and who would bear the cost? "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"If people who pin all their hopes on the future squander what they have in the present. How much of what should be saved will remain when the future comes? "}]},{"spans":[{"text":"How can we talk of the future if the present is lost?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...To safeguard the present. Yes, that's right. Like what Ange, Mr. Kryuger, Machlian, and all the people on their side have been doing. "}]},{"spans":[{"text":"Forget the countless tragedies of the past. Forget how the self-righteous hypocrites spin their lies... Forget all the sacrifices, and the bright but intangible future. "}]},{"spans":[{"text":"Them. Us. "}]},{"spans":[{"text":"What we can protect, what we can maintain, what we can trust and what is within reach... "}]},{"spans":[{"text":"It's the present."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"2021white_GriffinSPAWAR","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The present..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...It's the present, Ange. "}]},{"spans":[{"text":"Our focus has never changed. "}]},{"spans":[{"text":"It's not something in the past. It's not something intangible. "}]},{"spans":[{"text":"It's the present that we're living and breathing."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzt..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"It-it's playing again!"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...I knew it all along.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In the end, we really are allies, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On the screen, Ange smiles in relief before turning serious again."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"The situation has changed, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"His goal isn't to eradicate Paradeus.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"What he wants... is to bring William under his control.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even though Ange didn't give the name, the Commander understands right away who she's referring to."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...I will never let that happen.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"If he decides to withdraw from this operation, then I'll pick up where he's left off and eradicate Paradeus.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"A demon is a demon, not because of his greed, but because he possesses a demon's powers.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We must not let him acquire this power, which has already cost so many lives...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"As for William, I think it's time we settle things with him.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're using yourself as bait...?"}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I have received the gift that you had RO deliver to me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I also have some help here. You don't have to worry about me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Time's almost up, Ange.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange smiles at the camera, her eyes gleaming with great determination."}]}]},{"sprites":[{"prefab":"NPC-AngeDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Listen, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"My plan is to—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"... "}