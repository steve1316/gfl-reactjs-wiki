{"name":"10-4-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"98","raw":"BIN"},{"type":"bgm","value":"BGM_Sunshine","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Sangvis offense is completely decimated. Griffin has successfully protected the Military's interference neutralizer."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That was fantastic! We dealt with all those Sangvis troops so quickly! "}]},{"spans":[{"text":"RO, is this how powerful the military units are?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Oh? Even you find them remarkable, SOP-II?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"They are nothing to sneeze at in terms of pure firepower and mobility. "}]},{"spans":[{"text":"But then again...these big oafs aren't entirely invincible."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"So you noticed it too. As expected of you. "}]},{"spans":[{"text":"But with the might of the Military, mowing down the Sangvis forces shouldn't be a problem, right?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Even so, I wouldn't miss the capture of Mastermind for the world. "}]},{"spans":[{"text":"Especially since...she probably has M16..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP-II... "}]},{"spans":[{"text":"M4's here..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Oh, M4! You did well!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Good, you're okay. "}]},{"spans":[{"text":"The Commander is asking for our next objective. We'll probably have to move right away. Will that be a problem?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Nope! I've been waiting for this!"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"RO..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hmm?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I just want to say...sorry... "}]},{"spans":[{"text":"I was rather rude to you because of my turbulent mental state... "}]},{"spans":[{"text":"If it weren't for your support, I wouldn't have been able to accomplish our mission."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Oh...don't mention it. "}]},{"spans":[{"text":"There's no need to apologize either. I've forgotten all about it, haha..."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You have bold ideas and make keen observations. You also have the drive to put things in action. "}]},{"spans":[{"text":"It is an honor to have you on the AR Team."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Uh... "}]},{"spans":[{"text":"Haha, is that so? I still have a lot to learn, so let's watch out for each other."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm sorry you have to join us under such circumstances. "}]},{"spans":[{"text":"From the combat records SOP-II sent me, I can see that you really are an outstanding T-Doll. "}]},{"spans":[{"text":"That's why, just like M16, I've decided to have faith in you. You are now officially part of the team."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I also have faith in you, M4A1, and I'll defer to your authority. "}]},{"spans":[{"text":"I'll also put in some strong opinion when the situation calls for it. Don't hold my grating voice against me, okay?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Sure. I'm counting on you... "}]},{"spans":[{"text":"(Please, support me and guide me forward, just as AR-15 and M16 once did.)"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"There's still the last part of the welcoming ceremony. Should we wait till we finish off Mastermind?"}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I don't mind. It's not gonna take long anyway."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"A transmission request from the Commander."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Your order, Commander. "}]},{"spans":[{"text":"Follow the Military forces? "}]},{"spans":[{"text":"Understood. We're on our way. "}]},{"spans":[{"text":"Yes, the AR Team will stick together."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Are we setting off?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yes, the Milita