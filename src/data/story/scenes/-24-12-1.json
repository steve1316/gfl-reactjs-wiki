FF"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"W-What... did you say? "}]},{"spans":[{"text":"Hey, didn't you say there wouldn't be a next time?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Is your hearing module defective? Ask your friends, I won't repeat myself.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Also, the situation is different this time round.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You know I didn't do what I did just now to suck up to you, right?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Same here.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Scarecrow ends the transmission."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Wait— "}]},{"spans":[{"text":"Honestly, what the heck is she up to...?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"This route ultimately leads to our former command post. "}]},{"spans":[{"text":"Even if the Commander's gone, there ought to be Dolls or resources left behind. Once we reach it, we can perform some minor repairs on ourselves. "}]},{"spans":[{"text":"So... can we trust her? "}]},{"spans":[{"text":"Can we trust the Sangvis ringleader who was trying to kill us just a few hours ago?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"No, but... we have no other choice."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"If nothing else, we trust you, SOP-II."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yeah... "}]},{"spans":[{"text":"(Making choices is hard...)","style":{"color":"#A9A9A9"}}]},{"spans":[{"text":"(Was M4A1 always under such immense pressure on every operation...?)","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"SOP-II?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Arghhh, I don't care anymore! "}]},{"spans":[{"text":"I don't care if it's a trap or whatever, if they dare to trick me, I'll hunt them down to the ends of the earth! "}]},{"spans":[{"text":"Let's go! We'll head towards that base over there. Everyone, check your weapon modes and be wary as you get close. "}]},{"spans":[{"text":"Pay attention to the elite units' detection range! Don't open fire without my orders!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Holding down on the Sangvis echelons displays their detection radius.","style":{"color":"#fff775"}}]},{"spans":[{"text":"Taking this radius into consideration will allow you to avoid combat with some of the S.F. forces.","style":{"color":"#fff775"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
