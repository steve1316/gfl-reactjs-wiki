:"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The bubbling coffee pot looks so retro it could easily pass for an antique from the previous century. "}]},{"spans":[{"text":"A record player is playing some very old music with the occasional pop and crackle."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Miss Catherine! Wake up!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"background","value":"528","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Who's calling? And who is Catherine?"}]}]},{"sprites":[{"prefab":"NPC_CZ52","expression":0,"side":"left","tags":{"Position":"0,170"}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Miss Catherine, please get ready quickly! "}]},{"spans":[{"text":"Miss Maggie told us that a very important customer is about to visit."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Huh? Is she talking to me?","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"spritePosition","value":"0,60","raw":"Position"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...We seem to be observing events from this blonde woman's perspective.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Let's see what this anchor point is going to show us.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_PP90","expression":4,"side":"left","tags":{"Position":"0,200"}}],"ops":[],"speaker":"Catherine Ponzi","narrator":false,"pages":[{"spans":[{"text":"A very important customer? Oh right, you mean the campy scammer in a suit with the advance booking, yeah? "}]},{"spans":[{"text":"Tsk, we are the real con artists here, so why should we entertain him?! "}]},{"spans":[{"text":"Sophia, when is his appointment?"}]}]},{"sprite