{"name":"-16-5-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click. "}]},{"spans":[{"text":"Ange uses the comms station's equipment to send a transmission to the outside world."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Is that so? "}]},{"spans":[{"text":"Griffin's shifting towards Area S11? "}]},{"spans":[{"text":"I see it, it's a total mess over here. "}]},{"spans":[{"text":"...There, I was right. The Military's going to use this as an excuse to openly enter the battlefield and restore order. "}]},{"spans":[{"text":"I know, that's just their excuse. Even now they're reorganizing their troops on the outskirts. "}]},{"spans":[{"text":"Once their main forces mobilize and intervene, we'll have no chance of stopping them at all."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Yes. I'll do my best to slow them down, but I can't hold on for long without support. "}]},{"spans":[{"text":"Eh...having our support troops standing by at the perimeter won't solve anything...I guess you know what they want to do... "}]},{"spans":[{"text":"I understand. I completely understand your concerns, Chief. I'll do my best to buy you time. "}]},{"spans":[{"text":"However, if the worst comes to the worst, I hope you will approve the plan I laid out earlier. "}]},{"spans":[{"text":"I understand, it's a very radical solution, but if... "}]},{"spans":[{"text":"Yes, yes, I'll wait for approval. I'll do my best to ensure it does not come to that."}]}]},{"sprites":[],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Transmission terminated."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Looks like it's time to go all-out now... "}]},{"spans":[{"text":"Hmm...I hope they're still alive."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click. "}]},{"spans":[{"text":"A transmission connects over an encrypted channel."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Guten Tag. Have you missed me?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Nothing good ever happens when I think of you. "}]},{"spans":[{"text":"What about the \"file\"?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Heheh, do you need to ask?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If it's been settled, then hurry back."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We ran into a bit of trouble. "}]},{"spans":[{"text":"Did you know? We caught up with Griffin's exodus by coincidence, so we helped them out a little."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Sier's told me all about how you love engineering these coincidences. "}]},{"spans":[{"text":"Alright, make a note of the people you saved and I'll help you get paid for it, assuming Griffin's still around after all this."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"sp2.2.4","raw":"BIN"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"If Griffin doesn't pay up, then please cough the money up from your own account."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"s