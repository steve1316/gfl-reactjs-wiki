{"name":"-44-A4-2-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"239","raw":"BIN"},{"type":"bgm","value":"10220","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"15:28, Berlin Time. "}]},{"spans":[{"text":"Former residence of \"William\" in the district of Neu-Tempelhof, Berlin."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"12 once told me that it's bad news for us whenever Ange is all pumped up. "}]},{"spans":[{"text":"I didn't take her seriously because I thought she was joking."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"What is it, 15?"}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"You're talking less. "}]},{"spans":[{"text":"Than usual."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Oh my, does that bother you? "}]},{"spans":[{"text":"How unexpected. I thought you didn't like me."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"It will jeopardize our mission if you are not in optimal condition. "}]},{"spans":[{"text":"Besides, you are the leader right now."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"\"Acting\" leader... Jeez, 12 left me with the worst possible job at the worst possible time."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"It means she trusts you."}]}]},{"sprites":[{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"That is definitely the second largest mistake she has made in her life."}]}]},{"sprites":[{"prefab":"AN94","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Nonsense. I think you are a wonderful... Second largest?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"What's her largest mistake then?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"That is a little secret between 12 and me. "}]},{"spans":[{"text":"So, Ange, let me ask you one last time. "}]},{"spans":[{"text":"Are you really doing this?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If you don't want to come, you can stay here with 94."}]}]},{"sprites":[{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Sorry, forget I asked."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Miss Ange, I'm ready over here."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"How many people do you have with you?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"Not many; they're all agents in my cohort. "}]},{"spans":[{"text":"All trustworthy. "}]},{"spans":[{"text":"Also...I haven't told them any specific details. "}]},{"spans":[{"text":"They only know that they'll be playing sentry."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Good... You'll just have to stay outside and keep a lookout for me. "}]},{"spans":[{"text":"I won't make things difficult for you. If your superior demands an explanation from you, just pile it all on me."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"It's okay, we're all prepared to live with the consequences. "}]},{"spans":[{"text":"Will Miss AN-94 be working with us?"}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Yes, I will also be standing guard outside the mansion with everyone from the Stasi. "}]},{"spans":[{"text":"In case of an emergency."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"The grouping is different this time. "}]},{"spans":[{"text":"Last time you stayed behind, Miss Ange tossed me aside."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"That won't happen again. "}]},{"spans":[{"text":"RPK needs to go in because we can't be sure if there will be any secret mechanisms or electronic installations in the mansion. "}]},{"spans":[{"text":"Don't worry, I will do my best to keep you all safe."}]}]},{"sprites":[{"prefab":"NPC-Light","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Light","narrator":false,"pages":[{"spans":[{"text":"That's not what I mean... Besides, we can handle ourselves just fine. "}]},{"spans":[{"text":"We look forward to working alongside you, Miss AN-94."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"We don't have much time. Light, have your men seal off the mansion. Don't let even a single fly in. "}]},{"spans":[{"text":"15, 16."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ka-chak."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Let's go."}]}]},{"sprites":[{"prefab":"AK15","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"...Roger."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"239","raw":"BIN"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"According to the Stasi's intel, this building has been uninhabited since a long time ago. "}]},{"spans":[{"text":"The signs of age and dereliction it shows all prove that to be true."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange walks into the front yard—it must have been many years since a gardener last tended to it. "}]},{"spans":[{"text":"Other than a few buzzing bees, there's no sign of any other living creatures."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...This eerie silence haunts Ange. "}]},{"spans":[{"text":"Her gut feeling tells her that she's in the right place. "}]},{"spans":[{"text":"She will definitely find what she's after here."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Are we entering through the front doors?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I don't think it makes any difference whichever entrance we choose. "}]},{"spans":[{"text":"RPK?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"No sign of anything unusual."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"If someone is lying in ambush, even if we enter through another door, or even through a window... "}]},{"spans":[{"text":"It won't do us any good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She crosses the wild and disorganized front yard and arrives at the main entrance of the mansion. "}]},{"spans":[{"text":"Even now, it is still quiet as a tomb."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Go take a look, 15."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a nod, AK-15 walks up to the doors and lays a hand on them."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"See anything in there?"}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...No, nothing out of the ordinary."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange makes her way up the front staircase and stops next to AK-15. She, too, places her hand on the doors."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Ange."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...What?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Are you really going in?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Of course. "}]},{"spans":[{"text":"Have you noticed any problem?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Other than the cleaners' botched job? Nope. "}]},{"spans":[{"text":"But don't you think that's what makes it so suspicious?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...You have a point. "}]},{"spans":[{"text":"But we can't back down now. "}]},{"spans":[{"text":"The more suspicious this house is, the more we can be certain we're at the right place."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After one final pause."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"15, open the doors."}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"240","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 gives a powerful shove, and the doors of the mansion swing open. "}]},{"spans":[{"text":"The double doors shudder and creak, shaking loose a thick layer of dust. They are so out of use that the hinges look as if they might fall right off the wall."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange holsters her pistol and slowly enters. "}]},{"spans":[{"text":"In the gloomy foyer, there is no sound other than the trio's echoing footsteps."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"It's pretty big inside."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"It will certainly take a while to look through the place. "}]},{"spans":[{"text":"Considering the covert nature of our mission, I think we should minimize the time we spend in here."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Got any suggestions?"}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"15, you take the east wing. "}]},{"spans":[{"text":"Ange and I will check the west wing. "}]},{"spans":[{"text":"Keep checking in periodically and notify us immediately if you find anything. "}]},{"spans":[{"text":"How does that sound?"}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...I have no objections."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Sounds reasonable. Let's do that."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 nods and slings her rifle onto her back."}]}]},{"sprites":[{"prefab":"RPK16","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[{"prefab":"AK15","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...Nothing."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She gives RPK-16 one last look before heading off to the right."}]}]},{"sprites":[{"prefab":"RPK16","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Shall we go too, Ange?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Ange nods and takes the lead as they turn left."}]}]},{"sprites":[{"prefab":"RPK16","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two of them walk on, heading deeper into the mansion."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
