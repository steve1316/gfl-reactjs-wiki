{"name":"-33-27-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"m_avg_labyrinth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"......"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Have new sacrifices come?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"2019summer_3","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"More refugees... It appears the Epiphylla will bloom again in several days. "}]},{"spans":[{"text":"But I guess there will not be any chosen ones this time either. "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Such a being does not exist..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Are these the memories of the Isomers?)"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"A transport train? Have Father and the others come?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"We must hurry and open the quarantine wall..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_3","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The train has entered the city... "}]},{"spans":[{"text":"But I cannot hear my friends' voices... "}]},{"spans":[{"text":"Is there nobody else alive here but me?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"There is another train; someone must be alive..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_8","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is this place no good either..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"They are still alive, but their minds seem to be damaged. Could they not endure the Parapluie virus?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(The Parapluie virus? Why would they mention that?)"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"But of course. It's been used for doing all sorts of dirty work in addition to corrupting Griffin Dolls. What a handy \"virus\" it is."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Reverse","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Is that voice...UMP45?"}]}]},{"sprites":[],"ops":[],"speaker":"OGAS","narrator":false,"pages":[{"spans":[{"text":"Tsk... Is that the rat which had come in earlier? I should have dealt with you sooner rather than later."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Apologies for interrupting your refined pleasures of babbling utter nonsense. But even someone as patient as me was hard-pressed to continue listening to your rubbish."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_1","raw":"BIN"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Huh? Where is this place?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Thank goodness you kept it talking for so long, I had the chance to escape from its offensive firewall. So in return, I'll help you out too. "}]},{"spans":[{"text":"This virtual space is made of different connections all grouped up together. We've jumped to another circuit, so we should be able to avoid that voice for now."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Mind explaining why you're here?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well, someone's got to clean up after you, right? "}]},{"spans":[{"text":"I didn't expect to find such a talkative consciousness hiding inside M4's neural cloud. I suppose the reason why she's usually so quiet is because she's too busy talking to herself."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Did you hack into M4's neural cloud?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You don't seem too surprised by the existence of another neural cloud inside M4."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"How much do you know...? "}]},{"spans":[{"text":"Did Persica ask you to pursue this investigation? Or was it the Commander?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"As interesting as ever, I see. Alright, keep up with me."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Where are you going?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You're here to find M4, aren't you? "}]},{"spans":[{"text":"M4's neural cloud is connected to those Isomers, but she didn't let her own neural cloud come back. At least, not yet. "}]},{"spans":[{"text":"Is it because she's been trapped? Or does she not want to come back because she's looking for something?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Don't talk as if you know her so well."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You might not believe this, but we've repeated this conversation ten thousand times already, doing the same thing over and over again in different connections. Unfortunately, our luck isn't too good, which is why we've been looping this over and over again. "}]},{"spans":[{"text":"Therefore, I know everything that I should and shouldn't know. I didn't know how much you cared for her. Oh, what a touching friendship."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...You...you what?!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Just kidding~ "}]},{"spans":[{"text":"But this time, we've been kind of lucky. We've finally come to a connection that leads further in."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Further in? "}]},{"spans":[{"text":"You mean, these...memory fragments?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"These are memory fragments that M4 has read before. We should be able to get closer to her by following them, don't you think?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Thank you for showing me the way, but I'll be fine by myself from here on in."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Dear me, it's a little embarrassing to admit this, but the truth is - I'm also stuck in this place. I don't think we'll be able to leave until the connection is broken. "}]},{"spans":[{"text":"So, shall we head out?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Fine, let's go."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_avg_labyrinth","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"The corpses have all been moved away... They called themselves believers, but nobody was willing to speak to me. I watched them leave from afar, and the look in their eyes... It was as though they had seen a monster."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"How many times have the Epiphylla bloomed? These humans have died again, and my friends are unwilling to answer me. "}]},{"spans":[{"text":"There are no chosen ones and nobody to accept me. Only a silence that seems to last forever..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is this a test Father has concocted for me? Or have I already been forgotten, simply obeying a promise that will never be kept? "}]},{"spans":[{"text":"Or...has he already found the flower in his heart, and is only waiting for me to end myself? "}]},{"spans":[{"text":"No... I don't want to believe it..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Ah...a new train has arrived... Will there be someone to accept me there...?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_3","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Ah...nobody responded, as always... Everyone failed... How many more failures will it take before Father is satisfied?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Wait... I can hear a voice... Is that a voice that can answer me?!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I can hear a voice... Where is it? Where on earth is it?!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is this...a Chosen One?! A true Chosen One? Will she lead me away from here?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Her mind has been damaged too...but she was chosen! Why is this happening?!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"Mercu...rows..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is this city nothing more than a rubbish dump to Father?! If nobody will come to accept me, then I will be the one who accepts others!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"What are you doing...?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I am sorry, but we must become one."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"These connections...no!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"Stop! Don't come inside! It hurts!"}]}]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"},{"type":"rate","value":"15","raw":"rate"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I see... So these are your memories... but no matter. You no longer need to remember these painful things..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I will use this body of yours in your place, until the time when we can leave..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Is this...the body of one who was once worthy? "}]},{"spans":[{"text":"With this, I can hear all the things I need to know. I will take as many of my friends with me as I can."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Their voices are starting to become distinct... Everyone...needs to connect together..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2019summer_1","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...So Nimogen was sent here in the end..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"You know this Nyto?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I fought her once. Paradeus is pretty ruthless to their own... Is the Isomer who hacked Nimogen the culprit behind all this?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Who knows? I'm more curious about the Parapluie virus that it mentioned. "}]},{"spans":[{"text":"Those unresponsive Isomers seem to be Dolls with melted-down neural clouds. "}]},{"spans":[{"text":"I'm very interested in why exactly Paradeus had to do such horrible things to their own creations."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Looks like neither of us will get the answers we want unless we press ahead."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"That seems to be the case. Let's move on, then."}]}]}]}
