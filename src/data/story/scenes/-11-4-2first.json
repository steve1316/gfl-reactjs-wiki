spans":[{"text":"What the hell is wrong with you? What's with that scary cackle?! "}]},{"spans":[{"text":"(Mutters) Your usual chuckle is enough to scare the crap outta me..."}]}]},{"sprites":[{"prefab":"梦想家","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"You're more interesting than I gave you credit for, UMP45... "}]},{"spans":[{"text":"Though this hasn't played out the way I want... Actually, this could be going even better than what I had planned! "}]},{"spans":[{"text":"What lies beneath your facade... "}]},{"spans":[{"text":"Let me uncover you...bit by bit..."}]}]}]}
