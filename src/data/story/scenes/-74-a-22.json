ssion":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Send a portion to the underground shelters; the majority of civilians are there."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander! I'll go follow up on the supply tally. "}]},{"spans":[{"text":"Oh, would you like handle the delivery to Miss Nele yourself?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nele? She... Right, I forgot to ask. How is she doing?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"According to 520, she and Amaris are still tending the wounded at Johannes Gutenberg University metro station."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Got it. I'll go myself. Please take care of the rest."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 heads off with her squad. "}]},{"spans":[{"text":"The Commander watches the Dolls withdraw from the cleared road, and their heavy mood lightens just a little."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"822","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Johannes Gutenberg University metro station. "}]},{"spans":[{"text":"The Commander arrives with some emergency supplies. Amaris has been waiting for them."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Here, Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris pulls them through the crowd. "}]},{"spans":[{"text":"The air has grown stale and stifling from the extended lockdown and overcrowding; the stench is overwhelming. "}]},{"spans":[{"text":"Forcing their eyes open, the Commander finally spots a pale figure in the crowd."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Nele!"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Busy inside a makeshift tent, Nele looks up. Seeing the Commander, she carefully steps around patients and comes out."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Commander? "}]},{"spans":[{"text":"Why are you here?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"520 said you needed medical supplies. I've brought the basics for now; I hope it helps. "}]},{"spans":[{"text":"Whatever else you're missing, make me a list. I'll try to find them."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Besides medical supplies, we're in need of emergency food and supplements. You came right on time, Commander."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nele... you look like you haven't slept in days."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Commander... you look the same..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Two worn-out souls share a knowing smile."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I thought you'd have left Frankfurt already..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And I thought you'd have gone home."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Honestly, I felt a little lost."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"sfx","value":"AVG_Zipper","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele remembers something. She digs into her bag and produces a tightly wrapped box."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Here, your Makarov."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander takes the pistol. It is empty."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I'm just not fit to carry a gun. "}]},{"spans":[{"text":"Just before Laplace died, she said something to me and gave me a key. Amaris will tell you."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What did she say?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"It doesn't matter anymore. "}]},{"spans":[{"text":"When blinded by hatred, I carry a gun. "}]},{"spans":[{"text":"But once the hatred is gone, I would rather hold a scalpel."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I want to save people. The more the better. "}]},{"spans":[{"text":"I am not a killer, and I don't find joy in killing."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You've done well."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Sorry, I'm rambling when I should be..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No, this is the time for such words, Nele. "}]},{"spans":[{"text":"Like you, in the face of this disaster, I've found my original aspirations—my true self. "}]},{"spans":[{"text":"Why did you take up the gun? "}]},{"spans":[{"text":"Why did I? "}]},{"spans":[{"text":"You set it down to save lives. "}]},{"spans":[{"text":"I hold it still, also to save lives. "}]},{"spans":[{"text":"Our methods differ, but our purpose is the same. We walk the same path."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Thank you, Commander. "}]},{"spans":[{"text":"Revenge is a long surgery. A step forward is hell, a step back is also hell."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander silently squeezes Nele's hand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Then Nele pulls out a storage drive and hands it over."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Now, there's one last thing I want to do. "}]},{"spans":[{"text":"Inside is evidence proving Professor Gray's innocence. I'll testify as witness."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Nele, you understand what this means? "}]},{"spans":[{"text":"You'll face endless retaliation... even from those you thought were friends..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I'm prepared."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele returns the squeeze on her hand with a faint smile."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"If Professor Gray's motto was, “Only death cannot be avoided, and only life cannot be let down,\" "}]},{"spans":[{"text":"Then mine would be Romain Rolland's words—"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Each one of us in turn climbs the Calvary of the age. "}]},{"spans":[{"text":"Each one of us finds anew the agony, each one of us finds anew the desperate hope and folly of the ages. "}]},{"spans":[{"text":"Each one of us follows in the footsteps of those who were, of those before us who struggled with death, denied death—and are dead. "}]},{"spans":[{"text":"Bathe in humanity every day, and endure, and love your destiny. "}]},{"spans":[{"text":"We all have to do what we can... Als ich kann."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
