ct","raw":"SE1"}],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Initiate routine intel sync.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Minister of State Security C","narrator":false,"pages":[{"spans":[{"text":"Main Division III confirms border base intel.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Data sync in progress.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Minister of State Security B","narrator":false,"pages":[{"spans":[{"text":"Main Division I confirms movements of the 10th Armored Division.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Minister of State Security D","narrator":false,"pages":[{"spans":[{"text":"Foreign Intelligence and External Operations confirm Carter's latest movements.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Minister of State Security A","narrator":false,"pages":[{"spans":[{"text":"Minister's Task Force E has secured the list of Obersteins' remnant followers.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Central Evaluation and Information Group progressing on schedule.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Conference Room 1—152 attendees confirmed, 89 dead, 2 missing.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Major General Kumm, commander of the garrison, has been suspended. Disciplinary result pending.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The top priority now is to make sure the meeting in Conference Room 1 proceeds as scheduled.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Deputy Ministers of State S