xt":"... "}]},{"spans":[{"text":"...This is an operating theater, hardly a place for receiving guests. "}]},{"spans":[{"text":"But inside, a young man is clearly waiting for someone."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He slowly polishes the scalpels and other surgical tools, glancing now and then at the clock."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tap, tap, tap. Unhurried footsteps draw near."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. The door opens. The newcomer removes his hat in greeting."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Sorry to keep you waiting."}]}]},{"sprites":[{"prefab":"NPC-William","expression":2,"side":"left","tags":{"Position":"0,-80"}}],"ops":[],"speaker":"\"William\"","narrator":false,"pages":[{"spans":[{"text":"You're late."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man removes his coat unhurriedly. "}]},{"spans":[{"text":"There are neither Dolls nor Nytos present. "}]},{"spans":[{"text":"A meeting of apparent sincerity."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker