tor":false,"pages":[{"spans":[{"text":"Hello? Do you not understand what I just said? Of course you don't.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"It's all scrambled code.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"You only get to read the report if you answer the question correctly~","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"687","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"branch","value":"1","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"230, 136, 130, 229, 133, 176, 229, 186, 145, 231, 142, 139, 230, 149, 176, ","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"229, 155, 189, 229, 164, 150, 227, 128, 129, 228, 186, 148, 229, 145, 168, 228, 186, 148, 227, 128, 130","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"50, 32, 43, 32, 55, 32, 61, 32, 57","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Hello? Do you not understand what I just said? Of course you don't.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"It's all scrambled code.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"You only get to read the report if you answer the question correctly~","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"branch","value":"3","raw":"分支"},{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"687","raw":"BIN"},{"type":"branch","value":"3","raw":"分支"},{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"GF_2022_Summer_AVG_2","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"AR-18, sorry for not picking up. Many things have happened in the Summer Garden.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I met up with the Doll who contacted us. It's Stevens M520, serial number 09-П-39.","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"There was a time when we lived here together, but she's the only one who retained her memories of that time. I wonder if you remember any of it...?","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I only realized you'd left a lot of anchor points with me after I came. Anchor points from when you were Polina, Daria, Lyudmila, and many more.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I'm not rambling here. I think it's necessary to report this. You are welcome to retrieve these anchor points anytime.","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Also, other than having a violent streak, Stevens M520 isn't really that odd. She's nowhere near as special or crazy as you made her out to be. And the info you gave me about Doctor Hume is totally inaccurate.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Didn't know you could be so unreliable.","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"By the way, since I'm Mother's first daughter, you should be calling me \"Big Sis\". Make sure you do that when I come back.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Right, you probably think I'm getting long-winded, but I'm done sorting out the issue with the Commander here!","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"3","raw":"分支"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"So it doesn't hurt to chat a bit more, does it...?","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]}]}
