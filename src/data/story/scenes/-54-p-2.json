{"name":"-54-P-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_20Winter_Chains_Break","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"A choppy voice pierces the darkness and reaches me."}]}]},{"sprites":[],"ops":[],"speaker":"Pavel?","narrator":false,"pages":[{"spans":[{"text":"...It's me, Pavel."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Me","narrator":false,"pages":[{"spans":[{"text":"Pavel..."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"I squeeze the object in my hands. It isn't a warm hand, but a block of cold metal. "}]},{"spans":[{"text":"Cold like a dead body that has lost its warmth."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21winter_avg_mahaline","raw":"BGM"}],"speaker":"Me","narrator":false,"pages":[{"spans":[{"text":"Thank goodness, you're still there... "}]},{"spans":[{"text":"Where should we go next?"}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Pavel?","narrator":false,"pages":[{"spans":[{"text":"...You don't look well. I think you need to charge... to replenish your... "}]},{"spans":[{"text":"To get something to eat, yes, to eat something..."}]}]},{"sprites":[{"prefab":"NPC-SickGirl","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Me","narrator":false,"pages":[{"spans":[{"text":"You're right... 