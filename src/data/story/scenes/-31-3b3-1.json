{"name":"-31-3B3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-Theatre","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pushing open the door reveals a dark and empty theater stage."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The debris all over the ground, the bullet holes scattered across the room, and the pungent smell of burnt flesh all indicate that a ferocious battle took place here not long ago."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Looks like we're alone."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But this is where they last communicated with us. Where have they gone...?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"whiteFlash","raw":"白屏闪光"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It's...Sangvis Ferri! You're from back then..."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"It's been a long time, ditzy young lady. Have you missed me?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Executioner dashes at them from behind with her long blade, but M4 blocks her attack with her weapon case."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before M4 can reply, a swift and accurate burst of bullets forces Executioner to take evasive maneuvers."}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Stay back, M4! Leave this to...whoa!"}]}]},{"sprites":[],"ops":[{"type":"whiteFlash","raw":"白屏闪光"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clash!"}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"An unfamiliar Griffin Doll. What interesting prey. "}]},{"spans":[{"text":"However, Executioner said she wanted to take M4A1's head as a souvenir..."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"...So you mustn't get in the way."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A large amount of Sangvis units come swarming into the theater and start launching a fierce attack under the coordination of the two Sangvis ringleaders."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4A1 and AK-12, now separated from each other, have to fight alone on opposite ends of the auditorium."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Hahahahaha, you've grown a lot stronger, but so have I! "}]},{"spans":[{"text":"It's been a while since I last fought such an exhilirating battle!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I expected this, but their numbers are far greater than I imagined...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If we don't take out the ringleaders soon, we're going to waste a lot of time here...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"There's a hidden passage in this theater that leads where everyone is trying to get to."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Do you know where it is?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"One of the floorboards in the backstage area is hollow."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But if I go in blindly, I could run into even more S.F. and white units..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"And AK-12 is..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"You'll have to go around the Sangvis units. As for the white ones, I can handle them no matter how many of them there are."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"If you want to help your partner, you'll have to trust me. You should also have some faith in your friend."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then...AK-12!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment their eyes meet, Executioner's and Hunter's attacks force them apart and send them running again."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"As if we'd let you join forces."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Why are you running? Fight me fair and square, M4A1!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Backed to the edge of the auditorium, M4A1 stops and turns around. Executioner flashes her a genuine smile."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"That's it! Let's fight until one of us drops dead!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Do it!"}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"bossbattle_loop","raw":"BGM"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A massive explosion goes off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Sangvis forces are blown up into pieces, their debris falling all around like unseasonal snow. "}]},{"spans":[{"text":"The explosion has blasted a large hole on half of the theater wall, dust and rubble come crashing down onto the stage like a landslide."}]}]},{"sprites":[{"prefab":"BOSS-2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Executioner","narrator":false,"pages":[{"spans":[{"text":"Cough cough...! That...was a bomb? When..."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"Watch out, Executioner!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The explosion has thrown Executioner onto the stage. The last image she sees is M4 lifting her weapon case and aiming at her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a deafening boom, Executioner is reduced to ashes along with the stage."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That was trickier than I expected..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Good thing we anticipated the possibility of walking into an ambush and rigged a bomb outside beforehand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Runstep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beneath the decimated stage, M4 finds the entrance to the secret passage and runs up to it."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I'm leaving things here to you!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Go, M4!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"No matter what you want to do, do it!"}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"You think we'll let you have your way?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A heavily-wounded Hunter aims her gun at M4's back, but AK-12 shoots her weapon out of her hands."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"Ugh! "}]},{"spans":[{"text":"You Griffin bastards...!"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Sangvis Manufacture Model SP721, \"Hunter\", isn't it? "}]},{"spans":[{"text":"Actually...I'm not with Griffin. "}]},{"spans":[{"text":"And just like your friend, you will soon pay the price for your ignorance."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
