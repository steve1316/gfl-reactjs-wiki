{"name":"-24-14-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"85","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"flash","raw":"闪屏"},{"type":"duration","value":"5","raw":"duration"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"AHHHHHHHHHHHHHHHHHHHHHHHHHH!","style":{"size":"55"}}]},{"spans":[{"text":"WHY AM I IN A DINERGATE?!","style":{"size":"55"}}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Ugh... What a ruckus... "}]},{"spans":[{"text":"Huh? Am I awake?"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_EV3_Bingocard_loop","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP-II! What's the meaning of this?!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Jeez...that's the only vessel I can keep on my body at all times... "}]},{"spans":[{"text":"So when I saw that Scarecrow didn't want to take it back, I just took it along with me. "},{"text":"(Well, more like kidnapped it). ","style":{"color":"#A9A9A9"}},{"text":" "}]},{"spans":[{"text":"In any case, you'll just have to make do for now. We'll figure out what to do once we get to HQ, okay?"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You lied! This isn't a vessel at all!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Dinergate circuitry is simple. I already pulled out the S.F. circuit boards and the CPU's now linked to my system. "}]},{"spans":[{"text":"Also, while you're speaking through the Dinergate, your neural cloud is linked to my motherboard. "}]},{"spans":[{"text":"If you use your neural cloud too much, I won't be able to think on my end..."}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I don't care! What the hell is this, I look like a complete dork! "}]},{"spans":[{"text":"Why don't you just rip me out of there!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Well, it's a Sangvis product so it's cheap stuff. Bear with it for a while, alright?"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I should just kill myself."}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Think of this as a simulation of how all human beings start out small and become big! Be open-minded!"}]}]},{"sprites":[{"prefab":"RO635","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Ahhhh, seriously, Makarov is going to laugh her ass off when she sees me like this!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That'll have to wait until she actually sees you like this."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Um... I'm sorry, but we don't have much time, so—"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Ah, sorry, Cx4. "}]},{"spans":[{"text":"Er... What did you just say?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"sp