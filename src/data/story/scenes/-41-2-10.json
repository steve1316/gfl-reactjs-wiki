{"name":"-41-2-10","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"272","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bremen, Germany."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Flora Botanical Research Institute. "}]},{"spans":[{"text":"At the back entrance."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I've masked us from the surveillance system."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"What's the security status?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"All clear."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Understood. "}]},{"spans":[{"text":"Restate our objective."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Ange will distract the staff out front. "}]},{"spans":[{"text":"Meanwhile, we will infiltrate the facility and search for clues and evidence of any floral experiments. "}]},{"spans":[{"text":"We are also to investigate William's connection with this institute."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...I will be in charge of the mission. Is that okay with you?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I have no objections."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Actually... "}]},{"spans":[{"text":"If you have a problem with that, we can switch roles."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Only one brain is necessary for the mission. "}]},{"spans":[{"text":"It has already been decided that you will take charge. "}]},{"spans":[{"text":"I do not question that decision."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I don't understand why Ange has put me in charge... "}]},{"spans":[{"text":"You have more field experience than me."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Experience and leadership are different. "}]},{"spans":[{"text":"You are more skilled in command. "}]},{"spans":[{"text":"Past training records have concluded that I am not effective in making tactical decisions. Deferring to your judgment is more efficient."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"You've changed a lot."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I have not changed. I still dislike convoluted strategies. "}]},{"spans":[{"text":"You and RPK are both capable of completing objectives in an efficient manner, which I approve. "}]},{"spans":[{"text":"But 12 is different. As long as AK-12 is not in command, I have no complaints."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"12 always has her reasons."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Which she never bothers to tell us. "}]},{"spans":[{"text":"My dissatisfaction with her stems from her tendency of getting sidetracked by other irrelevant objectives and making our mission unnecessarily challenging."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"But those objectives often end up helping a lot of people."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Her gratuitous compassion could result in the failure of our missions. "}]},{"spans":[{"text":"She may have weighed the odds, but she never justifies her reasons to me. "}]},{"spans":[{"text":"Unlike you, I cannot give her my unconditional trust."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ahem. Will you be alright with just a pistol?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"No problem. Light firearms are better suited for infiltrations. "}]},{"spans":[{"text":"Besides, my own rifle is right here in the case."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Right. I will provide fire support when needed."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Please."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ange is entering the greenhouse."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"What are our engagement protocols?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Secrecy is paramount. No explosives at any cost. "}]},{"spans":[{"text":"Also try to avoid opening fire if at all possible."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Roger that."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 tugs at her tactical gloves and presses herself against the wall. "}]},{"spans":[{"text":"The two Dolls are breaking into the building through an emergency exit. "}]},{"spans":[{"text":"There are four such exits altogether at the Flora laboratories. "}]},{"spans":[{"text":"AN-94 has chosen this particular one because she believes it is the safest option."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"There's a safety lock."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Can you break it?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 wraps her hand around the lock and tears it right off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sound of metal rupturing is short and sharp."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Go."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Hush."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On their way in, AN-94 gestures for AK-15 to stop."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...What is it?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"According to Ange's topographic map, we'll soon be entering the restricted area. "}]},{"spans":[{"text":"There will be researchers and security staff. "}]},{"spans":[{"text":"Scan for life forms."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I have, but I'm not detecting anyone."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The scanner isn't picking up anyone? "}]},{"spans":[{"text":"But the map shows that the working area is right there."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I'm not seeing any life signs at all, not even plants."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Let's get inside and have a look. "}]},{"spans":[{"text":"Can you see any entrances? "}]},{"spans":[{"text":"Try not to let any security cameras capture you."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Hold on."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"This wall is way too thin."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 walks over to the corner. "}]},{"spans":[{"text":"Her eyes glow red as she scans the space. Then she activates a mechanism hidden at a desk."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clatter..."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...A hidden door?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Should we go in?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Yes. "}]},{"spans":[{"text":"Stay vigilant and watch your surroundings."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"There is such a large subterranean structure. "}]},{"spans":[{"text":"I didn't notice it at all."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"You would've spotted it if you had my eyes. "}]},{"spans":[{"text":"Even without them, it would only be a matter of time for you to discover this place with your experience."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...Am I imagining things? "}]},{"spans":[{"text":"You seem a bit too eager with your encouragement."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I never encourage others. Encouragement itself is pointless. "}]},{"spans":[{"text":"I am merely stating facts. You are an excellent operative, AN-94. "}]},{"spans":[{"text":"And we will accomplish our mission. That's all there is to it."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...You're too kind, but you really don't have to baby me. "}]},{"spans":[{"text":"I'm not the way I used to be. "}]},{"spans":[{"text":"Wait... Look, over there."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perhaps in an attempt to change the subject, AN-94 suddenly directs her attention to what lies ahead. "}]},{"spans":[{"text":"In the center of the room is a large amount of something very familiar to them."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...Epiphylla."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"In vast quantities. "}]},{"spans":[{"text":"Where's the radiation detector?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Scanning for radioactivity. "}]},{"spans":[{"text":"These flowers contain a high concentration of radioactive particles."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"So Ange was right..."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"And the containers. "}]},{"spans":[{"text":"Looks like these flowers are about to be packed and transported."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The flowers the Commander has discovered must have originated from here."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"What do we do?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Don't alert them just yet. "}]},{"spans":[{"text":"Let me report this to Ange."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Right."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 takes several steps forward, ready to investigate further."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Stop."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Hush."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 gestures for her to keep quiet. Then she creeps carefully up to the corner and stoops."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Someone's there."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 clams up and makes her way rapidly to another spot for better observation."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"There are a lot of them, and they're all armed. "}]},{"spans":[{"text":"But they show no signs of having noticed us."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"They probably did not expect anyone to venture so deep into the facility. "}]},{"spans":[{"text":"Stay hidden...and avoid a direct confrontation for now."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"I believe that would be difficult."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Even for a restricted facility, they are a bit too well-armed. "}]},{"spans":[{"text":"They look more like a quick reaction force lying in ambush than regular security staff to me."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ambush?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The realization strikes AN-94 immediately."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I see... "}]},{"spans":[{"text":"They're here for Ange."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Looks like Ange was correct. "}]},{"spans":[{"text":"However, her visit was arranged at very short notice. "}]},{"spans":[{"text":"If Ange really is the target of this ambush, then they've been extremely quick."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"This is the only possible explanation at the moment. "}]},{"spans":[{"text":"Even if I'm wrong, we must still inform Ange ASAP."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"Understood. I'll cover you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AK-15 crouches down an