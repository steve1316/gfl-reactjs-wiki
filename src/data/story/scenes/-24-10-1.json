{"name":"-24-10-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click."}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Good afternoon.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Although I don't know what time it is. You don't mind, do you?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"So, have you come to surrender?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Scarecrow, I've come to bargain.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Under the present circumstances, we need to quietly...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"There is no value in allying with you."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Allying? No, of course not! What are you thinking?!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"...?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I know you took our stuff. But that's fine, we don't need it. Except for one thing.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I just want a single Griffin auxiliary power supply. Just one.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Give it to me, and we'll let you go. We'll both withdraw. How about that? It's a good deal, right?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"That's assuming you can be trusted."}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'll go to your base to get it, and I won't be armed.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"You know that they can't operate as an independent group if I'm not with them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"Of course I know that. They were just a disorganized rabble before. "}]},{"spans":[{"text":"Still, aren't you worried I'll take this opportunity to open fire and attack your position?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Then I'll guarantee this...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Before you can open fire, I'll use your lackey's hand to rip off that ugly mask of yours and gouge out one of your eyes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then make it quick. Let's get it done before the Military attacks again."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"shake","raw":"震屏"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"SOP-II, are you really going onto the battlefield? There's Military units everywhere!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Their main force hasn't arrived yet. I'm confident I can pull this off, but I'll need the help of a few T-Dolls."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Our lives are yours. Take your pick."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Right! I want these ones. Everyone, pack up, we're moving out right away!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Will you be back? I mean...they're S.F., after all, and it's very likely that..."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Scarecrow will keep her word, for her own sake and for her friends'. She has no choice."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Would Sangvis Ferri... do things for their friends, too?"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Yes, they do. Nobody in Griffin understands them better than me."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"(Chuckles) Did you learn that from torturing them?"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"We've made contact in various ways."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"I'm surprised you're a friend of ours."}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"That's exactly why I'm a friend of yours. Cx4, hold the line for the time being. I'll be back right away! "}]},{"spans":[{"text":"Let's go, everyone. We're going to avoid the Military units and conduct peaceful negotiations with Sangvis Ferri! "}]},{"spans":[{"text":"Not every Griffin T-Doll gets the chance to do this, especially with me around, so come with me!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
