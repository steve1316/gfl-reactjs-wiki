":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What..."}]}]},{"sprites":[{"prefab":"清澈的女声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Clear female voice","narrator":false,"pages":[{"spans":[{"text":"\"I'm attempting to break her seals...\" "}]},{"spans":[{"text":"That's what the woman said, and now you can think about a lot more things – thoughts you wouldn't have in the past."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I don't know how to think..."}]}]},{"sprites":[{"prefab":"清澈的女声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Clear female voice","narrator":false,"pages":[{"spans":[{"text":"That's why I'm here...to save you."}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I don't need you to save me... "}]},{"spans":[{"text":"I don't need you at all! Get OUT!"}]}]},{"sprites":[{"prefab":"清澈的女声","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Clear female voice","narrator":false,"pages":[{"spans":[{"text":"I can see it's not time yet. "}]},{"spans":[{"text":"Do some introspection, Tactical Doll M4A1, while you still have the chance. "}]},{"spans":[{"text":"Don't make your choice when it's all too late..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The voice disappears."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"M16... "}]},{"spans":[{"text":"I must have faith in her...and believe that she's stronger than me... "}]},{"spans":[{"text":"She'll come back... She definitely will..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":fals