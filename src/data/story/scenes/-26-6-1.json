{"name":"-26-6-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"BG-ContaminatedZone","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Task Force DEFY has finally found the mark left by the rescue team!"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Surpriiiiise! "}]},{"spans":[{"text":"Ahahaha! We finally found you, DEFY!"}]}]},{"sprites":[{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"If your movement had been just a little swifter than your utterance, I would have identified you as a hostile target and attacked."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Sorry, this is M4 SOPMOD II of the AR Team. SOP-II, meet AK-12 and AN-94 of Task Force DEFY. I'm 416. You've all met me."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"I do not particularly want to see you again, but it cannot be helped."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Right, this isn't the time to deepen our bond. Let's get straight to the point - where is Ange, and how is she?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...AN-94 looks behind her and finds an unconscious Ange draped on AK-12's back."}]}]},{"sprites":[{"prefab":"AN94","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ange...she—"}]}]},{"sprites":[{"prefab":"AK12","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"A few minutes ago...she took a heavy dose of radiation and passed out. "}]},{"spans":[{"text":"It took us a while to find the mark, but her life isn't in danger. However, she'll be sitting out the coming battles. It'll be just us."}]}]},{"sprites":[{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What a shame. Guess I'll have to say hi some other time. "}]},{"spans":[{"text":"Still, it's not \"just us\". We also have the Commander and the HOCs."}]}]},{"sprites":[{"prefab":"AN94","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"What...HOCs?"}]}]},{"sprites":[{"prefab":"SOPIIDamage","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Our new toys! They're giving us long-range support and specialize in fighting tanks! You'll love them!"}]}]},{"sprites":[{"prefab":"AK12","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Then we're safe for now. Let's figure out what to do next."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"The contamination index is significantly lower here. Though Ange is not entirely out of danger, her life is not under any immediate threat."}]}]},{"sprites":[{"pre