:[{"spans":[{"text":"Everyone puts their hands up in the air as the gaping muzzles sweep over them."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_h","raw":"SE1"},{"type":"background","value":"539","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Broken_Glass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a thunderous bang, the crystal glasses on the bar counter shatter and scatter their shards all over the floor."}]}]},{"sprites":[],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"Aaaah!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_People_Panic","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even Susanna, who has seen her fair share of things, can't help but let out a yelp. "}]},{"spans":[{"text":"Meanwhile, the passengers, who can't keep their terror in check, let out another scream. "}]},{"spans":[{"text":"However, this perfectly harmless reaction is enough to draw the ire of the burly thug named Danil, who immediately trains his gun on them."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the vacuous black muzzle sweeps over them, the weeping men and women swallow their whimpers and wails."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"528","raw":"BIN"}],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"Dolls to Carriage 10, humans to Carriage 8. "}]},{"spans":[{"text":"Leave all your jewelry on the tables and open your luggage."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Once Susanna overcomes her initial shock, she suddenly comes to a horrifying realization. She looks up at the old woman before her and stutters incoherently."}]}]},{"sprites":[{"prefab":"NPC-TD_Porter","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"Ba-ba-ba...Baba Lyuba?! "}]},{"spans":[{"text":"The last of the Neo-Soviet Union's V—"}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"...The botrytized wine that you prepared was to my taste. "}]},{"spans":[{"text":"You should know what to do next, right?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susanna gulps and swallows the words she's about to say. "}]},{"spans":[{"text":"She only speaks again after a long moment of hesitation."}]}]},{"sprites":[],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The passenger manifest is in the workroom."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"Very good. You're a clever girl."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The fragile-looking granny seems to have undergone a complete change. Standing on the armrests of her own wheelchair, she pulls out a frightening gun in each hand and cackles. Her ghastly laughter, so utterly discordant with the elegant background music, sounds almost like a dirge."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Behind her, armed gangsters enter the room in an orderly fashion."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine, who has remained motionless ever since the Vory barged in, is cowering in front of the bar with her head lowered."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Maggie... What should I do...?"}]}]},{"sprites":[],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie remains slumped over the table, completely still."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"420","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"In the restroom of Carriage F09 (Dining Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_h","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"bgm","value":"BGM_stage10","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Upon hearing the deafening gunshot, the two Dolls locked in a stalemate immediately exchange looks."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"It's very noisy out there. Did something happen?"}]}]},{"sprites":[{"prefab":"AR18","expression":4,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"That was a gunshot."}]}]},{"sprites":[{"prefab":"AR18","expression":4,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Murder?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"I can't be sure. They are armed with quite a few shotguns. The models are also varied. "}]},{"spans":[{"text":"From what I've heard, it sounded like a Super-Shorty and an M500..."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You're also armed. Are you with them?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...No."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Then answer my questions about Hume. "}]},{"spans":[{"text":"You've been coming at me since I mentioned this surname on the Colt Express. "}]},{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}},{"prefab":"Erma","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...I cannot tell you."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila closes her eyes and concentrates on her hearing. "}]},{"spans":[{"text":"...There are a lot of armed hostiles out there. How did they manage to bring so many weapons on board?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Seven... eight... There are a total of 12 intruders, one of which is in a wheelchair."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila recalls the old woman she saw in the carriage she was in earlier."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...I know who they are."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"The last Vory v Zakone in the Neo-Soviet Union... "}]},{"spans":[{"text":"They live off any kind of crime imaginable, which naturally includes robbery."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lyudmila pauses."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...Also, they don't tend to leave survivors in their robberies."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...You could tell so much just from listening?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"While Lyudmila is deliberating, an unfamiliar comms signal suddenly contacts both of them."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They glance at each other and take the call in unison. "}]},{"spans":[{"text":"A familiar voice speaks through the channel."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":