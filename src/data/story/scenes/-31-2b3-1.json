"prefab":"AN94","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Mercurows","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"It's M16A1. "}]},{"spans":[{"text":"They're targeting the White Faction. This is our chance. "}]},{"spans":[{"text":"AR-15, I managed to get you over here. "}]},{"spans":[{"text":"Sangvis Ferri seems to have disabled the interference caused by the White Faction, so we now have access to comms. "}]},{"spans":[{"text":"I'll conduct some basic repairs on you, and you can contact Ange through a secure channel."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Thanks... I've accepted your connection request. "}]},{"spans":[{"text":"Ange, do you copy?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"AR15Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I'm receiving you. Is it done, AR-15?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Sorry Ange, I located the Node, but it isn't going well at all!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Things are rapidly getting out of hand. I've sent you our location. Sangvis Ferri has engaged the White Faction in battle with M16 in command. I'm afraid we're going to have to fight whoever is left after this fight...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mercurows","narrator":false,"pages":[{"spans":[{"text":"\"Nothing can save you from the precipitous fall. From the precipitous fall can nothing save you!\" "}]},{"spans":[{"text":"You're nothing but specters that wander in darkness... No one can stop me! "}]},{"spans":[{"text":"I will triumph...and get what I deserve!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Unfamiliar S.F. Doll","narrator":false,"pages":[{"spans":[{"text":"Hahahaha! What on earth is that strange human going on about?! Hey, work harder and just tear her apart already!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"M16...? Sangvis Ferri...?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"What a messy situation. Alright, things aren't looking too good on our end either, but we'll send reinforcements to you ASAP.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Hang in there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I hope you won't be greeted by our dead bodies by the time you make it here... We'll be counting on you!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sparkOff","raw":"关闭火花"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"AR-15...AN-94. Mercurows. M4 isn't here. "}]},{"spans":[{"text":"I'd better hurry... "}]},{"spans":[{"text":"I must find it before \"that thing\" does!","style":{"color":"#A9A9A9"}}]}]}]}
