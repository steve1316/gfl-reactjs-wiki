[{"spans":[{"text":"Will do.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Erma, verify everyone's connection stability.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":14,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Roger."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR18","expression":3,"shown":true,"side":"left","tags":{"spritePosition":"0,120"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"2019summer_7","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander, I've just received a comms request from Miss Persica."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Put her through now!"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Commander, I received a signal from Strongarm 17.34 seconds ago.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How's Ange?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Give me a few more seconds, I'm decoding the info.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Tsk...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is she alright?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"She's still alive.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's good..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"But she isn't that far from becoming a corpse.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Her heart rate, respiratory rate, body temperature... They're all a mess.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How much longer can she hold out?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"A normal person can last about two hours at most.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages"