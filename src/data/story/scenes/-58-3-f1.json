fab":"Erma","expression":18,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Alright, you're up, Commander!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander, who has been watching from the side for a while, begins to speak."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Give me a sitrep.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"We've finished clearing out the enemies and recovered Unicorn. We're currently stationed in a temporary signal station to the north of Avernus.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How is Unicorn doing?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"We've recovered 9's core, but we had Dandelion make a backup just to be safe.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"45 can still continue operations, but she has requested to join us.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"45?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"UMP45","narra