:"NPC-William","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William (?)","narrator":false,"pages":[{"spans":[{"text":"Hold them off for two more hours.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}},{"prefab":"NPC-William","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}},{"prefab":"NPC-William","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"William (?)","narrator":false,"pages":[{"spans":[{"text":"Permission to activate the \"Gatekeeper of Hell\"?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"...Granted."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"The call ends."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nemhran takes a deep breath."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"In 30 minutes' time, activate the \"Gatekeeper of Hell\"."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Roger!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]}]}
