{"name":"-58-3-F4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"448","raw":"BIN"},{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...On the platform outside the Western Tower, Avernus."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"More and more Nytos march out of the Western Tower entrance. They march over the burning debris, circle around the smoking, smoldering platform and head for the Eastern Tower. "}]},{"spans":[{"text":"Architect and Gager are collapsed on the ground near a chunk of debris that they were using as cover, their bodies ruined and their eyes dull. "}]},{"spans":[{"text":"Narciss lands near their remains, a maniacal grin on her face."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clang. Gager is sent flying by a kick. She hits the charred wreckage of an aircraft and crashes back down to the ground, throwing up a plume of dust."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The floating blades rise and dive at their target like scalpels, flaying Architect's bionic flesh and exposing her metallic endoskeleton and innards."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Tinnitus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Despite the lack of response, Narciss seems to get more and more enthused. The floating blades trail afterimages behind them as they noisily dismember Architect."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Creeeeak... Metal scrapes against metal, producing a harsh noise. One of the floating blades seem to have gotten stuck."}]}]},{"sprites":[{"prefab":"Narciss","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Architect's body has been mutilated beyond recognition, but her synthetic spine is surprisingly tough and one of the floating blades is stuck between two of the vertebrae, unable to respond to Narciss' commands."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Furious, she turns on the Nytos who are cowering by the edge of the platform."}]}]},{"sprites":[{"prefab":"Narciss","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"Nyto","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"...Y-yes... Big Sister Narciss..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Nyto trembles as she approaches the quivering blade stuck in Architect's spine... "}]},{"spans":[{"text":"But despite using all her strength, she cannot pull it free."}]}]},{"sprites":[{"prefab":"Nyto","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, Big Sister Narciss..."}]}]},{"sprites":[{"prefab":"Narciss","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Narciss explodes in anger and her floating blades sweep across the platform like a tornado, shredding the equipment stashed there, along with several luckless Nytos. "}]},{"spans":[{"text":"The remaining Nytos on the platform fall on their knees, while the ones at the Western Tower entrance hang back timidly."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tinnitus_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whum... The floating blades suddenly freeze in their tracks."}]}]},{"sprites":[{"prefab":"Narciss","expression":1,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Narciss' anger grows, but her blades remain frozen in the air."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Phone_Crash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Crash! In the next moment, several of the hitherto invincible floating blades disintegrate into powder, which falls to the ground in full view of an incredulous Narciss."}]}]},{"sprites":[{"prefab":"Narciss","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[]