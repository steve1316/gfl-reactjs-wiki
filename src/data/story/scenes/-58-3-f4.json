":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Level 12 Control Room","narrator":false,"pages":[{"spans":[{"text":"Big Sister Ashley, energy conduits on level 12 are connected.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Level 14 Control Room","narrator":false,"pages":[{"spans":[{"text":"Big Sister Ashley, we're adjusting the energy conduits on level 14. Connection will be established in approximately three minutes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"34 floors have reported their energy transfer status. Only level 19 has not checked in yet."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Level 19?"}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Level 19 Control Room","narrator":false,"pages":[{"spans":[{"text":"...Ashley, they're going to mature soon, so we can't transfer power now.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We have three specimens with excellent data in this batch! Please give us another eight hours—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Carry out your orders—that's all you need to do."}]}]},{"sprites":[],"ops":[],"speaker":"Level 19 Control Room","narrator":false,"pages":[{"spans":[{"text":"What—Urk...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A splattering noise comes through the comms. After a brief pause, a soft voice speaks over the line again."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Level 19 Control Room","narrator":false,"pages":[{"spans":[{"text":"Big Sister Ashley, the energy conduits on level 19 are being adjusted. Connection in approximately eight minutes.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Good. Once the connection is complete, have everyone on your floor proceed to the Eastern Tower main hall and stand by."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ashley rises to her feet the moment Nemhran enters the control room."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The screen depicts a 3D rendering of the Western Tower. 34 lines representing energy conduits light up. They work their way up through each floor until they all gather at level 35."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Big Sister Nemhran, the power lines from all the production lines in the Western Tower are connected to level 35. "}]},{"spans":[{"text":"The conduit on this floor is now active. It will be fully charged in about 120 minutes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nemhran nods. "}]},{"spans":[{"text":"Ashley observes Nemhran as she continues tentatively."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"Having 34 power lines simultaneously patched into here might overload the production capacity of the Western Tower... The subsequent repairs might..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"How long will it take?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her tone is cold as ice and brooks no argument. Ashley's voice drops to a whisper."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ashley","narrator":false,"pages":[{"spans":[{"text":"...At maximum capacity... it'll only take 30 minutes, but none of the production lines will be salvageable afterwards..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,30"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"30 minutes it is, then."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ashley winces. She walks up to the control terminal and flips a number of switches."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Shield_Startup","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The charging progress bar on the screen suddenly leaps forward and the lines representing the power conduits shine brighter, while level 35 starts glowing like a blazing star. The faint humming of circuits overloading can be heard even here in the control room."}]}]},{"sprites":[],"ops":[],"speaker":null,"narra