,"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Alright.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK15MOD","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...I demand an explanation.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod#隐身","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Remember that game we once played?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"It was also a snowy Halloween.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In that game of \"Find the Ghost\", the word you got was \"Ange\", wasn't it?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...Yes, but how is that relevant?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod#隐身","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...I also got \"Ange\".","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'll explain everything once this is all over.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK15MOD","expression":5,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...We agreed I'll be the one to end her.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod#隐身","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It is my duty as the \"Alpha Wolf\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK15MOD","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AN94MOD","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"15...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You've already questioned her once. She won't give you the answers you seek.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AK15MOD","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang-bang-bang!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 and AK-15 start making for the exit of the Alte Oper."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With the withdrawal of the two DEFY members, the spacious and battered theater grows still and quiet again. "}]},{"spans":[{"text":"All that's left in here are several erect fire barriers, Embla, who is nowhere to be seen, and AK-12, who is lurking in the shadows."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"Campaion-70","raw":"BGM"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh. "}]},{"spans":[{"text":"The curtains are drawn once more."}]}]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"sfx","value":"AVG_21Winter_Open_Light","raw":"SE1"},{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"BG-Theatre","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Snap—a followspot shines upon the stage. "}]},{"spans":[{"text":"Embla is captured in a harsh beam of light."}]}]},{"sprites":[{"prefab":"NPC_Embla_RPK","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"The Devil was but an angel once, and angels, in their time, shall fall to devilry. "}]},{"spans":[{"text":"The barter of the human soul drifts upon the tides of desire, rising and sinking with its restless waves. "}]},{"spans":[{"text":"My companion, you ask whither we now tread— "}]},{"spans":[{"text":"My journey ends here, this day, in this very hour, for my return lies in the eternal now."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_The_Division_Grenade","raw":"SE1"},{"type":"cgDelay","value":"1.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Embla's eyes glisten as she sings with great emotion, paying no heed to the few spherical objects lobbed at the stage."}]}]},{"sprites":[{"prefab":"NPC_Embla_RPK","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"And you—nowhere may you go, for this world has long since cast us out, leaving no place for our weary souls to dwe—"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Bullet_Hit_Body","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Embla can finish her final phrase, a 5.45x39mm round tears through the air and hits her in the chest—where her neural cloud would have been."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"cgDelay","value":"0.1","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"},{"type":"cgDelay","value":"0.2","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_pistol_finalshot_n","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Almost at the same time, Embla raises her pistol and fires several successive shots in the direction of her attacker. "}]},{"spans":[{"text":"She seems to have hit something... or maybe not."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_lifttable","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=5%%delay=0.1%%range=4","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Following her gunshots, the chandelier shatters into a million pieces that rain down on the auditorium in a crystalline cascade. Then finally, like a rose pulverized by a rainstorm, the entire light fixture crashes to the floor— "}]},{"spans":[{"text":"Embla lifts her face toward the sky with a radiant and expectant smile, completely oblivious to the red that has spilled all over her dress..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0.1%%range=5","raw":"controll_shake"},{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! Boom! The fragmentation grenades thrown onto the stage explode simultaneously, pushing the opera to its climax."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AK12Mod#隐身","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"gradientShow","value":"2","raw":"GradientShow"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"1","raw":"CGDelay"}],"speaker":"AK-12","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-AK12Mod#隐身","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_TalesofTheBlackFreighter","raw":"BGM"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You will meet your end today. Right now."}]}]},{"sprites":[{"prefab":"NPC_Embla_RPK","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"I have been waiting for this moment the whole time."}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"effect","value":"%%code=2024074_RPKDeath%%","raw":"common_effect"},{"type":"cgDelay","value":"7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Through the thick, billowing smoke, AK-12 draws her sidearm and walks up to Embla on the stage."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She shoves its muzzle right against Embla's forehead."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...I really can't stand you."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"That's only natural. You SHOULD hate me. "}]},{"spans":[{"text":"After all, I'm neither as useful as 15 nor as obedient as 94."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"And yet, you still transferred something as important as the command authorization of Task Force DEFY to me. "}]},{"spans":[{"text":"Have you been regretting this decision day and night since you left Avernus?"}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's right. Even now... "}]},{"spans":[{"text":"I still don't understand your actions."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"That can't be true, AK-12. "}]},{"spans":[{"text":"You understand what I'm trying to achieve better than anyone else."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Don't be ridiculous."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Because what you're about to do... and what I'm doing... "}]},{"spans":[{"text":"...Are one and the same. "}]},{"spans":[{"text":"We are walking down the same path, 12."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm not like you. "}]},{"spans":[{"text":"I will never make a deal with the Devil."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Just as Ange was not like Shaw. "}]},{"spans":[{"text":"Ange didn't mind getting her own hands dirty. "}]},{"spans":[{"text":"So that you can maintain your moral high ground."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Save it. Your sophistry doesn't work on me."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Really?"}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"94 and 15 have been lured away by your little diversion. "}]},{"spans":[{"text":"Feel free to continue."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"That just shows how well you know me, doesn't it? "}]},{"spans":[{"text":"So, are you ready? "}]},{"spans":[{"text":"This final ending scene can't be performed solo."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"One of the reasons I still walk this earth..."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...Is to kill you."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Hm, that expression is on point, 12. "}]},{"spans":[{"text":"It is absolutely perfect for this stage... this performance... this dramatic stand-off between you and me."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"3","raw":"CGDelay"},{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"},{"type":"effect","value":"%%code=202407_AK12%%","raw":"common_effect"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"I don't think I've ever seen you so angry."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.6","raw":"CGDelay"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Bit of a shame that Ange never got to see it."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Back then... why did you take my neural cloud? "}]},{"spans":[{"text":"...Why did you betray Ange...?"}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Haven't you figured it out already? "}]},{"spans":[{"text":"I was given orders by the Earl even before we went to Bremen— "}]},{"spans":[{"text":"To infiltrate Avernus and bring back Paradeus' secrets."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That's not the answer."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"There really is no deceiving you."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"During that game, you were the \"ghost\". "}]},{"spans":[{"text":"Your word was \"Shaw\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Embla smiles."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"AK-12, out of everyone in Task Force DEFY, you really are the one who knows me best. "}]},{"spans":[{"text":"I would love nothing more than to chat with you a little longer, but our time is sadly running out. "}]},{"spans":[{"text":"Now, let's finish this little Easter egg I've placed in the play—the real climax of the show..."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"black","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"\"Pandora\"."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=AVG_xiaxue%%","raw":"common_effect"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"2022saros_CyberCityStreet","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Large display screen, Roemerberg, Frankfurt District."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_SFX_chant","raw":"BGM"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"...Through me you pass into the city of woe, "}]},{"spans":[{"text":"Through me you pass into eternal pain, "}]},{"spans":[{"text":"Through me among the people lost for aye."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"...Justice the founder of my fabric mov'd, "}]},{"spans":[{"text":"To rear me was the task of power divine, "}]},{"spans":[{"text":"Supremest wisdom, and primeval love. "}]},{"spans":[{"text":"Before me things create were none, save things eternal, "}]},{"spans":[{"text":"And eternal I endure."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"...Love led us to one life. "}]},{"spans":[{"text":"Love led us to one death."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The repeating chant comes to an end."}]}]},{"sprites":[],"ops":[{"type":"whitescreenOn","raw":"白屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"background","value":"202407_RPK_TV_b","raw":"BIN"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzzt... The large screen flickers back to life."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Hume_ImFutue_Main","raw":"BGM"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Good evening, ladies and gentlemen, and Happy Halloween. "}]},{"spans":[{"text":"Please indulge me as I play a little Halloween trick."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Embla smiles. "}]},{"spans":[{"text":"The smile can be seen not only in Roemerberg, but also on the large display screen in the Roemer itself. "}]},{"spans":[{"text":"As well as on the feed of all major television broadcasting stations."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Allow me to introduce myself—I am Angelia, a special agent of the Neo-Soviet Union. "}]},{"spans":[{"text":"I am also RPK-16, a tactical Doll created by Doctor Samantha Shaw."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"background","value":"202407_RPK_TV_c","raw":"BIN"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"But now, I have decided to name myself Embla Petrovskaya."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202407_RPK_TV_a","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"Because I have been reborn."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"And I have gained immortality."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"19winter_inbg_2","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"...Good, she has completed our mission. "}]},{"spans":[{"text":"The moment is finally upon us."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Something's not right! Look, she's bleeding!"}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"...Haven't Task Force DEFY been drawn away...?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"One of them stayed behind."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202407_Embla","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"I have a face that will never be ravaged by age... "}]},{"spans":[{"text":"A constitution far superior to an ordinary human's... "}]},{"spans":[{"text":"And a heart that is forever young."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Embla's serene smile never wavers even though her body is drenched in blood. "}]},{"spans":[{"text":"Blood pumping from her heart."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"...The technology that has made me thus... "}]},{"spans":[{"text":"...Came from the Relics. "}]},{"spans":[{"text":"It is truly a miracle."}]}]},{"sprites":[],"ops":[],"speaker":"Embla","narrator":false,"pages":[{"spans":[{"text":"It was I who killed Shaw. "}]},{"spans":[{"text":"It was also I who killed Angelia. "}]},{"spans":[{"text":"Because they were opposed to introducing such great technology to the world."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Because they knew that the Relics are a gift from the Devil. "}]},{"spans":[{"text":"They are \"Pandora's Box\", whose opening would be the original sin that leads to the fall of man."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.6","raw":"CGDelay"},{"type":"sfx","value":"AVG_rifle_finalshot_n","raw":"SE1"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot rings out, and a fountain of blood spurts out of the woman named Embla."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"background","value":"202407_AK12_TV","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The camera wobbles and shifts until it focuses on another blood-soaked face."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"...The desire to steal fire was man's original sin."}]}]},{"sprites":[],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"This is AK-12, a tactical Doll created by Samantha Shaw. "}]},{"spans":[{"text":"These are Shaw's last words—"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzzt... "}]},{"spans":[{"text":"An audio recording starts playing..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"I'm against using Relic technology of any sort. It will inevitably become the weapon that humanity uses to bring about its own demise.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The sad thing is... I'm a human myself.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.6","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
