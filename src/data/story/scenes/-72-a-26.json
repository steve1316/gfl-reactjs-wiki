{"name":"-72-A-26","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_2022_Summer_Battle_1","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"778","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Inside the industrial park, Offenbach District."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh... whoosh..."}]},{"spans":[{"text":"On the desolate streets, several news vans speed past, all heading in the same direction."}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0%%range=2","raw":"controll_shake"},{"type":"sfx","value":"AVG_brake","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Screech."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After bringing their vans to a crisp halt, the reporters quickly disembark to secure the best filming spots. Almost simultaneously, over a dozen uniformed Stasi agents begin moving in and out of a factory, carrying out sealed crates and placing them right within the cameras' line of sight."}]},{"spans":[{"text":"Everything is perfectly timed—like the opening scene of a meticulously staged play."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Reporter","narrator":false,"pages":[{"spans":[{"text":"I am now standing inside the Offenbach Industrial Park. Behind me is a factory that has been closed for several months due to poor management. Before its shutdown, this factory mainly produced electric wheelchairs and other rehabilitation equipment."}]},{"spans":[{"text":"According to sources, the production line was reactivated a few days ago—but this time, what's coming off the belts isn't medical gear, but devastating weapons..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The camera shifts to where the reporter is pointing—sealed crates being hauled out by the agents."}]}]},{"sprites":[],"ops":[],"speaker":"Reporter","narrator":false,"pages":[{"spans":[{"text":"The Stasi has now shut down this factory, along with seven others in the Offenbach Industrial Park, on charges of illegal manufacture of explosives, endangering public safety, and treason."}]},{"spans":[{"text":"All these factories were secretly producing a weapon known as \"Iaso's Box\"."}]},{"spans":[{"text":"There is concrete evidence linking this weapon to the Berlin bombing months ago, as well as the recent series of explosions in Frankfurt."}]},{"spans":[{"text":"According to a Stasi spokesperson, the factory manager is already in custody. Interrogation is underway. We will continue to follow the story closely."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"All of a sudden, a commotion erupts behind the reporter—an uproar from the gathered crowd."}]},{"spans":[{"text":"The camera immediately follows—"}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the distant factory, several medics emerge carrying a stretcher. A man lies on it, his face covered."}]},{"spans":[{"text":"From the blood dripping from his limp arm, it is clear that he has suffered horrific abuse."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Close","raw":"SE1"},{"type":"fadePoint","raw":"黑点2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"background","value":"202","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The car door slams shut, cutting off the reporters' clamoring."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q casts a cold glance at the motionless man on the stretcher. As the vehicle starts, the stretcher begins to jolt slightly."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"How long are you planning to keep up the act?"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Swish. The man on the stretcher sits up, yanking off the cover from his face and disgustedly wiping away the fake blood on his arm."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":9,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Verdammt noch mal! What took you so long to get me out?"}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":12,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Do you have any idea what I've been through these past days?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q takes a sip from the now-cold coffee in hand with a frown."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Just be grateful. Nobody had any plans to rescue you. If the Commander hadn't come up with a perfect plan, the next agent codenamed J would've already started the job."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":14,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":14,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Right, don't forget to send one last message to Frau "},{"text":"Nele","style":{"color":"#00CCFF"}},{"text":", who's been looking after you."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"J","narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Frau Nele who?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":11,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Maybe try polishing up your terrible acting."}]},{"spans":[{"text":"Once we're back at HQ, all your personal contact channels are getting deleted."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":9,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Wasn't I getting a commendation?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":9,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"That was all for show. You really bought into it, \"Hero Agent J\"?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J snatches the new communicator from Q with a scowl."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_2","raw":"BGM"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"685","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander receives intelligence transmitted back from Task Force DEFY."}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"We've acquired complete intel on the new Nyto. Her codename is \"Hebe\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Also, bad news—aside from this Hebe, there's another high-level Nyto lurking in Frankfurt. No specifics yet.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AK12Mod","expression":11,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Almost there... Once we have intel on her, we can prepare for the final sweep."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as the communicator is put down, it rings again."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Drink_Tea","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-18 brings over another cup of coffee."}]}]},{"sprites":[{"prefab":"AR18","expression":3,"side":"left","tags":{"Position":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander, it's a call from Mr. Kryuger."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Kryuger?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander picks up at once."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Mr. Kryuger?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Yes, it's me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Finally, a call from you..."}]},{"spans":[{"text":"Does this mean you and Helian are safe?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Yes, we've been released.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's great news!"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"The Earl told me you and the Stasi took down Paradeus' Project Cocoon...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, their leader Laplace has been eliminated. Only William remains..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"...Commander, we're so proud of you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Once we finish off William and the remnants of Paradeus, I'll come get you both home."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Home...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Let's rebuild Griffin together, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Even though the fire at the base burned for days, leaving almost nothing of the surface buildings...","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"The good news is that it's finally burned out.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"It's the perfect time to rebuild. Now we can construct the new Griffin base exactly how we envision it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Commander, I want to invite you to join us—not as an employee, but as family.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Looking out at the silent night, the Commander feels a calm unlike anything before."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Nothing would make me happier, Mr. Kryuger."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"412","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. Q walks into Romy's office."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment she enters, a cup of coffee is shoved into her hand."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Congratulations, Agent Q. Another impressive achievement."}]},{"spans":[{"text":"This cup's on the Director."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Thanks, ma'am. Finally got you to buy me a coffee."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Help yourself to as much as you like. But about that vacation—I'm afraid you'll have to wait."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Don't worry. I know the drill."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q hands over a neatly prepared report to Romy."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"This operation seized a large batch of Paradeus products, including components, weapons, and Iaso' Boxes... A detailed inventory is attached."}]},{"spans":[{"text":"We've also secured all production lines of the Iaso's Box. Some were damaged. The condition of each line is listed in detail."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"And—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Q can finish, Romy removes the paperclip and pulls out a few pages, laying them on the desk."}]},{"spans":[{"text":"Q glances at them—it's the report on Paradeus' top-secret lab codenamed Cherry Orchard."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_PPT_Switch","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hoffmann, who has been standing off to the side, casually takes the pages and feeds them into the shredder."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Ma'am, do these need editing or—?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Make no mention of them."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"I see."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy hands the rest of the report back to Q."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Someone else will take over from here."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"772","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nemhran pushes open the office door."}]}]},{"sprites":[],"ops":[],"speaker":"Friedrich","narrator":false,"pages":[{"spans":[{"text":"Welcome to the office of the Chairman of the Socialist Unity Party. How—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The secretary's eyes widen."}]}]},{"sprites":[],"ops":[],"speaker":"Friedrich","narrator":false,"pages":[{"spans":[{"text":"Why are you here...? The Chairman..."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"side":"left","tags":{"Position":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Relax. I came through the secret passage and didn't come across anyone."}]},{"spans":[{"text":"I've already overridden all surveillance on the way up. No time for explanations now. I need to see the Chairman immediately."}]}]},{"sprites":[],"ops":[],"speaker":"Friedrich","narrator":false,"pages":[{"spans":[{"text":"...Chairman Oberstein isn't in at the moment."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"side":"left","tags":{"Position":"80,90"}}],"ops":[],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief moment of silence, Nemhran slowly sits down on the couch in the guest area."}]}]},{"sprites":[{"prefab":"NPC-Nemhran","expression":0,"side":"left","tags":{"Position":"80,90"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nemhran","narrator":false,"pages":[{"spans":[{"text":"Tell him—Laplace is dead."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
