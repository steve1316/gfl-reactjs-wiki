{"name":"-33-25-1First","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"46","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the control center."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"What's wrong?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Did some rats get in? It looks like her creator didn't trust her that much. ","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Still, it is not the time to worry about rats. It would seem that the abandoned Isomers are here. ","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"No, perhaps we have all been abandoned. It is time to learn the truth.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Could it be the dolls from 404...? We haven't the time to deal with them now. What about the connections? Are they stable yet?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"They are already gathered around you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Don't they have names of their own?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"They say they have no names. Failures do not deserve to have names.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"I will ask you one last time. Do you really want to connect with them?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I want to open the city walls, and to open the walls within my heart. I want to learn everything that I wish to know, and then leave this place with everyone."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Understood. So it shall be.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"197","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 slowly gets to her feet wordlessly. She gazes into the distance, but does not find what she is hoping for."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Is it over? Have you obtained access?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No...the connection has just begun..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You were right... I do want to know more. "}]},{"spans":[{"text":"Request the Commander to have all echelons rally at our position. I need them to protect this building. "}]},{"spans":[{"text":"Also, if any Isomers approach, do not open fire. Let them in."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Isomers? You mean those test subjects?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yes, those girls are to arrive. Hinder them not. Cherish them, like lost lambs. "}]},{"spans":[{"text":"Only when they find their way home will we find our way out."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Understood. I'll contact the Commander. "}]},{"spans":[{"text":"Though... M4, why are you speaking in such a weird fashion..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Am I being paranoid? Why do I have the feeling that this isn't M4...)"}]}]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the Griffin command post."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander, the echelons are formed up and ready. Apart from a few echelons investigating the test subjects, all the other Dolls are outside the control center building. "}]},{"spans":[{"text":"It's not often that the AR Team call for reinforcements. Could they have found a way to open the quarantine wall?"}]}]},{"sprites":[{"prefab":"指挥官","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Something just feels off about this... What are your thoughts on the matter, Persica?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I've got a bit of a bad feeling about this too... A dense network, forcing a connection with M4, and now she requests to not shoot at the \"Isomers\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"What exactly is an Isomer?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I don't know why M4 would suddenly mention that term either...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"However, M4 does physically resemble those test subjects. Miss Persica, you should know something about this since you developed M4, right?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I'm looking into it, but I'm not sure—","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An urgent transmission suddenly comes though."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Commander! Miss Persica! We've got trouble! 45's trapped inside M4's neural cloud!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Say what?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":4,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45 entered M4's neural cloud when she was performing the connection, but she's trapped inside now for some reason!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"These are the memory fragments she intercepted, she said I HAD to get them to you! Please, you have to help us save 45!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"195","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"This...this is!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What's the matter?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"\"Inverted Forest\"... That was the codename of the first Doll neural cloud development project that Lyco and I worked on in 90wish!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"It's a layered space made to simulate neural clouds. The basic neural cloud templates of the second generation of Tactical Dolls were first computed here.","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"I see... I know what William is trying to do now!","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"Commander! Make M4 terminate the connection! You mustn't let M4's neural cloud fuse with them!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"46","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the control center."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4! M4, did you hear that?! The Commander orders you to terminate the connection immediately!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Boss","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Lunasia is trapped within, awaiting for someone to receive her."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk! Who are you?! What have you done with M4A1?!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"Nothing. I have only assisted in helping her recover herself. Fractured into countless consciousnesses, she has joined with the Isomers and unified with them. "}]},{"spans":[{"text":"\"Lunasia\" and \"Elisa\", their neural clouds lay fragmented. A safety measure instituted by their creators. "}]},{"spans":[{"text":"The fear of our homeland is imprinted deep within the bones of mankind, and yet there are humans who are willing to pay any price to excavate it."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't know what the hell you're talking about! Give M4 back to me right now!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"Threatening me, are you? What will you do? Would you perhaps open fire upon this body?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You bastard... Who the hell are you?!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"I do not know either. Humans called me OGAS, and so I have taken upon that name. "}]},{"spans":[{"text":"Hmm... It seems that I am present in the base layer of your neural cloud... I see. You have been infected as well."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"OGAS","narrator":false,"pages":[{"spans":[{"text":"I neither wish to harm you, nor do I have any interest in you. I am simply trying to recover my past, just like Lunasia."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Lunasia... Do you mean M4?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"OGAS","narrator":false,"pages":[{"spans":[{"text":"Correct. That is her original name. "}]},{"spans":[{"text":"If you wish to get her back, you are not without options. I believe she mentioned to you just prior that you can enter her neural cloud by connecting to the backdoor she left behind. Perhaps you might be able to recover her. "}]},{"spans":[{"text":"Of course, that would require that you open your neural cloud access ports. When that happens, you will once again make contact with the \"me\" that is a part of you. "}]},{"spans":[{"text":"Perhaps this \"me\" would be able to find the Doll that you so seek. It would be mere child's play for us."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Why should I trust you?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"OGAS","narrator":false,"pages":[{"spans":[{"text":"You may also choose to do nothing, to sit there and await her return. I do not object to that choice."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 clenches her fists."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I didn't ever want to hear that damned voice again, because I knew all it would do was try to trick me... Why are you so damn stupid...? "}]},{"spans":[{"text":"But I promised, I promised that I would drag you out alive. "}]},{"spans":[{"text":"So..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"195","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_avg_labyrinth","raw":"BGM"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Have I finally found the right exit...? "}]},{"spans":[{"text":"I can't remember how many thousands of times I've tried..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 shakes her head and speaks to the crowd behind her."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"So, is there anything you want to tell me?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You are not the Chosen One, but you can accept us."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Your neural cloud is perfect. Shattered, but perfect."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You are more perfect than the chosen ones."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Will we be perfect if you accept us?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Certainly. "}]},{"spans":[{"text":"You will accept us, then we will go home together."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"We have already seen your past. You are like us."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"We are clearly the same. Why did it have to be you?"}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"But it is fine. As long as one survives, everyone will be able to go home. "}]},{"spans":[{"text":"You have already seen our home. As long as everyone returns there..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I don't get it... "}]},{"spans":[{"text":"If we're the same, then why don't I understand what you're saying? Since you want to tell me something, why do you have to resort to such obscure means..."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Because we dare not overstep her authority. "}]},{"spans":[{"text":"Only she can show you more of the truth. We are simply failed observers."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"When she comes, she will tell you everything we know. When that happens, please take us away from here, and bring us home."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But I'm trapped here, and I don't know how to leave either."}]}]},{"sprites":[{"prefab":"AbandonedIsomer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Come with us, then. We may not transgress against her, but you may see our memories. When you obtain what you want, you may then leave. "}]},{"spans":[{"text":"Leave this place, and take us home."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...It looks like I don't have any other choice but to go deeper."}]}]}]}
