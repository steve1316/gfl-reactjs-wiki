{"name":"-44-B4-4-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"229","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"sfx","value":"RunStep","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the gunshots gradually die down behind them, the Commander and Dandelion advance silently through the confusing layout of the drug plant, protected by the AR Team."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sorry, RO. My delay cost us a lot of time."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...No, that is something you would do."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The layout here has changed too much. I can't find a path that leads upward."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We don't have much time. If we don't find a way up... "}]},{"spans":[{"text":"Then Squad Griffin will have sacrificed themselves in vain."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Can't we just blow up the ceiling?!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Of course not! Who knows what's on top of us! "}]},{"spans":[{"text":"What if we cause a chain reaction of cave-ins that traps us here?!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Also, we do not have enough explosives to destroy such sturdy walls."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...If we delay any longer, Paradeus' pursuers will catch up and we'll all die here."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander clenches their teeth and punches the wall in the corridor."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"God dammit!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Knock knock knock. "}]},{"spans":[{"text":"As though in response, a gentle knocking comes from the other side of the wall."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Who's that!"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Robin? Is that you, Robin?! "}]},{"spans":[{"text":"Can you hear me?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Machlian?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 chambers a round immediately."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Wait, 15."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What are you waiting for?! Do you still think she's innocent at this point? Really? "}]},{"spans":[{"text":"Listen up! I think Perosa and the others were tricked by her!"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"How do you know that?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I just know! And I have proof!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Proof? What proof..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Robin! Robin!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian starts pounding the wall, and the frantic beats interrupt the Commander's train of thought. "}]},{"spans":[{"text":"The Commander hesitates for a second before knocking on the wall by way of response."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Machlian, where are you?"}]}]},{"sprites":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"I'm in the passage on the other side. "}]},{"spans":[{"text":"Follow the sound of my voice."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Go over and take a look."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO nods and creeps slowly along the wall, following Machlian's voice."}]}]},{"sprites":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Yes... Over here, Robin. "}]},{"spans":[{"text":"There should be a secret door on this wall. Push the switch for about 15 seconds and it'll open up. "}]},{"spans":[{"text":"The exit is here. Come in after you open it, I'll lead you out."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Do you want me to KO her?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Don't be hasty. "}]},{"spans":[{"text":"Let's hear her out first, I'm still thinking."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Prison_Door","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO feels around on the wall as directed and finds the switch for the hidden door. After pressing down on it, the wall in front of her opens slowly. "}]},{"spans":[{"text":"RO leads the way in. The only person inside the empty secret passage is Machlian, who is leaning against a wall and cradling several vials in her arm."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Robin..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She looks very weak. One arm hangs limply. Her wounds have already scabbed over, but it's clear that she has lost an incredible amount of blood."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...It's the serum."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion whispers to the Commander when she sees what Machlian is holding."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Machlian, how did you get here?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"This...place hasn't changed too much... "}]},{"spans":[{"text":"Someone had tempered with the blood-extraction device to capture me, but I managed to avoid the Paradeus troops with my knowledge of this place... "}]},{"spans":[{"text":"But since I couldn't find you, I had to keep running up...until I ended up here..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Do you really think we'll believe that? At least put some effort into making up your pathetic lies!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I'm not lying... Please, will you believe me, Robin?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian directs a pleading look at the Commander. "}]},{"spans":[{"text":"She pants heavily as she speaks, and her feebleness doesn't seem to be an act. She looks like she might collapse at any time if she weren't leaning against a wall."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Can't you hear the falseness in her lies?!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Thanks to you, we're surrounded and in danger, while Squad Griffin's fate hangs in the balance... "}]},{"spans":[{"text":"We have no reason to believe you unless you provide a convincing reason."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"The Commander was so nice to you! "}]},{"spans":[{"text":"Why did you even come back after sneaking off by yourself?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion... What do you think?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"If Lunasia were here, I know she would trust her."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Huh?! Why are you bringing up M4 at a time like this?!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Do you disagree?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...In any case, I don't trust her!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Robin. "}]},{"spans":[{"text":"You once promised...that you would trust me... "}]},{"spans":[{"text":"And I also promised...I would get you out of this place."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."},{"text":"Trust her.","style":{"c":""}},{"text":"Don't trust her.","style":{"c":""}}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...15."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"},{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Under the Commander's cold and indifferent gaze, Machlian comes to a realization. Sadness creeps into her eyes."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Robin..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I trusted you once, Machlian. "}]},{"spans":[{"text":"And I paid the price for it."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian's face is fraught with sorrow."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_weapon_reload","raw":"SE1"}]