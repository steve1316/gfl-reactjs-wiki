":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Ro...bin..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian's body twitches slightly, and streams of tears flow from her eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"The exit's...just... "}]},{"spans":[{"text":"...Up ahead."}]}]},{"sprites":[],"ops":[],"speaker":"\"Machlian\"","narrator":false,"pages":[{"spans":[{"text":"Oh, how pitiful."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The massive cybernetic limbs retract. "}]},{"spans":[{"text":"Machlian's last words lodge in her throat, inaudible. "}]},{"spans":[{"text":"They can only be vaguely guessed from the shape of her lips."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"...Thank you, Robin.\""}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"<Size=60>MORRIDOW!!!</Size>"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"And as Machlian falls, the fluorescent powder on Morridow's shoulder glows with brilliant, dazzling intensity."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
