ression":0,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Now let's see you weasel your way out of—"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, the UV flashlight reveals nothing."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"W-Wait a minute..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 starts to panic as she turns Machlian this way and that. The latter offers no resistance at all as she shines the flashlight on the other shoulder, but it is just as empty. "}]},{"spans":[{"text":"The Commander seems to have lost patience and waves ST AR-15 off."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We're out of time. Just leave her here. We're moving on."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Wait, let me think..."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Robin."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What else do you have to say?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Go all the way down this passage and you'll find a fork in the path. "}]},{"spans":[{"text":"Remember, go left. That will take you to the top level."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Do you think I'll still believe you?"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian gives the Commander a sad smile."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...I promised I would you out of here."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns and gestures to the others."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Wait, don't go yet...!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Who would have thought that at a time like this, YOU would be the one to split hairs. "}]},{"spans":[{"text":"You're such a fussy one."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's not what I mean! "}]},{"spans":[{"text":"I just think this doesn't make sense!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What doesn't make sense?! She lied to us! "}]},{"spans":[{"text":"Isn't that the truth?!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"But—"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Just as the Commander bellows in rage, the lights overhead suddenly flicker. "}]},{"spans":[{"text":"The stifling air in the secret passage suddenly grows damp and cold."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"AVG_Walk","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Tap, tap... "}]},{"spans":[{"text":"In the empty corridor, in the darkness. "}]},{"spans":[{"text":"A pair of high heels pound out a bone-chilling rhythm on the ground."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What's going on?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment the Commander turns around, a flash of cold light streaks out of the darkness!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Robin! Look out!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"2","raw":"分支"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I believe you. "}]},{"spans":[{"text":"Where's the exit?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 gapes at the Commander with abject disbelief. "}]},{"spans":[{"text":"Machlian breathes a sigh of relief and gives the Commander a grateful look, all the while struggling to keep herself upright. "}]},{"spans":[{"text":"The Commander is about to reach out when ST AR-15 steps in and blocks everyone's path."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Commander, there really is something fishy about her!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Didn't you say you had proof, 15? "}]},{"spans":[{"text":"If you don't agree with my decision, show me your evidence."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Humph! Fine! I'll show you all right now!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 takes a UV flashlight out of her waist pouch."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's that?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Look closely now!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 points the UV flashlight at Machlian and turns it on."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":6,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"(Whimpers)"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She directs the beam onto Machlian's shoulder. "}]},{"spans":[{"text":"However, even under UV light, Machlian's shoulder is still clean."}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"15?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"No way... It can't be?!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Lunasia would have laughed at this."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Shut up! "}]},{"spans":[{"text":"...This can't be right! Perosa clearly gave me a hint back then!"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Stop wasting time. SOP-II, help her up. "}]},{"spans":[{"text":"Machlian, get us out of here."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Gimme your hand!"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"side":"left","tags":{}}],"ops":[{"type":"branch","value":"1","raw":"分支"}],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Okay!"}]}]},{"sprites":[],"ops":[{"type":"branch","value":"1","