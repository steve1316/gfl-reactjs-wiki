{"name":"-17-6-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Task Force DEFY continues breaking through the lockdown toward the repeater station. "}]},{"spans":[{"text":"Meanwhile, M4A1 looks silently at AR-15 as she adjusts her gear in the darkness."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"},{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I guess you're not going to let the matter go, are you?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Do you have something to tell me?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"It was a forcefield."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","value":"0.6","raw":"黑屏1"},{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Hmm?"}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"6CG-M4","raw":"BIN"},{"type":"blackscreenOff","value":"0.6","raw":"黑屏2"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That day... "}]},{"spans":[{"text":"The moment the explosives went off, Mastermind created a forcefield around me. "}]},{"spans":[{"text":"I somehow managed to survive, although most of my body was blown to bits."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"6CG-M4","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But then...how did you get out of that place...?"}]}]},{"sprites":[{"prefab":"AR15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"6CG-M4","raw":"BIN"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange's T-Dolls rescued me. "}]},{"spans":[{"text":"I went through a whole mess of things after that, but in the end...I was fixed."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AR-15 sighs and looks at her wrists, which she dextrously rotates."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"They also upgraded me along the way, and that's about it..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...That's it? "}]},{"spans":[{"text":"You've always been like this. You've always loved to hide and burrow yourself away. "}]},{"spans":[{"text":"Did you know that back then, all of us thought that you...you..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"They had to shut down all my external interfaces in order to curb the Parapluie still within my body. "}]},{"spans":[{"text":"I spent a long, long time lying down for servicing in an underground room where I couldn't even see the sun, so don't ask why I didn't contact you."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...If you had come back earlier, a lot of things wouldn't have ended up like they did now. "}]},{"spans":[{"text":"At least we could have...gone back to how things used to be..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"That's just wishful thinking on your part, M4A1. "}]},{"spans":[{"text":"When I woke up, I was told that my neural cloud had been heavily altered thanks to Parapluie... "}]},{"spans":[{"text":"Part of that involved deleting my original principal order."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Principal order... What's that?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...AR-15 gazes intently at M4A1."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Everything I did had protecting you as my top priority, even if it meant sacrificing myself."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You should have sensed it too, right? "}]},{"spans":[{"text":"This was our original principal order... Not just for me, but the other members of the AR Team as well... "}]},{"spans":[{"text":"That was why everyone fought so hard for your sake."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Did that order...make you feel very uncomfortable?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I just thought it was stupid. "}]},{"spans":[{"text":"Good thing it was deleted. I'm no longer bound by this order. Perhaps, technically speaking, I am free. "}]},{"spans":[{"text":"And so, after going through all that, I won't risk my life to protect you anymore."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Right now, I'm no longer like how I was in the AR Team. "}]},{"spans":[{"text":"Are you still planning to take risks even with someone like me at your side?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But of course. That's completely irrelevant. "}]},{"spans":[{"text":"Or rather, it might be for the better that nothing can force you to do anything anymore. "}]},{"spans":[{"text":"...It also makes me feel less burdened."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You've really changed, M4A1. I think it's for the better."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"But I still haven't figured out why Mastermind would save you..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I don't know either. Perhaps... "}]},{"spans":[{"text":"Our orders to destroy Sangvis Ferri, or perhaps everything else, aren't as simple as we thought. "}]},{"spans":[{"text":"Even though we're still enemies with all the Sangvis units that we see, the enemies behind us..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"It doesn't matter. Clearing obstacles from my path has always been the way of things. "}]},{"spans":[{"text":"I just want to know who really needs to die. That's enough for me."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...M4A1 gets to her feet and walks off."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...For a moment... "}]},{"spans":[{"text":"There was an icy gleam in M4A1's eyes."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"background","value":"雪地","raw":"BIN"},{"type":"night","raw":"Night"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(She has changed... )"}]},{"spans":[{"text":"(But is it really for the better?)"}]}]}]}
