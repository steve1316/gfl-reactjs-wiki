O635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Giving them a taste of their own medicine?"}]}]},{"sprites":[{"prefab":"M1887","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1887","narrator":false,"pages":[{"spans":[{"text":"Not every person is born with a purpose... "}]},{"spans":[{"text":"But every T-Doll is created for one."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Alright, I believe you. Tell me everything you know. "}]},{"spans":[{"text":"SOP II, set up the comms. "}]},{"spans":[{"text":"We need a new encrypted channel to send a progress report to Helian."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Roger. On it now!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Suddenly, M1887 raises her weapon."}]}]},{"sprites":[{"prefab":"M16","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...! "}]},{"spans":[{"text":"SOP II, watch your back!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BANG!"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"What are you doing, M1887?! Why did you blast the comms to pieces?!"}]}]},{"sprites":[{"prefab":"M1887","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M1887","narrator":false,"pages":[{"spans":[{"text":"Your team is missing a T-Doll. "}]},{"spans":[{"text":"She's gone because of Parapluie, hasn't she?"}]}]},{"sprites":[{"prefab"