{"name":"-36-1-10","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the command room."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander, the Military armored units have begun their assault on the northern defense line! "}]},{"spans":[{"text":"It's a saturation attack, our HOCs can't stop them!"}]},{"spans":[{"text":"Losses to our frontline Doll echelons are over 85%!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"We're just too weak, huh..."}]},{"spans":[{"text":"Dandelion, can you have the northern echelons fall back to our train?"}]},{"spans":[{"text":"If their armored units flank this train, then we're done for."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I'm relaying orders now and reorganizing our remaining forces in the most optimal manner."}]},{"spans":[{"text":"Also, the backup Dolls have pinpointed the location of the armored units. They are not trying to approach the train's position. "}]},{"spans":[{"text":"Their objective is probably the coastal gun platforms. Once they break through our lines, they'll probably head for it at full speed."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's worse than if they were headed right for us..."}]},{"spans":[{"text":"Send this news to the AR Team. Make sure they know they have to reach the shore guns before the Military!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Attempting to contact them."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How's Squad 404? Have they still not found a way open the main gate?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"They're still running silent..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Continue to monitor their transmissions. We'll move once we get word from them."}]},{"spans":[{"text":"(Sighs) I told them we could hold out for 30 minutes, but it's only been 10 minutes..."}]},{"spans":[{"text":"We're sitting ducks here until that gate opens!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Commander, the ECCM is effective; our comms have been partially restored."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Have the northern echelons begun withdrawing?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"They're trying to regroup, but there's a sustained barrage targeted at them."}]},{"spans":[{"text":"Also, the southern defense line is taking a second round of attacks. The enemy's human infantry are moving up and there are no autonomous units to hack."}]},{"spans":[{"text":"Losses on the southern line are up to 70%. Should we order them to continue fighting?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...Have them pull back to the train as well. Instruct the backup teams to prepare for combat."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander."}]}]},{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In a corner of the battlefield."}]},{"spans":[{"text":"The Dolls here are carrying on perfectly normally, as though the gunfire and chaos outside have nothing to do with this place."}]}]},{"sprites":[{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"CF-05","narrator":false,"pages":[{"spans":[{"text":"Girls! Orders from the Commander!"}]}]},{"sprites":[{"prefab":"SL8","expression":2,"side":"left","tags":{}},{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr SL8","narrator":false,"pages":[{"spans":[{"text":"Patch them in. "}]},{"spans":[{"text":"Yes... Understood."}]}]},{"sprites":[{"prefab":"SL8","expression":2,"side":"left","tags":{}},{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"CF-05","narrator":false,"pages":[{"spans":[{"text":"Why are you making that face?"}]}]},{"sprites":[{"prefab":"SL8","expression":0,"side":"left","tags":{}},{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr SL8","narrator":false,"pages":[{"spans":[{"text":"When the Commander gives orders, you've got to listen solemnly! "}]},{"spans":[{"text":"Don't worry, everything's still going as planned."}]},{"spans":[{"text":"Everyone, prepare to withdraw! Guard your mainframes well, and if need be, use your Dummies as meat shields"}]}]},{"sprites":[{"prefab":"SL8","expression":0,"side":"left","tags":{}},{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"CF-05","narrator":false,"pages":[{"spans":[{"text":"Right. Everyone, step lively!"}]}]},{"sprites":[{"prefab":"SL8","expression":0,"side":"left","tags":{}},{"prefab":"06TypeSMG","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_h","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A gunshot rings out."}]}]},{"sprites":[{"prefab":"SL8","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Gr SL8","narrator":false,"pages":[{"spans":[{"text":"...Well, that was fast. Everyone, get ready for battle!"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":3,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"Commando","narrator":false,"pages":[{"spans":[{"text":"I've spotted some remaining Dolls... Everyone, on me!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"All forces, retreat!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"We can't! We can't go yet! "}]},{"spans":[{"text":"Our other echelons are still in their positions!"}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Ingram, now's not the time for heroics. The Commander's given orders!"}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"Huh? You want me to go when P7's still in danger?"}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Ingram...you..."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"Give me your Dummies! I'll hold the enemy off!"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"You stay behind, Ingram. Everyone else, give your Dummies to her, then fall back with me."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"But..."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}},{"prefab":"MAC10","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"That's more like it. Thanks, boss."}]}]},{"sprites":[{"prefab":"MP5","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gr MP5","narrator":false,"pages":[{"spans":[{"text":"Are we going to abandon Ingram? "}]},{"spans":[{"text":"Are we...going to abandon everyone else?"}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Don't let Ingram's sacrifice go to waste. "}]},{"spans":[{"text":"All we can do is repay her in the end by winning."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ingram doesn't look back at her teammates as they retreat."}]},{"spans":[{"text":"She rubs her tired eyes and leads the remaining Dummies towards the Military commandos—"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"Gunfight","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"More gunshots."}]}]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Inside the train's command room."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Commander...there are fewer and fewer echelons capable of responding to us at the forward defense line... "}]},{"spans":[{"text":"And the Military units are now within two kilometers of us."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Activate the train's defensive weapons. Let the enemy vanguard past, then interdict the battlefield. Do your best to cover the retreating echelons. "}]},{"spans":[{"text":"Commit all of our reserves, have them block the enemy forces along with the retreating echelons."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Our train is almost out of ammunition."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I know. "}]},{"spans":[{"text":"Still no word from 404?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":7,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":5,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Not yet... Come on, Miss 45... Please, hurry up!"}]}]}]}
