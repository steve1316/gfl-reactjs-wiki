ags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Oh, that's because the Commander wasn't hurt at first. "}]},{"spans":[{"text":"The Commander brought me up here, but we ran into Paradeus soldiers along the way. "}]},{"spans":[{"text":"It was a really close call and the Commander barely managed to escape with me."}]}]},{"sprites":[{"prefab":"Derringer","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Derringer","narrator":false,"pages":[{"spans":[{"text":"...This still feels kinda strange to me..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Derringer frowns."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Does it? How so?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perosa comes to a halt, and because she stopped, the other members of Squad Griffin stop too, though they don't understand why."}]}]},{"sprites":[{"prefab":"Kolibri","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"...What's wrong, Perosa?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Machlian."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Is the Commander really up ahead?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...Why wouldn't they be? "}]},{"spans":[{"text":"You saw the map, right? There's an abandoned storeroom up ahead. "}]},{"spans":[{"text":"The Commander is in there."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Yes, I DID see the map. "}]},{"spans":[{"text":"Which is why I know this doesn't add up. "}]},{"spans":[{"text":"The path you took to escape is simply too far from your original position."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"...What are you getting at?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"How exactly...did you get to the upper levels? "}]},{"spans":[{"text":"And where are the Commander and the AR Team?"}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Machlian looks a little taken aback by Perosa's questions. Then, her expression softens... But she still doesn't look remotely like her usual self."}]}]},{"sprites":[{"prefab":"NPC-Machlian","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Machlian","narrator":false,"pages":[{"spans":[{"text":"And here I thought you trusted me."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":fa