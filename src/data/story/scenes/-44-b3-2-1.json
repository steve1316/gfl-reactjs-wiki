ander","narrator":false,"pages":[{"spans":[{"text":"Perosa, what's going on?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I can hear gunfire from beyond the quarantine wall.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Commander! It's Paradeus! "}]},{"spans":[{"text":"Paradeus is attacking the quarantine wall! "}]},{"spans":[{"text":"They've turned the entire garrison. We're isolated here!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Hang in there.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We've already arrived.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
