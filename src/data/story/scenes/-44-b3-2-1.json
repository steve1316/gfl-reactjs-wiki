{"name":"-44-B3-2-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"169","raw":"BIN"},{"type":"bgm","value":"10220","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the Berlin quarantine wall."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Thank you for your cooperation."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"You're welcome. It's our job."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The smiling guard brings Perosa to the power room. His attitude has done a complete 180, and he is now extremely cooperative."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Thank goodness for that search warrant from the Earl...","style":{"color":"#A9A9A9"}},{"text":" "}]},{"spans":[{"text":"Things wouldn't have gone so smoothly without it.","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, Perosa still has her doubts. "}]},{"spans":[{"text":"She can't deny that Machlian is the key to all this, but would everything in Machlian's memory come to pass? "}]},{"spans":[{"text":"Perosa puts a big question mark on tat. "}]},{"spans":[{"text":"Leaving the other locations aside... Berlin's quarantine wall is essentially the city's front door, and the security here is on par with the Bundeskanzleramt. "}]},{"spans":[{"text":"Even the guard in front of her is an elite member of the military force. Sneaking past him to destroy the quarantine wall is practically impossible."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Still, this is strange. "}]},{"spans":[{"text":"Why would the brass suddenly think of checking for security issues here?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Well, you're guarding the gateway to Berlin, so you can't fault them for being too cautious."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Haha, you might be a Doll, but you have a way with words."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The man disables the lock to the power room and opens the door cheerfully."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Go ahead and look. I guarantee you won't find any issue here."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Alright, don't mind if I do."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still, suspicions are suspicions and orders are orders. "}]},{"spans":[{"text":"Perosa is not going to slack off on a mission she's been given. "}]},{"spans":[{"text":"She has the trust of even the famously picky Griffin. Perosa's vast stores of knowledge and experience, gathered over long years of service, are her greatest weapon."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Speaking of which, those friends of yours all look like very new models."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...No, Fedorov and Kolibri are from the same batch as me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As she checks behind the equipment, Perosa exchanges the occasional word with the man."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"And the other two are your subordinates?"}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Yeah."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"The man is incredibly frivolous for a security guard. "}]},{"spans":[{"text":"Perosa furrows her brow, but she keeps her misgivings to herself."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Kolibri, come in. How's the investigation on your end?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pzzzt... "}]},{"spans":[{"text":"The communicator emits a burst of ear-piercing static, and Perosa gets no reply."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Sorry, but signal reception in here isn't too good. "}]},{"spans":[{"text":"We block all electronic broadcasts for security reasons."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"Is that so?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Perosa looks back at the guard, who is all smiles."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As Perosa heads deeper into the room, the man locks the door behind him quietly."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"I've finished my inspection. Please open the door."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"You're done? So soon?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The guard looks a little surprised."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"That's because there's nothing to check."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Haha, really? "}]},{"spans":[{"text":"I guess so. I mean, this IS the quarantine wall, what problem could there be? "}]},{"spans":[{"text":"We've always..."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"There are three bombs in total, all placed in the most vital locations. "}]},{"spans":[{"text":"Once they go off, this section of the quarantine wall will be paralyzed in 15 seconds. "}]},{"spans":[{"text":"Only someone who's intimately familiar with this place could have planted them."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Is there anything else you'd like to say?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The guard's smile grows stiff before his face slowly darkens."}]}]},{"sprites":[],"ops":[],"speaker":"Guard","narrator":false,"pages":[{"spans":[{"text":"Do you really think you can stand in the way of Paradeus' great work?"}]}]},{"s