They put a huge pile of mines on the shore guns.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Stay there. I'll handle the other places."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kolibri","narrator":false,"pages":[{"spans":[{"text":"Yo yo! Dumbasses should just stay where dumbasses ought to be.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Kolibri","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"No, what I mean is..."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Savage99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Savage","narrator":false,"pages":[{"spans":[{"text":"If they're sabotaging the shore guns, then it's very likely that they ARE planning to attack the quarantine wall.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"They must be working in tandem with the people outside, which is why they were plotting to disable the wall's defensive capabilities.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Savage99","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Perosa","narrator":false,"pages":[{"spans":[{"text":"...Correct, that's what I meant. "}]},{"spans":[{"text":"You picked up on that fast."}]}]},{"sprites":[{"prefab":"VP1915","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"Savage99","expression":0,"shown":true,"side":"left","tags":{"commsBox":"