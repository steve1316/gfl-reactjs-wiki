{"name":"-54-B-11","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"197","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"10082","raw":"BGM"},{"type":"effect","value":"%%code=CJ_rain%%","raw":"common_effect"},{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A ruptured carriage. A broken droid. Shattered rain. "}]},{"spans":[{"text":"Woven into a sleepless night."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk! "}]},{"spans":[{"text":"The smuggled military droid topples to the ground with a mighty crash."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"...Do we keep going?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Instead of mocking Danil like he usually would, Nikolai shifts his gaze to Baba Lyuba in her wheelchair. "}]},{"spans":[{"text":"The small handful of remaining Vory are all huddled around her, waiting for their orders."}]}]},{"sprites":[{"prefab":"NPC-OldLady","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Baba Lyuba","narrator":false,"pages":[{"spans":[{"text":"Enough..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Baba Lyuba looks around at her underlings and sighs heavily."}]}]},{"sprites":[{"prefab":"NPC-Bodyguard1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Danil","narrator":false,"pages":[{"spans":[{"text":"Withdraw."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Once the order is given, the rattled Vory stumble out of the carriage in a rush. "}]},{"spans":[{"text":"Their demeanor cannot be more different from when they swaggered on board earlier. It is hard to look threatening when one is running away with their tail in between their legs."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Amb_Rain_0","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mixing with the incessant rain, blood seeps through a layer of gunpowder and into the soil... "}]},{"spans":[{"text":"The Vory trudge on heavily..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"530","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"Carriage F09 (Dining Carriage), Intercontinental Railway train \"Future\"."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Carriage 9 doesn't seem to be faring much better. "}]},{"spans":[{"text":"As the footsteps slowly recede, Susanna's panic finally subsides."}]}]},{"sprites":[{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"...Phew. "}]},{"spans":[{"text":"They're gone!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Though everyone is obviously shaken, chaos has not engulfed this particular carriage thanks to Lyudmila. "}]},{"spans":[{"text":"The humans are taking refuge behind sturdier obstacles, while the Dolls are gathered near the bashed in carriage door. "}]},{"spans":[{"text":"Susanna may be relieved, but Maggie is uncharacteristically grim-faced."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...That was very unlike them."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Maybe Lyudmila's tactics worked?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still hiding behind cover, Lyudmila frowns deeply and racks the slide on her gun after a pause."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Their behavior was very odd during both the confrontation and their retreat. "}]},{"spans":[{"text":"We mustn't let down our guard just yet."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...Only ten Dolls are currently able to fight. "}]},{"spans":[{"text":"The body temperatures of some of the human passengers are already dropping..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After taking stock of the situation in the entire carriage, Pavel comes up to Lyudmila with Rosita in his arms."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"If we don't get any supplies soon... I'm afraid some of us won't make it. "}]},{"spans":[{"text":"Rosita's fever is also getting worse..."}]}]},{"sprites":[{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"...The emergency kits are all used up. We've also lost all the food and water because of the crash and the rain."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"We make for the first carriage."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}},{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"I just received word from Lucas. "}]},{"spans":[{"text":"The first-class carriage didn't take too much of an impact. There should be enough emergency power, water, and food to last us a while."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Passenger A","narrator":false,"pages":[{"spans":[{"text":"What—R-really?!"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Passenger B","narrator":false,"pages":[{"spans":[{"text":"...L-let's go already!"}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Passenger C","narrator":false,"pages":[{"spans":[{"text":"Oh, thank God! Our Lord hasn't forsaken us, after all!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Lyudmila can even finish, the passengers all rush out from their hiding spots, and the entire carriage bustles with frantic movements."}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Do a headcount and take stock of our supplies. We should move as quickly as possible."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Susanna musters what energy she has left and tries her best to perk up. "}]},{"spans":[{"text":"Her smile looks a little forced and even comical. "}]},{"spans":[{"text":"But still, she retains her professionalism as a train stewardess."}]}]},{"sprites":[{"prefab":"NPC-TD_Porter","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Susanna","narrator":false,"pages":[{"spans":[{"text":"Leave that to me."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The passengers are in a celebratory mood. Catherine grumbles to Maggie as she watches them from her seat on the floor."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Don't you think that was too easy?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie shrugs, her gaze still directed at the window."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Even you can tell something's wrong. Isn't it obvious?"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine follows her gaze through the window and watches as a scattered group of dark figures traipse off into the woods in the distance. "}]},{"spans":[{"text":"That's where the unidentified convoy is located, but unlike the last group, the Vory's approach is met with no resistance."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...They're working together."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Indeed."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After some thought, Maggie lets out a humorless chuckle."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"If only I could have a sip of whiskey."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Catherine wordlessly produces a half-full and slightly battered bottle from behind her back. "}]},{"spans":[{"text":"Maggie takes the bottle and studies the label—"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Scotch! Where did you get this?!"}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"I swiped it at the bar counter when the Vory had me tied up."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...You sneaky bastard."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"That's me! It was gonna be my last drink before I go to hell. "}]},{"spans":[{"text":"But I'm giving it to you since you look so miserable."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie gives the bottle another look, then gives it back to Catherine."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Keep it for now. We're not going to hell just yet."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep— "}]},{"spans":[{"text":"An incoming message."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"GF_21summer_avg_SecretAgent","raw":"BGM"}],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Who is it?"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Nikolai."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie looks down at her communicator with a frown."}]}]},{"sprites":[],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"\"Only the good die young. Good thing you're not good, and neither am I.\"","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep— "}]},{"spans":[{"text":"Another message."}]}]},{"sprites":[],"ops":[],"speaker":"Nikolai","narrator":false,"pages":[{"spans":[{"text":"\"I'm going. See you in Poznań.\"","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"We backed the wrong horse. "}]},{"spans":[{"text":"Who knew it was HIS coattails that we should be riding on..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie puts away her communicator silently."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"Ugh, he found his way onto Noah's Ark. "}]},{"spans":[{"text":"While we got left behind like fools... "}]},{"spans":[{"text":"We've been slaving away for him all these years, how could he just abandon us...?! "}]},{"spans":[{"text":"I'm so sick of playing the victim!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A hand taps Catherine on the shoulder."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"...Don't interrupt my emotional soliloquy. My ship is sinking."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"...Miss Catherine, the others are ready. "}]},{"spans":[{"text":"Are you not coming with us?"}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'm coming! Of course I'm coming!"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Scene_Transfer","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Wait..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie's eyes widen as she stares out the window."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Look outside!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
