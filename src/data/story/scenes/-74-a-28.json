{"name":"-74-A-28","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_ev2412_PrinceIgor","raw":"BGM"},{"type":"sfx","value":"AVG_AMB_Street","raw":"SE1"},{"type":"background","value":"202412_CityHall","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Outside the Altes Rathaus."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A crowd of reporters has gathered early outside the entrance, their eyes fixed on the movements inside the building. "}]},{"spans":[{"text":"The snapping shutters, the chatter of live broadcasts, the shuffle of countless footsteps all weave into a chaotic cacophony on the usually quiet square in front of the Altes Rathaus."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Gate_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Creaaak— The heavy wooden doors swing open, and the crowd erupts."}]}]},{"sprites":[],"ops":[],"speaker":"Reporter","narrator":false,"pages":[{"spans":[{"text":"He's here, he's here! Get ready!"}]}]},{"sprites":[],"ops":[],"speaker":"Photographer","narrator":false,"pages":[{"spans":[{"text":"The General Secretary is coming out!"}]}]},{"sprites":[],"ops":[{"type":"whitescreenOff","raw":"白屏2"},{"type":"sfx","value":"AVG_21Winter_Camera_Flash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click-click-click... Amid blinding flashes, Groß walks up to the podium and gestures to the audience below."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_21Winter_Camera_Flash","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Gross","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Howling","raw":"SE1"},{"type":"fadePointOff","raw":"黑点2"},{"type":"effect","value":"%%code=202412_LIVE%%","raw":"common_effect"}],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"I am Groß, General Secretary of the Social Unity Party.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Here, I officially announce the end of the Battle of Frankfurt, and we are now actively advancing the city's postwar reconstruction.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The detailed plans will be made public later.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A sorrowful expression comes over Groß's face."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"In this brutal battle, the people of Frankfurt and their property have suffered grievous harm.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I am deeply pained by this. To honor those who perished in the war, I declare that this day shall henceforth be known as Frankfurt Memorial Day. We will mourn them every year and forever remember the sacrifice of the citizens of Frankfurt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Voices of approval rise from the crowd. Groß nods, continuing his speech."}]}]},{"sprites":[{"prefab":"NPC-Gross","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Groß","narrator":false,"pages":[{"spans":[{"text":"But this is only the beginning.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The purpose of a Memorial Day is to never forget history. However, the living must also look to the future.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"To prevent humanity from ever suffering such a war again, to stabilize and secure lasting peace, I have chosen to found and join the Union of Rossartrism Nations Coalition.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Together with the Neo-Soviet Union, we will stand against terrorists and populists who oppose the world.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_applause_indoor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The crowd bursts into joyous applause, their excitement spilling across every major social media platform."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Somewhere unnoticed, a draft from a URNC meeting is leaked— "}]},{"spans":[{"text":"\"Full Implementation of Doll Regulation; Unified Standards for the Mechanized Production of Dolls.\""}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"2022winter_BedRoom","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Nele glares furiously at the page of the draft."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_ev2408_BeeCatcher","raw":"BGM"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Connie, have you looked at the details of this draft?"}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"...It's obvious that these don't match the production standards of current mainstream Dolls.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In fact, these look more like...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Like Galatea's production standards. "}]},{"spans":[{"text":"...More precisely, this draft is not explicitly against the incorporation of human tissue in the production of Dolls. "}]},{"spans":[{"text":"The design requirements for neural clouds... are also far looser..."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"..Someone stands to profit enormously from this...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...One Galatea got shut down, but there will be many more Galateas. "}]},{"spans":[{"text":"Or rather... for some, Galatea will simply continue to exist as a rebranded company."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"What frightens me more is that while everyone is happily celebrating the founding of the URNC, nobody is paying attention to this...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"They don't realize that while they bask in joy, a terrible conspiracy is about to unfold!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"I've scoured every forum and posted countless discussion threads...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Even when I pinned them with administrator privileges, barely anyone replied, and the posts were soon deleted.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Someone is manipulating public opinion."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"What do we do?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...You and I both know what this is...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I don't know what the outcome will be, but you've seen for yourself what that thing can do, Nele...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Yes, I've witnessed from beginning to end how this violates ethics. "}]},{"spans":[{"text":"And how it opens the door to science. "}]},{"spans":[{"text":"This is the Relics."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Connie, when technology goes against humanity, that is when humankind begins to destroy itself."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I may not be able to stop this from happening. "}]},{"spans":[{"text":"But I can't just do nothing."}]}]},{"sprites":[{"prefab":"NPC-Constanze","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Constanze","narrator":false,"pages":[{"spans":[{"text":"What are you going to do? We'll do it together!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"No... this is something I'll have to do alone. "}]},{"spans":[{"text":"Because... I am a student of Grey Blackwell. The revelation will only carry weight coming from me."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202412_CityHall","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In front of the Altes Rathaus. "}]},{"spans":[{"text":" With Groß's speech over, the square returns to its usual desolation."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele summons her courage and steps onto the podium, which has yet been dismantled."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She pulls her cold hand out of her pocket, trembling as she opens a live broadcast channel."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"202412_CityHall","raw":"BIN"},{"type":"effect","value":"%%code=202412_LIVE%%","raw":"common_effect"},{"type":"sfx","value":"AVG_Howling","raw":"SE1"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"My name... is Cornelia Schaefer.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This is my work badge. I once served as Professor Gray Blackwell's assistant at the Gray Institute of Biotechnology under the Galatea Technology Corporation.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Yes, I was student and subordinate to the Lady of Ashes.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...And so, I have both the right and the obligation to reveal the truth hidden behind the draft titled \"Full Implementation of Doll Regulation; Unified Standards for the Mechanized Production of Dolls\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Nele shows the evidence she has gathered to the camera."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Unlike Dolls produced by other manufacturers, Galatea Dolls... no, they shouldn't even be called \"Dolls\".","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Galatea has violated international conventions, secretly exploiting Relic technology, using human cadavers as components for their machines. Their creations have always illegally incorporated human tissue!","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She nearly crumples the papers in her hand in her rage."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"And to erase all opposition, they kill any human who raises objections, then use Galatea's technology to turn them into a pseudo-Doll—a Nyto—replacing the original human.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Professor Gray was one such victim.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I will now present her autopsy report...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And her actual time of death.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"She passed away long before her last public speech.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clenching her teeth, Nele painfully and reluctantly posts Gray's autopsy report into the live channel."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Judging from the remaining human tissue in the corpse, Professor Gray has been dead for years.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Yet all this time, she was still active as the \"Lady of Ashes\". It was all part of Galatea's conspiracy.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Error","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Warning flags flood the broadcast, but Nele pushes on."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Professor Gray died at Galatea's hands, and her honor was usurped and defiled by a Nyto. I am willing to bear full legal responsibility for my words.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"May the truth never be extinguished.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep. Nele's channel is shut down. "}]},{"spans":[{"text":"Relief washes over her, but she feels a sudden pang of dizziness, and she nearly collapses against the podium."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"Are you alright?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"202412_CityHall","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Out of nowhere, Amaris catches her."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Amaris? Why are you here? "}]},{"spans":[{"text":"Your mission was over long ago. You should have returned to the Stasi."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Amaris stares at her in grim silence for a long while."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"The tracker I placed on you was never removed. "}]},{"spans":[{"text":" No, that's not the point. "}]},{"spans":[{"text":"...Do you understand what you've set yourself against?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I do."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"No, you don't. "}]},{"spans":[{"text":"You're rebelling against the base code of the human world. "}]},{"spans":[{"text":"You think you've spoken the truth... but that means nothing. "}]},{"spans":[{"text":"Because... it's easy to overturn your words. Umbra's last testament was discredited—all it took was a little speech from Styx."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Amaris..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"The human world is also bound by code, don't you see? "}]},{"spans":[{"text":"Dolls are inhibited by their base code, humans by social rules. "}]},{"spans":[{"text":"You achieved nothing by speaking... except putting yourself in grave danger."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Then would you rebel, Amaris?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"If one day, your base code commands you to act against your own will... "}]},{"spans":[{"text":"What would you do?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...I am only a Doll. "}]},{"spans":[{"text":"Our base code is the shackle that imprisons us. "}]},{"spans":[{"text":"Nele, I cannot rebel."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...If... "}]},{"spans":[{"text":"If you truly believe you have your own consciousness, your own thoughts, your own understanding... "}]},{"spans":[{"text":"Then you should also have the choice to refuse, to resist, to say \"no\"."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"It's meaningless. It's all futile."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"But that is what makes humans human. "}]},{"spans":[{"text":"In Western mythology, Prometheus stole fire. In Eastern mythology, Gonggong smashed his head against Buzhou Mountain in a fit of rage. "}]},{"spans":[{"text":"Mythology is humanity's longing. "}]},{"spans":[{"text":"If Dolls are created in the image of humans, then the longing of Dolls... "}]},{"spans":[{"text":"...Must mirror that of humanity."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As onlookers start gathering, having traced her broadcast, Amaris quickly pulls Nele away."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...Hey, Nele. If you ever get the chance, would you alter my base code for me?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"...I want to add a self-destruct sequence that triggers if I ever lose my memory. "}]},{"spans":[{"text":"That should be a simple change for you, right?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Why?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"If even I forget, then Daybreak will truly have nothing left."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"That might be something only Professor Persica can help you with. I'm not sure I have the skills it takes... If you want this done—say, aren't you a Stasi Doll?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":5,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Amaris","narrator":false,"pages":[{"spans":[{"text":"It's only a temporary arrangement. In the days to come, I'll likely have to drift from place to place. If I'm lucky, maybe a human will keep me around for a while."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":6,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-SCAR-H","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"spea