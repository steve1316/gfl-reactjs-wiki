or Document 36."}]},{"spans":[{"text":"Hurry. The next round will begin any second."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"室内战斗","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Several minutes later, in a secret chamber within the office building."}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"Miss RO, is this the cover?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Yes! That's it! That's Document 36!"}]},{"spans":[{"text":"Bring it back to me quick, Miss Sten!"}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"I'm sorry, Miss RO..."}]},{"spans":[{"text":"I can't give it to you."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"What?!"}]},{"spans":[{"text":"What did you say, Miss Sten?!"}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sad","raw":"BGM"}],"speaker":"STEN MkⅡ","narrator":false,"pages":[{"spans":[{"text":"The human asked me just before he passed out..."}]},{"spans":[{"text":"To destroy the document..."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"I'm asking you to give me the document. That's an order!"}]}]},{"sprites":[{"prefab":"MK2","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"STEN MkⅡ","narrator":