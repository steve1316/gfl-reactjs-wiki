own":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Please be okay..."}]},{"spans":[{"text":"What to do... What should I do..."}]},{"spans":[{"text":"AR-15... Please tell me what I should do at a time like this..."}]}]},{"sprites":[{"prefab":"??","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"AR-15 can't help you anymore, you know."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[{"prefab":"??","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"But I can."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Privet, my dear Miss Commander."}]},{"spans":[{"text":"My return is most timely, isn't it?"}]}]}]}
