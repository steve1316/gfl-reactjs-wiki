rator":false,"pages":[{"spans":[{"text":"Fwup."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"?!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica, who was still lying on the floor just a moment ago, has suddenly jumped to her feet with a vicious look on her face."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"m_wv_battle","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Say that again?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Her animosity is directed straight at Hunter who insulted her."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"I mean, even you can't possibly do anything in such a short time."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏3"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You think I'm no better than all these amateurs at the Griffin Base?! I'm Persica, for heaven's sake!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica goes off like a firecracker."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I can easily whip that up in two hours!"}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"It would take Dreamer just an hour and a half."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Then I can do it in one!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Persica storms into her workshop angrily."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander and LWMMG exchange looks speechlessly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hunter... You..."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...In my experience, scientists like her hate nothing more than being belittled by fellow scientists. "}]},{"spans":[{"text":"I thought it was worth a shot. Good thing it worked."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Way to go, Hunter."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"Don't mention it. It's just me taking responsibility for what happened. "}]},{"spans":[{"text":"Let's haul the ingredients here and start preparing for the chocolate making, Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Right. Lam, let's go."}]}]},{"sprites":[{"prefab":"LWMMGMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"LWMMG","narrator":false,"pages":[{"spans":[{"text":"Understood."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
