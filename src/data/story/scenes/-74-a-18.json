{"name":"-74-A-18","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Crossroads_Warrior","raw":"BGM"},{"type":"background","value":"819","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Autobahn 661. "}]},{"spans":[{"text":"Late at night, the road lies in deathly silence. Derelict vehicles sit quietly on the shoulder like relics of the end times. "}]},{"spans":[{"text":"After a long trek, Team Palette finally reaches their new target destination. "}]},{"spans":[{"text":"AAT-52 plops down on the hood of an abandoned car and starts complaining."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Arghhh!!! I can't go on anymore!"}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Stop whining, we're here already."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"We just hauled dozens of kilos of medicine on foot to the hospital, and now we're clearing the Autobahn. The weight of all this work is crushing me!"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"You're finishing the mission, even if you turn into a can of tomatoes today. "}]},{"spans":[{"text":"We're short on hands, and the Commander is also under huge pressure. We can't afford to drag things out."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Makarov checks the time."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"We rest here for 15 minutes and wait for the other squads to arrive. "}]},{"spans":[{"text":"AAT, rest up while you can. 92, help me set up the markers."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Got it!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Makarov and Type 92 hang up road-clearing signs at the highway entrance."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rustle... "}]},{"spans":[{"text":"Not far away, the shadowy figures of a few people dragging luggage appear in the night."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Makarov looks up. They seem to be families fleeing on foot, trudging down the autobahn with children in tow. "}]},{"spans":[{"text":"When they see the squad and the markers, their faces light up in surprised delight, but as they draw close enough to tell that they are Dolls, joy turns into caution and mistrust."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Makarov, should we show some ID?"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"No, don't do anything. Act like we don't see them and just keep working."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"},{"type":"sfx","value":"AVG_tableware","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Makarov starts calculating which lane is the easiest to clear, while Type 92 drags AAT-52 into helping move chunks of concrete and car wreckage. "}]},{"spans":[{"text":"The humans linger and watch them for a while, then slowly walk on. "}]},{"spans":[{"text":"Out of the corner of her eye, Makarov notices that one of them hang back for a little longer before finally leaving."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"819","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_Team_Running","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Some time later, more squads arrive to help. "}]},{"spans":[{"text":"Makarov finishes mapping out the clearing plan. Just as everyone is ready to get started— "}]},{"spans":[{"text":"AAT-52 passes the spot where the humans have passed through earlier and cries out in surprise."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Whoa, look! Supplies just spawned here!"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Energy drinks and some canned food?"}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"It must be heaven showing mercy, dropping gifts just for me!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Makarov calmly takes them."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"They were left by the group of humans that just walked past."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"I thought those humans hated us..."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"It's just a simple thank-you. Don't overthink it."}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Maybe it's because they thought I'm cute?"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2"}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"No. Get lost."}]}]},{"sprites":[{"prefab":"92typeMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Type 92","narrator":false,"pages":[{"spans":[{"text":"Quit daydreaming and get to work!"}]}]},{"sprites":[{"prefab":"AAT52","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AAT-52","narrator":false,"pages":[{"spans":[{"text":"Kaaaaay...."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Doll squad starts clearing debris off the road while Makarov contacts the Commander."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Command room."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Commander, road-clearing work on the A661 has begun. At the moment I can't give an estimated completion time.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How long before you can give me a rough timeline?"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"In about an hour I'll have a clearer estimate.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I need to make the projection based on actual progress and difficulty.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Understood. Stay safe out there."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander. Please take care of yourself too.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After setting all squad assignments and movements, the Commander sighs wearily and decides to rest for half an hour."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Curling up on a not-so-comfortable cot in the corner, the Commander is soon crushed under the tidal weight of exhaustion..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"The Commander feels their soul drift away from their heavy body as they sink into a deep sleep..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"They walk back into another midnight from years past much like this one. "}]},{"spans":[{"text":"Back then, they were younger, more hot-blooded."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"531","raw":"BIN"},{"type":"bgm","value":"BGM_23S_Winter_Night","raw":"BGM"},{"type":"sfx","value":"AVG_21Winter_Subway","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"They have once again returned to that train carriage in their memory."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander wolfs down a can of beef, then avert their gaze awkwardly from the smiling woman sitting across from them."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You seem like a decent person."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Didn't catch that... What did you say?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I said if I'd had a gun, I could've killed them just now."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Marina shakes her head, puts on her earbuds, and starts a movie. The Commander caught a glimpse of the screen; it's a grainy black-and-white film. The resolution was low, but the cinematography was great."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What are you watching?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"\"Ballad of a Soldier\". Seen it? "}]},{"spans":[{"text":"It's my favorite old film, but nobody watches it anymore."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"When the Commander shakes their head, Marina casually offers one earbud."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"9","raw":"BIN"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"531","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half an hour later, the Commander looked up at Marina, thoroughly unimpressed."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"This is your favorite movie? I thought it'd have huge battle scenes."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"It does—Alyosha takes out two tanks right in the beginning."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Two tanks? That's it? "}]},{"spans":[{"text":"If I were the director, I'd show Alyosha leading a tide of steel over the plains, cannons roaring, planes crowding the skies like storm clouds..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Pfft..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What are you laughing at?!"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Nothing, just... that's the sort of thing kids like."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Rounding up, I'm basically an adult. You should talk to me as an equal."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"An adult, huh... Then let's talk about something more grown-up. "}]},{"spans":[{"text":"Judging from your uniform, we're from the same school. What's your plan after you graduate from military school?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're from Suvorov too? Got any advice?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Usually, grads either go to command school to become officers, or straight into the ranks as soldiers."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"And if I don't want to join the military?"}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"Apply elsewhere, study a subject you like, build a different career."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Honestly, I'm not really sure myself. "}]},{"spans":[{"text":"I only got into cadet school through the benefits given to war orphans, to stay off the streets. "}]},{"spans":[{"text":"But I can't be sure I like the military, or even want to be a soldier."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"You're just like I was back then."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't want to turn into you."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Marina","narrator":false,"pages":[{"spans":[{"text":"That's fine. You've still got time. "}]},{"spans":[{"text":"Not everyone finds the path they love, one worth giving their life to."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The movie comes to an end. The sky stretches over the fields as Alyosha's train fades into the horizon."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"That's all we have to tell you about our friend Alyosha Skvortsov. "}]},{"spans":[{"text":"He could have become a remarkable man. "}]},{"spans":[{"text":"He could have become a builder or beautified the land with gardens. "}]},{"spans":[{"text":"But he was, and in our memory will forever remain... "}]},{"spans":[{"text":"A soldier."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep-beep-beep! "}]},{"spans":[{"text":"The sound of an urgent transmission."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander jolts awake and sits up."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes?"}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Sorry to disturb you so late, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"It's fine. Go ahead."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"An hour has passed since we started clearing the A661, but progress is only at about 10% of Phase One.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"At this pace, it'll take at least three days to finish clearing the autobahn.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Three days? That's too slow."}]}]},{"sprites":[{"prefab":"PMMod","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,60","spriteScale":"1.2","commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"We need more manpower, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I understand. Let me handle that."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
