{"name":"10-6-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Battle","raw":"BGM"},{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's forces is fighting their way through the Sangvis encirclement while the AR Team is trying to find a way out of a trench."}]}]},{"sprites":[{"prefab":"RO635","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"M4, we're almost at our limit! How is it going with the Commander?!"}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The Commander's troops still aren't here yet! We must hold on for a little longer!"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"They won't make it in time! The Sangvis forces are right in front of us! We can't hold them back anymore! "}]},{"spans":[{"text":"Right now...our only choice is—"}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Don't be hasty, SOP-II—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang! Bang! "}]},{"spans":[{"text":"...Several Griffin T-Dolls appear out of nowhere and fight off the attacking Sangvis units."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Reinforcement! Reinforcement from the Commander!"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Vivacious T-Doll in glamorous clothes","narrator":false,"pages":[{"spans":[{"text":"Buongiorno! "}]},{"spans":[{"text":"Looks like we're right on time!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She hops into the trench and helps them fend off this wave of Sangvis attack."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Gloomy T-Doll in glamorous clothes","narrator":false,"pages":[{"spans":[{"text":"I actually think we got here a bit too early."}]}]},{"sprites":[{"prefab":"M4A1","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No, you showed up at the perfect time! "}]},{"spans":[{"text":"But who—"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The Carcano sisters? I've heard about you from the Commander!"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Carcano M1938. Call me Cano! "}]},{"spans":[{"text":"This is my little sister Carcano 91/38, or just Ceno!"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Pleasure to meet you, Signorina M4A1 and members of the AR Team."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Sorry about my sister. She's very shy around strangers and struggles with saying what she means. Do forgive her."}]}]},{"sprites":[{"prefab":"M4A1","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Thank you so much, Cano and Ceno! "}]},{"spans":[{"text":"But where is the Commander? The main forces can't get here?"}]}]},{"sprites":[{"prefab":"Carca