,{"sprites":[{"prefab":"NPC-Hoffmann","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Take your pick out of anything within three kilometers."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_2023Slow_Keyboard_Correct","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q grins as she sorts the search results by average price from highest to lowest."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"I don't care what the food tastes like, I'm just gonna pick the most expensive one."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"772","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The midday sun warms up the sofa and shines upon the chandelier overhead, which reflects the dazzling light."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-MK18","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Sonya","narrator":false,"pages":[{"spans":[{"text":"Please go in, Frau Nele."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Thank you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sonya ushers Nele inside. Nele immediately spots her grandfather sitting on the sunlit sofa by the window in the spacious and minimalist lounge."}]},{"spans":[{"text":"She finds herself nostalgically nervous as she faces this old man with hawkish features and piercing eyes that can see through everything."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"Good afternoon, Grandfather."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"...Take a seat."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sonya leads Nele over to a chair opposite the sofa. After pouring her a coffee, she retreats quietly to the side."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"Meyer told me you're looking for a job."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"If memory serves, you graduated from Heidelberg University?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Yes."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"That university's tuition fees have always been exorbitant. Your father was willing to get you in by making a donation?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...No, I got a 1.0 for my Abitur and was given advanced entry."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"Not bad."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"But you were involved in the Galatea scandal?"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...Our contract had already been terminated before things went south."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vogt gently swirls his almost empty cup of coffee and ponders for a while with narrowed eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"How about this—"}]},{"spans":[{"text":"A pharmaceutical company wants me to be a trustee. You can work at their Munich subsidiary as a representative."}]},{"spans":[{"text":"Your mother wouldn't let me intervene in her marriage and insisted on marrying that penniless pauper."}]},{"spans":[{"text":"Ha, I suppose you won't want me to butt in either. I'll let your cousin take care of it."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"If that's all, you can go."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vogt puts down his coffee and slowly gets to his feet to leave the lounge."}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Nele","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"I can see that my mom's description of you is 100% accurate."}]},{"spans":[{"text":"You really are a stubborn, self-righteous old geezer who doesn't give a damn about other people's feelings!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Vogt whirls around in disbelief and glares furiously at the impudent youth."}]}]},{"sprites":[],"ops":[],"speaker":"Vogt","narrator":false,"pages":[{"spans":[{"text":"How dare you speak to me that way?!","style":{"size":"50"}}]},{"spans":[{"text":"Did you come here just to rile me up?!"}]},{"spans":[{"text":"I'll have you know that one word from me and nobody in all of Frankfurt will hire you!"}]}]},{"sprites":[{"prefab":"NPC-Nele","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nele","narrator":false,"pages":[{"spans":[{"text":"...No, that's not why I'm here. I only came because shortly before Mom died, she made me promise I'd visit you when I have time. She was afraid that you would spend your final years in misery."}]},{"spans":[{"text":"She said with your nasty temper and stubbornness, nobody would ever come to see you after you retire."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"bgm","value":"GF_21winter_avg_nightbar","raw":"BGM"}],"speaker":null,"narrator":fal