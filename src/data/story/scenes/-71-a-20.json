{"name":"-71-A-20","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"412","raw":"BIN"},{"type":"bgm","value":"BGM_stage13","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Director's office, Stasi HQ, Frankfurt White Zone."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After going through the last document on the tray, Finn Hoffmann rolls his stiff neck and peers at the clock hanging on the wall."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The meeting should have concluded one hour 27 minutes ago. Things must be really intense at the meeting."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"...I don't think it'll end any time soon."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Finn looks over at Q, who is sitting on the black sofa across from him."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She stacks up the files in her hands and shrugs indifferently."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Things aren't too urgent on my end."}]},{"spans":[{"text":"But Herr Finn, shouldn't we start thinking about lunch?"}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"When Frau Romy's meeting is over, the three of us can eat together."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"...I just want a simple lunch break all to myself."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Finn chuckles. He picks up a pen and spins it slowly around his fingers."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Your presentation isn't urgent, but it's very important."}]},{"spans":[{"text":"If you don't get it done by this afternoon, you won't have any luck getting an appointment at a later date."}]},{"spans":[{"text":"The queue of people who want to see the minister stretches from the Main to the Rhine."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"...Fine. Let me get myself a coffee then."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q has barely stood up when Finn points at the mini fridge to the side."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"There's cold brew americano concentrate in the mini fridge to your left."}]},{"spans":[{"text":"It'll probably give you a bigger kick."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Am I not even allowed time for a cup of hot americano on a winter day in Frankfurt?"}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Such is the work culture in Frankfurt."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Car_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Q opens the fridge and takes out a bottle of iced americano concentrate."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She weighs it on her palm and gives Finn a thoughtful look."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Why don't we have a wager?"}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"On what?"}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"Whether Frau Romy's negotiation goes well."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"What's the bet?"}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"I know better than to ask for a day off, so I'll just say a free lunch later."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Fine."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"It's obviously a long and tough battle since she's running so late."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"I bet it went really well."}]},{"spans":[{"text":"And Frau Romy received some unexpected good news."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Finn Hoffmann","narrator":false,"pages":[{"spans":[{"text":"Oh? Why do you think so?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Finn sits up straighter in his chair, showing that he is all ears."}]}]},{"sprites":[{"prefab":"NPC-maya","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Q","narrator":false,"pages":[{"spans":[{"text":"We're on an aggressive offensive here. If it hadn't gone well, the meeting would've been over pretty soon."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ding!"}]},{"spans":[{"text":"A notification pops up from the intranet."}]},{"spans":[{"text":"Finn quickly leans closer to his monitor to check it."}]}]},{"sprites":[{"prefab":"NPC-Hoffmann","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"s