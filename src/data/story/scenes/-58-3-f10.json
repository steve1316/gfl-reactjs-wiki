{"name":"-58-3-F10","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"449","raw":"BIN"},{"type":"bgm","value":"GF_22W_BGM_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The stuffy wind blows through the tower bridge with a quiet moan. "}]},{"spans":[{"text":"Resting her elbows on the railing, Bramedb watches the movements at the base of the towers. "}]},{"spans":[{"text":"The sound of footsteps comes from behind her, but she does not look back."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I can't believe you didn't look into Sana's background. What's gotten into you?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"You seem to be well-informed about her. "}]},{"spans":[{"text":"When did we get such a powerful sibling, hm?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"From the moment all of the Western Tower's power supply got fed into level 35."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow points to the Western Tower. All of the other floors are no longer producing power, but they're still lit up, with the exception of the 35th floor."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"I've never seen her before. In fact. I've never even heard of her."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Not everyone has the clearance to know about the keeper to the gates of Hell."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb narrows her eyes, but soon she smiles again."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Looks like Gray told you a lot. "}]},{"spans":[{"text":"So, does she have a weakness? Even a simple weak spot will do."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"The price for that is something else entirely."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"There aren't many people who can beat me in electronic warfare. "}]},{"spans":[{"text":"But when she was standing there, I didn't even dare attack. "}]},{"spans":[{"text":"Compared to this brand new daughter of Father's, we're just like those rejects in the Western Tower."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"She isn't Father's daughter."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"She is the \"origin\" of this place."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow points to the 70th level of the Eastern Tower."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Do you know what that place is?"}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"The control center?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow smiles and taps Bramedb on her forehead."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"It's basically this."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"...And what does Sana have to do with that?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Ever seen a bee? "}]},{"spans":[{"text":"The difference between us and her is like that between a worker and a queen."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb leans against the railing and lets out a nonchalant chuckle."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"So we'd better start working hard to power up Her Majesty?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"How do you know that we won't end up being used up to power her in the end?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Ah, you have a point."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Still... have a care for where you're standing, Morridow. I don't want to end up being jabbed full of bee stings."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"The threat of a bee's sting is far worse than the actual thing."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"You're not afraid?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb's eyes turn to study Morridow, who has a foxy smile on her face."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Father values the results we produce far more than our blind obedience. "}]},{"spans":[{"text":"Fortunately, I happen to have a golden ticket in hand, and it's shining brightly indeed."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Tsk. Because you saw \"her\", right?"}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Shhh..."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"If you help me, I don't mind sharing a bit of the benefits with you too."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"As long as that thing's around, you'll have to return obediently to Father's side should the whim strike him, even if you're in the Antarctic."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Are you afraid of that, then?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb turns around and looks at Morridow."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Someday, we will all have to go there. "}]},{"spans":[{"text":"However, I wouldn't mind if that day comes a little later for me, even if it's just for a moment or a minute."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"And what if this place completely disappeared?"}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow glances toward the top of the Eastern Tower, then she traces a word in Bramedb's palm."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Now this is interesting."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Who doesn't like reminiscing about the past, after all? "}]},{"spans":[{"text":"We don't have much time; you'd best place your bets soon."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"You're saying, that little pup upstairs..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow smiles to her."}]}]},{"sprites":[{"prefab":"NPC-MorridowNew","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I think you know what to do now."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"10220","raw":"BGM"},{"type":"background","value":"447","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In an unknown region inside Avernus."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Get lost!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II yells to no avail as she waves her depleted gun around angrily. "}]},{"spans":[{"text":"Her empty hands frantically feel out her surroundings trying to find a path that leads to the light."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Get away from me! Or I'll rip you all to shreds!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"417","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Standing in front of the security monitor, Bramedb sneers as she watches SOP-II flail around desperately in blindness."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"My oh my, you poor little thing. "}]},{"spans":[{"text":"You're being quite cruel to yourself, no? "}]},{"spans":[{"text":"You actually shut off all your sensory inputs and network connections just to avoid my neural cloud attacks."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"Big Sister Bramedb, shall we dispose of her now?"}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Let me think..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb feigns contemplation as she rests her chin on her palm and studies SOP-II on the screen. "}]},{"spans":[{"text":"Then, she seems to think of something and smiles thinly to the white Nyto."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Don't bother. We'll let this lost little pup run around in circles for now. "}]},{"spans":[{"text":"Right now, she can't see her friends' faces or hear their cries. All she can do is cower in the eternal darkness..."}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{"spritePosition":"0,50"}}],"ops":[],"speaker":"White Nyto","narrator":false,"pages":[{"spans":[{"text":"Do you mean we should open the shutters to this sector?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb brings her face closer to the screen and smiles as she strokes the image of SOP-II, who has curled up into a ball."}]}]},{"sprites":[{"prefab":"NPC-Bramedb","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Bramedb","narrator":false,"pages":[{"spans":[{"text":"Poor little puppy. As much as I'd like to keep playing with you... "}]},{"spans":[{"text":"It's time to say goodbye. "}]},{"spans":[{"text":"Come now, tuck your tail between your legs and search for your little friends. If you run fast enough, you might actually get to bid them farewell in time..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bramedb walks out of the monitoring room, all the while laughing derisively."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"RO, did you find Ange?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As SOP-II scrambles to her feet, she feels as if she's standing in infinite darkness."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I wonder how M4's doing now... and if 15's pacing around the Commander again... "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"I wish I could talk to you guys, but..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II can't help but shudder. "}]},{"spans":[{"text":"The nightmares woven by Bramedb have given her a taste of terror, and even though her reason keeps telling her that it's all fake, it still feels so real that she keeps falling for them..."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I'm scared."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II takes a hesitant step in an unknown direction."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I can't see anything or even hear what I'm saying. "}]},{"spans":[{"text":"But I'll find you. I'll meet up with you, and we'll save Ange together. "}]},{"spans":[{"text":"We made a promise, right?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even with her pain inhibitors engaged, SOP-II can feel how heavy and damaged her body is. Simply walking is like torture for her."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Faster, SOP-II... "}]},{"spans":[{"text":"Ange, RO, and 15 are all waiting for you..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dragging along a body that doesn't seem to belong to her, SOP-II struggles to move through the darkness."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
