side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Make it back alive, and I'll tell you, got it?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Deal."}]},{"spans":[{"text":"Think about where to start before I come back."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"10","raw":"BIN"}],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Then let's begin."}]},{"spans":[{"text":"I'm handing ops to you, Makarov."}]},{"spans":[{"text":"First, deploy our forces here..."}]}]}]}
