{"name":"4-4-1N","beats":[{"sprites":[],"ops":[{"type":"bgm","value":"BGM_NightOPS","raw":"BGM"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ten minutes later."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Silence everywhere. Sangvis Ferri haven't made their move yet."}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"They're running tests on some sort of artillery weapon with this city."}]},{"spans":[{"text":"The attack wasn't directed at us, so the possibility of 92 and co.'s survival is very high."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Oh? How do you know?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Someone's looking into it. I got word just now."}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"Just now? After you cried into my shoulder?"}]}]},{"sprites":[{"prefab":"RO","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO","narrator":false,"pages":[{"spans":[{"text":"Don't put it in such an embarrassing way! I was just venting a little!"}]}]},{"sprites":[{"prefab":"PM","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Makarov","narrator":false,"pages":[{"spans":[{"text":"I see..."}]},{"spans":[{"text":"By the way, my way of venting is spreading words of how others vent."}]},{"spans":[{"text":"I've recorded the whole thing. Look forward to tomorrow's Fatebook."}]}]},{"sprites":[{"pre