ags":{}}],"ops":[],"speaker":"Type 79","narrator":false,"pages":[{"spans":[{"text":"You're welcome. I'll be going then. "}]},{"spans":[{"text":"Enjoy!"}]}]},{"sprites":[{"prefab":"79type","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After sending off Type 79, who has hurried off like a whirlwind, the Commander lets out a pained smile."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"How long will it take to finish all this...?"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
