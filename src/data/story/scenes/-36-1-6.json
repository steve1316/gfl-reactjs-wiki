{"name":"-36-1-6","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"19winter_door_close","raw":"BIN"},{"type":"bgm","value":"m_avg_tension","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside the quarantine wall."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We're at the wall. Everyone out."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"And here I thought we'd have to dodge bullets and shells on the way in."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Isn't that a good thing? I mean, if we started off that way, it would be really easy to end up with a crappy ending where the car blows up and everyone dies."}]}]},{"sprites":[{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Don't say scary things like that!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"The defense systems didn't open fire on us. Doesn't quite fit the information we were given. "}]},{"spans":[{"text":"Check the perimeter, see if there are enemies hiding there."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I'm scanning now. Haven't picked up anything suspicious yet."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Good. "}]},{"spans":[{"text":"According to the map annotations, there ought to be a sewer exit we can take to get inside the walls."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I've found it. It's covered by a folding-type shutter. Should we blow it open?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We have no idea what's going to happen next, so we need to make sparing use of valuable items like explosives."}]},{"spans":[{"text":"However, 9 can crack an electronically-controlled shutter of that level. "}]},{"spans":[{"text":"You CAN do that, right, 9?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"UMP9Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Leave it to me, 45!"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"(Gags) This place stinks!"}]}]},{"sprites":[{"prefab":"G11","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Are we really going in there?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Bear with it. It'll only get worse once we actually go inside."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Distant explosions go off, one after the other."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Did you hear that?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"That was cannonfire. Looks like the fighting's already started on the Commander's end..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"The Military's moving faster than I expected. Are you done yet, 9?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I'm looking for the unlocking nodes! "}]},{"spans":[{"text":"There are two control ports which need cracking, give me a hand over there, 45."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Whatever will I do with you... I'm going in too."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"BG-Sewer","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After they enter the quarantine wall through the sewer..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I knew it would smell bad...but I didn't expect it to smell THIS bad..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Just do what Gr G11 did and switch off your smell modules."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"As if I'd learn from a good-for-nothing like that..."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Quiet, everyone... I picked up something irregular inside the passage."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Enemies?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"No...there's no signal reaction... It's probably..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"They're remains from S.F. and Paradeus."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"416 leaps out of the tunnel and lands inside a room."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Hmm, there are traces everywhere of a firefight between S.F. and Paradeus. Looks like they fought over the wall too."}]}]},{"sprites":[{"prefab":"G11","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Oh dear... I can't believe there are so many corpses here..."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Judging by the state of these bodies, it must've happened quite a while ago..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Looks like Dandelion was partially right. S.F. have probably tried to take control of the base before we arrived."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"So is this base under Sangvis control now?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"They probably haven't gained full control access over the base, otherwise there's no way they would leave a place as important as the quarantine wall's main gate undefended."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"So you're saying the Commander still has a chance?"}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"That's only if we can open the gate before the Commander is wiped out by the Military. "}]},{"spans":[{"text":"Plus, we have to make sure there are no other threats underground. "}]},{"spans":[{"text":"Speaking of which, can you verify DEFY's previous coordinates?"}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"I can pinpoint them. Should I try to contact them?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We can't risk exposing ourselves like that. First, we need to make sure that DEFY really is at the coordinates they gave us."}]},{"spans":[{"text":"Come with me to check it out, 416. "}]},{"spans":[{"text":"UMP9, Gr G11, you two guard this passage. If anything dangerous happens, we'll withdraw through it."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Leave it to me. ♪ "}]},{"spans":[{"text":"Happy now, Gr G11?？"}]}]},{"sprites":[{"prefab":"G11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"I...I'm overjoyed..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"After that, close your Zener Protocol interfaces and switch to verbal communication. If need be, use radio—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45 suddenly stops in her tracks."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Huh? What's wrong, 45?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm picking up some interference..."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Another forced connection?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I felt something like this in Tallinn... I'm going to take precautions just in case."}]},{"spans":[{"text":"This might be the reason why DEFY can't transmit to us, or it might be part of an enemy trap."}]},{"spans":[{"text":"In any case, send a burst message to the Commander and the AR Team. We won't make any connections until we reach the quarantine wall control room."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Right, sending!"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"That said, getting this sensation means we're in the right place."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You're just asking for it. Let's hurry up to the coordinates."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Indeed, Captain Obvious."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Shortly before..."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"10130","raw":"BGM"}],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"I'm at the place you were talking about. What now?"}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"She's gone...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What do you mean? Who's gone? Where did they go?"}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"Mastermind relinquished her command. Don't you understand what that means?","style":{"color":"#00CCFF"}}]},{"spans":[{"text":"To her, we're nothing more than disposable pawns.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-11","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Dreamer","narrator":false,"pages":[{"spans":[{"text":"And now, it's time to take out the trash...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What are you talking about?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A burst of intense gunfire rings out from Dreamer's end, and the transmission cuts off."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Dreamer? Answer me!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The sound of orderly footsteps comes from a place not far off."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Who's that? Is it you, Dreamer? "}]},{"spans":[{"text":"No, wait, the signal IFF reads..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the dust clears before her, the girls' nearly-identical faces come into view."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Paradeus...what are you doing here?! "}]},{"spans":[{"text":"You should have all been locked inside!"}]}]},{"sprites":[{"prefab":"NytoWhite","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Dammit...so you're trying to walk all over me?! "}]},{"spans":[{"text":"Let me warn you, I'm not one to be bullied!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Nytos disregard Destroyer's angry protests. They merely approach her in complete silence..."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"What, are you looking down on me?! "}]},{"spans":[{"text":"Move to attack formation and fire—!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Nytos dodge the barrage of shots with swift movements even as they close the distance to the S.F. forces with incredible speed."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Switch to defensive formation! Pull away from them! Fall back! Fall back!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Nytos rip through the Sangvis forces like a streak of lightning."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Retreat! RETREAT! Retreat with me!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"However, most of the Sangvis units have already been hacked - their neural clouds are thrown into disarray, and they are unable to comply. All they can do is scatter in all directions."}]},{"spans":[{"text":"As she watches more and more Sangvis units being torn apart before her eyes, the only thing Destroyer can do is protect herself."}]}]},{"sprites":[{"prefab":"BOSS-6","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Destroyer","narrator":false,"pages":[{"spans":[{"text":"Dammit dammit dammit! "}]},{"spans":[{"text":"All remaining S.F. forces, follow me and withdraw!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With the last few Sangvis forces in tow, Destroyer breaks into a mad sprint towards the shore gun emplacements."}]}]}]}
