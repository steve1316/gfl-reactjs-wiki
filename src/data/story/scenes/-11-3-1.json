{"name":"-11-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"Metro","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Fifteen minutes later."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45, do you copy?! We must abort the mission! "}]},{"spans":[{"text":"Even Sier advices us to retreat to the perimeter for the time being and think of something else!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"No, listen to me. We stick to the plan."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What are you thinking, 45? S.F. knows our every move. "}]},{"spans":[{"text":"No matter how we proceed, it's suicide if we go any further."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":3,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"No... S.F. doesn't know our every move. "}]},{"spans":[{"text":"All they know is MY move."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What? What makes you think so?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Think about it... "}]},{"spans":[{"text":"Destroyer only made the two broadcasts after I said something. "}]},{"spans":[{"text":"And judging from what she said, she couldn't hear you guys."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"But she can hear your voice, right? She can find out what you're doing any time!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I think she can indeed hear my voice, but not \"any time\". "}]},{"spans":[{"text":"Otherwise, she would've just blown us right up rather than only making two broadcasts this whole time. "}]},{"spans":[{"text":"Besides, her new body must still be incomplete, or we would've found her by now."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"So you plan on getting back the drone while the window is still open?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"This is our best shot. "}]},{"spans":[{"text":"If we retreat now, there won't be another attempt. "}]},{"spans":[{"text":"The drone will be theirs - mission failed."}]}]},{"sprites":[{"prefab":"UMP9","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"But how do we know you're making the right call? If this is a Sangvis trap..."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Have I ever been wrong?"}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"...Understood. "}]},{"spans":[{"text":"But 416 and Gr G11 are still out there. We have to meet up with them."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"That won't be necessary. 9, go get the drone. I'll cover you with my echelons. "}]},{"spans":[{"text":"416, head to scouting point eins. Gr G11, scouting point zwei. The two of you monitor every single junction within sight. Report immediately if you detect any signal of a Sangvis Ringleader!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"HK416","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I sure hope your lucky guess is right. Get up, Gr G11. We're going!"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Ugh... I have to do this...on my own?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Don't worry. I'll give you cover."}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"What about you, 45? "}]},{"spans":[{"text":"If you're right, then aren't you their primary target?"}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"G11","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"True. I'm not sure why, but it doesn't help dwelling on it. "}]},{"spans":[{"text":"Keep calm. We only have a tighter deadline. It'll be fine as long as you're snappy. "}]},{"spans":[{"text":"I'll only be safe if you get the drone ASAP."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"45 claps her hands twice."}]}]},{"sprites":[{"prefab":"UMP45","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Chop chop, girls. "}]},{"spans":[{"text":"Get your hands on the drone and let's all go home!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"White","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]}]}
