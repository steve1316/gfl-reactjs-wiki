{"name":"-59-a-3-start","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Persica","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"},{"type":"background","value":"607","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"This can't be right... Something's off... How could it have turned out this way?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Miss Persica, you have circled around me 189 times in the past 10 minutes."}]},{"spans":[{"text":"This is a serious case of obsessive and compulsive behavior. Do you require some psychiatric consultation?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"No, no, no... Not like that..."}]},{"spans":[{"text":"Maybe we should..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Miss Persica? If you keep ignoring me, I'll have to resort to more drastic measures."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Hmmm... "}]},{"spans":[{"text":"Guess we have no choice but to do it this way. DoROemon, bring me another cup of coffee."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Given we're the only entities with consciousness here, I'll assume you were addressing me for now."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"After that, go raise the difficulty to its peak value. Actually, no. Go reprogram the parameters and raise the peak values."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Miss Persica, I suggest we conduct a psychiatric evaluation on you before we consider our plan ahead."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You think I've gone mad?"}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"According to your schedule this year, you have been working continuously around the clock without taking a single day off. "}]},{"spans":[{"text":"Under such prolonged high-stress conditions, it is common for human beings to fall into a state of insanity."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Alright, I get it. Please slowly step down from the edge of the window. "}]},{"spans":[{"text":"I'll get you your coffee."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"I've reworked the parameters. You can now go synchronize the new data, configure it, and implement it in Test No. 3."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Drink_Tea","raw":"SE1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Allow me to remind you again that under this difficulty setting, AR Team will have an extremely high probability of succumbing to fatal damage."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"When they carried out Operation Viper, no one told them in advance that there was a risk of being destroyed. "}]},{"spans":[{"text":"But they completed the mission nonetheless, and even made it back to the base alive."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":8,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Test No. 3, start."}]}]},{"sprites":[{"prefab":"RO635-NoArmor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Roger."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
