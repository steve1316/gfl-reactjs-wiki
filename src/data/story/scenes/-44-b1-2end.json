{"name":"-44-B1-2End","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"10065","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"269","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"We run wildly without looking back. "}]},{"spans":[{"text":"Thanks to Dandelion's remote support, I finally see the AR Team come into view and can breathe a sigh of relief at last."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"My cover was blown and the mission is a failure. "}]},{"spans":[{"text":"More importantly, let's get Machlian out of here—"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Isn't this woman our mission objective?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"She looks just like the woman in the picture!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"335","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"269","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"My heart skips a beat. I immediately turn to get a better look at Machlian. Her hood has been blown off her head at some point."}]}]},{"sprites":[{"prefab":"NPC-Machl