n":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAR-21","narrator":false,"pages":[{"spans":[{"text":"Well, that's your problem, my lady."}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Ha. Aren't you worried that I won't come get you?"}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAR-21","narrator":false,"pages":[{"spans":[{"text":"You said your mission is more important than your friends. Or was that a lie?"}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"...Alright, I shouldn't have tried to haggle. "}]},{"spans":[{"text":"On my mark. Open the gates of the factory when I give the order."}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"TAR-21","narrator":false,"pages":[{"spans":[{"text":"Ready whenever you are."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Click. Transmission terminated."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"The clock is ticking, Commander. We gotta pick up the pace. "}]},{"spans":[{"text":"...Hold on, did you fall asleep? "}]},{"spans":[{"text":"Jeez... I put some energy drinks in the fridge. Grab a can and down it all now. "}]},{"spans":[{"text":"Okay? Then hurry. I'll be waiting."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"shake","raw":"震屏"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Crack! "}]},{"spans":[{"text":"...Gulp. Gulp..."}]}]},{"sprites":[{"prefab":"NEGEV","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Well? Feeling better? "}]},{"spans":[{"text":"Seriously, just imagine if I weren't your adjutant. "}]},{"spans":[{"text":"Now buckle up. It'll be bad news if we miss the chance and run into the Ringleader. "}]},{"spans":[{"text":"...What? I'm not afraid. Isn't it my job as your adjutant to find the best solution for you? "}]},{"spans":[{"text":"...That's right. We can't let all our efforts and sacrifices be in vain. Let's go!"}]}]}]}
