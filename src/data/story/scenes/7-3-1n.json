{"name":"7-3-1N","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"So you abandoned your friends?"}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"I didn't forget what you'd taught me, Jericho. "}]},{"spans":[{"text":"My mission is more important than my friends because..."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Because T-Doll friends can be rebuilt, but a failed mission is failed. "}]},{"spans":[{"text":"Looks like you stick to this principle better than I do."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Someone has to keep your flair alive. And someone has to be play the villain."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You have your own path to walk, Negev."}]}]},{"sprites":[],"ops":[],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Perhaps you've pointed me to the wrong way."}]}]},{"sprites":[],"ops":[],"speaker":"Jericho","narrator":false,"pages":[{"spans":[{"text":"Oh, I've compiled a list of what's wrong with you. "}]},{"spans":[{"text":"But this... "}]},{"spans":[{"text":"If Griffin's okay with this, then I have nothing to say."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Negev","narrator":false,"pages":[{"spans":[{"text":"Then let me continue. The next part is crucial."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"TAR21","expression":0,"shown":true,"side":"left","tags":{"