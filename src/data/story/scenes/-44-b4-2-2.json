{"name":"-44-B4-2-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"19winter_lab","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Can we turn off the jammers?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We can, but there's a small problem... "}]},{"spans":[{"text":"These Paradeus bastards are really crafty. "}]},{"spans":[{"text":"They've divided the jammers into different groups, and one code can only shut down one portion at once."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"That's not even our biggest problem... "}]},{"spans":[{"text":"If we only switch off some of them, then when we try to crack the other groups... "}]},{"spans":[{"text":"The disabled jammers will automatically reactivate. "}]},{"spans":[{"text":"We need to learn all the codes and switch them all off at once, otherwise it won't solve the problem."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Also, these suppressors have no location data attached to them, only serial numbers. "}]},{"spans":[{"text":"Every group runs on different logic too... It seems Paradeus has someone really skilled in electronic warfare on their side."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"So we still can't contact the Commander?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I'm trying my best. "}]},{"spans":[{"text":"According to the Commander's backup plan, they ought to be in these sectors... So I'll prioritize dealing with this section. "}]},{"spans":[{"text":"The rest is up to fate."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...I hate that phrase."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Who doesn't? "}]},{"spans":[{"text":"But sometimes, that's all we can do."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Click_Keyboard","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Staring at the massive flow of data on the monitor before her, UMP45 taps a few keys on the keyboard and shakes her head."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Hang in there, Commander."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"19winter_inbg_2","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_door_elecport","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After ducking behind a blast door leading to another corridor, the AR Team finally shakes off their pursuers for the time being."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"10230","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"They're really clingy..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"They seem to be holding back."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hm... It's true, it doesn't feel like they're really out for blood."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I think they're trying to capture us alive."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk, they're looking down on us."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"More specifically, they're probably trying to capture the Commander and Dandelion."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...No, I think they might only be going after Dandelion. "}]},{"spans":[{"text":"We still don't know how well they understand her... "}]},{"spans":[{"text":"But I'm sure Paradeus would love to get their hands on a mature OGAS system."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"If I fall into Paradeus' hands, the consequences would be catastrophic."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Dandelion, how far off course are we?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"We're now on the northwest side of the plant. Once we pass through the room ahead, we should be able to return to the main corridor. "}]},{"spans":[{"text":"...Or at least, if the plant is still in its original state."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"This plant looks like it's come to life after being activated. "}]},{"spans":[{"text":"The corridors and doors keep moving. Are you sure this route will work?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I can't be sure."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk, then what good is it?!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"That's enough. We need to pick up the pace. "}]},{"spans":[{"text":"If the maps don't work, we'll have to go by instinct... Let's start by heading in the direction Dandelion mentioned."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Speaking of which... "}]},{"spans":[{"text":"...Do you guys hear voices?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Girl_Singing","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The group stops. The voices of an ethereal choir are coming from the room ahead."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I think I've heard this before."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh! "}]},{"spans":[{"text":"The three members of the AR Team raise their guns in unison."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"They're Isomers."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"(Snarls)"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What do we do, Commander?"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...There's no way back. We have to go forward."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Got it."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO635 carefully approaches the room. After pausing for a moment, she kicks the door in."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Factory","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh! "}]},{"spans":[{"text":"Three sets of gun muzzles cover the interior of the room, and SOP-II nearly opens fire. "}]},{"spans":[{"text":"However..."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What is this?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_Girls_Chorus","raw":"SE1"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander moves past the three Dolls and enters the room. "}]},{"spans":[{"text":"Dandelion, on the other hand, stares blankly at the rows of incubation tanks in the room—it would seem this room is yet another lab. "}]},{"spans":[{"text":"Inside the tanks are naked girls floating in a liquid of unknown composition. Despite the presence of intruders, they keep singing in their thin, reedy voices."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Are they...still alive?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...No."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dandelion goes up to the master control terminal and accesses a subsystem through a local connection."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...They're all dead. "}]},{"spans":[{"text":"Brain dead."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"But...they..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...You're telling me all these singers are corpses?"}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...Yes. "}]},{"spans":[{"text":"Their brains are no longer functional, and their singing is a form of...muscle memory. "}]},{"spans":[{"text":"Their bodies are still alive, and their hearts are still beating, and these machines sustain their biological functions. "}]},{"spans":[{"text":"But they are undoubtedly corpses."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander peers at the girls' youthful faces behind the glass."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Paradeus."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Can you turn off these machines?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Huh? You want to turn them off...? But then they'll..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...They're already dead, SOP-II. "}]},{"spans":[{"text":"We can't let their corpses be defiled any further."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"The local databases have a lot of useful things on them. "}]},{"spans":[{"text":"I'm downloading them all. "}]},{"spans":[{"text":"And now..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"2021white_Factory_Old","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The incubation tanks darken. "}]},{"spans":[{"text":"The girls' song suddenly comes to a halt, and their limbs start twitching by nervous reflex, curling in on themselves unnaturally. "}]},{"spans":[{"text":"Like infants that have returned to their mothers' bodies, they fall silent once more."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"...I'll grant them rest."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Thank you, Dandelion."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"It is also what \"the children\" and I want for them."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I...I don't know what to say..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I know everyone's waxing sentimental. "}]},{"spans":[{"text":"Well, sorry to kill the mood, but we don't have much time."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yeah, now that the mystery's solved, let's continue onward—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! "}]},{"spans":[{"text":"The Commander is interrupted by the sound of an explosion."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"That sounded like..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"EMP grenades! "}]},{"spans":[{"text":"It's Squad Griffin!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Let's go!"}]}]}]}
