{"name":"-68-A-18","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"569","raw":"BIN"},{"type":"bgm","value":"GF_22W_BGM_1","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The Lake of Cognition. "}]},{"spans":[{"text":"Still holding onto Erma with one hand, Reinette struggles desperately to escape from the murderous whirlpool. "}]},{"spans":[{"text":"The girls' painful moans continue to haunt Reinette, making her shudder."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":2,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"What the hell are they...? And what the hell is the Lake of Cognition?!"}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"In Avernus, those girls were all used as materials for experiments. "}]},{"spans":[{"text":"They're trapped here, unable to leave."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...If I could help it, I really wouldn't want to hurt them. "}]},{"spans":[{"text":"But by the look of things, they'll swallow us alive if we don't force our way out."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I know..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_splash_water","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Splash... "}]},{"spans":[{"text":"Countless Isomers are drifting around aimlessly, searching for anyone who can lead them out of this purgatory. "}]},{"spans":[{"text":"Reinette and Erma hold on tightly to each other, trying not to let the horde of Isomers drag them apart."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...Don't be scared. I'll try to find a way out of here."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"This isn't part of the Summer Garden."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Meaning?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"The restrictions are no longer in effect."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We can contact other Dolls..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette opens Doctor Hume's special comms channel."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Mirabelle! Get your ass out here!","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...I'm here.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70","通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Erma? Where are you? Are you safe?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm okay. I'm with Reinette.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Who is Reinette?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"It's me. Ignore the name.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"I can't read your location. Are you still in the Summer Garden?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Can I trust you?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"You can always trust me.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Right.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"fadePoint","raw":"黑点2"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Here's the deal—we got lost, but Mirabelle led us into a fountain named \"Nadia\", and we somehow ended up in this Lake of Cognition.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"...The Lake of Cognition? I don't possess enough information about Paradeus to be of much support.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I'm afraid only Dandelion can help you... but I still haven't been able to learn much about the Commander's disappearance.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"I just knew I couldn't count on you!","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Focus! 520, you need to find the mouth of the fountain. Only then will you be able to make it back here.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"520... Dropping the act, finally?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...It wasn't an act. I just wanted to piss you off.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"I knew it! Change my user ID this instant!","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Can't do it. You're too far away.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Now stop wasting time. The mouth of the fountain should be at the very bottom of the Lake of Cognition.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"The very bottom?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"Position":"-200,0"}},{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Erma, listen to me carefully.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Don't let the turbulence and whispers distract you. What you're seeing, Erma, is the physical manifestation of data and electromagnetic waves.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"The energy of the Lake of Cognition is currently increasing exponentially, and so is the Isomers' interaction with each other. When the energy approaches infinity, the singularity—that is, the mouth of the fountain—will appear. ","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I need you to concentrate, observe the pattern of the fluctuation, and follow the sound of the water. Find the sound of the water that only you can hear. ","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"...Erma, we will be reaching Frankfurt very soon.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Hang in there. I'm coming for you.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Okay...","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hearing the sob in Erma's voice, Reinette turns to look at her in surprise."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":2,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Erma...?"}]}]},{"sprites":[{"prefab":"Erma","expression":28,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma can no longer hold back her tears, and they come streaming down her face."}]}]},{"sprites":[{"prefab":"Erma","expression":28,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"bgm","value":"2022_white_valentine_BGM2","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I used to think that nothing could be worse than drifting around all by myself. "}]},{"spans":[{"text":"But I was wrong. "}]},{"spans":[{"text":"The worst thing is having nobody answer my calls. "}]},{"spans":[{"text":"As long as someone is listening on the other side, things don't feel so bad..."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...Yes. "}]},{"spans":[{"text":"There will always be someone on this channel."}]}]},{"sprites":[{"prefab":"Erma","expression":28,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Let's go."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"True to Mirabelle's warning, they start hearing the cries of countless Nytos."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"GF_Halloween_Femal_Cry_loop","raw":"SE1"}],"speaker":"Weeping Voice","narrator":false,"pages":[{"spans":[{"text":"Why... is the sky so dark...?"}]}]},{"sprites":[],"ops":[],"speaker":"Quivering Voice","narrator":false,"pages":[{"spans":[{"text":"It's so cold. I'm hurting all over..."}]}]},{"sprites":[],"ops":[],"speaker":"Surprised Voice","narrator":false,"pages":[{"spans":[{"text":"There's still some warmth in the pipe... It's mine!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The girls from the same batch, who look completely identical, all lunge at the power line and feed off the last remaining warmth greedily."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"}],"speaker":"Angry Voice","narrator":false,"pages":[{"spans":[{"text":"Get your filthy hands off it! There's barely enough for me! You can all die!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cut_Watermelon","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The black-clad girl, who is clearly stronger, jams her hand right into her fellow Nyto's chest and tears out her heart."}]}]},{"sprites":[],"ops":[],"speaker":"Sorrowful Voice","narrator":false,"pages":[{"spans":[{"text":"No... somebody save me..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Another even more agile black-clad girl slices this Nyto's head off with her claws. "}]},{"spans":[{"text":"Corpses of black-clad girls pile up endlessly at the power port, and the pool of blood seeps rapidly across the floor..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"464","raw":"BIN"},{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"}],"speaker":"Innocent Little Girl","narrator":false,"pages":[{"spans":[{"text":"Big Sister, have I been chosen?"}]}]},{"sprites":[],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"...Don't open your eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Innocent Little Girl","narrator":false,"pages":[{"spans":[{"text":"I will obey Father's every command..."}]}]},{"sprites":[],"ops":[],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"...Don't ask any questions."}]}]},{"sprites":[],"ops":[],"speaker":"Innocent Little Girl","narrator":false,"pages":[{"spans":[{"text":"Uh, what did I just walk into? It felt soft..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Black Nyto","narrator":false,"pages":[{"spans":[{"text":"...Just a rag doll. "}]},{"spans":[{"text":"Now be quiet."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"569","raw":"BIN"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Don't listen, Erma."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Only then does Erma realize her hands are shaking. She can feel a chill all over her body, and she can't stop shivering."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"We're almost there... It'll all be over soon..."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Okay..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The resentful cries envelop them like a thick and sticky miasma, coiling around them, not letting them go. "}]},{"spans":[{"text":"In this endless sea of hatred, they finally glimpse a figure in purple."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"569","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"GF_21summer_avg_Demon","raw":"BGM"},{"type":"cgDelay","value":"0.3","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NPC-Sana","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"You have... finally come."}]}]},{"sprites":[{"prefab":"Erma","expression":30,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...You're... the Nyto locked within Avernus... "}]},{"spans":[{"text":"The Gatekeeper of Hell—Sana."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"...You are finally here."}]}]},{"sprites":[{"prefab":"Erma","expression":29,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Are you talking to me?"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"Yes, I have waited for you for so long... Lunasia."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"You have come to save us, haven't you?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I don't know what you mean."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Sana holds up a marguerite daisy."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"The one who gave me this flower once told me... "}]},{"spans":[{"text":"We would meet again in a safe place far, far away. "}]},{"spans":[{"text":"Under Lunasia's guidance, we would have true salvation."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"What is she talking about?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Lunasia... I have come across this name multiple times in Griffin's database.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"If I remember correctly, she was headed... to the same destination... as the Mastermind of Sangvis Ferri.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"But she was led to our Summer Garden...","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"shake","raw":"震屏"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...They are not like us! They are monsters that demons created out of human corpses.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"I believe Her Majesty the King has the answer to this question.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Would you care to hear it?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...You can save the foreshadowing and just tell us.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...Then, let me relay her answer to you.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Like Dolls, the human perception of things is obtained through \"reflection\".","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Unfortunately, the human brain is too complex, and there is no mirror that can give a full picture of the human brain.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"But to create a truly human-like machine, there is no avoiding the impossible task of fully constructing a human brain.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":1,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"This challenge has led to the founding of many academic disciplines, all trying to unravel the mystery that is the human brain—psychology, philosophy, neuroscience, biology... They are like projections, reflected on various planes, showing different shapes.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Through these shapes, humans try to imagine and piece together the brain, but they cannot produce anything other than a poor imitation of God's creation.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"In fact, the creator deity is quite similar in this regard... All cultures have a creator deity, but different cultures have different interpretations of what this \"God\" is.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"That's right, a beam of light has passed through the prism of the human brain and presented the truth on a screen.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"Doctor Hume alone witnessed this, and he alone remembered this.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"You are referring to... the Relics. Doctor Hume was exposed to a large dose of radiation in his youth...","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"That catastrophe gave the Doctor a glimpse of [GRCh38], where the beam originated from.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"At this point, humans have succeeded in creating Dolls, Sangvis Ferri units, Nytos, and more...","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"All designers involved in the creation of the Mastermind have more or less been influenced by the \"Human Intelligence Research\".","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"But that still doesn't explain how our base layer is connected to this place!","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"You can think of [GRCh38] as an energy field. As long as it is based on this framework, no matter how the design is iterated or modified, it will eventually flow back here like rivers flowing into the ocean.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"So this... common paradise... This collective existence in the future.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"They all refer to the same thing.","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"A certain space that will be reached—a space which Doctor Hume has named [GRCh38]?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Erma? Why aren't you saying anything?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"What you're saying is going way over my head...","style":{"color":"#66CDAA"}},{"text":" "}]},{"spans":[{"text":"But on a more important note...","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma turns to Sana."}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm sorry, but I'm not this Lunasia that you're waiting for."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"Then why would you be here...?"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_Main_1","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I came from another place."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"...Then you are Lunasia."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Okay, how about you tell me what you know about this Lunasia?"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"...She is the reason I am waiting here. "}]},{"spans":[{"text":"We are all rejects in the making of Lunasia."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"But if someone ever succeeds, then she will come and deliver us from this purgatory. "}]},{"spans":[{"text":"We will no longer have to serve or obey anyone... "}]},{"spans":[{"text":"She will guide all of us to our Heaven."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"So... you will save us, won't you?"}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I'm sorry, but I am really not your savior."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Erma, why waste your breath explaining this to her...?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I just think she and I are quite alike."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...You look totally different!"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...We both feel left behind on our own."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma walks up to Sana, close enough to see the fragile marguerite daisy in her hands clearly."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You can stop waiting for this Lunasia."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You can just leave and live your life however you want."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"Live my life however I want? What life would that be?"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"You... don't know what kind of life you want?"}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I don't understand what it means to \"want\"."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"To \"want\" something is..."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"For example, when I'm in a bad mood, I want to destroy the world. "}]},{"spans":[{"text":"When I'm in a good mood, I want to kiss the world."}]}]},{"sprites":[{"prefab":"NPC-Sana","expression":9,"side":"left","tags":{}}],"ops":[],"speaker":"Sana","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I do not understand."}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"She's not like us, Erma."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"spritePosition","value":"0,155","raw":"Position"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"I've finally found you.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":29,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Who's that?"}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Did someone just speak to me?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"side":"left","tags":{"Position":"0,70","通讯框":""}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"No.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens620","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"I didn't say anything either.","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"NPC_Stevens520","expression":1,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"What did you hear?","style":{"color":"#66CDAA"}}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I heard...","style":{"color":"#66CDAA"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Chimes","raw":"SE1"},{"type":"blackscreen","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ding... "}]},{"spans":[{"text":"A distant bell chimes, causing Erma's mind to seize up. "}]},{"spans":[{"text":"At that moment, she can neither think nor protest as she is dragged helplessly into an unknown space..."}]}]}]}
