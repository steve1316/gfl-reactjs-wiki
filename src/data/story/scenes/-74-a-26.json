{"name":"-74-A-26","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202404_ELMO_Frankfurt","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...On board the Elmo."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander, Styx has escaped. "}]},{"spans":[{"text":"Just as expected."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Good. "}]},{"spans":[{"text":"Is the tracking signal clear?"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Very clear. 404 and DEFY are already on her trail."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Tell them to maintain pursuit for now. They mustn't go too deep. Wait for us."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"GF_21winter_avg_pathfinder","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep-beep. An incoming call through an encrypted comms channel."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander, it's the Earl."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Patch it through."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander mentally prepares themself before turning toward the image on the comms screen."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Sir, do you have instructions?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"First, allow me to congratulate you. You have brought honor to yourself and G&K in Frankfurt.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I only did my duty as a soldier."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"You will receive the reward you deserve.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And the Griffin Dolls will be granted more privileges.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I thank you on their behalf."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander gives perfunctory responses to the small talk, their fingers drumming the desk idly all the while."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Your mission in Germany is over.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Once you return to Berlin, perhaps we can share a drink with Kryuger.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Is that so? I don't think it's over."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"The mastermind, Carter, is dead.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"How could it not be over?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What about Paradeus? What about William? "}]},{"spans":[{"text":"Earl, you know full well this is far from over."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"But you have done your part.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Leave the rest to me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...And what will you do? "}]},{"spans":[{"text":"Absorb Paradeus? Recruit William? "}]},{"spans":[{"text":"Earl, you sit in an office far removed from the battlefield. "}]},{"spans":[{"text":"From where you sit, you can't see the suffering of the people, their blood and tears. "}]},{"spans":[{"text":"The ones who died because of the Iaso's Boxes, the ones used as test subjects by Paradeus. "}]},{"spans":[{"text":"Did they ever exist in your eyes? "}]},{"spans":[{"text":"To you, they were nothing but necessary, insignificant sacrifices, weren't they? "}]},{"spans":[{"text":"William's life is worth more than all of theirs, isn't it?"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"I've been on the battlefield far longer than you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"But you no longer see the sacrifices on the battlefield!"}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"The URNC is about to be formed. Oberstein and Carter will take the blame for everything.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This is the greatest consolation we can offer the dead!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Would you ignite war in the coming age of peace, Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The dead won't be swayed by your rhetoric. "}]},{"spans":[{"text":"Ask them if they'd accept this so-called peace."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"The living must live for the living.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The living must strive for the living.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...That may be your future. "}]},{"spans":[{"text":"But it is not mine."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Commander, you are too young.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So young you think yourself invincible.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"So young you forget who gave you the might to speak with such self-assurance.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Griffin","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Earl","narrator":false,"pages":[{"spans":[{"text":"Kryuger's indulgence has made you forget how the world works.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk. The other side cuts the transmission. "}]},{"spans":[{"text":"AR-18 watches the commander quietly."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...I'm fine."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander releases their grip on the deformed sofa armrest and rubs their throbbing temples."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"He won't let this go."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Should we take any precautions?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before the Commander can respond, another incoming call chimes."}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"0,100"}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"AR-18","narrator":false,"pages":[{"spans":[{"text":"It's Mr. Havier."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Answer the call."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Long time no see, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"bgm","value":"BGM_stage13","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hello, Mr. Havier."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"You look terrible. You could use a long vacation.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Right now, what I need is ammo."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Let's talk about something more cheerful, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You are about to be decorated with the Gold Star medal, the highest honor any Soviet soldier could dream of.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...And what must I give in return?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"You've already paid the price.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Now it's time to take your eyes off other people.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Focus on yourself, Commander.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"A brilliant future lies ahead of you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"So I'm supposed to abandon the hunt for William for this so-called future? "}]},{"spans":[{"text":"The Earl sent you to play the good cop, didn't he?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"After all this, after a road paved with blood and corpses... "}]},{"spans":[{"text":"What lies behind me is not a red carpet of glory, but a blood-red blade that drives my vengeance."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"If you still consider me an old friend, you should consider my advice carefully.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Right now you stand at a critical crossroads. You can become a hero honored with the Gold Star for your service to your country and people.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Or vanish into obscurity. Erased from existence.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"If my medal must be bought with such a choice, that is a true insult to the Gold Star."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"},{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"William must pay for what he's done!"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The Earl was right. You won't listen to anyone right now.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Kryuger gave you too much freedom.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"And now, like you, he refuses to speak with the Earl.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In that case... let this old nobody handle it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...What do you mean?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Have you heard of the Nidhogg Protocol?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"The what?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"If it is activated, all cooperation between IOP and G&K will cease.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This protocol will shut down all IOP-made Dolls.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"It will forcibly revoke your command authority.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Do you think that will make me yield? "}]},{"spans":[{"text":"Mr. Havier, even without the Dolls, I will never give up the hunt for William."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I just hope you'll cool your head.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Commander, I've watched you come this far, and I know how hard-won your achievements are.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You're one step—just one step—away from seizing it all with your own hands.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"One step away means never reaching it, Mr. Havier. My answer hasn't changed."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A sigh of regret comes from the other end of the line."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Thank you for all you've done.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...The last thing I can do for you is to stagger the activation of the protocol.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You have 12 hours.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"During that time, I will initiate the Nidhogg Protocol starting with the weakest Dolls.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Whatever you intend to do, you have 12 hours to finish it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...In any case, thank you."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":1,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Take care, Commander.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Havier ends the call."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"black","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202404_ELMO_Frankfurt","raw":"BIN"},{"type":"night","raw":"Night"},{"type":"sfx","value":"AVG_Power_Down","raw":"SE1"}],"speaker":null,"narrat