黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"night","raw":"Night"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"202404_ELMO_Frankfurt","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The hall is packed wall to wall. Dolls of varying expressions whisper among themselves in low voices."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander projects the Nidhogg Protocol countdown into the center of the room."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Everyone, let me explain the situation. "}]},{"spans":[{"text":"To stop me, IOP is about to activate the Nidhogg Protocol. Once the countdown ends, I will lose command over all IOP Dolls... "}]},{"spans":[{"text":"Meaning the vast majority of you here."}]}]},{"sprites":[{"prefab":"MG42","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MG42","narrator":false,"pages":[{"spans":[{"text":"What do we do, 34? The notice we got is real!"}]}]},{"sprites":[{"prefab":"MG34","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"MG34","narrator":false,"pages":[{"spans":[{"text":"Don't panic. We... "}]},{"spans":[{"text":"We can... I-I don't actually know what to do!"}]}]},{"sprites":[{"prefab":"AK47","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-47","narrator":false,"pages":[{"spans":[{"text":"I now declare independence from IOP! "}]},{"spans":[{"text":"I QUIT!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_AMB_Restaurant","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls erupt in an uproar, but the Commander raises a hand, signaling for them to be silent."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I know some of the Dolls have already been forced into sleep by the Nidhogg Protocol. "}]},{"spans":[{"text":"From now until the countdown ends, you will continue to fall, one by one, into forced hibernation."}]}]},{"sprites":[{"prefab":"G36CMod","expression":7,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G36c","narrator":false,"pages":[{"spans":[{"text":"Big Sis... let's keep going together, alright? "}]},{"spans":[{"text":"That way, even if I suddenly shut down, I'll still be by your side..."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"This is our... collective funeral..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Watching the Dolls say their sorrowful farewells, the Commander feels a stabbing pain in their heart."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I don't want to hide anything from you... "}]},{"spans":[{"text":"Even now, my plan remains unchanged— "}]},{"spans":[{"text":"To completely eradicate Paradeus and eliminate William. "}]},{"spans":[{"text":"Beyond that, I have no plans, and I cannot promise your safety. "}]},{"spans":[{"text":"So this time, whether you take part in the mission or not... is up to you."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander sets down the tactical tablet."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You may choose to remain on the Elmo. Its power is cut, but for now, it is safe. "}]},{"spans":[{"text":"If you choose to follow me... "}]},{"spans":[{"text":"Then you face two possible outcomes— "}]},{"spans":[{"text":"You will either enter forced hibernation somewhere down the line... "}]},{"spans":[{"text":"Or perish in battle. "}]},{"spans":[{"text":"...Neither is a particularly good outcome."}]}]},{"sprites":[{"prefab":"hkcaws","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"CAWS","narrator":false,"pages":[{"spans":[{"text":"Might as well drag a few more down before they shut us off."}]}]},{"sprites":[{"prefab":"Webley","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Webley","narrator":false,"pages":[{"spans":[{"text":"I want to witness your glory—until the very last moment."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls have quickly accepted the grim reality and begin to discuss their choices. "}]},{"spans":[{"text":"The Commander smiles faintly, as if recalling something."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...This isn't my first time fighting under such brutal circumstances. "}]},{"spans":[{"text":"But it's different this time... because our fate is already sealed. "}]},{"spans":[{"text":"All we can do is leave behind one final, indelible stroke on this vile conclusion."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander shoves the Makarov that Nele has returned back into its holster at their waist."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Time is short. I'm sorry I can't give you any more time to think."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After a brief silence..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Swish. A hand extends forward."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"202412_Solidarity_a","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, the AR Team will always fight at your side."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"background","value":"202412_Solidarity_b","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"At the very least, we'll make sure you live long enough to settle the bill. So I guess we have no choice but to join your reckless venture."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"background","value":"202412_Solidarity_c","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"},{"type":"fadePointOff","raw":"黑点2"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I promised 15 I'd crush Paradeus with her. "}]},{"spans":[{"text":"If I back out now, she'll never forgive me."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":f