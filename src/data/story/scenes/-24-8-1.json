{"name":"-24-8-1","beats":[{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"Come to think about it, why did I even join Griffin in the first place? "}]},{"spans":[{"text":"If I had gone to work at a civilian firm, the worst that could have happened would be getting bullied for being a newcomer, right? "}]},{"spans":[{"text":"Humans, Dolls, I wouldn't be surprised by anything that the world could throw at us now."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Gunkill","raw":"SE2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bangbang!"}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Cx4 Storm","narrator":false,"pages":[{"spans":[{"text":"I accepted the Imprint and became a Tactical Doll in order to protect myself and to keep people from ever bullying me again. "}]},{"spans":[{"text":"But...why did things end up like this? "}]},{"spans":[{"text":"If I'd just gone and been a maid or a clerk, the worst thing that could've happened would be having a trash can dumped over me in the streets or something ... It'd still be better than dying in a place like this, right?"}]}]},{"sprites":[{"prefab":"BOSS-1","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[{"type":"background","value":"BG-WildBattle","raw":"BIN"},{"type":"fadePointOff","raw":"黑点2"},{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Scarecrow","narrator":false,"pages":[{"spans":[{"text":"There's no point hiding, you Griffin trash.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Cx4Storm","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","v