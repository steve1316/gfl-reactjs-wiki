{"name":"10-3-1E","beats":[{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"},{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An hour ago, in the trench where the AR Team is fighting."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You're finally here...Judge!"}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"I'm not interested in you. Where is M4A1?"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Aren't you the ones hacking her?! You won't find her!"}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"Scooping out someone's neural cloud and measuring its worth... "}]},{"spans":[{"text":"...I don't enjoy doing it, but it's just part of a Judge's job."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"It's a piece of cake storming in here, Signorina Judge."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"But the Commander's troops are pouring in from outside. Your rear forces won't be able to withstand them!"}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"I don't care about what happens to my rear forces. All that matters is your judgment."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Even if you have M4A1, you won't make it out alive! "}]},{"spans":[{"text":"The Military is about to capture your Mastermind! Aren't you the slightest bit worried?"}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"You know nothing, M4 SOPMOD II. "}]},{"spans":[{"text":"You've spent so much time with M4A1, yet you don't even know what she's worth."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"I don't give a damn what she's worth! She's my friend – my family! Nothing else matters!"}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"Then die for her right here!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The Sangvis vanguard are headed straight for them."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Ceno, can you handle this?!"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Easy peasy. I can take another wave."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"You're clearly hurt, Miss Ceno! Find cover!"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Draw back and huddle up near me!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The surviving T-Dolls draw together and concentrate their fire to repel the Sangvis assault."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Take a break, Ceno. See if anyone is responding to our distress call."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"...Nothing, sorella, but there's something else. "}]},{"spans":[{"text":"A military signal is approaching in our direction. Specs unknown."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Battlefield","raw":"SE1"}],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Is that reinforcement from the Military? We couldn't contact them at all."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"We still can't. I don't know if it's reinforcement and I honestly don't care. "}]},{"spans":[{"text":"The Military isn't even willing to spare some time to help out us poor Griffin T-Dolls."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"Gunfight","raw":"SE2"}],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"At least it's an ally. Keep sending the distress signal. "}]},{"spans":[{"text":"It's not entirely hopeless for us! The Commander will be here soon! Just hold on for a little longer!"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Miss Cano, Miss Ceno... "}]},{"spans":[{"text":"I'm sorry we dragged you into this."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Haha, it's our honor!"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Don't speak for me."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Hey, you're the one who told me about the situation here, Ceno."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"I only wanted you to get in trouble."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What are you talking about? How did you even learn of our situation?"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Wake","raw":"BGM"}],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"We heard it from XM3. "}]},{"spans":[{"text":"We and XM3 joined Griffin at around the same time. She was killed in a mission to protect Signorina M4A1 earlier..."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Her first death was meaningful. I envy her."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Fortunately, her neural cloud wasn't too badly damaged. "}]},{"spans":[{"text":"She said she still remembered M4A1 and wanted us to pass on a message to her."}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What message?"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"She wanted to say sorry. "}]},{"spans":[{"text":"If she'd known she would die so soon, she would've softened her words."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"As in she would've been more forthcoming about how she really felt."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"But since she's still stuck in the repair bay, we're here to deliver the message instead."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Don't misunderstand. We only came because the Commander gave the order."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Though we did volunteer to bolster our numbers."}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Such a ruthless battlefield. I weep for all our losses."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"You're obviously crying because of your wounds. Don't try to hide it!"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"But this IS a battlefield. You came diving in all because of what she said? Isn't that a bit excessive?"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"It's precisely because this is a battlefield. "}]},{"spans":[{"text":"Whether it's the AR Team, Ceno and I, or even other T-Dolls, we all live on in each other's neural cloud. "}]},{"spans":[{"text":"If we can't even keep each other's memory alive, who would remember us?"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M16A1","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You once asked me...why we're equipped with emotion modules despite being tools of combat. "}]},{"spans":[{"text":"The thing is, having emotions is a flaw in itself, SOP-II. T-Dolls or humans, we are all defective beings."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I don't know... But emotion modules are something that humans gave to us. No one would intentionally make their own products defective right? "}]},{"spans":[{"text":"So...there must be some meaning to all of this."}]}]},{"sprites":[{"prefab":"AR-15","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I'm doing what must be done. "}]},{"spans":[{"text":"Hurry, SOP-II. Get out of the jam. "}]},{"spans":[{"text":"M4 is still waiting for you. Protect her. I'm counting on you..."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"99","raw":"BIN"}],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"SOP-II, how much emotion have you been penning up? "}]},{"spans":[{"text":"Let it all out now and enjoy this fight!"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"And this death."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"SOPII","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Commander...I know you're still fighting for us with everything you have. "}]},{"spans":[{"text":"We are also doing our best to survive, so that we can keep M4A1 safe, so that we can see you again. "}]},{"spans":[{"text":"So please remember me as who I am today. Whether we win or lose, I'm very, very content. "}]},{"spans":[{"text":"I hope we'll meet again. Please, no matter what you do, remember what we did today."}]}]},{"sprites":[{"prefab":"BossJustice","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Judge","narrator":false,"pages":[{"spans":[{"text":"Still not giving up? You won't last much longer!"}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"We don't plan on lasting too long. We only need to last as long as we can!"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Sorella, while there's still time, I just want to say I'm very happy."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"You're telling the truth?"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Duh."}]}]},{"sprites":[{"prefab":"Carcano1891","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Cano","narrator":false,"pages":[{"spans":[{"text":"Heheh, I wish there's more time for us to talk. "}]},{"spans":[{"text":"Alright, Griffins, our moment of glory is at hand! Are you ready for it? "}]},{"spans":[{"text":"Alla vittoria—"}]}]},{"sprites":[{"prefab":"Carcano1938","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ceno","narrator":false,"pages":[{"spans":[{"text":"Alla gloria militar!"}]}]},{"sprites":[{"prefab":"SOPII","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Is everybody here? "}]},{"spans":[{"text":"My dear Sangvis prey, it's time for us to feast. "}]},{"spans":[{"text":"Bon appétit!"}]}]}]}
