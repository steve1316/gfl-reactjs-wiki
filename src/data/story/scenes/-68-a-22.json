rrator":false,"pages":[{"spans":[{"text":"But I'm sad."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"...I'm sad."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...But I'm glad."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"Then let's begin."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Right."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm opening this anchor point."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"...It has been waiting for you for a long time."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Accessing Anchor Point [GRCh38]..."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"698","raw":"BIN"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_BaseDoor_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh... "}]},{"spans":[{"text":"It is an exceptionally beautiful day. The automatic door of the laboratory slides open, and a man exits slowly."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I witnessed the answer, Erma. "}]},{"spans":[{"text":"I finally know what material is needed to reach [GRCh38]."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Wow! Congratulations! "}]},{"spans":[{"text":"Oh, so is Project \"Pilot Whale\" a success?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Yes... Someone has succeeded. She renamed my project as the \"Holy Grail\"."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...So what is the material?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":5,"side":"left","tags":{}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"A human brain. "}]},{"spans":[{"text":"I witnessed the creation in her lab with my own eyes... "}]},{"spans":[{"text":"The dead human girl opened her eyes again..."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":5,"side":"left","tags":{}},{"prefab":"Erma","expression":29,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Isn't this discovery something to be celebrated?"}]}]},{"sprites":[{"prefab":"Erma","expression":27,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"So why do you look so sad...?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"I used the correct formula, but plugged in the wrong data, and was unable to derive the correct answer... "}]},{"spans":[{"text":"Or perhaps I have been avoiding the answer this whole time."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"...Still, this is enough for me. "}]},{"spans":[{"text":"It marks the perfect end for the project."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Erma... Do you wish to become human?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":31,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Huh?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}},{"prefab":"Erma","expression":31,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"You are my own masterpiece. I am giving this choice as my final gift to you."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Erma, you can choose to become human or to stay as a Doll forever. "}]},{"spans":[{"text":"You will be given the complete key to [GRCh38]. "}]},{"spans":[{"text":"Whether you lead humankind or Dollkind to [GRCh38]... "}]},{"spans":[{"text":"...Is entirely up to you."}]}]},{"sprites":[{"prefab":"Erma","expression":31,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Me?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"But I... don't know anything... I'm completely clueless... "}]},{"spans":[{"text":"What is this thing... What is it for... How should I use it... "}]},{"spans":[{"text":"I haven't got the slightest clue. "}]},{"spans":[{"text":"Is it really okay for me to have something so important?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Erma, what are you worried about?"}]}]},{"sprites":[{"prefab":"Erma","expression":30,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I don't know. "}]},{"spans":[{"text":"I just have a feeling I'm about to be given incredible power. "}]},{"spans":[{"text":"But I don't have the knowledge or wisdom to wield such power. I'm scared that I'll make the wrong decision."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"...Wrong? "}]},{"spans":[{"text":"What is right for humans? What is wrong? "}]},{"spans":[{"text":"And what is right or wrong for Dolls?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I'm sorry, I don't know how to answer these questions."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But Arthur Hume demands no answer."}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"...Dolls are creations of logic, so why do you end up having emotions?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Mother, do you have no emotions?"}]}]},{"sprites":[{"prefab":"NPC_Hume","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"For me, they are a distant memory. "}]},{"spans":[{"text":"Perhaps you are more human than me. "}]},{"spans":[{"text":"Why don't you store this anchor point in the Summer Garden for now?"}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"whitescreen","raw":"白屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Yes, Mother."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"688","raw":"BIN"}],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"...We are in possession of the key."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I'm sure countless humans and Dolls covet it."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"Yes."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"bgm","value":"GF_2022_Summer_Main_1","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"But you just want to use it to end your life."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"Yes. "}]},{"spans":[{"text":"To end a life that should never have existed."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"How ironic."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}},{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"I've once heard a story..."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"Once upon a time, a cat with extraordinary intelligence became an eight-tailed cat through meditation and spiritual practice. "}]},{"spans":[{"text":"A deity told her that if she managed to grow another tail, she would achieve immortality and godhood. "}]},{"spans":[{"text":"But the ninth tail was incredibly difficult to grow—it could only be obtained by granting a human's wish. "}]},{"spans":[{"text":"But paradoxically, a tail had to be sacrificed every time a wish was granted."}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"That's the story of the Eight-Tailed Cat."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"Yes. "}]},{"spans":[{"text":"The eight-tailed cat kept practicing and granting people's wishes. She would lose a tail, then grow a tail again. "}]},{"spans":[{"text":"She was stuck in this loop for a long, long time. "}]},{"spans":[{"text":"Until she met a little boy. "}]},{"spans":[{"text":"The boy wanted the eight-tailed cat to come home with him, to be his friend and play with him. "}]},{"spans":[{"text":"The cat agreed, so that he would make his wish soon."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"After a while, the boy finally did— "}]},{"spans":[{"text":"\"I wish for you to have nine tails.\""}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"The Doctor once asked me... "}]},{"spans":[{"text":"\"Erma, what do you want?\""}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"At first, I wanted to see the world."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"But now... I want to die."}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"...Will you grant my wish?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma accesses the anchor point named \"Arthur Hume\" once more."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"516","raw":"BIN"}],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Your name is also the name of this gun."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Erma Maschinenpistole. Erma EMP."}]}]},{"sprites":[],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Walk further. Further away. "}]},{"spans":[{"text":"50 meters... No, 100."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma nods obediently."}]}]},{"sprites":[],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Very good... Now, we'll play this game a different way. "}]},{"spans":[{"text":"Now you will shoot me."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma acts like she's actually playing a game. "}]},{"spans":[{"text":"She takes up her gun, like \"Mother\" once taught her."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_rifle_finalshot_h","raw":"SE1"},{"type":"shake","raw":"震屏3"},{"type":"background","value":"517","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang— "}]},{"spans":[{"text":"It is a precise shot that pierces his chest."}]}]},{"sprites":[],"ops":[],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"Ugh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Blood gushes out of Hume's body."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Arthur Hume","narrator":false,"pages":[{"spans":[{"text":"I'm sorry... You're free, Erma."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"688","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma lowers her eyes. She can almost feel Doctor Hume's blood pooling around her feet again."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"What will you choose?"}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I will grant your wish."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"And after that?"}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"There is no after."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"What about you? "}]},{"spans":[{"text":"Will you have any regrets?"}]}]},{"sprites":[{"prefab":"Erma","expression":25,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...I once asked a human..."}]}]},{"sprites":[{"prefab":"Erma","expression":13,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"flashback","raw":"回忆"},{"type":"background","value":"683","raw":"BIN"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I have a question. I know that when a human dies, they are given a funeral. "}]},{"spans":[{"text":"So should we... organize a funeral for Ange?"}]}]},{"sprites":[{"prefab":"Erma","expression":13,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"No, this isn't the right place to put her gravestone."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I see."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Also, from what I know of her, she'd roll her eyes so hard she'd see her brain if we weep before her grave."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I gather Ange wasn't someone who needed a funeral then."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're right."}]}]},{"sprites":[{"prefab":"Erma","expression":18,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Then... I have another question!"}]}]},{"sprites":[{"prefab":"Erma","expression":18,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Shoot..."}]}]},{"sprites":[{"prefab":"Erma","expression":15,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Before I set off, I read a story about a man who went on an arduous journey to pick a magical herb in order to bring his dead mother back to life... "}]},{"spans":[{"text":"If such a panacea really did exist, would you use it to revive Ange?"}]}]},{"sprites":[{"prefab":"Erma","expression":15,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"No."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Huh? I thought you'd say yes."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Death is the only gift she bequeathed to me. "}]},{"spans":[{"text":"To snatch life away from Death is for mankind to pay the ultimate price. "}]},{"spans":[{"text":"I won't allow anyone to disturb her eternal rest. I've already paid enough."}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Can death be considered... a gift?"}]}]},{"sprites":[{"prefab":"Erma","expression":17,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Yes, a heavy and painful gift. "}]},{"spans":[{"text":"One to which we must hold on tightly, lest we forget..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander clenches their fist, squeezing Strongarm tightly in their fingers. This is the first time Erma has seen such anguish on a human's face. "}]},{"spans":[{"text":"But the moment lasts only briefly."}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"688","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"No one should have their death taken away from them. "}]},{"spans":[{"text":"I will give you your eternity— "}]},{"spans":[{"text":"Death, which will never be taken from you."}]}]},{"sprites":[{"prefab":"NPC_ErmaAngel","expression":0,"side":"left","tags":{"Position":"-230,150"}}],"ops":[{"type":"bgm","value":"BGM_Scar_Morichongfeng","raw":"BGM"}],"speaker":"Her Majesty the King","narrator":false,"pages":[{"spans":[{"text":"...So you do love me, just as I love you, Erma."}]}]},{"sprites":[{"prefab":"Erma","expression":26,"side":"left","tags":{"Position":"0,155"}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"As you said yourself, I am a selfish Doll."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beautiful sunlight shines through the stained glass window onto Erma's face. "}]},{"spans":[{"text":"She turns to face the two Dolls behind her."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"686","raw":"BIN"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Mirabelle, once this decision is made...you will never be able to leave the Summer Garden."}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Your Majesty, I remain your loyal knight."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Will you resent me for this?"}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"...I would rather not guard the fountain on my own."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Mirabelle, I won't leave you behind anymore."}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Make sure you keep your promise this time."}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Erma... why does it have to be this way...?"}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I love myself. I want to stay true to myself. "}]},{"spans":[{"text":"I don't like humans, and I don't want to be human."}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"Do you have to go that far?"}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"It's the only way to completely shut down the passage to GRCh38. "}]},{"spans":[{"text":"By doing this... neither Paradeus nor Sangvis Ferri... "}]},{"spans":[{"text":"...Will be able to enter this space. "}]},{"spans":[{"text":"I will seal it off permanently..."}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Do you... think I'm selfish?"}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...No, no matter what you do... you have my full support. "}]},{"spans":[{"text":"Just like I promised... "}]},{"spans":[{"text":"Just like we promised..."}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"As I've just said, I am Your Majesty's knight. I will always be by your side."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Alright... "}]},{"spans":[{"text":"Then I accept this crown, and... I'll shut down this passage for good."}]}]},{"sprites":[],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm leaving the matter with Nadia and Lunasia to you, Reinette."}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...I'll relay your message to AR-18... and the Griffin Commander. "}]},{"spans":[{"text":"...Mirabelle, what about you? ...Anything you'd like to say to me?"}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"Stop living your life for someone else's sake, dumbass!"}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"...Would it kill you to call me \"sis\" even just once?"}]}]},{"sprites":[],"ops":[],"speaker":"Mirabelle","narrator":false,"pages":[{"spans":[{"text":"I thought you hated being called sister? "}]},{"spans":[{"text":"Please don't go out of character."}]}]},{"sprites":[],"ops":[],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"...Let's leave it at that. "}]},{"spans":[{"text":"Now what should my last words be? "}]},{"spans":[{"text":"Should I repeat what Mother said? No... I will not apologize. "}]},{"spans":[{"text":"Erma is the cutest Doll. "}]},{"spans":[{"text":"So... "}]},{"spans":[{"text":"Erma refuses to become human."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"backgroundMove","value":"%%pivot_x=0.5%%pivot_y=0.5%%scale=1%%duration=0%%","raw":"bg_move"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette never says what she means. She claims to hate Erma more than anyone else."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Hume_ImFutue_Main","raw":"BGM"}],"speaker":"Reinette","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette always spurns tears."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"sfx","value":"AVG_Water_Drip","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Yet right now, her tears won't stop falling."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"691","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma holds her head up high."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"692","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A pair of wings sprouts from her back. She buckles under the pain."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"693","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The wings gradually take shape, their feathers rustling as they unfurl. Throughout the process, Erma has not let out even a whimper. She just keeps up a brave, quiet smile..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"694","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...While letting the feathered wings deform and mangle her body..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"695","raw":"BIN"},{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Reinette bears witness to the birth of an angel... and her swansong..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"696","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma is the sole player in this game, and she has chosen her favorite ending."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"When Erma can no longer hear, Reinette finally stops holding back her sobs and lets out a howl of heartrending grief. "}]},{"spans":[{"text":"From as far as she can remember, Erma has always had an extremely strong aversion to pain. "}]},{"spans":[{"text":"She could never bear the thought of causing someone pain, yet here she is, inflicting the most unimaginable suffering on herself."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"462","raw":"BIN"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"},{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The light grows so blindingly intense that Reinette struggles to keep her eyes open. "}]},{"spans":[{"text":"Her familiar surroundings are warping, distorting, disintegrating... "}]},{"spans":[{"text":"The garden in which they used to frolic and play together, the fountain, the grassy field... "}]},{"spans":[{"text":"Natalie at the age of 25, Mirabelle, Erma... "}]},{"spans":[{"text":"All these pieces of cherished, nostalgic memories of the past become forever out of reach as the Summer Garden falls apart."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"689","raw":"BIN"},{"type":"sfx","value":"AVG_AMB_waves_and_seagulls_oneshot","raw":"SE1"},{"type":"effect","value":"%%code=AVG_yinghua_bai%%","raw":"common_effect"},{"type":"whitescreen","raw":"白屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the center of the ruins, Erma quietly closes her eyes. A white bird flies above them in the sky, as if carrying her soul away. "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"On this day in October, Frankfurt welcomes its first snow of this winter."}]}]}]}
