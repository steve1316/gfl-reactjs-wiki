{"name":"-17-17-2First","beats":[{"sprites":[],"ops":[{"type":"background","value":"BG-BurnCity","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The battle ends."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Finally...Did we kill her? "}]},{"spans":[{"text":"Go check her corpse!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Griffin T-Doll A","narrator":false,"pages":[{"spans":[{"text":"Commander! Miss Kalin! That corpse was just a Dummy!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Eh?! A powerful enemy like that was still just a Dummy?! "}]},{"spans":[{"text":"Then...where could the real Agent be...?"}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-BurnCity","raw":"BIN"},{"type":"shake","raw":"震屏"},{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Bang!"}]}]},{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"bgm","value":"BGM_stage10","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"spark","raw":"火花"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...A thunderous explosion blasts me from behind! "}]},{"spans":[{"text":"Fire falls like rain and smoke fills the air. The darkness spins as I fall. "}]},{"spans":[{"text":"...... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"格琳","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Commander, where are you?! "}]},{"spans":[{"text":"Answer me, Commander—! "}]},{"spans":[{"text":"Everyone, put out the flames! And look for the Commander!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...I've fallen underground, and the entire command post is burning. "}]},{"spans":[{"text":"The sound of crisp, elegant footsteps approaches me."}]}]},{"sprites":[{"prefab":"？？","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"Humans are so weak... "}]},{"spans":[{"text":"You're already unable to move after a fall like this."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...I hear the Doll's voice in the darkness and hurriedly raise my sidearm to defend myself."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Thud! "}]},{"spans":[{"text":"Something heavy presses down on my chest, making it difficult to breathe."}]}]},{"sprites":[{"prefab":"代理人","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"My apologies. That was carelessness on my part. "}]},{"spans":[{"text":"But don't you think you're acting too surprised?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The smoke begins to clear, and my vision slowly returns."}]}]},{"sprites":[{"prefab":"代理人","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"After all, I did say... "}]},{"spans":[{"text":"That I would bury you personally..."}]}]},{"sprites":[{"prefab":"代理人","expression":0,"shown":false,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2018Winter3-2","raw":"BIN"},{"type":"openEyes","raw":"睁眼"}],"speaker":"Agent","narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...My handgun...is nowhere to be found."}]