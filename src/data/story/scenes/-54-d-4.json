xt":"He knows he has nowhere to run now—Even if he's afraid, he still has to protect his last hope. "}]},{"spans":[{"text":"Dr. Rugosa grits his teeth and stands his ground..."}]}]},{"sprites":[],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"I won't let anything be taken from me ever again!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dr. Rugosa spreads his arms to plant himself firmly in front of Lucas and Rosita."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"background","value":"2022summer_FirstClass","raw":"BIN"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bang— "}]},{"spans":[{"text":"Just as a knife is about to pierce Dr. Rugosa's flesh, someone kicks the door open—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A massive figure charges through the airtight blockade in just a second."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_20Winter_Knife_Whoosh","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Get lost! All of you, get lost!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Pavel swings the spanner in his hands, clearing a safe space for Dr. Rugosa."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Rosita... Is she alright?"}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"I injected the serum. Her condition has stabilized."}]}]},{"sprites":[{"prefab":"NPC-TD_Worker","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Pavel","narrator":false,"pages":[{"spans":[{"text":"Thank goodness... "}]},{"spans":[{"text":"Thank you."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Dr. Rugosa returns to Rosita's side. Her breathing is calm and regular. The serum seems to be working."}]}]},{"sprites":[{"prefab":"NPC-TD_Boy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucas","narrator":false,"pages":[{"spans":[{"text":"Doctor, are you hurt?"}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"No, I'm fine."}]}]},{"sprites":[{"prefab":"NPC-TD_Boy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucas","narrator":false,"pages":[{"spans":[{"text":"Then... why are you crying?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Confused, Dr. Rugosa touches his cheek and feels a cool dampness through his glove. "}]},{"spans":[{"text":"He had not cried since his son's death."}]}]},{"sprites":[{"prefab":"NPC-TD_Boy","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Lucas","narrator":false,"pages":[{"spans":[{"text":"Doctor?"}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"I... I saved a life."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Lucas blinks as he waits for the doctor to explain himself. "}]},{"spans":[{"text":"But Dr. Rugosa simply keeps muttering to himself—"}]}]},{"sprites":[{"prefab":"NPC-Doctor","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Doctor Rugosa","narrator":false,"pages":[{"spans":[{"text":"I saved a life... "}]},{"spans":[{"text":"... "}]},{"spans":[{"text":"Turns out... all I've ever wanted is the gratification of saving lives..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
