{"name":"12-3-1E","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"2019summer_12","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Danger","raw":"BGM"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Doesn't it feel like the enemies are following us?! "}]},{"spans":[{"text":"Have they spotted us? "}]},{"spans":[{"text":"But they haven't fired at us! What the hell is going on?!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Stop thinking about that! They're trying to block us off ahead! "}]},{"spans":[{"text":"Left! Turn left and follow me!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What just happened?!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The consciousness! It's controlling those enemies! It's trying to capture us!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What?! But didn't you say..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yes, I thought I lost it, but it's back!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What a clingy, tenacious...!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Since we're exposed anyway, I ran a full scan on their positions! "}]},{"spans":[{"text":"This way! They haven't sealed off this direction yet!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Are we running straight for the signal relay?!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If you have any better suggestions, go right ahead!"}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Is that your solution?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Scampering around mindlessly?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"You're in control of these units, aren't you?!","style":{"color":"#A9A9A9"}},{"text":" "}]},{"spans":[{"text":"I know you don't dare fire at me!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Who knows, perhaps it's a good idea to stay in this system. It may be more accommodating than your ungrateful neural cloud.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If you like it there so much, I wish you all the best!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"But there isn't anything that's remotely interesting to me in their system.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I know what you're going to say next!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Then just be a good girl and stop this nonsense.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If you think you can intercept me with these dumb white units, you underestimate me!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"They probably can't, but I bet the Nytos can.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Nytos?!","style":{"color":"#A9A9A9"}}]}]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"Don't say I didn't warn you. I can't keep these Dolls under control. They seem to hate you a lot more than I expected.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4, stop! The black enemy appeared straight ahead!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Tsk... It's drawing its weapon! Get inside that building, hurry!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"She's firing! M4, come in!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"},{"type":"background","value":"black","raw":"BIN"}],"speaker":"M4A1","narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":"Clear Voice","narrator":false,"pages":[{"spans":[{"text":"You can run, you can hide, but you'll have to face me eventually, Lunasia.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Before we patch things up, let's play a game of hide-and-seek.","style":{"color":"#00CCFF"}}]}]}]}
