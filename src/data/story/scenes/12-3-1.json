],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4A1...would never say something like that. "}]},{"spans":[{"text":"I really..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"You really can't accept me as Lunasia?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You bastard...!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"So what are you going to do? Shoot me? "}]},{"spans":[{"text":"I'm out of ammunition, so you can do whatever you want."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Don't talk like that in M4A1's voice!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1?","narrator":false,"pages":[{"spans":[{"text":"If you don't plan on shooting me, then just hurry up and do what must be done."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Dammit..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"shown"