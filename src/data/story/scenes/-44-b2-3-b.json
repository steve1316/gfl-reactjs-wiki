":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"?","narrator":false,"pages":[{"spans":[{"text":"Very good. Father will reward you for your efforts. "}]},{"spans":[{"text":"Now then, there is only one last thing to do..."}]}]},{"sprites":[{"prefab":"Narciss","expression":4,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Let me do it, Big Sis! "}]},{"spans":[{"text":"I'll be so happy every bone in my body will dance a jig If I get to kill that woman!"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":6,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":7,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"?","narrator":false,"pages":[{"spans":[{"text":"No, I must finish off that woman personally. "}]},{"spans":[{"text":"This is the mission I was given from the moment I was born, after all."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_21Winter_FT_Heel","raw":"SE1"},{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The third woman slowly approaches, the sound of her high heels tapping out crisp notes on the floor. "}]},{"spans":[{"text":"Clack...clack...clack... "}]},{"spans":[{"text":"Neither quick nor slow, but each step is filled with lethal menace. "}]},{"spans":[{"text":"Clack...clack...clack... "}]},{"spans":[{"text":"Every beat feels like a stomp on her heart. "}]},{"spans":[{"text":"Clack... "}]},{"spans":[{"text":"She is here."}]}]}]}
