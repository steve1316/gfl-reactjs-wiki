sion":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"PA-15","narrator":false,"pages":[{"spans":[{"text":"Huh? Didn't you say we're the worst team you've ever led? "}]},{"spans":[{"text":"Turns out it was just us and us only!?"}]}]},{"sprites":[{"prefab":"APS","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Stechkin","narrator":false,"pages":[{"spans":[{"text":"Wait, doesn't that mean... "}]},{"spans":[{"text":"We're also the best team you've ever led!"}]}]},{"sprites":[],"ops":[],"speaker":"Intern","narrator":false,"pages":[{"spans":[{"text":"..."}]},{"spans":[{"text":"Yeah, that's right."}]},{"spans":[{"text":"Alright, let's finish this!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
