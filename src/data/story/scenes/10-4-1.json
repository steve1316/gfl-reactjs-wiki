{"name":"10-4-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"},{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Half an hour later."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"background","value":"作战室avg","raw":"BIN"}],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Commander, Captain Yegor is on the line. Their combat units are all in position. Should I patch it through to the command center? "}]},{"spans":[{"text":"Alright! Coming through!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Griffin Commander, the Military forces have entered the Parapluie zone. We are currently setting up an interference neutralizer, which will render the Parapluie virus completely ineffective once activated. "}]},{"spans":[{"text":"I need your troops to protect it."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"What will the Military units be doing in the meantime?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"They will be advancing towards the heart of Sangvis territory. I believe both parties are allocated suitable duties. Any objections? "}]},{"spans":[{"text":"...No? Good. "}]},{"spans":[{"text":"Sangvis forces have already taken notice of our equipment and are moving in to surround it. Your troops must destroy them in due haste."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Isn't this a bit difficult...with only our echelons, Commander?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"That's an order. It must be done."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Captain Yegor terminates the call."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"How inconsiderate..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Ah, the AR Team is hailing us!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Commander, we've just arrived at the coordinates you sent us. I'll hand over to RO to explain the situation."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, we've pinpointed the location of the paralyzed military units discovered around the anti-interference equipment! "}]},{"spans":[{"text":"I believe they were forcibly disconnected after being hacked by Sangvis Ferri."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"You found them? That's great!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I asked SOP-II to get us one of the signal repeaters destroyed by S.F., which can hopefully help us restore control over the military units. "}]},{"spans":[{"text":"If the Military is willing to direct them in protecting the interference neutralizer, it'll make our job a lot easier..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander! Connecting to the Captain's channel!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Captain Yegor?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"Looks like you're getting down to business."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Thank you for your help earlier, but now we have a new favor to ask. "}]},{"spans":[{"text":"We found several paralyzed military units, if you could..."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"I've learned of your situation. "}]},{"spans":[{"text":"Our forces have already vacated the area where the equipment is located, so we are unable to aid you by directing those units."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"We only need you to activate the basic firing protocol! "}]},{"spans":[{"text":"If they could at least give us some cover..."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"That's impossible."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What do we do now, M4A1...?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then with permission, Captain Yegor, may we...borrow them for a bit?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Huh?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If the Military cannot spare anyone to direct them, we'll do it ourselves. You don't want Sangvis Ferri to destroy the equipment, do you, Captain?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"M4A1","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Permission granted. "}]},{"spans":[{"text":"Those units were disposables with the sole purpose of defending against Sangvis electronic assault in the first place. "}]},{"spans":[{"text":"Use them as you please, though I highly doubt you possess the technological compatibility."}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalin","narrator":false,"pages":[{"spans":[{"text":"Then...can we let our Commander direct them?"}]}]},{"sprites":[{"prefab":"NPC-Yegor","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kalin","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Yegor","narrator":false,"pages":[{"spans":[{"text":"The Griffin Commander must focus on protecting the interference neutralizer. That's your order. "}]},{"spans":[{"text":"Other than that, do as you see fit."}]}]},{"sprites":[],"ops":[{"type":"background","value":"BG-BurnCity","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Five minutes later."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Sneak","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Huh? Are you certain? "}]},{"spans":[{"text":"You sure it's a good idea to forcibly establish a link with these military units...?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"We don't have any other choice. If the interference neutralizer is destroyed, the whole operation will be set back. "}]},{"spans":[{"text":"RO, the odds aren't in our favor to begin with. We must work with whatever we have."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I understand... Theoretically speaking, the Zener Protocol should be compatible, "}]},{"spans":[{"text":"but it might overload your neural cloud. Do you think you can deal with it?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Don't worry about me. Do your part."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"I was literally made to worry about you, M4. "}]},{"spans":[{"text":"I couldn't wait to see what kind of T-Doll you are before I met you, but now that you're finally here in the flesh, you're completely different than what I imagined."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"In what way, good or bad?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"SOP-II always said you were a very gentle T-Doll, but I think you're a lot tougher than you seem."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Gentle, you say...?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You may have changed. "}]},{"spans":[{"text":"But no matter what you were like in the past, right now, you're more suited for the battlefield, as well as for command."}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...Thanks. Are we set to make the connection?"}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, M4A1. Are you sure you're ready for this?"}]}]},{"sprites":[{"prefab":"M4A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Affirmative."}]}]},{"sprites":[{"prefab":"RO635","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Then let's do this."}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"White","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
