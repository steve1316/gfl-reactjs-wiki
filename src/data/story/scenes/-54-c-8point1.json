{"name":"-54-C-8Point1","beats":[{"sprites":[],"ops":[{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Erma follows Lyudmila's instruction and climbs to the roof of the train."}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"I'm here. What now?"}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"You see the turret on top of the train? It's incredibly powerful. Not even a Tactical Doll can take more than a few shots from one of these.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Then what should I do?"}]}]},{"sprites":[{"prefab":"Erma","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"There's a control terminal up ahead, not far from you. It can shut down the turret.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"You can weave through the fields of fire that way.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Alright... I'll give it a try!"}]}]},{"sprites":[{"prefab":"AR18","expression":2,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"Yellow icons will appear on the ground before the cannon fires. Make sure you dodge in time.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"Erma","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"Got it. See you in F02."}]}]}]}
