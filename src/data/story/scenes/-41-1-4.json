{"name":"-41-1-4","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"84","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bremen City Hall, Germany."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The black sedan slowly comes to a stop at a reserved parking spot. The woman dressed as a secretary gets out first and hurries to open the door for her passengers in the back seat. "}]},{"spans":[{"text":"But before she can do that, they have already disembarked on their own."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Have you had dealings with this Chairwoman Ulrich before?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"No, I've never even met her. "}]},{"spans":[{"text":"But I've heard about what she did in Belgrade. "}]},{"spans":[{"text":"Including the things she went through with the Commander."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Do you think she can be trusted?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I will reserve my judgment. But we have free rein here only because she's given us the green light. "}]},{"spans":[{"text":"I really can't draw any conclusions until I actually meet her."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I see~"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Frau Ange, this way please!"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"How attentive of you, Miss Secretary. It must be tough doing this kind of work."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Not at all... I love my work. "}]},{"spans":[{"text":"I have always aspired to serve Frau Ulrich and contribute to her cause, no matter how insignificant my contribution may be. "}]},{"spans":[{"text":"I firmly believe that her ideology will guide mankind onto the right path as we struggle to survive in this hostile world. "}]},{"spans":[{"text":"I am happy to tend to the frivolities behind the scenes, and I freely admit that I'm merely parroting her views."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Sounds like you have a lot of respect for your employer."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"My employer is my country; Frau Ulrich is simply my superior. "}]},{"spans":[{"text":"Still, I feel extremely lucky to be given the opportunity to work under her. She is truly deserving of respect."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"How surprising. "}]},{"spans":[{"text":"I've been working with Angelia for such a long time I've almost forgotten there are actually good people in the world."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Watch your tongue while we're in there. "}]},{"spans":[{"text":"I don't want to get kicked out before we can even start doing our job."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"97","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Knock knock."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Frau Ulrich, it's me. "}]},{"spans":[{"text":"Frau Angelia is here."}]}]},{"sprites":[{"prefab":"乌尔利赫","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Please come in."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"...Frau Angelia, it's a pleasure."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Hello, just call me Ange."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"And this must be AK-12. "}]},{"spans":[{"text":"I have heard much about you. You are considered quite the exceptional paragon even among Tactical Dolls."}]}]},{"sprites":[{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,85"}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Hahahaha, you are incredibly forthright. "}]},{"spans":[{"text":"But you might want to call me Lucia for now."}]}]},{"sprites":[{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,85"}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Lucia?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's her alias while we're operating in Germany."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I see. So the Wolf Pack is also here."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"A-Apologies, Frau Ulrich... "}]},{"spans":[{"text":"I did say Frau Ange was the only one you wanted to see..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"No need to apologize. Frau Ange is in a very precarious situation; her caution is totally understandable. "}]},{"spans":[{"text":"Not to mention I am a complete stranger."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Thank you for your understanding and support."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"It is simply a mutually-beneficial arrangement, Frau Ange. "}]},{"spans":[{"text":"We also have much to gain from your operation. "}]},{"spans":[{"text":"We have every reason to see to your success."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"So what do you want with me? "}]},{"spans":[{"text":"Frankly speaking, I sneaked into Bremen through border security as a legitimate refugee. "}]},{"spans":[{"text":"I'm in no state to be talking to you in a place like this. "}]},{"spans":[{"text":"I don't mind making this trip, but I claim no responsibility for soiling your pristine office."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Please forgive me. I understand you are unhappy that you've been brought here against your wishes. "}]},{"spans":[{"text":"I should have gone and welcomed you in person. "}]},{"spans":[{"text":"However, I'm afraid I am not currently in the position to do that. "}]},{"spans":[{"text":"As you surely know, right now this office is being watched very closely."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"...Because of what happened at the submarine base."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"As a key participant of that operation, I believe your superior must have sent you here to share some information with us?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Unfortunately, I no longer have a superior."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Which is why you're the one standing in my office and not anyone else."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You should know that I don't give away intelligence for free. "}]},{"spans":[{"text":"There is also something I want. This collaboration can only proceed if I get something of equal value in return."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"That's alright, I did not expect you to divulge anything today. "}]},{"spans":[{"text":"I simply wanted to have a chat with you in person out of common courtesy."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You have achieved your goal even if we talk about nothing. You just needed me to sit here for several minutes."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"After all, a lot of eyes are on you. "}]},{"spans":[{"text":"I ask for your understanding. Think of it as a politician's customary tactic."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I only agreed to come because the Commander thinks pretty highly of you. "}]},{"spans":[{"text":"If you truly live up to your reputation, then surely you cannot abide by William's crimes?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Naturally."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Alright, I hope you'll prove that through your actions."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I will give you whatever assistance I am in the position to give."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"In exchange, I will provide you with intelligence once my objective is completed."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Wonderful. "}]},{"spans":[{"text":"But even if you didn't, I would still help you."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Why?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"There are far too few kind-hearted people in the world. "}]},{"spans":[{"text":"No matter how hard you try to feign indifference, you cannot really hide your true nature. "}]},{"spans":[{"text":"You and the commander that saved me both strike me as the rare sort of people who still possess kindness. "}]},{"spans":[{"text":"It is my belief that the world will be a better place with more people like you. "}]},{"spans":[{"text":"Our mission isn't to catch one or two bad guys, but to change this evil-infested world and remake the rules that govern it."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"\"A shining beacon in a brave new world\"...eh? "}]},{"spans":[{"text":"But I must warn you—it does take power to change the world, but power that's beyond your control will eventually be your demise. "}]},{"spans":[{"text":"I hope you will not repeat my country's mistake."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I will remember your counsel."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Now I can see why you were sent to Belgrade."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"I'm flattered. "}]},{"spans":[{"text":"Morridow, escort Frau Ange to her residence."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Uh... Right! Understood!"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Oh... One more thing."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Knock knock."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Come in, please."}]}]},{"sprites":[{"prefab":"？？？","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Ma'am."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A man of imposing stature enters the office."}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Anything I can do for you, Madam Chairwoman?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Angelia, Herr Hopps will be in charge of your safety during your time in Bremen."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I won't run away."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"This really is just for the sake of your personal safety."}]}]},{"sprites":[{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Hahahaha, you Germans have such a great sense of humor!"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Hopps","narrator":false,"pages":[{"spans":[{"text":"...I am Hopps, Protection Officer."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Hopps is a retired GSG 9 officer and has been working for me for almost a year. "}]},{"spans":[{"text":"He has seen real combat and is very dependable; you can count on him. "}]},{"spans":[{"text":"In terms of performance in combat, he obviously can't compare with your Dolls. "}]},{"spans":[{"text":"But it's better to let a human handle things in the city."}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"Also, feel free to entrust Morridow with other errands. "}]},{"spans":[{"text":"I know it is rather difficult for you to navigate our city, where everything is new and unfamiliar."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"At your service!"}]}]},{"sprites":[{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"She knows the city very well and will be able to help you in all kinds of matters."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She does sound pretty useful, Ange."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Alright."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"In that case, I wish you a happy and fruitful time in Bremen."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Thanks. "}]},{"spans":[{"text":"And please bear with us if we cause any trouble."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ambassador","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Ulrich","narrator":false,"pages":[{"spans":[{"text":"...I'll keep that in mind."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"84","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Frau Ange, allow me to escort you to the safe house. "}]},{"spans":[{"text":"Herr Hopps, are you coming with us?"}]}]},{"sprites":[{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Hopps","narrator":false,"pages":[{"spans":[{"text":"...My mission is to ensure Frau Ange's personal safety while she is out and about in Bremen. "}]},{"spans":[{"text":"At the same time, I have been asked to keep out of her way in day-to-day life."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"How very thoughtful of the chairwoman... So are you coming or not?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Hopps","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Hopps","narrator":false,"pages":[{"spans":[{"text":"If you'll allow me to accompany you."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Lucia, get in the car."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"85","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A few minutes later, at the temporary outpost prepared by Ulrich."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"It's a bit messy, but it is definitely secure. "}]},{"spans":[{"text":"Hopps and I will be waiting outside. Please call us if you need anything."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With that, Morridow leaves the briefing room and closes the door behind her."}]}]},{"sprites":[{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Ange."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Hm... "}]},{"spans":[{"text":"Where's K?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Mr. K left shortly after he had brought us here. "}]},{"spans":[{"text":"He seemed to have other important matters to attend to."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"...How did the discussion go?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"There wasn't really much of a discussion. "}]},{"spans":[{"text":"This is only day one; we'll be here for a long time."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I do hope it will go smoothly. "}]},{"spans":[{"text":"Unfortunately, from what I can tell, some things are beyond even the chairwoman's control."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Ulrich isn't the chancellor of Germany. Just be happy that she genuinely wants to help. "}]},{"spans":[{"text":"According to my sources, quite a lot of people have opposing views even in Bremen alone. "}]},{"spans":[{"text":"Governments are never as cohesive as they make themselves out to be."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"People are the same everywhere, eh?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"If pointless strife is reduced by even 10%, the world will become a paradise. "}]},{"spans":[{"text":"In any case, we have more immediate things to worry about. Don't forget why we've come all this way to Germany."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"How should we proceed?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Now that we have a way of navigating the city, we can focus on the operation. "}]},{"spans":[{"text":"William... Havier's intelligence indicates that he is in Bremen, but that still leaves us with a lot of ground to search. "}]},{"spans":[{"text":"This is a very cunning man. Evidence of his activities is detected only after he's long gone, and he always keeps his plans well-concealed."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"But you've already got a plan?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We don't have nearly enough clues to work with, but it's better than nothing. "}]},{"spans":[{"text":"At least we can now be certain that we're at an important location, and this is where we will find that weasel."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Right... So we've got to drag the weasel out by his tail."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":4,"side":"left","tags":{"Position":"0,85"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"That sounds very comedic coming from you."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"Should we start searching?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"side":"left","tags":{}},{"prefab":"AN94","expression":11,"side":"left","tags":{"Position":"0,-70"}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"No need to be hasty. We aren't the only ones who want a piece of the action. "}]},{"spans":[{"text":"Right now, all we need to do is sit tight and wait."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
