ue":"54","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"Signal re-authentication in process... "}]},{"spans":[{"text":"Are you... my enemy?"}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"background","value":"54","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"It shouldn't have turned out this way... "}]},{"spans":[{"text":"AUG, I promised I wouldn't..."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"side":"left","tags":{"Position":"0,-100"}}],"ops":[{"type":"background","value":"54","raw":"BIN"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"...I don't believe you."}]}]},{"sprites":[{"prefab":"IWS2000","expression":0,"side":"left","tags":{"Position":"0,100"}}],"ops":[{"type":"background","value":"54","raw":"BIN"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"Please, I beg you..."}]}]},{"sprites":[{"prefab":"AUG","expression":0,"side":"left","tags":{"Position":"0,-100"}}],"ops":[{"type":"background","value":"54","raw":"BIN"},{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":"AUG","narrator":false,"pages":[{"spans":[{"text":"We are out of options, it seems. This was your first mistake."}]}]},{"sprites":[],"ops":[{"type":"background","value":"54","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"IWS 2000","narrator":false,"pages":[{"spans":[{"text":"And it won't... be our last."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"MachineGunBurst","raw":"SE2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"2,1","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"......"}]}]},{"sprites":[{"prefab":"系统语音","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":"System Prompt","narrator":false