{"name":"-48-1-7","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Ministry of State Security, Berlin, Germany."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"158","raw":"BIN"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As a high-ranking member of the Stasi, J never expected to find himself sitting in an interrogation chair one day."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Now then. "}]},{"spans":[{"text":"You know what it means to violate a Stasi lockdown, don't you?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"—This is Romy Riefenstahl. "}]},{"spans":[{"text":"She is the new director of the Stasi. In other words, she is J's immediate superior."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I am not a traitor to the State."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"I'll be the judge of that, Agent Kevin."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"My job in Berlin was to cooperate fully with Angelia's investigation in all ways. "}]},{"spans":[{"text":"Also, Agent Light, who perished there, was my junior, so I wanted to investigate the matter myself."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"You were not authorized to do so."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I'm an agent, and an agent's job is to pursue the truth and protect the nation. "}]},{"spans":[{"text":"I acted because I judged that there might be a threat to national safety."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"So you think your judgment takes precedence and everyone else is an idiot? "}]},{"spans":[{"text":"Who the hell do you think you are?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"You submitted many requests to mount an investigation before this. "}]},{"spans":[{"text":"However, I believe I made myself clear when I told you that there is no value in investigating the matter any further."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Seven agents died there and you say there's no value in looking into it? "}]},{"spans":[{"text":"Even if you are the Director, you were only recently appointed. There was no basis for making that call. "}]},{"spans":[{"text":"Who are you trying to convince? Nobody would—"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Enough."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy interrupts J's attempt to justify himself and produces the medicine bottle J recovered from an evidence case."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_21Winter_Medicine_Bottle","raw":"SE1"}],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"What is this?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Can't you tell?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"What is this?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I found it there, on the scene. "}]},{"spans":[{"text":"The bottle is labeled with the Galatea Corporation's logo. "}]},{"spans":[{"text":"But there's no existing product with this packaging on the market. "}]},{"spans":[{"text":"This leads me to conclude that it's a trial product which has yet to be distributed to the public. Only insiders would have access to it."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Which means?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"This proves Galatea personnel were present at the scene."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"You idiot."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Say what?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"It proves nothing."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy puts the bottle aside disinterestedly."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"It's just a bottle of medicine. There are countless reasons why it could have ended up there. "}]},{"spans":[{"text":"You simply chose the one that suits your narrative the best but is the least likely to be true."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"But that's not it at all..."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Is that the reason why you took matters into your own hands?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I simply could not agree with giving up on the investigation so easily."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"It is not your place to question my decisions."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"And your decision is to let the deaths of our comrades be in vain? "}]},{"spans":[{"text":"To ignore the culprit behind all this?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"...It looks like you don't value your job much."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_doorknock_wood","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Knock knock."}]}]},{"sprites":[],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Pardon the intrusion, Director. "}]},{"spans":[{"text":"...It's me, Kain Schwaben."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"...Enter."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K pushes the door open and enters the room, his face carefully blank. He inclines in a slight bow to Romy."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I have new information to report regarding the closure of the Galatea pharmaceutical plants."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Romy looks at K, then at J, who is bound to the chair. Her eyes flash with some kind of understanding."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_keyboardtype_sci","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She presses a button on a remote control and loosens J's bonds."}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"You may go."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...That's it?"}]}]},{"sprites":[{"prefab":"NPC-Romy","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Romy","narrator":false,"pages":[{"spans":[{"text":"Yes. Enjoy your last few hours in the Stasi."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"417","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J is at his desk packing up his things."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Kevin, I have something to tell you... "}]},{"spans":[{"text":"What are you doing?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J looks up from the cardboard box he is packing."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"I'm taking the first step in my vacation plan—a glorious retirement. "}]},{"spans":[{"text":"So says the old bitch."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K can't help but frown at the crudity of J's speech. "}]},{"spans":[{"text":"That's when J notices an unfamiliar girl standing behind K."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Don't be so immature."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"What, you think I'm kidding?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"J puts down the things he's holding and focuses his attention on K."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You encounter a setback, so you just abandon your duty? That's pretty childish to me. You want to avenge Light, yet you're quitting your job. "}]},{"spans":[{"text":"Do you have multiple personality disorder or something?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Oh, give me a break! You think I WANT this? You're calling me immature for dropping the investigation. I DID try to pursue it, but that woman reamed me out—oh, I almost forgot, she skipped reaming and fired me on the spot."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K takes a deep breath and draws close to J."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Take a good look around you... You see all these empty desks? This isn't targeted at you alone. "}]},{"spans":[{"text":"Think about who left and WHY they left. Use your brain, for God's sake."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Who cares? The only thing in my brain right now is the mansion."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Don't be rash. The only way you can stay on the case is by staying in the Stasi."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...I suppose it's too late to apologize?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Relax. "}]},{"spans":[{"text":"She's put you on a new assignment. In other words, you aren't fired."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Wait... Did you sell your body or something?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K can't help but roll his eyes. He does not even bother to dignify J's question with a reply. "}]},{"spans":[{"text":"Instead, he steps back to make room, and J's gaze falls on the silent girl."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Allow me to introduce Miss Mona. She is a Tactical Doll who has officially joined the Stasi recently."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"...Nice to meet you, Agent J."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"She looks just like the real thing."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...She was brought in at the request of Romy Riefenstahl, though this is still a trial posting. "}]},{"spans":[{"text":"Mona will be bringing you on operations from now on."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Excuse me, but did I mishear something? Who's the Doll here, me or her? "}]},{"spans":[{"text":"You mean she's going to be leading me?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"These are orders from a superior. "}]},{"spans":[{"text":"Didn't you learn how to follow orders during Stasi agent training?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Got it."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I'll let Mona explain the mission to you."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Very well. The recent closures of the Galatea pharmaceutical plants have brought several security issues to light. "}]},{"spans":[{"text":"We've received news from the Berlin police that crowds of protesters have gathered in front of the pharmaceutical plants. "}]},{"spans":[{"text":"We need to move out right now to prevent any attempts they might make to storm the premises."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"Tsk... That's agent work for you. "}]},{"spans":[{"text":"Got it, I'm on it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mona nods, then turns to leave."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Kevin. "}]},{"spans":[{"text":"Hold on to this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Book","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"K hands a slip of paper to J. There is a phone number on it... But it is not a German phone number. "}]},{"spans":[{"text":"J memorizes the number and crumples it up. He looks up at K."}]}]},{"sprites":[{"prefab":"NPC-Jason","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...Call it when you're free. "}]},{"spans":[{"text":"It might come in handy."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...Alright."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"325","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray Institute of Biotechnology, Galatea Corporation."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"What are you looking at?"}]}]},{"sprites":[{"prefab":"NPC-MrsGray","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"A requisition form."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Gray looks at the list on the table. Her fingertips drum on the table every now and then, and her brow remains perpetually furrowed."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Is it from \"her\"?"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":2,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Yes. "}]},{"spans":[{"text":"She sent a message, but refused to speak to me. "}]},{"spans":[{"text":"...She'll probably ignore everyone except Father or Teacher."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":1,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Gray."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"That woman... "}]},{"spans":[{"text":"What is this? A declaration of war or a surrender?"}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Given her personality, I would say neither."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Heh. "}]},{"spans":[{"text":"Well, however repulsive she might be, right now I'm the one who controls how the mission proceeds."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Sending the order to you is a sort of assurance."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":1,"side":"left","tags":{}},{"prefab":"NPC-MrsGray","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"Yes... "}]},{"spans":[{"text":"In the end, the mission must be carried out, and it is almost time."}]}]},{"sprites":[{"prefab":"NPC-grig","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Indeed. The day on which the fireworks bloom has been decided, and none may change it."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"413","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Outside a closed-down Galatea pharmaceutical plant in Berlin City."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Crowd","raw":"SE1"}],"speaker":"Protester","narrator":false,"pages":[{"spans":[{"text":"You sons of bitches! What are we supposed to do if you close down the plant? "}]},{"spans":[{"text":"Is the government trying to kill us?"}]}]},{"sprites":[],"ops":[],"speaker":"Protester","narrator":false,"pages":[{"spans":[{"text":"We can't buy medicine anymore! There's no way we can survive like this! "}]},{"spans":[{"text":"What the hell are you trying to do?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"An angry crowd is gathered in front of the police line at the pharmaceutical plant, shouting and screaming with heartfelt anger. "}]},{"spans":[{"text":"Things are slowly getting too out of hand for the police to handle alone."}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"We've been tasked by Madam Romy to assist the police in dispersing the crowd and maintaining order. "}]},{"spans":[{"text":"I've read through reports concerning similar cases before we arrived, but this is much worse than what I was expecting. "}]},{"spans":[{"text":"What is your opinion?"}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"...As if my opinion is worth a damn. "}]},{"spans":[{"text":"Aren't you the one in charge here?"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"Yes, but you have been a Stasi agent much longer than I have, Agent J. "}]},{"spans":[{"text":"I believe your experience will be helpful in completing this mission. Is there a problem with that?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"No matter how he looks at her, there is no doubt that Mona is one of \"Romy's people\". "}]},{"spans":[{"text":"They are not on the same side."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"What else can we do... All she did was ask us to help maintain order. "}]},{"spans":[{"text":"Start by contacting the person in charge here and just play it by ear. If you can't even figure out that much on your own, then what business have you got being an agent?"}]}]},{"sprites":[{"prefab":"SP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Mona","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Mona nods silently at J with a strange look in her eyes."}]}]},{"sprites":[{"prefab":"NPC-Keven","expression":5,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"J","narrator":false,"pages":[{"spans":[{"text":"(Why did Romy send me on such a pointless errand? Is this her way of telling me to \"stay out of trouble\"?) "}]},{"spans":[{"text":"(She even sent a Doll to keep an eye on me... God dammit.) "}]},{"spans":[{"text":"(I don't have time to waste in a place like this... )"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Somewhere deep inside his eyes where Mona's gaze can't penetrate, a fire blazes up."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"background","value":"10","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]}]}
