{"name":"-36-5-6End","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"196","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"},{"type":"bgm","value":"m_avg_labyrinth","raw":"BGM"}],"speaker":"Nyto","narrator":false,"pages":[{"spans":[{"text":"Father..."}]}]},{"sprites":[{"prefab":"NPC-Mercurows","expression":0,"side":"left","tags":{}}],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"179","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"}],"speaker":"Mercurows","narrator":false,"pages":[{"spans":[{"text":"But who may abide the day of Her coming, and She shall stand when She appeareth, for She is like a refiner's fire."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"173","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"}],"speaker":"Nimogen","narrator":false,"pages":[{"spans":[{"text":"It-it hurts! Fa-Father! Help me! "}]},{"spans":[{"text":"Who was it?! Who did this?! Stop it! Don't come in! It hurts! It hurts! AHHH...AAAAHHHHHHH!!!"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"206","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"You really do like this garden very much, considering how you come here to keep me company every day."}]},{"spans":[{"text":"My apologies... (Coughs) If only I wasn't so weak and feeble. You still have your own research, right? You don't need to keep worrying about me. Go do what you want to do."}]},{"spans":[{"text":"We're simply taking shelter here for a while. Once the storm passes, Father will surely bring us back."}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"201","raw":"BIN"},{"type":"whitescreen","raw":"白屏1"}],"speaker":"Lunasia","narrator":false,"pages":[{"spans":[{"text":"What's wrong? Did you oversleep? I'm Lunasia, no?"}]}]},{"sprites":[],"ops":[{"type":"whitescreen","raw":"白屏2"},{"type":"background","value":"230","raw":"BIN"}],"speaker":"Elisa","narrator":false,"pages":[{"spans":[{"text":"But that is your original name. "}]},{"spans":[{"text":"It is OUR original name."}]}]},{"sprites":[],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Tell me everything."}]}]},{"sprites":[],"ops":[],"speaker":"Elisa","narrator":false,"pages":[{"spans":[{"text":"The seawater is flooding in. You cannot leave this place in time."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The seawater and the brilliant blue light blend together, then everything is suspended in mid-air. "}]},{"spans":[{"text":"M4 knows that things aren't over yet."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"m_20winter_end1","raw":"BGM"},{"type":"credits","raw":"名单"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"【Polarized Light - END】"}]}]}]}
