ssion":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Are we short?! We don't have much time!!"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"No... We have enough. "}]},{"spans":[{"text":"But the labels are missing for these ones, which means we don't know who they're for."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"Only you can sort this out, Commander! "}]},{"spans":[{"text":"Find the intended recipients of these chocolates using your memory and understanding of the Dolls!"}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hold on... I just pulled an all-nighter and my head isn't the clearest! This is asking for the impossible! "}]},{"spans":[{"text":"Why don't we log the other ones and see—"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Dolls","narrator":false,"pages":[{"spans":[{"text":"Commander!! We're coming!!"}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=4%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"sfx","value":"AVG_Crowd_Run","raw":"SE1"},{"type":"bgm","value":"m_avg_casual","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"As the morning sunlight shines onto the floorboards in the lab, and the Dolls' excited jabbering can already be heard from outside the door. "}]},{"spans":[{"text":"...The Dolls are making their way to the office."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Kalin","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Kalina","narrator":false,"pages":[{"spans":[{"text":"...Good luck, Commander! "}]},{"spans":[{"text":"I'll go and give out the problem-free ones at the office!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Wait... Don't go!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Using my understanding of the Dolls? "}]},{"spans":[{"text":"The Commander stares at the chocolates with the missing labels and gulps nervously."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"If I end up giving these to the wrong Dolls... that's not a mistake that a simple apology can make up for. "}]},{"spans":[{"text":"Looking down at the chocolates, the Commander's heart starts pounding heavily in their chest."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]}]}
