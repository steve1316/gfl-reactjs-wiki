{"name":"-50-2-5","beats":[{"sprites":[],"ops":[{"type":"background","value":"black","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"作战室avg","raw":"BIN"},{"type":"bgm","value":"BGM_Room","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Command Center, Griffin Base. "}]},{"spans":[{"text":"Commander's office."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander closes their eyes for a catnap during their brief lunch break."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Select","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But their sluggish mind clears immediately when they feel a cold metallic object pressed against the back of their head."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Don't move."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Who's this?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The voice is digitally distorted."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"You don't need to know who I am, Griffin Commander. "}]},{"spans":[{"text":"All you need to know is that I will be the one who hands you over to my employer. "}]},{"spans":[{"text":"You possess a lot of confidential information that intrigues him."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Interesting. So you just swan into our base and declare that you're going to abduct me?"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"From what I know, that has happened in the past. "}]},{"spans":[{"text":"I've made it this far, I can certainly get you out of here too."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander turns their head to look behind them."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...Is this some kind of new prank, Hunter?"}]}]},{"sprites":[{"prefab":"BOSS-3","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"290,-150"}}],"ops":[{"type":"bgm","value":"2022_white_valentine_BGM2","raw":"BGM"}],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"...If I were actually an intruder and you turned your head just like that, you would've been dead by now."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"290,-150"}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"First of all, the character you're playing wants me alive, so she wouldn't kill me. "}]},{"spans":[{"text":"Second, if it were really an intruder, she wouldn't have to mask her voice. Only someone who didn't want to be recognized by me would do that. "}]},{"spans":[{"text":"Third, I can smell chocolate. Did you just eat some?"}]}]},{"sprites":[{"prefab":"BOSS-3","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"290,-150"}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Hunter lowers her gun."}]}]},{"sprites":[{"prefab":"BOSS-3","expression":2,"shown":true,"side":"left","tags":{"spritePosition":"290,-150"}}],"ops":[],"speaker":"Hunter","narrator":false,"pages":[