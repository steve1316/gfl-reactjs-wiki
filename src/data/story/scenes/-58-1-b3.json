arrator":false,"pages":[{"spans":[{"text":"Ramzan and Anna exchange looks and continue listening."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Still, the USA is practically a powder keg. They have a civil war on their hands any day now, so what are they doing over here?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Haha, if the Rangers hadn't come, how would we make a fortune?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We should thank them for giving us so many specimens.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"But we wouldn't have had to relocate if the Rangers hadn't attracted a bunch of enemy troops. It's always a chore every time we move.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"Anna & Ramzan","narrator":false,"pages":[{"spans":[{"text":"The Professor is Capita!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two blurt out the same realization they have come to at the same time, then look away from each other."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Capita will slip through the Rangers' net and escape unscathed."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":28,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"We've caught a big fish this time."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"What you've caught is a shark. We don't have enough manpower. "}]},{"spans":[{"text":"KS-23, withdraw from the information black zone."}]}]},{"sprites":[{"prefab":"KS23","expression":0,"side":"left","tags":{}}],"ops":[],"s