ans":[{"text":"He closes his eyes and rubs the center of his brow. His eyes are ringed by dark circles."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I know what I'm doing. "}]},{"spans":[{"text":"The way forward may be covered in barbed wire, but I have no choice but to keep going, even if I must do it on all fours."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Ever since that day, there's been no going back for me."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"72","raw":"BIN"},{"type":"bgm","value":"Campaion-58-3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"...The Professor won't wait. Hurry up, you lot.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Team 9, two vehicles just loaded. Preparing to return.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Team 6 still searching. No specimens found yet.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"????","narrator":false,"pages":[{"spans":[{"text":"Team 7 is on our way back.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":"??","narrator":false,"pages":[{"spans":[{"text":"If the Professor's work is delayed, you'll be the first to be thrown into the specimen processing room.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Make sure you complete the preliminary screening and loading of the specimens back 