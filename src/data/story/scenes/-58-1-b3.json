{"name":"-58-1-B3","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"98","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"Battlefield","raw":"SE1"},{"type":"sfx","value":"Gunfight","raw":"SE2"},{"type":"bgm","value":"Campaion-58-3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"3rd Platoon temporary command post, outer rim of the Red Zone. "}]},{"spans":[{"text":"It's impossible to make out anyone within view; the ceaseless sound of barrages is the only proof that the battle is still ongoing. "}]},{"spans":[{"text":"The wrecks of three destroyed transport vehicles within the crater are producing thick clouds of black smoke."}]}]},{"sprites":[{"prefab":"NPC-Pan","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Pan  Squad 2 Leader","narrator":false,"pages":[{"spans":[{"text":"We actually intercepted the American troops?! With our pretty much non-existent experience?! "}]},{"spans":[{"text":"I've got to write a ballad to commemorate this!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":28,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Fighting isn't that hard. I'll teach you little by little later on."}]}]},{"sprites":[{"prefab":"NPC-Pan","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Pan  Squad 2 Leader","narrator":false,"pages":[{"spans":[{"text":"You're awesome, ma'am! From now on, I'll do whatever you say!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":28,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Rest up for five minutes while we wait for further directives."}]}]},{"sprites":[{"prefab":"NPC-Pan","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Pan  Squad 2 Leader","narrator":false,"pages":[{"spans":[{"text":"Yes, ma'am!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whoosh! Whoosh! Whoosh! Several objects whizz past above them towards 3rd Platoon's battle position."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_Explosion","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Get down!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"background","value":"183","raw":"BIN"},{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna pulls Alexander, who is the closest to her, down to the ground. Then, a powerful shockwave sends her rolling almost immediately."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The world brightens and darkens. Dirt mixed with green crystal fragments smelling of rust and decay is sprinkled all over her head and body. "}]},{"spans":[{"text":"Someone seems to be shouting something. Anna glimpses a familiar figure, then darkness claims her..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"632","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"flashback","raw":"回忆"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Command College. "}]},{"spans":[{"text":"Many portraits of renowned figures are hanging on the wall in the fourth floor corridor. "}]},{"spans":[{"text":"The fifth from the right is a female scientist—Martha Meitner, who \"gained international fame for her groundbreaking achievements in Relic technology research.”"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"On this quiet afternoon, Anna hears the hiss of a spray paint can as she walks down the corridor."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":23,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Hm?"}]}]},{"sprites":[],"ops":[],"speaker":"Tall Male Student","narrator":false,"pages":[{"spans":[{"text":"amerikosi have no place in our school!"}]}]},{"sprites":[],"ops":[],"speaker":"Small Male Student","narrator":false,"pages":[{"spans":[{"text":"Get the hell out of the NSU, pindosi!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":24,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_23S_Crossroads_Warrior","raw":"BGM"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What are you doing?!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna runs up to the two cadets and shoves them angrily aside. "}]},{"spans":[{"text":"Martha's face on the portrait is now a smear of black, and profanities are scrawled above her head."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":24,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You assholes!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna punches one of them right in the face. "}]},{"spans":[{"text":"The cadet freezes in shock for a second, then he returns the blow, and the three of them are locked in an all-out brawl."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Combat_Hits","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=3%%delay=0.1%%range=5","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna takes a few blows before unleashing a flurry of punches on the two cadets, making them cower and back away. She glares at them with blazing eyes."}]}]},{"sprites":[],"ops":[],"speaker":"Tall Male Student","narrator":false,"pages":[{"spans":[{"text":"You assault your fellow cadets over a portrait of some pindosi bitch?!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":23,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Ha. And you take your anger out on a portrait just because you don't have the balls to fight on the battlefield?"}]}]},{"sprites":[],"ops":[],"speaker":"Tall Male Student","narrator":false,"pages":[{"spans":[{"text":"Херня! I'm gonna go out there and kill her right now!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The cadet suddenly spots a figure in his peripheral vision. He looks up."}]}]},{"sprites":[],"ops":[],"speaker":"Small Male Student","narrator":false,"pages":[{"spans":[{"text":"I-I-Instructor Ra-Ramzan?!"}]}]},{"sprites":[],"ops":[],"speaker":"Tall Male Student","narrator":false,"pages":[{"spans":[{"text":"Run! That's her brother!"}]}]},{"sprites":[],"ops":[],"speaker":"Small Male Student","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The two cadets sprint down the corridor and disappear like the wind. "}]},{"spans":[{"text":"Ramzan is standing silently at the end of the corridor, his eyes dark and flat."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"630","raw":"BIN"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna spits out a gob of blood angrily and dusts herself off. "}]},{"spans":[{"text":"The tall, straight-backed instructor finally walks up to her."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You saw the whole thing, then?"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I've got to say, you fight like a gorilla drunk on vodka."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Ha, well, sorry for embarrassing you, Combat Instructor."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna turns to leave."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"631","raw":"BIN"}],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Stop right there."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna keeps walking without looking at Ramzan."}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Anna Viktorovna Tsoi!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What, are you going to give a personal demonstration on how to fight properly because I was so bad, Instructor? Right here?"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Take the portrait down. Martha Meitner's."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna whirls around."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Ramzan, are you human?!"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I'm a Soviet, without a doubt. "}]},{"spans":[{"text":"What about you?"}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What kind of Soviet? The kind that cower in the safety of this school and can only gloat by defacing portraits?"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"She is an American researcher of Relic tech. What is your nationality?"}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I don't need to prove anything to you."}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"You need to prove it to yourself. "}]},{"spans":[{"text":"Take it down, or... take that off."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan points first at the portrait, then at Anna's cadet armband."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You have no right!"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"I will never let someone who doesn't know which side they're on go on the battlefield."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You're the one who doesn't know!"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"Are you taking it down or not?"}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"...You just don't want me out there."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ramzan gazes at Anna coldly."}]}]},{"sprites":[],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Are you scared that I'd outrank you one day? "}]},{"spans":[{"text":"You've always been like this. Back in Beslan—"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"How dare you bring up Beslan?! "}]},{"spans":[{"text":"My brother is dead, but you live. "}]},{"spans":[{"text":"Anna Tsoi, why wasn't it you who died that day?!"}]}]},{"sprites":[],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Creep","raw":"SE1"}],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"...!!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"Heartbeat","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"closeMask","raw":"关闭蒙版"},{"type":"openEyes","raw":"睁眼"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Creep","raw":"SE1"},{"type":"background","value":"98","raw":"BIN"},{"type":"sfx","value":"AVG_Tinnitus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna can feel herself being dragged along. Her head is spinning as if she had downed a whole bottle of vodka."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"bgm","value":"BGM_23S_War_Sacrifice","raw":"BGM"}],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Ma'am? Ma'am!","style":{"size":"50"}}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Are you... trying to shake me to death...? Promotion?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna's ears keep buzzing. She retches twice, but nothing comes out."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Alexander rolls his eyes and lets go of Anna. He offers her a transparent pack labeled \"glucose\"."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Drink this."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna takes the pack, tears it open at the slit, and starts taking small sips from it."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The survivors of 3rd Platoon are either lying prone or sitting upright. A medical Doll is tending to their injuries."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Camera_Focus","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Wiktor is sitting back-to-back with another soldier and fiddling with the communicator in his hands."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Captain Ramzan got here and mounted a rescue with a Doll force. "}]},{"spans":[{"text":"Look at that pretty medic Doll. If Pan saw her, he'd definitely try to flirt..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The burly man suddenly starts blinking back tears."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":30,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"What... happened to Pan?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"The pindosi fired four mortar shells when they were retreating. "}]},{"spans":[{"text":"One of them hit Squad 2's position. Pan... was right where it landed."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"...How many have we lost?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"...Four. Four more are injured."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":31,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Not far away, an injured soldier moans in pain. Other survivors stare dazedly at the sky while cradling their guns. "}]},{"spans":[{"text":"Alexander's head is buzzing and blank."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Pan was always going on and on about how popular he was with women and how great a poet he was. He kept calling himself the Pushkin of the 21st century..."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"I know it was an order from the brass. We had no choice but to fight. I just... I just..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Alexander takes a deep and shaky breath and turns his face away."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna pats him on the shoulder."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Alexander, you are the only veteran who enlisted willingly in the 3rd Platoon. Why did you enlist?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"...I've got nothing left. "}]},{"spans":[{"text":"No family, no friends, no lovers... "}]},{"spans":[{"text":"I couldn't throw away even my country, could I...? "}]},{"spans":[{"text":"Well, it wasn't actually that noble. I simply had nowhere else to go, so I stayed with the Military."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"He tries to keep his tone casual and nonchalant, as if he were talking about the weather or what to have for lunch."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Enough about me. What's your story? "}]},{"spans":[{"text":"You want to be a field marshal. I, for one, know that's not true."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"You want the truth?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Rope","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna finishes her last sip of the glucose solution."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"...I want to end the war."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"...I've heard many people say that."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"And?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"And they all died. "}]},{"spans":[{"text":"And the war carries on."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I have a question."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Shoot."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}},{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"If everything in life is futile, then what is the point in struggling?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"I think..."}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"Vice-Leader, Leader, I detected that radio signal again!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23SF_zonghe_1","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Alexander's answer is interrupted."}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"These people are definitely nearby. Could they be the Rangers in the Red Zone?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Wiktor holds onto their one last compact radio transceiver and stares at Anna with wide eyes."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna turns to Alexander."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Didn't you say you couldn't crack their channel encryption?"}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"I can't with our equipment, but it'd be a walk in the park for those Dolls! "}]},{"spans":[{"text":"I hear Tactical Dolls come with a bunch of functions. They're fearsome fighters and are also computers on legs. If we can just borrow one or two..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"They're elite forces. They are off-limits for 3rd Platoon."}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"Isn't that captain your—"}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[{"type":"shake","value":"0.1","raw":"Shake"},{"type":"sfx","value":"AVG_Punch","raw":"SE1"}],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"OW!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Alexander kicks Wiktor in the shin. Still holding the transceiver in one hand, Wiktor hugs his shin and hops around, howling in pain."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":31,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I'm dizzy."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna leans against a large rock and closes her eyes. "}]},{"spans":[{"text":"Alexander shrugs, and Wiktor limps away miserably."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"sfx","value":"AVG_wind_grass","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Wearing the protective suit in this muggy wind is as unpleasant as wearing a wet raincoat that sticks hotly to one's skin. "}]},{"spans":[{"text":"Anna keeps her eyes closed and drums her fingers lightly against her thigh. "}]},{"spans":[{"text":"After a moment of silence, Alexander eventually decides to venture a question."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"...Are you two fighting?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":31,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Don't stick your nose into things that don't concern you."}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"It's a good thing that you can still fight. "}]},{"spans":[{"text":"If Martina was still alive, we would be fighting every day, and nothing would make me happier."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":28,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"If... "}]},{"spans":[{"text":"Ha, you almost sound like a babushka who has to mediate all the fights at home."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Alexander watches as Wiktor returns just as miserably. Anna opens her eyes."}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"Ma'am, the captain won't talk to me. He's asking for you personally."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Мудак!"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"Why don't I go?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Are you asking for a dressing down?"}]}]},{"sprites":[{"prefab":"NPC-Alexander","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Alexander","narrator":false,"pages":[{"spans":[{"text":"If it means he'll lend us the Dolls, he can dress me down as much as he wants. "}]},{"spans":[{"text":"\"Merits on the battlefield don't just jump into your hand\", no?"}]}]},{"sprites":[{"prefab":"NPC-Wiktor","expression":0,"side":"left","tags":{"Position":"0,60"}}],"ops":[],"speaker":"Wiktor  Squad 1 Leader","narrator":false,"pages":[{"spans":[{"text":"What do we do, ma'am?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Heartbeat","raw":"SE1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna gets to her feet sullenly."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"I'll go ask for them. Don't follow me."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点2"},{"type":"background","value":"469","raw":"BIN"},{"type":"bgm","value":"GF_2022_Summer_Battle_3","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Temporary command post. "}]},{"spans":[{"text":"Ramzan is talking to a Doll with a grim look on his face."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Anna approaches him and gives him a standard military salute."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":false,"pages":[{"spans":[{"text":"Captain."}]}]},{"sprites":[{"prefab":"NPC-Pamzan","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"Ramzan","narrator":false,"pages":[{"spans":[{"text":"...Take KS-23 to the Red Zone entrance and gather topographical data in the area. "}]},{"spans":[{"text":"If you encounter any life forms, you are authorized to decide if they're friend or foe and open fire at your own discretion. "}]},{"spans":[{"text":"If you lose our signal, save the data offline until you return to the rendezvous point and then share them with your teammates."}]}]},{"sprites":[{"prefab":"SVT38","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"SVT-38","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The T-Doll turns to leave."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":29,"side":"left","tags":{}}],"ops":[],"speaker":"Anna","narrator":fals