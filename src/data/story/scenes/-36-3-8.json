":{}},{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Nytos lead the S.F. Dolls past the AR Team, who stare at them with silent bewilderment, and walk outside the gate."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Let's go. They'll buy us time."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Did you...consume their neural clouds?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"I simply joined with them - became one with them."}]},{"spans":[{"text":"Whether they're Griffin's backups or these poor, pitiful Nytos, I simply gave them the right to live on."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Live on..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Coalescence is not necessarily a mistake. Ego and acceptance are not entirely opposed to each other."}]},{"spans":[{"text":"Lunasia, the change you can bring will be far greater than what I can do, and when the time comes, I hope you will not refuse."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Let us hurry and meet with the Commander. These Dolls will not last long. We need to get to the base as soon as possible to prepare."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Yeah... Let's move out ASAP."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The team starts making their way into the base, and just before she enters the building, M4 looks back at the Nytos. The sun illuminates the sleeves of their black dresses, casting a gentle radiance on them."}]},{"spans":[{"text":"Although the Nytos have always been their enemies, for some reason, she is suddenly overcome by sympathy and a sense of nostalgia at the sight of these girls."}]},{"spans":[{"text":"However, there is no turning back now."}]},{"spans":[{"text":"M4 looks away. She knows that these girls in black will soon drown in red."}]}]}]}
