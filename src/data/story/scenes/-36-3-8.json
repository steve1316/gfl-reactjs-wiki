xt":"M4, do you trust me?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"I thought I've answered that question already."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"No. What I mean is, do you TRULY trust me? Can you understand me and not fear me?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I don't know how to answer you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"That, too, is an answer in itself."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M4 senses Dandelion connecting to the statue-like Dolls. The massive processing load makes her chest feel hot. "}]},{"spans":[{"text":"Dandelion slowly walks toward the Nytos, and as she approaches them, the Nytos in the front begin to stir."}]},{"spans":[{"text":"The Sangvis units around the Nytos also open their eyes, and the darkness is lit up by these orbs of savage crimson."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"Don't follow me."}]}]},{"sprites":[{"prefab":"NytoIsomer","expression":3,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"