{"name":"-36-3-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[{"type":"background","value":"46","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"bgm","value":"BGM_Truth","raw":"BGM"}],"speaker":"Dandelion","narrator":false,"pages":[{"spans":[{"text":"You were faster than I expected. That's the AR Team for you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NytoIsomer","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"The Military units have linked up and they're preparing to attack this place. So, what's your plan?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Sorry to interrupt, M4, but I just detected some Nyto and Sangvis signals."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}},{"prefab":"RO635","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Nyto AND Sangvis? "}]},{"spans":[{"text":"So which side should I fight? Or should I kill them all?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Don't fight any of them."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"So...that's your plan?"}]}]},{"sprites":[{"