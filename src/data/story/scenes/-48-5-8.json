{"name":"-48-5-8","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the airport warehouse, the Commander successfully repels Paradeus' assault with Sangvis Ferri's help."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Tsk, it really was a trap. They didn't even bring Ange."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Don't panic, Commander. Ange won't go without putting up a fight."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I know. Let's get ourselves out of this sticky situation first."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Khaybar runs over while panting heavily."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What is it?"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Commander... I just received some terrible news..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What happened?"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"I...Don't know how to tell you... "}]},{"spans":[{"text":"You'd better see for yourself..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's hands start trembling inexplicably as they bring up the news. "}]},{"spans":[{"text":"\"Breaking news! Multiple PMC bases came under artillery bombardment in the Neo-Soviet Union...\""}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Explo_Close","raw":"SE1"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"183","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander's mind goes blank. All they can see is a blinding white light."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Save us..."}]}]},{"sprites":[{"prefab":"BOSS-8","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOff","raw":"黑屏2"}],"speaker":"Agent","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander..."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What happened to the Dolls?!"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"KH2002","narrator":false,"pages":[{"spans":[{"text":"I looked through all the reports, but no one has been able to contact the Griffin base because of an electronic blockade. We don't know what's happening in there."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I need to go back! Right now! "}]},{"spans":[{"text":"Khaybar, get me the next flight!"}]}]},{"sprites":[{"prefab":"KH2002","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Khaybar","narrator":false,"pages":[{"spans":[{"text":"Yes, Commander! I'm already contacting the airport staff! "}]},{"spans":[{"text":"However, due to the most recent destruction to airport facilities, it will take them some time to make the arrangements..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander crumples into a sitting position on the ground in a daze. "}]},{"spans":[{"text":"The airport is actually quite chilly, but a roaring fire is burning in their heart..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"415","raw":"BIN"},{"type":"bgm","value":"GF_21summer_avg_Reunion","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Neural Cloud Storage Room, Basement 3, Griffin Base. "}]},{"spans":[{"text":"Standing in front of the crisscrossed network that is the neural cloud servers, Helian looks both small and frail."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"So many... Is our data all stored within them?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You see? That's why I told you it's impossible."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Then think of a way to make it possible."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"With our current manpower, the most feasible solution would be to compress all the data into a single storage unit before transport. "}]},{"spans":[{"text":"However, this comes with two risks. Firstly, there's a possibility that some data will be lost during decompression. Secondly, if the storage unit is destroyed, all our Dolls' data will be lost."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Can't we back up the data?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You've got to be kidding me. Where am I supposed to find enough spare hard drives to do that?!"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We'll do it your way."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Are you absolutely sure? This is the memory of the entire Griffin base... No..."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"For the Dolls, this is their most essential component... "}]},{"spans":[{"text":"The slightest damage to the data could have a serious impact on their self-concept."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Yes, I'm sure. Get started."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You know, there's actually another solution. "}]},{"spans":[{"text":"We leave the neural cloud server right here. I'm confident that the insurgents won't find them."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"What if they just level the entire Griffin base?"}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Judging by the commotion they've caused so far, this isn't going to be a small-scale attack. "}]},{"spans":[{"text":"I think...This is just the beginning."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"Since you've already made the decision, I'll start making the preparations."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Then please."}]}]},{"sprites":[{"prefab":"NPC-Persica","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Persica","narrator":false,"pages":[{"spans":[{"text":"You... Yes, you, rugged Doll. Come and give me a hand."}]}]},{"sprites":[{"prefab":"MAC10","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ingram","narrator":false,"pages":[{"spans":[{"text":"Sure."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Helian's communicator chirps to life."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Helian, I'm leading the Dolls over to regroup with you. When we're there, we'll escort our neural cloud servers and evacuate.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Understood. But where are we supposed to go?"}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"We can't confront the enemy's assault head-on, so we must go downward to evade them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"Downward... But we'll be fencing ourselves in..."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"We don't have a choice.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Helian. Even if it's a dead end, we'll definitely think of a way out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"...Alright, I understand."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Helian ends the call. "}]},{"spans":[{"text":"The ceiling quakes due to the relentless explosions. Helian wipes away the dust stuck to the surface of the neural cloud servers."}]}]},{"sprites":[{"prefab":"NPC-Helian","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"Helian","narrator":false,"pages":[{"spans":[{"text":"As long as we still have everyone, we will have a Griffin base no matter where we go."}]}]},{"sprites":[],"ops":[{"type":"background","value":"394","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"spark","raw":"火花"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...In the dormitory, Kryuger has assembled all the surviving Dolls."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"10258","raw":"BGM"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Now let's do another headcount and reorganize our teams."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The T-Dolls line up in an orderly fashion and starts counting off one by one. "}]},{"spans":[{"text":"Kryuger's face grows increasingly grim as the process continues."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Dolls in the back, keep going!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls look at each other in wordless dismay."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"That was the last of us, Mr. Kryuger."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"There is a long silence."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"I see. "}]},{"spans":[{"text":"All of you, take turns to undergo emergency repairs at GSh-18's. Let the more heavily damaged Dolls go first. "}]},{"spans":[{"text":"Rest and prepare for our operation in the meantime. We're setting off in 20 minutes."}]}]},{"sprites":[{"prefab":"M1928A1","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Thompson","narrator":false,"pages":[{"spans":[{"text":"Roger."}]}]},{"sprites":[{"prefab":"WA2000","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"WA2000","narrator":false,"pages":[{"spans":[{"text":"What next, Mr. Kryuger? What's our operation plan?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Escort the neural cloud servers to the bottom level and await rescue. "}]},{"spans":[{"text":"This is going to be a very difficult battle. You must be prepared for that. "}]},{"spans":[{"text":"I'm not one to give out false reassurances. I'll just give it to you straight— "}]},{"spans":[{"text":"This mission is practically impossible."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls' pale faces look even more dejected."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"We have already suffered terrible casualties, but more suffering awaits us. "}]},{"spans":[{"text":"Our only hope for victory is to deliver the neural cloud servers to safety."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"If we succeed, then all of you, as well as the Dolls who have perished, will return. "}]},{"spans":[{"text":"If we fail, the Griffin base will cease to exist."}]}]},{"sprites":[{"prefab":"M14Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"shake","raw":"Shake"}],"speaker":"M14","narrator":false,"pages":[{"spans":[{"text":"We'll... cease to exist..."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"In all my years of military service, frankly speaking, this isn't the bleakest battle I've encountered—it's not even the second or third. "}]},{"spans":[{"text":"In the past, I would've started lecturing you on how to deal with this kind of situation. "}]},{"spans":[{"text":"But now, I know that you have already experienced even darker moments. "}]},{"spans":[{"text":"And the Commander has led you all out of the abyss one step at a time, by treading on the corpses of your friends and foes."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A faint glimmer returns to the dispirited eyes."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"To all of you, who have already experienced true despair, this is all I have to say."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dolls are now ready and getting back to their feet one after the other."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Any more questions before we set off?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A slender arm is raised amid the silent group."}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"Tokarev, what can I clarify for you?"}]}]},{"sprites":[{"prefab":"TT33","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Tokarev","narrator":false,"pages":[{"spans":[{"text":"When will we be able to put all this bloodshed and strife behind us?"}]}]},{"sprites":[{"prefab":"NPC-Kyruger","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":"Kryuger","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"I'm sorry, Tokarev. "}]},{"spans":[{"text":"\"Only the dead have seen the end of the war.\""}]}]}]}
