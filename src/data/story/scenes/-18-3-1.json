{"name":"-18-3-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"99","raw":"BIN"},{"type":"bgm","value":"BGM_Sneak","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"M4, do you read me?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{"通讯框":""}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Loud and clear."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I believe you understand that we're in treacherous waters. "}]},{"spans":[{"text":"Just destroying Sangvis Ferri will not be enough to stop the Military. "}]},{"spans":[{"text":"We need to know more, understand more."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Hmm."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"So I'll give it to you straight. I already know you're going to meet Mastermind. "}]},{"spans":[{"text":"I'm guessing she traded you the location of the missing SOP-II and M16."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"But in truth, you don't actually have much hope of finding them, so you're prepared to take her with you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"They've been gone too long... Are you going to stop me?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"There's a saying, \"Our eyes are our prison, and all we see are the walls of our gaol.\" "}]},{"spans":[{"text":"Don't be bound by what you know, and don't let a blind thirst for revenge lead you astray."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"So what?! So I shouldn't do anything at all?! Just obey your orders?! "}]},{"spans":[{"text":"You promised me you'd let me find my friends! Well?!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"And if they're no longer around?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...If they're no longer around, then everyone who hurt them will pay!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"So if you want revenge, on whom will you exact your vengeance? "}]},{"spans":[{"text":"Are you planning to kill every Sangvis unit? Kill Captain Yegor? Then what?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"There's no \"then\". "}]},{"spans":[{"text":"I can't just do nothing... I can't go back to being my old self...the weak and cowardly M4A1..."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Cowardice may be shameful, but it is not fatal. "}]},{"spans":[{"text":"Courage may be awe-inspiring, but it will lead you into the abyss."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then...what should I do...? "}]},{"spans":[{"text":"I don't want to keep being protected by everyone, nor do I want others to sacrifice themselves for me. If I had the choice, I wouldn't even want to be M4A1!"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"You still have a choice. "}]},{"spans":[{"text":"Choose not to die with Mastermind, even if your teammates are no longer around."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"You want to capture her. You want ME to capture her."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"This is our last chance. Our last chance to keep more people from getting hurt. "}]},{"spans":[{"text":"Meet her. Buy time.Then the others will find a way to seize her. "}]},{"spans":[{"text":"Do you accept this request?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"And if I fail?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Then I will activate the last resort. There will be nothing left."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":4,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Then...it makes no difference to me."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"98","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"It's about time. "}]},{"spans":[{"text":"M4, can you see the airdrop location? "}]},{"spans":[{"text":"And how are things on 404's end?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Ah...sorry... I haven't seen any airdrop."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"How about 404?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"...I wasn't synced with them just now."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...What's with you...? "}]},{"spans":[{"text":"Don't tell me you're starting to get cold feet at a time like this."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"No... I'm just... "}]},{"spans":[{"text":"...It's a message from 404. "}]},{"spans":[{"text":"They've found the drop site."}]}]},{"sprites":[{"prefab":"G11","expression":2,"side":"left","tags":{}}],"ops":[{"type":"background","value":"71","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"This mission's gone on for way too long... My limbs are about to fall off..."}]}]},{"sprites":[{"prefab":"UMP9","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Ahahaha, well, we need to train you from time to time, Gr G11~"}]}]},{"sprites":[{"prefab":"G11","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"I don't want to train... I want to stay at home forever..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Hang in there a little~ Who knows, we might never need to go on a mission again after this~♪"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Hearing that from you gives me chills..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Don't sweat the small stuff. How are our surroundings?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"Do you think M4 really doesn't know where M16 is?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Is that your patrol report?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"I don't think she'd vanish just like that."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"If you're so concerned about her, then why not leave 404 and join me in looking for her?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So you're already here. "}]},{"spans":[{"text":"How about it, 416? Sound like a good idea to you?"}]}]},{"sprites":[{"prefab":"HK416","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"...Tsk. Gr G11, keep watching the perimeter with me."}]}]},{"sprites":[{"prefab":"G11","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"Gr G11","narrator":false,"pages":[{"spans":[{"text":"Why do I have to go too...?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"It seems the main cast is all here, so let's see what this airdrop package contains."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"133","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"A strange...container? "}]},{"spans":[{"text":"Could it be a warhead?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Looks like some sort of cannister. There are five of these... "}]},{"spans":[{"text":"I don't know where Ange got them from, but it's clear that a single one of these glass shells is scarier than all of Sangvis Ferri put together."}]}]},{"sprites":[{"prefab":"UMP9","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Are they so dangerous? They look pretty unassuming to me..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Looks like this is going to be the biggest surprise we can give the Military. "}]},{"spans":[{"text":"AR-15, it's time for you to shine. I'll leave the connection and installation of the explosives to you. ♪"}]}]},{"sprites":[{"prefab":"AR15","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Bitch, you're doing this on purpose, aren't you?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well, you're the record holder for explosions among us. Didn't you load up with those things when you set out, as always? "}]},{"spans":[{"text":"I don't want to die for nothing because of a little mistake during the preparation, which is why I'm leaving it to you."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[{"type":"background","value":"71","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"AR-15."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Understood."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"I have eight blocks of C-type TNT which can be detonated by remote control. I also have smoke flares and thermite strips for controlled demolition. "}]},{"spans":[{"text":"What do you plan to do with them?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Frankly speaking, I'm not too sure either. Why not ask Ange? "}]},{"spans":[{"text":"Ange, can you hear me? We found your package."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{"通讯框":""}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Is that so? That was sooner than I expected. "}]},{"spans":[{"text":"Is everyone there?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"We're all gathered, just waiting for your next order."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Alright. This means we can move on to the next stage."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Before you send us to our deaths, would you mind telling us what these things contain?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Let me see... "}]},{"spans":[{"text":"From the image, I'm guessing that they're sealed radial polarizers."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So what's inside them?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"I can tell it's Collapse Fluid. I can't believe that old man actually dared drop this stuff from the air... And five cannisters too. "}]},{"spans":[{"text":"Still, each cannister doesn't seem to contain much...which means the contaminated zone won't be too large either..."}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Isn't this the stuff that triggered the previous world war?"}]}]},{"sprites":[{"prefab":"UMP9","expression":2,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"To think we'd have a Doll who actually read up on her history. That deserves praise."}]}]},{"sprites":[{"prefab":"UMP9","expression":3,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"Hehehhe..."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"By putting the Collapse Fluid together with the remote controlled explosives, I take it you want to make dirty bombs? "}]},{"spans":[{"text":"This stuff is going to affect humans a lot more than Dolls when it goes off, right?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Collapse Radiation. Dolls were initially developed because humans couldn't enter contaminated zones filled with radiation. That's part of history class too."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"So we're not the only ones who're going to die."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"This may sound weird coming from me, but I'm the one who's most likely to die. After all, death is a distant concept for Dolls."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"A distant concept, huh... "}]},{"spans":[{"text":"I can't just agree with that."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's true. After all, you've gone through different things than ordinary Dolls. "}]},{"spans":[{"text":"Alright, enough chit-chat. I've sent the coordinates where I want them to be planted. Once they're in place, get as far away from them as possible. "}]},{"spans":[{"text":"Dolls aren't easily affected by Collapse Radiation, but the explosion generates extreme temperatures that can melt even military armor plating."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"The ideal weapon for dealing with the Military and Sangvis Ferri."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"Yes, but I would like all of us to get out of the blast radius before using it."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"But I suppose we can evacuate only if we have Mastermind with us?"}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"We either capture her or blow everyone to kingdom come."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Well, you heard her. Y'all know what to do?"}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Pairing up will make it quicker. I'll handle two cannisters."}]}]},{"sprites":[{"prefab":"UMP45","expression":0,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"No problem. 9 will be with me and 416 will be with Gr G11. Alright, get to work~"}]}]}]}
