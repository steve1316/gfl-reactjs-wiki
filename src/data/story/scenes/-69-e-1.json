{"name":"-69-E-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"463","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The air gradually grows thin. "}]},{"spans":[{"text":"She struggles to remain conscious, but consciousness eludes her, leaving her with just a faint smile. "}]},{"spans":[{"text":"Bright lights flicker. Ba-dump, ba-dump, ba-dump—like a pumping heart..."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"...?!"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Expedition_Story","raw":"BGM"},{"type":"openEyes","raw":"睁眼"},{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"background","value":"704","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16's eyes snap open in shock. She slowly gets to her feet."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The waves above her head cast a pulsing light on her. "}]},{"spans":[{"text":"All around her, under her feet... is an empty void."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Oof..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 tries to touch the white glow concealed in her body— "}]},{"spans":[{"text":"It is a tarot card."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Blessing of the [Wheel of Fortune]—","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The endless cycle of destiny; the liquor of victory that dispels all confusion.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Cheers_People","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Three wine glasses filled with a clear yellowish liquid clink in the air. "}]},{"spans":[{"text":"That moment is imprinted on the face of the tarot card named \"Wheel of Fortune\" like a snapshot made by a camera."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Is that... whiskey?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"All of a sudden, a thought occurs to M16, and her face freezes..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"flashback","raw":"回忆"},{"type":"frame","value":"2","raw":"边框"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"RO635Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Leinad Kcaj sent us a letter. "}]},{"spans":[{"text":"The letter mentioned a way of saving everyone..."}]}]},{"sprites":[{"prefab":"AR15Tarot","expression":0,"side":"left","tags":{"Position":"0,250"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"This is what the guy was talking about—the liquor that clears away all confusion?"}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"704","raw":"BIN"},{"type":"closeMask","raw":"关闭蒙版"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"\"Leinad Kcaj\"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 keeps repeating this tongue twister of a name. "}]},{"spans":[{"text":"Then she suddenly bursts out laughing."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"\"Leinad Kcaj\"—Jack Daniel. "}]},{"spans":[{"text":"Her favorite whiskey."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"This is... absolutely nuts... "}]},{"spans":[{"text":"Is this the gift of the \"Wheel of Fortune\"...? "}]},{"spans":[{"text":"Or maybe it's more of a punishment?"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_door_storehouse","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble... Faint tremors emanate from the depths of the ocean. "}]},{"spans":[{"text":"A dark hole opens up slowly by her feet... "}]},{"spans":[{"text":"A new world is about to begin."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"We will meet again very soon, M4... "}]},{"spans":[{"text":"Hopefully for the last time."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"},{"type":"shake","raw":"震屏3"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a chuckle, M16 steps into the hole without any hesitation..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=CJ_suduxian%%","raw":"common_effect"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"},{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"},{"type":"sfx","value":"AVG_flag","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She closes her eyes as she falls for what feels like an eternity..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even if it isn't the last time, that's okay. "}]},{"spans":[{"text":"Because she will find M4 no matter how many times it takes. She will be by her side and kindle the embers of hope. "}]},{"spans":[{"text":"Just as she has done through countless years across countless reincarnations that M4 has forgotten..."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"effect","value":"%%code=CJ_suduxian_destroy%%","raw":"common_effect"},{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"sfx","value":"AVG_2023Slow_Heart_Monitor1","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beep... beep... "}]},{"spans":[{"text":"The rhythmic sound of the equipment rouses her from unconsciousness."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"openEyes","raw":"睁眼"},{"type":"background","value":"568","raw":"BIN"},{"type":"cgDelay","value":"0.8","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 slowly opens her eyes. She studies the ceiling of the laboratory, which looks both strange and familiar."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Oh? You woke up ten minutes earlier than expected..."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She wills her body to move, but it refuses to cooperate."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_whitenoise","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 tries again in desperation, but can only hear the crackling of electric current."}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Relax, M16."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"A face wearing a kindly smile suddenly comes into her restricted view."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"....Havier?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"It appears that even her vocal module has been destroyed. Her thought is projected robotically through a speaker. It sounds a little comical."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Someone told me there's a surprise for me in the waters near the submarine base. "}]},{"spans":[{"text":"I didn't expect the \"surprise\" to be you. "}]},{"spans":[{"text":"That's the only upside to living to such a grand old age—live long enough and you'll see everything..."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"What happened to M4A1... and the Commander?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"Don't worry. Your old boss is doing fine. They were actually sent on an important mission a few days ago. "}]},{"spans":[{"text":"As for M4A1's whereabouts... you should know better than me."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...And Persica?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Did she say how long my repairs would take?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"She hasn't been informed yet."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Havier smiles a little at M16's wariness."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"I'll be honest with you. If word gets out that someone has returned from the Starfish System alive, it would practically be like throwing a wounded sheep into the clutches of a pack of ravenous wolves. "}]},{"spans":[{"text":"Think about all the vultures circling the submarine base... What do you think they'd do?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"So the fewer people who know about this, the better. Don't you agree?"}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Other than Persica, I can't think of anyone who can repair my frame.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"That is certainly true. "}]},{"spans":[{"text":"At the end of the day, IOP is technically just a civilian company... We're still very far behind compared to military technology."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_20Winter_Door_Open","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Clatter. A door opens some distance away. "}]},{"spans":[{"text":"M16 cannot turn her head, but judging from the gait of the footsteps, she deduces that the newcomer is male."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"...There you are."}]}]},{"sprites":[],"ops":[],"speaker":"Voice of a Middle-Aged Man","narrator":false,"pages":[{"spans":[{"text":"The initial repairs seem to have gone smoothly. "}]},{"spans":[{"text":"Thanks for your hard work, Mr. Havier."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"You're too kind."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After some perfunctory small talk, the man's footsteps draw closer. "}]},{"spans":[{"text":"As M16 strains her eyes to look sideways, a face that she has seen in newspapers and news reports suddenly comes into view."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Chief?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"I'm pleased that you still remember me, M16A1."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Still incredulous of what she's seeing, M16's eyes flicker back and forth between Havier and Zelinsky."}]}]},{"sprites":[{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"M16A1's frame was severely corroded by seawater and Collapse fluid. "}]},{"spans":[{"text":"I'm afraid this is the best we can do with IOP's current technology."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"All is not lost now that she has regained consciousness. "}]},{"spans":[{"text":"We'll handle the rest."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}},{"prefab":"NPC-Havel","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Havier","narrator":false,"pages":[{"spans":[{"text":"If I may ask... What does the old chief..."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"This is his wish. "}]},{"spans":[{"text":"We will provide M16A1 with whatever she requires."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...It sounds like I'm being treated as some kind of bargaining chip?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Even the AI mechanical voice cannot filter out M16's sarcastic tone. "}]},{"spans":[{"text":"Zelinsky peers at M16 with narrowed eyes."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"I can tell you in all honesty that—no, M16A1, you are not a bargaining chip. "}]},{"spans":[{"text":"You are a crucial chess piece. I'll go so far as to say you are capable of tipping the scales."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"How can you be sure I'll cooperate?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"You're not the only one who's seen that kind of thing. "}]},{"spans":[{"text":"More importantly, we are also searching for M4A1."}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-Zielinski","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Zelinsky","narrator":false,"pages":[{"spans":[{"text":"It's a deal worth considering, don't you think?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16A1 ponders the offer in silence. Finally, she opens her eyes again."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...What do you need me to do?","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"408","raw":"BIN"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"...Roger."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Click. "}]},{"spans":[{"text":"The call ends."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"Whew..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Cloak_Whoosh","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Whipped by the frigid wind, the figure standing on a high tower casts their cold gaze out into the distance. "}]},{"spans":[{"text":"The Doll teams sprint down the runway in the middle of the night-shrouded airport."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...Just wait. "}]},{"spans":[{"text":"...The time is upon us."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk!"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Huh?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a loud noise, the helicopter suddenly starts rocking violently."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"What... what's happening?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thunk! "}]},{"spans":[{"text":"Before Morridow can figure out what is going on, the noise comes again, and the helicopter rocks harder. "}]},{"spans":[{"text":"This time, Morridow finally identifies the source of the noise. Something is ramming into the helicopter—"}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"You... What?!"}]}]},{"sprites":[],"ops":[],"speaker":"???","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-Morridow","expression":9,"side":"left","tags":{"Position":"0,90"}}],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She can hardly believe what she's seeing. "}]},{"spans":[{"text":"She knows that the helicopter is currently flying through the air, and the readings on her dashboard confirm that. "}]},{"spans":[{"text":"However..."}]}]},{"sprites":[],"ops":[{"type":"fadePoint","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type"