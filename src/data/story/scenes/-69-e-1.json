rites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"Explode","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Boom! "}]},{"spans":[{"text":"An explosion erupts, triggering alarms on the dashboard of the helicopter. "}]},{"spans":[{"text":"Morridow instantly realizes what just happened."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Are you insane, Doll?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"But she is utterly helpless against the attack. All she can do is swerve the helicopter in the hopes that she can shake the T-Doll off. "}]},{"spans":[{"text":"But before she can put that into action, the Doll has already made her move..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Explosives. She destroyed the rotor system with a sticky bomb."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Y-you're trying to drag me to hell with you?!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Doll... is grinning."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Ugh!!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The helicopter hovering at a high altitude begins its sharp plunge after losing its rotor system. "}]},{"spans":[{"text":"The white-haired Doll, still holding on firmly to her silver cord, is still hanging outside the helicopter. "}]},{"spans":[{"text":"In fact..."}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"background","value":"406","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"With a powerful kick, she launches herself closer to the cabin using her momentum. "}]},{"spans":[{"text":"As the out-of-control helicopter plummets horizontally, the white Doll has almost made her way into the cockpit."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I won't let you—!!"}]}]},{"sprites":[],"ops":[{"type":"shake","raw":"震屏3"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"},{"type":"sfx","value":"AVG_bigglassbreak","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Before Morridow can even finish, the Doll's second blow has shattered the cabin door. "}]},{"spans":[{"text":"Her powerfully-built body hurtles into the cramped space with a massive impact... "}]},{"spans":[{"text":"And then..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Explode","raw":"SE1"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"BOOM!!!!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Ugh..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After the second explosion, Morridow knows without a doubt. "}]},{"spans":[{"text":"She has suffered an overwhelming defeat."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_cave","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"In the roaring flames around them, M16's footsteps toll in Morridow's ears like death knells."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=CJ_rain%%","raw":"common_effect"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"407","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"Haha..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Seemingly resigned to her fate, Morridow turns around to face the approaching Doll, whose pale hair is dyed blood red by the blaze behind her."}]}]},{"sprites":[],"ops":[],"speaker":"Morridow","narrator":false,"pages":[{"spans":[{"text":"I remember now... You're the last T-Doll of the AR Team..."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"background","value":"408","raw":"BIN"},{"type":"shake","raw":"震屏3"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"},{"type":"sfx","value":"AVG_Punch_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Morridow is about to speak again, but M16 knocks her out with a single punch."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Another fake."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After scooping her target into her arms, M16 takes another look around and finally sets her eyes in the direction of the warehouse."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...I suppose it's time."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"effect","value":"%%code=CJ_rain_destroy%%","raw":"common_effect"},{"type":"background","value":"356","raw":"BIN"},{"type":"bgm","value":"GF_EV9_Story","raw":"BGM"},{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Why are you all so tense, anyway?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 sits in the corner of the room, looking very relaxed."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...M4 hasn't woken up yet and you're asking us why we're tense?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"16! When will M4 wake up?!"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...Do you really think that's M4?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What do you mean?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 opens a pack of compact food and munches on them as she looks up at ST AR-15."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I understand that you're concerned about her, but don't let your feelings overrule your rationality."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":4,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"She isn't M4 at all."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Oh, 16, I don't think you know, but! "}]},{"spans":[{"text":"She may look like someone else, but she's really M4 on the inside!"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"No, she's not... At least, she's not the one we're looking for. "}]},{"spans":[{"text":"She IS M4, but at the same time she isn't."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"What does that mean?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Exactly what I said."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"background","value":"315","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You're always so hung up on trivial stuff that people don't care about, Commander."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Everyone else has entered the command post, leaving only the Commander, M16, and ST AR-15 outside."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...Do you count yourself among these \"people\" you mentioned?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"You know I never belong in the majority."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16A1 conjures a bottle of whiskey seeming out of thin air and starts taking massive gulps from it."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Ah... That felt good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"She wipes her mouth, puts the cap back on, then tosses the half-empty bottle over to ST AR-15."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":8,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"?! "}]},{"spans":[{"text":"What are you doing?!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Not expecting this at all, ST AR-15 fumbles to catch the bottle."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Haha, it tastes pretty good. You should have some."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 shoots her irritated sister a cheerful grin and waves her hand."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I need to have a chat with the Commander. You go on in first."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"ST AR-15 is still fuming, but instead of protesting, she simply enters the command post with the half-empty bottle of whisky wordlessly."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander crosses their arms and looks at M16."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"You're taking off?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I have my mission."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Since the Commander has correctly guessed what's on her mind, M16 drops all pretense and simply shrugs."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"That Stasi agent brought up something about my objective. "}]},{"spans":[{"text":"I need to go."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[{"type":"darken","raw":"同时置暗"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"I suppose there's nothing I can do to make you stay?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Haha, I wonder. You won't know for sure if you don't try, eh?"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 grins and snaps her fingers, then she looks over to the other side of the street. "}]},{"spans":[{"text":"Following her gaze, the Commander spots an oddly-shaped motorbike parked near the kerb."}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"BGM_23S_Crossroads_Warrior","raw":"BGM"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"...We're still friends, aren't we?"}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Of course. "}]},{"spans":[{"text":"...But some things don't stay the same, Commander."