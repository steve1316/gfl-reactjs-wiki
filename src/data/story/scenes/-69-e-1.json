e,"pages":[{"spans":[{"text":"Beak frowns in confusion. "}]},{"spans":[{"text":"She knows that any questions she asks will only be met with the usual silence."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"For the last time, M16A1 takes a deep breath. She closes her eyes and delves into the familiar space."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"},{"type":"shake","value":"%%type_id=2%%duration=1%%delay=0%%range=1","raw":"controll_shake"},{"type":"sfx","value":"AVG_tele_connect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"},{"type":"cgDelay","value":"0.5","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Yes, there's no mistake. Ange is definitely in the Eastern Tower.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"My job is done here... Best of luck.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...Got it.​","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[],"speaker":"System","narrator":false,"pages":[{"spans":[{"text":"Are you sure you want to [log out] from the Aeneas Conference Room?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"You are logged out.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"cgDelay","value":"1","raw":"CGDelay"},{"type":"sfx","value":"AVG_20Winter_Burnfire_Loop","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"645","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Rumble... "}]},{"spans":[{"text":"The dull explosions rumble on continuously. Avernus in the distance is doomed to fall into ruin. "}]},{"spans":[{"text":"M16 looks through the window and watches it burn. Meanwhile, ST AR-15 has finally been reunited with RO and SOP-II."}]}]},{"sprites":[{"prefab":"M16A1BOSS","expression":2,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"I'll see you in Frankfurt."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreen","raw":"黑屏2"}],"speaker":null,"narrator":true,"pages":[{"spans":[{"text":"The story in Berlin has come to an end, while the story in Frankfurt is only just beginning. "}]},{"spans":[{"text":"This is going to be a sleepless night."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[]}]}
