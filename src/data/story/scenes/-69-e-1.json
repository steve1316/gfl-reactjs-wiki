arrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"9","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"M16 lowers her hand and glances at the closed screen door nearby."}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"...That does seem to be the case."}]}]},{"sprites":[],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"(Coughs)"}]}]},{"sprites":[],"ops":[],"speaker":"M16A1","narrator":false,"pages":[{"spans":[{"text":"Good luck."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_footsteps_woodfloor","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After one more look at RPK-16, who is slumped feebly on the ground, M16 double-checks her terminal, then turns to leave the way she came."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"Stop_AVG_loop","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RPK-16 licks the blood off her lips as she gazes at M16's receding back. She leans back into the wall behind her and slowly closes her eyes."}]}]},{"sprites":[],"ops":[{"type":"blackscreen","raw":"黑屏1"},{"type":"cgDelay","value":"0.7","raw":"CGDelay"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_engine_speedup","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=99999%%delay=0%%range=2","raw":"controll_shake"},{"type":"blackscreen","raw":"黑屏2"},{"type":"background","value":"456","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Dead Sea. "}]},{"spans":[{"text":"The grooves on the dark tires are caked in green crystal fragments."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Beak's motorbike roars across the Dead Sea at an absurd speed against the howling wind."}]}]},{"sprites"