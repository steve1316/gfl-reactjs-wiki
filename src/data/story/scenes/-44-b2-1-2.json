{"name":"-44-B2-1-2","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"168","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the entrance of Athena's Owl."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"One minute left!"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Commander, we'll be standing by outside, if there's anything—"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"30 SECONDS!!!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"},{"type":"bgm","value":"GF_EV9_Intermission","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The Commander rushes into the bar."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Whew... Made it in the nick of time, at least. "}]},{"spans":[{"text":"45, what was with that signal interference?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"We still haven't identified the precise cause, but it was definitely very fishy.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Who would have thought that UMP45, the EW expert, would end up being jammed? And she took so long to resolve the issue too."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Actually, we didn't. ","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"We couldn't find any sign of a jammer, so we had to keep changing positions to gauge the jammer's effective range.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"How could you not find it? "}]},{"spans":[{"text":"In theory, jammers work by sending signals to generate interference that breaks our connections."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Yes, which is why I said it was fishy.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"With normal jammers, we'd be able to at least sense their presence even if we couldn't disable them.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But this particular jammer felt like it directly cut off our connections. I couldn't feel anything.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"That IS very dangerous."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Yeah, we'll discuss this further once the Commander is done in there.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"Right now, we need to rest.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Copy that."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_tele_disconnect","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"After ending the transmission, RO continues to puzzle over the jamming issue. "}]},{"spans":[{"text":"SOP-II shakes her by the shoulder and points to the huge display board opposite the bar. "}]},{"spans":[{"text":"The supermarket across the street turns its exterior display on at 3pm sharp. "}]},{"spans":[{"text":"The display written in a fancy font reads, "},{"text":"\"Congratulations on Galatea Corporation's 100th Anniversary\"","style":{"color":"#FFFF00"}},{"text":"."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"bgm","value":"10213","raw":"BGM"}],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"RO, look! "}]},{"spans":[{"text":"So that's why the crowd was going crazy earlier! It was all because of this! "}]},{"spans":[{"text":"This Galatea Corporation sure is swanky! Maybe when we get our own 100th anniversary, we can ask the Commander to buy an ad signboard just like this!"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"By then the Commander will be an old—"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Ahem, let's leave it till then."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Kay..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RO gazes at the monitor that is currently playing Galatea Corporation publicity videos. A good-looking refugee representative is currently making a speech to convey her gratitude."}]}]},{"sprites":[],"ops":[],"speaker":"Refugee Representative","narrator":false,"pages":[{"spans":[{"text":"...Galatea Corporation has done a lot for us, not only in terms of material support, but also in spiritual comfort. "}]},{"spans":[{"text":"Many people think that they are already bestowing a most gracious gift by giving us refuge, even though they've done little to improve our terrible living condition. "}]},{"spans":[{"text":"Only Galatea sees our pain of losing our homes to radiation contamination and offers a helping hand..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"What's on your mind, RO?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"The name of this corporation also came up in Bohnsdorf."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Both the timing and location where it showed up were surprising coincidental."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ting-a-ling... "}]},{"spans":[{"text":"The bell behind the door tinkles softly. "}]},{"spans":[{"text":"A white-haired girl steps out, carrying a bag of cat food in her arms."}]}]},{"sprites":[{"prefab":"AN94","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"94?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"15... "}]},{"spans":[{"text":"Hello, members of the AR Team."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Hi. Are Ange and the Commander having a good chat?"}]}]},{"sprites":[{"prefab":"AN94","expression":11,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...It's pretty good."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"AN-94 quietly walks to the side of the road and crouches down. The cat that was sunning itself on the eaves lazily jumps down and rubs up against AN-94's hand."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Since you're here, that means..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ting-a-ling... The doorbell tinkles again."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"If it isn't the AR Team! It's been a while."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Yes, it really has."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":5,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"You should go in and get a drink. The bartender here is pretty good. "}]},{"spans":[{"text":"Of all the bars Ange and I have visited, his mixing skills rank among the top three."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Wow... "}]},{"spans":[{"text":"Then why did you come out?"}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"It's obviously because there's someone annoying in there."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"You guys came to Berlin first. How is it?"}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Not too good. Recently, Ange's been... Well, I guess you can tell."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Is it because of that \"Morridow\" woman?"}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Of course... She's the cause of all this. If it weren't for her, we wouldn't even be here."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What is she like?"}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She's a devious high-spec Nyto who is an expert in pretense. She can change personalities the way people change clothes."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Is she good at disguising herself?"}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Without question. Morridow is a talented con artist. Ange's as sharp as a knife and even she was deceived."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"...We might have captured Morridow."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"15, we can't be sure of that yet. The Commander's still looking into it."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Oh? Then you'd better be careful. All the grief we've gone through recently is thanks to her."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"No wonder she could draw out that many Paradeus troops."}]}]},{"sprites":[{"prefab":"AK12","expression":13,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}},{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"She's also very good at changing her image to take advantage of her victim's weaknesses."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"I'm a bit concerned—someone like the Commander could certainly resist interrogation, but perhaps not a request for help coming from a weak and vulnerable person."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"While the Commander is both righteous and kind, I don't think they'd be easily deceived."}]}]},{"sprites":[{"prefab":"AK12","expression":12,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Don't worry, Ange's definitely going to give the Commander lots of useful suggestions."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ting-a-ling..."}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Oh my, so many familiar faces."}]}]},{"sprites":[{"prefab":"AK15","expression":6,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"AK-15","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Are you RPK-16 and AK-15 of Task Force DEFY?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Yes, we are. And you must be RO635, the current leader of the AR Team, right?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Hello, nice to meet you."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Nice to meet you."}]}]},{"sprites":[{"prefab":"RPK16","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Oh, don't mind me. Please carry on with your conversation."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"fadePointOn","raw":"黑点1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The moment RPK-16 shows up, AK-12 leans against the wall and closes her eyes to rest. "}]},{"spans":[{"text":"Silence hangs in the air. "}]},{"spans":[{"text":"In the distance, the Galatea Corporation publicity videos are still chattering on."}]}]},{"sprites":[],"ops":[{"type":"background","value":"325","raw":"BIN"},{"type":"effect","value":"%%code=NPC_TV_19%%","raw":"common_effect"}],"speaker":"Mrs. Gray","narrator":false,"pages":[{"spans":[{"text":"...All this time, Galatea Corporation has focused its efforts on researching anti-ELID medications, and I believe everyone will be happy with the results we have achieved. "}]},{"spans":[{"text":"You may have heard of the new type of anti-ELID medication called \"Idunn\". "}]},{"spans":[{"text":"Our aspirations for this formulation are to make it safer, more effective, cheaper and more widely available. "}]},{"spans":[{"text":"Idunn has shown promising results in clinical trials so far, and it is currently under review by the government. "}]},{"spans":[{"text":"We believe that it can be launched in the not-too-distant future, and when that happens we cordially invite everyone to judge the effectiveness of Idunn for themselves. "}]},{"spans":[{"text":"It is always darkest before dawn, so please do not give up hope. We will surely see the first rays when the sun comes up!"}]}]},{"sprites":[],"ops":[{"type":"fadePointOff","raw":"黑点2"},{"type":"background","value":"168","raw":"BIN"},{"type":"closeMask","value":"%%","raw":"关闭蒙版"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The crowds surrounding the monitor cheer wildly. "}]},{"spans":[{"text":"Even from quite a distance away, the Dolls gathered at the bar's rear entrance can feel the genuine outpour of joy and hope from the people. "}]},{"spans":[{"text":"The Dolls watch the jubilant crowd with curiosity."}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Humans are such fragile yet resilient creatures. "}]},{"spans":[{"text":"They are easily crushed by absolute might, but if you give them a little bit of hope... "}]},{"spans":[{"text":"Even if it's just a little, it can reignite their thirst for life."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At some point, RPK-16 has walked up next to RO635."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"...You're right."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"It's better to be a Doll though! If our bodies break, we can simply get a new one!"}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I disagree. "}]},{"spans":[{"text":"Have you heard of the Ship of Theseus?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"What's that?"}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"A long time ago, a human posed a question. "}]},{"spans":[{"text":"If the planks of the ship of Theseus were constantly being changed out, until none of the planks were the original ones, then would it still be the original ship? "}]},{"spans":[{"text":"Now apply the same question to Dolls. If our parts are constantly replaced, or if we get a new body entirely, then are we still the same Dolls that we originally were?"}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hm..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"This story..."}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"We need to keep replacing our parts to keep functioning. "}]},{"spans":[{"text":"But human bodies don't work that way."}]}]},{"sprites":[{"prefab":"M4 SOPMOD IIMod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Hmmm..."}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Discounting things like accidents, humans can live a long time in their own bodies of flesh. "}]},{"spans":[{"text":"Their bodies may be fragile, but they are heartbreakingly pure and unadulterated."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Your thoughts are very profound, Miss RPK-16..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"SOP-II has already dozed off while leaning on RO's shoulder. "}]},{"spans":[{"text":"Out of politeness, RO is compelled to stay where she is."}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Miss RO, do you find my musings dry and boring?"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Not at all..."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"Zzzzz..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"You're drooling again, SOP-II...","style":{"color":"#A9A9A9"}}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"That's wonderful. There are many things I'd like to ask you, Miss RO."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"RPK-16 turns toward RO and peers at her with fascination."}]}]},{"sprites":[{"prefab":"RPK16","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I hear that you're the prototype for the third generation of Dolls. "}]},{"spans":[{"text":"Miss Persica didn't place any restrictions on your base layer."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Um... "}]},{"spans":[{"text":"That's true, but practically speaking there's no real difference."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"A base layer like a blank sheet of paper... "}]},{"spans":[{"text":"It's as close to a human soul as you can get."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"I suppose you could say that in a certain sense, you have a human heart, Miss RO."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Well, I wouldn't go that far. At the end of the day, I'm—"}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Then have you ever wondered what it would feel like to be a human?"}]}]},{"sprites":[{"prefab":"RPK16","expression":8,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"After all, the only thing that keeps you from being completely human is not having a body made of flesh, right? "}]},{"spans":[{"text":"If a Doll had a soul as pure as a human's and a body as pure as a human's, then she would practically be no different than her creator..."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"What?"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"The unexpected question is so unnerving that RO takes a step back. "}]},{"spans":[{"text":"ST AR-15's eyes snap open from her feigned sleep. AK-15 and AK-12 also eye their teammate incredulously."}]}]},{"sprites":[{"prefab":"RPK16","expression":9,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Aw, don't be so tense, I was just thinking out loud."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"Er... Sorry... I've never thought about this question before, so I don't know how to answer it."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_Door_Open_Close","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ting-a-ling... "}]},{"spans":[{"text":"The Commander steps out of the back door."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"RO, let's— "}]},{"spans":[{"text":"Oh hey, it's Task Force DEFY. I'm not interrupting anything, am I?"}]}]},{"sprites":[{"prefab":"RPK16","expression":7,"shown":true,"side":"left","tags":{"spritePosition":"0,-100"}}],"ops":[],"speaker":"RPK-16","narrator":false,"pages":[{"spans":[{"text":"Hello, Commander."}]}]},{"sprites":[],"ops":[],"speaker":"Commander","narrator":false,"pages":[{"spans":[{"text":"Hello. Ange's waiting for you in there. "}]},{"spans":[{"text":"RO, we should head back."}]}]},{"sprites":[{"prefab":"RO635Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"RO635","narrator":false,"pages":[{"spans":[{"text":"OK. 15, SOP-II, let's go."}]}]},{"sprites":[],"ops":[],"speaker":"M4 SOPMOD II","narrator":false,"pages":[{"spans":[{"text":"zzzzZZZZZ..."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"SOP-II, wake up! Time to go!"}]}]},{"sprites":[],"ops":[{"type":"blackscreenOff","raw":"黑屏2"},{"type":"background","value":"88","raw":"BIN"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...On a rooftop occupied by Squad 404 in the Old Town district."}]}]},{"sprites":[{"prefab":"HK416Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"416","narrator":false,"pages":[{"spans":[{"text":"What the hell were they droning on about? It almost put me to sleep."}]}]},{"sprites":[{"prefab":"UMP9Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP9","narrator":false,"pages":[{"spans":[{"text":"45, what's on your mind?"}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"UMP45's gaze once again falls on RPK-16, who is currently smiling and talking to Ange."}]}]},{"sprites":[{"prefab":"UMP45Mod","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":"UMP45","narrator":false,"pages":[{"spans":[{"text":"I have a feeling something's about to happen."}]}]}]}
