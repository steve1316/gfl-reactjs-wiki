{"name":"-31-2A12-1","beats":[{"sprites":[],"ops":[{"type":"background","value":"9","raw":"BIN"},{"type":"blackscreenOn","value":"0,10","raw":"黑屏1"},{"type":"bgm","value":"BGM_Empty","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[]},{"sprites":[],"ops":[{"type":"background","value":"181","raw":"BIN"},{"type":"blackscreenOff","raw":"黑屏2"},{"type":"bgm","value":"BGM_Brain","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...At the memorial of nameless martyrs."}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"At the sight of the quarantine wall and purification tower being reduced to rubble, as well as the swarming ELIDs, Ange clenches her fists. "}]},{"spans":[{"text":"She feels a searing rage but can't muster a way to express it."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"The purification tower is destroyed. "}]},{"spans":[{"text":"There are traitors among the garrison troops on the wall. The rebels have also blasted through the quarantine wall."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Just make your point.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"You knew about this, didn't you?! Didn't you say Statesec had eliminated the infiltrators?! They haven't done anything, haven't they!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"It's impossible, even for Statesec, to sniff out every single traitor. Miscalculations are inevitable.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Tsk...there are too many ELIDs and I don't have enough people, not to mention the oncoming storm. Time is short. I need you to send in more troops to lend me support near the wall."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I can't.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Why?! "}]},{"spans":[{"text":"Didn't we agree that you'd provide backup in the case of an emergency?! "}]},{"spans":[{"text":"...I just need them to round off the ELIDs; that's hardly an unreasonable request!"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"The agents have practically been wiped out. I don't have any more men to send.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"...Wiped...out? "}]},{"spans":[{"text":"How could that be? What about the backup teams?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"There aren't any. Those were all we got from the Head of Operations.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Why did they not take such an important conference seriously? "}]},{"spans":[{"text":"I'll recall my team and head over to the conference hall right away."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"That won't be necessary. Continue with your recon work.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"But Ambassador Roshchin..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"He's dead.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Don't let their sacrifices be in vain. Continue your mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"\"Don't let their sacrifices be in vain...\" "}]},{"spans":[{"text":"A terrifying idea suddenly occurred to me... Care to listen to my suspicions?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"Did these suspicions form over the last few seconds?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I believe I'm not obliged to listen, nor am I obliged to offer you any explanation—","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"I couldn't detect even a sliver of shock in your voice. "}]},{"spans":[{"text":"Even with a will of steel, anyone would at least waver a little in the face of such a crisis... "}]},{"spans":[{"text":"So I can't help but suspect that everything..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You're overthinking it. As a Statesec agent, you simply have to do your job. That's the only thing you're good for.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Humph, and here I thought I was a renegade."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"All the more reason why you need me.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"Do I though?"}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"You think you're oh-so-amazing just because you pulled a few crazy stunts in the past?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Of course you need me if you still want to complete your objective.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}},{"prefab":"NPC-Jason","expression":0,"shown":true,"side":"left","tags":{"commsBox":""}}],"ops":[],"speaker":"K","narrator":false,"pages":[{"spans":[{"text":"I have no wish to concern myself with what you have done or who you used to be. Those things mean nothing to me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Right now, I'm the only one who can tell where your loyalties lie, and only I can truly protect you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I hope you can remember that and refrain from making unnecessary comments in the future. Resume your mission.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"NPC-AngeStreet","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Ange","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"blackscreenOn","raw":"黑屏1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Ange ends the transmission and silently looks into the distance."}]}]}]}
