lue":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...You're certainly very well informed.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Not many can go toe-to-toe with Paradeus.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"This is the only person who's known to have grappled with those white monsters and not only survived, but also managed to corner them.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...So?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"I'm looking to work with a different contractor. What do you think?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"You're part of the Fox Sisterhood.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"That makes it very hard for me to trust you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Fair enough, but that's why I've spent the last two years preparing for my next client.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"After all, it is a dangerous world we live in, and there are too many unscrupulous villains around.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...The Fox Sisterhood's work is unscrupulous by nature.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"My, such generous praise!","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In any case, just write me a reference letter. I'm sure I'll be able to convince that commander to work with me.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"In return, you can name your terms.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...With the Fox sisters now missing, aren't you finally free?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Why are you shackling yourself again?","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"A Soviet agent questioning me about shackles? How quaint.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"About as quaint as you talking about \"unscrupulous villains\" in this \"dangerous world\".","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"In the eyes of other Dolls, it may look like I'm living the high life.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"The same goes for you.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie sighs deeply on the other end of the comms channel."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Look, let's use the Future as an example.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You get to travel in the first-class carriage, sipping the best red wine served to you by Susanna.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"While I can only risk my life and be a stowaway.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...You must've made a fortune in this business by now. The money should be enough for several new bodies.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Spoken like a true member of the upper class.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"You are a Doll in the Military. Maintenance and overhauls are a walk in the park for you.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But drifters like us aren't so privileged.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"If it were up to me, I might actually prefer your lifestyle.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Haha.","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie lets out a bark of laughter."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"As if I'm living like this by choice.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":1,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"You see, most people don't get to choose the circumstances they are born into—you don't, and neither do I.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Which is why I cherish every single choice that I DO get to make.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"The choices that have passed us by, the ones that we never had in the first place...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"There's no point in beating ourselves up over them.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"It's not my fault that I didn't get to choose.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"But now I have a choice, and so do you, Madam Instructor.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"I'll think about it.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"I look forward to doing business with you!","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"But I have an extra condition.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Take Erma with you to Griffin's base.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...","style":{"color":"#00CCFF"}}]}]},{"sprites":[],"ops":[{"type":"frame","value":"2","raw":"边框"},{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie looks out of the window into the distance."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"If I remember correctly, that goes directly against your Official Secrets Act, no?","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"...She's a Doll created by Doctor Hume in private.","style":{"color":"#00CCFF"}}]}]},{"sprites":[{"prefab":"ColtWalker","expression":3,"shown":true,"side":"left","tags":{}},{"prefab":"AR18","expression":6,"shown":true,"side":"left","tags":{"spritePosition":"0,70"}}],"ops":[{"type":"frame","value":"2","raw":"边框"}],"speaker":"Lyudmila","narrator":false,"pages":[{"spans":[{"text":"We problematic Hume Dolls aren't likely to have happy endings.","style":{"color":"#00CCFF"}},{"text":" "}]},{"spans":[{"text":"Sinc