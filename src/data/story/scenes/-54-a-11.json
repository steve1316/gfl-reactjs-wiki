oor_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam!"}]}]},{"sprites":[],"ops":[{"type":"bgm","value":"GF_22W_BGM_4","raw":"BGM"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma's small body starts shifting backwards rapidly in the direction opposite to the one in which the train is traveling. She knocks a table away and crashes straight through a wall, creating a gaping hole in the retro-looking carriage."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":3,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":false,"pages":[{"spans":[{"text":"W-what the hell?! "}]},{"spans":[{"text":"Maggie... your train!"}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...I saw that!"}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"RunStep","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Maggie immediately goes running after Erma. She hasn't even got around to sipping her tequila."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":4,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"Hey... I just renovated this place not long ago! "}]},{"spans":[{"text":"It cost me a freaking fortune!!!","style":{"size":"50"}}]}]},{"sprites":[],"ops":[{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=8","raw":"controll_shake"},{"type":"sfx","value":"AVG_Door_Hit","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Bam! "}]},{"spans":[{"text":"No matter how many times Erma is forcibly deposited back in her original position, she immediately resets her own coordinates to an absolute point in this virtual space."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"