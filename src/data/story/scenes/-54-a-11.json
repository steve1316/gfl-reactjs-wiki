ator":false,"pages":[{"spans":[{"text":"Instead of trying to stop her, Maggie simply watches in amusement as she walks over to the bar and opens a bottle of tequila."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"AVG_va_addingredient","raw":"SE1"}],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"...Let her jump. "}]},{"spans":[{"text":"If she dies, it's on me."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"AVG_XXS_kick","raw":"SE1"},{"type":"shake","value":"%%type_id=2%%duration=2%%delay=0.1%%range=8","raw":"controll_shake"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Thud!"}]}]},{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Erma drops from the overhead luggage rack back into the same seat."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"ColtWalker","expression":2,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Maggie","narrator":false,"pages":[{"spans":[{"text":"If jumping out of the window isn't fun enough, try hanging yourself. "}]},{"spans":[{"text":"I've never seen a Doll die from hanging, but you can certainly give it a go."}]}]},{"sprites":[{"prefab":"Erma","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Erma","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[],"ops":[{"type":"sfx","value":"ClothingUp","raw":"SE1"}],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"Leaning against the table, Erma gets to her feet. "}]},{"spans":[{"text":"She seems oblivious to Maggie's mockery as she scans the carriage with narrowed eyes."}]}]},{"sprites":[{"prefab":"NPC-Scalper","expression":0,"shown":true,"side":"left","tags":{}}],"ops":[],"speaker":"Catherine","narrator":fa