ator":false,"pages":[{"spans":[{"text":"The things you can do on a safe circuit are limited to begin with. We'll wait for the pros to show up and let them handle the rest."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange, by pros, do you mean..."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":5,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's right. They're the only ones who can operate on Level II without regard for Parapluie's interference. "}]},{"spans":[{"text":"Also, AK-12, set up another signal blockade when the time comes. That way we'll know what the Military's up to."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Acknowledged."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Who are \"they\"?"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange's personal black ops squad. You should've heard of them and the rumors about them... "}]},{"spans":[{"text":"The squad which \"doesn't exist.\""}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"Doesn't exist... "}]},{"spans":[{"text":"Ah, it's them!"}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}},{"prefab":"M4A1Mod","expression":3,"side":"left","tags":{}}],"ops":[{"type":"blackscreen","raw":"黑屏1"}],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's right. "}]},{"spans":[{"text":"It's my Squad 404."}]}]}]}
