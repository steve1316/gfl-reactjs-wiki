{"name":"-16-11-2First","beats":[{"sprites":[],"ops":[],"speaker":null,"narrator":false,"pages":[{"spans":[{"text":"...The battle ends."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"M4, that's enough. Those are friendlies up ahead. "}]},{"spans":[{"text":"They're members of Task Force DEFY, Ange and AN-94."}]}]},{"sprites":[{"prefab":"M4A1Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"M4A1","narrator":false,"pages":[{"spans":[{"text":"..."}]}]},{"sprites":[{"prefab":"AK12","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AK-12","narrator":false,"pages":[{"spans":[{"text":"Nice work, AN-94."}]}]},{"sprites":[{"prefab":"AN94","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"AN-94","narrator":false,"pages":[{"spans":[{"text":"...It's nothing. It is the least I could do."}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"Ange, you actually came over in person."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"That's right, I'm a good boss who doesn't balk at risking her life to protect her people. How about some thanks?"}]}]},{"sprites":[{"prefab":"AR15Mod","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"ST AR-15","narrator":false,"pages":[{"spans":[{"text":"(Sighs) That's just like you, and who am I to say anything about it? "}]},{"spans":[{"text":"Anyway, here's our new member, as you wanted."}]}]},{"sprites":[{"prefab":"NPC-Ange","expression":0,"side":"left","tags":{}}],"ops":[],"speaker":"Angelia","narrator":false,"pages":[{"spans":[{"text":"... "}]},{"spans":[{"text":"Looking good. It seems the final neural upgrade went very well... "}]},{"spans":[{"text":"Didn't it, M4A1?"}]}]},{"sprites":[{"prefab":